/target
Cargo.lock
!/android/Cargo.lock
*.rs.bk
.DS_Store
/.vscode
/.idea
/.claude
/.codegraph
/AGENTS.md
/opencode.jsonc
/.qoder
/docs/superpowers
/android/target/
# Runtime state & secrets — must never be committed (#runtime-data).
# config/ holds ipc.port, known_hosts, secret.key, sessions.json
# log/ holds error.log and other runtime logs.
/config
/log

# Build / release artifacts — binaries must NOT be committed (#no-binaries).
# These are local convenience copies for the user; kept on disk but never tracked.
# target/ (above) already covers target/{debug,release}/meatshell.exe.
/meatshell-*-win64.exe
/meatshell-win-verify.zip
/meatshell-win-verify/
# scripts/package-win.py 的产物：34MB 的 exe + zip。每次发版都会重建，只留磁盘。
/dist/

# Local build logs (wip builds) — ephemeral, never tracked.
build_wip*.log

# WorkBuddy project data lives inside the repo dir; it is tool-internal and
# must never be committed to the code fork.
/.workbuddy/
# 同类：另一个编码助手的本地 plans，与 .claude/.codegraph 同性质。
/.zcode/

# Vendor 目录内的构建产物与升级前的备份副本 — 不进版本库。
vendor/*/target/
vendor/*.bak/
*.log
