// 分组管理弹框 —— 高保真落地（docs/design/group-manager-hifi-2026-10-22.html）
//
// 设计要点（与稿子一一对应）：
//  ① 双栏 760×560：左 320（可拖 220–480，双击回 320）+ 5px 分隔条 + 右侧余量。
//     左栏管组（选中 / 改色 / 双击行内改名 / 拖拽排序 / 新建），
//     右栏管这个组的人（勾选 / 刷选 / 拖拽换组 / 组内排序 / 移出 / 批量移动）。
//  ② 整行可点 = 勾选；复选框那一列另外负责刷选；Shift+点复选框 = 范围勾选。
//     拖动按位移区分（>5px 才起拖），纯点击不会误拖。
//  ③ 组级动作只在右栏头部：色点改色 / 双击组名改名 / 垃圾桶删除（前置 1px 线）。
//     左栏零图标，只有 hover 才浮出的 ↑↓。
//  ④ 改名：Enter 或点空白确认，Esc 放弃；左栏行内改（错误写底栏）+ 右栏头部改
//     （错误写在标题下）。两个入口用 edit-where 区分，不会同时出现两个输入框。
//  ⑤ 删除不再要求空组：右栏头部整条换成 52px 删除条，先选成员去向再删。
//  ⑥ 没有撤销 —— ConfigStore 每次改动即时落盘，删除条是唯一防线；
//     结果写进底栏那行（2.6s 回落），不再弹居中 toast。
//  ⑦ 搜索：组行不隐藏，计数变 命中/总数、0 命中压暗；当前组 0 命中而别处有时
//     自动跳过去；空态分「所有分组都没有」与「本组没有 · 别处还有 N 个」。
//
// Slint 落地约束（踩过的坑，别再犯）：
//  · 布局子项不能设 x / y / width（由布局给），否则报 "cannot be set" 或绑定循环。
//  · 布局子项的 width 不能引用 parent.width（preferred-width 反向依赖 → 循环）。
//  · Rectangle 没有 padding / margin —— 只能包一层 HorizontalLayout / VerticalLayout。
//  · 组件函数在表达式里不能带连字符（a-b() 会被当减法），一律蛇形命名；
//    函数体内没有 if 语句和 for，用三元；局部 let 变量不能二次赋值。
//  · 拖动落点用「位移 / 行高」推算，不依赖每行的绝对坐标；跨栏命中用容器绝对 y。
import { Theme } from "theme.slint";
import { Icon } from "icons.slint";
import { ProtocolIcon, Scrim, DialogClose } from "widgets.slint";
import { GroupRow, GroupSwatch, GmMember } from "group_types.slint";
import { ColorPickerDialog, PickerMath } from "color_picker.slint";
import { ScrollView } from "std-widgets.slint";

// 左栏「我的分组 N」小节标题：默认组之后出现；默认组空着被隐藏时它顶到最上面。
component GmCaption inherits Rectangle {
    in property <string> label;
    in property <int> count;
    in property <length> cap-height: 32px;
    height: root.cap-height;
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        padding-top: 5px;
        spacing: 6px;
        cross-axis-alignment: center;
        Text {
            text: root.label;
            color: Theme.text-secondary;
            font-size: 11.5px;
            font-weight: 600;
            vertical-alignment: center;
        }
        Rectangle {
            height: 16px;
            border-radius: 8px;
            background: Theme.accent-soft;
            HorizontalLayout {
                padding-left: 6px;
                padding-right: 6px;
                alignment: center;
                Text {
                    text: root.count;
                    color: Theme.accent;
                    font-size: 10px;
                    font-family: Theme.font-mono;
                    font-weight: 600;
                    vertical-alignment: center;
                }
            }
        }
        Rectangle { horizontal-stretch: 1; height: 1px; }
    }
}

// 空态里的文字按钮（清除搜索 / 跳到「X」）：
// 22px 高、1px 描边、hover 转 accent；定宽子项要自己包一层 alignment:center 的
// HorizontalLayout 才会居中（VerticalLayout 的交叉轴不认固定宽度）。
component GmLinkBtn inherits Rectangle {
    in property <string> label;
    callback clicked();
    height: 22px;
    border-radius: Theme.radius-sm;
    border-width: 1px;
    border-color: ta.has-hover ? Theme.accent.with-alpha(0.42) : Theme.mgr-line-strong;
    background: ta.has-hover ? Theme.accent.with-alpha(0.10) : transparent;
    ta := TouchArea {
        mouse-cursor: default;
        clicked => { root.clicked(); }
    }
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        alignment: center;
        Text {
            text: root.label;
            color: ta.has-hover ? Theme.accent-solid : Theme.text-secondary;
            font-size: 11px;
            vertical-alignment: center;
        }
    }
}

// 快捷键气泡的一行：[标签] <kbd>按键</kbd>（高保真 §keys：标签在左、键帽贴右）
component GmKeyRow inherits HorizontalLayout {
    in property <string> label;
    in property <string> keys;
    height: 24px;
    spacing: 8px;
    Text {
        horizontal-stretch: 1;
        text: root.label;
        color: Theme.text-secondary;
        font-size: 11.5px;
        vertical-alignment: center;
        overflow: elide;
    }
    Rectangle {
        height: 18px;
        border-radius: 4px;
        border-width: 1px;
        border-color: Theme.mgr-line-strong;
        background: Theme.bg-active;
        HorizontalLayout {
            padding-left: 5px;
            padding-right: 5px;
            alignment: center;
            Text {
                text: root.keys;
                color: Theme.text-secondary;
                font-size: 9.5px;
                font-family: Theme.font-mono;
                vertical-alignment: center;
            }
        }
    }
}

// 气泡里的分组小标（浏览与选择 / 改名与删除 / 弹框）
component GmKeyCap inherits Text {
    height: 20px;
    color: Theme.text-muted;
    font-size: 9.5px;
    vertical-alignment: bottom;
}

export component GroupManagerDialog inherits Rectangle {
    in property <bool> lang-en;
    in property <bool> open;
    in-out property <string> selected: "";
    in property <[GroupRow]> groups: [];
    in property <[GmMember]> members: [];
    in property <[GroupSwatch]> palette: [];
    // 已选条数由 Rust 维护（Slint 1.8 的数组没有 filter / map）。
    in property <int> picked-count: 0;
    // 标题副标题：自定义分组数 / 全部会话数（Rust 下发，搜索时也不变）。
    in property <int> custom-count: 0;
    in property <int> session-count: 0;
    // 当前组是「未分组」：标题不可双击改名（高保真 §RULES）。
    in property <bool> cur-reserved: false;
    // 当前组的高亮信息由 Rust 随 selected 一起下发（省掉在 Slint 里查表）。
    in property <color> cur-color: transparent;
    in property <string> cur-color-hex: "";
    // (#gm-search-count 2026-10-22) 搜索汇总：全局命中数 + 第一个「别处有命中」的组。
    // 右栏空态据此区分「所有分组都没有」与「本组没有 · 别处还有 N 个」。
    in property <int> search-hits: 0;
    in property <string> search-jump: "";

    callback close();
    callback search(string /* query */);
    callback select(string /* group */);
    callback rename(string /* orig */, string /* name */) -> string;
    // 输入时实时预校验：返回 "" = 合法，否则返回错误文案
    callback validate-name(string /* text */, string /* orig */) -> string;
    callback create-group(string /* name */, string /* hex */) -> string;
    callback remove-group(string /* name */, string /* target */);
    callback set-group-color(string /* name */, string /* hex */);
    callback reorder-group(string /* group */, string /* before */);
    callback toggle-pick(string /* id */);
    callback paint-pick(int /* from */, int /* to */, bool /* on */);
    callback clear-picks();
    // whole = true → Rust 取全部已选；false → 只处理这一条
    callback move-members(string /* id */, string /* target */, bool /* whole */);
    callback reorder-members(string /* id */, string /* before */, bool /* after */, bool /* whole */);
    // 整块上下移一格（行尾 ↑↓ 点到「已勾选的某条且勾了多条」时走这里）：
    // dir = -1 上移 / +1 下移，由 Rust 按组内顺序算落点并整块插入。
    callback step-members(int /* dir */);
    callback move-out(string /* id */, bool /* whole */);

    // ── 弹框内临时态（不落盘）──
    in-out property <string> editing: "";        // 正在改名的组名（"" = 无）
    in-out property <string> editing-text: "";
    in-out property <string> editing-error: "";
    in-out property <bool> creating: false;
    in-out property <string> confirm-del: "";    // 展开删除条的组名
    in-out property <string> del-target: "";     // 成员去向（"" = 未分组）
    in-out property <bool> del-menu: false;      // 删除条的「去向」下拉
    in-out property <string> color-for: "";      // 展开色板的组名（"__new" = 新建行）
    // (#gm-accent-palette) 自定义颜色：色板左下角入口 → 取色盘（属性在 app.slint
    // 根上双向绑定，Rust 侧照 highlight 版四行直写同步取样点）
    in-out property <bool> pick-open: false;
    in-out property <string> pick-hex: "";
    in-out property <string> pick-fmt: "rgb";
    in-out property <float> pick-wheel-mx: 0.5;
    in-out property <float> pick-wheel-my: 0.5;
    in-out property <float> pick-val-my: 1.0;
    in-out property <float> pick-pick-v: 1.0;
    callback picker-sync();
    callback copy-text(string);
    in-out property <string> color-hex-for: "";  // 色板里打环的当前色
    in-out property <string> new-color: "";      // 新建行手选色（"" = 自动分配）
    in-out property <color> new-swatch: transparent;   // 手选色的 color 值（画色点用）
    // 自动分配色：Rust 每次刷新算好「当前主题色板里第一个没被占用的颜色」，
    // 新建行在建组之前就能显示出来，落盘时用的也是同一个规则。
    in property <color> next-color: transparent;
    in-out property <string> edit-where: "";     // "left" = 左栏行内改名，"right" = 右栏头部
    in-out property <int> color-row: 0;
    // 色板锚点（gm 坐标系）：贴在被点的色点下方 6px，出界自动夹回
    in-out property <length> color-anchor-x: 0px;
    // 「移动到 / 删除去向」下拉的锚点（gm 坐标，= 触发按钮**中心** x）：
    // 菜单以按钮为轴左右居中（右缘对齐会显得偏右），出界再夹回面板内。
    in-out property <length> move-menu-x: 0px;
    in-out property <length> del-menu-x: 0px;
    in-out property <length> color-anchor-y: 0px;
    in-out property <bool> move-menu: false;
    // 结果提示（删除后只报结果，不提供撤销）
    in-out property <string> toast: "";
    // 键盘焦点脉冲（弹框打开时 +1，fs 盯着把自己推上焦点链——见 changed open）
    property <int> focus-pulse: 0;
    // 底栏那条是**错误**而不是结果：图标转警示、文字转 danger，且不被 2.6s 定时器吞掉
    // （重名提示要一直留到用户把名字改回来 —— 用绿勾报错误是最误导的那种"优化"）
    in-out property <bool> toast-error: false;
    // 快捷键气泡（底栏 ? 圆钮，只按需展开 —— 打开弹框时不再自动弹）
    in-out property <bool> keys-open: false;
    // 搜索：过滤交给 Rust（Slint 的字符串没有 contains）
    in-out property <string> query: "";
    // 悬浮卡：tip-row = 正在悬停的成员行号（-1 = 无），150ms 后才置。
    // 位置跟鼠标（高保真 10-22：贴鼠标右下角 +16/+14，出界自动翻转）。
    in-out property <int> hover-row: -1;
    in-out property <int> tip-row: -1;
    in-out property <length> tip-mx: 0px;
    in-out property <length> tip-my: 0px;
    // 拖到左栏时命中的组行（-1 = 不是换组）
    in-out property <int> drop-gi: -1;

    // 拖动
    in-out property <bool> dragging: false;
    in-out property <string> drag-kind: "";      // "group" | "member"
    in-out property <string> drag-id: "";
    in-out property <string> drag-label: "";      // ghost 主文案（会话名 / 组名）
    in-out property <int> drag-index: 0;
    in-out property <int> drag-to: 0;
    in-out property <int> drag-insert: -1;       // 插入线位置（-1 = 不画）
    in-out property <length> drag-abs-x: -1000px;
    in-out property <length> drag-abs-y: -1000px;
    in-out property <bool> drop-group: false;    // 指针在左栏组行上
    // 起拖阈值（高保真：位移 >5px 才起拖，避免手抖）
    in-out property <length> press-x: 0px;
    in-out property <length> press-y: 0px;
    // 刷选：按下行的锚点与「画成什么状态」（从已选行起拖 = 反向擦除）
    in-out property <int> pick-anchor: -1;
    in-out property <bool> pick-on: false;
    in-out property <bool> pick-sweeping: false;
    // Shift+点复选框 = 范围勾选：按下时已整段置位，松开的那次 clicked 不能再翻一次
    in-out property <bool> shift-pending: false;
    // 弹框拖动（标题区 / 空白，>3px 起拖，夹在窗口内）
    in-out property <length> win-dx: 0px;
    in-out property <length> win-dy: 0px;
    in-out property <bool> win-dragging: false;
    in-out property <length> win-start-x: 0px;
    in-out property <length> win-start-y: 0px;
    in-out property <length> win-base-x: 0px;
    in-out property <length> win-base-y: 0px;
    // 当前组在左栏中的行号（键盘 ↑↓ 用；Rust 随 selected 下发）
    in-out property <int> cur-index: 0;
    // (#gm-split 2026-10-22) 左栏宽度：默认 320（高保真：左窄右宽 320 / 约 435），
    // 中间 5px 分隔条可拖 220–480，双击回 320。
    in-out property <length> left-w: 320px;
    in-out property <bool> sp-on: false;
    in-out property <length> sp-start: 0px;
    in-out property <length> sp-base: 320px;
    // 按下行号：press-row = 最后一次点过的成员行（Space 的落点，切组时清），
    // down-row = 本次手势按下的行（松开时判「按下与松开在同一行」）
    in-out property <int> press-row: -1;
    in-out property <int> down-row: -1;

    property <length> row-h: 36px;
    property <length> mem-h: 36px;
    // 「我的分组」小节标题（未分组与自定义组之间，高保真 §左栏）
    property <length> cap-h: 32px;

    out property <int> total-count: root.members.length;
    out property <string> cur-name: root.selected;

    // 有自定义组才有「我的分组」小节；它占一行高，所以行号 ↔ 像素不能再用纯乘法。
    function has-cap() -> bool {
        return root.custom-count > 0;
    }
    // 第 0 行是不是「默认组」：它没成员时 Rust 不下发这一行（2026-10-22），
    // 那时小节标题顶到列表最顶部，插入线/命中的像素映射也要跟着换一套。
    pure function has-default-row() -> bool {
        return root.groups.length > 0 && root.groups[0].reserved;
    }
    // 内容内 y（已减列表 8px padding）→ 组行号
    function gi-at(y: length) -> int {
        let cap = root.has-cap() ? root.cap-h : 0px;
        if (root.has-default-row() && y < root.row-h) { return 0; }
        if (root.has-default-row() && y < root.row-h + cap) { return 1; }
        return Math.max(0, Math.min(root.groups.length - 1,
            Math.floor((y - cap) / root.row-h)));
    }
    // 组行号 → 该行顶部（相对 glay 内容顶 + 8px padding 的原点，含列表 8px padding）
    pure function gi-top(i: int) -> length {
        let cap = root.has-cap() ? root.cap-h : 0px;
        return 8px + i * root.row-h
            + (root.has-default-row() ? (i >= 1 ? cap : 0px) : cap);
    }
    // 下拉里实际渲染多少行：可见组（当前组不列）+ 默认组被隐藏时补的一行
    pure function menu_rows() -> int {
        return Math.max(1, root.groups.length - 1) + (root.has-default-row() ? 0 : 1);
    }
    // 当前组的会话总数：取组行上的真实计数（右栏 total-count 是搜索过滤后的行数，
    // 删除条/批量动作报数时不能用它）
    pure function cur_total() -> int {
        return root.cur-index >= 0 && root.cur-index < root.groups.length
            ? root.groups[root.cur-index].count
            : root.total-count;
    }
    // 认证方式显示名：与 app.slint 的 auth-display-name 同一张映射
    // （卡片在弹框组件里，跨组件拿不到根组件的函数，故本地复制三支）。
    function auth-label(a: string) -> string {
        if (a == "keyboard-interactive") {
            return root.lang-en ? "Keyboard-interactive" : "键盘交互";
        }
        if (a == "key") {
            return root.lang-en ? "Private key" : "私钥";
        }
        return root.lang-en ? "Password" : "密码";
    }
    // 协议显示名（hover 卡首行，与 tab-card-proto 同口径）：kind 是 ProtocolIcon 的 id。
    function proto-label(k: string) -> string {
        if (k == "ssh") { return "SSH"; }
        if (k == "rdp") { return "RDP"; }
        if (k == "vnc") { return "VNC"; }
        if (k == "sftp") { return "SFTP"; }
        if (k == "telnet") { return "Telnet"; }
        if (k == "serial") { return "Serial"; }
        if (k == "local") { return "Local"; }
        return k;
    }

    // 进入改名：预填原名（TextInput 拿焦点后全选，直接输入即覆盖）
    function start_edit(name: string) {
        root.editing = name;
        root.editing-text = name;
        root.editing-error = "";
        root.color-for = "";
        root.creating = false;
    }

    // 统一的底栏反馈（bad = 语义红 + 警示图标）
    function flash(m: string, bad: bool) {
        root.toast = m;
        root.toast-error = bad;
    }

    // 确认改名 / 新建：Enter、点空白、点关闭都走这里。
    // 返回 true = 没有待提交的编辑或提交成功；false = 名字非法 —— 调用方**不得**
    // 继续关窗 / 切组 / 开新建行，否则用户刚打的字会被静默丢掉（旧版就是这样：
    // 重名时按「完成」照样关窗，回来发现没改成、也没有任何提示）。
    function commit_edit() -> bool {
        let active = root.creating || root.editing != "";
        if (!active) { return true; }
        // 规则①：空名不提交 —— 失焦/点空白即静默放弃（不报错、不产生空组）
        if (root.editing-text == "") {
            root.editing = "";
            root.creating = false;
            root.editing-text = "";
            root.editing-error = "";
            root.edit-where = "";
            root.new-color = "";
            root.new-swatch = transparent;
            return true;
        }
        // 新建时把「新建行手选的色」一起交出去（"" = Rust 自动分配）
        let err = root.creating
            ? root.create-group(root.editing-text, root.new-color)
            : root.rename(root.editing, root.editing-text);
        // err 只能被移动一次（生成的 Rust 里是 SharedString）→ 先落进属性，再读回来用
        let ok = err == "";
        root.editing-error = ok ? "" : err;
        // 左栏行内改名没有位置放文案 → 写进底栏那行（红色警示）
        if (!ok && !root.creating && root.edit-where == "left") {
            flash(root.editing-error, true);
        }
        if (ok) {
            root.editing = "";
            root.creating = false;
            root.editing-text = "";
            root.edit-where = "";
            root.new-color = "";
            root.new-swatch = transparent;
        }
        return ok;
    }

    // ── 悬浮提示（按钮 title 的落地）：150ms 出、跟指针、移开即收 ──
    in-out property <string> tip-text: "";
    in-out property <length> tip-ax: 0px;
    in-out property <length> tip-ay: 0px;
    in-out property <bool> tip-show: false;
    btn-tip-timer := Timer {
        interval: 150ms;
        running: root.tip-text != "";
        triggered => { root.tip-show = true; }
    }
    function tip-on(text: string, ax: length, ay: length) {
        root.tip-text = text;
        root.tip-ax = ax;
        root.tip-ay = ay;
        root.tip-show = false;
    }
    function tip-at(ax: length, ay: length) {
        root.tip-ax = ax;
        root.tip-ay = ay;
    }
    function tip-off() {
        root.tip-text = "";
        root.tip-show = false;
    }

    // 悬停 150ms 出卡（与列表侧同一口径）；移开或开始拖拽立刻收起
    tip-timer := Timer {
        interval: 150ms;
        running: root.hover-row >= 0 && root.tip-row != root.hover-row && !root.dragging;
        triggered => { root.tip-row = root.hover-row; }
    }
    changed hover-row => {
        if (root.hover-row < 0) { root.tip-row = -1; }
    }
    changed dragging => {
        if (root.dragging) { root.tip-row = -1; }
    }
    // 结果提示停留 2.6s 后回落到「改动已自动保存」（高保真 §操作反馈）
    toast-timer := Timer {
        interval: 2600ms;
        // 错误提示不自动消失：名字还非法就一直留着（改回合法时下面这个 changed 收掉它）
        running: root.toast != "" && !root.toast-error;
        triggered => { root.toast = ""; }
    }
    changed editing-error => {
        if (root.editing-error == "" && root.toast-error) {
            root.toast = "";
            root.toast-error = false;
        }
    }
    // 关窗时把弹框内的临时态全部复位：下次打开是干净的一份
    changed open => {
        if (root.open) {
            // 打开瞬间拉回键盘焦点（fs init 抢不过外层浮层关闭后的焦点归还
            // 时序，首按 Esc 会丢给终端输入框）
            root.focus-pulse += 1;
        }
        if (!root.open) {
            tip-off();
            root.hover-row = -1;
            root.tip-row = -1;
            root.color-for = "";
            root.confirm-del = "";
            root.del-menu = false;
            root.move-menu = false;
            root.keys-open = false;
            root.new-color = "";
            root.new-swatch = transparent;
            root.editing = "";
            root.creating = false;
            root.editing-error = "";
            root.edit-where = "";
            root.down-row = -1;
            root.drop-gi = -1;
            root.dragging = false;
            root.drag-kind = "";
            root.drag-insert = -1;
            root.pick-anchor = -1;
            root.press-row = -1;
            root.pick-sweeping = false;
            root.win-dx = 0px;
            root.win-dy = 0px;
            root.win-dragging = false;
        }
    }

    width: 100%;
    height: 100%;

    if root.open : Rectangle {
        width: 100%;
        height: 100%;

        Scrim { }
        // 点遮罩：先确认改名再关（改名不会因为点了一下外面就丢）
        // (#modal-titlebar-block 2026-10-23) 命中区恢复全屏：此前让开标题栏
        // (#modal-titlebar-drag) 使弹框打开期间顶栏工具按钮仍可点，实测出现
        // 「分组管理开着又点出新建会话」的双弹框叠层。模态期间标题栏一律不
        // 响应，点标题栏 = 点背板（提交改名并关闭）；Scrim 视觉本来就铺满
        // 全屏，无变化。
        TouchArea {
            width: 100%;
            height: 100%;
            // 名字非法时不关窗（否则刚打的字白打）
            clicked => { if (commit_edit()) { root.close(); } }
        }

        gm := Rectangle {
            x: (parent.width - self.width) / 2 + root.win-dx;
            y: (parent.height - self.height) / 2 + root.win-dy;
            width: min(760px, parent.width - 32px);
            // 高保真 10-22：760×560（原 522）。多出来的高度留给右栏地址列与底部批量条。
            height: min(560px, parent.height - 32px);
            background: Theme.popup-bg;
            border-radius: Theme.radius-lg;
            border-width: 1px;
            border-color: Theme.mgr-line-strong;
            // (#popup-no-shadow 2026-10-20) 28px 投影按 10-17 定稿移除
            clip: true;

            // 按住标题区 / 任意空白拖动弹框；3px 内仍算点击（点空白 = 确认改名）。
            // 行 / 按钮 / 输入框各有自己的 TouchArea，先命中，不会触发这里。
            bg-ta := TouchArea {
                pointer-event(ev) => {
                    if (ev.kind == PointerEventKind.down) {
                        root.win-start-x = self.absolute-position.x + self.mouse-x;
                        root.win-start-y = self.absolute-position.y + self.mouse-y;
                        root.win-base-x = root.win-dx;
                        root.win-base-y = root.win-dy;
                        root.win-dragging = false;
                    } else if (ev.kind == PointerEventKind.up) {
                        if (!root.win-dragging) {
                            commit_edit();
                            root.color-for = "";
                            root.move-menu = false;
                            root.del-menu = false;
                            root.keys-open = false;
                        }
                        root.win-dragging = false;
                    }
                }
                moved => {
                    let ax = self.absolute-position.x + self.mouse-x;
                    let ay = self.absolute-position.y + self.mouse-y;
                    let dx = ax - root.win-start-x;
                    let dy = ay - root.win-start-y;
                    if (!root.win-dragging
                        && (dx > 3px || dx < -3px || dy > 3px || dy < -3px)) {
                        root.win-dragging = true;
                    }
                    if (root.win-dragging) {
                        let sx = Math.max(0px, (root.width - gm.width) / 2);
                        let sy = Math.max(0px, (root.height - gm.height) / 2);
                        root.win-dx = Math.max(-sx, Math.min(sx, root.win-base-x + dx));
                        root.win-dy = Math.max(-sy, Math.min(sy, root.win-base-y + dy));
                    }
                }
            }

            // Esc：编辑中先取消编辑，否则关窗（与稿子一致）。
            // 焦点给 FocusScope，TextInput 不处理的按键会冒泡上来。
            fs := FocusScope {
                x: 0px;
                y: 0px;
                width: 100%;
                height: 100%;
                init => { self.focus(); }
                property <int> pulse: root.focus-pulse;
                changed pulse => { self.focus(); }
                key-pressed(ev) => {
                    if (ev.text == Key.Escape) {
                        // Esc 逐级取消：取色盘 → 改名 → 删除条 → 搜索词 → 关窗。
                        // 取色盘先关（色板浮层保留，可继续选预设）；删除条未确认时
                        // 只收删除条 —— 误按一次 Esc 不该把弹框关掉。
                        if (root.pick-open) {
                            root.pick-open = false;
                        } else if (root.editing != "" || root.creating) {
                            root.editing = "";
                            root.creating = false;
                            root.editing-error = "";
                        } else if (root.keys-open) {
                            root.keys-open = false;
                        } else if (root.del-menu) {
                            root.del-menu = false;
                        } else if (root.confirm-del != "") {
                            root.confirm-del = "";
                        } else if (root.query != "") {
                            root.query = "";
                            root.search("");
                            q-ta.focus();
                        } else {
                            root.close();
                        }
                        return accept;
                    }
                    // 编辑中把按键留给 TextInput（Enter 由 accepted 处理）。
                    if (root.editing != "" || root.creating) {
                        return reject;
                    }
                    // Ctrl+F：聚焦搜索（快捷键收进底栏 ? 气泡）
                    if (ev.modifiers.control && (ev.text == "f" || ev.text == "F")) {
                        q-ta.focus();
                        return accept;
                    }
                    // ↑↓ 切换分组（高保真 §RULES / 快捷键气泡）
                    if (ev.text == Key.UpArrow || ev.text == Key.DownArrow) {
                        if (root.groups.length > 0) {
                            let step = ev.text == Key.UpArrow ? -1 : 1;
                            let i = Math.max(0, Math.min(root.groups.length - 1,
                                root.cur-index + step));
                            if (i != root.cur-index) {
                                if (!commit_edit()) { return accept; }
                                root.selected = root.groups[i].name;
                                root.confirm-del = "";
                                root.color-for = "";
                                root.clear-picks();
                                root.select(root.groups[i].name);
                            }
                        }
                        return accept;
                    }
                    // Space：勾选「最后点过的那一行」（锚点）；没有锚点就勾第一条
                    if (ev.text == " ") {
                        if (root.members.length > 0 && root.confirm-del == "") {
                            // 局部变量不能二次赋值 → 用三元一次算出处
                            let t = root.press-row >= 0 && root.press-row < root.members.length
                                ? root.press-row : 0;
                            root.toggle-pick(root.members[t].id);
                        }
                        return accept;
                    }
                    // F2 改名 / Del 删除（未分组不响应）
                    if (ev.text == Key.F2 && !root.cur-reserved) {
                        start_edit(root.cur-name);
                        root.edit-where = "left";
                        return accept;
                    }
                    if (ev.text == Key.Delete && !root.cur-reserved) {
                        root.confirm-del = root.cur-name;
                        root.del-target = "";
                        root.clear-picks();
                        return accept;
                    }
                    return reject;
                }

            VerticalLayout {
                spacing: 0px;

                // ══ 标题区（高保真 10-22：单行 52px —— 标题 + 计数胶囊贴左，
                //    搜索 + 关闭贴右，中间留白；原两行副标题合并进胶囊） ══
                Rectangle {
                    height: 52px;
                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 12px;
                        spacing: 10px;
                        cross-axis-alignment: center;
                        Text {
                            text: root.lang-en ? "Manage groups" : "分组管理";
                            color: Theme.text-primary;
                            font-size: Theme.fs-lg;
                            font-weight: 650;
                            vertical-alignment: center;
                        }
                        // 计数胶囊：accent-soft 底 + accent 字 + 8px 圆角（与稿子同款）
                        Rectangle {
                            height: 22px;
                            border-radius: 8px;
                            background: Theme.accent-soft;
                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                alignment: center;
                                Text {
                                    text: root.lang-en
                                        ? root.custom-count + " groups · " + root.session-count + " sessions"
                                        : root.custom-count + " 组 · " + root.session-count + " 会话";
                                    color: Theme.accent;
                                    font-size: 10.5px;
                                    font-family: Theme.font-mono;
                                    vertical-alignment: center;
                                }
                            }
                        }
                        // 占位：把搜索 / 关闭推到右侧
                        Rectangle { horizontal-stretch: 1; }
                        // 搜索（组名 / 会话名 / 主机，过滤在 Rust 侧）
                        // 高保真 10-22：搜索框吃掉中间余量，上限 280（窄窗靠弹框最小宽兜住）
                        Rectangle {
                            width: 280px;
                            height: 28px;
                            border-radius: Theme.radius-md;
                            // 输入框聚焦语言与其余弹框统一：accent 描边 + 提底 + 外扩 3px accent-soft 光环
                            background: q-ta.has-focus ? Theme.popup-field-2 : Theme.popup-bg-inset;
                            border-width: 1px;
                            border-color: q-ta.has-focus ? Theme.accent.with-alpha(0.42) : Theme.mgr-line-strong;
                            if q-ta.has-focus : Rectangle {
                                x: -3px;
                                y: -3px;
                                width: parent.width + 6px;
                                height: parent.height + 6px;
                                border-radius: Theme.radius-md + 3px;
                                border-width: 3px;
                                border-color: Theme.accent-soft;
                            }
                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 6px;
                                spacing: 6px;
                                cross-axis-alignment: center;
                                Icon { glyph: "search"; tint: Theme.text-muted; size: 13px; }
                                // 输入框 + 占位提示：TextInput 没有 placeholder-text，用叠层
                                Rectangle {
                                    horizontal-stretch: 1;
                                    height: 100%;
                                    q-ta := TextInput {
                                        width: 100%;
                                        height: 100%;
                                        text <=> root.query;
                                        font-size: Theme.fs-xs;
                                        color: Theme.text-primary;
                                        vertical-alignment: center;
                                        single-line: true;
                                        edited => { root.search(root.query); }
                                    }
                                    if root.query == "" : Text {
                                        width: 100%;
                                        height: 100%;
                                        text: root.lang-en ? "Search groups or sessions" : "搜索分组或会话";
                                        color: Theme.text-muted;
                                        font-size: Theme.fs-xs;
                                        horizontal-alignment: left;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                }
                                // (#gm-input-clear 2026-10-21) 框内清空 ×：与侧栏搜索清空同
                                // 语言（accent 实心圆 + 底色 × 镂空），按本弹框 28px 输入框的
                                // 紧凑尺度取 16px 圆 / 20×20 命中。有输入才出现，清空后焦点
                                // 留在输入框（对齐 #search-clear-refocus 惯例）。
                                if root.query != "" : Rectangle {
                                    width: 20px;
                                    height: 20px;
                                    background: transparent;
                                    gm-clear-ta := TouchArea {
                                        mouse-cursor: default;
                                    changed has-hover => {
                                        if (self.has-hover) {
                                            root.tip-on(root.lang-en ? "Clear search" : "清除搜索",
                                                self.absolute-position.x + self.mouse-x,
                                                self.absolute-position.y + self.mouse-y);
                                        } else { root.tip-off(); }
                                    }
                                    pointer-event(__ev) => {
                                        if (__ev.kind == PointerEventKind.move && self.has-hover) {
                                            root.tip-at(self.absolute-position.x + self.mouse-x,
                                                self.absolute-position.y + self.mouse-y);
                                        }
                                    }
                                        clicked => {
                                            root.query = "";
                                            root.search("");
                                            q-ta.focus();
                                        }
                                    }
                                    Rectangle {
                                        width: 16px; height: 16px;
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                        border-radius: parent.width / 2;
                                        background: gm-clear-ta.has-hover ? Theme.accent : transparent;
                                        animate background { duration: 100ms; }
                                        accessible-role: button;
                                        accessible-label: @tr("Clear search");
                                        Icon {
                                            glyph: "close";
                                            tint: gm-clear-ta.has-hover ? Theme.popup-bg-inset : Theme.text-muted;
                                            size: Theme.fs-xs;
                                        }
                                    }
                                }
                            }
                        }
                        // (#dialog-close-unify 2026-10-20) 原为 bg-hover 灰底悬停,
                        // 与其余弹框的红底白 × 不同款。
                        DialogClose {
                            corner: Theme.radius-md;
                            glyph-size: 14px;
                            clicked => { if (commit_edit()) { root.close(); } }
                        }
                    }
                    Rectangle {
                        y: parent.height - 1px;
                        width: 100%;
                        height: 1px;
                        background: Theme.mgr-line-soft;
                    }
                }

                // ══ 主体双栏 ══
                HorizontalLayout {
                    spacing: 0px;
                    vertical-stretch: 1;

                    // ── 左栏：组清单 ──
                    // 高保真 10-22：默认 320（左窄右宽），底色与弹框同色 —— 原来的
                    // inset 深色板会让两栏看起来是「两个窗口」，稿子里只有一条 1px 分隔线。
                    Rectangle {
                        width: root.left-w;
                        background: transparent;
                        VerticalLayout {
                            spacing: 0px;
                            glist := Rectangle {
                                vertical-stretch: 1;
                                clip: true;
                                // 组多时滚动
                                gsv := ScrollView {
                                    width: 100%;
                                    height: 100%;
                                    // 行拖拽优先：鼠标拖动交给行，滚轮仍滚列表
                                    mouse-drag-pan-enabled: false;
                                glay := VerticalLayout {
                                    padding-top: 8px;
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    spacing: 0px;
                                    alignment: start;
                                    // (#gm-hit-y 2026-10-23) 跨栏命中不再缓存 list-top：
                                    // `changed absolute-position` 在元素**初次布局赋值时
                                    // 不触发**（只在后续变化时 fire），而弹框是 if open
                                    // 条件子树、每次打开整棵重建 → 缓存停留 0px，gi-at
                                    // 拿窗口绝对 y 当列表内 y，命中 clamp 到最后一组
                                    // （用户实测"成员只能拖到最后一组"）。改为调用点
                                    // 直接读 glay.absolute-position.y（响应式、随滚动
                                    // 正确），彻底删缓存。

                                    // 默认组空着被隐藏时，小节标题顶到列表最上面（Rust 不下发那一行）
                                    if !root.has-default-row() && root.has-cap() : GmCaption {
                                        label: root.lang-en ? "My groups" : "我的分组";
                                        count: root.custom-count;
                                        cap-height: root.cap-h;
                                    }
                                    for i in root.groups.length : VerticalLayout {
                                        spacing: 0px;
                                        // 「我的分组 N」小节标题：只在默认组之后出现一次。
                                        // 层级靠「更小更重」而不是压暗：11.5px / 600 / text-secondary。
                                        if i == 1 && root.has-default-row() && root.has-cap() : GmCaption {
                                            label: root.lang-en ? "My groups" : "我的分组";
                                            count: root.custom-count;
                                            cap-height: root.cap-h;
                                        }
                                        Rectangle {
                                            height: root.row-h;
                                            border-radius: Theme.radius-md;
                                            // 被拖的组行 40% 透明；搜索 0 命中的组行压暗但不隐藏
                                            opacity: root.drag-kind == "group"
                                                && root.drag-id == root.groups[i].name ? 0.4
                                                : (root.query != "" && root.groups[i].hit == 0 ? 0.45 : 1.0);
                                            background: root.selected == root.groups[i].name
                                                ? Theme.accent.with-alpha(Theme.dark ? 0.10 : 0.08)
                                                : (root.drop-gi == i && root.drag-kind == "member"
                                                    ? Theme.accent.with-alpha(Theme.dark ? 0.18 : 0.12)
                                                    : (grow-ta.has-hover || gu-ta.has-hover || gd-ta.has-hover
                                                        ? Theme.bg-hover : transparent));

                                            // 选中竖条（高保真 §组行：上下各让 9px）
                                            if root.selected == root.groups[i].name : Rectangle {
                                                x: 0px;
                                                y: 9px;
                                                width: 2px;
                                                height: parent.height - 18px;
                                                border-radius: 1px;
                                                background: Theme.accent-solid;
                                            }
                                            // 拖成员到本行：accent 淡底（见 background）+ 1px accent 内描边
                                            if root.drop-gi == i && root.drag-kind == "member" : Rectangle {
                                                width: 100%;
                                                height: 100%;
                                                border-radius: Theme.radius-md;
                                                border-width: 1px;
                                                border-color: Theme.accent.with-alpha(0.42);
                                                background: transparent;
                                            }

                                            grow-ta := TouchArea {
                                                mouse-cursor: default;
                                                clicked => {
                                                    if (!commit_edit()) { return; }
                                                    root.color-for = "";
                                                    root.move-menu = false;
                                                    root.del-menu = false;
                                                    if (root.selected != root.groups[i].name) {
                                                        root.selected = root.groups[i].name;
                                                        root.confirm-del = "";
                                                        root.press-row = -1;
                                                        root.clear-picks();
                                                        root.select(root.groups[i].name);
                                                    }
                                                }
                                                double-clicked => {
                                                    if (!root.groups[i].reserved) {
                                                        start_edit(root.groups[i].name);
                                                        root.edit-where = "left";
                                                    }
                                                }
                                                moved => {
                                                    if (root.groups[i].reserved) { return; }
                                                    if (root.editing != "" || root.creating || root.query != "") { return; }
                                                    let ax = self.absolute-position.x + self.mouse-x;
                                                    let ay = self.absolute-position.y + self.mouse-y;
                                                    // 组 ghost 也要跟手：这里同步指针绝对坐标（成员拖动在
                                                    // pointer-event 里更新，组拖动只有 moved 回调）
                                                    root.drag-abs-x = ax;
                                                    root.drag-abs-y = ay;
                                                    let dx = ax - root.press-x;
                                                    let dy = ay - root.press-y;
                                                    if (!root.dragging) {
                                                        // >5px 才起拖（高保真 §拖拽）
                                                        if (dx > -5px && dx < 5px
                                                            && dy > -5px && dy < 5px) {
                                                            return;
                                                        }
                                                        root.dragging = true;
                                                        root.drag-kind = "group";
                                                        root.drag-id = root.groups[i].name;
                                                        root.drag-label = root.groups[i].name;
                                                        root.drag-index = i;
                                                    }
                                                    if (root.drag-kind == "group") {
                                                        let off = Math.round(self.mouse-y / root.row-h);
                                                        root.drag-to = Math.max(0, Math.min(
                                                            root.groups.length - 1, i + off));
                                                        root.drag-insert = root.drag-to > root.drag-index
                                                            ? root.drag-to + 1 : root.drag-to;
                                                    }
                                                }
                                                pointer-event(ev) => {
                                                    if (ev.kind == PointerEventKind.down) {
                                                        root.press-x = self.absolute-position.x + self.mouse-x;
                                                        root.press-y = self.absolute-position.y + self.mouse-y;
                                                        root.dragging = false;
                                                    } else if (ev.kind == PointerEventKind.up
                                                        && root.dragging && root.drag-kind == "group") {
                                                        // before = 目标位置当前的组（拖走自己后重取）
                                                        let to = root.drag-to;
                                                        let before = to > root.drag-index
                                                            ? (to + 1 < root.groups.length ? root.groups[to + 1].name : "")
                                                            : root.groups[to].name;
                                                        if (to != root.drag-index) {
                                                            root.reorder-group(root.drag-id, before);
                                                        }
                                                        root.dragging = false;
                                                        root.drag-kind = "";
                                                        root.drag-id = "";
                                                        root.drag-insert = -1;
                                                    }
                                                }
                                            }

                                            HorizontalLayout {
                                                // 左内边距 8 / 右 6 / 间距 8（高保真 §组行）
                                                padding-left: 8px;
                                                padding-right: 6px;
                                                spacing: 8px;
                                                cross-axis-alignment: center;

                                                // 色点：9px 实心 + 3px 同色光晕；无颜色时空心圈
                                                Rectangle {
                                                    width: 15px;
                                                    height: 15px;
                                                    border-radius: 8px;
                                                    background: root.groups[i].color-hex != ""
                                                        ? root.groups[i].color.with-alpha(0.18) : transparent;
                                                    Rectangle {
                                                        x: (parent.width - self.width) / 2;
                                                        y: (parent.height - self.height) / 2;
                                                        width: 9px;
                                                        height: 9px;
                                                        border-radius: 5px;
                                                        background: root.groups[i].color-hex != ""
                                                            ? root.groups[i].color : transparent;
                                                        border-width: root.groups[i].color-hex != "" ? 0px : 1px;
                                                        border-color: Theme.text-muted;
                                                    }
                                                }

                                                // 名称 / 编辑框（行内改名只在「左栏编辑」时出现）
                                                if root.editing == root.groups[i].name && root.edit-where == "left" : Rectangle {
                                                    horizontal-stretch: 1;
                                                    height: 24px;
                                                    border-radius: Theme.radius-sm;
                                                    background: grow-edit.has-focus
                                                        ? Theme.popup-field-2 : Theme.popup-bg-inset;
                                                    border-width: 1px;
                                                    border-color: root.editing-error != ""
                                                        ? Theme.danger
                                                        : (grow-edit.has-focus ? Theme.accent.with-alpha(0.42) : Theme.mgr-line-strong);
                                                    if grow-edit.has-focus && root.editing-error == "" : Rectangle {
                                                        x: -3px;
                                                        y: -3px;
                                                        width: parent.width + 6px;
                                                        height: parent.height + 6px;
                                                        border-radius: Theme.radius-sm + 3px;
                                                        border-width: 3px;
                                                        border-color: Theme.accent-soft;
                                                    }
                                                    grow-edit := TextInput {
                                                        x: 6px;
                                                        width: parent.width - 12px;
                                                        height: parent.height;
                                                        // 输入框是随编辑态**新建**的，Slint 不会自动给焦点 ——
                                                        // 不显式 focus() 的话 F2/双击改名后打字没有任何反应
                                                        init => { self.focus(); }
                                                        text <=> root.editing-text;
                                                        font-size: 12.5px;
                                                        color: Theme.text-primary;
                                                        vertical-alignment: center;
                                                        single-line: true;
                                                        edited => { root.editing-error = root.validate-name(root.editing-text, root.editing); }
                                                        accepted => { commit_edit(); }
                                                    }
                                                }
                                                if !(root.editing == root.groups[i].name && root.edit-where == "left") : Text {
                                                    horizontal-stretch: 1;
                                                    text: root.groups[i].name;
                                                    color: root.selected == root.groups[i].name
                                                        || grow-ta.has-hover
                                                        || gu-ta.has-hover || gd-ta.has-hover
                                                        ? Theme.text-primary : Theme.text-secondary;
                                                    font-size: 12.5px;
                                                    vertical-alignment: center;
                                                    overflow: elide;
                                                }
                                                // 计数：搜索态显示 命中/总数（0 命中不上强调色）
                                                Text {
                                                    text: root.query != ""
                                                        ? root.groups[i].hit + "/" + root.groups[i].count
                                                        : root.groups[i].count;
                                                    color: root.selected == root.groups[i].name
                                                        || (root.query != "" && root.groups[i].hit > 0)
                                                        ? Theme.accent-solid : Theme.text-muted;
                                                    font-size: 10.5px;
                                                    font-family: Theme.font-mono;
                                                    vertical-alignment: center;
                                                }
                                                // 拖成员悬停时浮出 +N（N = 实际拖拽条数）
                                                if root.drop-gi == i && root.drag-kind == "member"
                                                    && root.picked-count > 0 : Rectangle {
                                                    height: 16px;
                                                    border-radius: 8px;
                                                    background: Theme.accent-solid;
                                                    HorizontalLayout {
                                                        padding-left: 6px;
                                                        padding-right: 6px;
                                                        alignment: center;
                                                        Text {
                                                            text: "+" + root.picked-count;
                                                            color: white;
                                                            font-size: 9.5px;
                                                            font-family: Theme.font-mono;
                                                            font-weight: 700;
                                                            vertical-alignment: center;
                                                        }
                                                    }
                                                }
                                                // 上移 / 下移（未分组没有）：常占位、悬停渐显、边界置灰
                                                HorizontalLayout {
                                                    // 未分组没有排序键：用 visible 隐藏（Slint 的不可见元素不占位、
                                                    // 不吃事件），这样 id 仍在本作用域，行底色/组名能一起判 hover
                                                    visible: !root.groups[i].reserved;
                                                    spacing: 1px;
                                                    opacity: grow-ta.has-hover
                                                        || gu-ta.has-hover || gd-ta.has-hover ? 1.0 : 0.0;
                                                    animate opacity { duration: 120ms; }
                                                    Rectangle {
                                                        width: 16px;
                                                        height: 16px;
                                                        border-radius: Theme.radius-sm;
                                                        background: gu-ta.has-hover ? Theme.bg-hover : transparent;
                                                        gu-ta := TouchArea {
                                                            enabled: i > 1;
                                                            mouse-cursor: default;
                                                            changed has-hover => {
                                                                if (self.has-hover) {
                                                                    root.tip-on(i > 1
                                                                ? (root.lang-en ? "Move group up" : "上移分组")
                                                                : (root.lang-en ? "Already at top" : "已在最上"),
                                                                        self.absolute-position.x + self.mouse-x,
                                                                        self.absolute-position.y + self.mouse-y);
                                                                } else { root.tip-off(); }
                                                            }
                                                            pointer-event(__ev) => {
                                                                if (__ev.kind == PointerEventKind.move && self.has-hover) {
                                                                    root.tip-at(self.absolute-position.x + self.mouse-x,
                                                                        self.absolute-position.y + self.mouse-y);
                                                                }
                                                            }
                                                            clicked => {
                                                                root.reorder-group(root.groups[i].name, root.groups[i - 1].name);
                                                            }
                                                        }
                                                        Icon { glyph: "arrow-up"; tint: Theme.text-secondary; size: 10px; opacity: i > 1 ? 1.0 : 0.3; }
                                                    }
                                                    Rectangle {
                                                        width: 16px;
                                                        height: 16px;
                                                        border-radius: Theme.radius-sm;
                                                        background: gd-ta.has-hover ? Theme.bg-hover : transparent;
                                                        gd-ta := TouchArea {
                                                            enabled: i < root.groups.length - 1;
                                                            mouse-cursor: default;
                                                            changed has-hover => {
                                                                if (self.has-hover) {
                                                                    root.tip-on(i < root.groups.length - 1
                                                                ? (root.lang-en ? "Move group down" : "下移分组")
                                                                : (root.lang-en ? "Already at bottom" : "已在最下"),
                                                                        self.absolute-position.x + self.mouse-x,
                                                                        self.absolute-position.y + self.mouse-y);
                                                                } else { root.tip-off(); }
                                                            }
                                                            pointer-event(__ev) => {
                                                                if (__ev.kind == PointerEventKind.move && self.has-hover) {
                                                                    root.tip-at(self.absolute-position.x + self.mouse-x,
                                                                        self.absolute-position.y + self.mouse-y);
                                                                }
                                                            }
                                                            clicked => {
                                                                let before = i + 2 < root.groups.length
                                                                    ? root.groups[i + 2].name : "";
                                                                root.reorder-group(root.groups[i].name, before);
                                                            }
                                                        }
                                                        Icon { glyph: "arrow-down"; tint: Theme.text-secondary; size: 10px; opacity: i < root.groups.length - 1 ? 1.0 : 0.3; }
                                                    }
                                                }
                                            }

                                            // 色点点击区（压在行 TouchArea 之上，锚到色点）
                                            Rectangle {
                                                x: 4px;
                                                y: 0px;
                                                width: 26px;
                                                height: parent.height;
                                                background: transparent;
                                                cdot-ta := TouchArea {
                                                    mouse-cursor: default;
                                                changed has-hover => {
                                                    if (self.has-hover) {
                                                        root.tip-on(root.lang-en ? "Set color" : "改色",
                                                            self.absolute-position.x + self.mouse-x,
                                                            self.absolute-position.y + self.mouse-y);
                                                    } else { root.tip-off(); }
                                                }
                                                pointer-event(__ev) => {
                                                    if (__ev.kind == PointerEventKind.move && self.has-hover) {
                                                        root.tip-at(self.absolute-position.x + self.mouse-x,
                                                            self.absolute-position.y + self.mouse-y);
                                                    }
                                                }
                                                    clicked => {
                                                        commit_edit();
                                                        root.color-row = i;
                                                        root.color-hex-for = root.groups[i].color-hex;
                                                        root.color-anchor-x = cdot-ta.absolute-position.x
                                                            - gm.absolute-position.x;
                                                        root.color-anchor-y = cdot-ta.absolute-position.y
                                                            - gm.absolute-position.y + cdot-ta.height - 2px;
                                                        root.color-for = root.color-for == root.groups[i].name
                                                            ? "" : root.groups[i].name;
                                                        root.move-menu = false;
                                                        root.del-menu = false;
                                                    }
                                                }
                                            }
                                        }
                                    }

                                    // 新建行（编辑态）：色点可在建之前先定色（高保真 10-22）
                                    if root.creating : VerticalLayout {
                                        spacing: 0px;
                                        padding-top: 6px;
                                        Rectangle {
                                            height: 28px;
                                            border-radius: Theme.radius-md;
                                            background: new-name.has-focus
                                                ? Theme.popup-field-2 : Theme.popup-bg-inset;
                                            border-width: 1px;
                                            border-color: root.editing-error != ""
                                                ? Theme.danger
                                                : (new-name.has-focus ? Theme.accent.with-alpha(0.42) : Theme.mgr-line-strong);
                                            if new-name.has-focus && root.editing-error == "" : Rectangle {
                                                x: -3px;
                                                y: -3px;
                                                width: parent.width + 6px;
                                                height: parent.height + 6px;
                                                border-radius: Theme.radius-md + 3px;
                                                border-width: 3px;
                                                border-color: Theme.accent-soft;
                                            }
                                            HorizontalLayout {
                                                padding-left: 8px;
                                                padding-right: 5px;
                                                spacing: 7px;
                                                cross-axis-alignment: center;
                                                Rectangle {
                                                    width: 15px;
                                                    height: 15px;
                                                    border-radius: 8px;
                                                    background: (root.new-color != ""
                                                        ? root.new-swatch : root.next-color).with-alpha(0.18);
                                                    newdot-ta := TouchArea {
                                                        mouse-cursor: default;
                                                    changed has-hover => {
                                                        if (self.has-hover) {
                                                            root.tip-on(root.lang-en ? "Set color" : "改色",
                                                                self.absolute-position.x + self.mouse-x,
                                                                self.absolute-position.y + self.mouse-y);
                                                        } else { root.tip-off(); }
                                                    }
                                                    pointer-event(__ev) => {
                                                        if (__ev.kind == PointerEventKind.move && self.has-hover) {
                                                            root.tip-at(self.absolute-position.x + self.mouse-x,
                                                                self.absolute-position.y + self.mouse-y);
                                                        }
                                                    }
                                                        clicked => {
                                                            root.color-hex-for = root.new-color;
                                                            root.color-anchor-x = newdot-ta.absolute-position.x
                                                                - gm.absolute-position.x;
                                                            root.color-anchor-y = newdot-ta.absolute-position.y
                                                                - gm.absolute-position.y + newdot-ta.height - 2px;
                                                            root.color-for = root.color-for == "__new" ? "" : "__new";
                                                            root.move-menu = false;
                                                        }
                                                    }
                                                    Rectangle {
                                                        x: (parent.width - self.width) / 2;
                                                        y: (parent.height - self.height) / 2;
                                                        width: 9px;
                                                        height: 9px;
                                                        border-radius: 5px;
                                                        background: root.new-color != ""
                                                            ? root.new-swatch : root.next-color;
                                                    }
                                                }
                                                Rectangle {
                                                    horizontal-stretch: 1;
                                                    height: 100%;
                                                    new-name := TextInput {
                                                        width: 100%;
                                                        height: 100%;
                                                        init => { self.focus(); }
                                                        text <=> root.editing-text;
                                                        font-size: 12.5px;
                                                        color: Theme.text-primary;
                                                        vertical-alignment: center;
                                                        single-line: true;
                                                        edited => { root.editing-error = root.validate-name(root.editing-text, ""); }
                                                        accepted => { commit_edit(); }
                                                    }
                                                    if root.editing-text == "" : Text {
                                                        width: 100%;
                                                        height: 100%;
                                                        text: root.lang-en ? "New group name" : "新分组名";
                                                        color: Theme.text-muted;
                                                        font-size: 12.5px;
                                                        horizontal-alignment: left;
                                                        vertical-alignment: center;
                                                        overflow: elide;
                                                    }
                                                }
                                                // 清空 ×（与搜索框同款 20×20 命中 / 14px 圆）
                                                if root.editing-text != "" : Rectangle {
                                                    width: 20px;
                                                    height: 20px;
                                                    background: transparent;
                                                    nclear-ta := TouchArea {
                                                        mouse-cursor: default;
                                                        clicked => {
                                                            root.editing-text = "";
                                                            root.editing-error = "";
                                                        }
                                                    }
                                                    Rectangle {
                                                        width: 14px;
                                                        height: 14px;
                                                        x: (parent.width - self.width) / 2;
                                                        y: (parent.height - self.height) / 2;
                                                        border-radius: parent.width / 2;
                                                        background: nclear-ta.has-hover ? Theme.accent : transparent;
                                                        animate background { duration: 100ms; }
                                                        Icon {
                                                            glyph: "close";
                                                            tint: nclear-ta.has-hover ? Theme.popup-bg-inset : Theme.text-muted;
                                                            size: 9px;
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                        // 重名提示贴在输入行下方（红框 + 文案，与右栏同一套语义）
                                        if root.editing-error != "" : HorizontalLayout {
                                            padding-left: 9px;
                                            padding-top: 4px;
                                            Text {
                                                text: root.editing-error;
                                                color: Theme.danger;
                                                font-size: 10.5px;
                                                overflow: elide;
                                            }
                                        }
                                    }

                                    // 左栏搜索无结果：组行仍全部列出（压暗的 0/N），这里只作一行脚注。
                                    // 动作按钮与右栏「清除搜索」同款，左右两边不再各写一套。
                                    if root.query != "" && root.search-hits == 0 : Rectangle {
                                        height: 104px;
                                        VerticalLayout {
                                            alignment: center;
                                            padding-top: 6px;
                                            spacing: 7px;
                                            HorizontalLayout {
                                                alignment: center;
                                                Icon {
                                                    glyph: "search";
                                                    tint: Theme.text-muted;
                                                    size: 15px;
                                                    width: 15px;
                                                    height: 15px;
                                                }
                                            }
                                            Text {
                                                text: root.lang-en
                                                    ? "No matching group or session"
                                                    : "没有匹配的分组或会话";
                                                color: Theme.text-secondary;
                                                font-size: 11.5px;
                                                horizontal-alignment: center;
                                                overflow: elide;
                                            }
                                            HorizontalLayout {
                                                alignment: center;
                                                GmLinkBtn {
                                                    label: root.lang-en ? "Clear search" : "清除搜索";
                                                    clicked => {
                                                        root.query = "";
                                                        root.search("");
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                                }

                                // 组排序插入线（2px accent + 两端 6px 圆点；高保真 §插入线）
                                if root.dragging && root.drag-kind == "group"
                                    && root.drag-insert >= 0 : Rectangle {
                                    y: root.gi-top(root.drag-insert) - 1px - gsv.content-y;
                                    x: 8px;
                                    width: parent.width - 16px;
                                    height: 2px;
                                    background: Theme.accent-solid;
                                    Rectangle {
                                        x: -2px;
                                        y: -2px;
                                        width: 6px;
                                        height: 6px;
                                        border-radius: 3px;
                                        background: Theme.accent-solid;
                                    }
                                    Rectangle {
                                        x: parent.width - 4px;
                                        y: -2px;
                                        width: 6px;
                                        height: 6px;
                                        border-radius: 3px;
                                        background: Theme.accent-solid;
                                    }
                                }
                            }

                            // 新建按钮（高保真：吸底、32px、hover 转 accent）
                            HorizontalLayout {
                                height: root.creating ? 0px : 40px;
                                visible: !root.creating;
                                padding: 4px;
                                padding-left: 8px;
                                padding-right: 8px;
                                Rectangle {
                                    horizontal-stretch: 1;
                                    border-radius: Theme.radius-md;
                                    background: new-ta.has-hover
                                        ? Theme.accent.with-alpha(Theme.dark ? 0.10 : 0.08) : transparent;
                                    border-width: 1px;
                                    border-color: new-ta.has-hover ? Theme.accent.with-alpha(0.42) : Theme.mgr-line-strong;
                                    new-ta := TouchArea {
                                        mouse-cursor: default;
                                        clicked => {
                                            if (!commit_edit()) { return; }
                                            root.creating = true;
                                            root.edit-where = "left";
                                            root.editing = "";
                                            root.editing-text = "";
                                            root.editing-error = "";
                                            root.new-color = "";
                                            root.color-for = "";
                                        }
                                    }
                                    HorizontalLayout {
                                        alignment: center;
                                        spacing: 5px;
                                        Icon {
                                            glyph: "add";
                                            tint: new-ta.has-hover ? Theme.accent-solid : Theme.text-secondary;
                                            size: 12px;
                                        }
                                        Text {
                                            text: root.lang-en ? "New group" : "新建分组";
                                            color: new-ta.has-hover ? Theme.accent-solid : Theme.text-secondary;
                                            font-size: Theme.fs-xs;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // 两栏之间的 5px 命中区 + 1px 静默线（高保真 §调整两栏宽度）：
                    // 命中区居中压在线上，拖动时线转 accent 2px；双击回默认 320。
                    Rectangle {
                        width: 5px;
                        background: transparent;
                        sp-ta := TouchArea {
                            mouse-cursor: col-resize;
                        changed has-hover => {
                            if (self.has-hover) {
                                root.tip-on(root.lang-en
                                ? "Drag to resize · double-click to reset" : "拖动调整左栏宽度 · 双击复位",
                                    self.absolute-position.x + self.mouse-x,
                                    self.absolute-position.y + self.mouse-y);
                            } else { root.tip-off(); }
                        }
                            pointer-event(ev) => {
                                if (ev.kind == PointerEventKind.move && self.has-hover) {
                                    root.tip-at(self.absolute-position.x + self.mouse-x,
                                        self.absolute-position.y + self.mouse-y);
                                }
                                if (ev.kind == PointerEventKind.down) {
                                    root.sp-start = self.absolute-position.x + self.mouse-x;
                                    root.sp-base = root.left-w;
                                    root.sp-on = true;
                                } else if (ev.kind == PointerEventKind.up
                                    || ev.kind == PointerEventKind.cancel) {
                                    root.sp-on = false;
                                } else if (ev.kind == PointerEventKind.move && root.sp-on) {
                                    let dx = self.absolute-position.x + self.mouse-x - root.sp-start;
                                    root.left-w = Math.max(220px, Math.min(480px, root.sp-base + dx));
                                }
                            }
                            double-clicked => { root.left-w = 320px; }
                        }
                        Rectangle {
                            x: 2px;
                            width: root.sp-on || sp-ta.has-hover ? 2px : 1px;
                            height: 100%;
                            background: root.sp-on || sp-ta.has-hover
                                ? Theme.accent-solid : Theme.mgr-line;
                            animate background { duration: 120ms; }
                        }
                    }

                    // ── 右栏：当前组的成员 ──
                    Rectangle {
                        horizontal-stretch: 1;
                        background: Theme.popup-bg;
                        VerticalLayout {
                            spacing: 0px;

                            // 组头部 52px（高保真 10-22）：[色点][组名][n 个会话] 左对齐成组，
                            // 组名不吸空（否则计数会被推到大片空白右侧，与稿子相反）；
                            // 右端只留「全选 / 删除」，删除前置 1px 分隔线。
                            Rectangle {
                                height: 52px;
                                HorizontalLayout {
                                    padding-left: 16px;
                                    padding-right: 12px;
                                    spacing: 10px;
                                    cross-axis-alignment: center;

                                    // 色点 12px + 4px 同色光晕（点开色板）
                                    Rectangle {
                                        width: 20px;
                                        height: 20px;
                                        border-radius: 10px;
                                        background: root.cur-color-hex != ""
                                            ? root.cur-color.with-alpha(0.16) : transparent;
                                        rdot-ta := TouchArea {
                                            mouse-cursor: default;
                                        changed has-hover => {
                                            if (self.has-hover) {
                                                root.tip-on(root.lang-en ? "Set color" : "改色",
                                                    self.absolute-position.x + self.mouse-x,
                                                    self.absolute-position.y + self.mouse-y);
                                            } else { root.tip-off(); }
                                        }
                                        pointer-event(__ev) => {
                                            if (__ev.kind == PointerEventKind.move && self.has-hover) {
                                                root.tip-at(self.absolute-position.x + self.mouse-x,
                                                    self.absolute-position.y + self.mouse-y);
                                            }
                                        }
                                            clicked => {
                                                commit_edit();
                                                root.color-hex-for = root.cur-color-hex;
                                                root.color-anchor-x = rdot-ta.absolute-position.x
                                                    - gm.absolute-position.x;
                                                root.color-anchor-y = rdot-ta.absolute-position.y
                                                    - gm.absolute-position.y + rdot-ta.height - 2px;
                                                root.color-for = root.color-for == root.cur-name
                                                    ? "" : root.cur-name;
                                                root.move-menu = false;
                                                root.del-menu = false;
                                            }
                                        }
                                        Rectangle {
                                            x: (parent.width - self.width) / 2;
                                            y: (parent.height - self.height) / 2;
                                            width: 12px;
                                            height: 12px;
                                            border-radius: 6px;
                                            background: root.cur-color-hex != "" ? root.cur-color : transparent;
                                            border-width: root.cur-color-hex != "" ? 0px : 1px;
                                            border-color: Theme.text-muted;
                                        }
                                    }

                                    // 组名 / 编辑框：单击不进入编辑，双击才改（避免「想点标题却开了编辑框」）
                                    if root.editing != "" && root.editing == root.cur-name
                                        && root.edit-where == "right" : Rectangle {
                                        width: 200px;
                                        height: 26px;
                                        border-radius: Theme.radius-sm;
                                        background: rhd-edit.has-focus
                                            ? Theme.popup-field-2 : Theme.popup-bg-inset;
                                        border-width: 1px;
                                        border-color: root.editing-error != ""
                                            ? Theme.danger
                                            : (rhd-edit.has-focus ? Theme.accent.with-alpha(0.42) : Theme.mgr-line-strong);
                                        if rhd-edit.has-focus && root.editing-error == "" : Rectangle {
                                            x: -3px;
                                            y: -3px;
                                            width: parent.width + 6px;
                                            height: parent.height + 6px;
                                            border-radius: Theme.radius-sm + 3px;
                                            border-width: 3px;
                                            border-color: Theme.accent-soft;
                                        }
                                        rhd-edit := TextInput {
                                            x: 6px;
                                            width: parent.width - 12px;
                                            height: parent.height;
                                            init => { self.focus(); }
                                            text <=> root.editing-text;
                                            font-size: 14px;
                                            font-weight: 650;
                                            color: Theme.text-primary;
                                            vertical-alignment: center;
                                            single-line: true;
                                            edited => { root.editing-error = root.validate-name(root.editing-text, root.editing); }
                                            accepted => { commit_edit(); }
                                        }
                                    }
                                    if !(root.editing != "" && root.editing == root.cur-name
                                        && root.edit-where == "right") : Text {
                                        // 宽度随内容、封顶 250（高保真 §右栏头部），不吸空
                                        horizontal-stretch: 0;
                                        max-width: 250px;
                                        text: root.cur-name;
                                        color: Theme.text-primary;
                                        font-size: 15px;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                        overflow: elide;
                                        rtt-ta := TouchArea {
                                            mouse-cursor: default;
                                            double-clicked => {
                                                // 「未分组」不可改名（高保真 §RULES）
                                                if (!root.cur-reserved) {
                                                    start_edit(root.cur-name);
                                                    root.edit-where = "right";
                                                }
                                            }
                                        }
                                    }

                                    // 计数胶囊：紧贴组名（同一组视觉），accent-soft 底 + accent 字
                                    Rectangle {
                                        height: 21px;
                                        border-radius: 8px;
                                        background: Theme.accent-soft;
                                        HorizontalLayout {
                                            padding-left: 8px;
                                            padding-right: 8px;
                                            alignment: center;
                                            Text {
                                                text: root.total-count
                                                    + (root.lang-en ? " sessions" : " 个会话");
                                                color: Theme.accent;
                                                font-size: 11px;
                                                font-family: Theme.font-mono;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                    Rectangle { horizontal-stretch: 1; height: 1px; }

                                    // 全选 / 取消全选（勾满当前列表时切文案）
                                    if root.total-count > 0 : Rectangle {
                                        height: 26px;
                                        border-radius: Theme.radius-sm;
                                        background: all-ta.has-hover ? Theme.bg-hover : transparent;
                                        all-ta := TouchArea {
                                            mouse-cursor: default;
                                            clicked => {
                                                if (root.picked-count >= root.total-count) {
                                                    root.clear-picks();
                                                } else {
                                                    root.paint-pick(0, root.total-count - 1, true);
                                                }
                                            }
                                        }
                                        HorizontalLayout {
                                            padding-left: 9px;
                                            padding-right: 9px;
                                            alignment: center;
                                            Text {
                                                text: root.picked-count >= root.total-count
                                                    ? (root.lang-en ? "Clear" : "取消全选")
                                                    : (root.lang-en ? "Select all" : "全选");
                                                color: root.picked-count > 0
                                                    ? Theme.accent-solid : Theme.text-secondary;
                                                font-size: 11.5px;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                    // 删除：唯一入口，与「全选」用 1px 竖线隔开
                                    if !root.cur-reserved : Rectangle {
                                        width: 1px;
                                        height: 16px;
                                        background: Theme.mgr-line;
                                    }
                                    if !root.cur-reserved : Rectangle {
                                        width: 28px;
                                        height: 28px;
                                        border-radius: Theme.radius-sm;
                                        background: delg-ta.has-hover
                                            ? Theme.danger.with-alpha(0.14) : transparent;
                                        animate background { duration: 100ms; }
                                        delg-ta := TouchArea {
                                            mouse-cursor: default;
                                            clicked => {
                                                commit_edit();
                                                root.confirm-del = root.cur-name;
                                                root.del-target = "";
                                                root.clear-picks();
                                                root.move-menu = false;
                                                root.color-for = "";
                                            }
                                        }
                                        Icon {
                                            glyph: "delete";
                                            tint: delg-ta.has-hover ? Theme.danger : Theme.text-secondary;
                                            size: 14px;
                                        }
                                    }
                                }
                                Rectangle {
                                    y: parent.height - 1px;
                                    width: 100%;
                                    height: 1px;
                                    background: Theme.mgr-line-soft;
                                }
                            }

                            // 改名失败提示：单独占一行 —— 塞进 52px 头部只会被压成
                            // 「已存…」这种读不出来的碎片（用户截图）。
                            if root.editing-error != "" && root.edit-where == "right" : Rectangle {
                                height: 22px;
                                background: Theme.danger.with-alpha(0.10);
                                HorizontalLayout {
                                    padding-left: 16px;
                                    padding-right: 12px;
                                    spacing: 6px;
                                    cross-axis-alignment: center;
                                    Icon { glyph: "warning"; tint: Theme.danger; size: 11px; }
                                    Text {
                                        text: root.editing-error;
                                        color: Theme.danger;
                                        font-size: 11px;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                    // 尾部吸空块：没有它余量会均摊到图标/文字之间，文案被推开
                                    Rectangle { horizontal-stretch: 1; height: 1px; }
                                }
                                Rectangle {
                                    y: parent.height - 1px;
                                    width: 100%;
                                    height: 1px;
                                    background: Theme.danger.with-alpha(0.34);
                                }
                            }

                            // 删除条（52px 单行）：[⚠] 删除「X」？ n 个会话将移到 [去向] … [取消][删除]
                            // 文案按「一句话 + 内嵌下拉」组织：原来末尾那个「→」指向空气，
                            // 读起来像还有下文。
                            if root.confirm-del != "" : Rectangle {
                                height: 52px;
                                background: Theme.danger.with-alpha(0.10);
                                HorizontalLayout {
                                    padding-left: 16px;
                                    padding-right: 12px;
                                    spacing: 8px;
                                    cross-axis-alignment: center;
                                    Icon { glyph: "warning"; tint: Theme.danger; size: 14px; }
                                    Text {
                                        text: (root.lang-en ? "Delete " : "删除「") + root.confirm-del
                                            + (root.lang-en ? "?" : "」？");
                                        color: Theme.text-primary;
                                        font-size: 12px;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                    Text {
                                        text: root.cur_total() == 0
                                            ? (root.lang-en ? "Empty group." : "该分组为空。")
                                            : (root.cur_total() + (root.lang-en
                                                ? " sessions will move to" : " 个会话将移到"));
                                        color: Theme.text-secondary;
                                        font-size: 11px;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                    // 去向：空组时整块隐藏（没有可搬的东西，不摆一个没意义的控件）
                                    if root.cur_total() > 0 : Rectangle {
                                        height: 26px;
                                        border-radius: Theme.radius-sm;
                                        background: Theme.popup-bg-inset;
                                        border-width: 1px;
                                        border-color: root.del-menu ? Theme.accent.with-alpha(0.42) : Theme.mgr-line-strong;
                                        dsel-ta := TouchArea {
                                            mouse-cursor: default;
                                            clicked => {
                                                root.del-menu-x = dsel-ta.absolute-position.x
                                                    + dsel-ta.width / 2 - gm.absolute-position.x;
                                                root.del-menu = !root.del-menu;
                                                root.move-menu = false;
                                                root.color-for = "";
                                            }
                                        }
                                        HorizontalLayout {
                                            padding-left: 9px;
                                            padding-right: 7px;
                                            spacing: 5px;
                                            cross-axis-alignment: center;
                                            Text {
                                                text: root.del-target == "" ? (root.lang-en ? "Default" : "默认组") : root.del-target;
                                                color: Theme.text-primary;
                                                font-size: 11px;
                                                vertical-alignment: center;
                                            }
                                            Icon {
                                                glyph: "expand-more";
                                                tint: Theme.text-muted;
                                                size: 10px;
                                            }
                                        }
                                    }
                                    Rectangle { horizontal-stretch: 1; height: 1px; }
                                    // 两个动作按钮同宽下限 54（中文两字在 11px 下会被挤成窄块）
                                    Rectangle {
                                        width: 54px;
                                        height: 26px;
                                        border-radius: Theme.radius-sm;
                                        border-width: 1px;
                                        border-color: Theme.mgr-line-strong;
                                        background: dcan-ta.has-hover ? Theme.bg-hover : Theme.popup-bg-inset;
                                        dcan-ta := TouchArea {
                                            mouse-cursor: default;
                                            clicked => { root.confirm-del = ""; root.del-menu = false; }
                                        }
                                        Text {
                                            text: root.lang-en ? "Cancel" : "取消";
                                            color: Theme.text-secondary;
                                            font-size: 11px;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                    Rectangle {
                                        height: 26px;
                                        border-radius: Theme.radius-sm;
                                        border-width: 1px;
                                        border-color: Theme.danger.with-alpha(0.34);
                                        background: dk-ta.has-hover
                                            ? Theme.danger.with-alpha(0.22) : Theme.danger.with-alpha(0.14);
                                        dk-ta := TouchArea {
                                            mouse-cursor: default;
                                            clicked => {
                                                // 先把结果算好：remove 之后这一行数据就没了
                                                let n = root.cur_total();
                                                let target = root.del-target == ""
                                                    ? (root.lang-en ? "Default" : "默认组")
                                                    : root.del-target;
                                                root.toast = root.lang-en
                                                    ? "Deleted " + root.confirm-del + " · "
                                                        + n + " sessions moved to " + target
                                                    : "已删除「" + root.confirm-del + "」· "
                                                        + n + " 个会话移到 " + target;
                                                root.remove-group(root.confirm-del, root.del-target);
                                                root.confirm-del = "";
                                                root.del-menu = false;
                                                root.clear-picks();
                                            }
                                        }
                                        HorizontalLayout {
                                            padding-left: 12px;
                                            padding-right: 12px;
                                            alignment: center;
                                            Text {
                                                text: root.lang-en ? "Delete group" : "删除分组";
                                                color: Theme.danger;
                                                font-size: 11px;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }
                                Rectangle {
                                    y: parent.height - 1px;
                                    width: 100%;
                                    height: 1px;
                                    background: Theme.danger.with-alpha(0.34);
                                }
                            }

                            // 成员列表
                            mlist := Rectangle {
                                vertical-stretch: 1;
                                clip: true;
                                // 成员多时滚动（高保真：弹框高度不变，列表滚动）
                                msv := ScrollView {
                                    width: 100%;
                                    height: 100%;
                                    mouse-drag-pan-enabled: false;
                                    // 切组后滚回顶部（高保真 §切组）。`changed` 只认本元素自己的
                                    // 属性，所以拿一个局部镜像盯 root.selected，变化即复位。
                                    property <string> sel-watch: root.selected;
                                    changed sel-watch => { self.content-y = 0px; }
                                mem-lay := VerticalLayout {
                                    padding-top: 6px;
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    padding-bottom: 56px;   // 给批量条留位（高保真 §批量条），列表不跳
                                    spacing: 0px;
                                    // 空组：整块在列表里垂直居中（有成员时仍从上排）
                                    alignment: root.total-count == 0 ? center : start;
                                    // (#gm-hit-y 2026-10-23) 刷选命中同理不缓存 mem-top：
                                    // changed absolute-position 初次布局不触发，直接读
                                    // mem-lay.absolute-position.y（随滚动正确）。

                                    // 空态①：搜索没有任何命中（全局 0 命中）
                                    if root.total-count == 0 && root.query != "" && root.search-hits == 0 : Rectangle {
                                        height: 190px;
                                        VerticalLayout {
                                            alignment: center;
                                            padding-left: 28px;
                                            padding-right: 28px;
                                            spacing: 8px;
                                            HorizontalLayout {
                                                alignment: center;
                                                Icon {
                                                    glyph: "search";
                                                    tint: Theme.text-muted;
                                                    size: 20px;
                                                    width: 20px;
                                                    height: 20px;
                                                }
                                            }
                                            Text {
                                                text: root.lang-en
                                                    ? "No match in any group" : "所有分组里都没有匹配";
                                                color: Theme.text-secondary;
                                                font-size: 12.5px;
                                                horizontal-alignment: center;
                                            }
                                            Text {
                                                text: root.lang-en
                                                    ? "Nothing matches \"" + root.query + "\""
                                                    : "「" + root.query + "」没有命中任何分组名、会话名或地址";
                                                color: Theme.text-muted;
                                                font-size: 11px;
                                                horizontal-alignment: center;
                                                wrap: word-wrap;
                                            }
                                            // 定宽按钮必须包一层 alignment:center 的 HL ——
                                            // VerticalLayout 的交叉轴只负责拉伸，不会居中固定宽度
                                            HorizontalLayout {
                                                alignment: center;
                                                height: 22px;
                                                GmLinkBtn {
                                                    label: root.lang-en ? "Clear search" : "清除搜索";
                                                    clicked => {
                                                        root.query = "";
                                                        root.search("");
                                                        q-ta.focus();
                                                    }
                                                }
                                            }
                                        }
                                    }
                                    // 空态②：本组没有，但别处还有 → 给「跳过去」
                                    if root.total-count == 0 && root.query != "" && root.search-hits > 0 : Rectangle {
                                        height: 190px;
                                        VerticalLayout {
                                            alignment: center;
                                            padding-left: 28px;
                                            padding-right: 28px;
                                            spacing: 8px;
                                            HorizontalLayout {
                                                alignment: center;
                                                Icon {
                                                    glyph: "search";
                                                    tint: Theme.text-muted;
                                                    size: 20px;
                                                    width: 20px;
                                                    height: 20px;
                                                }
                                            }
                                            Text {
                                                text: root.lang-en ? "No match in this group" : "本组没有匹配";
                                                color: Theme.text-secondary;
                                                font-size: 12.5px;
                                                horizontal-alignment: center;
                                            }
                                            Text {
                                                text: root.lang-en
                                                    ? root.search-hits + " matches in other groups"
                                                    : "其他分组里还有 " + root.search-hits + " 个结果";
                                                color: Theme.text-muted;
                                                font-size: 11px;
                                                horizontal-alignment: center;
                                                wrap: word-wrap;
                                            }
                                            if root.search-jump != "" : HorizontalLayout {
                                                alignment: center;
                                                height: 22px;
                                                GmLinkBtn {
                                                    label: (root.lang-en ? "Go to " : "跳到「")
                                                        + root.search-jump
                                                        + (root.lang-en ? "" : "」");
                                                    clicked => {
                                                        root.selected = root.search-jump;
                                                        root.clear-picks();
                                                        root.select(root.search-jump);
                                                    }
                                                }
                                            }
                                        }
                                    }
                                    // 空态③：真空组。**这里不是投放区** —— 右栏只列当前组的成员，
                                    // 任何拖拽都不可能落到这块画布上，所以原来「把会话拖到这里」
                                    // 的虚线框是个假 affordance（用户实测：压根拖不过来）。
                                    // 现在只说明真的可行的两条路：拖到左栏组名、或在别的组用「移动到」。
                                    if root.total-count == 0 && root.query == "" : Rectangle {
                                        height: 168px;
                                        VerticalLayout {
                                            alignment: center;
                                            padding-left: 24px;
                                            padding-right: 24px;
                                            spacing: 8px;
                                            HorizontalLayout {
                                                alignment: center;
                                                Icon {
                                                    glyph: "folder";
                                                    tint: Theme.text-muted;
                                                    size: 22px;
                                                    width: 22px;
                                                    height: 22px;
                                                }
                                            }
                                            Text {
                                                text: root.lang-en
                                                    ? "No sessions in this group"
                                                    : "这个分组还没有会话";
                                                color: Theme.text-secondary;
                                                font-size: 12.5px;
                                                horizontal-alignment: center;
                                            }
                                            Text {
                                                text: root.lang-en
                                                    ? "Drag sessions onto the group name on the left, or use Move to from another group."
                                                    : "把会话拖到左侧的分组名上，或在其他分组里用「移动到」移进来。";
                                                color: Theme.text-muted;
                                                font-size: 11px;
                                                horizontal-alignment: center;
                                                wrap: word-wrap;
                                            }
                                        }
                                    }

                                    for j in root.members.length : Rectangle {
                                        height: root.mem-h;
                                        border-radius: Theme.radius-md;
                                        // 被拖的行（含整批）35% 透明（高保真 §拖拽）
                                        opacity: root.drag-kind == "member" && root.dragging
                                            && (root.members[j].picked
                                                || root.drag-id == root.members[j].id) ? 0.35 : 1.0;
                                        background: root.members[j].picked
                                            ? Theme.accent.with-alpha(0.08)
                                            : (mrow-ta.has-hover || mu-ta.has-hover || md-ta.has-hover
                                                ? Theme.bg-hover : transparent);

                                        mrow-ta := TouchArea {
                                            mouse-cursor: default;
                                            changed has-hover => {
                                                if (self.has-hover) {
                                                    root.hover-row = j;
                                                } else if (root.hover-row == j) {
                                                    root.hover-row = -1;
                                                }
                                            }
                                            pointer-event(ev) => {
                                                if (ev.kind == PointerEventKind.down) {
                                                    root.press-x = self.absolute-position.x + self.mouse-x;
                                                    root.press-y = self.absolute-position.y + self.mouse-y;
                                                    root.dragging = false;
                                                    root.down-row = j;
                                                    root.press-row = j;
                                                    root.pick-anchor = j;
                                                    root.pick-on = !root.members[j].picked;
                                                    root.pick-sweeping = false;
                                                    return;
                                                }
                                                if (ev.kind == PointerEventKind.move) {
                                                    let ax = self.absolute-position.x + self.mouse-x;
                                                    let ay = self.absolute-position.y + self.mouse-y;
                                                    // 悬浮卡贴鼠标：未按下时 move 也会来（TouchArea.moved 不会）
                                                    if (!root.dragging) {
                                                        root.tip-mx = ax - gm.absolute-position.x;
                                                        root.tip-my = ay - gm.absolute-position.y;
                                                    }
                                                    if (!self.pressed) { return; }
                                                    if (root.editing != "" || root.creating
                                                        || root.query != "") { return; }
                                                    if (!root.dragging) {
                                                        let dx = ax - root.press-x;
                                                        let dy = ay - root.press-y;
                                                        // >5px 才起拖（纯点击不会误拖）
                                                        if (dx > -5px && dx < 5px
                                                            && dy > -5px && dy < 5px) { return; }
                                                        root.dragging = true;
                                                        root.drag-kind = "member";
                                                        root.drag-id = root.members[j].id;
                                                        root.drag-label = root.members[j].name;
                                                        root.drag-index = j;
                                                    }
                                                    if (root.drag-kind == "member") {
                                                        root.drag-abs-x = ax;
                                                        root.drag-abs-y = ay;
                                                        let off = Math.round(self.mouse-y / root.mem-h);
                                                        root.drag-to = Math.max(0, Math.min(
                                                            root.members.length - 1, j + off));
                                                        root.drop-group = ax
                                                            < gm.absolute-position.x + root.left-w;
                                                        root.drop-gi = root.drop-group
                                                            ? root.gi-at(ay - glay.absolute-position.y - 8px)
                                                            : -1;
                                                        root.drag-insert = root.drop-group
                                                            ? -1
                                                            : (root.drag-to > root.drag-index
                                                                ? root.drag-to + 1 : root.drag-to);
                                                    }
                                                    return;
                                                }
                                                if (ev.kind != PointerEventKind.up) { return; }
                                                // 纯点击（按下与松开同一行）→ 勾选整行
                                                // 删除条展开时不接受勾选：那个状态只等你确认「移到哪 / 删」
                                                if (!root.dragging) {
                                                    if (root.down-row == j && root.confirm-del == "") {
                                                        root.toggle-pick(root.members[j].id);
                                                    }
                                                    root.down-row = -1;
                                                    return;
                                                }
                                                if (root.drag-kind == "member") {
                                                    if (root.drop-group) {
                                                        // 左栏：按指针绝对 y 命中组行（含小节标题偏移）
                                                        let gi = root.gi-at(
                                                            root.drag-abs-y - glay.absolute-position.y - 8px);
                                                        let whole = root.picked-count > 0
                                                            && root.members[j].picked;
                                                        let n = whole ? root.picked-count : 1;
                                                        if (root.groups[gi].name != root.selected) {
                                                            if (root.lang-en) {
                                                                root.toast = n + " sessions → "
                                                                    + (root.groups[gi].reserved
                                                                        ? "Default" : root.groups[gi].name);
                                                            } else {
                                                                root.toast = n + " 个会话 → "
                                                                    + (root.groups[gi].reserved
                                                                        ? "默认组" : root.groups[gi].name);
                                                            }
                                                            root.move-members(root.members[j].id,
                                                                root.groups[gi].reserved ? "" : root.groups[gi].name,
                                                                whole);
                                                        }
                                                    } else if (root.drag-to != root.drag-index) {
                                                        let to = root.drag-to;
                                                        let last = root.members.length - 1;
                                                        let before = to > root.drag-index
                                                            ? (to >= last ? root.members[last].id : root.members[to + 1].id)
                                                            : root.members[to].id;
                                                        let after = to > root.drag-index && to >= last;
                                                        root.reorder-members(root.members[j].id, before,
                                                            after, root.picked-count > 0);
                                                    }
                                                }
                                                root.dragging = false;
                                                root.drag-kind = "";
                                                root.drag-id = "";
                                                root.drop-group = false;
                                                root.drop-gi = -1;
                                                root.drag-insert = -1;
                                                root.down-row = -1;
                                            }
                                        }
                                        HorizontalLayout {
                                            // 左 10 / 右 10：复选框命中区 22 居中放 15px 方块
                                            padding-left: 10px;
                                            padding-right: 10px;
                                            spacing: 8px;
                                            cross-axis-alignment: center;

                                            // 复选框：视觉 15px，命中区 22px（刷选这一列不能太窄）
                                            Rectangle {
                                                width: 22px;
                                                height: 22px;
                                                cb-ta := TouchArea {
                                                    mouse-cursor: default;
                                                    clicked => {
                                                        // 删除条展开时不接受勾选
                                                        if (root.confirm-del != "") { return; }
                                                        // 范围勾选 / 刷选结束的同一次释放不算单击
                                                        if (root.shift-pending) {
                                                            root.shift-pending = false;
                                                            return;
                                                        }
                                                        if (root.pick-sweeping) {
                                                            root.pick-sweeping = false;
                                                            return;
                                                        }
                                                        root.toggle-pick(root.members[j].id);
                                                        root.press-row = j;
                                                        root.move-menu = false;
                                                    }
                                                    pointer-event(ev) => {
                                                        if (ev.kind == PointerEventKind.down) {
                                                            // 锚点 = 按下的这一行；取反 = 从已选行起拖是擦除
                                                            root.shift-pending = false;
                                                            root.pick-anchor = j;
                                                            root.pick-on = !root.members[j].picked;
                                                            root.pick-sweeping = false;
                                                            // Shift + 点复选框 = 从上次点击行到这个范围按目标态整段置位
                                                            if (ev.modifiers.shift && root.press-row >= 0
                                                                && root.press-row != j) {
                                                                root.paint-pick(root.press-row, j,
                                                                    !root.members[j].picked);
                                                                root.shift-pending = true;
                                                            }
                                                            root.press-row = j;
                                                        } else if (ev.kind == PointerEventKind.up) {
                                                            root.pick-anchor = -1;
                                                        }
                                                    }
                                                    // 刷选：按住这一列上下拖，经过即画成锚点取反后的状态
                                                    moved => {
                                                        if (root.pick-anchor < 0) { return; }
                                                        root.pick-sweeping = true;
                                                        let ay = self.absolute-position.y + self.mouse-y;
                                                        let to = Math.max(0, Math.min(root.members.length - 1,
                                                            Math.floor((ay - mem-lay.absolute-position.y - 6px)
                                                                / root.mem-h)));
                                                        root.paint-pick(root.pick-anchor, to, root.pick-on);
                                                    }
                                                }
                                                Rectangle {
                                                    x: (parent.width - self.width) / 2;
                                                    y: (parent.height - self.height) / 2;
                                                    width: 15px;
                                                    height: 15px;
                                                    border-radius: 4px;
                                                    background: root.members[j].picked
                                                        ? Theme.accent-solid : transparent;
                                                    border-width: 1px;
                                                    border-color: root.members[j].picked
                                                        ? Theme.accent-solid : Theme.mgr-line-strong;
                                                    if root.members[j].picked : Icon {
                                                        glyph: "check";
                                                        tint: white;
                                                        size: 10px;
                                                    }
                                                }
                                            }
                                            ProtocolIcon {
                                                proto-id: root.members[j].kind;
                                                width: 17px;
                                                height: 17px;
                                                icon-color: Theme.text-muted;
                                                icon-size: 16px;
                                            }
                                            HorizontalLayout {
                                                horizontal-stretch: 1;
                                                spacing: 8px;
                                                cross-axis-alignment: center;
                                                Text {
                                                    horizontal-stretch: 1;
                                                    text: root.members[j].name;
                                                    color: Theme.text-primary;
                                                    font-size: 12.5px;
                                                    overflow: elide;
                                                    vertical-alignment: center;
                                                }
                                                // user@host 并排（高保真 10-22：单行，地址贴右、优先保完整）
                                                Text {
                                                    text: root.members[j].user != ""
                                                        ? root.members[j].user + "@" + root.members[j].host
                                                        : root.members[j].host;
                                                    color: Theme.text-muted;
                                                    font-size: 10.5px;
                                                    font-family: Theme.font-mono;
                                                    overflow: elide;
                                                    vertical-alignment: center;
                                                }
                                            }
                                            // 上移 / 下移：常占位、悬停渐显、边界置灰；搜索时禁用
                                            HorizontalLayout {
                                                spacing: 1px;
                                                // ⚠️ 只判整行 hover 会让按钮「一移过去就消失」：
                                                // 指针到按钮上时整行 TouchArea 已失去 hover。
                                                opacity: mrow-ta.has-hover
                                                    || mu-ta.has-hover || md-ta.has-hover ? 1.0 : 0.0;
                                                animate opacity { duration: 120ms; }
                                                Rectangle {
                                                    width: 16px;
                                                    height: 16px;
                                                    border-radius: Theme.radius-sm;
                                                    background: mu-ta.has-hover ? Theme.bg-hover : transparent;
                                                    mu-ta := TouchArea {
                                                        enabled: j > 0 && root.query == "";
                                                        mouse-cursor: default;
                                                        clicked => {
                                                            // 这条已勾选且勾了多条 → 整块移动（看得见的勾选态即判据）
                                                            if (root.picked-count > 1 && root.members[j].picked) {
                                                                root.step-members(-1);
                                                            } else {
                                                                root.reorder-members(root.members[j].id,
                                                                    root.members[j - 1].id, false, false);
                                                            }
                                                        }
                                                    }
                                                    Icon {
                                                        glyph: "arrow-up";
                                                        tint: Theme.text-secondary;
                                                        size: 10px;
                                                        opacity: j > 0 && root.query == "" ? 1.0 : 0.3;
                                                    }
                                                }
                                                Rectangle {
                                                    width: 16px;
                                                    height: 16px;
                                                    border-radius: Theme.radius-sm;
                                                    background: md-ta.has-hover ? Theme.bg-hover : transparent;
                                                    md-ta := TouchArea {
                                                        enabled: j < root.members.length - 1 && root.query == "";
                                                        mouse-cursor: default;
                                                        clicked => {
                                                            if (root.picked-count > 1 && root.members[j].picked) {
                                                                root.step-members(1);
                                                            } else {
                                                                let last = root.members.length - 1;
                                                                root.reorder-members(root.members[j].id,
                                                                    root.members[j + 1].id, j + 1 >= last, false);
                                                            }
                                                        }
                                                    }
                                                    Icon {
                                                        glyph: "arrow-down";
                                                        tint: Theme.text-secondary;
                                                        size: 10px;
                                                        opacity: j < root.members.length - 1 && root.query == "" ? 1.0 : 0.3;
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                                }

                                // 成员排序插入线（2px accent + 两端 6px 圆点；高保真 §插入线）
                                if root.dragging && root.drag-kind == "member"
                                    && root.drag-insert >= 0 : Rectangle {
                                    y: 6px + root.drag-insert * root.mem-h - 1px - msv.content-y;
                                    x: 8px;
                                    width: parent.width - 16px;
                                    height: 2px;
                                    background: Theme.accent-solid;
                                    Rectangle {
                                        x: -2px;
                                        y: -2px;
                                        width: 6px;
                                        height: 6px;
                                        border-radius: 3px;
                                        background: Theme.accent-solid;
                                    }
                                    Rectangle {
                                        x: parent.width - 4px;
                                        y: -2px;
                                        width: 6px;
                                        height: 6px;
                                        border-radius: 3px;
                                        background: Theme.accent-solid;
                                    }
                                }
                            }
                        }

                        // 批量条：浮在列表底部（不占流 —— 刷选时不会推挤列表）
                        // 高保真 §批量条：46px / 左右各 10 / 底 10 / accent 淡底 + 42% 描边
                        if root.picked-count > 0 && root.confirm-del == "" : Rectangle {
                            x: 10px;
                            y: parent.height - 56px;
                            width: parent.width - 20px;
                            height: 46px;
                            border-radius: 9px;
                            background: Theme.accent.with-alpha(Theme.dark ? 0.15 : 0.10);
                            border-width: 1px;
                            border-color: Theme.accent.with-alpha(0.42);
                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 10px;
                                spacing: 8px;
                                cross-axis-alignment: center;
                                Text {
                                    text: root.lang-en ? "Selected " : "已选 ";
                                    color: Theme.text-primary;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: root.picked-count + (root.lang-en ? "" : " 项");
                                    color: Theme.accent-solid;
                                    font-size: 12px;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                }
                                Rectangle { horizontal-stretch: 1; height: 1px; }
                                // 「移动到 ▾」
                                Rectangle {
                                    height: 26px;
                                    border-radius: Theme.radius-sm;
                                    border-width: 1px;
                                    border-color: root.move-menu ? Theme.accent.with-alpha(0.42) : Theme.mgr-line-strong;
                                    background: mv-ta.has-hover
                                        ? Theme.bg-hover : Theme.popup-bg-elevated;
                                    mv-ta := TouchArea {
                                        mouse-cursor: default;
                                        clicked => {
                                            root.move-menu-x = mv-ta.absolute-position.x
                                                + mv-ta.width / 2 - gm.absolute-position.x;
                                            root.move-menu = !root.move-menu;
                                            root.color-for = "";
                                            root.del-menu = false;
                                        }
                                    }
                                    HorizontalLayout {
                                        padding-left: 10px;
                                        padding-right: 8px;
                                        spacing: 4px;
                                        alignment: center;
                                        Text {
                                            text: root.lang-en ? "Move to" : "移动到";
                                            color: Theme.text-secondary;
                                            font-size: 11px;
                                            vertical-alignment: center;
                                        }
                                        Icon { glyph: "expand-more"; tint: Theme.text-muted; size: 10px; }
                                    }
                                }
                                // 「移出分组」：在未分组视图里没有意义 → 不出现
                                if !root.cur-reserved : Rectangle {
                                    height: 26px;
                                    border-radius: Theme.radius-sm;
                                    border-width: 1px;
                                    border-color: Theme.mgr-line-strong;
                                    background: mo-ta.has-hover
                                        ? Theme.bg-hover : Theme.popup-bg-elevated;
                                    mo-ta := TouchArea {
                                        mouse-cursor: default;
                                        clicked => {
                                            root.toast = root.lang-en
                                                ? root.picked-count + " sessions moved to Default"
                                                : root.picked-count + " 个会话已移回默认组";
                                            root.move-out("", true);
                                        }
                                    }
                                    HorizontalLayout {
                                        padding-left: 10px;
                                        padding-right: 10px;
                                        alignment: center;
                                        Text {
                                            text: root.lang-en ? "Ungroup" : "移出分组";
                                            color: Theme.text-secondary;
                                            font-size: 11px;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                                // 「取消选择」
                                Rectangle {
                                    height: 26px;
                                    border-radius: Theme.radius-sm;
                                    border-width: 1px;
                                    border-color: Theme.mgr-line-strong;
                                    background: cl-ta.has-hover
                                        ? Theme.bg-hover : Theme.popup-bg-elevated;
                                    cl-ta := TouchArea {
                                        mouse-cursor: default;
                                        clicked => { root.clear-picks(); root.move-menu = false; }
                                    }
                                    HorizontalLayout {
                                        padding-left: 10px;
                                        padding-right: 10px;
                                        alignment: center;
                                        Text {
                                            text: root.lang-en ? "Clear" : "取消选择";
                                            color: Theme.text-secondary;
                                            font-size: 11px;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }

                        // 「移动到」下拉：锚在按钮右缘（不是贴面板右缘），带标题与「已选 N 项」
                        if root.move-menu : Rectangle {
                            width: 186px;
                            // 标题 20 + 行 × 28 + 分隔 1 + 已选 20 + 上下内边距 10
                            height: 51px + root.menu_rows() * 28px;
                            // 以「移动到」按钮中心为轴居中
                            x: Math.max(4px, Math.min(
                                root.move-menu-x - (root.left-w + 5px) - self.width / 2,
                                parent.width - self.width - 4px));
                            y: parent.height - 62px - self.height;
                            border-radius: Theme.radius-md;
                            background: Theme.popup-bg-elevated;
                            border-width: 1px;
                            border-color: Theme.border-strong;
                            VerticalLayout {
                                padding: 5px;
                                spacing: 0px;
                                alignment: start;
                                HorizontalLayout {
                                    height: 20px;
                                    padding-left: 3px;
                                    Text {
                                        text: root.lang-en ? "Move to" : "移动到";
                                        color: Theme.text-muted;
                                        font-size: 10px;
                                        vertical-alignment: center;
                                    }
                                }
                                for g in root.groups : Rectangle {
                                    height: g.name == root.cur-name ? 0px : 28px;
                                    visible: g.name != root.cur-name;
                                    border-radius: Theme.radius-sm;
                                    background: mm-ta.has-hover ? Theme.bg-hover : transparent;
                                    mm-ta := TouchArea {
                                        mouse-cursor: default;
                                        clicked => {
                                            root.toast = root.lang-en
                                                ? root.picked-count + " sessions → " + g.name
                                                : root.picked-count + " 个会话 → " + g.name;
                                            root.move-members("", g.reserved ? "" : g.name, true);
                                            root.move-menu = false;
                                        }
                                    }
                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        spacing: 7px;
                                        cross-axis-alignment: center;
                                        Rectangle {
                                            width: 9px;
                                            height: 9px;
                                            border-radius: 5px;
                                            background: g.color-hex != "" ? g.color : transparent;
                                            border-width: g.color-hex != "" ? 0px : 1px;
                                            border-color: Theme.text-muted;
                                        }
                                        Text {
                                            horizontal-stretch: 1;
                                            text: g.name;
                                            color: Theme.text-primary;
                                            font-size: Theme.fs-xs;
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }
                                        Text {
                                            text: g.count;
                                            color: Theme.text-muted;
                                            font-size: Theme.fs-2xs;
                                            font-family: Theme.font-mono;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                                // 默认组空着时不在左栏占行，但**仍然是合法去向** ——
                                // 菜单里必须补一条，否则成员再也搬不回默认组。
                                if !root.has-default-row() && root.cur-name != "": Rectangle {
                                    height: 28px;
                                    border-radius: Theme.radius-sm;
                                    background: mmd-ta.has-hover ? Theme.bg-hover : transparent;
                                    mmd-ta := TouchArea {
                                        mouse-cursor: default;
                                        clicked => {
                                            root.toast = root.lang-en
                                                ? root.picked-count + " sessions → Default"
                                                : root.picked-count + " 个会话 → 默认组";
                                            root.move-members("", "", true);
                                            root.move-menu = false;
                                        }
                                    }
                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        spacing: 7px;
                                        cross-axis-alignment: center;
                                        Rectangle {
                                            width: 9px;
                                            height: 9px;
                                            border-radius: 5px;
                                            background: transparent;
                                            border-width: 1px;
                                            border-color: Theme.text-muted;
                                        }
                                        Text {
                                            horizontal-stretch: 1;
                                            text: root.lang-en ? "Default" : "默认组";
                                            color: Theme.text-primary;
                                            font-size: Theme.fs-xs;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                                Rectangle { height: 1px; background: Theme.mgr-line; }
                                HorizontalLayout {
                                    height: 20px;
                                    padding-left: 3px;
                                    Text {
                                        text: root.lang-en
                                            ? root.picked-count + " selected"
                                            : "已选 " + root.picked-count + " 项";
                                        color: Theme.text-muted;
                                        font-size: 10px;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }

                        // 删除条「去向」下拉：锚在「去向」按钮右缘，正对该按钮展开（像原生 select）
                        if root.del-menu : Rectangle {
                            width: 186px;
                            // 标题 20 + 行 × 28 + 上下内边距 10
                            height: 30px + root.menu_rows() * 28px;
                            // 以「去向」按钮中心为轴居中
                            x: Math.max(4px, Math.min(
                                root.del-menu-x - (root.left-w + 5px) - self.width / 2,
                                parent.width - self.width - 4px));
                            // 头部 52 + 删除条 52 → 贴删除条下沿 2px
                            y: 106px;
                            border-radius: Theme.radius-md;
                            background: Theme.popup-bg-elevated;
                            border-width: 1px;
                            border-color: Theme.mgr-line-strong;
                            VerticalLayout {
                                padding: 5px;
                                spacing: 0px;
                                alignment: start;
                                HorizontalLayout {
                                    height: 20px;
                                    padding-left: 3px;
                                    Text {
                                        text: root.lang-en ? "Move sessions to" : "会话移到";
                                        color: Theme.text-muted;
                                        font-size: 10px;
                                        vertical-alignment: center;
                                    }
                                }
                                for g in root.groups : Rectangle {
                                    height: g.name == root.confirm-del ? 0px : 28px;
                                    visible: g.name != root.confirm-del;
                                    border-radius: Theme.radius-sm;
                                    background: dtm-ta.has-hover ? Theme.bg-hover : transparent;
                                    dtm-ta := TouchArea {
                                        mouse-cursor: default;
                                        clicked => {
                                            root.del-target = g.reserved ? "" : g.name;
                                            root.del-menu = false;
                                        }
                                    }
                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        spacing: 7px;
                                        cross-axis-alignment: center;
                                        Rectangle {
                                            width: 9px;
                                            height: 9px;
                                            border-radius: 5px;
                                            background: g.color-hex != "" ? g.color : transparent;
                                            border-width: g.color-hex != "" ? 0px : 1px;
                                            border-color: Theme.text-muted;
                                        }
                                        Text {
                                            horizontal-stretch: 1;
                                            text: g.name;
                                            color: (root.del-target == (g.reserved ? "" : g.name))
                                                ? Theme.accent-solid : Theme.text-primary;
                                            font-size: Theme.fs-xs;
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }
                                        Text {
                                            text: g.count;
                                            color: Theme.text-muted;
                                            font-size: Theme.fs-2xs;
                                            font-family: Theme.font-mono;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                                // 默认组被隐藏时也要能选它当去向
                                if !root.has-default-row() : Rectangle {
                                    height: 28px;
                                    border-radius: Theme.radius-sm;
                                    background: dtd-ta.has-hover ? Theme.bg-hover : transparent;
                                    dtd-ta := TouchArea {
                                        mouse-cursor: default;
                                        clicked => {
                                            root.del-target = "";
                                            root.del-menu = false;
                                        }
                                    }
                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        spacing: 7px;
                                        cross-axis-alignment: center;
                                        Rectangle {
                                            width: 9px;
                                            height: 9px;
                                            border-radius: 5px;
                                            background: transparent;
                                            border-width: 1px;
                                            border-color: Theme.text-muted;
                                        }
                                        Text {
                                            horizontal-stretch: 1;
                                            text: root.lang-en ? "Default" : "默认组";
                                            color: root.del-target == "" ? Theme.accent-solid : Theme.text-primary;
                                            font-size: Theme.fs-xs;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }
                    }

                }

                // ══ 底部 ══（高保真 10-22：保存/结果一行 + ? 快捷键气泡 + 完成）
                Rectangle {
                    height: 48px;
                    // ⚠️ 必须显式 y：不给 y 时这条 1px 线落在竖直中心，会横穿底栏文字
                    Rectangle {
                        y: 0px;
                        width: 100%;
                        height: 1px;
                        background: Theme.mgr-line-soft;
                    }
                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 12px;
                        spacing: 8px;
                        cross-axis-alignment: center;
                        Icon {
                            glyph: root.toast-error ? "warning" : "check";
                            tint: root.toast-error ? Theme.danger
                                : (root.toast != "" ? Theme.accent-solid : Theme.success);
                            size: 12px;
                        }
                        // 任何落盘动作的结果都写进这行，2.6s 后回落到常驻文案（不弹居中 toast）
                        Text {
                            text: root.toast != ""
                                ? root.toast
                                : (root.lang-en ? "Changes save immediately" : "改动已自动保存");
                            color: root.toast-error ? Theme.danger
                                : (root.toast != "" ? Theme.text-primary : Theme.text-muted);
                            font-size: 11.5px;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        Rectangle { horizontal-stretch: 1; height: 1px; }
                        // 快捷键气泡入口（原来四条提示常驻，吃掉近一半横向空间）
                        Rectangle {
                            width: 24px;
                            height: 24px;
                            border-radius: 12px;
                            border-width: 1px;
                            border-color: keys-ta.has-hover || root.keys-open
                                ? Theme.accent.with-alpha(0.42) : Theme.mgr-line-strong;
                            keys-ta := TouchArea {
                                mouse-cursor: default;
                                clicked => { root.keys-open = !root.keys-open; }
                                changed has-hover => {
                                    if (self.has-hover) {
                                        root.tip-on(root.lang-en ? "Shortcuts" : "快捷键",
                                            self.absolute-position.x + self.mouse-x,
                                            self.absolute-position.y + self.mouse-y);
                                    } else { root.tip-off(); }
                                }
                                pointer-event(__ev) => {
                                    if (__ev.kind == PointerEventKind.move && self.has-hover) {
                                        root.tip-at(self.absolute-position.x + self.mouse-x,
                                            self.absolute-position.y + self.mouse-y);
                                    }
                                }
                            }
                            Text {
                                text: "?";
                                color: keys-ta.has-hover || root.keys-open
                                    ? Theme.accent-solid : Theme.text-muted;
                                font-size: 11px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                        Rectangle { width: 6px; height: 1px; }
                        Rectangle {
                            height: 30px;
                            border-radius: 7px;
                            background: done-ta.has-hover ? Theme.accent-hover : Theme.accent-solid;
                            done-ta := TouchArea {
                                mouse-cursor: default;
                                clicked => { if (commit_edit()) { root.close(); } }
                            }
                            HorizontalLayout {
                                padding-left: 18px;
                                padding-right: 18px;
                                alignment: center;
                                Text {
                                    text: root.lang-en ? "Done" : "完成";
                                    // 强调色实心块上的字：暗色主题用稿子的 ink（近黑），
                                    // 浅色主题强调色本来就深，仍用白
                                    color: Theme.dark ? #06201D : white;
                                    font-size: 12.5px;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }
            }
            }

            // ── 快捷键气泡（底栏 ? 圆钮，点开才有）──
            // 文案核对口径：**每一条都必须真的能触发**（2026-10-22 逐条实测），
            // 并覆盖实现里存在的全部入口 —— 键盘一组、鼠标一组，缺一即补。
            if root.keys-open : Rectangle {
                width: 236px;
                height: 410px;
                x: gm.width - self.width - 12px;
                y: gm.height - 48px - 10px - self.height;
                border-radius: Theme.radius-lg;
                background: Theme.popup-bg-elevated;
                border-width: 1px;
                border-color: Theme.border-strong;
                VerticalLayout {
                    padding: 10px;
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 0px;
                    Text {
                        text: root.lang-en ? "Shortcuts" : "快捷键";
                        color: Theme.text-secondary;
                        font-size: 11px;
                        font-weight: 600;
                        height: 22px;
                        vertical-alignment: center;
                    }
                    GmKeyCap { text: root.lang-en ? "BROWSE" : "浏览与选择"; }
                    GmKeyRow { label: root.lang-en ? "Previous / next group" : "切换分组"; keys: "↑ ↓"; }
                    GmKeyRow { label: root.lang-en ? "Toggle pick" : "勾选 / 取消勾选"; keys: "Space"; }
                    GmKeyRow { label: root.lang-en ? "Range pick" : "范围勾选"; keys: "Shift+点"; }
                    GmKeyRow { label: root.lang-en ? "Search" : "搜索"; keys: "Ctrl F"; }
                    GmKeyCap { text: root.lang-en ? "RENAME / DELETE" : "改名与删除"; }
                    GmKeyRow { label: root.lang-en ? "Rename group" : "改名（当前组）"; keys: "F2"; }
                    GmKeyRow { label: root.lang-en ? "Confirm" : "确认改名 / 新建"; keys: "Enter"; }
                    GmKeyRow { label: root.lang-en ? "Delete group" : "删除分组"; keys: "Del"; }
                    GmKeyCap { text: root.lang-en ? "DIALOG" : "弹框"; }
                    GmKeyRow { label: root.lang-en ? "Close / step back" : "关闭 / 逐级取消"; keys: "Esc"; }
                    GmKeyCap { text: root.lang-en ? "MOUSE" : "鼠标"; }
                    GmKeyRow { label: root.lang-en ? "Pick a row" : "勾选 / 取消勾选"; keys: root.lang-en ? "Click" : "点行"; }
                    GmKeyRow { label: root.lang-en ? "Rename" : "改名"; keys: root.lang-en ? "Dbl-click" : "双击组名"; }
                    GmKeyRow { label: root.lang-en ? "Move / reorder" : "换组 / 组内排序"; keys: root.lang-en ? "Drag" : "拖动"; }
                    GmKeyRow { label: root.lang-en ? "Colour" : "改分组颜色"; keys: root.lang-en ? "Dot" : "点色点"; }
                }
            }

            // ── 成员悬浮卡：与左侧栏成员列表的信息卡**同款**（elevated 底 / 9px 圆角 /
            // subtle 边框 / 24px 投影 / 行距 2px / 键值单行连排 / 全部主文本色）。
            // ⚠️ 必须显式给 height：非布局子项默认铺满父级，5 行会被 layout 摊到整个
            // 弹框高度（2026-10-20 用户截图：主机~认证三行隔了近百像素）。
            if root.tip-row >= 0 && root.tip-row < root.members.length && !root.dragging : Rectangle {
                // 名称/主机/认证/分组 恒显，用户/备注 非空才显（与侧栏同口径）
                property <int> tip-rows: 4
                    + (root.members[root.tip-row].user != "" ? 1 : 0)
                    + (root.members[root.tip-row].note != "" ? 1 : 0);
                // 贴鼠标右下角（+16/+14）；出界自动翻到左侧 / 上方（gm 有 clip，溢出会被裁）
                // 右侧预留 48px（↑↓ 按钮列），否则悬浮卡会正好压在按钮上
                x: Math.max(6px, root.tip-mx + 16px + self.width > gm.width - 48px
                    ? root.tip-mx - self.width - 12px
                    : root.tip-mx + 16px);
                y: Math.max(6px, root.tip-my + 14px + self.height > gm.height - 56px
                    ? root.tip-my - self.height - 12px
                    : root.tip-my + 14px);
                width: min(340px,
                    Math.max(tip-name.preferred-width, tip-host.preferred-width) + 76px);
                height: 18px + self.tip-rows * 22px;
                background: Theme.popup-bg-elevated;
                border-radius: 9px;
                border-width: 1px;
                border-color: Theme.mgr-line-strong;

                // (#popup-no-shadow 2026-10-20) 投影按 10-17「弹窗投影全删」定稿移除（toast 与成员悬浮卡同清）
                VerticalLayout {
                    padding: 9px;
                    padding-left: 12px;
                    padding-right: 12px;
                    spacing: 2px;
                    // 协议固定首行（高保真 10-22 对齐 tab-card-proto；不再显示「分组」）
                    if root.members[root.tip-row].kind != "" : Text {
                        text: (root.lang-en ? "Protocol:" : "协议：")
                            + root.proto-label(root.members[root.tip-row].kind);
                        color: Theme.text-primary;
                        font-size: Theme.fs-xs;
                        overflow: elide;
                    }
                    tip-name := Text {
                        text: (root.lang-en ? "Name:" : "名称：") + root.members[root.tip-row].name;
                        color: Theme.text-primary;
                        font-size: Theme.fs-xs;
                        overflow: elide;
                    }
                    tip-host := Text {
                        text: (root.lang-en ? "Host:" : "主机：") + root.members[root.tip-row].host;
                        color: Theme.text-primary;
                        font-size: Theme.fs-xs;
                        overflow: elide;
                    }
                    if root.members[root.tip-row].user != "" : Text {
                        text: (root.lang-en ? "User:" : "用户：") + root.members[root.tip-row].user;
                        color: Theme.text-primary;
                        font-size: Theme.fs-xs;
                        overflow: elide;
                    }
                    Text {
                        text: (root.lang-en ? "Auth:" : "认证：")
                            + root.auth-label(root.members[root.tip-row].auth);
                        color: Theme.text-primary;
                        font-size: Theme.fs-xs;
                        overflow: elide;
                    }
                    if root.members[root.tip-row].note != "" : Text {
                        text: (root.lang-en ? "Note:" : "备注：") + root.members[root.tip-row].note;
                        color: Theme.text-primary;
                        font-size: Theme.fs-xs;
                        overflow: elide;
                    }
                }
            }

            // ── 悬浮提示浮层（贴指针右上角；右/顶出界翻转）──
            if root.tip-show && root.tip-text != "" : Rectangle {
                property <length> tip-w: btn-tip-label.preferred-width + 16px;
                x: root.tip-ax - gm.absolute-position.x + 14px + tip-w > gm.width - 8px
                    ? root.tip-ax - gm.absolute-position.x - tip-w - 14px
                    : root.tip-ax - gm.absolute-position.x + 14px;
                y: root.tip-ay - gm.absolute-position.y - 28px < 8px
                    ? root.tip-ay - gm.absolute-position.y + 18px
                    : root.tip-ay - gm.absolute-position.y - 28px;
                height: 24px;
                width: tip-w;
                border-radius: 6px;
                border-width: 1px;
                border-color: Theme.border-strong;
                background: Theme.popup-bg-elevated;
                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    alignment: center;
                    btn-tip-label := Text {
                        text: root.tip-text;
                        color: Theme.text-primary;
                        font-size: 11px;
                        vertical-alignment: center;
                        overflow: elide;
                        max-width: 240px;
                    }
                }
            }

            // ── 色板浮层：锚在被点的色点下方（左栏行 / 右栏头部 / 新建行共用）──
            // 高保真 §改色：就地 8 列色板，当前色带环，选色即时落盘，点外部关闭。
            if root.color-for != "" : Rectangle {
                width: 195px;
                // 47 预设色 8 列（6 行）+ 底行两钮（自定义 / 无颜色）
                height: 16px + Math.ceil(root.palette.length / 8) * 18px
                    + (Math.ceil(root.palette.length / 8) - 1) * 5px + 6px + 20px + 8px;
                x: Math.max(8px, Math.min(root.color-anchor-x - 8px, gm.width - self.width - 8px));
                y: Math.max(8px, Math.min(root.color-anchor-y + 6px, gm.height - self.height - 8px));
                border-radius: Theme.radius-lg;
                background: Theme.popup-bg-elevated;
                border-width: 1px;
                border-color: Theme.border-strong;
                VerticalLayout {
                    padding: 8px;
                    spacing: 6px;
                    GridLayout {
                        spacing: 5px;
                        for k in root.palette.length : Rectangle {
                            row: k / 8;
                            col: Math.mod(k, 8);
                            width: 18px;
                            height: 18px;
                            border-radius: 4px;
                            background: root.palette[k].swatch;
                            // 当前色打环（用被编辑组的色，不是「当前组」的色）
                            border-width: 2px;
                            border-color: root.palette[k].hex == root.color-hex-for
                                ? white : transparent;
                            pw-ta := TouchArea {
                                mouse-cursor: default;
                                clicked => {
                                    root.color-hex-for = root.palette[k].hex;
                                    if (root.color-for == "__new") {
                                        // 新建行：只改待建色，不落盘（组还不存在）
                                        root.new-color = root.palette[k].hex;
                                        root.new-swatch = root.palette[k].swatch;
                                        root.color-for = "";
                                    } else {
                                        root.set-group-color(root.color-for, root.palette[k].hex);
                                        root.color-for = "";
                                    }
                                }
                            }
                        }
                    }
                    // 底行两钮：左「自定义颜色…」（取色盘）/ 右「无颜色」（清空）
                    HorizontalLayout {
                        height: 20px;
                        spacing: 5px;
                        Rectangle {
                            horizontal-stretch: 1;
                            border-radius: 4px;
                            border-width: 1px;
                            border-color: cp-ta.has-hover ? Theme.accent.with-alpha(0.42) : Theme.mgr-line-strong;
                            cp-ta := TouchArea {
                                mouse-cursor: default;
                                clicked => {
                                    // 起点色 = 该组当前色（无色则第一预设）；色板
                                    // 浮层保留，取消取色盘即回到色板继续选预设
                                    root.pick-hex = root.color-hex-for != ""
                                        ? root.color-hex-for : root.palette[0].hex;
                                    root.pick-open = true;
                                }
                            }
                            Text {
                                text: root.lang-en ? "Custom…" : "自定义颜色…";
                                color: cp-ta.has-hover ? Theme.accent-solid : Theme.text-secondary;
                                font-size: Theme.fs-2xs;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                        Rectangle {
                            width: 64px;
                            border-radius: 4px;
                            border-width: 1px;
                            border-color: nc-ta.has-hover ? Theme.accent.with-alpha(0.42) : Theme.mgr-line-strong;
                            nc-ta := TouchArea {
                                mouse-cursor: default;
                                clicked => {
                                    if (root.color-for == "__new") {
                                        root.new-color = "";
                                        root.new-swatch = transparent;
                                    } else {
                                        root.set-group-color(root.color-for, "");
                                    }
                                    root.color-for = "";
                                }
                            }
                            Text {
                                text: root.lang-en ? "No color" : "无颜色";
                                color: nc-ta.has-hover ? Theme.accent-solid : Theme.text-secondary;
                                font-size: Theme.fs-2xs;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }

            // ── 自定义颜色取色盘（盖整个弹框；取消回到色板，确认落盘组色）──
            if root.pick-open : Rectangle {
                width: 100%;
                height: 100%;
                background: transparent;
                Scrim { }
                TouchArea { clicked => { root.pick-open = false; } }
                ColorPickerDialog {
                    x: clamp((parent.width - self.width) / 2, 8px,
                        max(8px, parent.width - self.width - 8px));
                    y: clamp((parent.height - self.height) / 2, 8px,
                        max(8px, parent.height - self.height - 8px));
                    bounds-w: gm.width;
                    bounds-h: gm.height;
                    title: root.lang-en ? "Palette" : "调色盘";
                    en: root.lang-en;
                    hex <=> root.pick-hex;
                    fmt <=> root.pick-fmt;
                    wheel-mx <=> root.pick-wheel-mx;
                    wheel-my <=> root.pick-wheel-my;
                    val-my <=> root.pick-val-my;
                    pick-v <=> root.pick-pick-v;
                    sync-pos => { root.picker-sync(); }
                    copy-requested(h) => { root.copy-text(h); }
                    cancelled => { root.pick-open = false; }
                    confirmed => {
                        if (root.color-for == "__new") {
                            root.new-color = root.pick-hex;
                            root.new-swatch = PickerMath.hex-color(root.pick-hex);
                        } else if (root.color-for != "") {
                            root.set-group-color(root.color-for, root.pick-hex);
                        }
                        root.color-for = "";
                        root.pick-open = false;
                    }
                }
            }

            // ── 拖动浮层（高保真 §拖拽浮层：高 30px、跟手 +14/+14）──
            // ⚠️ drag-abs-* 是**窗口**坐标，本元素挂在 gm 里 → 必须减 gm.absolute-position。
            // 之前减的是 root.absolute-position（弹框根 = 0,0），弹框居中后 ghost 整体
            // 比指针偏出 (gm.x, gm.y)，窗口越大偏得越多 —— 就是「不跟手」的根因。
            if root.dragging : Rectangle {
                width: 240px;
                x: Math.max(4px, Math.min(root.drag-abs-x - gm.absolute-position.x + 14px,
                    gm.width - self.width - 6px));
                y: Math.max(4px, Math.min(root.drag-abs-y - gm.absolute-position.y + 14px,
                    gm.height - self.height - 6px));
                height: 30px;
                border-radius: Theme.radius-md;
                background: Theme.popup-bg-elevated;
                border-width: 1px;
                border-color: root.drop-group ? Theme.accent-solid : Theme.border-strong;
                // (#popup-no-shadow 2026-10-20) 投影按 10-17 定稿移除
                HorizontalLayout {
                    padding-left: 9px;
                    padding-right: 9px;
                    spacing: 6px;
                    cross-axis-alignment: center;
                    Text {
                        horizontal-stretch: 1;
                        text: root.drag-label;
                        color: Theme.text-primary;
                        font-size: Theme.fs-2xs;
                        overflow: elide;
                        vertical-alignment: center;
                    }
                    // 多选时**追加**「N 项」药丸（不是替换掉名称）
                    if root.drag-kind == "member" && root.picked-count > 1 : Rectangle {
                        height: 16px;
                        border-radius: 8px;
                        background: Theme.accent.with-alpha(0.22);
                        HorizontalLayout {
                            padding-left: 6px;
                            padding-right: 6px;
                            alignment: center;
                            Text {
                                text: root.lang-en
                                    ? root.picked-count + " selected"
                                    : root.picked-count + " 项";
                                color: Theme.accent-solid;
                                font-size: 9.5px;
                                vertical-alignment: center;
                            }
                        }
                    }
                    // 尾注：实时显示落点语义（高保真 §拖拽浮层）
                    Text {
                        text: root.drop-group && root.drop-gi >= 0
                                && root.drop-gi < root.groups.length
                            ? (root.lang-en ? "→ " + root.groups[root.drop-gi].name
                                            : "放到 " + root.groups[root.drop-gi].name)
                            : (root.drag-kind == "member"
                                ? (root.lang-en ? "#" + (root.drag-to + 1)
                                                : "第 " + (root.drag-to + 1) + " 位")
                                : "");
                        color: Theme.accent-solid;
                        font-size: Theme.fs-2xs;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
            }
        }
    }
}
