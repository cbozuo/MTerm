// (#sync-dialog 2026-10-08 / #sync-dialog-v2 2026-10-12) 同步输入（频道管理）
// 对话框 —— v2 高保真落地（docs/design/sync-dialog-hifi-2026-10-12.html）：
//   ① 频道页签换 SegGroup 滑动分段（ui/seg.slint，频道色 thumb，下划线删除）；
//   ② 标题区右侧「当前窗口 / 全部窗口」作用域分段（compact 档，只过滤左栏
//      候选；右栏成员跨窗口常显）；
//   ③ 行主文本 = 主机（左对齐，名称收进悬浮卡）；左栏其他频道成员行带
//      左栏候选行带暗底浅字频道字母（区别于 tab 的已加入药丸）；跨窗口行带「窗口 N」
//      徽标；当前频道成员不出现在左栏（右栏就是）；
//   ④ 行悬浮信息卡（tab 同款 150ms 首锚 + 跟手 + 右/上缘翻转）：名称/主机/
//      用户/认证/组别/备注/频道（暂停附注）/窗口，左右两栏都有；
//   ⑤ 两栏裸 Flickable → ScrollView（自适应滚动条）；
//   ⑥ welcome tab（空 session_id）不入列（Rust open-dialog 过滤）。
// 成员增删仍由 Rust 落在 sync-sessions 模型上；模型打开时一次装全所有窗口
// 的行（作用域只是 UI 过滤，切换不重灌、未应用的编辑不丢）。确定时 Rust
// 一次性按会话稳定 id 持久化。slot-counts / left-count 由 Rust 重算。
import { Theme } from "theme.slint";
import { Icon } from "icons.slint";
import { SegGroup } from "seg.slint";
import { ScrollView } from "std-widgets.slint";

// 一行 = 一个打开的终端 tab（或离线的持久频道成员）。slot -1 = 未加入，
// 0..3 = 频道 A..D。离线成员 online=false（标题由 Rust 追加「（离线）」）。
// win-id = 该行所属窗口的**显示位次**（1 起；与窗口标题「MTerm · 窗口 N」
// 同源，存活窗口按 registry id 升序的序号；离线行 = 打开弹框的窗口）。
// (#sync-dialog-v2-fix8) 以前存原始 registry id：关掉靠前窗口后标题顺延、
// 徽标/悬浮卡却停在旧号（用户实测）。
// host/user/auth/group 供行主文本与悬浮卡；auth 为代码（password 等），
// 显示名走 auth-label（跟随界面语言）。
export struct SyncSessionInfo {
    tab-id: string,
    session-id: string,
    title: string,
    host: string,
    user: string,
    auth: string,
    group-name: string,
    group-color: color,
    note: string,
    slot: int,
    // (#sync-dialog-v2-fix) 打开弹框时的**已生效**频道归属（-1 = 未加入任何
    // 频道）。弹框内的增删只改 slot（编辑态）；悬浮卡的「频道」行与字母药丸
    // 读 committed-slot —— 未点确定前，卡片不能声称会话"已在频道 C"。
    committed-slot: int,
    color: color,
    online: bool,
    paused: bool,
    win-id: int,
}

// 频道分段段（SegGroup 的 children）：色点 + 频道名 + 成员数徽标。
// 选中态透出滑层（thumb 染频道色），文字/徽标同染频道色；无下划线。
component ChannelSegCell inherits Rectangle {
    in property <int> slot;
    in property <string> letter;
    in property <int> active-slot;
    in property <color> dot;
    in property <int> count;
    in property <bool> lang-en;
    callback picked(int);
    min-width: 0;
    preferred-width: 0;
    horizontal-stretch: 1;
    border-radius: 7px;
    property <bool> active: active-slot == slot;
    background: active ? transparent : (ta.has-hover ? Theme.bg-hover : transparent);
    animate background { duration: 100ms; }
    HorizontalLayout {
        alignment: center;
        spacing: 7px;
        // 频道色点 10×10
        Rectangle {
            width: 10px; height: 10px; border-radius: 3px;
            background: dot;
            y: (parent.height - self.height) / 2;
        }
        Text {
            text: (SyncInputState.lang-en ? "Channel " : "频道 ") + letter;
            color: active ? dot : (ta.has-hover ? Theme.text-primary : Theme.text-secondary);
            font-size: 12px;
            font-weight: active ? 600 : 400;
            vertical-alignment: center;
            overflow: elide;
        }
        count-chip := Rectangle {
            height: 17px;
            width: max(17px, count-txt.preferred-width + 8px);
            // (#sync-dialog-v2-fix) HL 不做固定高子元素的垂直居中（色点是手动
            // 居中的），徽标同样手动居中，否则顶置（用户实测）。
            y: (parent.height - self.height) / 2;
            border-radius: 9px;
            background: active
                ? dot.with-alpha(Theme.dark ? 0.24 : 0.18)
                : Theme.popup-bg;
            count-txt := Text {
                width: 100%; height: 100%;
                text: count;
                color: active ? dot : Theme.text-muted;
                font-size: 10px; font-weight: 600;
                horizontal-alignment: center; vertical-alignment: center;
            }
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.picked(slot); }
    }
}

// 作用域分段段：图标 + 文案。选中 = accent（标准 chip 语义——作用域没有
// 频道身份，与频道段区分）。
component ScopeCell inherits Rectangle {
    in property <string> glyph;
    in property <string> label;
    in property <bool> active;
    callback picked();
    // (#sync-dialog-v2-fix) 段宽固定 92px（两段等宽，thumb 等分对齐）：容器
    // 宽按内容自然宽计算，段 preferred 归零会把容器塌成 0 宽叠到 ✕ 上
    // （用户实测）。zh/EN 文案（最长 "Current window" ≈78px）都放得下。
    min-width: 0;
    preferred-width: 92px;
    border-radius: 6px;
    background: active ? transparent : (ta.has-hover ? Theme.bg-hover : transparent);
    animate background { duration: 100ms; }
    HorizontalLayout {
        alignment: center;
        spacing: 5px;
        Icon {
            glyph: root.glyph;
            tint: active ? Theme.accent : Theme.text-secondary;
            size: 13px;
        }
        Text {
            text: root.label;
            color: active ? Theme.accent : (ta.has-hover ? Theme.text-primary : Theme.text-secondary);
            font-size: 11px;
            font-weight: active ? 600 : 400;
            vertical-alignment: center;
            overflow: elide;
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.picked(); }
    }
}

// 会话行：主机（主文本，名称只在悬浮卡）+ 频道字母标识（仅左栏候选行，
// 暗底浅字）+ 窗口徽标（跨窗口行）+ 行尾动作图标。整行可点；悬停 150ms 出卡。
component SyncRow inherits Rectangle {
    in property <SyncSessionInfo> entry;
    in property <bool> member;         // true = 右栏（当前频道成员，点行移出）
    in property <int> win-id;          // 打开弹框的窗口 id（窗口徽标据此显隐）
    in property <bool> lang-en;
    callback card-out(SyncSessionInfo, length, length);
    callback card-clear();
    height: 28px;
    border-radius: 6px;
    background: ta.has-hover ? Theme.bg-hover : transparent;
    animate background { duration: 100ms; }

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 6px;
        spacing: 8px;
        // (#sync-dialog-v2-fix3 2026-10-12) 原行首有个 9px 频道色点，与右侧
        // 频道药丸表达的是同一件事（双重编码）。药丸已对齐 tab 样式，色点删掉。
        // 主文本 = 主机（空回退标题）。名称/用户/认证收进悬浮卡。
        // (#sync-dialog-v2-fix) 离线成员行补「（离线）」后缀：旧行显标题时
        // 后缀由 Rust 拼在标题里，行改显主机后看不见了（用户实测）——回退到
        // 标题时后缀已自带，不重复拼。
        Text {
            horizontal-stretch: 1;
            text: entry.online
                ? (entry.host != "" ? entry.host : entry.title)
                : (entry.host != ""
                    ? entry.host + (SyncInputState.lang-en ? " (offline)" : "（离线）")
                    : entry.title);
            color: entry.online ? Theme.text-primary : Theme.text-muted;
            font-size: 12px;
            vertical-alignment: center;
            overflow: elide;
        }
        // 频道标识（**左栏专属**，右栏一律不显示）。
        // (#sync-dialog-v2-fix7 2026-10-12) 用户定稿 ——
        //   ① 已生效归属其他频道的行：**tab 页签同款**实心药丸（频道色底 +
        //      白字，14×14 / 圆角 4 / 9px w800，颜色同源 entry.color），与 tab
        //      逐参数一致（用户实测"弹框里的和 tab 上显示的还是不一样"）；
        //   ② 本次弹框内编排、未确定的行：**暗底浅字**字母 —— 与"已加入"
        //      明确区分（待确认不算已加入）；
        //   ③ 右栏成员行：不显示（列表本身就是归属）。
        // 字母取编辑态 slot（本次编排优先）；无编排回退 committed（"本次待
        // 确认移出"的行如实显示现状频道）。
        if !member && (entry.slot >= 0 || entry.committed-slot >= 0) : Rectangle {
            property <bool> pending: entry.slot != entry.committed-slot;
            property <int> badge-slot: max(0, entry.slot >= 0 ? entry.slot : entry.committed-slot);
            width: 14px; height: 14px;
            y: (parent.height - self.height) / 2;
            border-radius: 4px;
            background: pending ? Theme.popup-bg : entry.color;
            Text {
                width: 100%; height: 100%;
                text: parent.badge-slot == 0 ? "A" : parent.badge-slot == 1 ? "B"
                    : parent.badge-slot == 2 ? "C" : "D";
                color: pending ? Theme.text-primary : white;
                font-size: 9px; font-weight: 800;
                horizontal-alignment: center; vertical-alignment: center;
            }
        }
        // 窗口徽标：跨窗口行（悬停卡的「窗口」行同源）
        if entry.win-id != win-id : Rectangle {
            height: 16px;
            y: (parent.height - self.height) / 2;
            border-radius: 4px;
            border-width: 1px;
            border-color: Theme.border-subtle;
            background: Theme.popup-bg;
            HorizontalLayout {
                padding-left: 4px;
                padding-right: 5px;
                spacing: 3px;
                // (#theme-dedupe 2026-10-15) 图标降到文字同档:原 primary 比"窗口 N"还亮
                Icon { glyph: "display"; tint: Theme.text-secondary; size: 10px; }
                Text {
                    text: SyncInputState.lang-en ? "W" + entry.win-id : "窗口 " + entry.win-id;
                    color: Theme.text-secondary;
                    font-size: 10px;
                    vertical-alignment: center;
                }
            }
        }
        // 行尾动作键（图标 +/−）。(#sync-dialog-v2-fix) HL 固定高子项顶对齐
        // （icons.slint #icon-align 记过同款坑），手动垂直居中。
        Rectangle {
            width: 20px; height: 20px;
            y: (parent.height - self.height) / 2;
            border-radius: 5px;
            background: ta.has-hover
                ? (member ? Theme.danger.with-alpha(0.16) : Theme.accent-soft)
                : transparent;
            Icon {
                glyph: member ? "remove" : "add";
                tint: member ? Theme.danger : (ta.has-hover ? Theme.accent : Theme.text-muted);
                size: 14px;
            }
        }
    }
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            if (member) { SyncInputState.remove-row(entry.tab-id); }
            else { SyncInputState.add-row(entry.tab-id); }
        }
        // 纯悬停移动跟手（moved 只在按住时触发，跟随只能挂 pointer-event）
        pointer-event(e) => {
            if (e.kind == PointerEventKind.move && !self.pressed) {
                root.card-out(root.entry,
                    ta.absolute-position.x + ta.mouse-x,
                    ta.absolute-position.y + ta.mouse-y);
            }
        }
        changed has-hover => {
            if (!self.has-hover) { root.card-clear(); }
        }
    }
    // 悬停信息卡首锚计时器（tab 同款 150ms）
    card-delay := Timer {
        interval: 150ms;
        running: ta.has-hover;
        triggered => {
            root.card-out(root.entry,
                ta.absolute-position.x + ta.mouse-x,
                ta.absolute-position.y + ta.mouse-y);
        }
    }
}

export component SyncInputDialog inherits Rectangle {
    width: 680px;
    height: 480px;
    // (#dialog-drag 2026-10-14) 空白区拖动弹窗：增量式（mouse 相对卡片自身、
    // 随卡片移动自缩，逐事件以「上一次读数」为锚做差 = 纯指针位移，1:1 跟手
    // 无自馈跳角）；钳制边界 = 宿主全窗尺寸（app.slint 实例化时传入）。
    in property <length> bounds-w;
    in property <length> bounds-h;
    property <bool> card-dragging: false;
    property <length> drag-ox;                     // 按下时的卡片原点
    property <length> drag-oy;
    property <length> drag-cx;                     // 按下时指针的窗口绝对坐标（拖动期间稳定）
    property <length> drag-cy;
    border-radius: 12px;
    background: Theme.popup-bg;
    border-width: 1px;
    border-color: Theme.border-strong;
    drop-shadow-blur: 24px;
    drop-shadow-color: #00000066;
    clip: true;
    // (#sync-dialog-esc) 关闭请求（✕/取消按钮用）：交宿主收口——关 global
    // 的同时把键盘焦点还给活动终端（见 SyncDialogHost 的接线）。
    callback request-close();

    // 当前频道字母 / 成员数 / 色（供栏头标题、徽标、空态用）
    property <string> active-letter:
        SyncInputState.slot == 0 ? "A" :
        SyncInputState.slot == 1 ? "B" :
        SyncInputState.slot == 2 ? "C" : "D";
    property <int> active-count: SyncInputState.slot-counts[SyncInputState.slot];
    property <color> active-color: Theme.channel-colors[SyncInputState.slot];

    // 悬浮信息卡状态（行 card-out 写入；坐标 = 弹框内坐标）
    property <bool> card-show: false;
    property <SyncSessionInfo> card-info;
    property <length> card-x;
    property <length> card-y;

    // 认证显示名（与新建会话「认证方式」分段同一套文案，跟随界面语言）
    function auth-label(a: string) -> string {
        if (a == "keyboard-interactive") { return @tr("Keyboard-interactive"); }
        if (a == "key") { return @tr("Private key"); }
        return @tr("Password");
    }

    // 全卡吞层 + 空白拖动：点空白不复位焦点的副作用可接受（字段失焦走
    // 各字段自身逻辑）；声明在最前（垫底），其上控件不受影响。
    TouchArea {
        width: root.width;
        height: root.height;
        clicked => {}
        pointer-event(ev) => {
            if (ev.kind == PointerEventKind.down) {
                root.card-dragging = true;
                root.drag-ox = root.x;
                root.drag-oy = root.y;
                root.drag-cx = self.absolute-position.x + self.mouse-x;
                root.drag-cy = self.absolute-position.y + self.mouse-y;
            } else if (ev.kind == PointerEventKind.up) {
                root.card-dragging = false;
            }
        }
        moved => {
            if (root.card-dragging) {
                // 绝对坐标差值：与设置卡/调色盘同一实现（相对坐标会随卡片
                // 移动自缩，事件批次新旧快照混用会抖）
                root.x = Math.max(8px, Math.min(
                    root.drag-ox + (self.absolute-position.x + self.mouse-x - root.drag-cx),
                    Math.max(8px, root.bounds-w - root.width - 8px)));
                root.y = Math.max(8px, Math.min(
                    root.drag-oy + (self.absolute-position.y + self.mouse-y - root.drag-cy),
                    Math.max(8px, root.bounds-h - root.height - 8px)));
            }
        }
    }
    VerticalLayout {
        // ── 标题区 ──
        Rectangle {
            height: 60px;
            // 图标徽标
            Rectangle {
                x: 16px; y: 13px;
                width: 34px; height: 34px;
                border-radius: 9px;
                background: Theme.accent-soft;
                Icon {
                    glyph: "link";
                    tint: Theme.accent-solid;
                    size: 18px;
                }
            }
            // 标题 + 副标题
            Text {
                x: 60px; y: 13px;
                text: SyncInputState.lang-en ? "Sync input" : "同步输入";
                color: Theme.text-primary; font-size: 13px; font-weight: 700;
            }
            Text {
                x: 60px; y: 33px;
                text: SyncInputState.lang-en
                    ? "Configure channel membership for synced input"
                    : "配置各频道会话成员，实现跨会话同步输入";
                color: Theme.text-muted; font-size: 11px;
            }
            // 作用域分段（compact 档，标题区右侧；✕ 前留 8px 间隙）
            scope-seg := SegGroup {
                compact: true;
                x: parent.width - self.width - 48px;
                y: (parent.height - self.height) / 2;
                width: self.content-w;
                active-index: SyncInputState.scope;
                count: 2;
                ScopeCell {
                    glyph: "display";
                    label: SyncInputState.lang-en ? "Current window" : "当前窗口";
                    active: SyncInputState.scope == 0;
                    picked => { SyncInputState.pick-scope(0); }
                }
                ScopeCell {
                    glyph: "copy";
                    label: SyncInputState.lang-en ? "All windows" : "全部窗口";
                    active: SyncInputState.scope == 1;
                    picked => { SyncInputState.pick-scope(1); }
                }
            }
            // 关闭
            close-btn := Rectangle {
                x: parent.width - self.width - 12px;
                y: 16px;
                width: 28px; height: 28px;
                border-radius: 6px;
                background: close-ta.has-hover ? Theme.bg-hover : transparent;
                Icon {
                    glyph: "close";
                    tint: Theme.text-primary;
                    size: 14px;
                }
                close-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.request-close(); }
                }
            }
        }
        // 分隔线
        Rectangle {
            height: 1px;
            background: Theme.border-subtle;
        }

        // ── 频道滑动分段（4 槽）：thumb 染当前频道色，无下划线 ──
        Rectangle {
            height: 52px;
            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                padding-top: 8px;
                padding-bottom: 8px;
                spacing: 8px;
                ch-seg := SegGroup {
                    width: parent.width;
                    active-index: SyncInputState.slot;
                    count: 4;
                    thumb-tint: active-color.with-alpha(Theme.dark ? 0.16 : 0.13);
                    for cs in [
                        { slot: 0, letter: "A" }, { slot: 1, letter: "B" },
                        { slot: 2, letter: "C" }, { slot: 3, letter: "D" },
                    ] : ChannelSegCell {
                        slot: cs.slot;
                        letter: cs.letter;
                        active-slot: SyncInputState.slot;
                        dot: Theme.channel-colors[cs.slot];
                        count: SyncInputState.slot-counts[cs.slot];
                        lang-en: SyncInputState.lang-en;
                        picked(s) => { SyncInputState.pick-slot(s); }
                    }
                }
            }
        }

        // ── 双栏 ──
        HorizontalLayout {
            padding-left: 16px;
            padding-right: 16px;
            padding-top: 10px;
            padding-bottom: 10px;
            spacing: 12px;
            height: parent.height - 60px - 1px - 52px - 1px - 56px;
            // 左：候选（排除当前频道成员；作用域只影响这一栏的可见集）
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 8px;
                // 栏头
                HorizontalLayout {
                    spacing: 6px;
                    Text {
                        text: SyncInputState.lang-en
                            ? (SyncInputState.scope == 1 ? "Sessions in all windows" : "Sessions in this window")
                            : (SyncInputState.scope == 1 ? "全部窗口中的会话" : "当前窗口中的会话");
                        // (#dialog-label-sync 2026-10-15) 栏头标签对齐设置面板口径:常态 = 前景色
                        color: Theme.text-primary; font-size: 11px; font-weight: 600;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    Rectangle {
                        height: 16px;
                        width: max(16px, lc-txt.preferred-width + 10px);
                        border-radius: 8px;
                        background: Theme.popup-bg;
                        y: (parent.height - self.height) / 2;
                        lc-txt := Text {
                            width: 100%; height: 100%;
                            text: SyncInputState.left-count;
                            color: Theme.text-secondary; font-size: 10px; font-weight: 600;
                            horizontal-alignment: center; vertical-alignment: center;
                        }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    // 添加全部（只作用于左栏可见候选 —— Rust 侧按作用域过滤）
                    add-all-btn := Rectangle {
                        height: 22px;
                        border-radius: 5px;
                        background: add-all-ta.has-hover ? Theme.accent-soft : transparent;
                        HorizontalLayout {
                            alignment: center;
                            spacing: 3px;
                            padding-left: 6px;
                            padding-right: 8px;
                            Icon { glyph: "add"; tint: Theme.accent; size: 12px; }
                            Text {
                                text: SyncInputState.lang-en ? "Add all" : "添加全部";
                                color: Theme.accent; font-size: 11px;
                                vertical-alignment: center;
                            }
                        }
                        add-all-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { SyncInputState.add-all(); }
                        }
                    }
                }
                // 列表（ScrollView：滚动条自适应，内容不溢出不出现）
                Rectangle {
                    clip: true;
                    border-radius: 8px;
                    border-width: 1px; border-color: Theme.border-control;
                    background: Theme.popup-field;
                    vertical-stretch: 1;
                    ScrollView {
                        VerticalLayout {
                            spacing: 0px;
                            padding: 2px;
                            // (#sync-dialog-v2-fix3) 左栏 = 可见候选，由 Rust
                            // 灌好（已排除当前频道成员 + 作用域过滤）。
                            for r in SyncInputState.left-rows : SyncRow {
                                width: 100%;
                                height: 28px;
                                entry: r;
                                member: false;
                                win-id: SyncInputState.win-id;
                                lang-en: SyncInputState.lang-en;
                                card-out(i, wx, wy) => {
                                    root.card-info = i;
                                    root.card-x = wx - root.absolute-position.x;
                                    root.card-y = wy - root.absolute-position.y;
                                    root.card-show = true;
                                }
                                card-clear => { root.card-show = false; }
                            }
                        }
                    }
                    // 空态
                    if SyncInputState.left-count == 0 : Text {
                        width: parent.width;
                        y: (parent.height - self.height) / 2;
                        text: SyncInputState.lang-en
                            ? "All sessions are already in this channel"
                            : "所有会话均已加入当前频道";
                        color: Theme.text-muted; font-size: 11px;
                        horizontal-alignment: center;
                    }
                }
            }
            // 右：当前频道的成员（跨窗口常显；点行移出）
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 8px;
                // 栏头
                HorizontalLayout {
                    spacing: 6px;
                    Text {
                        text: SyncInputState.lang-en
                            ? "Channel " + active-letter + " members"
                            : "频道 " + active-letter + " 成员";
                        // (#dialog-label-sync 2026-10-15) 栏头标签对齐设置面板口径:常态 = 前景色
                        color: Theme.text-primary; font-size: 11px; font-weight: 600;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    Rectangle {
                        height: 16px;
                        width: max(16px, rc-txt.preferred-width + 10px);
                        border-radius: 8px;
                        background: active-color.with-alpha(Theme.dark ? 0.24 : 0.18);
                        y: (parent.height - self.height) / 2;
                        rc-txt := Text {
                            width: 100%; height: 100%;
                            text: active-count;
                            color: active-color; font-size: 10px; font-weight: 600;
                            horizontal-alignment: center; vertical-alignment: center;
                        }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    // 全部移出
                    remove-all-btn := Rectangle {
                        height: 22px;
                        border-radius: 5px;
                        background: remove-all-ta.has-hover ? Theme.danger.with-alpha(0.16) : transparent;
                        HorizontalLayout {
                            alignment: center;
                            spacing: 3px;
                            padding-left: 6px;
                            padding-right: 8px;
                            Icon { glyph: "remove"; tint: Theme.danger; size: 12px; }
                            Text {
                                text: SyncInputState.lang-en ? "Remove all" : "全部移出";
                                color: Theme.danger; font-size: 11px;
                                vertical-alignment: center;
                            }
                        }
                        remove-all-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { SyncInputState.remove-all(); }
                        }
                    }
                }
                // 列表
                Rectangle {
                    clip: true;
                    border-radius: 8px;
                    border-width: 1px; border-color: Theme.border-control;
                    background: Theme.popup-field;
                    vertical-stretch: 1;
                    ScrollView {
                        VerticalLayout {
                            spacing: 0px;
                            padding: 2px;
                            // (#sync-dialog-v2-fix3) 右栏 = 当前频道成员（跨窗口
                            // 常显），同样由 Rust 灌好，不做 UI 侧过滤。
                            for r in SyncInputState.right-rows : SyncRow {
                                width: 100%;
                                height: 28px;
                                entry: r;
                                member: true;
                                win-id: SyncInputState.win-id;
                                lang-en: SyncInputState.lang-en;
                                card-out(i, wx, wy) => {
                                    root.card-info = i;
                                    root.card-x = wx - root.absolute-position.x;
                                    root.card-y = wy - root.absolute-position.y;
                                    root.card-show = true;
                                }
                                card-clear => { root.card-show = false; }
                            }
                        }
                    }
                    // 空态
                    if active-count == 0 : Text {
                        width: parent.width;
                        y: (parent.height - self.height) / 2;
                        text: SyncInputState.lang-en
                            ? "No members — add sessions from the left"
                            : "暂无成员，点击左侧会话加入";
                        color: Theme.text-muted; font-size: 11px;
                        horizontal-alignment: center;
                    }
                }
            }
        }

        // 分隔线
        Rectangle {
            height: 1px;
            background: Theme.border-subtle;
        }

        // ── 底部 确定/取消 ──
        Rectangle {
            height: 56px;
            HorizontalLayout {
                padding-right: 16px;
                spacing: 10px;
                Rectangle { horizontal-stretch: 1; }
                cancel-btn := Rectangle {
                    width: 88px; height: 30px;
                    y: (parent.height - self.height) / 2;
                    border-radius: 7px;
                    background: cancel-ta.has-hover ? Theme.popup-bg-active : Theme.popup-field;
                    border-width: 1px; border-color: Theme.border-control;
                    Text {
                        width: 100%; height: 100%;
                        text: SyncInputState.lang-en ? "Cancel" : "取消";
                        color: Theme.text-primary; font-size: 12px;
                        horizontal-alignment: center; vertical-alignment: center;
                    }
                    cancel-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.request-close(); }
                    }
                }
                apply-btn := Rectangle {
                    width: 88px; height: 30px;
                    y: (parent.height - self.height) / 2;
                    border-radius: 7px;
                    background: apply-ta.has-hover ? Theme.accent-hover : Theme.accent-solid;
                    Text {
                        width: 100%; height: 100%;
                        text: SyncInputState.lang-en ? "OK" : "确定";
                        color: white; font-size: 12px; font-weight: 600;
                        horizontal-alignment: center; vertical-alignment: center;
                    }
                    apply-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { SyncInputState.apply(); }
                    }
                }
            }
        }
    }

    // ── 悬浮信息卡（tab 同款）：150ms 首锚 + 跟手 + 右/上缘翻转。声明在
    // 主布局之后 = 盖在列表上；无 TouchArea（指针穿透）。弹框 clip:true，
    // 翻转公式天然保证卡不越界，不与根层 tab 卡共用渲染槽（模态防串层）。
    if root.card-show && root.card-info.title != "" : Rectangle {
        x: root.card-x + 10px + self.width > parent.width - 8px
            ? max(8px, root.card-x - self.width - 10px) : root.card-x + 10px;
        y: root.card-y - self.height - 8px < 8px
            ? root.card-y + 20px : root.card-y - self.height - 8px;
        width: min(parent.width - 60px, card-lay.preferred-width + 24px);
        height: card-lay.preferred-height + 18px;
        background: Theme.bg-elevated;
        border-radius: 9px;
        border-width: 1px;
        border-color: Theme.border-subtle;
        drop-shadow-blur: 24px;
        drop-shadow-color: #00000045;
        card-lay := VerticalLayout {
            padding: 9px;
            padding-left: 12px;
            padding-right: 12px;
            spacing: 2px;
            // 键值单行连排（同跳板信息卡）：避免两列布局的全角冒号间隙。
            Text {
                text: (SyncInputState.lang-en ? "Name:" : "名称：") + root.card-info.title;
                color: Theme.text-primary;
                font-size: Theme.fs-xs;
                overflow: elide;
            }
            if root.card-info.host != "" : Text {
                text: (SyncInputState.lang-en ? "Host:" : "主机：") + root.card-info.host;
                color: Theme.text-primary;
                font-size: Theme.fs-xs;
                overflow: elide;
            }
            if root.card-info.user != "" : Text {
                text: (SyncInputState.lang-en ? "User:" : "用户：") + root.card-info.user;
                color: Theme.text-primary;
                font-size: Theme.fs-xs;
                overflow: elide;
            }
            if root.card-info.auth != "" : Text {
                text: (SyncInputState.lang-en ? "Auth:" : "认证：") + root.auth-label(root.card-info.auth);
                color: Theme.text-primary;
                font-size: Theme.fs-xs;
                overflow: elide;
            }
            if root.card-info.group-name != "" : HorizontalLayout {
                spacing: 4px;
                // (#sync-dialog-v2-fix) HL 会把多余宽度均分给可拉伸子项 ——
                // 键 Text 默认可拉伸会把色点/值推到右边（用户实测）。键与点
                // 锁 0 拉伸，剩余宽度给值吃（文字仍左对齐）。
                Text {
                    text: (SyncInputState.lang-en ? "Group:" : "组别：");
                    color: Theme.text-primary;
                    font-size: Theme.fs-xs;
                    vertical-alignment: center;
                    horizontal-stretch: 0;
                }
                Rectangle {
                    width: 8px; height: 8px; border-radius: 2.5px;
                    background: root.card-info.group-color != transparent
                        ? root.card-info.group-color : Theme.border-subtle;
                    horizontal-stretch: 0;
                    y: (parent.height - self.height) / 2;
                }
                Text {
                    text: root.card-info.group-name;
                    color: Theme.text-primary;
                    font-size: Theme.fs-xs;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
            }
            if root.card-info.note != "" : Text {
                text: (SyncInputState.lang-en ? "Note:" : "备注：") + root.card-info.note;
                color: Theme.text-primary;
                font-size: Theme.fs-xs;
                overflow: elide;
            }
            // (#sync-dialog-v2-fix) 「频道」行：显示编辑态归属（slot），但本次
            // 弹框内未确定的编排要如实标注 —— slot != committed 时附「（本次
            // 待确认生效）/（本次待确认移出）」；已生效且有暂停态才附暂停注。
            // (#sync-dialog-v2-fix2 2026-10-12) 用户定稿：卡上频道信息**保留**，
            // 只加待确认描述，不做隐藏。
            if root.card-info.slot >= 0 || root.card-info.committed-slot >= 0 : Text {
                property <int> ps: root.card-info.slot;
                property <int> cs: root.card-info.committed-slot;
                property <bool> pending: ps != cs;
                text: (SyncInputState.lang-en ? "Channel:" : "频道：")
                    + (SyncInputState.lang-en ? "Channel " : "频道 ")
                    + (ps >= 0
                        ? (ps == 0 ? "A" : ps == 1 ? "B" : ps == 2 ? "C" : "D")
                        : (cs == 0 ? "A" : cs == 1 ? "B" : cs == 2 ? "C" : "D"))
                    + (pending
                        ? (SyncInputState.lang-en
                            ? (ps >= 0 ? " (pending confirmation)" : " (pending removal)")
                            : (ps >= 0 ? "（本次待确认生效）" : "（本次待确认移出）"))
                        : (root.card-info.paused
                            ? (SyncInputState.lang-en ? " (paused)" : "（已暂停同步）") : ""));
                color: Theme.text-primary;
                font-size: Theme.fs-xs;
                overflow: elide;
            }
            if root.card-info.win-id != SyncInputState.win-id : Text {
                text: (SyncInputState.lang-en ? "Window:" : "窗口：")
                    + (SyncInputState.lang-en ? "Window " : "窗口 ") + root.card-info.win-id;
                color: Theme.text-primary;
                font-size: Theme.fs-xs;
                overflow: elide;
            }
        }
    }
}

// (#sync-dialog-r2 2026-10-08) 同步输入的全局状态 + 宿主。拆出 app.slint：
// 顶栏按钮、对话框、Rust 三方都走这个 global（app.rs/app.slint 只剩一行
// 接线），app.slint 不再持有同步输入的任何属性与回调。
// (#sync-dialog-hifi 2026-10-11) slot-counts：每频道成员数，Rust 在每次增删
// 后重算写入。
// (#sync-dialog-v2 2026-10-12) 新增 scope（0=当前窗口 1=全部窗口，纯 UI 过滤，
// 模型打开时已装全所有窗口的行，切换不重灌）、win-id（打开弹框的窗口**位次**，
// 与标题同源）、left-count（左栏候选数，Rust 在重算时按作用域+排除当前频道一并算）。
export global SyncInputState {
    in-out property <bool> dialog-open: false;
    in-out property <int> slot: 0;               // 当前操作的频道槽 0..3
    in-out property <[SyncSessionInfo]> sessions;
    // (#sync-dialog-v2-fix3 2026-10-12) 左右两栏各自的可见行，由 Rust 在
    // open / 增删 / 切页签 / 切作用域后**重新灌整模型**。此前两栏共用
    // `sessions` 靠 `height: 0px` 折叠行来过滤，行数据改了但 repetition 的
    // height 绑定不重算 → 点「+」行不消失、右栏也不出现（只有悬浮卡变了）。
    // 换模型 = 最可靠的刷新路径。
    in-out property <[SyncSessionInfo]> left-rows;
    in-out property <[SyncSessionInfo]> right-rows;
    in-out property <[int]> slot-counts: [0, 0, 0, 0];   // 每频道成员数（Rust 维护）
    in-out property <int> left-count: 0;         // 左栏候选数（Rust 维护）
    in-out property <int> win-id: 1;             // 打开弹框的窗口位次（1 起，与标题同源）
    in-out property <int> scope: 0;              // 0=当前窗口 1=全部窗口
    in-out property <bool> lang-en: false;
    callback open-dialog();                      // Rust：填充模型并打开
    callback add-row(string /* tab-id */);       // Rust：改内存模型槽位
    callback remove-row(string);
    callback add-all();
    callback remove-all();
    callback apply();                            // Rust：按槽持久化 + 刷新
    callback pick-slot(int);                     // Rust：切频道页签并重灌两栏
    callback pick-scope(int);                    // Rust：切作用域并重灌左栏
}

// 宿主：AppWindow 根层只放这一个元素（模态吞层 + 居中）。app.slint 里一行：
//   SyncDialogHost { request-terminal-focus => { root.terminal-focus-sequence += 1; } }
export component SyncDialogHost inherits Rectangle {
    width: 100%;
    height: 100%;
    // (#dialog-drag) 拖拽钳制边界（全窗尺寸，app.slint 实例化时传入）
    in property <length> bounds-w;
    in property <length> bounds-h;
    // (#sync-dialog-esc 2026-10-13) 关框后把键盘焦点还给活动终端 —— 与粘贴
    // 确认卡同一机制（AppWindow.terminal-focus-sequence）。Esc / ✕ / 取消
    // 三条 UI 关闭路径都经它；确定（Rust apply）由 Rust 侧递增。
    callback request-terminal-focus();
    if SyncInputState.dialog-open : Rectangle {
        width: 100%;
        height: 100%;
        // (#scrim-unify 2026-10-15) 补上缺失的遮罩:此前只有一层无底色的
        // TouchArea 吞层,弹框背后直接露出主界面(用户截图反馈"同步输入
        // 弹框没有遮罩")。统一走 Theme.modal-scrim,与新建会话/设置/关闭
        // 弹框同源(深浅色 + 通透档自适应)。
        background: Theme.modal-scrim;
        TouchArea { }   // 模态吞层：点外部不关（走 取消/✕/确定）
        // (#sync-dialog-esc) Esc 取消当前窗口的同步输入弹框。开框即抓键盘：
        // 模态期间终端不再收键，Esc 也不会被终端透传进 PTY（终端 key-pressed
        // 对其余按键一律 accept 并转发）。落焦延到下一 tick —— init 内同步
        // focus 会重入 IME/AccessKit（#323 同款坑，terminal_view 的
        // focus-defer-timer 同一模式）。与确认卡 / 接口面板 esc-scope 同模式。
        esc-scope := FocusScope {
            focus-on-click: false;
            focus-on-tab-navigation: false;
            property <bool> focus-pending: true;
            Timer {
                interval: 0ms;
                running: parent.focus-pending;
                triggered => {
                    parent.focus();
                    parent.focus-pending = false;
                }
            }
            key-pressed(e) => {
                if (e.text == Key.Escape) {
                    SyncInputState.dialog-open = false;
                    root.request-terminal-focus();
                }
                accept   // 模态：其余键一并吞掉，不漏进终端
            }
            key-released(e) => { accept }
        }
        SyncInputDialog {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2 - 20px;
            bounds-w: root.bounds-w;
            bounds-h: root.bounds-h;
            request-close => {
                SyncInputState.dialog-open = false;
                root.request-terminal-focus();
            }
        }
    }
}
