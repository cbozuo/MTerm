import { Icon } from "icons.slint";
import { Theme } from "theme.slint";
import { IconButton } from "widgets.slint";

export struct TabInfo {
    id: string,
    title: string,
    title_len: int,
    kind: string,   // "welcome" | "terminal"
    connected: bool,
    // (#session-status-dot 2026-09-05) 该 tab 归属的会话 id(welcome tab 为
    // "")。会话列表的在线状态点据此汇总:任一 connected tab 存在即点亮。
    session_id: string,
    // (#session-status-dot-r2 2026-09-05) 连接三态:0 连接中 / 1 已连接 /
    // 2 已断开(welcome = -1)。会话列表状态汇总的数据源:绿 = 任一 tab 已连接,
    // 黄 = 无已连接但有连接中。
    state: int,
    // (#tab-group-bar 2026-09-14) 标签底部的分组色条。与本 tab 所属会话的分组
    // 颜色同源(ConfigStore.group_colors,见 session_models::tab_group_color),
    // 与左侧组头文件夹、成员树线共用同一个值。hex 为空 = 该组无色 → **不画**色条
    // (分组色是身份标识,没有身份就不该有标识),故 UI 只需判空。
    group_color_hex: string,
    group_color: color,
    // (#tab-32) 频道：字母（A/B/C/D，空 = 不在频道）、频道色、暂停态
    // （字母加删除线；既不发送也不接收，成员关系保留）。
    channel_letter: string,
    channel_color: color,
    channel_paused: bool,
}

// --- SingleTab -------------------------------------------------------------
component SingleTab inherits Rectangle {
    in property <TabInfo> info;
    in property <bool> active;
    // A ghost is the floating copy that follows the cursor while its original is
    // being dragged (#408). Purely visual: its TouchArea is off, so it can never
    // steal the pointer grab from the real tab.
    in property <bool> ghost: false;
    callback selected();
    callback closed();
    callback duplicated();
    // Right-click (v0.5): request a context menu at the given absolute position.
    callback context-requested(length /* abs-x */, length /* abs-y */);
    // Drag lifecycle (#408). The tab only *reports* the gesture; the strip owns
    // every bit of reorder state and the model is not touched before the drop, so
    // this element — and with it the pointer grab — survives the whole drag.
    callback drag-begun(length /* grab-offset */);
    callback drag-moved(length /* abs-x */, length /* abs-y */);
    callback drag-dropped(length /* abs-x */, length /* abs-y */);
    callback drag-cancelled();

    // Where inside the tab the drag began, and whether a drag (vs a click) is in
    // progress. `dragging` suppresses the select-on-release.
    property <length> grab-offset;
    property <bool> pressing;
    out property <bool> dragging;
    // The dragged original (dimmed in place) and its ghost share the lifted look.
    property <bool> lifted: root.dragging || root.ghost;

    // (#tab-polish 2026-09-14) 32px 高 + radius-md 圆角。**取消选中态的 2px
    // accent 全包围外框**：选中改由"背景分野"表达（暗色比栏底更暗、亮色更亮），
    // 分组身份交给底部色条 —— 焦点通道与身份通道各管一件事，不再互相压色。
    // (#tab-32 2026-10-07, tab-row-idia 稿)：**36 → 32px（与条带等高）、
    // 四边全 0 圆角**（IDEA 标准长方形直切角；旧"上圆下方"两头不靠）。
    // 选中标识改由**顶部 3px accent 横线**承担（见下方 accent-line）。
    height: 32px;
    border-radius: 0px;
    background: lifted ? Theme.bg-active
        : (touch.pressed ? Theme.bg-active
        : (active ? (info.kind == "terminal" ? Theme.tab-active-bg : Theme.bg-root)
        // (#tab-32) 非活动底色按稿重取：暗 1.52→1.30、亮 1.36→1.24（同色条带
        // 上重取，方向相反——暗色比终端亮、亮色比终端暗，都读作「浮在终端之上」）。
        : (touch.has-hover ? Theme.bg-hover : Theme.bg-elevated)));
    animate background { duration: 130ms; }
    // (#tab-32) 选中标识：顶部 3px accent 横线，长度 = border-box 全宽
    //（width 用 parent.width 而非内容区宽——后者比 tab 短、右端留缺口，
    // 125%/150% 缩放下尤其明显）。用 opacity 不用 if（常驻不重建）。
    accent-line := Rectangle {
        x: 0; y: 0;
        width: parent.width;
        height: 3px;
        background: Theme.accent-solid;
        opacity: active ? 1.0 : 0.0;
    }
    // Lift the ghost off the strip so it reads as "in hand".
    // (#tab-flush 2026-09-14) 选中态不再有投影：标签要跟终端连成一片，任何投影
    // （尤其下偏移 1px）都会在贴合缝渗出灰边，与"贴住"互相抵消。ghost 悬空浮层照旧。
    drop-shadow-blur: ghost ? 12px : 0px;
    drop-shadow-offset-y: 0px;
    drop-shadow-color: ghost ? #00000070 : transparent;

    // Declared FIRST so the HorizontalLayout's children (close button) are at
    // a higher z-order and receive their own click events.
    touch := TouchArea {
        // A ghost never takes input: the real tab keeps the grab until the drop.
        enabled: !root.ghost;
        mouse-cursor: root.dragging ? move : pointer;
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                root.grab-offset = self.mouse-x;
                root.pressing = true;
                root.dragging = false;
            } else if (e.kind == PointerEventKind.down && e.button == PointerEventButton.right) {
                root.context-requested(
                    self.absolute-position.x + self.mouse-x,
                    self.absolute-position.y + self.mouse-y);
            } else if (e.kind == PointerEventKind.up) {
                if (root.pressing && !root.dragging) {
                    root.selected();
                } else if (root.dragging) {
                    root.drag-dropped(self.absolute-position.x + self.mouse-x,
                                      self.absolute-position.y + self.mouse-y);
                }
                root.pressing = false;
                root.dragging = false;
            } else if (e.kind == PointerEventKind.cancel) {
                // The grab was taken away (window deactivated, an ancestor
                // intercepted, the area got disabled). End the gesture without
                // committing anything so no ghost or highlight is left behind.
                if (root.dragging) {
                    root.drag-cancelled();
                }
                root.pressing = false;
                root.dragging = false;
            }
        }
        moved => {
            if (root.pressing) {
                // A drag begins once the cursor drifts horizontally OR leaves the
                // tab vertically (so a straight-down drag to split also counts).
                if (!root.dragging
                        && (abs(self.mouse-x - root.grab-offset) > 4px
                            || self.mouse-y < -6px || self.mouse-y > root.height + 6px)) {
                    root.dragging = true;
                    root.drag-begun(root.grab-offset);
                }
                // Gate on `dragging`: a plain click can emit tiny `moved` events
                // (macOS), which would otherwise start a bogus gesture.
                if (root.dragging) {
                    root.drag-moved(self.absolute-position.x + self.mouse-x,
                                    self.absolute-position.y + self.mouse-y);
                }
            }
        }
        double-clicked => {
            if (root.info.kind != "welcome") { root.duplicated(); }
        }
    }

    // (#tab-32 2026-10-07) 内容布局：padding 12/8 → **20/20**（标题动态居中
    // 的基准是内容盒中心 = (PL+W−PR)/2，只由左右内边距之差决定，左右必须
    // 相等）；spacing 8 → 7。竖条/字母已 absolute 脱流（见下），不参与居中。
        // ⚠️ padding-left 必须 ≥ 21px（3px 竖条 + 3px 间隙 + 14px 药丸右缘 +
        // 1px 呼吸），否则窄 tab 上标题压到字母。左右对称（22/22）保标题居中。
        HorizontalLayout {
            width: parent.width;
            padding-left: 22px;
            padding-right: 22px;
        spacing: 7px;
        // (#tab-32) alignment: center = 标题动态居中（padding 对称的前提下，
        // 内容盒中心 = tab 中心；有频道/无频道两类 tab 的标题中心完全一致）。
        alignment: center;

        title-text := Text {
            text: info.title;
            color: active ? Theme.text-primary : Theme.text-secondary;
            // One size for every tab. This used to shrink 12 → 10 → 9px by title
            // length, so the same session name read 13px in the sidebar and up to
            // 30% smaller here — the largest single source of "the member list and
            // the title bar don't look like the same font". tab-width() already
            // budgets 7px per display column, which fits a fixed size past ~40
            // columns; `overflow: elide` below handles the tail, so the size ramp
            // was a redundant second safety net that only cost legibility.
            font-size: Theme.fs-sm;
            vertical-alignment: center;
            overflow: elide;
            // (#tab-32) horizontal-stretch 去掉——stretch 会让标题吃满剩余空间，
            // 布局没有"可移动的对象"，配合 padding 20/20 的居中即失效。
        }

    }

    // (#tab-32) 频道字母（tab-row-idia 稿）：absolute left:6px 脱流。(#tab-32-
    // pill 2026-10-08) 裸字母(彩色文字)在浅色 tab 底上区分不明显（用户反馈
    // "加入和未加入区分不明显"）→ 改 **频道色药丸 + 白字**：一眼可辨加入的
    // 频道槽位；暂停态画白色删除线（对比度优于色字叠色线）。
    channel-letter := Rectangle {
        x: 6px;
        y: (parent.height - self.height) / 2;
        width: 14px;
        height: 14px;
        border-radius: 4px;
        background: info.channel_color;
        visible: info.channel_letter != "";
        Text {
            width: 100%;
            height: 100%;
            text: info.channel_letter;
            color: white; font-size: 9px; font-weight: 800;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        // 暂停态删除线：白色横线盖在药丸中线上（药丸已是频道色实底）。
        Rectangle {
            visible: info.channel_paused;
            x: 1.5px;
            y: (parent.height - 1.5px) / 2;
            width: parent.width - 3px;
            height: 1.5px;
            background: white;
        }
    }

    // Keep close pinned to the far right even when the title is very short.
    // (#tab-32) 关闭键改 **absolute right:0 + 仅 hover 显示**：去掉 `|| active`
    // （active 常显时占 20px 流内宽度）；absolute 脱流修复"hover 突然占宽把
    // 后面的 tab 顶开一条缝"（间隙症状的第三成因，最隐蔽）。盒宽 20px 恰好
    // 等于右内边距，别写 right:2px（会向左侵入内容区 2px 压到长标题）。
    // glyph 改两根 9px×1.5px 斜杠（rotation 45°，精确到 px；「×」字符的视觉
    // 跨度只有 ~0.5em 且随字体漂移）。hover **只染红 × 自身**（#dc4b44 =
    // Theme.danger-strong；红底白字太重，与平面 tab 行不协调——VS Code/IDEA 做法）。
    // (merge #408 2026-09-04) 保留本地的关闭按钮实现，仅并入上游的 `!ghost` 条件。
    if info.kind != "welcome" && !ghost : Rectangle {
        width: 20px; height: 20px;
        x: parent.width - self.width;
        y: (parent.height - self.height) / 2;
        // (#tab-32) 关闭键常态隐形，**仅 hover 显示**（去掉 || active）。
        // (#tab-close-hover-fix 2026-09-14) 必须把 **close-ta.has-hover 一并算进
        // 显示条件**：Slint 的 hover 是"单一顶层命中"语义 —— close-ta 覆盖在
        // touch 之上，鼠标一旦移到 × 槽位就把 hover 抢走，父级 touch.has-hover
        // 立刻翻 false。原先只判 touch，于是"鼠标刚靠近 ×，× 反而消失"（既看不见
        // 也点不中）。absolute 脱流后 hover 显示不再改变占位（不顶开邻 tab）。
        opacity: (touch.has-hover || close-ta.has-hover) ? 1.0 : 0.0;
        animate opacity { duration: 140ms; }
        // (#tab-32) 去掉红底：hover 只染红 × 自身（#dc4b44 = Theme.danger-strong）。
        background: transparent;
        close-ta := TouchArea {
            mouse-cursor: pointer;
            clicked => { root.closed(); }
        }
        // × 的两根斜杠用 Path 画（Slint 1.18 无元素级 rotation-angle；M/L
        // 命令精确到 px，等效稿内 9px×1.5px 双斜杠）。stroke 1.5px，hover 染红。
        Path {
            width: 10px; height: 10px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            viewbox-width: 10;
            viewbox-height: 10;
            commands: "M 1 1 L 9 9 M 9 1 L 1 9";
            stroke: close-ta.has-hover ? Theme.danger-strong : Theme.text-secondary;
            stroke-width: 1.5px;
        }
    }

    // --- 左缘分组色竖条 (#tab-group-bar-r2 2026-09-15 / #tab-32) ------------
    // (#tab-32) 定位改 **absolute x:0 脱流**：标记「这个 tab 从哪开始」，贴边
    // 才是核心语义——作为 flex 子项时左缘 = padding-left（首 tab 曾有 0 特例
    // 必然差一截）；absolute 后内边距怎么变它都不用动。top 6px / height 20px。
    Rectangle {
        x: 0px;
        y: 6px;
        width: info.group_color_hex != "" ? 3px : 0px;
        height: 20px;
        border-radius: 0px;
        background: info.group_color;
        opacity: info.group_color_hex == "" ? 0.0
            : (active || touch.has-hover ? 1.0 : 0.55);
        animate opacity { duration: 140ms; }
    }

    // --- 顶部内高光：已删（#tab-32）——与顶部 3px accent 横线职责重复。

}

// --- Tab context-menu item -------------------------------------------------
component TabMenuItem inherits Rectangle {
    in property <string> label;
    in property <bool> enabled: true;
    callback clicked();
    height: 28px;
    border-radius: Theme.radius-sm;
    background: enabled && ta.has-hover ? Theme.bg-hover : transparent;
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        Text {
            text: label;
            color: enabled ? Theme.text-primary : Theme.text-muted;
            font-size: Theme.fs-sm;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
    }
    ta := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// --- TabBar ----------------------------------------------------------------
export component TabBar inherits Rectangle {
    in property <[TabInfo]> tabs;
    in property <string> active-id;
    in property <bool> show-new-tab: true;
    in property <bool> can-merge-pane: false;
    // Keep this much clear on the right so tabs don't slide under the app's
    // top-right toolbar icons, which are positioned over the tab row (#122).
    in property <length> reserve-right: 0px;
    // Window-wide tab-drag hand-off (#408). The window root hit-tests the live
    // drag against each pane's rect (pure model data) and hands the hovering strip
    // the cursor in its own coordinates, so this strip can offer an insertion index
    // for a tab dropped in from another pane. Keeping the hit-test out of here
    // matters: every binding a `changed` handler depends on must stay free of
    // layout results, or its eager first evaluation recurses into the very layout
    // that is creating this component.
    in property <bool> ext-drag-over: false;
    in property <length> ext-drag-x;

    callback tab-selected(string);
    callback tab-closed(string);
    // (#tab-32) 频道（tab-row-idia 稿）：右键菜单的加入/暂停/离开与状态条
    // 恢复入口；menu-channel-letter 供色块勾选显示。
    callback tab-join-channel(string /* tab-id */, int /* slot 0..3 */);
    callback tab-pause-channel(string /* tab-id */);
    callback tab-leave-channel(string /* tab-id */);
    callback show-channel-bar();
    in-out property <bool> channel-bar-hidden: false;
    in property <bool> lang-en: false;   // 频道菜单双语（app.slint 转发）
    in-out property <string> menu-channel-letter: "";
    in-out property <bool> menu-channel-paused: false;
    callback new-tab();
    // Drag-to-reorder (#408), committed exactly once on drop: move the tab at
    // `from` to `to`, where `to` is the insertion index AFTER `from` has been
    // removed from the list.
    callback tab-move(int /* from */, int /* to */);
    // Split this pane, peeling `tab-id` into a new pane on `dir` (#v0.5).
    callback tab-split(string /* tab-id */, string /* dir */);
    // Open another connection to the same session as `tab-id` (#v0.5).
    callback tab-duplicate(string /* tab-id */);
    // Rename an open session's tab (display name only).
    callback tab-rename-request(string /* tab-id */);
    callback merge-pane();
    // Drag-to-split (#v0.5): cursor moved / dropped while dragging `tab-id`, in
    // absolute (window) coordinates. `over-own-strip` tells Rust that this strip
    // is showing its own insertion gap, so no pane drop-zone must light up.
    callback tab-drag-move(string /* tab-id */, length /* abs-x */, length /* abs-y */,
                           bool /* over-own-strip */);
    callback tab-drag-drop(string /* tab-id */, length /* abs-x */, length /* abs-y */);
    // The gesture ended without a drop (grab lost / nothing to commit): drop any
    // highlight the drag put up.
    callback tab-drag-cancel();
    // Insertion index this strip offers for a tab dragged in from another pane;
    // -1 while the cursor is somewhere else (#408).
    callback drop-index-changed(int);

    // Right-click context-menu state.
    property <length> menu-x;
    property <length> menu-y;
    property <string> menu-target;

    // (#tab-polish 2026-09-14) 36 → 40px（32px 标签 + 上下各 4px），条带更舒展。
    // 底色改用 Theme.tab-bar-bg：亮色档比 bg-panel-alt 深一档，选中标签的
    // "背景分野"才看得出来（详见 theme.slint）。
    height: 32px;
    background: Theme.tab-bar-bg;

    // Width of a tab, from its title length. Shared by the strip's slots and the
    // drag ghost so the two agree pixel-for-pixel.
    pure function tab-width(len: int) -> length {
        return clamp(76px, 50px + len * 7px * Theme.ui-scale, 320px);
    }

    // --- Drag-to-reorder state (#408) --------------------------------------
    // Nothing here touches the model: the slots stay exactly where they are for
    // the whole gesture, which is what keeps the dragged tab's pointer grab (and
    // therefore the drag) alive across any number of slots. Only the drop commits.
    //
    // Everything a `changed` handler below can reach must be computable without
    // asking the layout for a position — those handlers are evaluated eagerly when
    // a slot is created, which happens *inside* the layout pass, so a peek at
    // `x` / `width` / `absolute-position` there recurses. Hence the cursor arrives
    // pre-converted from the event handler (where reading geometry is safe) and
    // every tracked binding short-circuits on a plain flag first.
    property <bool> drag-active;
    property <int> drag-from: -1;
    // Insertion index in the "dragged tab removed" list; see `tab-move`.
    property <int> drag-to: -1;
    property <length> drag-width;
    property <length> grab-offset;
    // Cursor relative to this bar's top-left, and whether it is still on the strip
    // row. Both are written by `drag-move` rather than bound, to keep them (and the
    // tracked bindings that read them) independent of the layout.
    property <length> cursor-x;
    property <length> cursor-y;
    property <bool> over-strip;
    property <bool> reordering: root.drag-active && root.drag-from >= 0 && root.over-strip;
    // Cursor in strip-content space: past the bar's 4px padding and through the
    // scroll offset. A binding, not a stored value, so edge auto-scrolling keeps
    // the ghost and the insertion index live while the pointer stands still.
    property <length> content-x: root.cursor-x - 4px - flick.content-x;
    // Ghost's left edge, clamped to the visible part of the strip so it can never
    // be dragged out of sight. Only ever evaluated while a drag is live.
    property <length> ghost-x: clamp(root.content-x - root.grab-offset,
        -flick.content-x,
        max(-flick.content-x, -flick.content-x + flick.width - root.drag-width));

    function begin-drag(index: int, offset: length, slot-width: length) {
        root.drag-from = index;
        root.drag-to = index;
        root.grab-offset = offset;
        root.drag-width = slot-width;
        root.drag-active = true;
    }

    function end-drag() {
        root.drag-active = false;
        root.over-strip = false;
        root.drag-from = -1;
        root.drag-to = -1;
    }

    // Absolute cursor -> bar-local. Safe here: an event handler runs with the
    // layout settled, unlike the bindings above.
    function track-cursor(ax: length, ay: length) {
        root.cursor-x = ax - root.absolute-position.x;
        root.cursor-y = ay - root.absolute-position.y;
        root.over-strip = root.cursor-x >= 0px && root.cursor-x <= root.width
            && root.cursor-y >= -10px && root.cursor-y <= root.height + 10px;
    }

    function drag-move(id: string, ax: length, ay: length) {
        root.track-cursor(ax, ay);
        // Reported for every move, in or out of the strip: Rust needs it to track
        // the cross-window merge target, and the window root republishes it to the
        // other panes' strips.
        root.tab-drag-move(id, ax, ay, root.reordering);
    }

    function drag-drop(id: string, ax: length, ay: length) {
        root.track-cursor(ax, ay);
        if (root.reordering) {
            if (root.drag-to >= 0 && root.drag-to != root.drag-from) {
                root.tab-move(root.drag-from, root.drag-to);
            } else {
                root.tab-drag-cancel();
            }
        } else {
            root.tab-drag-drop(id, ax, ay);
        }
        root.end-drag();
    }

    // Visual let-in: a tab the dragged one has moved past slides over by one slot,
    // opening the gap it will land in. Each slot decides on its own — the run of
    // "passed" slots is exactly the run that has to move — so no reduction over the
    // strip is needed for the animation.
    pure function slot-shift(i: int, passed: bool) -> length {
        if (!root.reordering || i == root.drag-from) {
            return 0px;
        }
        if (i > root.drag-from) {
            return passed ? -(root.drag-width + 3px) : 0px;
        }
        return passed ? 0px : root.drag-width + 3px;
    }

    // --- Insertion index for a tab dragged in from another pane (#408) ------
    property <bool> ext-hover: root.ext-drag-over && !root.drag-active;
    property <length> ext-content-x: root.ext-drag-x - 4px - flick.content-x;
    property <int> ext-index: -1;
    changed ext-hover => {
        root.ext-index = root.ext-hover ? 0 : -1;
        root.drop-index-changed(root.ext-index);
    }
    changed ext-index => {
        if (root.ext-hover) {
            root.drop-index-changed(root.ext-index);
        }
    }

    // True only when the tabs are wider than the available strip width (#122).
    // Computed from the TabBar's own width (set by the parent), not flick.width,
    // so showing the arrows (which shrink the flickable) can't feed back into this
    // condition and form a binding loop. The 64px allows for the two arrows.
    property <bool> tab-overflow:
        strip.preferred-width > root.width - root.reserve-right - 64px;

    // Drag past either end of an overflowing strip to scroll it (Chrome-style).
    // `!reordering` first, and a single read of `flick.width`, so this stays out of
    // the layout while idle: the Timer evaluates `running` eagerly.
    property <length> edge-step:
        !root.reordering || !root.tab-overflow ? 0px
        : (root.cursor-x - 4px < 24px ? -6px
        : (root.cursor-x - 4px > flick.width - 24px ? 6px : 0px));
    Timer {
        interval: 16ms;
        running: root.edge-step != 0px;
        triggered => {
            flick.content-x = clamp(flick.content-x - root.edge-step,
                min(0px, flick.width - flick.content-width), 0px);
        }
    }

    HorizontalLayout {
        // (#tab-polish 2026-09-14) 3/2 → 4/3px：与标签同成 4 的倍数，标签之间
        // 也给底部色条留出呼吸。
        // (#tab-flush 2026-09-14) 只保留**上方** 4px：下方归零，标签下沿贴住终端区。
        // (#tab-shape 2026-09-15) 左内边距 4 → 3px：与页签间距(spacing)一致,
        // 首个页签"贴边"的观感 = 侧面板边框 + 3px,和后续页签同节奏(用户定稿)。
        padding-top: 0px;
        padding-bottom: 0px;
        padding-left: 0px;
        padding-right: 0px;
        spacing: 3px;

        // Horizontally-scrollable strip: when the tabs overflow the available
        // width they stay reachable by the arrows or the wheel (#122).
        flick := Flickable {
            // Non-interactive on purpose (#408): an interactive Flickable delays
            // the press to its children by 100ms and, once the tabs overflow,
            // steals the gesture as soon as it travels 8px — which cancelled the
            // tab drag and scrolled the strip instead. Wheel / trackpad scrolling
            // is unaffected (the Flickable still handles wheel events), and the
            // arrows below remain.
            interactive: false;
            horizontal-stretch: 1;
            content-height: self.height;
            content-width: max(self.width, strip.preferred-width);
            strip := HorizontalLayout {
                spacing: 0px;
                alignment: start;
                // The slot owns the geometry and never moves during a drag; the
                // tab inside it is what slides. A layout child cannot have its `x`
                // set (the layout owns it), hence this wrapper.
                for tab[i] in tabs : Rectangle {
                    width: root.tab-width(tab.title_len);
                    horizontal-stretch: 0;
                    // Index in the list with the dragged tab removed.
                    property <int> shifted-index: i < root.drag-from ? i : i - 1;
                    // Has the ghost's leading edge passed this slot's midpoint in
                    // the "dragged tab removed" layout? That layout depends only on
                    // `drag-from`, never on `drag-to`, so the decision can never
                    // feed back into the let-in animation and oscillate. `self.x` is
                    // the slot's offset inside the strip, i.e. content space.
                    property <bool> passed: root.reordering && i != root.drag-from
                        && root.ghost-x > self.x + self.width / 2
                            - (i > root.drag-from ? root.drag-width + 3px : 0px);
                    // Exactly the leading run of slots is "passed", so pushing the
                    // max/min of the crossed boundaries converges on the insertion
                    // index however many slots a single move event skipped over.
                    changed passed => {
                        if (i != root.drag-from) {
                            if (self.passed) {
                                root.drag-to = max(root.drag-to, self.shifted-index + 1);
                            } else {
                                root.drag-to = min(root.drag-to, self.shifted-index);
                            }
                        }
                    }
                    // Same rule for a tab dragged in from another pane, minus the
                    // removal (nothing leaves this strip).
                    property <bool> ext-passed:
                        root.ext-hover && root.ext-content-x > self.x + self.width / 2;
                    changed ext-passed => {
                        if (self.ext-passed) {
                            root.ext-index = max(root.ext-index, i + 1);
                        } else {
                            root.ext-index = min(root.ext-index, i);
                        }
                    }

                    SingleTab {
                        x: root.slot-shift(i, parent.passed);
                        width: parent.width;
                        height: parent.height;
                        // (#tab-drag-ghost-shape 2026-09-15) 原位变暗而非完全消失:
                        // 35% 残影保留"从这里拿走的"的槽位感,与插入线/浮层一起构成
                        // 拖动三态(设计稿 #tab-dnd-3state)。旧版 0.0 完全隐形。
                        opacity: root.reordering && i == root.drag-from ? 0.35 : 1.0;
                        animate x { duration: 120ms; easing: ease-out; }
                        animate opacity { duration: 120ms; }
                        info: tab;
                        active: tab.id == root.active-id;
                        selected => { root.tab-selected(tab.id); }
                        closed => { root.tab-closed(tab.id); }
                        duplicated => { root.tab-duplicate(tab.id); }
                        context-requested(ax, ay) => {
                            root.menu-target = tab.id;
                            root.menu-x = ax - root.absolute-position.x;
                            root.menu-y = ay - root.absolute-position.y;
                            tab-menu.show();
                        }
                        drag-begun(offset) => { root.begin-drag(i, offset, parent.width); }
                        drag-moved(ax, ay) => { root.drag-move(tab.id, ax, ay); }
                        drag-dropped(ax, ay) => { root.drag-drop(tab.id, ax, ay); }
                        drag-cancelled => {
                            root.end-drag();
                            root.tab-drag-cancel();
                        }
                    }

                    // (#tab-dnd-3state 2026-09-15) 拖动插入线:落在"移除被拖项后"
                    // 索引 == drag-to 的槽位左缘(间隙中央),最尾落点画在末槽右缘。
                    // accent 竖线 + 顶圆点,只在实际排序中显示。
                    if root.reordering && i != root.drag-from
                            && (self.shifted-index == root.drag-to
                                || (root.drag-to == root.tabs.length - 1
                                    && i == root.tabs.length - 1)) : Rectangle {
                        x: self.tail ? parent.width - 1.5px : -1.5px;
                        property <bool> tail:
                            root.drag-to == root.tabs.length - 1 && i == root.tabs.length - 1;
                        y: 4px;
                        width: 3px;
                        height: parent.height - 8px;
                        border-radius: 2px;
                        background: Theme.accent-solid;
                        Rectangle {
                            x: -2.5px;
                            y: -5px;
                            width: 8px;
                            height: 8px;
                            border-radius: 4px;
                            background: Theme.accent-solid;
                        }
                    }
                }
                if root.show-new-tab : IconButton {
                    glyph: "+";
                    size: 28px;
                    y: (parent.height - self.height) / 2;
                    clicked => { root.new-tab(); }
                }
            }

            // The dragged tab's floating copy. It lives in the Flickable (so its x
            // is already in content space and it is clipped to the strip) and is
            // declared after `strip`, which puts it on top — Slint's `z` is a
            // compile-time constant, so stacking has to come from declaration order.
            if root.reordering && root.drag-from < root.tabs.length : SingleTab {
                ghost: true;
                info: root.tabs[root.drag-from];
                active: root.tabs[root.drag-from].id == root.active-id;
                x: root.ghost-x;
                y: 0px;
                width: root.drag-width;
                // (#tab-flush 2026-09-14) 跟随标签加高，ghost 与落位尺寸一致。
                height: 32px;
            }
        }

        // Reserved gap for the external top-right toolbar icons (#122).
        Rectangle { width: root.reserve-right; }
    }

    // (#tab-overflow-list 2026-09-15) 溢出 UI 整体重做(用户定稿):废弃左右
    // "<"">"滚动箭头(丑、且盖在页签上),改为**右缘渐隐遮罩 + 「⋯」胶囊按钮**,
    // 点击弹出全部页签列表面板(自上而下 = 自左而右,行首组色竖条,悬停出
    // 红色关闭键,点击行切换)。横向滚动仍由滚轮/拖拽边界自动滚动承担,
    // overlay 用绝对定位,显隐不影响 tab-overflow 的布局判定(避免绑定环)。
    if root.tab-overflow : Rectangle {
        x: parent.width - root.reserve-right - 76px;
        y: 0px;
        width: 76px;
        height: parent.height;
        // (#tab-32) 渐隐端色 = 条带底色 = term-bg 的不透底（slot-tbg，Rust
        // 按主题写入）——硬编码 #2a2d35/#eaeaef 退役。渐变 stop 只接受 color。
        background: @linear-gradient(90deg,
            Theme.slot-tbg.with-alpha(0),
            Theme.slot-tbg 72%);
        more-btn := Rectangle {
            x: parent.width - self.width - 6px;
            y: (parent.height - self.height) / 2;
            width: 28px;
            height: 28px;
            border-radius: Theme.radius-sm;
            background: more-ta.has-hover ? Theme.bg-active : Theme.bg-hover;
            drop-shadow-blur: 8px;
            drop-shadow-color: #00000045;
            more-ta := TouchArea {
                mouse-cursor: pointer;
                clicked => { tab-list-menu.show(); }
            }
            for d in [0, 1, 2] : Rectangle {
                x: 6px + d * 7px;
                y: (parent.height - 4px) / 2;
                width: 4px;
                height: 4px;
                border-radius: 2px;
                background: Theme.text-secondary;
            }
        }
    }
    // 全页签列表面板:行首组色竖条(与页签同语言) + 标题,当前页签高亮,
    // 悬停行右缘出现红色关闭键。行高 32px,列表面板最高 ~9 行,超出滚动。
    tab-list-menu := PopupWindow {
        x: parent.width - self.width - 8px;
        y: 40px;
        width: 252px;
        height: min(root.tabs.length * 32px + 40px, 330px);
        Rectangle {
            background: Theme.popup-bg;
            border-radius: Theme.radius-md;
            border-width: 1px;
            border-color: Theme.border-strong;
            drop-shadow-blur: 14px;
            drop-shadow-color: #00000060;
            VerticalLayout {
                padding: 5px;
                Text {
                    height: 22px;
                    text: @tr("All tabs");
                    color: Theme.text-muted;
                    font-size: Theme.fs-xs;
                    vertical-alignment: center;
                    x: 6px;
                }
                Flickable {
                    vertical-stretch: 1;
                    content-height: root.tabs.length * 32px;
                    content-width: self.width;
                    VerticalLayout {
                        spacing: 1px;
                        for t in root.tabs : Rectangle {
                            height: 32px;
                            border-radius: Theme.radius-sm;
                            background: t.id == root.active-id || row-ta.has-hover
                                ? Theme.bg-hover : transparent;
                            // 行首组色竖条:与页签左缘竖条同一视觉语言。
                            // 元素始终存在,无色时宽 0 —— 避免 `if` 条件元素
                            // 在 hex 从空变非空时不重建。
                            Rectangle {
                                x: 7px;
                                y: 8px;
                                width: t.group_color_hex != "" ? 3px : 0px;
                                height: parent.height - 16px;
                                border-radius: 2px;
                                background: t.group_color;
                                opacity: t.group_color_hex == "" ? 0.0
                                    : (t.id == root.active-id ? 1.0 : 0.55);
                            }
                            Text {
                                x: 20px;
                                width: parent.width - 52px;
                                text: t.title;
                                color: t.id == root.active-id
                                    ? Theme.text-primary : Theme.text-secondary;
                                font-size: Theme.fs-sm;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                            // 悬停行右缘的红色关闭键(仅非 welcome 页签)。
                            if t.kind != "welcome" : Rectangle {
                                x: parent.width - self.width - 6px;
                                y: (parent.height - self.height) / 2;
                                width: 20px;
                                height: 20px;
                                border-radius: Theme.radius-sm;
                                background: close-ta.has-hover ? #e81123 : transparent;
                                opacity: row-ta.has-hover || close-ta.has-hover ? 1.0 : 0.0;
                                close-ta := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        root.tab-closed(t.id);
                                        tab-list-menu.close();
                                    }
                                }
                                Icon {
                                    glyph: "close";
                                    tint: close-ta.has-hover ? white : Theme.text-secondary;
                                    size: Theme.fs-sm;
                                }
                            }
                            row-ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.tab-selected(t.id);
                                    tab-list-menu.close();
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    // Right-click context menu (v0.5): split this pane by peeling the clicked tab
    // into a new pane. Splitting needs at least two tabs so the source pane survives.
    tab-menu := PopupWindow {
        x: root.menu-x;
        y: root.menu-y;
        width: 140px;
        // (#tab-32) 频道组动态加入：高度按菜单状态计算（基线 8 项 = 原 7 项
        // + 加入频道行；已加入再加暂停/离开两行；barHidden 再加显示状态条一行）。
        height: (8
            + (root.menu-channel-letter != "" ? 2 : 0)
            + (root.channel-bar-hidden ? 1 : 0)) * 29px + 13px + 30px;
        Rectangle {
            background: Theme.popup-bg;
            border-radius: Theme.radius-sm;
            border-width: 1px;
            border-color: Theme.border-strong;
            drop-shadow-blur: 12px;
            drop-shadow-color: #00000060;
            VerticalLayout {
                padding: 4px;
                spacing: 1px;
                // ── 频道组（#tab-32）：加入频道 4 色块 + 暂停/离开/显示状态条。
                // **原有菜单项全部保留**（Duplicate/Rename/Split/Merge/Close）。
                Text {
                    text: root.lang-en ? "Join channel" : "加入频道";
                    color: Theme.text-muted; font-size: 10px;
                    height: 20px;
                    HorizontalLayout { padding-left: 8px; padding-top: 6px; }
                }
                Rectangle {
                    height: 30px;
                    HorizontalLayout {
                        padding-left: 10px;
                        spacing: 8px;
                        alignment: start;
                        // 4 个 16px 色块（固定 4 槽；常驻、点选归频道——点任意
                        // 色块即**切换**到该频道，已加入的再点其它色块=换频道）。
                        // (#tab-32-join-distinct 2026-10-08) 加入态 = 2px 描边环
                        //（文字主色）；未加入 = 1px 细描边。不再降透明（旧版
                        // 未加入位 35% 透明读成"禁用不可点"，用户反馈）。色值 =
                        // Theme.channel-colors（按主题自适应，见 theme.slint）。
                        for cs in [
                            { slot: 0, letter: "A" }, { slot: 1, letter: "B" },
                            { slot: 2, letter: "C" }, { slot: 3, letter: "D" },
                        ] : Rectangle {
                            property <color> cc: Theme.channel-colors[cs.slot];
                            property <bool> joined: root.menu-channel-letter == cs.letter;
                            width: 16px; height: 16px; border-radius: 4px;
                            background: cc;
                            border-width: self.joined ? 2px : 1px;
                            border-color: self.joined ? Theme.text-primary : Theme.border-subtle;
                            Text {
                                text: cs.letter;
                                color: white; font-size: 10px; font-weight: 800;
                                horizontal-alignment: center; vertical-alignment: center;
                            }
                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.menu-channel-letter = cs.letter;
                                    root.tab-join-channel(root.menu-target, cs.slot);
                                }
                            }
                        }
                        Rectangle { horizontal-stretch: 1; }
                    }
                }
                if root.menu-channel-letter != "" : Rectangle { height: 1px; background: Theme.border-subtle; }
                if root.menu-channel-letter != "" : TabMenuItem {
                    label: root.menu-channel-paused ? (root.lang-en ? "Resume channel" : "继续参与频道") : (root.lang-en ? "Pause channel" : "暂停参与频道");
                    clicked => { root.tab-pause-channel(root.menu-target); }
                }
                if root.menu-channel-letter != "" : TabMenuItem {
                    label: root.lang-en ? "Leave channel" : "离开频道";
                    clicked => { root.tab-leave-channel(root.menu-target); }
                }
                if root.channel-bar-hidden : TabMenuItem {
                    label: root.lang-en ? "Show channel bar" : "显示状态条";
                    clicked => { root.show-channel-bar(); }
                }
                Rectangle { height: 1px; background: Theme.border-subtle; }
                TabMenuItem {
                    label: @tr("Duplicate connection");
                    enabled: root.menu-target != "welcome";
                    clicked => { root.tab-duplicate(root.menu-target); }
                }
                TabMenuItem {
                    label: @tr("Rename");
                    enabled: root.menu-target != "welcome";
                    clicked => { root.tab-rename-request(root.menu-target); }
                }
                Rectangle { height: 1px; background: Theme.border-subtle; }
                TabMenuItem {
                    label: @tr("Split right");
                    enabled: root.tabs.length > 1;
                    clicked => { root.tab-split(root.menu-target, "right"); }
                }
                TabMenuItem {
                    label: @tr("Split down");
                    enabled: root.tabs.length > 1;
                    clicked => { root.tab-split(root.menu-target, "down"); }
                }
                TabMenuItem {
                    label: @tr("Merge panes");
                    enabled: root.can-merge-pane;
                    clicked => { root.merge-pane(); }
                }
                Rectangle { height: 1px; background: Theme.border-subtle; }
                TabMenuItem {
                    label: @tr("Close tab");
                    enabled: root.menu-target != "welcome";
                    clicked => { root.tab-closed(root.menu-target); }
                }
            }
        }
    }
}
