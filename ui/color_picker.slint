// 通用取色盘（ui/color_picker.slint）：强调色 / 组别 / 终端光标共用的
// ColorPickerDialog 组件 + PickerMath 全局。业务拆分见 src/picker/mod.rs ——
// 颜色数学与位图烘焙在 Rust picker 模块，这里只经 PickerMath 回调调用。
//
// 调用方约定：
//   * 全窗遮罩 + 居中定位 + Esc 链由调用方负责（根层浮层模式，同 theme-pick）；
//   * `hex` 双向绑定调用方的「选定色」，`confirmed` 里自行写回/落库 —— 组件
//     只改自己的 hex，永不直接生效；
//   * `@children` 传示例条（如强调色的 选中态/主按钮/链接 三件套），颜色跟
//     `hex` 实时联动；
//   * `bounds-w/h` 传全窗尺寸，供头部拖动的边界钳制。
import { Theme } from "theme.slint";
import { SegGroup } from "seg.slint";
import { Icon } from "icons.slint";

// (#color-info-card 2026-10-14) 取色信息卡：HEX / RGB / HSV / HSL 四行等宽
// 对齐，悬停浮出、移出消失。**唯一实现** —— 强调色弹框副标题行里的色块
// （InfoSwatch）与「最近」行的色块共用这一张卡（用户要求两处提示框同款：
// 同尺寸、同字号、同字色。此前「最近」行另抄了一份 168×100 的卡，首行放大到
// 12px、RGB/HSV/HSL 三行用 text-secondary，两处观感对不上）。
// 四行标签同为 3 个拉丁字符 + 全角「：」，定宽字体下严格同宽 → 值列对齐。
// (#info-swatch-colon 2026-10-14) 全角冒号分隔(用户要求):原先靠两个空格凑出
// 的分隔没有"标签/值"的语义边界，值列对齐反而要看空格个数。
export component ColorInfoCard inherits Rectangle {
    in property <string> hex;
    width: 168px;
    height: 100px;
    border-radius: 8px;
    // (#info-card-theme 2026-10-16) 底色原先写死暗色 `#111318` —— 浅色主题下
    // 这张卡仍是深底（用户反馈「没有跟随主题」）。改用统一浮层 token
    // `bg-elevated`：跟随主题，且比它浮在其上的弹框（`popup-bg` = 面板底色）
    // 高一档，靠边框 + 14px 投影勾出卡片轮廓。四行文字本就是主题 token，换底即两档正确。
    background: Theme.popup-bg-elevated;
    border-width: 1px;
    border-color: Theme.border-strong;
    drop-shadow-blur: 14px;
    drop-shadow-color: transparent;
    VerticalLayout {
        padding-top: 10px;
        padding-bottom: 10px;
        padding-left: 12px;
        padding-right: 12px;
        spacing: 4px;
        alignment: center;
        Text {
            text: "HEX：" + root.hex;
            color: Theme.text-primary;
            font-size: 10.5px;
            font-family: Theme.term-font-family;
        }
        Text {
            text: "RGB：" + PickerMath.hex-ch(root.hex, 0, "rgb") + ", "
                + PickerMath.hex-ch(root.hex, 1, "rgb") + ", "
                + PickerMath.hex-ch(root.hex, 2, "rgb");
            color: Theme.text-primary;
            font-size: 10.5px;
            font-family: Theme.term-font-family;
        }
        Text {
            text: "HSV：" + PickerMath.hex-ch(root.hex, 0, "hsv") + "°  "
                + PickerMath.hex-ch(root.hex, 1, "hsv") + "%  "
                + PickerMath.hex-ch(root.hex, 2, "hsv") + "%";
            color: Theme.text-primary;
            font-size: 10.5px;
            font-family: Theme.term-font-family;
        }
        Text {
            text: "HSL：" + PickerMath.hex-ch(root.hex, 0, "hsl") + "°  "
                + PickerMath.hex-ch(root.hex, 1, "hsl") + "%  "
                + PickerMath.hex-ch(root.hex, 2, "hsl") + "%";
            color: Theme.text-primary;
            font-size: 10.5px;
            font-family: Theme.term-font-family;
        }
    }
}

// (#accent-pop-v3) 取色信息小色块：色块本体 + 悬浮信息卡（ColorInfoCard，
// 悬停浮出、移出消失）。卡片默认向上浮出；card-below = true 时向下（用于
// 靠近弹框顶部的行，避免越出弹框被裁剪）。
// (#swatch-parity 2026-10-14) 与强调色弹框「最近」行色块取齐，两处 11px 文字
// 旁的色块必须同规格（用户要求）：
//   * 边框 0/1px → 常态 1px、悬停 2px（同为最近行规格）。若一边有 1px 描边、
//     另一边没有，纯色区就差 2px，并排仍不齐。悬停色用对比色描边（深色块→白、
//     浅色块→黑），浅色块上细白边会看不见。
// (#swatch-size-match 2026-10-15) 尺寸 20px → 14px、圆角 6px → 4px：与设置页
// 「主题」下拉选择框里的色块**逐像素同规格**（截图实测该色块 14×14 / 圆角 4，
// 参照物 = 主题行右侧「GitHub · 暗」框内那个色块）。20px 比同行 11px 文字大近
// 一倍，色块与文字「整体大小」不一致（用户截图③）。
// ⚠ 本组件与「最近」行（app.slint）是同一事实的两份副本，必须同批改。
export component InfoSwatch inherits Rectangle {
    in property <string> hex;
    in property <bool> card-below: false;
    width: 14px;
    height: 14px;
    border-radius: 4px;
    background: PickerMath.hex-color(root.hex);
    border-width: sw-ta.has-hover ? 2px : 1px;
    border-color: sw-ta.has-hover ? PickerMath.ink-on(root.hex).with-alpha(0.72) : #ffffff26;
    sw-ta := TouchArea {
        mouse-cursor: pointer;
    }
    ColorInfoCard {
        hex: root.hex;
        x: (parent.width - self.width) / 2;
        y: root.card-below ? parent.height + 8px : -(self.height + 8px);
        visible: sw-ta.has-hover;
    }
}

// (#picker-input 2026-10-15) 取色盘输入行：标签 + 数值 + 统一聚焦样式。
// HEX 行与 R/G/B 行**同一实现**（此前 HEX 是独立手写块、三分量是内联 for 循环，
// 聚焦样式无处安放、两份代码迟早漂移）。要点：
//   * 聚焦样式 = 全应用输入框同款（MiniInput）：边框转 Theme.accent + 外扩 3px
//    的 accent-soft 柔光环；点输入框外由 blur-token 统一离焦（Slint 点空白
//     **不会**自动清焦点，必须显式 clear-focus）；
//   * 标签列定宽 30px（容得下 "HEX"），值列全部右对齐 → 四行标签、值各成一条竖线。
//
// (#picker-input-edit 2026-10-15) 用户反馈「第一次点只出聚焦边框、打不进字；
// 能编辑后光标落在行首，且够不到行尾」。用 Slint 测试后端真派发鼠标/键盘
// 事件复现（回归测试见 src/picker/ui_input_test.rs）后定位到两条真因，都出在本
// 组件，不在事件派发：
//   ① 值列右对齐 → 文字左边那一大片空白在 Slint 的命中测试里全部映射到偏移 0
//      （i-slint-core items/text.rs::byte_offset_for_position）。于是「点哪儿光标
//      都落行首」，而文字右缘紧贴右内边距、右边根本没有可点区域 → 靠鼠标永远
//      到不了行尾。旧代码想用 `changed has-focus` 里 set-selection-offsets(末,末)
//      把光标带到右端，但那次赋值发生在**同一次按下事件的前半段**，Rust 侧紧接着
//      的 set_cursor_position_with_affinity(命中偏移) 又把它覆盖回 0 —— 旧注释说
//      的「同官方 SpinBox 做法」在这个右对齐 + 单击场景下并不成立。
//   ② 打字过程中每个按键都经 edited→hex-apply 立刻回写事实源，`changed value`
//      又把钳过的值塞回输入框：想输入 300 会在第三个键被钳成 255、想输入 173
//      中间态会被 rem_euclid 拉走，看起来就是「打了没反应 / 数字乱跳」。
// 现在改成**数值框的通行做法**：
//   * 点入即全选（`select-all()`），打字/粘贴直接替换整段值 —— 一次点击就能改；
//     再点一次才落光标（此时是「已聚焦」状态，Slint 的按下定位不再被我们覆盖），
//     于是「想改某一位」也照常可用；
//   * 全选**不能**在 `changed has-focus` 里同步做（会被同一次按下的光标定位覆盖，
//     同上 ①），改用 0ms Timer 推到这次事件派发之后；
//   * 聚焦期间**不回写**输入框文本（`changed value` 加 `!has-focus` 守卫）：事实源
//     实时联动照旧（edited 上报），但用户敲到一半的串不会被钳过的值抽走；离焦
//     （blur-token 或焦点自然移走）时把事实值收敛回输入框。
component PickerInput inherits Rectangle {
    in property <int> idx;
    in property <string> label;
    in-out property <string> value;
    // 当前选色（只用于选中块配色；值列本身已经按 value 显示）
    in property <string> hex: "";
    // 每次「点输入框外」自增 → 已聚焦的输入框自行离焦（无需互查焦点归属）
    in property <int> blur-token: 0;
    // (#picker-channel 2026-10-15) 只画数值框、不要标签列（分量滑杆行右侧的
    // 数字框）。标签列连同它那 26px 与 8px 间距一起去掉，宽度交给调用方给。
    in property <bool> bare: false;
    // 行尾复制键（HEX 行用）
    in property <bool> copyable: false;
    callback edited(string);
    callback copy-requested();
    height: 36px;
    horizontal-stretch: 1;
    border-radius: 8px;
    background: Theme.popup-field;
    border-width: 1px;
    border-color: inp.has-focus ? Theme.accent : Theme.border-control;
    animate border-color { duration: 120ms; }
    // 聚焦柔光环（MiniInput 同款；圆角 8 + 3 = 11 与外框同心）
    if inp.has-focus : Rectangle {
        x: -3px;
        y: -3px;
        width: parent.width + 6px;
        height: parent.height + 6px;
        border-radius: 11px;
        border-width: 3px;
        border-color: Theme.accent-soft;
    }
    // 点入 → 本轮事件派发结束后全选（见上方 #picker-input-edit ①）
    // (#picker-copy-ui 2026-10-15) 复制键的「已复制」回执（1.4s 自动收起）
    property <bool> copied: false;
    // (#picker-no-select-all 2026-10-15) 「点入即全选」按用户反馈移除：第一次
    // 点击只落光标（常规输入框行为），要整选请 Ctrl+A / 双击。
    // (#picker-hex-hash 2026-10-15) hash-mode：# 常驻，编辑时缺席自动补回。
    in property <bool> hash-mode: false;
    HorizontalLayout {
        padding-left: root.bare ? 8px : 10px;
        padding-right: 10px;
        spacing: 8px;
        if !root.bare : Text {
            // (#picker-label-size 2026-10-15) 行标识（HEX / R / G / B）按反馈提亮
            // 放大：原 muted 10px 像"备注说明"，与右侧 13px 的数值明显两层皮；
            // 改为前景色 + fs-sm，与数值同档同号。
            width: 30px;
            text: root.label;
            color: Theme.text-primary;
            font-size: Theme.fs-sm;
            vertical-alignment: center;
        }
        inp := TextInput {
            horizontal-stretch: 1;
            height: parent.height;
            text: root.value;
            color: Theme.text-primary;
            font-size: 13px;
            font-family: Theme.term-font-family;
            // (#picker-caret-fix 2026-10-15) 右对齐会让命中测试全映射到偏移 0
            // （#picker-input-edit 自己诊断过：点哪儿光标都在行首、行尾永不可达）；
            // 点入即全选只是绕过了第一次点击，再点"落光标"依旧落在行首。改左对齐，
            // 光标位置与行尾可达性恢复正常。
            horizontal-alignment: left;
            vertical-alignment: center;
            single-line: true;
            // (#picker-input-edit) 点入即全选 → 每次点输入框都会闪一下选中块。
            // 选中色跟当前选色（与分段滑层同为 accent 系），不用 fluent 默认的蓝：
            // 这一屏所有"选中/当前"语义都由选色表达，蓝块是唯一的例外色。
            selection-background-color: PickerMath.hex-color(root.hex).with-alpha(0.32);
            selection-foreground-color: Theme.slot-t1;
            edited => {
                // (#picker-hex-hash) # 缺席时补回并写回显示：输入框里永不出现
                // "没有 # 的 hex"（# 是 HEX 的常驻标识）。
                if (root.hash-mode && !self.text.starts-with("#")) {
                    self.text = "#" + self.text;
                }
                root.edited(self.text);
            }
            changed has-focus => {
                if (!self.has-focus) {
                    // 离焦即收敛：打字中间态（非法 HEX、被钳过的数值）回写事实源
                    self.text = root.value;
                }
            }
        }
        // (#picker-copy-ui 2026-10-15) 复制键三处一起修：
        //  ① 固定高子元素在 HL 里默认顶对齐（22px 方块贴行首上沿，用户截图
        //     "不居中"）→ 包一层 alignment: center 的 VL；
        //  ② Icon 在非布局父级里不写显式宽高会铺满整盒、内部再"居中之居中"
        //     （toast 对勾同款坑）→ 显式 12×12 + HL 居中；
        //  ③ 点击给「已复制」回执：1.4s 绿色气泡（与 PathAction 的 done-tip、
        //     侧栏 Copied 徽标同款），每次点击重启计时器 —— 此前点了没反馈。
        if root.copyable : VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;
            copy-box := Rectangle {
                // (#picker-copy-size 2026-10-15) 22→26 / 图标 12→16：与 13px 的
                // 数值文字视觉重量协调（用户反馈"再大些"）。
                width: 26px;
                height: 26px;
                border-radius: 7px;
                background: copy-ta.has-hover ? Theme.bg-hover : transparent;
                // (#picker-copy-center 2026-10-15) 绝对居中坐标：HL 的
                // alignment: center 只管主轴，交叉轴 stretch 下固定高子元素仍
                // 顶对齐（用户实测"只有悬浮背景居中了"——方块居中、图标不居中）。
                Icon {
                    glyph: "copy";
                    tint: copy-ta.has-hover ? Theme.text-primary : Theme.text-muted;
                    size: 16px;
                    width: 16px;
                    height: 16px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }
                copy-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.copy-requested();
                        root.copied = true;
                        copied-timer.running = false;
                        copied-timer.running = true;
                    }
                }
                if root.copied : Rectangle {
                    x: copy-box.width - self.width;
                    y: -self.height - 4px;
                    width: done-txt.preferred-width + 16px;
                    height: 22px;
                    background: Theme.popup-bg-elevated;
                    border-radius: Theme.radius-sm;
                    border-width: 1px;
                    border-color: Theme.border-strong;
                    drop-shadow-blur: 8px;
                    drop-shadow-color: transparent;
                    done-txt := Text {
                        width: parent.width;
                        height: parent.height;
                        text: @tr("Copied");
                        color: Theme.success;
                        font-size: Theme.fs-xs;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
    // 「已复制」1.4s 收起；每次点击 false→true 重启（见上方 #picker-copy-ui ③）
    copied-timer := Timer {
        interval: 1400ms;
        running: false;
        triggered => { root.copied = false; self.running = false; }
    }
    // 用户在框内打字会**移除 text 上的绑定**（Slint 语义：内部 set 断开外部绑定），
    // 此后色轮 / 明度条 / 其它分量驱动的外部变化必须手动回写，否则该行永远停在
    // 手输值（官方 SpinBox 同款做法）。edited 走回调上报，单向流动不打架。
    // ⚠ 聚焦期间跳过：用户在敲字，事实源那边钳过的值不许抢走光标下的串。
    changed value => {
        if (!inp.has-focus) {
            inp.text = root.value;
        }
    }
    // (#picker-blur-sync 2026-10-15) 离焦即收敛：打字中间态（非法 HEX、"999"
    // 这类被 hex-apply 钳过的数值）在离焦瞬间回写为事实源的值 —— 输入框永远与
    // 盘上选色一致，不会停在用户敲了一半的串上。
    changed blur-token => {
        if (inp.has-focus) {
            inp.clear-focus();
            inp.text = root.value;
        }
    }
}

// (#picker-channel 2026-10-15 方案 B) 分量行：标签 + 渐变滑杆 + 数字框。
// 用户在高保真里选了 B（A + 分量滑杆 + HEX 复制），行高与原先同构（36px），
// 所以右列总高、色轮尺寸、整卡高度都不变 —— 只把「看得见的值」变成「拖得动的值」。
//   * 滑杆底：一般分量用「该分量从最小到最大」的两端色做线性渐变，端点色由
//     PickerMath.hex-apply 现推（其余分量保持不变），不需要预烘焙位图；色相 H
//     例外 —— 它的两端色（hue 0 → hue 100）不是彩虹，改用七停静态彩虹渐变。
//   * 数字框 = PickerInput(bare)：聚焦样式、点入全选、打字不回灌、离焦收敛
//     全部复用同一实现，不另抄一份。
//   * 拖动：整行高（36px）都是命中区，视觉条只有 6px，好抓；比例经
//     PickerMath.track-value 转成该分量的值串，再走 hex-apply 写事实源 ——
//     与手输数字走**同一条**通道（钳制、联动、sync-pos 语义完全一致）。
component PickerChannel inherits Rectangle {
    in property <int> idx: 0;
    in property <string> label;
    in property <string> hex: "";
    in property <string> fmt: "rgb";
    in property <string> value;              // 数字框显示值（与 hex-ch 同源）
    in property <int> blur-token: 0;
    callback edited(string);
    callback picked(float);                  // 拖动滑块 → 0..1
    height: 36px;
    horizontal-stretch: 1;
    // 量程与 hex-ch / hex-apply 同口径：rgb 0..255；H 0..360；S/V/L 0..100
    property <float> max-value: root.fmt == "rgb" ? 255 : (root.idx == 0 ? 360 : 100);
    property <float> ratio: Math.max(0, Math.min(1,
        PickerMath.hex-ch(root.hex, root.idx, root.fmt).to-float() / root.max-value));
    property <color> lo-color: PickerMath.hex-color(
        PickerMath.hex-apply(root.hex, root.idx, "0", root.fmt));
    property <color> hi-color: PickerMath.hex-color(
        PickerMath.hex-apply(root.hex, root.idx, root.fmt == "rgb" ? "255" : "100", root.fmt));
    // HSL 的 L 通道两端是黑与白，单纯两停渐变会把中间调色丢掉（看着像一根灰阶
    // 而非"这根色相的明度条"）→ 中间补一停 l=50 的当前色相。
    property <color> mid-color: PickerMath.hex-color(
        PickerMath.hex-apply(root.hex, root.idx, "50", root.fmt));
    property <bool> mid-stop: root.fmt == "hsl" && root.idx == 2;
    HorizontalLayout {
        spacing: 8px;
        Text {
            // (#picker-label-col 2026-10-16) 标签列 22 → 30px：与 PickerInput 的
            // 标签列同宽，HEX 行并入右列后四行标签成一条竖线（用户要求「在输入
            // 左侧加上 HEX」）。滑块相应右移 8px，可拖宽度略减。
            width: 30px;
            // (#picker-label-size 2026-10-15) 分量标识（R/G/B…）与 HEX 行标签
            // 同批提亮放大：muted 10px → 前景色 fs-sm，与右侧数值同档同号。
            text: root.label;
            color: Theme.text-primary;
            font-size: Theme.fs-sm;
            vertical-alignment: center;
        }
        track := Rectangle {
            horizontal-stretch: 1;
            height: parent.height;
            // 视觉条（渐变底）
            Rectangle {
                y: (parent.height - 6px) / 2;
                width: parent.width;
                height: 6px;
                border-radius: 3px;
                // (#picker-hue-ramp 2026-10-16) H 条改用 **Rust 烘的色相条位图**：
                // 原来的七停 @linear-gradient 实测有断层（用户反馈「彩色滑动条
                // 显示不全 → 有断层」）。位图逐像素求色、与明度条同一范式；
                // 内层再套一层 clip + 圆角，让位图跟着圆角切（Image 自身无圆角）。
                if root.idx == 0 && root.fmt != "rgb" : Rectangle {
                    width: 100%; height: 100%;
                    border-radius: 3px;
                    clip: true;
                    Image {
                        source: PickerMath.hue-image;
                        width: parent.width;
                        height: parent.height;
                    }
                }
                if !(root.idx == 0 && root.fmt != "rgb") : Rectangle {
                    width: 100%; height: 100%;
                    background: root.mid-stop
                        ? @linear-gradient(90deg, #000000 0%, root.mid-color 50%, #FFFFFF 100%)
                        : @linear-gradient(90deg, root.lo-color 0%, root.hi-color 100%);
                }
            }
            // 滑块：白圆 + 描边 + 投影（深色渐变上也看得见）
            Rectangle {
                x: Math.max(0px, Math.min(root.ratio * parent.width - 6.5px, parent.width - 13px));
                y: (parent.height - 13px) / 2;
                width: 13px;
                height: 13px;
                border-radius: 7px;
                background: #ffffff;
                border-width: 1px;
                border-color: #00000066;
                drop-shadow-blur: 3px;
                drop-shadow-color: #000000a6;
            }
            track-ta := TouchArea {
                mouse-cursor: col-resize;
                moved => { root.picked(Math.max(0, Math.min(1, self.mouse-x / track.width))); }
                clicked => { root.picked(Math.max(0, Math.min(1, self.mouse-x / track.width))); }
                // 滚轮微调：一格 = 该分量 1 个单位（rgb 一格 1、H 一格 1°、S/V/L 一格 1%），
                // 与数字框的步进语义一致；向下滚 = 减小（同明度条的滚轮方向）。
                scroll-event(ev) => {
                    root.picked(Math.max(0, Math.min(1,
                        root.ratio + (ev.delta-y > 0px ? -1 : 1) / root.max-value)));
                    accept
                }
            }
        }
        PickerInput {
            bare: true;
            horizontal-stretch: 0;
            width: 74px;
            value: root.value;
            hex: root.hex;
            blur-token: root.blur-token;
            edited(v) => { root.edited(v); }
        }
    }
}

// (#picker-seg 2026-10-15) 格式分段段件：与设置页 AccentSeg 同语言（透出滑层、
// 段内无边框、悬停浅染、13px 等宽段），差异只有色源 —— 设置页固定主题强调色，
// 本盘跟随当前选色（滑层淡染同 Theme.chip 口径 22%/14% 由调用方给，文字用
// 守卫后的亮色，保证任意选色下可读）。
component PickerSeg inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    in property <brush> active-color: Theme.accent;
    // (#picker-seg-hover 2026-10-16) 悬停底色跟随**当前选色**（原来是中性灰
    // Theme.bg-hover，与这一屏「所有选中/当前语义都由选色表达」不一致；用户
    // 要求「悬浮的切换背景色也跟随当前颜色，和确认按钮一致」）。淡染比滑层略
    // 浅一档，免得悬停看着像已选中。色源由调用方给（守卫后的亮色）。
    in property <color> hover-tint: transparent;
    callback clicked();
    height: 30px;
    horizontal-stretch: 1;
    min-width: 0px;
    preferred-width: 0px;
    border-radius: 7px;
    background: active ? transparent : (ta.has-hover ? root.hover-tint : transparent);
    Text {
        text: root.label;
        color: active ? root.active-color : (ta.has-hover ? Theme.text-primary : Theme.text-secondary);
        font-size: Theme.fs-sm;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}

// 纯取色数学：Rust 一次性接线（src/app.rs「PickerMath 接线」块）。
// hex-ch / hex-apply 的 fmt：rgb(R/G/B 0-255) | hsv(H 0-360, S/V 0-100) |
// hsl(H 0-360, S/L 0-100)。
// 色轮取样点（0..1，已钳制在盘内缘）
export struct WheelPos {
    mx: float,
    my: float,
}

export global PickerMath {
    pure callback hex-color(string) -> color;              // hex 串 → color（非法回黑）
    pure callback ink-on(string) -> color;                 // 色块字色：深块白字/浅块黑字
    pure callback hex-valid(string) -> string;             // 合法→规范化 #RRGGBB；**非法→空串**
    pure callback hex-ch(string, int, string) -> string;   // 读单分量
    // 写单分量 → 规范化 hex。(#picker-channel 2026-10-15) 从 `callback` 改为
    // `pure callback`：分量滑杆的两端色要在**绑定**里现推（见 PickerChannel 的
    // lo-color/hi-color），Slint 只允许 pure 回调出现在绑定里。实现本来就是纯
    // 函数（不开窗口、无副作用），语义上也是 pure。
    pure callback hex-apply(string, int, string, string) -> string;
    // (#picker-channel 2026-10-15) 滑杆比例(0..1) → 该分量的满量程值串。
    // 量程与 hex-ch / hex-apply 同口径：rgb 各分量 0..255；H 0..360；S/V/L 0..100。
    pure callback track-value(float, int, string) -> string;
    callback wheel-pick(float, float, float) -> string;    // 色轮命中（顺带重烘明度条）
    pure callback fit-hex(string) -> string;               // 守卫调亮预览（fit_contrast）
    pure callback clamp-wheel(float, float) -> WheelPos;   // 取样点钳制到盘内缘
    pure callback bright-label(v: float) -> string;        // 明度气泡数值（v*255 取整）
    in-out property <image> wheel-image;                   // 色轮位图（一次性烘焙）
    in-out property <image> slider-image;                  // 明度条渐变（随色相重烘）
    in-out property <image> hue-image;                     // H 滑杆色相条（静态，一次性烘焙）
}

// 取色盘卡片。显示宽 462；高度由内容撑（~440）。
export component ColorPickerDialog inherits Rectangle {
    in property <string> title: "调色盘";
    in property <bool> en: false;                  // i18n（调用方绑 root.lang-en）
    in property <length> bounds-w;                 // 拖动边界 = 全窗宽
    in property <length> bounds-h;
    in-out property <string> hex;                  // 唯一事实源（调用方绑定）
    in-out property <string> fmt: "rgb";           // rgb | hsv | hsl
    in-out property <float> wheel-mx: 0.5;         // 色轮取样点（0..1，my 向下 +）
    in-out property <float> wheel-my: 0.5;
    in-out property <float> val-my: 1.0;           // 明度条位置（1=最亮）
    in-out property <float> pick-v: 1.0;           // 明度值（色盘蒙罩同源）
    callback confirmed();                          // 「确认」：写回调用方选定色
    callback cancelled();                          // 「取消」/ ✕：放弃修改
    callback sync-pos();                           // hex 变动后回填取样点（Rust 算三角函数）
    callback copy-requested(string);               // (#picker-channel) HEX 行复制键 → 调用方写剪贴板

    width: 600px;
    height: dlg-lay.preferred-height;
    background: Theme.popup-bg;
    border-radius: 14px;
    border-width: 1px;
    border-color: Theme.border-strong;
    drop-shadow-blur: 26px;
    drop-shadow-color: transparent;

    property <length> drag-ox;                     // 按下时的卡片原点
    property <length> drag-oy;
    property <length> drag-cx;                     // 按下时指针的窗口绝对坐标（拖动期间稳定）
    property <length> drag-cy;
    property <bool> head-dragging: false;
    property <string> guarded: PickerMath.fit-hex(root.hex);
    // (#picker-blur 2026-10-15) 「点输入框外就是离焦」的统一触发槽：任何非输入
    // 区的按下把本值自增，PickerInput 收到变更后对自身 clear-focus（Slint 不会
    // 因点击空白自动清焦点）。用自增计数而非 bool，连续两次外部点击同样生效。
    property <int> blur-token: 0;

    // 卡片留白吞点击（否则点 padding 穿透到遮罩被当成取消）；
    // 放在最底层不影响其上控件的事件。空白区也可拖动卡片。
    // 点空白 = 输入框外 → 顺带清掉输入框焦点（#picker-blur）。
    card-ta := TouchArea {
        clicked => { root.blur-token += 1; }
        pointer-event(ev) => {
            if (ev.kind == PointerEventKind.down) {
                root.blur-token += 1;
                root.head-dragging = true;
                root.drag-ox = root.x;
                root.drag-oy = root.y;
                root.drag-cx = card-ta.absolute-position.x + card-ta.mouse-x;
                root.drag-cy = card-ta.absolute-position.y + card-ta.mouse-y;
            } else if (ev.kind == PointerEventKind.up) {
                root.head-dragging = false;
            }
        }
        moved => {
            root.x = Math.max(8px, Math.min(
                root.drag-ox + (card-ta.absolute-position.x + card-ta.mouse-x - root.drag-cx),
                Math.max(8px, root.bounds-w - root.width - 8px)));
            root.y = Math.max(8px, Math.min(
                root.drag-oy + (card-ta.absolute-position.y + card-ta.mouse-y - root.drag-cy),
                Math.max(8px, root.bounds-h - root.height - 8px)));
        }
    }

    dlg-lay := VerticalLayout {
        // (#picker-pad-sym 2026-10-15) 上下留白对齐：8 → 14（用户实测上窄下宽）
        padding-top: 14px;
        padding-bottom: 14px;
        padding-left: 16px;
        padding-right: 16px;
        spacing: 10px;

        // ── (#picker-head-removed 2026-10-15) 头部整条删除（✕ + 18px 空条 +
        // 头部拖动层）—— 用户要求"删除干净了"。关闭路径保留：取消 / 确认 /
        // 遮罩点击 / Esc；拖动保留卡片空白区拖动（card-ta，与设置卡 / 自定义
        // 弹框同口径：无标题行、无拖动光标、空白处即拖把）。

        // ── 色轮 + 明度条 + 数值列 ─────────────────────────────────────
        // (#picker-fill-width 2026-10-15) 此处**不能**写 alignment。
        // Slint 布局求解里主轴生长只在 alignment == stretch 时开启
        // （i-slint-core/layout.rs：`flex_grow = if params.alignment ==
        // LayoutAlignment::Stretch {...} else {0.}`），而 HorizontalLayout 的
        // 默认值就是 stretch。原先写死 `alignment: start` 把 flex_grow 全部
        // 归零 → 右列虽写了 horizontal-stretch:1 也长不动，被卡在 preferred
        // 宽（实测 ~258px，而可用 314px），弹框右侧留一大片空白、HEX/分量
        // 输入框全都偏短（用户截图④红框 A「上面几个方框的长度需要加长些」）。
        // 删掉 alignment 后走默认 stretch，右列铺满剩余宽度。
        HorizontalLayout {
            spacing: 14px;
            wheel-box := Rectangle {
                width: 240px;
                height: 240px;
                border-radius: 120px;
                clip: true;
                Image {
                    source: PickerMath.wheel-image;
                    width: 240px;
                    height: 240px;
                }
                // 明度蒙罩：整盘随明度条压暗（与逐像素缩放 V 等价）；
                // 圆形蒙罩 —— 方形会把圆外的透明角也压暗（背景色不协调的根因）
                Rectangle {
                    width: 240px;
                    height: 240px;
                    border-radius: 120px;
                    background: #000000;
                    opacity: 1 - root.pick-v;
                }
                // 取样点：白环 + 当前色填充
                Rectangle {
                    x: root.wheel-mx * 240px - 7px;
                    y: root.wheel-my * 240px - 7px;
                    width: 14px;
                    height: 14px;
                    border-radius: 7px;
                    border-width: 2px;
                    border-color: #ffffffff;
                    background: PickerMath.hex-color(root.hex);
                }
                // 圆外禁止操作：十字光标只在盘内出现，盘外移动/点击都不响应
                // （dist 用 0..1 归一化坐标计算，>0.5 即在圆外）
                wheel-ta := TouchArea {
                    mouse-cursor: Math.sqrt(
                        (self.mouse-x / wheel-box.width - 0.5) * (self.mouse-x / wheel-box.width - 0.5)
                        + (self.mouse-y / wheel-box.height - 0.5) * (self.mouse-y / wheel-box.height - 0.5)
                    ) <= 0.5 ? crosshair : default;
                    // (#picker-wheel-corner-drag 2026-10-15) 圆外四角原本被
                    // wheel-ta 的整框命中区吃掉 → 卡片空白区拖把在这些位置失效
                    // （用户截图四角标记"无法拖动"）。圆外按下 = 记录拖动锚点。
                    pointer-event(ev) => {
                        if (ev.kind == PointerEventKind.down) {
                            root.drag-ox = root.x;
                            root.drag-oy = root.y;
                            root.drag-cx = self.absolute-position.x + self.mouse-x;
                            root.drag-cy = self.absolute-position.y + self.mouse-y;
                        }
                    }
                    moved => {
                        root.blur-token += 1;
                        if (Math.sqrt(
                            (self.mouse-x / wheel-box.width - 0.5) * (self.mouse-x / wheel-box.width - 0.5)
                            + (self.mouse-y / wheel-box.height - 0.5) * (self.mouse-y / wheel-box.height - 0.5)
                        ) <= 0.5) {
                            root.wheel-mx = PickerMath.clamp-wheel(
                                self.mouse-x / wheel-box.width, self.mouse-y / wheel-box.height).mx;
                            root.wheel-my = PickerMath.clamp-wheel(
                                self.mouse-x / wheel-box.width, self.mouse-y / wheel-box.height).my;
                            root.hex = PickerMath.wheel-pick(
                                root.wheel-mx * 2 - 1, 1 - root.wheel-my * 2, root.pick-v);
                        } else {
                            // 圆外拖动 = 移动卡片（绝对坐标差值，与 card-ta 同算式）
                            root.x = Math.max(8px, Math.min(
                                root.drag-ox + (self.absolute-position.x + self.mouse-x - root.drag-cx),
                                Math.max(8px, root.bounds-w - root.width - 8px)));
                            root.y = Math.max(8px, Math.min(
                                root.drag-oy + (self.absolute-position.y + self.mouse-y - root.drag-cy),
                                Math.max(8px, root.bounds-h - root.height - 8px)));
                        }
                    }
                    clicked => {
                        root.blur-token += 1;
                        if (Math.sqrt(
                            (self.mouse-x / wheel-box.width - 0.5) * (self.mouse-x / wheel-box.width - 0.5)
                            + (self.mouse-y / wheel-box.height - 0.5) * (self.mouse-y / wheel-box.height - 0.5)
                        ) <= 0.5) {
                            root.wheel-mx = PickerMath.clamp-wheel(
                                self.mouse-x / wheel-box.width, self.mouse-y / wheel-box.height).mx;
                            root.wheel-my = PickerMath.clamp-wheel(
                                self.mouse-x / wheel-box.width, self.mouse-y / wheel-box.height).my;
                            root.hex = PickerMath.wheel-pick(
                                root.wheel-mx * 2 - 1, 1 - root.wheel-my * 2, root.pick-v);
                        }
                    }
                }
            }
            // 明度条：拖动 + 滚轮（按住时浮出「亮度 N」气泡，0-255 与 HSB 的 B 同标尺）
            bright := Rectangle {
                width: 26px;
                height: 240px;
                border-radius: 13px;
                // (#brightbar-edge 2026-10-16) 去掉 1px 描边、渐变铺到边：
                //   ① 描边在**底端**（渐变的黑端）勾出一道半圆弧细线，孤立看像
                //      「一个圆形细线」（用户疑问）；旁边的色轮本来就没有描边，
                //      去掉后两者同款。
                //   ② Image 原先写死 24×238 贴 1px 内衬，1.25/1.5 缩放下内衬与
                //      位图各舍各入，底边漏出一行面板色 —— 现在铺满整盒、圆角交给
                //      clip 裁，边到边无缝。
                clip: true;
                Image {
                    source: PickerMath.slider-image;
                    x: 0;
                    y: 0;
                    width: parent.width;
                    height: parent.height;
                }
                Rectangle {
                    y: 2px + (1 - root.val-my) * (bright.height - 14px);
                    x: 2px;
                    width: 22px;
                    height: 10px;
                    border-radius: 5px;
                    background: #ffffffff;
                    border-width: 1px;
                    border-color: #0000004d;
                }
                bright-tip := Rectangle {
                    x: -(self.width + 9px);
                    y: 2px + (1 - root.val-my) * (bright.height - 22px);
                    width: 58px;
                    height: 22px;
                    border-radius: 6px;
                    // (#info-card-theme 2026-10-16) 与取色信息卡同一处理：原先写死
                    // 暗底、浅色主题下不跟随 —— 改用统一浮层 token bg-elevated。
                    background: Theme.popup-bg-elevated;
                    border-width: 1px;
                    border-color: Theme.border-strong;
                    opacity: bright-ta.pressed ? 1 : 0;
                    Text {
                        width: parent.width;
                        height: parent.height;
                        text: (root.en ? "Bright " : "亮度 ") + PickerMath.bright-label(root.pick-v);
                        color: Theme.text-primary;
                        font-size: 10.5px;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
                bright-ta := TouchArea {
                    mouse-cursor: ns-resize;
                    moved => {
                        root.blur-token += 1;
                        root.val-my = 1 - Math.max(0, Math.min(1, self.mouse-y / bright.height));
                        root.hex = PickerMath.wheel-pick(
                            root.wheel-mx * 2 - 1, 1 - root.wheel-my * 2, root.val-my);
                    }
                    clicked => {
                        root.blur-token += 1;
                        root.val-my = 1 - Math.max(0, Math.min(1, self.mouse-y / bright.height));
                        root.hex = PickerMath.wheel-pick(
                            root.wheel-mx * 2 - 1, 1 - root.wheel-my * 2, root.val-my);
                    }
                    // 滚轮微调明度（±3%/格）
                    scroll-event(ev) => {
                        root.val-my = Math.max(0, Math.min(1,
                            root.val-my + (ev.delta-y > 0px ? -0.03 : 0.03)));
                        root.hex = PickerMath.wheel-pick(
                            root.wheel-mx * 2 - 1, 1 - root.wheel-my * 2, root.val-my);
                        accept
                    }
                }
            }
            // 右列：RGB|HSV|HSL 分段 + 三分量 + HEX（任一输入实时联动）
            // (#picker-col 2026-10-15) 行同构（用户第 5 轮：「第一行 加个 HEX
            // 是不是好些？」「整体布局是不是可以优化下，使其更加协调」）：HEX 行
            // 与三分量同用 PickerInput —— 标签列 30px + 值右对齐，各行标签、值
            // 成一条竖线；# 为默认输入输出符号，保留值内。
            // (#picker-hex-row 2026-10-16) 行序改为「分段 → R/G/B → HEX」：用户
            // 反馈「把 HEX 的色号放在下，即在 B 的下方」，并在其输入左侧加 HEX 标签。
            VerticalLayout {
                spacing: 15px;
                horizontal-stretch: 1;
                // (#picker-seg 2026-10-15) 格式分段复用设置页同款 SegGroup（用户
                // 第 5 轮：「这三个滑块的样式参照强调色里面的」）——容器 36px /
                // 圆角 10 / 内衬 3px / 段间 2px / 滑层高 30 圆角 7 / 180ms 滑动
                // 全部与主题设置页**同一实现**（ui/seg.slint，不再另抄一份）；
                // 只有滑层色源是当前选色（盘内语义）：淡染 22%（暗）/14%（亮）
                // = Theme.chip 同口径，激活文字用守卫后的亮色，任意选色可读。
                fmt := SegGroup {
                    count: 3;
                    active-index: root.fmt == "rgb" ? 0 : root.fmt == "hsv" ? 1 : 2;
                    thumb-tint: PickerMath.hex-color(root.hex).with-alpha(Theme.dark ? 0.22 : 0.14);
                    PickerSeg {
                        label: "RGB";
                        active: root.fmt == "rgb";
                        active-color: PickerMath.hex-color(root.guarded);
                        hover-tint: PickerMath.hex-color(root.guarded).with-alpha(Theme.dark ? 0.16 : 0.10);
                        clicked => { root.fmt = "rgb"; root.blur-token += 1; }
                    }
                    PickerSeg {
                        label: "HSV";
                        active: root.fmt == "hsv";
                        active-color: PickerMath.hex-color(root.guarded);
                        hover-tint: PickerMath.hex-color(root.guarded).with-alpha(Theme.dark ? 0.16 : 0.10);
                        clicked => { root.fmt = "hsv"; root.blur-token += 1; }
                    }
                    PickerSeg {
                        label: "HSL";
                        active: root.fmt == "hsl";
                        active-color: PickerMath.hex-color(root.guarded);
                        hover-tint: PickerMath.hex-color(root.guarded).with-alpha(Theme.dark ? 0.16 : 0.10);
                        clicked => { root.fmt = "hsl"; root.blur-token += 1; }
                    }
                }
                // 三分量：编辑任一 / 拖动滑杆，其余（含 HEX/色轮/明度条）实时跟随
                // (#picker-label-g 2026-10-15) 中列标签原写死 "S" —— RGB 模式下
                // 应为 "G"（用户第 5 轮截图②红框：RGB 的 G）；HSB/HSL 才用 S。
                // (#picker-channel 2026-10-15 方案 B) 本行实现换成 PickerChannel
                // （标签 + 渐变滑杆 + 数字框）：数字框仍是同一个 PickerInput，
                // 手输通路与改动前逐字一致；滑杆走 track-value → hex-apply，
                // 与手输汇进同一个出口，不存在第二套钳制/联动逻辑。
                for i in [0, 1, 2] : PickerChannel {
                    idx: i;
                    label: i == 0 ? (root.fmt == "rgb" ? "R" : "H")
                        : i == 1 ? (root.fmt == "rgb" ? "G" : "S")
                        : (root.fmt == "rgb" ? "B" : (root.fmt == "hsl" ? "L" : "V"));
                    hex: root.hex;
                    fmt: root.fmt;
                    value: PickerMath.hex-ch(root.hex, i, root.fmt);
                    blur-token: root.blur-token;
                    edited(v) => {
                        root.hex = PickerMath.hex-apply(root.hex, i, v, root.fmt);
                        root.sync-pos();
                    }
                    // 拖动滑块：先离焦（滑杆的 TouchArea 独占按下，卡片吞层收不到
                    // 这一下，不显式清的话正聚焦的输入框会留着不跟手），再写事实源
                    picked(r) => {
                        root.blur-token += 1;
                        root.hex = PickerMath.hex-apply(
                            root.hex, i, PickerMath.track-value(r, i, root.fmt), root.fmt);
                        root.sync-pos();
                    }
                }
                // (#picker-hex-row 2026-10-16) HEX 行移到 B 之下（用户反馈「把 HEX 的
                // 色号放在下，即在 B 的下方」），并给出与 R/G/B **同列**的标签「HEX」
                // —— 此前是 bare:true 的无标签行，四行标签、值不成竖线。仍开
                // hash-mode：# 是常驻标识，缺席自动补回。
                PickerInput {
                    idx: 0;
                    label: "HEX";
                    hash-mode: true;
                    value: root.hex;
                    hex: root.hex;
                    copyable: true;
                    blur-token: root.blur-token;
                    copy-requested => { root.copy-requested(root.hex); }
                    // (#picker-hex-guard 2026-10-15) 只有能规范化的输入才写回事实源。
                    // hex 是全盘唯一事实源：把 "#F279B90" 这类打字中间态写进去，
                    // hex-color 解析失败回黑 → 色轮圆点、色块、确认键当场全变黑
                    // （探针实测 hex=#F279B90）。中间态只留在输入框里显示，离焦时
                    // 由 PickerInput 的 blur 分支收敛回事实源。
                    edited(v) => {
                        if (PickerMath.hex-valid(v) != "") {
                            root.hex = PickerMath.hex-valid(v);
                            root.sync-pos();
                        }
                    }
                }
            }
        }

        // ── 页脚：对比度说明（占剩余宽度）+ 取消 / 确认（写回，不直接生效）──
        // (#picker-foot-hint 2026-10-15) 用户要求：底部那行对比度说明挪到页脚，
        // 与「取消 / 确认」同一行 —— 整卡少一行（省下 ~26px 高度，弹框更紧凑）。
        // 版式两个坑：
        //   * 这里**不能**写 `alignment: end`：Slint 布局求解只在 alignment ==
        //     stretch（HorizontalLayout 的默认值）时开启主轴 flex_grow，写了 end
        //     提示框就吃不到剩余宽度（与正文那段 #picker-fill-width 同一个坑）。
        //     删掉后提示占满余量，两颗定宽按钮自然靠右。
        //   * 警示态那句更长，一行放不下 → 文案 wrap，页脚高度由文案与按钮的
        //     较高者决定；cross-axis 居中让按钮在换行时仍居中。
        // 原「守卫提示」独立一行的版式与 #warn-row-gap 的三段间距口径一并作废。
        // (#picker-foot-line 2026-10-15) 与预设弹框页脚同构：顶部 1px 横线；
        // 取消/确认 = 64×36（预设弹框同规格，原 84×30 偏大偏矮）。
        Rectangle { height: Theme.hairline(); background: Theme.border-subtle; }
        HorizontalLayout {
            spacing: 8px;
            cross-axis-alignment: center;
            if root.guarded != root.hex : VerticalLayout {
                horizontal-stretch: 1;
                spacing: 3px;
                // (#picker-foot-warn 2026-10-15) 原版式把 16px 色块塞在警示句中段,
                // 文案一换行色块就夹在两行文字中间（用户截图"布局乱"）。重组为两行:
                // 第一行 = 警示句 + 句末色块（调亮目标色），第二行 = 操作说明（弱化）。
                HorizontalLayout {
                    spacing: 5px;
                    cross-axis-alignment: center;
                    // (#picker-foot-icon 2026-10-19) 原先在 Text 里内嵌 Unicode
                    // "⚠"：字体缺字形时画成空心方框（达标那条的 "✓" 已被用户
                    // 截图抓到）。图标一律走 Icon 组件（assets/icons/*.svg），
                    // 不依赖运行环境的字体覆盖。
                    Icon {
                        glyph: "warning";
                        tint: Theme.warning;
                        size: 12px;
                    }
                    Text {
                        text: root.en ? "Below 3:1 on the theme panel — applying lightens it to"
                            : "对面板对比度不足 3:1 —— 应用时将自动调亮为";
                        color: Theme.warning;
                        font-size: 11px;
                        // (#picker-foot-tight 2026-10-15) 不能 wrap：wrap 文本的
                        // preferred-width 等于整行可用宽 → 色块被挤到行尾（用户
                        // 实测"间距太大"）。本句 ~240px，一行放得下，不 wrap。
                        horizontal-stretch: 0;
                        vertical-alignment: center;
                    }
                    InfoSwatch {
                        hex: root.guarded;
                        width: 16px;
                        height: 16px;
                    }
                    // (#picker-foot-flow 2026-10-16) 尾部吸空块，与强调色弹框的
                    // #accent-pop-flow 同一修法：无 stretch 子项时 Slint 把多余宽
                    // 均摊给"可生长"的 Text（max=∞），色块于是被顶到行尾（用户截图
                    // 「间距太多」）。余量归这块吸空块后，色块紧贴句尾的「自动调亮为」。
                    Rectangle { horizontal-stretch: 1; }
                }
                Text {
                    text: root.en ? "Confirm writes back; Apply takes effect."
                        : "「确认」写回弹框，点「应用」后生效。";
                    color: Theme.text-muted;
                    font-size: 11px;
                    wrap: word-wrap;
                }
            }
            if root.guarded == root.hex : HorizontalLayout {
                horizontal-stretch: 1;
                spacing: 6px;
                cross-axis-alignment: center;
                Icon {
                    glyph: "check";
                    tint: Theme.success;
                    size: 12px;
                }
                Text {
                    horizontal-stretch: 1;
                    text: root.en ? "Contrast OK on the theme panel. Confirm writes back; Apply takes effect."
                        : "对面板对比度达标。「确认」写回弹框，点「应用」后生效。";
                    color: Theme.text-muted;
                    font-size: 11px;
                    wrap: word-wrap;
                    vertical-alignment: center;
                }
            }
            Rectangle {
                width: 64px;
                height: 36px;
                border-radius: 8px;
                background: cancel-ta.has-hover ? Theme.bg-hover : transparent;
                border-width: 1px;
                border-color: cancel-ta.has-hover ? Theme.text-muted : Theme.border-strong;
                Text {
                    width: 100%;
                    height: 100%;
                    text: root.en ? "Cancel" : "取消";
                    color: cancel-ta.has-hover ? Theme.text-primary : Theme.text-secondary;
                    font-size: 12px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                cancel-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.cancelled(); }
                }
            }
            Rectangle {
                width: 64px;
                height: 36px;
                border-radius: 8px;
                background: PickerMath.hex-color(root.hex);
                clip: true;
                // 悬停提亮 + 按下压暗（圆角同按钮，否则直角层会露出四个角）
                Rectangle {
                    border-radius: 8px;
                    background: #ffffff;
                    opacity: ok-ta.has-hover ? 0.12 : ok-ta.pressed ? 0.22 : 0;
                }
                Text {
                    width: 100%;
                    height: 100%;
                    text: root.en ? "Confirm" : "确认";
                    color: PickerMath.ink-on(root.hex);
                    font-size: 12px;
                    font-weight: 600;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
                ok-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.confirmed(); }
                }
            }
        }
    }
}
