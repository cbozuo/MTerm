// (#theme-split / #theme-dedupe §5) 主题选择器的一行：id + 中文名 + 明暗 + 族
// + 预览色（UI 五色 + ANSI 八色带 + 收藏态）。
// 独立文件避免 app.slint ↔ interface_panel.slint 的循环 import。
export struct ThemeEntry {
    id: string,
    zh: string,
    mode: string,   // 「暗」/「亮」
    kind: string,   // radix | brand | terminal | meat | header（组头行）
    root: color,
    panel: color,
    tbg: color,
    tfg: color,
    ac: color,
    /// 行缩略的 ANSI 八色带（槽 1/2/3/4/5/6/9/14，#theme-dedupe §5）
    ansi-eight: [color],
    /// 是否在「常用」列表（星标状态）
    faved: bool,
    /// 搜索过滤标记（Rust 在 theme-search-filter 重发时填；true=显示）
    matched: bool,
}
