// (#wallpaper-library 2026-10-18) 壁纸库的一张自定义壁纸（高保真
// wallpaper-hifi-2026-10-17「壁纸库」画廊）。数据源 = 数据目录下的
// `wallpapers/` 文件夹：放进去的图片自动出现，删掉文件即从列表消失。
// 独立文件避免 app.slint ↔ interface_panel.slint 的循环 import（同 ThemeEntry）。
export struct WallpaperEntry {
    /// 绝对路径，同时作为「当前壁纸」的 id（config.wallpaper）。
    id: string,
    /// 显示名（文件名去扩展名）。
    name: string,
    /// 缩略图（Rust 侧按 2× 卡片尺寸解码 + 缩放，避免整张大图进显存）。
    thumb: image,
}
