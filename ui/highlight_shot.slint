// 高亮弹框离屏预览壳：slint-viewer/slint-lsp 环境下直接实例化 HighlightDialog，
// 独立于 mterm lib（绕开 LLVM codegen 0xc0000409 环境病）。业务回调给空实现，
// 仅供视觉核对 —— Rust 侧行为仍以真实程序为准。
import { HighlightDialog, HighlightPresetItem, HighlightCustomItem } from "highlight_dialog.slint";

export component ShotHost inherits Window {
    width: 760px;
    height: 780px;
    background: #16181d;

    in-out property <string> shot-color: "#1FC8B4";
    in-out property <bool> shot-pal: false;

    HighlightDialog {
        width: 100%;
        height: 100%;
        lang-en: false;
        bounds-w: 760px;
        bounds-h: 780px;
        enabled: true;
        presets: [
            { id: "p1", name: "错误", group: "日志级别", pattern: "error", dot: #F75464, rainbow: false, special: "", enabled: true },
            { id: "p2", name: "警告", group: "日志级别", pattern: "warning", dot: #F5A623, rainbow: false, special: "", enabled: true },
        ];
        customs: [];
        enabled-count: 2;
        status: "";
        new-color <=> root.shot-color;
        pal-open <=> root.shot-pal;
        pal-base: "#1FC8B4";
        tab: 1;
        set-preset-enabled(id, v) => { }
        set-rule-enabled(i, v) => { }
        add-rule(n, p, c) => { return true; }
        update-rule(i, n, p, c) => { return true; }
        remove-rule(i) => { }
        close-requested => { }
        copy-text(h) => { }
        random-hex => { return "#7CB342"; }
        picker-open(h) => { }
        sync-picker-pos => { }
    }
}
