// 频道状态条（tab-row-idia 稿 .chbar，**⋮ 收纳版**——按用户指定的高保真
// 截图样式）：极简条身 = 色点(8×8) + 「频道 X」(11.5px/600) + 分隔线 +
// 流向说明 + 右端 ⋮；操作全部收进 ⋮ 菜单：
//   暂停参与频道（暂停时=继续参与频道）/ 离开频道 / 关闭频道(红) / 隐藏状态条。
// 其余稿约束不变：
//   ① 底色 = term-bg（与 tab 行条带、终端区三者同色）；暂停**不转暖底**，
//      左缘 3px warn 竖条 + 色点降透明 35% + 「本会话已暂停」徽标表达。
//   ② 上下各 1px 分界线；顶线全宽贯通。
// 流向说明三种文案（稿 syncBar 三分支）：
//   暂停 → 「本会话已暂停：与频道内其它 N 个会话互不收发（它们之间仍互通）」
//   无人 → 「暂无可投递的会话（本频道只有这一个在线会话）」
//   正常 → 「正在把输入发往另外 N 个会话」
import { Theme } from "theme.slint";

export component ChannelBar inherits Rectangle {
    in property <string> channel-letter;   // "A".."D"，空 = 不在频道（父级应不渲染）
    in property <color> channel-color;
    in property <bool> paused;             // 本会话暂停（双向停发停收）
    in property <int> online-count;        // 频道内在线会话数（含自己）
    in property <int> member-total;        // 成员总数（含离线）
    callback leave-channel();
    callback close-channel();
    callback pause-channel();
    callback pause-resume();
    callback hide-bar();

    // 稿内语义色按明暗取值（.chbar 用 t1/t2/t3/line 系）
    out property <color> bar-line: Theme.dark ? #3a3d46 : #bfbfc8;
    out property <color> bar-line-strong: Theme.dark ? #4a4e59 : #c7c7cc;
    out property <color> bar-warn: Theme.dark ? #e2a84a : #ff9f0a;
    out property <color> bar-danger: Theme.dark ? #e25c5c : #e05252;
    // (#chbar-fit 2026-10-08) 稿 fitBarOps 的**渐进式**变体（用户定稿）：
    // 宽度不够时按钮**从右向左**逐个收进 ⋮（能展示几个展示几个），⋮ 常驻
    // 最右侧；菜单里只出现被收起的项。可用宽 = 条宽 − 左侧固定内容
    // （padding/色点/标题/徽标/分隔线）− 状态说明最小可读宽(140px)。
    property <length> ops-avail: self.width
        - (root.paused ? 9px : 12px) - 8px - 8px
        - ch-title.preferred-width
        - (root.paused ? (root.lang-en ? 48px : 64px) + 8px : 0px)
        - 8px - 1px - 8px
        - 140px
        - 8px;
    // 累计宽（含 6px 间距）：暂停 76 / +离开 146 / +关闭 216 / +隐藏 290；
    // 有按钮被收起时 ⋮(24px)+间距(8px) 占 32px。
    in-out property <bool> show-pause: ops-avail >= 108px;
    in-out property <bool> show-leave: ops-avail >= 178px;
    in-out property <bool> show-close: ops-avail >= 248px;
    in-out property <bool> show-hide: ops-avail >= 290px;
    in-out property <bool> ops-tight: !show-hide;

    height: 32px;
    background: Theme.term-bg;

    // ② 顶线：absolute 1px、全宽、y:-1px（父容器需允许出界，Slint 默认不裁剪）
    Rectangle {
        x: 0; y: -1px;
        width: parent.width; height: 1px;
        background: bar-line;
    }
    Rectangle {
        x: 0; y: parent.height;
        width: parent.width; height: 1px;
        background: bar-line;
    }
    // ① 暂停态左缘 3px warn 竖条
    Rectangle {
        visible: root.paused;
        x: 0; y: 0; width: 3px; height: parent.height;
        background: bar-warn;
    }

    HorizontalLayout {
        padding-left: root.paused ? 9px : 12px;
        padding-right: 8px;
        spacing: 8px;
        alignment: center;

        // 色点 8×8（稿 .cdot；暂停降透明 35%——不是换色）
        Rectangle {
            width: 8px; height: 8px; border-radius: 2px;
            background: root.channel-color;
            opacity: root.paused ? 0.35 : 1.0;
            y: (parent.height - self.height) / 2;
        }
        // 标题「频道 X」11.5px/600、主文本色（暂停不变色）
        ch-title := Text {
            text: root.lang-en ? "Channel " + root.channel-letter : "频道 " + root.channel-letter;
            color: Theme.text-primary;
            font-size: 11.5px; font-weight: 600;
            vertical-alignment: center;
        }
        // 暂停徽标（稿 .badge：9px/700、warn-soft 底、warn 字）
        if root.paused : Rectangle {
            border-radius: 4px;
            background: bar-warn.with-alpha(0.16);
            y: (parent.height - self.height) / 2;
            height: 16px;
            width: root.lang-en ? 48px : 64px;   // 文本 9px + 两侧 5px 内距（中/英文案实测宽）
            Text {
                x: 5px;
                text: root.lang-en ? "Paused" : "本会话已暂停";
                color: bar-warn; font-size: 9px; font-weight: 700;
                vertical-alignment: center;
            }
        }
        // 分隔线 1×14（稿 .sep）
        Rectangle {
            width: 1px; height: 14px;
            background: bar-line;
            y: (parent.height - self.height) / 2;
        }
        // 流向说明（稿 syncBar 三分支；四要素齐全）
        stat-txt := Text {
            text: root.paused
                ? (root.lang-en
                    ? "This session is paused: no send/receive with the other "
                      + (root.online-count - 1) + " session(s) in the channel (they still sync)"
                    : "本会话已暂停：与频道内其它 " + (root.online-count - 1)
                      + " 个会话互不收发（它们之间仍互通）")
                : root.online-count <= 1
                    ? (root.lang-en
                        ? "No session to deliver to (this is the only online session in the channel)"
                        : "暂无可投递的会话（本频道只有这一个在线会话）")
                    : root.lang-en
                        ? "Sending input to " + (root.online-count - 1) + " other session(s)"
                        : "正在把输入发往另外 " + (root.online-count - 1) + " 个会话";
            color: Theme.text-muted; font-size: 11px;
            vertical-alignment: center;
            overflow: elide;
        }
        Rectangle { horizontal-stretch: 1; }

        // 平铺操作块（**四按钮**：暂停参与(↔继续参与) / 离开频道 / 关闭频道(红)
        // / 隐藏状态条；宽够时平铺，放不下整体收进右侧 ⋮）
        ops-lay := HorizontalLayout {
            visible: !root.ops-tight;
            spacing: 6px;
            alignment: start;
            Rectangle {
                visible: root.show-pause;
                width: 76px; height: 22px; border-radius: 5px;
                border-width: 1px; border-color: Theme.border-strong;
                background: pa-ta.has-hover ? Theme.bg-panel-alt : transparent;
                Text {
                    text: root.paused
                        ? (root.lang-en ? "Resume" : "继续参与")
                        : (root.lang-en ? "Pause" : "暂停参与");
                    color: root.paused ? bar-warn : Theme.text-primary;
                    font-size: 11px;
                    horizontal-alignment: center; vertical-alignment: center;
                }
                pa-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.paused ? root.pause-resume() : root.pause-channel(); }
                }
            }
            Rectangle {
                visible: root.show-leave;
                width: 64px; height: 22px; border-radius: 5px;
                border-width: 1px; border-color: Theme.border-strong;
                background: lv-ta.has-hover ? Theme.bg-panel-alt : transparent;
                Text {
                    text: root.lang-en ? "Leave" : "离开频道";
                    color: Theme.text-primary; font-size: 11px;
                    horizontal-alignment: center; vertical-alignment: center;
                }
                lv-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.leave-channel(); }
                }
            }
            Rectangle {
                visible: root.show-close;
                width: 64px; height: 22px; border-radius: 5px;
                border-width: 1px; border-color: bar-danger.with-alpha(0.45);
                background: cl-ta.has-hover ? bar-danger.with-alpha(0.12) : transparent;
                Text {
                    text: root.lang-en ? "Close" : "关闭频道";
                    color: bar-danger; font-size: 11px;
                    horizontal-alignment: center; vertical-alignment: center;
                }
                cl-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.close-channel(); }
                }
            }
            Rectangle {
                visible: root.show-hide;
                width: 68px; height: 22px; border-radius: 5px;
                border-width: 1px; border-color: Theme.border-strong;
                background: hd-ta.has-hover ? Theme.bg-panel-alt : transparent;
                Text {
                    text: root.lang-en ? "Hide bar" : "隐藏状态条";
                    color: Theme.text-secondary; font-size: 11px;
                    horizontal-alignment: center; vertical-alignment: center;
                }
                hd-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.hide-bar(); }
                }
            }
        }

        // ⋮（收纳态：宽度放不下四按钮时整体出现在最右侧）
        more-btn := Rectangle {
            visible: root.ops-tight;
            width: 24px; height: 22px; border-radius: 5px;
            background: more-ta.has-hover ? Theme.bg-panel-alt : transparent;
            y: (parent.height - self.height) / 2;
            Text {
                width: 100%; height: 100%;
                text: "⋮";
                color: more-ta.has-hover ? Theme.text-primary : Theme.text-secondary;
                font-size: 14px;
                horizontal-alignment: center; vertical-alignment: center;
            }
            more-ta := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    // 事件期读 absolute-position（布局期恒 0，ChainPicker 同结论）
                    menu-x = more-btn.absolute-position.x + more-btn.width - 140px;
                    menu-y = more-btn.absolute-position.y + more-btn.height + 4px;
                    ch-menu.show();
                }
            }
        }
    }

    property <length> menu-x;
    property <length> menu-y;
    ch-menu := PopupWindow {
        x: root.menu-x;
        y: root.menu-y;
        width: 150px;
        height: ((root.show-pause ? 0 : 1) + (root.show-leave ? 0 : 1)
                 + (root.show-close ? 0 : 1) + (root.show-hide ? 0 : 1)) * 29px + 13px;
        Rectangle {
            background: Theme.popup-bg;
            border-radius: Theme.radius-sm;
            border-width: 1px; border-color: Theme.border-strong;
            drop-shadow-blur: 12px; drop-shadow-color: #00000060;
            VerticalLayout {
                padding: 4px;
                spacing: 1px;
                // 菜单里只列**被收起**的项（平铺可见的不重复出现）
                Rectangle {
                    visible: !root.show-pause;
                    height: 29px;
                    background: mi-pause-ta.has-hover ? Theme.bg-panel-alt : transparent;
                    border-radius: 5px;
                    Text {
                        x: 10px;
                        text: root.paused
                            ? (root.lang-en ? "Resume channel" : "继续参与频道")
                            : (root.lang-en ? "Pause channel" : "暂停参与频道");
                        color: Theme.text-secondary; font-size: 11px;
                        vertical-alignment: center;
                    }
                    mi-pause-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            ch-menu.close();
                            root.paused ? root.pause-resume() : root.pause-channel();
                        }
                    }
                }
                Rectangle {
                    visible: !root.show-leave;
                    height: 29px;
                    background: mi-leave-ta.has-hover ? Theme.bg-panel-alt : transparent;
                    border-radius: 5px;
                    Text {
                        x: 10px;
                        text: root.lang-en ? "Leave channel" : "离开频道";
                        color: Theme.text-secondary; font-size: 11px;
                        vertical-alignment: center;
                    }
                    mi-leave-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { ch-menu.close(); root.leave-channel(); }
                    }
                }
                Rectangle {
                    visible: !root.show-close;
                    height: 29px;
                    background: mi-close-ta.has-hover ? #dc4b44.with-alpha(0.12) : transparent;
                    border-radius: 5px;
                    Text {
                        x: 10px;
                        text: root.lang-en ? "Close channel" : "关闭频道";
                        color: bar-danger; font-size: 11px;
                        vertical-alignment: center;
                    }
                    mi-close-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { ch-menu.close(); root.close-channel(); }
                    }
                }
                Rectangle { height: 1px; background: bar-line; }
                Rectangle {
                    visible: !root.show-hide;
                    height: 29px;
                    background: mi-hide-ta.has-hover ? Theme.bg-panel-alt : transparent;
                    border-radius: 5px;
                    Text {
                        x: 10px;
                        text: root.lang-en ? "Hide status bar" : "隐藏状态条";
                        color: Theme.text-secondary; font-size: 11px;
                        vertical-alignment: center;
                    }
                    mi-hide-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { ch-menu.close(); root.hide-bar(); }
                    }
                }
            }
        }
    }
    in-out property <bool> lang-en: false;
}
