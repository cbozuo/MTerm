// 分组管理相关的共享数据结构。
//
// 为什么单独成文件：GroupSwatch 原本定义在 app.slint 里，而 app.slint 要
// import group_manager.slint（组件），组件又需要色板类型 → 循环引用。
// 抽到这个叶子文件，两边各自 import 即可。
//
// 高保真：docs/design/group-manager-hifi-2026-10-19.html

// (#group-color 2026-09-14) 色板的一个候选色。`hex` 是提交给 Rust 的原文
// （也用作"当前选中"的判定依据），`swatch` 是画色块用的颜色。两者由 Rust 从
// 同一份调色板常量一并注入 —— Slint 没有 color → "#RRGGBB" 的转换。
export struct GroupSwatch {
    hex: string,
    swatch: color,
}

// 分组管理弹框左栏的一行。
export struct GroupRow {
    name: string,
    color: color,
    color-hex: string,
    count: int,
    // 未分组：不可改名 / 删除 / 拖拽排序，但可改色
    // （ConfigStore::set_group_color 只拒绝空名）。
    reserved: bool,
}

// 右栏成员行。
// 与 SessionInfo 分开：`picked` 是弹框内的临时态，不该污染侧栏那份 model
// （侧栏的 SessionInfo 由 build_session_rows 全量重建，带弹框状态会互相踩）。
export struct GmMember {
    id: string,
    name: string,
    host: string,
    user: string,
    auth: string,
    note: string,
    // 协议图标来源（Theme.protocol-icon），与侧栏成员行同一套。
    kind: string,
    online: bool,
    picked: bool,
}
