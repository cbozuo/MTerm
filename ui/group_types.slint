// 分组管理相关的共享数据结构。
//
// 为什么单独成文件：GroupSwatch 原本定义在 app.slint 里，而 app.slint 要
// import group_manager.slint（组件），组件又需要色板类型 → 循环引用。
// 抽到这个叶子文件，两边各自 import 即可。
//
// 高保真：docs/design/group-manager-hifi-2026-10-19.html

// (#group-color 2026-09-14) 色板的一个候选色。`hex` 是提交给 Rust 的原文
// （也用作"当前选中"的判定依据），`swatch` 是画色块用的颜色。两者由 Rust 从
// 同一份调色板常量一并注入 —— Slint 没有 color → "#RRGGBB" 的转换。
// `name`：色块上的中文名（#swatch-popup 2026-10-26 起与设置页「强调色」同款
// 大色块，需要名称 + 色号两行）。
export struct GroupSwatch {
    hex: string,
    swatch: color,
    name: string,
}

// 分组管理弹框左栏的一行。
export struct GroupRow {
    name: string,
    color: color,
    color-hex: string,
    count: int,
    // 搜索命中数（无搜索词时 = count）。高保真 10-22：左栏计数在搜索态显示
    // `命中/总数`，0 命中的组行压暗但不隐藏（隐藏会让「我的分组」小节的
    // 像素映射错位，也让用户以为组没了）。
    hit: int,
    // 未分组：不可改名 / 删除 / 拖拽排序，但可改色
    // （ConfigStore::set_group_color 只拒绝空名）。
    reserved: bool,
    // (#gm-subgroup 2026-11-12) 树深度（根级 0 / 子组 1）：组行按它缩进
    // （高保真树形层级），子组行不参与拖拽排序（DFS 序由父子关系决定）。
    depth: int,
}

// 右栏成员行。
// 与 SessionInfo 分开：`picked` 是弹框内的临时态，不该污染侧栏那份 model
// （侧栏的 SessionInfo 由 build_session_rows 全量重建，带弹框状态会互相踩）。
export struct GmMember {
    id: string,
    name: string,
    host: string,
    user: string,
    auth: string,
    note: string,
    // 协议图标来源（Theme.protocol-icon），与侧栏成员行同一套。
    kind: string,
    online: bool,
    picked: bool,
    // 搜索命中（仅 query 非空时置位；用于右栏高亮命中行）
    hit: bool,
}

// (#move-group-dialog 2026-11-12) 「移动到分组」弹框的一行(高保真
// left-panel-session-hifi-2026-10-28-v3 §Move to Group)。放本叶子文件
// 避免 left_sidebar ↔ move_group_dialog 组件互引。
// DFS 序;depth 决定缩进;current 所在组 = 「当前」徽章且禁止选中。
export struct MoveGroupRow {
    name: string,
    depth: int,
    color: color,          // 解析后的组色(无自定义色时为占位值)
    has-color: bool,       // false → 圆点用次级前景色(Theme.group-color 同口径)
    count: int,
    current: bool,
}
