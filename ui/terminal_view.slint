import { Icon } from "icons.slint";
import { ScrollView } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { CommandHint, HintRow } from "command_hint.slint";
import { SftpPanel, SftpEntry, SftpTreeNode, TunnelInfo } from "sftp_panel.slint";
import { TabInfo } from "tabs.slint";
import { DialogClose, DockExpandButton, ToolStrip } from "widgets.slint";

// One coloured run of text on the terminal grid.  The Rust side groups
// consecutive vt100 cells that share fg + bg + bold into a single span and
// tags it with its grid position (row, col) and width in cells, so the UI can
// place both a background fill and the text with absolute monospace coordinates.
// `bg` is transparent (alpha 0) when the cell uses the default background.
export struct TermSpan {
    text: string,
    fg: color,
    bg: color,
    bold: bool,
    row: int,
    col: int,
    cells: int,
    cjk: bool,   // contains CJK chars → render with the CJK-capable font (#54)
    // (#nerd-icon-split) span 为单个 Nerd Font 图标字符（私用区字形）。Rust 侧
    // 把图标字符从同色混合 run（eza/lsd 的「图标+文件名」同色输出）中拆成独立
    // span，放大才会命中；Powerline 分隔符（U+E0A0–E0D4）设计为恰好填满格子
    // 首尾相接，不拆不放。网格、PTY 寻址和点选不受影响，只改字形大小与落点。
    nerd: bool,
    // (#twemoji-removal 2026-09-05) emoji/emoji-image 字段已随 Twemoji 移除:
    // emoji 交由字体回退渲染单色轮廓,不再有图像 span。
}

// A find-match highlight rectangle on the terminal grid.
export struct TermMatch {
    row: int,
    col: int,
    len: int,
}

// One saved quick command (#55): a name shown on the chip + the text to send.
// Grouped like the welcome session list: group-header is non-empty on the first
// row of each group; collapsed hides the group's rows in the popup; orig-index
// points back to the entry's position in the stored list (delete target).
export struct QuickCmd {
    name: string,
    command: string,
    group: string,
    group-header: string,
    collapsed: bool,
    orig-index: int,
    // false → clicking only fills the input box (no trailing Return), so the
    // command can be tweaked before sending; true → send + execute (B站 suggestion).
    send-enter: bool,
}

// (#cmdbar-scope 2026-10-23) 命令栏「发送范围」下拉里的一项 = 一个同步频道。
// 高保真 session-dialog-commandbar-hifi-2026-10-23 屏 03/07：范围键从死文字
// 变成能点开的下拉，条目带频道色点与**当前可送达的台数**。
// count 由 Rust 按「本窗口已打开、且挂在该频道的标签页」统计 —— 不是频道成员
// 总数（离线成员发不到，列出来只会误导）。
export struct SendScope {
    letter: string,   // "A".."D"
    color: color,
    count: int,
}

// --- ScopeRow --------------------------------------------------------------
// (#cmdbar-scope-multi 2026-10-23) 发送范围菜单里的一行，结构对齐高保真
// `.opt`：15px 复选框（.cb）+ 色点槽 + 名称 + 右对齐台数（.ct）。
//
// ⚠️ 三行（当前标签页 / 全部标签页 / 频道 A）**都留同一个色点槽**：不这样做
// 的话有频道的那几行会比没有频道的行多出 8+9px，文字起点参差 —— 用户反馈的
// 「勾选图标和频道色块不居中」正是这一档：固定高度的图标在 HorizontalLayout
// 里默认**顶对齐**（见 icons.slint 的 #icon-align 注释），必须靠
// `alignment: center` 拉回交叉轴中心，并且槽位宽度统一。
component ScopeRow inherits Rectangle {
    in property <bool> checked: false;
    in property <color> dot: transparent;
    in property <string> label;
    in property <string> trailing: "";
    // 0 台的频道灰掉且不可点（高保真 .opt.dis）—— 列出来是让用户知道这个
    // 频道存在，但「发不到」不能靠点一下才发现。
    in property <bool> row-enabled: true;
    callback clicked();

    height: 38px;
    border-radius: 6px;
    background: checked
        ? Theme.accent.with-alpha(0.12)
        : (ta.has-hover && row-enabled ? Theme.bg-hover : transparent);
    opacity: row-enabled ? 1.0 : 0.55;
    animate background { duration: 110ms; }

    ta := TouchArea {
        enabled: root.row-enabled;
        mouse-cursor: default;
        clicked => { root.clicked(); }
    }
    HorizontalLayout {
        padding-left: 9px;
        padding-right: 9px;
        spacing: 9px;
        // ⚠️ 这里**不能**写 `alignment: center`：Slint 的 LayoutAlignment 是
        // 主轴对齐 —— 一写就把 `horizontal-stretch` 归零，整行内容缩成
        // preferred 宽再水平居中（实测复选框跑到行中间、右侧一片空白）。
        // 交叉轴（垂直）对齐 Slint 没有属性，固定尺寸子项直接顶对齐，所以
        // 复选框/色点各自包一层「行高 = 38」的槽，图形在槽内绝对居中。
        // 复选框：勾是 accent 实底 + 反相勾（高保真 .opt.on .cb）。
        // accent 在暗主题是亮青、亮主题是深青，勾色跟着主题反相，与发送键
        // 「白字 on accent」同一套对比口径，不在亮主题出现「亮底白勾」。
        Rectangle {
            width: 15px;
            height: 38px;   // = ScopeRow 行高，撑满后交叉轴不再顶对齐
            Rectangle {
                y: (parent.height - self.height) / 2;
                width: 15px;
                height: 15px;
                border-radius: 4px;
                border-width: 1px;
                border-color: root.checked ? Theme.accent-solid : Theme.border-control;
                background: root.checked ? Theme.accent-solid : transparent;
                animate background, border-color { duration: 120ms; }
                Icon {
                    glyph: root.checked ? "check" : "";
                    tint: Theme.dark ? #0A0B0E : #ffffff;
                    size: 11px;
                }
            }
        }
        // 色点槽：无色点也占位（行间文字起点才对得上）
        Rectangle {
            width: 8px;
            height: 38px;
            Rectangle {
                y: (parent.height - self.height) / 2;
                width: 8px;
                height: 8px;
                border-radius: 4px;
                background: root.dot;
            }
        }
        Text {
            text: root.label;
            color: root.checked ? Theme.text-primary : Theme.text-secondary;
            font-size: Theme.fs-sm;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
        if root.trailing != "" : Rectangle {
            width: 52px;
            Text {
                width: parent.width;
                height: parent.height;
                text: root.trailing;
                color: Theme.text-muted;
                font-size: Theme.fs-xs;
                horizontal-alignment: right;
                vertical-alignment: center;
            }
        }
    }
}

// (#cmdbar-expand 2026-10-23) 「发送范围」键 —— 主命令栏与弹出编辑窗口底部
// 用的是**同一个组件、同一份状态**（高保真屏 06：范围键也在弹窗底部，否则
// 用户写完命令还得收起来才能改发给谁）。组件化之前这段直接写在 TerminalView
// 里，两处复用不了。
export component ScopeButton inherits Rectangle {
    in property <[SendScope]> scopes;
    in property <int> tab-count: 0;
    in-out property <bool> all: false;
    in-out property <bool> ch-a: false;
    in-out property <bool> ch-b: false;
    in-out property <bool> ch-c: false;
    in-out property <bool> ch-d: false;
    in-out property <bool> open: false;
    // 菜单展开方向：主命令栏贴右端（默认右对齐、往左长）；弹出编辑窗口底部
    // 的范围键靠左，往左长会伸出面板、被左侧栏压掉一半 → 传 true 向右展开。
    in property <bool> menu-left: false;
    // 是否自带「点外部关闭」层。命令栏自己用（整个终端区都是外部）；弹出编辑
    // 弹窗传 false —— 那边是模态面板，由面板内层 / 遮罩分工处理（见下方注释）。
    in property <bool> outside-close: true;
    // (#scope-chip 2026-10-26) 「有框」档：常态就画 1phx 描边 + 圆角，像一枚可点的
    // 胶囊。命令栏那里它跟一排图标钮并排、紧挨发送键，靠位置就够"是个控件"，
    // 所以默认 false；弹出编辑面板的页脚只有它一个孤零零挂在左边，不画框就是
    // 一行普通文字（用户截图「当前标签页 ⌄」）。
    in property <bool> framed: false;
    // (#scope-menu-opaque 2026-10-26) 菜单/气泡是否要**不透明**。
    // 命令栏那枚悬在终端上，popup-bg 一层半透明没问题；弹出编辑面板里的这枚
    // 本身就压在一块 popup-bg 上，再叠一层同名半透明 = 能看见底下的文字
    // （用户截图：范围菜单"穿透"了）。面板里传 true → 用不透明的 field 底。
    in property <bool> on-popup: false;
    // 草稿（菜单里勾的那一份）—— 组件私有，不参与双向绑定
    property <bool> d-all: false;
    property <bool> d-a: false;
    property <bool> d-b: false;
    property <bool> d-c: false;
    property <bool> d-d: false;
    // 打开前通知外部：先把其它浮层（快捷/历史）关掉
    callback activated();

    function ch-count(a: bool, b: bool, c: bool, d: bool) -> int {
        return (a ? 1 : 0) + (b ? 1 : 0) + (c ? 1 : 0) + (d ? 1 : 0);
    }
    function ch-total(a: bool, b: bool, c: bool, d: bool) -> int {
        return (a ? root.scope-count-of("A") : 0)
             + (b ? root.scope-count-of("B") : 0)
             + (c ? root.scope-count-of("C") : 0)
             + (d ? root.scope-count-of("D") : 0);
    }
    function scope-count-of(letter: string) -> int {
        if (root.scopes.length > 0 && root.scopes[0].letter == letter) { return root.scopes[0].count; }
        if (root.scopes.length > 1 && root.scopes[1].letter == letter) { return root.scopes[1].count; }
        if (root.scopes.length > 2 && root.scopes[2].letter == letter) { return root.scopes[2].count; }
        if (root.scopes.length > 3 && root.scopes[3].letter == letter) { return root.scopes[3].count; }
        return 0;
    }
    function scope-color-of(letter: string) -> color {
        if (root.scopes.length > 0 && root.scopes[0].letter == letter) { return root.scopes[0].color; }
        if (root.scopes.length > 1 && root.scopes[1].letter == letter) { return root.scopes[1].color; }
        if (root.scopes.length > 2 && root.scopes[2].letter == letter) { return root.scopes[2].color; }
        if (root.scopes.length > 3 && root.scopes[3].letter == letter) { return root.scopes[3].color; }
        return transparent;
    }
    function applied-n() -> int {
        return root.ch-count(root.ch-a, root.ch-b, root.ch-c, root.ch-d);
    }
    function applied-total() -> int {
        return root.ch-total(root.ch-a, root.ch-b, root.ch-c, root.ch-d);
    }
    function applied-single() -> string {
        if (root.ch-a) { return "A"; }
        if (root.ch-b) { return "B"; }
        if (root.ch-c) { return "C"; }
        if (root.ch-d) { return "D"; }
        return "";
    }
    function scope-label() -> string {
        if (root.all) { return @tr("All tabs"); }
        if (root.applied-n() == 0) { return @tr("This tab"); }
        if (root.applied-n() == 1) { return @tr("Channel {0}", root.applied-single()); }
        return @tr("{0} channels", root.applied-n());
    }
    function scope-count() -> int {
        if (root.all) { return root.tab-count; }
        if (root.applied-n() == 0) { return 0; }
        return root.applied-total();
    }
    function scope-has-range() -> bool {
        return root.all || root.applied-n() > 0;
    }
    // 范围串："" / "*" / "A,C"（尾逗号由 Rust 侧过滤）
    function scope-spec() -> string {
        if (root.all) { return "*"; }
        if (root.applied-n() == 0) { return ""; }
        return (root.ch-a ? "A," : "") + (root.ch-b ? "B," : "")
             + (root.ch-c ? "C," : "") + (root.ch-d ? "D," : "");
    }
    function ch-applied(letter: string) -> bool {
        if (letter == "A") { return root.ch-a; }
        if (letter == "B") { return root.ch-b; }
        if (letter == "C") { return root.ch-c; }
        return root.ch-d;
    }
    function scope-tip-head() -> string {
        if (root.applied-n() > 1) {
            return @tr("{0} channels · {1} hosts", root.applied-n(), root.applied-total());
        }
        return root.scope-label();
    }
    function scope-tip-sub() -> string {
        if (root.all) { return @tr("{0} 台", root.tab-count); }
        if (root.applied-n() == 1) { return @tr("{0} 台", root.applied-total()); }
        return "";
    }
    function dot-color(i: int) -> color {
        if (i == 0) {
            if (root.ch-a) { return root.scope-color-of("A"); }
            if (root.ch-b) { return root.scope-color-of("B"); }
            if (root.ch-c) { return root.scope-color-of("C"); }
            return root.scope-color-of("D");
        }
        if (i == 1) {
            if (root.ch-a && root.ch-b) { return root.scope-color-of("B"); }
            if (root.ch-a && root.ch-c) { return root.scope-color-of("C"); }
            if (root.ch-a) { return root.scope-color-of("D"); }
            if (root.ch-b && root.ch-c) { return root.scope-color-of("C"); }
            if (root.ch-b) { return root.scope-color-of("D"); }
            return root.scope-color-of("D");
        }
        if (root.ch-a && root.ch-b && root.ch-c) { return root.scope-color-of("C"); }
        return root.scope-color-of("D");
    }
    function draft-n() -> int {
        return root.ch-count(root.d-a, root.d-b, root.d-c, root.d-d);
    }
    function draft-total() -> int {
        return root.ch-total(root.d-a, root.d-b, root.d-c, root.d-d);
    }
    function draft-of(letter: string) -> bool {
        if (letter == "A") { return root.d-a; }
        if (letter == "B") { return root.d-b; }
        if (letter == "C") { return root.d-c; }
        return root.d-d;
    }
    function draft-single() -> string {
        if (root.d-a) { return "A"; }
        if (root.d-b) { return "B"; }
        if (root.d-c) { return "C"; }
        return "D";
    }
    function draft-toggle(letter: string) {
        if (letter == "A") { root.d-a = !root.d-a; }
        else if (letter == "B") { root.d-b = !root.d-b; }
        else if (letter == "C") { root.d-c = !root.d-c; }
        else { root.d-d = !root.d-d; }
        root.d-all = false;
    }
    function draft-summary() -> string {
        if (root.d-all) { return @tr("{0} tabs", root.tab-count); }
        if (root.draft-n() == 0) { return @tr("This tab only"); }
        if (root.draft-n() == 1) {
            return @tr("Channel {0} · {1} hosts", root.draft-single(), root.draft-total());
        }
        return @tr("{0} channels · {1} hosts", root.draft-n(), root.draft-total());
    }
    function scope-menu-open() {
        root.d-all = root.all;
        root.d-a = root.ch-a;
        root.d-b = root.ch-b;
        root.d-c = root.ch-c;
        root.d-d = root.ch-d;
        root.open = true;
    }
    function scope-commit() {
        root.all = root.d-all;
        root.ch-a = root.d-a;
        root.ch-b = root.d-b;
        root.ch-c = root.d-c;
        root.ch-d = root.d-d;
        root.open = false;
    }
    function scope-pick(all: bool) {
        root.all = all;
        root.ch-a = false;
        root.ch-b = false;
        root.ch-c = false;
        root.ch-d = false;
        root.open = false;
    }

    // 宽度直接由内容行算（同旧「所有会话」胶囊的 all-row 口径）。
    // ⚠️ 不要再套一层「height 28 的居中盒子」：width ← preferred
    // ← width 的链路过两跳会让 Slint 的布局把宽度算成 0（实测
    // #cmdbar-hifi 首版就栽在这：scope/发送两个键直接消失）。
    width: scope-row.preferred-width + 16px;
    border-radius: 6px;
    border-width: root.framed ? Theme.hairline() : 1px;
    border-color: root.framed
        ? (scope-ta.has-hover || root.open ? Theme.border-strong : Theme.line-2)
        : root.scope-has-range()
            ? (scope-ta.has-hover || root.open ? Theme.border-strong : Theme.zone-sidebar-line)
            : transparent;
    background: root.open ? Theme.bg-active
              : scope-ta.has-hover ? Theme.bg-hover : transparent;
    animate background, border-color { duration: 110ms; }

    // 点外部关闭（#scope-menu-outside 2026-10-25）：菜单开着时，在组件**最底层**
    // 铺一张盖住整个可视区的透明层接住"别处"的点击。
    // ⚠️ 必须声明在按钮/菜单**之前**（z 最低）：放到它们后面就成了 cmd-expand
    // 遮罩踩过的那个坑（吞掉面板里所有按钮的点击，实测点不动）。这里按钮行与
    // 菜单都压在它上面，所以只有菜单以外的空白落到它身上 —— 正好关菜单。
    // 落到它身上的点击一律 reject 放行：关掉菜单的同时，下面该聚焦的聚焦、该
    // 点的照点（否则下拉一开，第一次点击全被吃掉）。
    // 祖先 central 有 clip: true，超出终端区的部分自然被裁掉，不需要精确尺寸。
    // outside-close: false 的宿主（弹出编辑弹窗）自己管外部点击 —— 那个面板是
    // 模态的，点面板外要连面板一起收起，不能只关菜单把点击吞在这儿。
    if root.open && root.outside-close : Rectangle {
        x: -2000px;
        y: -2000px;
        width: 9000px;
        height: 9000px;
        background: transparent;
        outside-ta := TouchArea {
            pointer-event(ev) => {
                if (ev.kind == PointerEventKind.down) {
                    root.open = false;   // 草稿丢弃，已应用的那份不动
                }
                EventResult.reject
            }
        }
    }

    scope-ta := TouchArea {
        mouse-cursor: default;
        clicked => {
            if (root.open) {
                root.open = false;   // 已应用的那份不动，草稿丢弃
            } else {
            root.activated();
                root.scope-menu-open();
            }
        }
    }
    scope-row := HorizontalLayout {
        width: parent.width; height: parent.height;
        padding-left: 8px; padding-right: 7px;
        spacing: 6px;
        alignment: center;
        // 频道档才画点（"当前/全部"没有颜色身份）。多选时按高保真
        // .dots 叠排：7px 点、步进 4px（相邻重叠 3px），描边取弹层
        // 底色，两个色点才不会糊成一个胶囊。
        if root.applied-n() > 0 : Rectangle {
            width: 7px + (Math.min(3, root.applied-n()) - 1) * 4px;
            height: parent.height;   // 撑满行高，点在里面绝对居中
            Rectangle {
                x: 0px; y: (parent.height - self.height) / 2;
                width: 7px; height: 7px;
                border-radius: 4px;
                background: root.dot-color(0);
                border-width: 1px;
                border-color: Theme.popup-bg;
            }
            if root.applied-n() > 1 : Rectangle {
                x: 4px; y: (parent.height - self.height) / 2;
                width: 7px; height: 7px;
                border-radius: 4px;
                background: root.dot-color(1);
                border-width: 1px;
                border-color: Theme.popup-bg;
            }
            if root.applied-n() > 2 : Rectangle {
                x: 8px; y: (parent.height - self.height) / 2;
                width: 7px; height: 7px;
                border-radius: 4px;
                background: root.dot-color(2);
                border-width: 1px;
                border-color: Theme.popup-bg;
            }
        }
        Text {
            text: root.scope-label();
            color: Theme.text-secondary;
            font-size: Theme.fs-sm;
            vertical-alignment: center;
        }
        if root.scope-count() > 0 : Text {
            text: root.scope-count();
            color: Theme.text-muted;
            font-size: Theme.fs-xs;
            vertical-alignment: center;
        }
        Icon {
            glyph: "expand-more";
            tint: Theme.text-muted;
            size: Theme.fs-sm;
        }
    }

    // 悬停汇总气泡：向上弹（命令栏贴着窗口底边，往下没空间），
    // 右缘贴按钮右缘。菜单打开时不画 —— 两者是同一个落点。
    // 鼠标左右键都在按钮上时才出，不抢焦点、不吞点击（没有
    // TouchArea：气泡只是画出来的）。
    if !root.open && scope-ta.has-hover : Rectangle {
        x: parent.width - self.width;
        y: -self.height - 6px;
        width: tip-col.preferred-width;
        height: tip-col.preferred-height;
        background: root.on-popup ? Theme.field : Theme.popup-bg;
        border-radius: Theme.radius-sm;
        border-width: 1px;
        border-color: Theme.border-strong;
        drop-shadow-blur: 12px;
        drop-shadow-color: transparent;
        tip-col := VerticalLayout {
            padding-left: 10px;
            padding-right: 10px;
            padding-top: 7px;
            padding-bottom: 7px;
            spacing: 2px;
            Text {
                text: root.scope-tip-head();
                color: Theme.text-primary;
                font-size: Theme.fs-xs;
                font-weight: Theme.fw-strong;
            }
            if root.scope-tip-sub() != "" : Text {
                text: root.scope-tip-sub();
                color: Theme.text-muted;
                font-size: Theme.fs-xs;
            }
            for sc in root.scopes : Text {
                // 只有「多选」需要逐行摊开（单选/全部的台数
                // 副行已经写全了）。visible 不脱布局，高度也要归零。
                visible: root.applied-n() > 1 && root.ch-applied(sc.letter);
                height: (root.applied-n() > 1 && root.ch-applied(sc.letter)) ? 15px : 0px;
                text: @tr("Channel {0} · {1} hosts", sc.letter, sc.count);
                color: Theme.text-muted;
                font-size: Theme.fs-xs;
            }
        }
    }

    // 菜单：**向上**展开（下面就是 SFTP 面板 / 窗口底边，往下长会
    // 被推出去）；右缘贴按钮右缘，宽 300（高保真 .scope-menu.wide：
    // 要同时放下复选框、色点、频道名和台数）。
    // 与快捷/历史浮层同一模式：绝对定位到命令栏上方，父层不裁。
    if root.open : Rectangle {
        // (#scope-menu-hairline 2026-10-27) 边线 1 逻辑 px → 1 **设备** px，
        // 且外框整体 snap 到设备栅格：200% 屏上原先这条边线是 2 物理像素，
        // 比窗口四边/面板分隔线粗一档（用户反馈「下拉框的边线太粗，横线
        // 和窗口的横线保持一致」）。snap 做法同 send_cmd_window 的标题栏
        // hairline：按**绝对坐标**对齐设备网格，再换回父级坐标 —— 菜单挂
        // 在页脚/命令栏里，自身 x/y 是布局算出来的，多半落在半像素上。
        x: Theme.snap-to-device(parent.absolute-position.x
                + (root.menu-left ? 0px : parent.width - self.width))
            - parent.absolute-position.x;
        y: Theme.snap-to-device(parent.absolute-position.y - self.height - 6px)
            - parent.absolute-position.y;
        width: 300px;
        height: Theme.snap-to-device(scope-col.preferred-height);
        background: root.on-popup ? Theme.field : Theme.popup-bg;
        border-radius: 9px;
        border-width: Theme.hairline();
        border-color: Theme.border-strong;
        drop-shadow-blur: 16px;
        drop-shadow-color: transparent;
        TouchArea {}   // 吞点击，免得被背板当成"点外部"
        scope-col := VerticalLayout {
            padding: 6px;
            spacing: 1px;

            // 1 当前标签页（单选，点完即关 —— 单一选择不需要
            // 「完成」那一步）
            // ⚠️ 勾选态一律读**草稿**：读已应用值的话，勾了
            // 频道 A 之后「当前标签页」还挂着勾（截图实证），
            // 三档同时亮两个。
            ScopeRow {
                checked: !root.d-all && root.draft-n() == 0;
                dot: transparent;
                label: @tr("This tab");
                clicked => { root.scope-pick(false); }
            }
            // 2 全部标签页（单选；高保真 .opt.all 的下沿分隔线）
            ScopeRow {
                checked: root.d-all;
                dot: transparent;
                label: @tr("All tabs");
                trailing: "" + root.tab-count;
                clicked => { root.scope-pick(true); }
            }
            // (#scope-menu-hairline 2026-10-27) 分隔横线 1 逻辑 px → 1 设备 px，
            // 与面板里的分隔线同一档粗细（见上方菜单外框的注释）。
            Rectangle {
                height: Theme.hairline();
                background: Theme.line-2;
            }
            // 3 同步频道（多选；勾选只改草稿，菜单不关 —— 高保真
            // MUST 02：关掉再打开、再找回位置，选第三个就崩了）
            if root.scopes.length > 0 : Rectangle {
                height: 26px;
                Text {
                    x: 9px;
                    width: parent.width - 18px;
                    height: parent.height;
                    text: @tr("Sync channels");
                    color: Theme.text-muted;
                    font-size: 10px;
                    letter-spacing: 1px;
                    vertical-alignment: center;
                }
            }
            for sc in root.scopes : ScopeRow {
                checked: root.draft-of(sc.letter);
                dot: sc.color;
                label: @tr("Channel {0}", sc.letter);
                trailing: @tr("{0} 台", sc.count);
                row-enabled: sc.count > 0;
                clicked => { root.draft-toggle(sc.letter); }
            }
            // 4 草稿汇总（高保真 .sum：勾了什么、合计几台，实时算）
            if root.scopes.length > 0 : Rectangle {
                height: Theme.hairline();
                background: Theme.line-2;
            }
            Rectangle {
                height: 30px;
                Text {
                    x: 9px;
                    width: parent.width - 18px;
                    height: parent.height;
                    text: root.draft-summary();
                    color: Theme.text-muted;
                    font-size: Theme.fs-xs;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
            // 5 完成：把草稿写回按钮（高保真 .acts .done；悬停转
            // accent 实心 —— 它是这个菜单唯一的落点）
            Rectangle {
                height: 36px;
                done-btn := Rectangle {
                    x: parent.width - 6px - self.width;
                    y: 4px;
                    width: 64px;
                    height: 28px;
                    border-radius: 7px;
                    border-width: 1px;
                    border-color: done-ta.has-hover ? Theme.accent-solid : Theme.border-control;
                    background: done-ta.has-hover ? Theme.accent-solid : transparent;
                    animate background, border-color { duration: 120ms; }
                    done-ta := TouchArea {
                        mouse-cursor: default;
                        clicked => { root.scope-commit(); }
                    }
                    Text {
                        width: parent.width;
                        height: parent.height;
                        text: @tr("Done");
                        color: done-ta.has-hover ? #ffffff : Theme.text-primary;
                        font-size: Theme.fs-xs;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}

// --- MenuItem --------------------------------------------------------------
// One row of the terminal right-click context menu (MDL2 icon + label).
component MenuItem inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    callback clicked();

    height: 28px;
    border-radius: Theme.radius-sm;
    background: ta.has-hover ? Theme.bg-hover : transparent;

    ta := TouchArea {
        mouse-cursor: default;
        clicked => { root.clicked(); }
    }
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 8px;
        Icon {
    glyph: root.icon;
    tint: Theme.text-primary;
    size: Theme.fs-sm;
}
        Text {
            text: root.label;
            color: Theme.text-primary;
            font-size: Theme.fs-md;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
    }
}

// Persistent, resizable quick-command panel (#215). It deliberately shares the
// same model/actions as the command-bar popup; docking only adds another view.
export component QuickDockPanel inherits Rectangle {
    in property <[QuickCmd]> commands;
    in property <string> dock-edge: "right";
    callback activate(string, bool /* send-enter */);
    callback toggle-group(string);
    callback manage();
    callback request-close();
    callback dock-drag-move(length, length);
    callback dock-drag-end();

    // (#sidebar-bottom-panel 2026-10-18) 停靠的快捷命令面板属于「侧栏」档：读
    // 侧栏透明度（dock 到下沿时它就是“下方面板”）。
    background: Theme.zone-sidebar;
    // (#term-border-thin 2026-10-11) 四周边框减淡（用户反馈左缘线读感偏粗，
    // 高 DPI 下 1px 逻辑像素占 2 物理像素）：alpha 0.45 回到"发丝线"。
    border-width: 1px;
    border-color: Theme.border-subtle.with-alpha(0.45);
    clip: true;

    VerticalLayout {
        spacing: 0;
        Rectangle {
            height: 34px;
            background: Theme.zone-sidebar-alt;
            drag-area := TouchArea {
                mouse-cursor: default;
                moved => {
                    if (self.pressed) {
                        root.dock-drag-move(self.absolute-position.x + self.mouse-x,
                                            self.absolute-position.y + self.mouse-y);
                    }
                }
                pointer-event(ev) => {
                    if (ev.kind == PointerEventKind.up) { root.dock-drag-end(); }
                }
            }
            HorizontalLayout {
                padding-left: 8px; padding-right: 4px; spacing: 6px;
                Icon {
    glyph: "drag-grip";
    tint: Theme.text-primary;
    size: Theme.fs-md;
}
                Text {
                    text: @tr("Quick commands");
                    color: Theme.text-primary; font-size: Theme.fs-sm;
                    font-weight: Theme.fw-strong; vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                Rectangle {
                    width: 28px;
                    background: close-ta.has-hover ? Theme.bg-hover : transparent;
                    border-radius: Theme.radius-sm;
                    close-ta := TouchArea { mouse-cursor: default; clicked => { root.request-close(); } }
                    Icon {
    glyph: root.dock-edge == "right" ? "chevron-right" : root.dock-edge == "top" ? "expand-less" : root.dock-edge == "bottom" ? "expand-more" : "chevron-left";
    tint: Theme.text-primary;
    size: Theme.fs-md;
}
                }
            }
        }

        Flickable {
            vertical-stretch: 1;
            content-width: self.width;
            content-height: max(self.height, list.preferred-height);
            list := VerticalLayout {
                padding: 6px; spacing: 2px; alignment: start;
                if root.commands.length == 0 : Text {
                    height: 36px;
                    text: @tr("No quick commands yet");
                    color: Theme.text-muted; font-size: Theme.fs-xs;
                    horizontal-alignment: center; vertical-alignment: center;
                }
                for q in root.commands : VerticalLayout {
                    spacing: 1px;
                    if q.group-header != "" : Rectangle {
                        height: 26px;
                        border-radius: Theme.radius-sm;
                        background: group-ta.has-hover ? Theme.bg-hover : transparent;
                        group-ta := TouchArea {
                            mouse-cursor: default;
                            clicked => { root.toggle-group(q.group); }
                        }
                        HorizontalLayout {
                            padding-left: 6px; padding-right: 6px; spacing: 5px;
                            Icon {
    glyph: q.collapsed ? "chevron-right" : "expand-more";
    tint: Theme.text-primary;
    size: Theme.fs-md;
}
                            Text {
                                text: q.group; color: Theme.text-muted;
                                font-size: Theme.fs-xs; font-weight: Theme.fw-strong;
                                vertical-alignment: center; overflow: elide;
                                horizontal-stretch: 1;
                            }
                        }
                    }
                    if !q.collapsed && q.orig-index >= 0 : Rectangle {
                        height: max(44px, item-col.preferred-height + 8px);
                        border-radius: Theme.radius-sm;
                        background: item-ta.has-hover ? Theme.bg-hover : transparent;
                        item-ta := TouchArea {
                            mouse-cursor: default;
                            clicked => { root.activate(q.command, q.send-enter); }
                        }
                        item-col := VerticalLayout {
                            padding-left: 9px; padding-right: 9px;
                            padding-top: 4px; padding-bottom: 4px; spacing: 1px;
                            Text {
                                text: q.name; color: Theme.text-primary;
                                font-size: Theme.fs-sm; wrap: word-wrap;
                                vertical-alignment: center;
                            }
                            Text {
                                text: q.command; color: Theme.text-muted;
                                font-size: Theme.fs-xs; overflow: elide;
                                font-family: Theme.ui-font-family;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }

        Rectangle {
            height: 32px;
            background: manage-ta.has-hover ? Theme.bg-hover : Theme.bg-panel-alt;
            manage-ta := TouchArea { mouse-cursor: default; clicked => { root.manage(); } }
            Text {
                text: @tr("Manage…"); color: Theme.accent; font-size: Theme.fs-sm;
                horizontal-alignment: center; vertical-alignment: center;
            }
        }
    }
}

// --- TerminalView ----------------------------------------------------------

export component TerminalView inherits Rectangle {
    in property <bool> active: true;
    in property <bool> zen-mode: false;
    in property <float> terminal-line-spacing: 1.0;
    in property <bool> extra-paste-shortcuts-enabled: true;
    in property <bool> quick-right-sidebar-enabled: false;
    in property <bool> quick-panel-docked: false;
    in property <string> quick-external-command;
    in property <bool> quick-external-send-enter;
    in property <int> quick-external-sequence;
    in property <int> focus-sequence;
    in property <string> tab-id;
    in property <string> status-line: @tr("Not connected");
    in property <[TermSpan]> spans;     // coloured runs of the visible screen
    in property <int> cursor-row;       // cursor cell (grid coords)
    in property <int> cursor-col;
    in property <string> cursor-style: "block";
    in property <color> cursor-color: Theme.term-fg;
    in property <int> rows-used;        // content rows, for viewport sizing
    in property <int> scroll-max;       // scrollback depth (max offset) (#103)
    in property <int> scroll-offset;    // current offset (0 = live bottom) (#103)
    in property <bool>   is-alt-screen;
    in property <bool>   mouse-tracked;   // remote app wants mouse events (btop/htop/mc)
    in property <[TermMatch]> find-matches; // search-highlight rectangles
    in property <[TermMatch]> selection;    // drag-selection highlight rectangles

    in property <string>  sftp-path: "/";
    in property <[SftpEntry]> sftp-entries;
    in property <string>  sftp-status: "";
    in property <bool>    sftp-loading: false;
    in property <[SftpTreeNode]> sftp-tree-nodes: [];
    in property <[TabInfo]> sftp-transfer-targets: [];
    in property <string> sftp-sort-key: "";
    in property <int> sftp-sort-dir: 0;
    in property <bool> sftp-show-type: true;
    in property <bool> sftp-show-size: true;
    in property <bool> sftp-show-modified: true;
    in property <bool> sftp-show-permissions: true;
    in property <bool> sftp-show-owner: true;
    in property <bool> sftp-show-group: true;
    in property <bool> sftp-available: true;
    in property <[TunnelInfo]> tunnels: [];

    // Per-session now (#v0.5): the AppWindow stores these in each TerminalState
    // and writes back via the set-* callbacks, so each tab/pane keeps its own SFTP
    // size + collapse state (resizing/collapsing one no longer affects the others).
    in property <length> sftp-panel-height: 220px;
    in property <length> sftp-panel-width: 380px;     // extent when docked left/right
    in property <length> sftp-saved-height: 220px;    // height to restore on un-collapse
    in property <length> sftp-tree-width: 160px;
    in property <bool>   sftp-collapsed: false;       // SFTP panel minimised (toolbar only)
    callback set-sftp-panel-height(length);
    callback set-sftp-panel-width(length);
    callback set-sftp-saved-height(length);
    callback persist-sftp-tree-width(length);
    callback toggle-sftp-column(string);
    callback set-sftp-collapsed(bool);

    // --- SFTP docking (within the terminal area) ---------------------------
    // Which edge of the terminal area the SFTP panel sits on: left|right|top|bottom.
    in-out property <string> sftp-dock: "bottom";
    property <bool> sftp-horizontal: root.sftp-dock == "left" || root.sftp-dock == "right";
    // Drag-to-dock snap state (mirrors the resource-panel docking in app.slint).
    property <bool> sftp-panel-dragging;
    property <float> sftp-drag-nx;
    property <float> sftp-drag-ny;
    property <string> sftp-dock-target:
        !root.sftp-panel-dragging ? ""
        : root.sftp-drag-nx < 0.22 ? "left"
        : root.sftp-drag-nx > 0.78 ? "right"
        : root.sftp-drag-ny < 0.22 ? "top"
        : root.sftp-drag-ny > 0.78 ? "bottom"
        : "";
    callback persist-sftp-dock(string);

    // Command bar (#55): 输入框（左）+ 内嵌快捷/历史 + 发送范围 + 发送键。
    // 高保真 session-dialog-commandbar-hifi-2026-10-23 屏 03：
    //   · 输入框从**最左**开始（原「快捷」胶囊占着视线起点，被挤掉时输入框
    //     起点还跟着跳）；快捷命令与历史是"往输入框里写东西"的辅助动作，
    //     并到输入框右端（⚡ / 🕘），与输入语义对齐；
    //   · 输入框有上限宽度，右半边不再被它吃光，范围键才能把话说全；
    //   · 发送范围从死文字变成下拉（全部标签页 / 各同步频道）。
    in property <[QuickCmd]> quick-commands;
    in property <[string]> command-history;   // oldest first (newest last, #113)
    in property <[string]> history-view;       // filtered dropdown, oldest first (newest last, #101)
    // (#cmdbar-suggest 2026-10-24) 打字时补全框的候选 = 自定义指令集（在前）+ 历史
    // 匹配（在后）。和 history-view 分开：点时钟打开的完整面板只列历史，而补全态
    // 是「我想执行什么」，自己配的指令集也该被找出来（用户反馈）。
    // suggest-kind 与 suggest-view 等长：1 = 快捷命令（画 bolt）、0 = 历史。
    in property <[string]> suggest-view;
    in property <[int]> suggest-kind;
    // (#cmd-hint 2026-10-27) 四段式提示框（高保真稿
    // docs/design/terminal-command-hint-hifi-2026-10-27.html）。
    // ★ 它**取代**了原来那个「只有文本 + 类型两列」的窄列表（300px）：
    //   高保真的四段结构（上下文 / 候选 / 详情 / 键盘脚注）在 300px 里排版
    //   不下，详情区尤其需要宽度。suggest-* 仍保留 —— 完整历史面板和
    //   send_cmd_window 还在用同一套数据。
    in property <[HintRow]> hint-rows;
    in property <string> hint-phase: "";       // 阶段胶囊文案（Rust 已本地化）
    in property <string> hint-context: "";     // 上下文条：`user@host : cwd`
    in property <int> hint-total: 0;           // 命中总数（行数仍按 5 封顶）
    // 危险命令告警由**本文件自己算**（danger-token() 就在下面几百行处），
    // 所以这里没有 in 属性；组件读的是 out property hint-danger-token。
    // (#cmdbar-scope 2026-10-23) 可送达的同步频道（Rust 按本窗口已打开标签页算）。
    in property <[SendScope]> send-scopes;
    // 「全部标签页」后面 / 「全部」档的台数：只数 kind == "terminal" 的标签页
    // （welcome 欢迎页没有 PTY，发不到），由 Rust 统一算好后下发。
    in property <int> open-tab-count: 0;
    // (#cmdbar-scope-multi 2026-10-23) 发送范围 = 三档互斥：
    //   · 当前标签页（默认，最安全，行为与旧版 to-all=false 一致）
    //   · 全部标签页
    //   · 一组同步频道（多选，最多 A–D 四个）
    // 用 bool 而不是一个 "A,C" 串保存：Slint 1.18 的 string 没有 contains /
    // split，只有按字母展开查表才能既判勾选又拼发送串。
    property <bool> scope-all: false;
    property <bool> scope-ch-a: false;
    property <bool> scope-ch-b: false;
    property <bool> scope-ch-c: false;
    property <bool> scope-ch-d: false;
    // 菜单里的勾选草稿在 ScopeButton 组件内部（打开时复制、点「完成」才写回）。
    property <bool> scope-open: false;
    // (#cmdbar-expand 2026-10-23) 弹出编辑窗口（高保真屏 06）：一条横条写不下
    // 的命令（for / heredoc / 要一边看输出一边改）。三个入口：输入框右端的 ↗
    // 钮、双击输入框、Ctrl+Shift+E。草稿是**同一份** —— 打开时回填，收起时写回
    // 命令栏；只有发送成功才清空。
    property <bool> cmd-expand-focus-pending: false;
    // (#cmdbar-expand-scope 2026-10-23) 弹窗里那个范围键的菜单是**独立**开合：
    // 复用 scope-open 会让两处菜单同时展开（用户截图：弹窗底部与命令栏上方
    // 各弹一个「当前标签页 / 全部标签页 / 完成」）。范围状态仍共用，只分开合。
    property <bool> exp-scope-open: false;
    in property <bool> cmd-bar-hidden: false;  // toolbar toggle hides the whole bar
    // Effective terminal font size in px: per-session zoom override when > 0,
    // else the window/global size (Theme.term-font-size).
    in property <float> term-font-size-px: Theme.term-font-size / 1px;
    property <bool> quick-open: false;         // quick-command popup visibility
    property <bool> history-open: false;       // history dropdown visibility
    // (#cmdbar-suggest 2026-10-24) 「完整历史面板」= 点 🕘 / Ctrl+R 打开的那个。
    // 打字触发的补全框也复用 history-open，但它不是「历史」这个动作 ——
    // 时钟钮不该跟着亮（用户反馈：输入时图标亮着，像点了历史）。
    property <bool> hist-panel-open: root.history-open && !root.history-autocomplete;
    // (#cmdbar-suggest-empty 2026-10-24) 浮层到底画不画：补全态要求至少一条候选
    // （空列表就是个只有「无匹配」三个字的空壳，挡终端没信息量）；完整面板照旧
    // （它本来就要用「无匹配 + 搜索框」回话）。backdrop 跟这个同一口径，
    // 否则会留一层看不见却吃点击的遮罩。
    //
    // (#cmd-hint 2026-10-27) 补全态改判 **hint-rows**：四段式提示框的数据源已经
    // 换成 `hint-rows`（Rust 按整行算出来的四列），不再是旧的 suggest-view。
    // 还按 suggest_count() 判的话，hint-rows 有内容也永远画不出来。
    // 危险命令例外：0 候选也要亮框，因为告警本身是信息（高保真 §3 ③）。
    property <bool> hist-popup-visible: root.history-open
        && (!root.history-autocomplete
            || root.hint-rows.length > 0
            || root.danger-now != "");
    property <bool> history-autocomplete: false; // live suggestions from command input (#349)
    property <int> history-cursor: -1;         // ↑/↓ recall index (-1 = live input)
    // (#cmdbar-caret-anchor 2026-10-23) 光标的横向位置（相对命令栏输入框的文字起点），
    // 历史浮层据此贴着光标右上角展开。之前浮层 `x: parent.width - 308px` 死在
    // 命令栏右端：光标在左半边打字时，列表飘在整行另一头（用户截图反馈「不协调」）。
    // 缓存值：TextInput 只给 cursor-position-changed 回调，没有可读的 cursor 属性。
    property <length> cmd-caret-x: 0px;
    // The history dropdown is created by the key-press / click handlers while
    // Slint is still dispatching the event. Focusing its search TextInput
    // synchronously in `init` can re-enter the Windows IME/accessibility
    // plumbing and read the popup's half-built layout, panicking with
    // "Recursion detected" (#349 / #343-style). Defer focus to next tick.
    property <bool> history-search-focus-pending: false;
    // Keyboard-driven selection in the open history dropdown (#140): ↑/↓ move it,
    // Enter runs history-view[history-selected].
    property <int> history-selected: 0;
    // 第二参数从 bool(to-all) 换成范围串："" = 当前标签页 / "*" = 全部 /
    // "A,C" = 勾选的一组频道（见 scope-spec）。
    callback run-command(string /* cmd */, string /* scope */);
    // (#send-cmd-window) 打开「发送命令」独立窗口，带上命令栏当前那一行文本
    callback open-send-window(string /* draft */);

    // (#cmdbar-scope-multi 2026-10-23) 发送范围串："" = 当前标签页 /
    // "*" = 全部标签页 / "A,C" = 勾选的一组频道（尾逗号由 Rust 侧过滤）。
    // 三档的文案、台数、色点、菜单都搬进了 ScopeButton 组件（主命令栏与
    // 弹出编辑窗口共用），根作用域只留「发送时要的那个串」。
    function applied-n() -> int {
        return (root.scope-ch-a ? 1 : 0) + (root.scope-ch-b ? 1 : 0)
             + (root.scope-ch-c ? 1 : 0) + (root.scope-ch-d ? 1 : 0);
    }
    function scope-spec() -> string {
        if (root.scope-all) { return "*"; }
        if (root.applied-n() == 0) { return ""; }
        return (root.scope-ch-a ? "A," : "") + (root.scope-ch-b ? "B," : "")
             + (root.scope-ch-c ? "C," : "") + (root.scope-ch-d ? "D," : "");
    }
    // (#cmdbar-suggest 2026-10-24) 补全候选的类型：1 = 快捷命令，0 = 历史。
    // 带越界保护 —— Rust 侧是两次 set（view / kind），理论上会有一帧长度不齐。
    function history_kind_at(idx: int) -> int {
        return idx >= 0 && idx < root.suggest-kind.length ? root.suggest-kind[idx] : 0;
    }
    // (#cmdbar-suggest 2026-10-24) 当前候选列表的长度 / 第 idx 条：补全态读
    // suggest-view，完整面板读 history-view。↑↓ 选择、Tab 补全、空态判断都走
    // 这两个函数，省得每个分支各写一遍三元。
    function suggest_count() -> int {
        return root.history-autocomplete ? root.suggest-view.length : root.history-view.length;
    }
    function suggest_at(idx: int) -> string {
        return root.history-autocomplete
            ? (idx >= 0 && idx < root.suggest-view.length ? root.suggest-view[idx] : "")
            : (idx >= 0 && idx < root.history-view.length ? root.history-view[idx] : "");
    }
    // (#cmdbar-suggest 2026-10-24) 打开「完整历史面板」：点 🕘 与 Ctrl+R 都走这里。
    // 关键是从**补全态升级**的那条路：此时 history-open 已经是 true，再赋 true
    // 不触发 `changed history-open`，过滤就不会被清掉 —— 面板里剩下的还是
    // 「按命令栏那几个字过滤过的」历史。所以这里显式 search-history("") 并重置选中。
    // ── (#cmd-hint 2026-10-27) 四段式提示框的键盘契约 ────────────────────
    // 高保真 §5。核心原则：**提示框只在打开时接管按键，关闭时一个键都不多占**；
    // 边界要「穿透」回 shell，而不是把方向键吞掉。

    // 可见行数 = min(候选数, 5)。选中项只允许在这几条里循环 —— 数据侧也按 5
    // 封顶，两边取同一个数，选中项不可能落在没画出来的行上（高保真 §5 边界）。
    function hint-count() -> int {
        return min(root.hint-rows.length, 5);
    }
    // 命中的那一条「填进命令行之后**整行**长什么样」。
    //
    // ★ 高保真 §5 最容易写错的一条：判据不能拿单词跟整行比。
    //   子命令阶段候选是「git commit」整条、参数阶段是「-u」这种单词，
    //   拿 `candidate == line` 去比，前者永远不等、后者几乎永远不等，
    //   结果就是「永远只填入、永远不执行」。
    //   这里的口径：把候选**应用到当前行**，得到目标整行，再比。
    // 命中项「填进命令行之后**整行**长什么样」。
    //
    // ★ 高保真 §5 最容易写错的一条：判据不能拿单词跟整行比。
    //   子命令阶段候选是「git commit」整条、参数阶段是「-u」这种单词，
    //   拿 `candidate == line` 去比，前者永远不等、后者几乎永远不等，
    //   结果就是「永远只填入、永远不执行」。
    //
    // ★ 这个整行由 **Rust 侧算好**（HintRow.apply）：Slint 1.18 的 string
    //   没有 trim-end / rfind / substr，在 UI 里拼路径/替换词只能靠
    //   replace-all 硬凑，重复片段一多就出错。Rust 那边拆分词的逻辑已经在
    //   `HintInput` 里，顺带产出 apply 只有一个来源。
    function hint-target(idx: int) -> string {
        if (idx < 0 || idx >= root.hint-rows.length) { return cmd-input.text; }
        return root.hint-rows[idx].apply;
    }

    // 把选中项填入命令行（不执行）。返回是否真的改了文本。
    function hint-accept() -> bool {
        let idx = root.history-selected;
        if (idx < 0 || idx >= root.hint-count()) { return false; }
        let before = cmd-input.text;
        let target = root.hint-target(idx);
        // 命令名/子命令后面补一个空格，好接着打下一个词；
        // 以 `/` 结尾的路径不补（用户还要继续补下一级）。
        if (!target.ends-with(" ") && !target.ends-with("/")) {
            cmd-input.text = target + " ";
        } else {
            cmd-input.text = target;
        }
        root.history-selected = 0;
        // ★ #cmdbar-focus：填入后要让输入框重新持有焦点与光标。
        cmd-input.focus();
        root.hint-refresh();
        return cmd-input.text != before;
    }

    // 鼠标悬停：高保真 §5 要求「悬停只高亮、不选中」，避免列表跟着鼠标抖。
    // Slint 侧高亮由 TouchArea.has-hover 自带，所以这里不改 selected。
    function hint-hover(idx: int) {
        // 故意留空。保留这个出口是为了将来接「悬停预览详情」，
        // 且让组件回调有明确归属（不要在这里改 selected）。
    }

    // Enter 的两段式（高保真 §5）：行尾**不是空格** = 这个词还在补 → 先填入；
    // 行尾是空格 = 已落定 → 执行。这样 Enter 永远只走两步，不会无限套娃。
    //
    // ★ 比的是 `cmd-input.text` 与 Rust 侧算好的 `row.apply`（见 hint-target）：
    //   相等 → 执行；不等 → 先填入。绝不能用「候选单词 == 整行」去比 ——
    //   子命令阶段候选是「git commit」整条、参数阶段是「-u」单词，那样比
    //   永远不相等，结果就是「永远只填入、永远不执行」。
    function hint-enter-runs() -> bool {
        if (root.hint-count() <= 0) { return true; }
        return cmd-input.text == root.hint-target(root.history-selected);
    }

    // 重新算一次提示框数据（Rust 侧按当前输入重算四列）。
    function hint-refresh() {
        root.hint-query(cmd-input.text);
    }

    function open_history_panel() {
        root.quick-open = false;
        root.scope-open = false;
        if (root.history-open && root.history-autocomplete) {
            root.history-autocomplete = false;
            root.search-history("");
            root.history-selected = root.history-view.length > 0
                ? root.history-view.length - 1 : 0;
        } else {
            root.history-autocomplete = false;
            root.history-open = true;
        }
    }

    // ── 危险命令（#cmdbar-danger 2026-10-23，高保真屏 05/07）───────────
    // 命中即「告警条浮出 + 发送键变红改文案」；改掉命令就自动消失，没有第二个
    // 确认对话框（高保真屏 07 的定稿：点「仍然发送」= 直接发出）。
    function has-token(t: string, tok: string) -> bool {
        return t.replace-all(tok, "") != t;
    }
    // 返回要展示的模式（命令原文，不翻译）；"" = 安全
    function danger-token(t: string) -> string {
        if (t == "") { return ""; }
        let s = t.to-lowercase();
        if (root.has-token(s, "rm -rf") || root.has-token(s, "rm -fr")
                || root.has-token(s, "rm -r -f")) {
            return "rm -rf";
        }
        if (root.has-token(s, "mkfs")) { return "mkfs"; }
        if (root.has-token(s, "dd if=")) { return "dd if="; }
        if (root.has-token(s, "shutdown")) { return "shutdown"; }
        if (root.has-token(s, "reboot")) { return "reboot"; }
        if (root.has-token(s, "chmod -r 777")) { return "chmod -R 777"; }
        if (root.has-token(s, "init 0")) { return "init 0"; }
        return "";
    }
    property <string> danger-now: root.danger-token(cmd-input.text);
    // (#cmd-hint 2026-10-27) 提示框详情区的告警**读同一份** danger-token()。
    // 高保真 §7 点名过「危险模式表被抄了第三遍」，所以这里不新增查表，
    // 直接把本节算出来的值下发给组件；tag 用命令原文（不翻译），
    // 说明按命中模式给一句人话。
    out property <string> hint-danger-token: root.danger-now;
    pure function danger-why(tok: string) -> string {
        if (tok == "rm -rf") { return @tr("Recursive force delete: nothing goes to a recycle bin."); }
        if (tok == "mkfs") { return @tr("Formatting overwrites every byte on the target device."); }
        if (tok == "dd if=") { return @tr("Block-level copy: a wrong of= wipes the whole disk."); }
        if (tok == "shutdown") { return @tr("Takes the remote host down; all sessions drop."); }
        if (tok == "reboot") { return @tr("Reboots the remote host; all sessions drop."); }
        if (tok == "chmod -R 777") { return @tr("Grants write access to everyone."); }
        if (tok == "init 0") { return @tr("Switches to the power-off runlevel."); }
        return "";
    }
    out property <string> hint-danger-why: root.danger-why(root.danger-now);
    // 「将发往 N 台」：当前标签页档没有台数概念（返回 0 = 不显示这一句）。
    // ScopeButton 组件内部也有同一张查表，但那是组件私有作用域，这里要自己算。
    function scope-count-in(letter: string) -> int {
        if (root.send-scopes.length > 0 && root.send-scopes[0].letter == letter) { return root.send-scopes[0].count; }
        if (root.send-scopes.length > 1 && root.send-scopes[1].letter == letter) { return root.send-scopes[1].count; }
        if (root.send-scopes.length > 2 && root.send-scopes[2].letter == letter) { return root.send-scopes[2].count; }
        if (root.send-scopes.length > 3 && root.send-scopes[3].letter == letter) { return root.send-scopes[3].count; }
        return 0;
    }
    function danger-targets() -> int {
        if (root.scope-all) { return root.open-tab-count; }
        if (root.applied-n() == 0) { return 0; }
        return (root.scope-ch-a ? root.scope-count-in("A") : 0)
             + (root.scope-ch-b ? root.scope-count-in("B") : 0)
             + (root.scope-ch-c ? root.scope-count-in("C") : 0)
             + (root.scope-ch-d ? root.scope-count-in("D") : 0);
    }
    callback manage-quick-commands();          // open the add/edit/delete dialog
    callback quick-dock-drag-move(length, length);
    callback quick-dock-drag-end();
    callback toggle-quick-group(string /* group */);  // collapse/expand a group (#55)
    // Right-click management on the popup, mirroring the welcome session list (#55).
    callback edit-quick-command(int /* index */);
    callback duplicate-quick-command(int /* index */);
    callback delete-quick-command(int /* index */);
    callback move-quick-command(int /* index */, string /* group */);
    callback new-quick-group();
    callback rename-quick-group(string /* group */);
    callback delete-quick-group(string /* group */);
    callback copy-text(string);                // copy a history command to clipboard (#96)
    callback delete-history(int /* index */);  // remove a history entry (#96)
    callback delete-history-cmd(string /* cmd */); // remove a history entry by command (#101)
    callback search-history(string /* query */);   // filter the history dropdown (#101)
    // (#cmd-hint 2026-10-27) 按当前命令行文本重算提示框四段数据。
    // Rust 侧同步回调（与 search-history 同一套模式），返回时 hint-* 已是最新值。
    callback hint-query(string /* line */);

    callback send-key(string, bool, bool, bool);
    // Temporary on-device diagnostics for #312. Rust redacts printable text.
    callback diagnose-key-event(string, bool, bool, bool, bool);
    callback cycle-tab(bool /* reverse */);
    // Ctrl+Shift+N (⌘⇧N on macOS) — open a new application window (#multi-window).
    callback new-window-key();
    // Font zoom: Ctrl+= / Ctrl+- / Ctrl+0 (⌘ on macOS). Direction:
    // 1 = larger, -1 = smaller, 0 = reset to default.
    callback zoom-key(int /* direction */, bool /* window-wide */);
    // Ctrl+Alt+Z (⌘⌥Z on macOS) — toggle zen (focus) mode.
    callback zen-key();
    callback terminal-resize(float, float);
    callback sftp-navigate(string);
    callback sftp-download(string);
    callback sftp-upload-clicked(string, bool);
    callback sftp-refresh(string);
    callback sftp-tree-expand(string);
    callback sftp-delete(string);
    in property <int> sftp-selected-count;          // checked-entry count (#100)
    in property <string> sftp-single-selected-path;   // single checked entry's path, else "" (#W4)
    callback sftp-toggle-select(int);               // toggle a row's checkbox (#100)
    callback sftp-download-selected();              // download checked entries (#100)
    callback sftp-download-selected-sequential();    // one-by-one, no archive (#100.4)
    callback sftp-download-archive(string);          // archive ONE explicit path as .zip (#sftp-archive-zip)
    callback sftp-delete-selected();                // delete checked entries (#100)
    callback sftp-copy-to-target(string, string);
    callback sftp-copy-selected-to-target(string);
    callback sftp-view(string);
    callback sftp-edit(string);
    callback sftp-open-external(string);
    callback sftp-edit-external(string);
    callback sftp-sort-request(string);
    callback sftp-clear-sort();
    callback tunnel-add(string, string, string, string, string, string);
    callback tunnel-stop(string);
    // Context-menu extensions (#69), forwarded up to the app shell.
    callback sftp-rename-request(string, string);
    callback sftp-chmod-request(string, string, int);
    callback sftp-copy-path(string);
    callback sftp-new-folder(string);
    callback sftp-new-file(string);
    callback paste-from-clipboard();
    callback copy-terminal-text();
    callback clear-terminal();              // wipe this session's screen buffer
    callback find-query-changed(string);    // recompute search highlights
    callback terminal-scroll(float);         // scroll history by fractional lines (+ = up); Rust keeps the sub-line remainder so momentum decays smoothly
    // Wheel inside an alt-screen app (tmux/less/vim): forward to the program so it
    // scrolls, instead of doing nothing (#170). dir = +1 up / -1 down; col/row =
    // mouse cell. Rust sends a mouse-wheel event if the app tracks the mouse, else
    // arrow keys (alternate-scroll).
    callback terminal-wheel(int /* dir */, int /* col */, int /* row */);
    callback terminal-scroll-to(int);       // jump to an absolute scrollback offset (#103)
    // Forward a mouse button event to the PTY for mouse-tracking TUI apps
    // (btop/htop/mc). kind: 0=press 1=release 2=drag-motion; button: 0=left
    // 1=middle 2=right; col/row are grid cells. Returns true when the event was
    // sent to the remote (the caller then skips its own local handling).
    callback terminal-mouse(int /* kind */, int /* button */, int /* col */, int /* row */) -> bool;
    callback select-start(int, int, bool, bool); // row, col, ctrl, shift
    callback select-update(int, int);       // extend drag-selection to (row, col)
    callback select-end();                  // finish selection → copy to clipboard
    callback select-word(int, int);         // double-click word → select + copy (#287)
    callback select-autoscroll(int);        // auto-scroll while dragging past edge (dir: -1 up / +1 down)

    // Right-click context-menu anchor + find-bar visibility (private UI state).
    property <length> ctx-x;
    property <length> ctx-y;
    property <bool> find-active: false;
    // A context-menu click creates the conditional find bar while Slint is
    // still dispatching the popup event. Focusing its TextInput synchronously
    // can re-enter the Windows IME/accessibility plumbing and panic (#343).
    property <bool> find-focus-pending: false;
    property <bool> selecting: false;
    // Auto-scroll direction while drag-selecting past the visible edge.
    // 0 = none, -1 = above top (scroll to older), +1 = below bottom (newer).
    property <int> autoscroll-dir: 0;
    property <length> vis-y: 0px;   // scratch: cursor Y within the visible viewport
    // Defer ime-input.focus() to the next event-loop tick so AccessKit tree
    // construction (on new TerminalView instantiation) finishes before focus
    // changes — avoids RefCell re-entry panic in WinitWindowAdapter (#AccessKit).
    property <bool> focus-pending: false;

    changed quick-external-sequence => {
        if (root.active) {
            if (root.quick-external-send-enter) {
                root.run-command(root.quick-external-command, root.scope-spec());
                root.focus-pending = true;
            } else {
                cmd-input.text = root.quick-external-command;
                cmd-input.focus();
            }
        }
    }

    changed focus-sequence => {
        if (root.active) {
            root.focus-pending = true;
        }
    }

    // (#bottom-dock-alpha 2026-10-18) 根底**透明**：终端底色下沉到画布（scroll-clip）。
    // 以前根底铺满 term-bg，命令栏 / 文件传输面板虽然半透明，透出来的仍是这块
    // 不透明的终端底色 → 侧栏透明度对它们「看起来没生效」。下沉后下方面板透出的
    // 是窗口底（无壁纸时即桌面），与左右侧栏一致。
    background: transparent;
    forward-focus: ime-input;

    // Drag state (private)
    property <bool>   sftp-dragging:     false;
    property <length> drag-start-mouse-y: 0px;

    // --- Real cell-size measurement ----------------------------------------
    // A hidden Text rendered with the exact terminal font reports the true
    // Consolas cell width/height for the current font size.  We derive the PTY
    // column/row counts from these measured cells instead of guessing 8×16px,
    // so full-screen programs (nano/vim) get an accurate row count and their
    // bottom shortcut bar is no longer clipped off the visible area.
    // Measure a 50-char run, not a single glyph: a single Text's preferred-width
    // includes left/right side bearings and is wider than the real per-character
    // advance, which would make absolutely-positioned spans drift apart.  The
    // average advance over a long run (side bearings amortised) is accurate.
    // Cell-size probe: must be RENDERED (opacity:0, not visible:false) so Slint
    // actually loads the resolved font before preferred-width/height are
    // computed. visible:false can skip font loading and measure with a different
    // fallback than the spans really use, giving a too-narrow cell-w and thus a
    // too-large term-cols.
    cell-probe := Text {
        text: "MMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMM"; // exactly 50×M
        font-family: Theme.term-font-family;
        font-size: root.term-font-size-px * 1px;
        font-weight: Theme.term-font-bold ? Theme.fw-strong : Theme.fw-regular;
        // Keep it in layout but invisible: opacity:0 forces full font loading.
        opacity: 0;
        // Park it at y<0 so it never overlaps terminal content.
        y: -200px;
        width: 0px; // zero out layout contribution
        height: 0px;
    }
    // cell-w / cell-h come straight from the probe so they ALWAYS match the
    // font the spans below are actually rendered with.  (Forcing a hard-coded
    // minimum here is dangerous: if the spans fall back to a system font, a
    // mismatched cell-w garbles the grid.  Keep them derived from one source.)
    property <length> cell-w: max(1px, cell-probe.preferred-width / 50);
    property <length> cell-h: max(1px, cell-probe.preferred-height * root.terminal-line-spacing);
    // (#line-spacing-center) 普通文字 span 的纵向偏移：把 Text 的自然行盒
    // （= 探针 preferred-height，未乘行距）在缩放后的格子内垂直居中。
    // 行距 1.0 → 偏移 0；<1 → 负（上移，否则字墨贴格底、高亮显得偏上）；
    // >1 → 正（下移，否则字墨贴格顶、高亮显得偏下）。
    // (#ink-center 2026-10-21) 只居中行盒还不够：parley 把行盒里剩余的行距全
    // 留在基线下方，字形墨迹（大写顶 → 基线）因此整体偏上。离屏实测（13px、
    // 125% 缩放、行距 80%）：格子 18 设备 px，墨迹上留白 2、下留白 4 —— 拖选
    // 时高亮下沿看着"空了一截"，用户以为文字浮在阴影上。把文字整体下移
    // 0.062em（13px 下 0.8px，正好补平 2/4），上下留白相等。图标走同一偏置，
    // 图标与文字的字面高度才继续对齐。
    property <length> ink-bias: root.term-font-size-px * 0.062px;
    property <length> text-y-shift: (root.cell-h - cell-probe.preferred-height) / 2 + root.ink-bias;
    // (#nerd-icon-scale) 图标字形放大倍数：图标按 em 方框设计，格宽只有字号
    // ~0.6，名义字号下比小写 x-height 还矮。但放大要按**最高的那批**图标算：
    // `ls --color` 的文档图标（nf-fa-file_text 等）墨高 0.77em，1.75 会让它长到
    // 1.35em —— 比整格还高，上下都糊进邻行，整屏看着"图标比字大一号、还错位"。
    // 1.15 让最高图标收进格内（0.92em），常规文件夹图标 0.60em、数字高度 0.73em，
    // 与文字比例协调。
    property <float> nerd-scale: 1.15;
    // Usable text box = root.width minus the 10px left/right padding of
    // output-text; usable height = key-capture height minus the 8px top pad.
    // The old 16px bottom focus-recovery strip was redundant once body-touch
    // covered the full output and visibly stole one terminal row.
    property <float> term-cols: max(10, floor((root.width - 20px) / cell-w));
    property <float> term-rows: max(5,  floor((key-capture.height - 8px) / cell-h));
    // Only resize the PTY while this tab is visible.  Inactive tabs are laid
    // out at width 0 (→ term-cols collapses to 10); resizing the remote to 10
    // columns reflows the vt100 screen and destroys the scrollback, so when you
    // switch back the output is gone.  Guarding on `visible` keeps each hidden
    // session frozen at its real size; `changed visible` re-syncs on return.
    property <bool> has-real-size: root.width >= 80px && key-capture.height >= 80px;
    changed term-cols => { if (root.visible && root.has-real-size) { root.terminal-resize(root.term-cols, root.term-rows); } }
    changed term-rows => { if (root.visible && root.has-real-size) { root.terminal-resize(root.term-cols, root.term-rows); } }
    changed has-real-size => { if (root.visible && root.has-real-size) { root.terminal-resize(root.term-cols, root.term-rows); } }

    init => { if (root.has-real-size) { root.terminal-resize(root.term-cols, root.term-rows); } }

    // Bottom-pinning / alt-screen alignment is handled declaratively by
    // scroll-clip.view-y; nothing to sync imperatively here anymore.
    // Reset the history filter whenever the dropdown opens; the search box itself
    // is recreated empty because the `if` subtree is destroyed on close (#101).
    changed history-open => {
        if (root.history-open) {
            if (!root.history-autocomplete) { root.search-history(""); }
            // List is oldest→newest (#101): default-select the newest entry.
            root.history-selected = root.history-view.length > 0
                ? root.history-view.length - 1 : 0;
        } else {
            root.history-autocomplete = false;
        }
    }
    changed visible => {
        if (self.visible) {
            root.focus-pending = true;
            // Re-sync the PTY size on return (it was frozen while hidden).
            if (root.has-real-size) {
                root.terminal-resize(root.term-cols, root.term-rows);
            }
        }
    }

    focus-defer-timer := Timer {
        interval: 0ms;
        running: root.focus-pending;
        triggered => {
            if (root.focus-pending) {
                ime-input.focus();
                root.focus-pending = false;
            }
        }
    }

    // (#cmdbar-expand 2026-10-23) 弹窗里的编辑器要**下一帧**才 focus：同步
    // focus 会撞上 Windows 的 IME/无障碍管线读到半建好的布局（#349 的
    // "Recursion detected" 就是这条路）。定时器放在弹窗内部 —— exp-input 是
    // 条件元素，根作用域里引用它在关闭时会指向不存在的元素。

    VerticalLayout {
        spacing: 0;

        // [ALT] alt-screen indicator is now a root-level absolute overlay (see
        // the bottom of this component) rather than a VerticalLayout child: the
        // old strip toggled its 0↔24px height with is-alt-screen and Rust
        // rewrites is-alt-screen on every terminal rebuild (terminal_ui.rs
        // rebuild_tab_display → row.is_alt_screen = b.is_alt), so that height
        // jump made the whole shell block jitter vertically on connect/focus.
        // An absolute overlay never changes the pane layout height (#alt-indicator-overlay).

        // SFTP docking region — terminal + command-bar (central) on one side,
        // the SFTP panel docked to the chosen edge. Absolute geometry, mirroring
        // the resource-panel dock area in app.slint (#dock).
        dock-region := Rectangle {
        vertical-stretch: 1;
        // Collapsed → shrink to the 36px ToolStrip icon bar at the docked edge
        // (M5), click its icon to re-expand. The 4px splitter is gone collapsed.
        // Side-docked SFTP needs enough room for its compact action row and a
        // usable path field. Clamp legacy/saved widths below that floor instead
        // of letting Slint squeeze controls out of alignment.
        // (#sftp-cmdbar-bottom 2026-09-04) When the session type doesn't
        // support SFTP (local PowerShell / CMD / WSL) the panel never
        // renders, so sf-h / sf-w fall back to 0 instead of leaving a
        // permanent 36px gap above the cmd-bar.
        property <length> sf-w: !root.sftp-available ? 0px
            : root.sftp-collapsed ? 36px
            : root.sftp-horizontal ? max(300px, root.sftp-panel-width)
            : root.sftp-panel-width;
        property <length> sf-h: !root.sftp-available ? 0px
            : root.sftp-collapsed ? 36px : root.sftp-panel-height;
        property <length> sp: root.sftp-collapsed || !root.sftp-available ? 0px : 5px;
        // The collapsed bar (sf-h) already reserves the bottom strip now.
        property <length> bottom-strip-h: 0px;

        central := Rectangle {
            x: root.sftp-dock == "left" ? parent.sf-w + parent.sp : 0px;
            y: root.sftp-dock == "top"  ? parent.sf-h + parent.sp : 0px;
            width:  root.sftp-horizontal ? parent.width - parent.sf-w - parent.sp : parent.width;
            height: root.sftp-horizontal ? parent.height : parent.height - parent.sf-h - parent.sp - parent.bottom-strip-h;
            clip: true;
            // (#wallpaper-scope-tabless 2026-10-18) 作用域 = 终端时壁纸不再画在这里：
            // 改由 AppWindow 的内容容器铺满**整个中间区域**（空态 / 欢迎页也包括），
            // 否则没有 tab 时整棵 TerminalView 不存在，壁纸就没了（用户反馈）。
            VerticalLayout {
            spacing: 0;

        // --- Key-capture scope + scrollable output --------------------------
        key-capture := FocusScope {
            vertical-stretch: 1;
            // Any click inside this scope (e.g. the middle-click paste strip)
            // can grab focus to the FocusScope itself.  Key forwarding lives on
            // the hidden `ime-input` TextInput, so a bare FocusScope focus means
            // the cursor stops blinking and typing stops working.  Forwarding
            // focus to ime-input guarantees the text input always ends up with
            // the keyboard focus, no matter what grabbed it.
            forward-focus: ime-input;
            property <bool> cursor-blink: true;

            init => { root.focus-pending = true; }

            Timer {
                // Stop blinking (and thus repainting) when the window isn't
                // focused — an idle background terminal should cost ~0 CPU (#127).
                running: ime-input.has-focus && Theme.window-focused;
                interval: 530ms;
                triggered => { key-capture.cursor-blink = !key-capture.cursor-blink; }
            }

            // Auto-scroll while the drag-selection is held past the top/bottom
            // edge: ticks repeatedly so the scrollback keeps moving even when the
            // mouse is held still beyond the edge.
            Timer {
                running: root.selecting && root.autoscroll-dir != 0;
                interval: 50ms;
                triggered => { root.select-autoscroll(root.autoscroll-dir); }
            }

            VerticalLayout {
                spacing: 0;

                // Plain clipped container instead of a Flickable.  Two reasons:
                //
                // 1. Cursor flicker: Slint resets the mouse-cursor to default at
                //    the start of *every* mouse event and re-derives it from the
                //    items actually visited.  A Flickable intercepts wheel
                //    events in bursts (gesture start + an 800ms capture window,
                //    items/flickable.rs handle_mouse_filter) without visiting
                //    children, so nobody claimed the cursor and the pointer
                //    flipped arrow↔I-beam while the capture window opened and
                //    lapsed.  Without the Flickable, every wheel lands on
                //    body-touch-overlay below, which always claims I-beam.
                // 2. Scroll ownership: the captured wheel also scrolled
                //    content-y natively (flick physics included), fighting the
                //    Rust-managed view_offset and the `changed spans` snap-back.
                //    All scrolling already flows through terminal-scroll /
                //    terminal-scroll-to, so the Flickable only ever added drift.
                scroll-clip := Rectangle {
                    vertical-stretch: 1;
                    clip: true;
                    // (#bottom-dock-alpha) 终端文本区的底色（原 TerminalView 根底）。
                    background: Theme.term-bg;

                    // Content height of the grid viewport.  Alt-screen: lock to
                    // exactly the visible height so full-screen programs (nano/
                    // vim) render top-aligned with no internal scroll.  Bash:
                    // grow with the content so we can scroll back through history.
                    property <length> content-h: root.is-alt-screen
                        ? self.height
                        : max(self.height, 8px + root.rows-used * root.cell-h + 8px);
                    // Vertical placement of the content inside the clip: newest
                    // output pinned to the bottom edge (negative), alt-screen
                    // top-aligned (0).  Replaces the old imperative
                    // `flickable.content-y = height - content-height` sync —
                    // as a binding it can no longer drift between rebuilds.
                    property <length> view-y: root.is-alt-screen
                        ? 0px
                        : self.height - self.content-h;

                    // The terminal grid.  Each coloured run is placed with
                    // absolute coordinates derived from its (row, col) and the
                    // measured Consolas cell size — no per-line layout needed,
                    // which keeps the model flat (a single `for`).
                    Rectangle {
                        x: 10px;
                        y: 8px + parent.view-y;
                        width: parent.width - 20px;
                        height: parent.content-h - 8px;

                        // Click-to-focus over the whole terminal body.  Without
                        // this, clicking anywhere in the output area blurs the
                        // hidden ime-input (Slint clears focus on a click that
                        // lands on a non-focusable element), which makes the
                        // cursor vanish and keystrokes stop — recoverable only by
                        // reopening the tab.  This TouchArea sits *below* the text
                        // (Text never grabs pointer events, so clicks fall through
                        // to it) and restores focus on every click; middle-click
                        // also pastes, matching the bottom strip.
                        body-touch := TouchArea {
                            x: 0px;
                            y: 0px;
                            width: parent.width;
                            height: parent.height;
                            mouse-cursor: text;
                            pointer-event(ev) => {
                                if (ev.kind == PointerEventKind.down) {
                                    // Any button press re-takes keyboard focus.
                                    ime-input.focus();
                                    if (ev.button == PointerEventButton.right) {
                                        root.ctx-x = self.mouse-x;
                                        root.ctx-y = self.mouse-y;
                                        ctx-menu.show();
                                    } else if (ev.button == PointerEventButton.left
                                            && root.mouse-tracked && !ev.modifiers.shift) {
                                        root.terminal-mouse(0, 0,
                                            floor(self.mouse-y / root.cell-h),
                                            floor(self.mouse-x / root.cell-w));
                                    } else if (ev.button == PointerEventButton.left) {
                                        root.selecting = true;
                                        root.select-start(
                                            floor(self.mouse-y / root.cell-h),
                                            floor(self.mouse-x / root.cell-w),
                                            ev.modifiers.control,
                                            ev.modifiers.shift);
                                    }
                                } else if (ev.kind == PointerEventKind.up) {
                                    if (root.extra-paste-shortcuts-enabled && ev.button == PointerEventButton.middle) {
                                        root.paste-from-clipboard();
                                        ime-input.focus();
                                    } else if (ev.button == PointerEventButton.left
                                            && root.mouse-tracked && !ev.modifiers.shift) {
                                        root.terminal-mouse(1, 0,
                                            floor(self.mouse-y / root.cell-h),
                                            floor(self.mouse-x / root.cell-w));
                                    } else if (ev.button == PointerEventButton.left
                                            && root.selecting) {
                                        root.selecting = false;
                                        root.autoscroll-dir = 0;
                                        root.select-end();
                                    }
                                }
                            }
                            double-clicked => {
                                if (root.mouse-tracked) {
                                    // Mouse-tracking TUI: double-click = two forwarded
                                    // presses, not a local word-select (#terminal-mouse).
                                } else {
                                    root.select-word(
                                        floor(self.mouse-y / root.cell-h),
                                        floor(self.mouse-x / root.cell-w));
                                }
                            }
                            moved => {
                                if (root.selecting) {
                                    // Position of the cursor within the *visible*
                                    // viewport (body-touch sits on the grid Rectangle
                                    // at content y=8px; content-y offsets the scroll).
                                    root.select-update(
                                        floor(self.mouse-y / root.cell-h),
                                        floor(self.mouse-x / root.cell-w));
                                    if (!root.is-alt-screen) {
                                        // vy = mouse position inside the visible window.
                                        // Only auto-scroll once the drag actually leaves
                                        // the top/bottom edge — selecting *within* the
                                        // visible area must never make the view jump or
                                        // the selection snap to an edge row (#41). Slint
                                        // captures the pointer while pressed, so dragging
                                        // past the edge still scrolls to extend across
                                        // more than one screen.
                                        root.vis-y = self.mouse-y + 8px + scroll-clip.view-y;
                                        if (root.vis-y < 0) {
                                            root.autoscroll-dir = -1;       // past top → older
                                        } else if (root.vis-y > scroll-clip.height) {
                                            root.autoscroll-dir = 1;        // past bottom → newer
                                        } else {
                                            root.autoscroll-dir = 0;
                                        }
                                    }
                                } else if (root.mouse-tracked && self.pressed) {
                                    root.terminal-mouse(2, 0,
                                        floor(self.mouse-y / root.cell-h),
                                        floor(self.mouse-x / root.cell-w));
                                }
                            }
                            scroll-event(ev) => {
                                // Positive delta-y = wheel up.
                                if (root.is-alt-screen) {
                                    // Alt-screen app (tmux/less/vim): forward the wheel
                                    // so the program scrolls instead of nothing (#170).
                                    root.terminal-wheel(
                                        ev.delta-y > 0 ? 1 : -1,
                                        floor(self.mouse-x / root.cell-w),
                                        floor(self.mouse-y / root.cell-h));
                                } else {
                                    // Normal screen: scroll our own scrollback history
                                    // (~3 lines per notch).
                                    // Raw pixel delta → fractional lines. The
                                    // magnitude matters: macOS momentum events
                                    // decay to sub-pixel steps, and quantizing
                                    // each to a fixed ±3 lines turned the tail
                                    // into an exaggerated staircase with a hard
                                    // stop. Rust accumulates the fractions.
                                    root.terminal-scroll(ev.delta-y / root.cell-h);
                                }
                                accept
                            }
                        }

                        // Drag-selection highlights (under the text, blue tint).
                        for s in root.selection : Rectangle {
                            x: s.col * root.cell-w;
                            y: s.row * root.cell-h;
                            width: s.len * root.cell-w;
                            height: root.cell-h;
                            background: Theme.accent.with-alpha(0.40);
                        }

                        // Search-match highlights (behind the text).
                        for m in root.find-matches : Rectangle {
                            x: m.col * root.cell-w;
                            y: m.row * root.cell-h;
                            width: m.len * root.cell-w;
                            height: root.cell-h;
                            background: Theme.warning.with-alpha(0.45);
                            border-radius: 2px;
                        }

                        // Each span = a background fill (transparent for the
                        // default bg) with its text on top.  Wrapping the Text in
                        // the bg Rectangle keeps one element per span and renders
                        // btop/htop/mc panels, meter bars and graph fills.
                        for span in root.spans : Rectangle {
                            x: span.col * root.cell-w;
                            y: span.row * root.cell-h;
                            width: span.cells * root.cell-w;
                            height: root.cell-h;
                            background: span.bg;
                            // A wide-CJK span is a single char in a 2-cell box; clip
                            // it so a glyph whose advance differs from 2×cell-w can't
                            // bleed over the neighbouring cell / cursor (#60 follow-up).
                            clip: span.cjk;
                            // Auto-sized Text (no width/height bindings) so its
                            // layout never re-enters parley's FontContext.
                            // (#twemoji-removal) emoji 图像 span 已移除,统一文本渲染。
                            Text {
                                x: 0px;
                                // (#line-spacing-center) cell-h 随 terminal-line-spacing
                                // 缩放，但这个 Text 仍按字体自然行盒（cell-probe 的
                                // preferred-height，未乘 spacing）绘制。行距 <1 时文字
                                // 整体压在格子下半（基线几乎贴格底、降部越界到下一
                                // 行），画满整格的光标/选区视觉上就"浮"在文字上方；
                                // 行距 >1 时反向偏下。把自然行盒在格内垂直居中即可，
                                // 行距=1 时偏移恰为 0、行为不变。CJK span 的自然行盒
                                // 来自 UI 字体，与探针略有出入，但同一偏移方向正确。
                                // (#nerd-icon-scale) 图标 span 在本格内放大：Nerd Font
                                // 图标按 em 方框设计而格宽只有字号 ~0.6，名义字号下
                                // 墨高比小写 x-height 还矮。放大后 Text 的自然行盒 ≈
                                // nerd-scale × 探针行盒（同字体等比），同样按
                                // (cell-h − scale×行盒)/2 在格内居中 —— 旧实现的居中
                                // 分支 `cell-h > glyph-h` 在默认字号下永不成立（恒
                                // y=0），基线被 1.02×放大字号 推到格外，图标沉到
                                // 下一行。纵向仍用 `y` 偏移而不是 `height` +
                                // `vertical-alignment`：后者要给 Text 设 height，与
                                // 「不设 height 以免重入 FontContext」冲突。
                                // (#ink-center) 与文字共用同一 ink-bias，图标字面底线
                                // 才能和文字齐平。
                                y: span.nerd
                                    ? (root.cell-h - cell-probe.preferred-height * root.nerd-scale) / 2
                                        + root.ink-bias
                                    : root.text-y-shift;
                                text: span.text;
                                color: span.fg;
                                // CJK spans use the CJK-capable UI font: the mono
                                // terminal font lacks CJK glyphs and Slint tofu's
                                // *isolated* CJK punctuation (、。,) on fallback (#54).
                                font-family: span.cjk ? Theme.ui-font-family : Theme.term-font-family;
                                // 图标放大不改变字体度量（cell-w/h 仍来自 cell-probe），
                                // 所以 PTY 列数/行数不会因放大而重排。
                                font-size: (span.nerd ? root.term-font-size-px * root.nerd-scale : root.term-font-size-px) * 1px;
                                font-weight: (Theme.term-font-bold || span.bold) ? Theme.fw-strong : Theme.fw-regular;
                            }
                        }

                        // Blinking cursor (overlay, decoupled from text). Its
                        // shape follows the persisted user preference (#275).
                        Rectangle {
                            // The VT cursor already names the active grid cell.
                            // A bar belongs on that cell's leading edge too;
                            // shifting it one column in alternate-screen apps put
                            // it after ASCII glyphs and inside wide CJK cells (#319).
                            x: root.cursor-col * root.cell-w;
                            y: root.cursor-row * root.cell-h
                                + (root.cursor-style == "underline" ? max(0px, root.cell-h - max(2px, root.cell-h / 8)) : 0px);
                            width: root.cursor-style == "bar" ? max(2px, root.cell-w / 8) : root.cell-w;
                            height: root.cursor-style == "underline" ? max(2px, root.cell-h / 8) : root.cell-h;
                            background: root.cursor-color;
                            // Blink while focused; show solid (no repaint) when the
                            // window is unfocused so the cursor neither vanishes nor
                            // keeps the window repainting (#127).
                            //
                            // Also require an actual live cursor (cursor-row >= 0):
                            // scrolled-back renders report -1 ("no live cursor").
                            // Block/bar styles then sit a full cell above the grid,
                            // where scroll-clip's clip hides them — but the
                            // UNDERLINE style offsets its dash to the bottom of
                            // that row, which lands back INSIDE the clip as a
                            // blinking horizontal dash at column 0 of the first
                            // row. Gate on the row instead of trusting clipping.
                            visible: root.cursor-row >= 0
                                && ime-input.has-focus
                                && (key-capture.cursor-blink || !Theme.window-focused);
                        }

                        // Top-most transparent interaction layer. On macOS,
                        // scroll events over rendered terminal text may not reach
                        // the older body TouchArea below the spans, so keep the
                        // terminal's click/select/wheel handling above all text
                        // while leaving the visual output untouched (#198).
                        body-touch-overlay := TouchArea {
                            x: 0px;
                            y: 0px;
                            width: parent.width;
                            height: parent.height;
                            mouse-cursor: text;
                            pointer-event(ev) => {
                                if (ev.kind == PointerEventKind.down) {
                                    ime-input.focus();
                                    if (ev.button == PointerEventButton.right) {
                                        root.ctx-x = self.mouse-x;
                                        root.ctx-y = self.mouse-y;
                                        ctx-menu.show();
                                    } else if (ev.button == PointerEventButton.left
                                            && root.mouse-tracked && !ev.modifiers.shift) {
                                        // Mouse-tracking TUI (btop/htop/mc): forward the
                                        // press so the remote acts on it (#terminal-mouse).
                                        // Shift+click still selects locally (xterm-style).
                                        root.terminal-mouse(0, 0,
                                            floor(self.mouse-y / root.cell-h),
                                            floor(self.mouse-x / root.cell-w));
                                    } else if (ev.button == PointerEventButton.left) {
                                        root.selecting = true;
                                        root.select-start(
                                            floor(self.mouse-y / root.cell-h),
                                            floor(self.mouse-x / root.cell-w),
                                            ev.modifiers.control,
                                            ev.modifiers.shift);
                                    }
                                } else if (ev.kind == PointerEventKind.up) {
                                    if (root.extra-paste-shortcuts-enabled && ev.button == PointerEventButton.middle) {
                                        root.paste-from-clipboard();
                                        ime-input.focus();
                                    } else if (ev.button == PointerEventButton.left
                                            && root.mouse-tracked && !ev.modifiers.shift) {
                                        root.terminal-mouse(1, 0,
                                            floor(self.mouse-y / root.cell-h),
                                            floor(self.mouse-x / root.cell-w));
                                    } else if (ev.button == PointerEventButton.left
                                            && root.selecting) {
                                        root.selecting = false;
                                        root.autoscroll-dir = 0;
                                        root.select-end();
                                    }
                                }
                            }
                            double-clicked => {
                                if (root.mouse-tracked) {
                                    // Mouse-tracking TUI: double-click = two forwarded
                                    // presses, not a local word-select (#terminal-mouse).
                                } else {
                                    root.select-word(
                                        floor(self.mouse-y / root.cell-h),
                                        floor(self.mouse-x / root.cell-w));
                                }
                            }
                            moved => {
                                if (root.selecting) {
                                    root.select-update(
                                        floor(self.mouse-y / root.cell-h),
                                        floor(self.mouse-x / root.cell-w));
                                    if (!root.is-alt-screen) {
                                        root.vis-y = self.mouse-y + 8px + scroll-clip.view-y;
                                        if (root.vis-y < 0) {
                                            root.autoscroll-dir = -1;
                                        } else if (root.vis-y > scroll-clip.height) {
                                            root.autoscroll-dir = 1;
                                        } else {
                                            root.autoscroll-dir = 0;
                                        }
                                    }
                                } else if (root.mouse-tracked && self.pressed) {
                                    // Drag-motion while a button is held → forward to the
                                    // remote so btop/htop graphs/hover regions track it.
                                    root.terminal-mouse(2, 0,
                                        floor(self.mouse-y / root.cell-h),
                                        floor(self.mouse-x / root.cell-w));
                                }
                            }
                            scroll-event(ev) => {
                                if (root.is-alt-screen) {
                                    root.terminal-wheel(
                                        ev.delta-y > 0 ? 1 : -1,
                                        floor(self.mouse-x / root.cell-w),
                                        floor(self.mouse-y / root.cell-h));
                                } else {
                                    // Raw pixel delta → fractional lines. The
                                    // magnitude matters: macOS momentum events
                                    // decay to sub-pixel steps, and quantizing
                                    // each to a fixed ±3 lines turned the tail
                                    // into an exaggerated staircase with a hard
                                    // stop. Rust accumulates the fractions.
                                    root.terminal-scroll(ev.delta-y / root.cell-h);
                                }
                                accept
                            }
                        }

                        // --- Right-click context menu ---------------------
                        ctx-menu := PopupWindow {
                            x: root.ctx-x;
                            y: root.ctx-y;
                            width: 132px;
                            height: 132px;
                            Rectangle {
                                background: Theme.popup-bg;
                                border-radius: Theme.radius-sm;
                                border-width: 1px;
                                border-color: Theme.border-strong;
                                drop-shadow-blur: 12px;
                                drop-shadow-color: transparent;
                                VerticalLayout {
                                    padding: 4px;
                                    spacing: 1px;
                                    MenuItem {
                                        icon: "copy"; label: @tr("Copy");
                                        clicked => { root.copy-terminal-text(); ime-input.focus(); }
                                    }
                                    MenuItem {
                                        icon: "paste"; label: @tr("Paste");
                                        clicked => { root.paste-from-clipboard(); ime-input.focus(); }
                                    }
                                    MenuItem {
                                        icon: "delete"; label: @tr("Clear buffer");
                                        clicked => { root.clear-terminal(); ime-input.focus(); }
                                    }
                                    MenuItem {
                                        icon: "search"; label: @tr("Find");
                                        clicked => { root.find-active = true; }
                                    }
                                }
                            }
                        }
                    }
                }

            }

            // --- Hidden TextInput — keyboard + Chinese IME capture -----------
            //
            // Key design decision: return `accept` for EVERY key and forward
            // them all via send-key.  Returning `reject` makes Slint bubble the
            // event without inserting the character into `text`, so `edited`
            // never fires for regular keystrokes — only IME-committed chars
            // (which go through a separate WM_IME_CHAR path) reach `edited`.
            //
            // By forwarding everything in key-pressed we guarantee English and
            // all direct-mode input reaches the PTY.  `edited` is kept as a
            // safety net for IME commits that Windows delivers via WM_IME_CHAR
            // rather than WM_CHAR (and therefore don't fire key-pressed).
            ime-input := TextInput {
                // Absolute 1x1 IME anchor: it captures keyboard/IME input without
                // participating in layout or exposing a second I-beam hit area.
                // Following the VT cursor also places native IME candidate UI near
                // the actual insertion point.
                // While scrolled back through history the live cursor is hidden
                // (cursor-row < 0): park the anchor far off-window then, never
                // clamp it with max(0, …). Clamping pinned this focused TextInput
                // onto the terminal's top-left cell, and since a hovered TextInput
                // forces the I-beam pointer (i-slint-core items/text.rs), wheel-
                // scrolling flickered the mouse cursor between arrow and text as
                // frames re-hit-tested under it. The park offset must dwarf any
                // parent origin: key-capture sits ~24-48px from the window top, so
                // a small offset like -32px still landed on the visible terminal's
                // top-left corner.
                x: root.cursor-row >= 0
                    ? 10px + max(0, root.cursor-col) * root.cell-w
                    : -1000px;
                y: root.cursor-row >= 0
                    ? 8px + root.cursor-row * root.cell-h
                    : -1000px;
                width: 1px;
                height: 1px;
                opacity: 0;
                // Opacity does not suppress Slint's focused TextInput caret on
                // every renderer. This input exists only as a keyboard/IME
                // anchor; the terminal cursor above is the sole visible caret.
                text-cursor-width: 0px;
                single-line: true;

                // Reset blink phase on focus gain so cursor appears immediately.
                changed has-focus => {
                    if (self.has-focus) { key-capture.cursor-blink = true; }
                }

                key-pressed(event) => {
                    // Keep the caret visible while typing or moving it. Without
                    // this reset an old blink phase can hide the cursor halfway
                    // through a repeated arrow-key sequence (#319).
                    key-capture.cursor-blink = true;
                    root.diagnose-key-event(event.text,
                        event.modifiers.control, event.modifiers.meta,
                        event.modifiers.alt, event.modifiers.shift);
                    // ⚠ macOS modifier naming is SWAPPED by Slint (see the winit
                    // backend's muda.rs): `event.modifiers.control` is the **Cmd (⌘)**
                    // key and `event.modifiers.meta` is the **physical Ctrl** key.
                    // So `control` already gives ⌘ shortcuts on macOS for free, and
                    // the physical Ctrl (meta on macOS) is what must reach the shell
                    // so ^C/^X work in nano/vim (#158).
                    // ── Cycle tabs: Ctrl+Tab / Ctrl+Shift+Tab (#294) ──
                    // On macOS Slint reports the physical Ctrl key as `meta`.
                    if ((Theme.is-mac ? event.modifiers.meta : event.modifiers.control)
                            && (event.text == Key.Tab || event.text == Key.Backtab)) {
                        root.cycle-tab(event.modifiers.shift || event.text == Key.Backtab);
                        accept
                    // ── Find: ⌘F / Ctrl+F (mirrors right-click → Find) ──
                    } else if (event.modifiers.control && !event.modifiers.shift
                            && (event.text == "f" || event.text == "F"
                                || event.text == "\u{0006}")) {
                        root.find-active = true;
                        accept
                    // ── Jump to command-history search: ⌘⇧R / Ctrl+Shift+R (#140) ──
                    } else if (event.modifiers.control && event.modifiers.shift
                            && (event.text == "r" || event.text == "R"
                                || event.text == "\u{0012}")) {
                        root.open_history_panel();
                        accept
                    // ── New window: ⌘⇧N / Ctrl+Shift+N (#multi-window) ──
                    // `control` is Cmd on macOS (Slint modifier swap, #158), so
                    // this single condition gives ⌘⇧N there and Ctrl+Shift+N
                    // elsewhere. Intercepted here — before send-key — so the
                    // keystroke never reaches the remote shell.
                    } else if (event.modifiers.control && event.modifiers.shift
                            && (event.text == "n" || event.text == "N"
                                || event.text == "\u{000e}")) {
                        root.new-window-key();
                        accept
                    // ── Zen (focus) mode: Ctrl+Alt+Z toggles (#zen). Hidden
                    // views reject it so the window-level fallback handles it.
                    } else if (root.visible && event.modifiers.control && event.modifiers.alt
                            && (event.text == "z" || event.text == "Z"
                                || event.text == "\u{001a}")) {
                        root.zen-key();
                        accept
                    // ── Font zoom: Ctrl+= / Ctrl+- / Ctrl+0 (⌘ on macOS) ──
                    // Zooms this session only; adding Alt zooms every session
                    // in the window. Alt (not Shift) because Ctrl+Shift is the
                    // IME-switch hotkey on Chinese Windows and gets swallowed.
                    // A hidden (inactive tab) view that still holds focus
                    // rejects these so the window-level fallback zooms the
                    // visible session (#zoom).
                    } else if (root.visible && event.modifiers.control && event.modifiers.alt
                            && (event.text == "=" || event.text == "+"
                                || event.text == "-" || event.text == "\u{001f}"
                                || event.text == "0")) {
                        root.zoom-key(event.text == "-" || event.text == "\u{001f}" ? -1
                            : event.text == "0" ? 0 : 1, true);
                        accept
                    } else if (root.visible && event.modifiers.control
                            && (event.text == "=" || event.text == "+")) {
                        root.zoom-key(1, false);
                        accept
                    } else if (root.visible && event.modifiers.control
                            && (event.text == "-" || event.text == "\u{001f}")) {
                        root.zoom-key(-1, false);
                        accept
                    } else if (root.visible && event.modifiers.control && event.text == "0") {
                        root.zoom-key(0, false);
                        accept
                    // ── Copy: ⌘C (macOS, no Shift) / Ctrl+Shift+C ──
                    } else if (event.modifiers.control
                            && (!event.modifiers.alt || root.extra-paste-shortcuts-enabled)
                            && (Theme.is-mac ? !event.modifiers.shift : event.modifiers.shift)
                            && (event.text == "c" || event.text == "C"
                                || event.text == "\u{0003}")) {
                        root.copy-terminal-text();
                        accept
                    // ── Paste: ⌘V / Ctrl+V (Ctrl+Shift+V also accepted) ──
                    } else if (event.modifiers.control
                            && (event.text == "v" || event.text == "V"
                                || event.text == "\u{0016}")) {
                        root.paste-from-clipboard();
                        // Clipboard access on Windows can deliver WM_KILLFOCUS.
                        // Restore focus explicitly so the cursor keeps blinking.
                        ime-input.focus();
                        accept
                    // ── Paste: Shift+Insert (the X11 / xterm paste convention) (#144) ──
                    } else if (root.extra-paste-shortcuts-enabled
                            && event.modifiers.shift && event.text == Key.Insert) {
                        root.paste-from-clipboard();
                        ime-input.focus();
                        accept
                    // ── macOS: swallow any other ⌘ combo (control == Cmd here) so it
                    // isn't typed into the shell as a literal character. ──
                    } else if (Theme.is-mac && event.modifiers.control) {
                        accept
                    // ── All other keys (printable, Ctrl+X, arrows, …) → the shell.
                    // The control flag is the *physical* Ctrl key: `meta` on macOS,
                    // `control` elsewhere, so ^X/^C reach the PTY everywhere (#158).
                    // Return `accept` for everything: `reject` would drop the char.
                    } else {
                        root.send-key(event.text,
                                      Theme.is-mac ? event.modifiers.meta : event.modifiers.control,
                                      event.modifiers.alt, event.modifiers.shift);
                        accept
                    }
                }

                // Safety-net for IME commits delivered via WM_IME_CHAR (which
                // may not fire key-pressed).  Guard with preedit-text == "" to
                // skip in-progress compositions.
                edited => {
                    if (self.preedit-text == "" && self.text != "") {
                        root.send-key(self.text, false, false, false);
                        self.text = "";
                    }
                }
            }

            // --- Find bar (overlay, top) ------------------------------------
            // Terminal scrollbar (#103) — a slim overlay on the right edge of the
            // output area, shown only when there's scrollback (and not on the
            // alternate screen). Driven by scroll-max/scroll-offset; click or drag
            // the track to jump to an absolute position.
            if root.scroll-max > 0 && !root.is-alt-screen : Rectangle {
                x: scroll-clip.x + scroll-clip.width - 10px;
                y: scroll-clip.y + 4px;
                width: 8px;
                height: scroll-clip.height - 8px;
                track-ta := TouchArea {
                    moved => {
                        if (self.pressed) {
                            root.terminal-scroll-to(clamp(round(root.scroll-max * (1 - self.mouse-y / self.height)), 0, root.scroll-max));
                        }
                    }
                    pointer-event(e) => {
                        if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                            root.terminal-scroll-to(clamp(round(root.scroll-max * (1 - self.mouse-y / self.height)), 0, root.scroll-max));
                        }
                    }
                }
                Rectangle {
                    property <float> total: root.scroll-max + root.term-rows;
                    x: 1px;
                    width: 6px;
                    height: max(28px, parent.height * root.term-rows / total);
                    y: (parent.height - self.height) * (root.scroll-max - root.scroll-offset) / max(1, root.scroll-max);
                    background: track-ta.has-hover || track-ta.pressed
                        ? Theme.text-secondary : Theme.border-strong;
                    border-radius: 3px;
                    animate background { duration: 100ms; }
                }
            }

            if root.find-active : Rectangle {
                x: 0;
                y: 0;
                width: parent.width;
                height: 34px;
                background: Theme.popup-bg;
                border-width: 1px;
                border-color: Theme.border-strong;
                border-radius: Theme.radius-sm;

                // Let the popup click and the conditional component's first
                // layout pass finish before asking the platform for focus.
                find-focus-timer := Timer {
                    interval: 0ms;
                    running: root.find-focus-pending;
                    triggered => {
                        root.find-focus-pending = false;
                        if (root.find-active) { find-input.focus(); }
                    }
                }

                HorizontalLayout {
                    padding: 6px;
                    spacing: 6px;
                    Icon {
    glyph: "search";
    tint: Theme.text-primary;
    size: Theme.fs-sm;
}
                    Rectangle {
                        background: Theme.bg-root;
                        border-radius: 3px;
                        horizontal-stretch: 1;
                        find-input := TextInput {
                            x: 6px;
                            width: parent.width - 12px;
                            height: parent.height;
                            color: Theme.text-primary;
                            font-family: Theme.ui-font-family; // CJK-capable (#54)
                            font-size: Theme.fs-md;
                            vertical-alignment: center;
                            single-line: true;
                            // Defer focus until popup event dispatch and layout
                            // have completed; synchronous focus crashes on
                            // Windows when opened from right-click (#343).
                            init => { root.find-focus-pending = true; }
                            edited => { root.find-query-changed(self.text); }
                            key-pressed(e) => {
                                if (e.text == "\u{001b}") {       // Esc closes find
                                    root.find-active = false;
                                    root.find-query-changed("");
                                    self.text = "";
                                    ime-input.focus();
                                    accept
                                } else {
                                    reject
                                }
                            }
                        }
                    }
                    Rectangle {
                        width: 24px;
                        // (#find-clear-accent 2026-10-21) 裸图标提亮 → 与侧栏搜索清空
                        // 同语言（accent 实心圆 + 底色 × 镂空），16px 紧凑档：查找栏
                        // 内高 22px（34 − 2×6 padding），语义同为「清空输入」。
                        // 命中区维持 24px 槽位。
                        background: transparent;
                        close-ta := TouchArea {
                            mouse-cursor: default;
                            clicked => {
                                root.find-active = false;
                                root.find-query-changed("");
                                find-input.text = "";
                                ime-input.focus();
                            }
                        }
                        Rectangle {
                            width: 16px; height: 16px;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                            border-radius: parent.width / 2;
                            background: close-ta.has-hover ? Theme.accent : transparent;
                            animate background { duration: 100ms; }
                            accessible-role: button;
                            accessible-label: @tr("Clear search");
                            Icon {
                                glyph: "close";
                                tint: close-ta.has-hover ? Theme.popup-bg : Theme.text-secondary;
                                size: Theme.fs-xs;
                            }
                        }
                    }
                }
            }
        }

        // --- Command bar (#55): quick commands + input box + history ---------
        cmd-bar := Rectangle {
            visible: !root.cmd-bar-hidden;
            // (#cmdbar-hifi 2026-10-23) 34 → 48：输入框 34 + 上下 7 的呼吸。
            // 高保真 .cmdbar 就是这个口径；旧 34 高时输入框只有 26，内嵌图标钮
            // （⚡/🕘 26px）会顶到边框上。
            height: root.cmd-bar-hidden ? 0px : 48px;
            // (#sidebar-bottom-panel) 命令栏 = 下方面板：跟「侧栏」透明度。
            background: Theme.zone-sidebar-alt;
            // (#cmdbar-frame 2026-10-23) 上下各一条 1px 分隔线（高保真
            // `.dock .cmdwrap{ border-top/bottom:1px solid var(--line) }`）。
            // 没有它，命令栏的 `zone-sidebar-alt` 底色和终端底色只差几个灰阶，
            // 上沿完全看不出边界（用户截图：「这个地方是少线框吧」）。
            // 用 zone-sidebar-line（跟面板同一档 alpha），别用实色 border-strong
            // —— 半透明面板上实线会把命令栏「焊」成一块实心方块。
            // (#cmdbar-frame-phx 2026-10-23) 用两条 1phx 的 Rectangle 画上下线，
            // 而不是 border：
            //   ① border 四边都画，命令栏贴着 pane 边缘，左右两条竖线是多余的；
            //   ② 1phx 恒落一个设备像素，125%/150% 下不会「上面 1px、下面 2px」。
            Rectangle {
                y: 0;
                width: parent.width;
                height: 1phx;
                background: Theme.zone-sidebar-line;
            }
            Rectangle {
                y: parent.height - 1phx;
                width: parent.width;
                height: 1phx;
                background: Theme.zone-sidebar-line;
            }

            // Outside-click backdrop: covers the terminal above so clicking
            // anywhere out of an open popup dismisses it.
            if root.quick-open || root.hist-popup-visible || root.scope-open : TouchArea {
                x: 0; y: -2000px; width: parent.width; height: 2000px;
                clicked => {
                    root.quick-open = false;
                    root.history-open = false;
                    root.scope-open = false;
                }
            }

            HorizontalLayout {
                padding-left: 10px; padding-right: 10px;
                padding-top: 7px; padding-bottom: 7px;
                spacing: 10px;

                // (#cmdbar-hifi 2026-10-23) 左端「快捷 ▴」胶囊已删：它占着视线
                // 起点却是低频动作，窗口变窄时第一个被挤掉、输入框起点还跟着
                // 跳。快捷命令与历史并到输入框右端（见下方 in-btn），输入框
                // 从最左开始。
                // 停靠侧栏时快捷命令的入口仍是侧栏/图标条，不受影响（#215）。

                // Command input.
                // (#cmdbar-focus-2026-10-19) 聚焦态与「新建会话」对话框的输入框
                // 同一套语言:1px accent 边 + 3px accent-soft 柔光环。
                // 外层**不裁**：聚焦光晕要画到框外 3px，而内层 `clip: true`(多行输入
                // 滚动必须裁) 会把子项裁掉。光晕写法与 session_dialog 的 MiniInput 逐值一致
                // (x/y -3、+6、圆角 +2、3px accent-soft)，即「新建会话」输入框同款。
                // (#cmdbar-hifi 2026-10-23) 吸空块**不放在这里**：输入框
                // stretch 1 与吸空块 stretch 1 会平分剩余宽，实测输入框只拿到
                // 一半（253px），连一条 60 字符的命令都展不开。按高保真 .cmdbar
                // 的真实语义：输入框 grow 到上限宽即止，范围键/发送键紧跟其后，
                // 余量留在行末（flex 无 grow 项时的自然结果）。
                Rectangle {
                    horizontal-stretch: 1;
                    min-width: 220px;
                    // 试了 max-width 620：Slint 下 stretch 项一旦设了 max-width，
                    // 它就只拿 min-width（实测输入框塌到 220，scope/发送被推到
                    // 右边），所以上限宽度这一档暂时不设 —— 输入框吃满可用宽，
                    // 与高保真「grow 到上限」的差别只在超宽窗口。
                    if cmd-input.has-focus : Rectangle {
                        x: -3px;
                        y: -3px;
                        width: parent.width + 6px;
                        height: parent.height + 6px;
                        border-radius: Theme.radius-sm + 2px;
                        border-width: 3px;
                        border-color: Theme.accent-soft;
                    }
                    cmd-box := Rectangle {
                        width: parent.width; height: parent.height;
                        border-radius: Theme.radius-sm;
                        border-width: 1px;
                        // (#sidebar-alpha-follow 2026-10-20) 边框也跟侧栏 alpha，
                        // 与 sftp 路径框同一档 —— 实色 1px 边框在透明面板上会
                        // 把输入框「焊」成一块实心方块。
                        border-color: cmd-input.has-focus ? Theme.zone-sidebar-accent : Theme.zone-sidebar-line;
                        animate border-color { duration: 120ms; }
                        // (#sidebar-alpha-follow 2026-10-20) 输入框内衬跟侧栏 alpha
                        // （原 bg-root 在无壁纸时是实色，会把半透明命令栏打出一个洞）。
                        background: Theme.zone-sidebar-root;
                        // (#cmd-prompt 2026-09-04) "$" 提示符前缀:等宽字体 + accent
                        // 色,一眼可辨"这是发给 shell 的命令";输入区(上游多行滚动
                        // 结构)右移让位。
                        Text {
                            x: 10px;
                            width: 12px;
                            height: parent.height;
                            text: "$";
                            font-family: Theme.font-mono;
                            // (#cmdbar-danger) 命中危险模式时提示符跟着变红（高保真屏 07）
                            color: root.danger-now != "" ? Theme.danger-strong : Theme.accent;
                            font-size: Theme.fs-md;
                            vertical-alignment: center;
                            horizontal-alignment: center;
                        }
                        clip: true;
                        TouchArea {
                            scroll-event(event) => {
                                command-scroll.content-y = clamp(
                                    command-scroll.content-y + event.delta-y,
                                    min(0px, command-scroll.visible-height - command-scroll.content-height), 0px);
                                accept
                            }
                        }
                        // (#cmdbar-hifi 2026-10-23) 输入区右端让出内嵌按钮位
                        // （⚡ 26 + 2 + 🕘 26 + 右内距 6 = 60，再留 4 的字距）。
                        command-scroll := ScrollView {
                            x: 26px;
                            // (#cmdbar-clear) 右端现在是 ⚡ 🕘 │ ↗ × 五个钮，让位 124。
                            width: parent.width - 26px - 98px;
                            content-width: self.visible-width;
                            content-height: max(self.visible-height, cmd-input.preferred-height);
                            cmd-input := TextInput {
                                x: 2px;
                                width: max(1px, command-scroll.visible-width - 4px);
                                y: 0px;
                                height: max(command-scroll.visible-height, self.preferred-height);
                                color: root.danger-now != "" ? Theme.danger-strong : Theme.text-primary;
                                font-family: Theme.ui-font-family;
                                font-size: Theme.fs-md;
                                vertical-alignment: center;
                                wrap: char-wrap;
                                page-height: command-scroll.visible-height;
                                cursor-position-changed(position) => {
                                    // (#cmdbar-caret-anchor 2026-10-23) 历史浮层跟着
                                    // 光标走横向位置，先记下（见 cmd-caret-x 注释）。
                                    root.cmd-caret-x = position.x;
                                    let cursor-y = position.y + command-scroll.content-y;
                                    if (cursor-y < 0px) {
                                        command-scroll.content-y = min(0px, command-scroll.content-y - cursor-y);
                                    } else if (cursor-y > command-scroll.visible-height - self.font-size) {
                                        command-scroll.content-y = max(
                                            min(0px, command-scroll.visible-height - command-scroll.content-height),
                                            command-scroll.content-y - (cursor-y - command-scroll.visible-height + self.font-size));
                                    }
                                }
                                // Preserve pasted newlines. A single-line input rewrites
                                // them as spaces and corrupts heredoc terminators before
                                // run-command receives the text (#319).
                                single-line: false;
                                // Enter sends; ↑/↓ recall history.
                                accepted => {
                                    root.run-command(self.text, root.scope-spec());
                                    self.text = "";
                                    root.history-open = false;
                                    root.history-cursor = -1;
                                    root.focus-pending = true;
                                }
                                edited => {
                                    root.history-cursor = -1;
                                    root.quick-open = false;
                                    root.history-autocomplete = self.text != "";
                                    root.search-history(self.text);
                                    // (#cmd-hint 2026-10-27) 四段式提示框的数据**由
                                    // Rust 侧按整行重算**（阶段判定、子命令表、危险
                                    // 命令都在那边，Slint 拿不到那些表）。这是同步
                                    // 回调：返回时 hint-* 已是这次输入的结果。
                                    root.hint-query(self.text);
                                    // (#cmdbar-suggest-empty 2026-10-24 / #cmd-hint)
                                    // 一条都没匹上就别把框亮出来 —— 只有「无匹配」
                                    // 三个字的空壳挡终端又没有信息量。危险命令例外：
                                    // 它的告警本身是必须传达的信息，所以即使 0 候选
                                    // 也要把框亮出来（高保真 §3 ③）。
                                    root.history-open = root.history-autocomplete
                                        && (root.hint-rows.length > 0
                                            || root.danger-now != "");
                                    // 选中项默认停在第一条（最相关），不是最后一条：
                                    // 四段式列表是「按相关度排好」的，第一条就是最佳。
                                    root.history-selected = 0;
                                }
                                key-pressed(e) => {
                                    if (e.text == Key.Return && !e.modifiers.shift) {
                                        // (#cmd-hint 2026-10-27) Enter 的两段式：
                                        // 行尾不是空格 = 这个词还在补 → 先填入；
                                        // 行尾是空格 = 已落定 → 执行。
                                        // 判据见 hint-enter-runs() 的注释（拿单词比
                                        // 整行会导致「永远只填入、永远不执行」）。
                                        if (root.hist-popup-visible
                                                && root.history-autocomplete
                                                && root.hint-count() > 0
                                                && !root.hint-enter-runs()) {
                                            root.hint-accept();
                                            root.focus-pending = true;
                                            accept
                                        }
                                        root.run-command(self.text, root.scope-spec());
                                        self.text = "";
                                        root.history-open = false;
                                        root.history-cursor = -1;
                                        root.focus-pending = true;
                                        accept
                                    // ⌘R / Ctrl+R opens the searchable history dropdown and
                                    // focuses its search box — full keyboard history recall
                                    // (#140). Esc closes it / returns to terminal. (The
                                    // Ctrl+E/K/U line-editing below stays on Ctrl — those
                                    // are the standard readline bindings on macOS too.)
                                    } else if ((Theme.is-mac ? e.modifiers.meta : e.modifiers.control)
                                            && (e.text == Key.Tab || e.text == Key.Backtab)) {
                                        root.cycle-tab(e.modifiers.shift || e.text == Key.Backtab);
                                        accept
                                    } else if ((Theme.is-mac ? e.modifiers.meta : e.modifiers.control)
                                            && (e.text == "r" || e.text == "R" || e.text == "\u{0012}")) {
                                        // (#cmdbar-suggest 2026-10-24) 与点 🕘 同一条路径：
                                        // 补全态下 Ctrl+R 要把过滤清掉、列全量历史。
                                        root.open_history_panel();
                                        accept
                                    } else if (e.text == Key.Escape) {
                                        // 用「浮层真的画着」判断，而不是 history-open：
                                        // 补全到 0 条时状态还是 true 但框已经不画了，
                                        // 按第一次 Esc 不该白吃掉一次。
                                        if (root.hist-popup-visible) { root.history-open = false; }
                                        else { ime-input.focus(); }   // back to the terminal
                                        accept
                                    } else if (e.text == Key.UpArrow) {
                                        // (#cmd-hint) 提示框打开时 ↑↓ 在**可见行**里循环；
                                        // 在首项再按 ↑ 就穿透回 shell 历史（高保真 §5）。
                                        if (root.history-autocomplete && root.hint-count() > 0) {
                                            if (root.history-selected <= 0) {
                                                // 穿透：收起提示框，改走历史回溯。
                                                root.history-open = false;
                                                if (root.command-history.length > 0) {
                                                    root.history-cursor = root.command-history.length - 1;
                                                    self.text = root.command-history[root.history-cursor];
                                                }
                                            } else {
                                                root.history-selected -= 1;
                                            }
                                        } else if (root.history-autocomplete && root.suggest_count() > 0) {
                                            root.history-selected = root.history-selected <= 0
                                                ? root.suggest_count() - 1
                                                : root.history-selected - 1;
                                        } else {
                                            // Model is oldest→newest (#113): first ↑ jumps
                                            // to newest, then steps toward older entries.
                                            if (root.command-history.length > 0) {
                                                root.history-cursor = root.history-cursor == -1
                                                    ? root.command-history.length - 1
                                                    : max(root.history-cursor - 1, 0);
                                                self.text = root.command-history[root.history-cursor];
                                            }
                                        }
                                        accept
                                    } else if (e.text == Key.DownArrow) {
                                        if (root.history-autocomplete && root.hint-count() > 0) {
                                            root.history-selected = root.history-selected >= root.hint-count() - 1
                                                ? 0 : root.history-selected + 1;
                                        } else if (root.history-autocomplete && root.suggest_count() > 0) {
                                            root.history-selected = root.history-selected >= root.suggest_count() - 1
                                                ? 0 : root.history-selected + 1;
                                        } else {
                                            // ↓ steps toward newer; past newest → live input.
                                            if (root.history-cursor != -1) {
                                                if (root.history-cursor < root.command-history.length - 1) {
                                                    root.history-cursor += 1;
                                                    self.text = root.command-history[root.history-cursor];
                                                } else {
                                                    root.history-cursor = -1;
                                                    self.text = "";
                                                }
                                            }
                                        }
                                        accept
                                    } else if (e.text == Key.Tab && root.history-autocomplete) {
                                        // (#cmd-hint) Tab 只在**有可见候选**时接管；
                                        // 0 候选时放行给 shell 的原生补全（高保真 §5）。
                                        // 填入后**保持提示框打开**，继续补下一个词。
                                        if (root.hint-count() > 0) {
                                            root.hint-accept();
                                        }
                                        accept
                                    // --- readline line-editing keys (#103) ---
                                    // Ctrl+A / Cmd+A selects all text in this GUI input.
                                    } else if (e.modifiers.control && (e.text =="a" || e.text == "A" || e.text == "\u{0001}")) {
                                        self.select-all();
                                        accept
                                    // Ctrl+Shift+E → 弹出编辑（#cmdbar-expand 2026-10-23，
                                    // 高保真屏 06）。必须排在 Ctrl+E 之前判：带 shift
                                    // 时 e.text 仍是 "e"，否则永远被"行尾"分支吃掉。
                                    } else if ((Theme.is-mac ? e.modifiers.meta : e.modifiers.control)
                                            && e.modifiers.shift
                                            && (e.text == "e" || e.text == "E" || e.text == "\u{0005}")) {
                                        root.open-send-window(cmd-input.text);
                                        accept
                                    // Ctrl+E → end of line.
                                    } else if ((Theme.is-mac ? e.modifiers.meta : e.modifiers.control) && (e.text =="e" || e.text == "E" || e.text == "\u{0005}")) {
                                        self.set-selection-offsets(1000000, 1000000);
                                        accept
                                    // Ctrl+K → kill from cursor to end (deletes + clipboard).
                                    } else if ((Theme.is-mac ? e.modifiers.meta : e.modifiers.control) && (e.text =="k" || e.text == "K" || e.text == "\u{000B}")) {
                                        self.set-selection-offsets(self.cursor-position_byte-offset, 1000000);
                                        self.cut();
                                        accept
                                    // Ctrl+U → kill from start to cursor.
                                    } else if ((Theme.is-mac ? e.modifiers.meta : e.modifiers.control) && (e.text =="u" || e.text == "U" || e.text == "\u{0015}")) {
                                        self.set-selection-offsets(0, self.cursor-position_byte-offset);
                                        self.cut();
                                        accept
                                    } else {
                                        reject
                                    }
                                }
                            }
                        }
                        // (#cmdbar-focus-2026-10-19) 聚焦即隐藏提示语:与对话框的
                        // "Hide on focus" 一致 —— 占位文字不再和光标/IME 预编辑叠在
                        // 一起(用户反馈聚焦后里面还留着「输入命令，回车发送」)。
                        if cmd-input.text == "" && !cmd-input.has-focus : Text {
                            x: 26px;
                            width: parent.width - 26px - 102px;
                            height: parent.height;
                            text: @tr("Type a command, Enter to send");
                            color: Theme.text-muted;
                            font-size: Theme.fs-md;
                            horizontal-alignment: left;
                            vertical-alignment: center;
                        }
                        // ── 内嵌图标钮（清空 / 快捷命令 / 历史命令 / 弹出编辑）──
                        // (#cmdbar-hifi 2026-10-23) 从命令栏左右两端并到输入框
                        // **右端**：两者都是「往输入框里塞东西」的输入辅助，不是
                        // 独立动作。26×26 / r5 / 14px 图标（高保真 .in-btn），
                        // 常态透明、悬停 bg-hover、面板打开时 accent 浅底 + accent
                        // 字（.in-btn.on）。声明在 ScrollView 之后 = 画在输入区之上。
                        // (#cmdbar-clear-first 2026-10-23) 清空键从最末挪到最前：
                        // 它是「丢弃当前输入」的动作，跟后面三个「往输入框里塞东西」
                        // 不是一类；藏在右端最后一个还要跨过 ↗ 才点得到（用户反馈）。
                        // 槽位（W-119）恒定，空框时不画 ×（`if` 只跳过渲染，兄弟按钮
                        // 都是绝对定位，不会跟着挪）。
                        qin-btn := Rectangle {
                            x: parent.width - 93px;
                            y: (parent.height - 26px) / 2;
                            width: 26px;
                            height: 26px;
                            border-radius: 5px;
                            background: root.quick-open
                                ? Theme.accent.with-alpha(0.14)
                                : (qin-ta.has-hover ? Theme.bg-hover : transparent);
                            animate background { duration: 110ms; }
                            qin-ta := TouchArea {
                                mouse-cursor: default;
                                clicked => {
                                    root.history-open = false;
                                    root.scope-open = false;
                                    root.quick-open = !root.quick-open;
                                }
                            }
                            Icon {
                                glyph: "bolt";
                                tint: root.quick-open
                                    ? Theme.accent-solid
                                    : (qin-ta.has-hover ? Theme.text-primary : Theme.text-secondary);
                                size: 14px;
                            }
                        }
                        hin-btn := Rectangle {
                            x: parent.width - 67px;
                            y: (parent.height - 26px) / 2;
                            width: 26px;
                            height: 26px;
                            border-radius: 5px;
                            background: root.hist-panel-open
                                ? Theme.accent.with-alpha(0.14)
                                : (hin-ta.has-hover ? Theme.bg-hover : transparent);
                            animate background { duration: 110ms; }
                            hin-ta := TouchArea {
                                mouse-cursor: default;
                                // 完整面板已开 → 再点关闭；否则（含补全态）→ 打开/升级。
                                clicked => {
                                    if (root.hist-panel-open) {
                                        root.history-open = false;
                                    } else {
                                        root.open_history_panel();
                                    }
                                }
                            }
                            Icon {
                                glyph: "command-history";
                                tint: root.hist-panel-open
                                    ? Theme.accent-solid
                                    : (hin-ta.has-hover ? Theme.text-primary : Theme.text-secondary);
                                // (#cmdbar-hist-icon 2026-10-20) 圆只占 24 网格的
                                // 18（75%），盒给 15px → 字形圈 ~11px。
                                size: 15px * Theme.ui-scale;
                            }
                        }
                        // (#cmdbar-expand 2026-10-23) 一条细线 + 「弹出编辑」钮（高保真
                        // 屏 06：⚡ 🕘 之后用细线隔开 —— 前两个是「往输入框里塞内容」，
                        // 这个换的是编辑面，动作性质不同）。
                        Rectangle {
                            x: parent.width - 37px;
                            y: (parent.height - 14px) / 2;
                            width: 1px;
                            height: 14px;
                            background: Theme.zone-sidebar-line;
                        }
                        exp-btn := Rectangle {
                            x: parent.width - 32px;
                            y: (parent.height - 26px) / 2;
                            width: 26px;
                            height: 26px;
                            border-radius: 5px;
                            background: exp-ta.has-hover ? Theme.bg-hover : transparent;
                            animate background { duration: 110ms; }
                            exp-ta := TouchArea {
                                mouse-cursor: default;
                                clicked => { root.open-send-window(cmd-input.text); }
                            }
                            Icon {
                                glyph: "open-in-full";
                                tint: exp-ta.has-hover ? Theme.text-primary : Theme.text-secondary;
                                size: 14px;
                            }
                        }
                        // (#cmdbar-clear 2026-10-23) 清空按钮：只在有内容时出现
                        // （空框上挂个 × 是噪音）。清空 = 回到"什么都没输入"，
                        // 历史游标一并复位，免得下一次 ↑ 从半路开始。
                        // (#cmdbar-clear-first / #input-clear-accent 2026-10-23)
                        // 两处修正：① 槽位从最末挪到最前 —— 它是「丢弃当前输入」，
                        // 和后面三个「往输入框里塞东西」不是一类，藏在 ↗ 之后还要
                        // 跨过去才点得到（用户反馈）；② 样式回到「输入清空统一
                        // 语言」（widgets / 侧栏搜索 / 主题搜索 / 新建会话 / 分组
                        // 管理同款）：常态只有一枚灰 ×，悬停才铺出 16px accent 实心
                        // 圆、× 换成字段底色镂空。命中区仍是 26×26 的内嵌钮档位，
                        // 鼠标不必精确戳 16px。
                        if cmd-input.text != "" : Rectangle {
                            x: parent.width - 119px;
                            y: (parent.height - 26px) / 2;
                            width: 26px;
                            height: 26px;
                            background: transparent;
                            clr-ta := TouchArea {
                                mouse-cursor: default;
                                clicked => {
                                    cmd-input.text = "";
                                    root.history-cursor = -1;
                                    root.history-open = false;
                                    root.quick-open = false;
                                    root.focus-pending = true;
                                }
                            }
                            Rectangle {
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                width: 16px;
                                height: 16px;
                                border-radius: parent.width / 2;
                                background: clr-ta.has-hover ? Theme.accent : transparent;
                                animate background { duration: 100ms; }
                                accessible-role: button;
                                accessible-label: @tr("Clear");
                                Icon {
                                    glyph: "close";
                                    // 悬停时 × 取字段底色 = 在 accent 圆上「挖洞」。
                                    tint: clr-ta.has-hover ? Theme.zone-sidebar-root : Theme.text-muted;
                                    size: Theme.fs-xs;
                                }
                            }
                        }
                    }
                }

                // ── 发送范围（高保真 .scope-btn）──────────────────────────
                // 28 高 / r6 / 色点 + 文字 + 台数 + 箭头；常态透明，悬停 bg-hover，
                // 「有明确范围」时带 1px 边框（.has）。三档：当前标签页（默认，
                // 行为与旧版 send-to-all=false 一致）/ 全部标签页 / 一组同步频道。
                // 文案不用「所有会话」：项目里「会话」= 侧栏保存的连接，而这里发
                // 给的是**已打开的标签页**（高保真屏 04 的决策）。
                // 组件化（#cmdbar-expand 2026-10-23）：弹出编辑窗口底部也要同一个
                // 键 —— 两处必须是同一份状态，所以状态留在 TerminalView、UI 抽组件。
                ScopeButton {
                    scopes: root.send-scopes;
                    tab-count: root.open-tab-count;
                    all <=> root.scope-all;
                    ch-a <=> root.scope-ch-a;
                    ch-b <=> root.scope-ch-b;
                    ch-c <=> root.scope-ch-c;
                    ch-d <=> root.scope-ch-d;
                    open <=> root.scope-open;
                    activated => {
                        root.quick-open = false;
                        root.history-open = false;
                    }
                }

                // ── 发送键（高保真 .btn-primary：实心 accent / 白字）────────
                // 不带箭头图标：图标和「发送」两个字说的是同一件事。
                // 与范围键同高（34，填满栏内行高）—— 稿子的 30 是另一套
                // cmdbar 内距口径，这里按钮与输入框齐高更稳。
                send-slot := Rectangle {
                    width: max(64px, send-row.preferred-width + 24px);
                    border-radius: 7px;
                    // (#cmdbar-danger 2026-10-23) 命中危险模式 → 实心红 + 文案变
                    // 「仍然发送」。这一下点击就是确认（高保真屏 07：不弹第二个
                    // 确认框 —— 告警条本身已经把「发给谁、什么模式」讲完了）。
                    background: root.danger-now != ""
                        ? (send-ta.has-hover ? Theme.danger-strong.brighter(0.10) : Theme.danger-strong)
                        : (send-ta.has-hover ? Theme.zone-sidebar-accent-hover : Theme.zone-sidebar-accent);
                    animate background { duration: 110ms; }
                    send-ta := TouchArea {
                        mouse-cursor: default;
                        clicked => {
                            root.run-command(cmd-input.text, root.scope-spec());
                            cmd-input.text = "";
                            root.history-cursor = -1;
                            root.focus-pending = true;
                        }
                    }
                    send-row := HorizontalLayout {
                        width: parent.width; height: parent.height;
                        alignment: center;
                        Text {
                            text: root.danger-now != "" ? @tr("Send anyway") : @tr("Send");
                            color: #ffffff;
                            font-size: Theme.fs-sm;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            // (#cmdbar-danger 2026-10-23) 危险命令告警条：从命令栏**上边缘浮出**
            // （高保真屏 07 —— 往下长会推走 SFTP；往上浮只压住终端最后一两行，
            // 正好在「刚敲完命令」的视线位置）。不占布局高度，改掉命令即消失。
            if root.danger-now != "" : Rectangle {
                x: 10px;
                y: -self.height - 6px;
                width: parent.width - 20px;
                height: 30px;
                border-radius: 7px;
                // (#cmdbar-danger-solid 2026-10-23) 底色必须**不透明**：之前是
                // danger 16% 直接叠在终端上，最后一行输出会透上来，红字和
                // `-rwxr-xr-x root root` 糊在一起，看着像"文字没居中"（用户截图）。
                // 高保真 .warn-float 是 rgba(40,16,16,.96) —— 用 popup-bg 打底
                // （≈97% 不透明）再叠一层淡红，两个主题都不会透字。
                background: Theme.popup-bg;
                border-width: 1phx;
                border-color: Theme.danger-strong.with-alpha(0.45);
                Rectangle {
                    x: 1phx;
                    y: 1phx;
                    width: parent.width - 2phx;
                    height: parent.height - 2phx;
                    border-radius: 6px;
                    background: Theme.danger-strong.with-alpha(0.12);
                }
                HorizontalLayout {
                    padding-left: 11px;
                    padding-right: 11px;
                    spacing: 7px;
                    // 图标槽撑满行高，图形在槽内居中（HL 的固定高度子项默认顶对齐）
                    Rectangle {
                        width: 13px;
                        height: 30px;
                        Icon { glyph: "warning"; tint: Theme.danger-strong; size: 13px; }
                    }
                    Text {
                        text: @tr("Dangerous command");
                        color: Theme.danger-strong;
                        font-size: Theme.fs-xs;
                        vertical-alignment: center;
                    }
                    // 命中的模式：等宽字体 + 红底小块（高保真 .warn-float .k）
                    // (#cmdbar-danger-chip-align 2026-10-24) 原来 chip 直接是 17 高的
                    // HL 子项：交叉轴默认 stretch，固定高度 ⇒ stretch 退化成 start，
                    // 于是 chip 贴着行顶，比左侧「检测到危险命令」高出一截（用户截图：
                    // 命令块看着往上飘）。Rectangle 没有 vertical-alignment 可用，
                    // 照左侧图标槽的老办法 —— 外层撑满 30 行高，内层 17 高的块用
                    // y 手动居中。
                    Rectangle {
                        width: warn-chip.preferred-width + 8px;
                        height: 30px;
                        Rectangle {
                            y: (parent.height - self.height) / 2;
                            width: parent.width;
                            height: 17px;
                            border-radius: 3px;
                            background: Theme.danger-strong.with-alpha(0.18);
                            warn-chip := Text {
                                width: parent.width;
                                height: parent.height;
                                text: root.danger-now;
                                color: Theme.danger-strong;
                                font-family: Theme.font-mono;
                                font-size: 10.5px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                    if root.danger-targets() > 0 : Text {
                        text: @tr("· will be sent to {0} hosts", root.danger-targets());
                        color: Theme.danger-strong;
                        font-size: Theme.fs-xs;
                        vertical-alignment: center;
                    }
                    Rectangle { horizontal-stretch: 1; }
                    Text {
                        text: @tr("Edit the command to cancel");
                        color: Theme.text-muted;
                        font-size: 11px;
                        vertical-alignment: center;
                    }
                }
            }

            // --- Quick-command popup (opens upward) --------------------------
            if root.quick-open : Rectangle {
                x: 8px;
                width: 420px;
                height: min(320px, qc-col.preferred-height + 8px);
                y: -self.height - 2px;
                background: Theme.popup-bg;
                border-radius: Theme.radius-md;
                border-width: 1px;
                border-color: Theme.border-strong;
                drop-shadow-blur: 16px;
                drop-shadow-color: transparent;
                TouchArea {}  // swallow clicks
                Flickable {
                    content-width: self.width;
                    content-height: max(self.height, qc-col.preferred-height);
                    qc-col := VerticalLayout {
                        padding: 4px;
                        alignment: start;
                        if root.quick-commands.length == 0 : Text {
                            text: @tr("No quick commands yet");
                            color: Theme.text-muted; font-size: Theme.fs-xs;
                            horizontal-alignment: center;
                            height: 32px; vertical-alignment: center;
                        }
                        for q in root.quick-commands : VerticalLayout {
                            // Group header on the first row of each group (#55) —
                            // click to collapse/expand the whole group.
                            if q.group-header != "" : Rectangle {
                                height: 24px;
                                property <length> gmx;
                                property <length> gmy;
                                grp-ta := TouchArea {
                                    mouse-cursor: default;
                                    clicked => { root.toggle-quick-group(q.group); }
                                    pointer-event(e) => {
                                        if (e.kind == PointerEventKind.down && e.button == PointerEventButton.right) {
                                            gmx = self.mouse-x; gmy = self.mouse-y; qpop-grp-menu.show();
                                        }
                                    }
                                }
                                HorizontalLayout {
                                    padding-left: 4px; padding-top: 4px; spacing: 4px;
                                    Icon {
    glyph: q.collapsed ? "chevron-right" : "expand-more";
    tint: Theme.text-primary;
    size: Theme.fs-md;
} // chevron ▶/▼
                                    Icon {
    glyph: "folder";
    tint: Theme.text-primary;
    size: Theme.fs-md;
} // folder
                                    Text {
                                        text: q.group; color: Theme.text-muted; font-size: Theme.fs-xs;
                                        font-weight: Theme.fw-strong; vertical-alignment: center;
                                        horizontal-stretch: 1; horizontal-alignment: left;
                                    }
                                }
                                qpop-grp-menu := PopupWindow {
                                    x: gmx; y: gmy; width: 150px;
                                    height: (q.orig-index == -1 ? 3 : 2) * 30px + 9px;
                                    Rectangle {
                                        background: Theme.popup-bg; border-radius: Theme.radius-sm;
                                        border-width: 1px; border-color: Theme.border-strong;
                                        drop-shadow-blur: 10px; drop-shadow-color: transparent;
                                        VerticalLayout {
                                            padding: 4px; spacing: 1px;
                                            Rectangle { height: 30px; border-radius: Theme.radius-sm;
                                                background: pg-ren-ta.has-hover ? Theme.bg-hover : transparent;
                                                pg-ren-ta := TouchArea { mouse-cursor: default; clicked => { root.rename-quick-group(q.group); } }
                                                HorizontalLayout { padding-left: 10px; spacing: 8px;
                                                    Icon {
    glyph: "edit";
    tint: Theme.text-primary;
    size: Theme.fs-sm;
}
                                                    Text { text: @tr("Rename group"); color: Theme.text-primary; font-size: Theme.fs-md; vertical-alignment: center; horizontal-stretch: 1; } } }
                                            if q.orig-index == -1 : Rectangle { height: 30px; border-radius: Theme.radius-sm;
                                                background: pg-del-ta.has-hover ? #cc333320 : transparent;
                                                pg-del-ta := TouchArea { mouse-cursor: default; clicked => { root.delete-quick-group(q.group); } }
                                                HorizontalLayout { padding-left: 10px; spacing: 8px;
                                                    Icon {
    glyph: "delete";
    tint: #cc3333;
    size: Theme.fs-sm;
}
                                                    Text { text: @tr("Delete group"); color: #cc3333; font-size: Theme.fs-md; vertical-alignment: center; horizontal-stretch: 1; } } }
                                            Rectangle { height: 30px; border-radius: Theme.radius-sm;
                                                background: pg-new-ta.has-hover ? Theme.bg-hover : transparent;
                                                pg-new-ta := TouchArea { mouse-cursor: default; clicked => { root.new-quick-group(); } }
                                                HorizontalLayout { padding-left: 10px; spacing: 8px;
                                                    Icon {
    glyph: "create-new-folder";
    tint: Theme.text-primary;
    size: Theme.fs-sm;
}
                                                    Text { text: @tr("New group"); color: Theme.text-primary; font-size: Theme.fs-md; vertical-alignment: center; horizontal-stretch: 1; } } }
                                        }
                                    }
                                }
                            }
                            if !q.collapsed && q.orig-index >= 0 : Rectangle {
                                height: 30px;
                                border-radius: Theme.radius-sm;
                                background: q-item-ta.has-hover ? Theme.bg-hover : transparent;
                                property <length> ctx-x;
                                property <length> ctx-y;
                                q-item-ta := TouchArea {
                                    mouse-cursor: default;
                                    clicked => {
                                        if (q.send-enter) {
                                            // Send + execute (trailing Return).
                                            root.run-command(q.command, root.scope-spec());
                                            root.focus-pending = true;
                                        } else {
                                            // Only fill the input box so it can be
                                            // tweaked before sending (B站 suggestion).
                                            cmd-input.text = q.command;
                                            cmd-input.focus();
                                        }
                                        root.quick-open = false;
                                    }
                                    pointer-event(e) => {
                                        if (e.kind == PointerEventKind.down && e.button == PointerEventButton.right) {
                                            ctx-x = self.mouse-x; ctx-y = self.mouse-y; qpop-ctx-menu.show();
                                        }
                                    }
                                }
                                // Name + command on one line; each elides so a long
                                // entry never overflows the popup (#55).
                                HorizontalLayout {
                                    padding-left: 8px; padding-right: 8px; spacing: 10px;
                                    Text { text: q.name; color: Theme.text-primary; font-size: Theme.fs-sm;
                                           vertical-alignment: center; overflow: elide;
                                           horizontal-stretch: 1; }
                                    Text { text: q.command; color: Theme.text-muted; font-size: Theme.fs-xs;
                                           vertical-alignment: center; overflow: elide;
                                           horizontal-alignment: right; horizontal-stretch: 1;
                                           font-family: Theme.ui-font-family; }
                                }
                                qpop-ctx-menu := PopupWindow {
                                    x: ctx-x; y: ctx-y; width: 160px;
                                    height: qpop-ctx-vl.preferred-height;
                                    Rectangle {
                                        background: Theme.popup-bg; border-radius: Theme.radius-sm;
                                        border-width: 1px; border-color: Theme.border-strong;
                                        drop-shadow-blur: 10px; drop-shadow-color: transparent;
                                        qpop-ctx-vl := VerticalLayout {
                                            padding: 4px; spacing: 1px;
                                            Rectangle { height: 28px; border-radius: Theme.radius-sm;
                                                background: pi-edit-ta.has-hover ? Theme.bg-hover : transparent;
                                                pi-edit-ta := TouchArea { mouse-cursor: default; clicked => { root.quick-open = false; root.edit-quick-command(q.orig-index); } }
                                                HorizontalLayout { padding-left: 10px; spacing: 8px;
                                                    Icon {
    glyph: "edit";
    tint: Theme.text-primary;
    size: Theme.fs-sm;
}
                                                    Text { text: @tr("Edit"); color: Theme.text-primary; font-size: Theme.fs-md; vertical-alignment: center; horizontal-stretch: 1; } } }
                                            Rectangle { height: 28px; border-radius: Theme.radius-sm;
                                                background: pi-dup-ta.has-hover ? Theme.bg-hover : transparent;
                                                pi-dup-ta := TouchArea { mouse-cursor: default; clicked => { root.duplicate-quick-command(q.orig-index); } }
                                                HorizontalLayout { padding-left: 10px; spacing: 8px;
                                                    Icon {
    glyph: "copy";
    tint: Theme.text-primary;
    size: Theme.fs-sm;
}
                                                    Text { text: @tr("Duplicate"); color: Theme.text-primary; font-size: Theme.fs-md; vertical-alignment: center; horizontal-stretch: 1; } } }
                                            Rectangle { height: 28px; border-radius: Theme.radius-sm;
                                                background: pi-del-ta.has-hover ? #cc333320 : transparent;
                                                pi-del-ta := TouchArea { mouse-cursor: default; clicked => { root.delete-quick-command(q.orig-index); } }
                                                HorizontalLayout { padding-left: 10px; spacing: 8px;
                                                    Icon {
    glyph: "delete";
    tint: #cc3333;
    size: Theme.fs-sm;
}
                                                    Text { text: @tr("Delete"); color: #cc3333; font-size: Theme.fs-md; vertical-alignment: center; horizontal-stretch: 1; } } }
                                            Rectangle { height: 1px; background: Theme.border-subtle; }
                                            HorizontalLayout { padding-left: 10px; padding-top: 2px; spacing: 6px;
                                                Icon {
    glyph: "folder";
    // (#theme-dedupe 2026-10-15) 分区标签图标跟文字同档(次级)
    tint: Theme.text-secondary;
    size: Theme.fs-xs;
}
                                                Text { text: @tr("Move to"); color: Theme.text-secondary; font-size: Theme.fs-xs; vertical-alignment: center; horizontal-stretch: 1; } }   // (#theme-dedupe 2026-10-15) 分区标签 muted → 次级档
                                            if q.group != "default" : Rectangle { height: 28px; border-radius: Theme.radius-sm;
                                                background: pi-md-ta.has-hover ? Theme.bg-hover : transparent;
                                                pi-md-ta := TouchArea { mouse-cursor: default; clicked => { root.move-quick-command(q.orig-index, "default"); } }
                                                HorizontalLayout { padding-left: 10px; spacing: 8px;
                                                    Icon {
    glyph: "folder";
    tint: Theme.text-primary;
    size: Theme.fs-sm;
}
                                                    Text { text: "default"; color: Theme.text-primary; font-size: Theme.fs-md; vertical-alignment: center; horizontal-stretch: 1; } } }
                                            for s in root.quick-commands : Rectangle {
                                                visible: s.group-header != "" && s.group != "default" && s.group != q.group;
                                                height: self.visible ? 28px : 0px;
                                                border-radius: Theme.radius-sm;
                                                background: pi-mv-ta.has-hover ? Theme.bg-hover : transparent;
                                                pi-mv-ta := TouchArea { mouse-cursor: default; clicked => { root.move-quick-command(q.orig-index, s.group); } }
                                                HorizontalLayout { padding-left: 10px; spacing: 8px;
                                                    Icon {
    glyph: "folder";
    tint: Theme.text-primary;
    size: Theme.fs-sm;
}
                                                    Text { text: s.group; color: Theme.text-primary; font-size: Theme.fs-md; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; } } }
                                        }
                                    }
                                }
                            }
                        }
                        // Manage entry.
                        Rectangle {
                            height: 30px;
                            HorizontalLayout {
                                spacing: 2px;
                                Rectangle {
                                    horizontal-stretch: 1;
                                    border-radius: Theme.radius-sm;
                                    background: mng-ta.has-hover ? Theme.bg-hover : transparent;
                                    mng-ta := TouchArea {
                                        mouse-cursor: default;
                                        clicked => { root.quick-open = false; root.manage-quick-commands(); }
                                    }
                                    Text { text: @tr("Manage…"); color: Theme.accent; font-size: Theme.fs-sm;
                                           horizontal-alignment: center; vertical-alignment: center; }
                                }
                                if root.quick-right-sidebar-enabled : Rectangle {
                                    width: 34px;
                                    border-radius: Theme.radius-sm;
                                    background: quick-grip.has-hover ? Theme.bg-hover : transparent;
                                    quick-grip := TouchArea {
                                        mouse-cursor: default;
                                        moved => {
                                            if (self.pressed) {
                                                root.quick-dock-drag-move(
                                                    self.absolute-position.x + self.mouse-x,
                                                    self.absolute-position.y + self.mouse-y);
                                            }
                                        }
                                        pointer-event(ev) => {
                                            if (ev.kind == PointerEventKind.up) {
                                                root.quick-open = false;
                                                root.quick-dock-drag-end();
                                            }
                                        }
                                    }
                                    Icon {
    glyph: "drag-grip";
    tint: Theme.text-primary;
    size: Theme.fs-md;
}
                                }
                            }
                        }
                    }
                }
            }

            // --- Command hint popup (#cmd-hint 2026-10-27) ----------------------
            // 高保真四段式提示框（docs/design/terminal-command-hint-hifi-2026-10-27.html）。
            //
            // 只有「打字触发的补全态」走新组件；点 🕘 打开的**完整历史面板**（带
            // 搜索框、可删可复制）保持原实现 —— 那是另一个动作（翻/搜历史），
            // 高保真 §2 也明确没动它。两者靠 history-autocomplete 分开。
            if root.hist-popup-visible && root.history-autocomplete : Rectangle {
                // 锚点：贴光标（与旧实现同一套横向口径），宽度按高保真 §3 取 472，
                // 但不超过命令栏可用宽。x 再 clamp 进栏内，光标贴右时不至于出界。
                width: min(472px, parent.width - 16px);
                x: clamp(cmd-box.x + 28px + root.cmd-caret-x, 8px,
                        max(8px, parent.width - self.width - 8px));
                // 向上弹：命令栏在最底，浮层只能往上长；底边贴住栏上沿。
                //
                // ★ 高度必须**再夹一次可用空间**。命令栏贴窗口底、浮层只能向上
                //   长，窗口一矮就会溢出到窗口外被裁掉（离屏实测：640 高窗口里
                //   5 条候选的框只露出 186px）。
                //   ⚠ 不能把 `self.y` 写进 height 的表达式 —— 会与
                //   `y: -self.height` 构成绑定循环（实测直接被 Slint 拒绝）。
                //   这里用「窗口高 - 命令栏高 - 边距」这个与 y 无关的量来夹。
                height: min(hint-inner.preferred-height,
                            max(160px, root.height - 48px - 16px));
                y: -self.height - 2px;

                hint-inner := CommandHint {
                    width: parent.width;
                    height: parent.height;
                    open: true;
                    rows: root.hint-rows;
                    selected: root.history-selected;
                    phase-label: root.hint-phase;
                    context-text: root.hint-context;
                    total-count: root.hint-total;
                    danger-token: root.hint-danger-token;
                    danger-why: root.hint-danger-why;
                    // 鼠标：单击填入（不执行）。悬停只发信号，不改选中。
                    picked(i) => {
                        root.history-selected = i;
                        root.hint-accept();
                    }
                    hovered(i) => { root.hint-hover(i); }
                }
            }
        }
            }
        }

        // --- SFTP resize splitter (#sftp-splitter-style 2026-09-04) ---------
        // 改为与 sftp_panel 目录/文件拆分条完全同款：5px 命中区直接显示
        // Theme.border-subtle，悬浮/拖拽切 Theme.accent；命中区向外扩 3px
        // （水平 11px、垂直 11px），不再嵌 1px 子线与 bg-panel-alt 实心带。
        // 之前的 bg-panel-alt 实心带在 cmd-bar 紧邻时显形为与两侧面板同
        // 色的 4px 带，视觉权重过重；改后只露 1px 静态线 + 整段 accent 高亮。
        // (#splitter-buffer-2026-09-04) 紧邻的 cmd-bar 底与 splitter 顶共享
        // 一个像素边界，femtovg 在 splitter hover 切换（accent↔border-subtle）
        // 时局部重绘会外扩 1px 擦过交界像素，露底色 term-bg 形成"鼠标移出后
        // 闪烁"的视觉故障。在 splitter 上方 1px 嵌一个子 Rectangle 作为
        // `bg-panel-alt` 同色缓冲带（与 cmd-bar 颜色一致），并同步跟随 splitter
        // 的 hover/drag 状态切色：重绘外扩擦到的位置永远同色（rest 时同 cmd-bar，
        // hover 时同 accent），splitter 真正边界稳定；1px 高度不足以让 4px 带
        // 视觉权重再增（拆条主体仍是 5px border-subtle）。
        Rectangle {
            visible: root.sftp-available && !root.sftp-collapsed;
            x: root.sftp-dock == "left"   ? parent.sf-w
             : root.sftp-dock == "right"  ? parent.width - parent.sf-w - parent.sp
             : 0px;
            y: root.sftp-dock == "top"    ? parent.sf-h
             : root.sftp-dock == "bottom" ? parent.height - parent.sf-h - parent.sp
             : 0px;
            width:  root.sftp-horizontal ? parent.sp : parent.width;
            height: root.sftp-horizontal ? parent.height : parent.sp;
            // (#sidebar-alpha-follow 2026-10-20) 静止态不再整条 5px 涂**实色**：
            // 原写法把 5px 命中区整条刷 border-subtle（不透明），面板调透明度后
            // 它成了命令栏与文件面板之间唯一不透的粗横线（用户截图）。现在底色
            // 与 sftp 面板里的树分界条（tree-split）**用同一个 token**
            // （zone-sidebar），中线同为 zone-sidebar-line —— 用户要求「横线的
            // 透明变化和左右两条竖线保持一致」；hover / 拖拽仍整条高亮，
            // 但高亮色跟侧栏档（原实色 accent —— 悬停时那一下比面板实得多，
            // 用户圈出来要求"和表头线一致"）。
            background: divider-ta.has-hover || root.sftp-dragging
                ? Theme.zone-sidebar-accent : Theme.zone-sidebar;
            divider-ta := TouchArea {
                // Hit area extends 3px past each side of the 5px bar so it's
                // easy to grab without landing on the terminal / SFTP edge
                // (mirrors sftp_panel.slint tree-split: x:-3 / w:+6).
                x: root.sftp-horizontal ? -3px : 0px;
                y: root.sftp-horizontal ? 0px : -3px;
                width:  root.sftp-horizontal ? 11px : parent.width;
                height: root.sftp-horizontal ? parent.height : 11px;
                mouse-cursor: root.sftp-horizontal ? ew-resize : ns-resize;
                pointer-event(ev) => {
                    if (ev.kind == PointerEventKind.down) {
                        root.sftp-dragging = true;
                        root.set-sftp-collapsed(false);
                    } else if (ev.kind == PointerEventKind.up) {
                        root.sftp-dragging = false;
                    }
                }
                // Direct tracking: the panel's docked edge follows the cursor's
                // position within the (stable) dock-region — no deltas, so no
                // moving-frame / accumulation issues. NOTE: `parent` here is the
                // thin splitter Rectangle, so refer to `dock-region` explicitly
                // for the region's size/origin (#dock).
                moved => {
                    if (root.sftp-dragging) {
                        if (root.sftp-horizontal) {
                            // Floor matches SftpPanel's compact two-row toolbar;
                            // narrower widths make the path field and actions unusable.
                            root.set-sftp-panel-width(clamp(
                                root.sftp-dock == "right"
                                    ? dock-region.width - ((self.absolute-position.x + self.mouse-x) - dock-region.absolute-position.x)
                                    : (self.absolute-position.x + self.mouse-x) - dock-region.absolute-position.x,
                                300px, max(310px, dock-region.width - 200px)));
                        } else {
                            root.set-sftp-panel-height(clamp(
                                root.sftp-dock == "bottom"
                                    ? dock-region.height - ((self.absolute-position.y + self.mouse-y) - dock-region.absolute-position.y)
                                    : (self.absolute-position.y + self.mouse-y) - dock-region.absolute-position.y,
                                60px, max(80px, dock-region.height - 80px)));
                        }
                    }
                }
            }
            // 1px 中线：静止态唯一可见的笔画，颜色跟侧栏 alpha（见上方注释）。
            Rectangle {
                x: root.sftp-horizontal ? (parent.width - self.width) / 2 : 0px;
                y: root.sftp-horizontal ? 0px : (parent.height - self.height) / 2;
                width:  root.sftp-horizontal ? 1px : parent.width;
                height: root.sftp-horizontal ? parent.height : 1px;
                background: Theme.zone-sidebar-line;
            }
            // Buffer band: 1px 子 Rectangle，贴在 splitter 靠 central（终端）
            // 那一侧的 1px 边界像素上。vertical 模式（dock=bottom|top）→ 缓冲
            // 带在 splitter 顶/底边、全宽；horizontal（dock=left|right）→ 缓冲
            // 带在 splitter 右/左边、全高。缓冲带颜色跟随 splitter 同一
            // hover/drag 状态切色，保证 femtovg 重绘外扩永不把异色像素画进
            // 相邻区域。
            Rectangle {
                visible: root.sftp-available && !root.sftp-collapsed;
                // horizontal 模式：1px 宽的竖条沿 splitter 全高，停在 central
                // 一侧（dock=left 时靠右、dock=right 时靠左）。
                x: root.sftp-horizontal
                    ? (root.sftp-dock == "right" ? 0px : parent.width - 1px)
                    : 0px;
                y: root.sftp-horizontal ? 0px
                    : (root.sftp-dock == "bottom" ? -1px : parent.height);
                width:  root.sftp-horizontal ? 1px : parent.width;
                height: root.sftp-horizontal ? parent.height : 1px;
                // 与 cmd-bar 同 token：半透明时交界不能出现色差缝。
                background: divider-ta.has-hover || root.sftp-dragging
                    ? Theme.zone-sidebar-accent : Theme.zone-sidebar;
            }
        }

        // --- SFTP panel — positioned on the docked edge ---------------------
        // (#sftp-cmdbar-bottom 2026-09-04) Wrap the panel in
        // `sftp-available` again: local / WSL tabs no longer render the
        // panel at all, the dock-region collapses back to just the central
        // terminal + cmd-bar, and the cmd-bar is pinned to the true
        // bottom of the dock-region (sf-h = 0 when sftp isn't usable so
        // central fills 100% of the height).
        if root.sftp-available : SftpPanel {
            x: root.sftp-dock == "right"  ? parent.width - parent.sf-w : 0px;
            y: root.sftp-dock == "bottom" ? parent.height - parent.sf-h : 0px;
            width:  root.sftp-horizontal ? parent.sf-w : parent.width;
            height: root.sftp-horizontal ? parent.height : parent.sf-h;
            show-tree: !root.sftp-horizontal;   // hide the tree when narrow (vertical)
            tree-width: root.sftp-tree-width;
            persist-tree-width(width) => { root.persist-sftp-tree-width(width); }
            show-type: root.sftp-show-type;
            show-size: root.sftp-show-size;
            show-modified: root.sftp-show-modified;
            show-permissions: root.sftp-show-permissions;
            show-owner: root.sftp-show-owner;
            show-group: root.sftp-show-group;
            toggle-column(key) => { root.toggle-sftp-column(key); }
            compact: root.sftp-collapsed && root.sftp-horizontal;  // clean strip when side+collapsed
            dock-drag-move(ax, ay) => {
                root.sftp-panel-dragging = true;
                root.sftp-drag-nx = (ax - dock-region.absolute-position.x) / dock-region.width;
                root.sftp-drag-ny = (ay - dock-region.absolute-position.y) / dock-region.height;
            }
            dock-drag-end() => {
                if (root.sftp-dock-target != "") {
                    root.sftp-dock = root.sftp-dock-target;
                    root.persist-sftp-dock(root.sftp-dock);
                }
                root.sftp-panel-dragging = false;
            }
            collapsed:     root.sftp-collapsed;
            current-tab-id: root.tab-id;
            current-path:  root.sftp-path;
            entries:       root.sftp-entries;
            status:        root.sftp-status;
            loading:       root.sftp-loading;
            tree-nodes:    root.sftp-tree-nodes;
            transfer-targets: root.sftp-transfer-targets;
            selected-count: root.sftp-selected-count;
            single-selected-path: root.sftp-single-selected-path;
            sort-key: root.sftp-sort-key;
            sort-dir: root.sftp-sort-dir;
            tunnels: root.tunnels;
            toggle-collapsed => {
                if (root.sftp-collapsed) {
                    // Re-expand; the panel height was preserved while collapsed.
                    root.set-sftp-collapsed(false);
                } else {
                    // Minimise: just collapse. sf-h becomes the 36px bar; the
                    // panel height is preserved (no 30px poke that would pollute
                    // the global default seeded into new sessions) (M5).
                    root.set-sftp-collapsed(true);
                }
            }
            navigate(path)      => { root.sftp-navigate(path); }
            download(path)      => { root.sftp-download(path); }
            upload-clicked(dir, folder) => { root.sftp-upload-clicked(dir, folder); }
            refresh(path)       => { root.sftp-refresh(path); }
            tree-expand(path)   => { root.sftp-tree-expand(path); }
            delete(path)        => { root.sftp-delete(path); }
            toggle-select(i)    => { root.sftp-toggle-select(i); }
            download-selected() => { root.sftp-download-selected(); }
            download-selected-sequential() => { root.sftp-download-selected-sequential(); }
            download-archive(path) => { root.sftp-download-archive(path); }
            delete-selected()   => { root.sftp-delete-selected(); }
            copy-to-target(path, target) => { root.sftp-copy-to-target(path, target); }
            copy-selected-to-target(target) => { root.sftp-copy-selected-to-target(target); }
            view(path)          => { root.sftp-view(path); }
            edit(path)          => { root.sftp-edit(path); }
            open-external(path) => { root.sftp-open-external(path); }
            edit-external(path) => { root.sftp-edit-external(path); }
            sort-request(key)   => { root.sftp-sort-request(key); }
            clear-sort()        => { root.sftp-clear-sort(); }
            tunnel-add(name, kind, bind, bind-port, host, host-port) => {
                root.tunnel-add(name, kind, bind, bind-port, host, host-port);
            }
            tunnel-stop(id)     => { root.tunnel-stop(id); }
            rename-request(path, name) => { root.sftp-rename-request(path, name); }
            chmod-request(path, name, mode) => { root.sftp-chmod-request(path, name, mode); }
            copy-path(path)     => { root.sftp-copy-path(path); }
            new-folder(dir)     => { root.sftp-new-folder(dir); }
            new-file(dir)       => { root.sftp-new-file(dir); }
        }

        // Drag-to-dock snap overlay — four edge zones; the one under the cursor
        // (sftp-dock-target) lights up. Purely visual (#dock).
        if root.sftp-panel-dragging : Rectangle {
            x: 0; y: 0; width: parent.width; height: parent.height;
            Rectangle {
                x: 0; y: 0; width: parent.width * 0.22; height: parent.height;
                background: root.sftp-dock-target == "left" ? Theme.accent.with-alpha(0.35) : Theme.accent.with-alpha(0.10);
                border-width: root.sftp-dock-target == "left" ? 2px : 0px; border-color: Theme.accent;
            }
            Rectangle {
                x: parent.width * 0.78; y: 0; width: parent.width * 0.22; height: parent.height;
                background: root.sftp-dock-target == "right" ? Theme.accent.with-alpha(0.35) : Theme.accent.with-alpha(0.10);
                border-width: root.sftp-dock-target == "right" ? 2px : 0px; border-color: Theme.accent;
            }
            Rectangle {
                x: 0; y: 0; width: parent.width; height: parent.height * 0.22;
                background: root.sftp-dock-target == "top" ? Theme.accent.with-alpha(0.35) : Theme.accent.with-alpha(0.10);
                border-width: root.sftp-dock-target == "top" ? 2px : 0px; border-color: Theme.accent;
            }
            Rectangle {
                x: 0; y: parent.height * 0.78; width: parent.width; height: parent.height * 0.22;
                background: root.sftp-dock-target == "bottom" ? Theme.accent.with-alpha(0.35) : Theme.accent.with-alpha(0.10);
                border-width: root.sftp-dock-target == "bottom" ? 2px : 0px; border-color: Theme.accent;
            }
        }

        // Collapsed:
        //   - **Bottom / top dock** → the SftpPanel itself shrinks to 36px
        //     (`sf-h`) and its 34px toolbar (with the `min-ta` "expand" button)
        //     stays visible. We render nothing extra here.
        //   - **Left / right dock** → `compact: sftp-collapsed && sftp-horizontal`
        //     hides the *whole* SftpPanel (toolbar + content) so the panel
        //     collapses to a clean side strip. Without an external entry the
        //     user would have no way to re-expand, so this ToolStrip is the
        //     expand button for the side-docked collapsed case. The earlier
        //     "always render a ToolStrip here" caused a duplicate expand entry
        //     over the bottom toolbar (#sftp-collapsed-side-only), so we now
        //     gate the ToolStrip on `sftp-horizontal`.
        if root.sftp-collapsed && root.sftp-horizontal : ToolStrip {
            x: root.sftp-dock == "right" ? parent.width - parent.sf-w : 0px;
            y: 0px;
            width:  parent.sf-w;
            height: parent.height;
            dock-edge: root.sftp-dock;
            glyph: "folder";   // folder — SFTP
            tooltip: root.sftp-available ? "SFTP" : @tr("SFTP not available");
            enabled: root.sftp-available;
            expand => {
                if (root.sftp-available) {
                    root.set-sftp-collapsed(false);
                }
            }
        }

        }
    }

    // [ALT] full-screen-app indicator — absolute overlay (top-right), a direct
    // child of the TerminalView root Rectangle (NOT the VerticalLayout, which
    // forbids x/y on its children).  It replaces the old status strip whose
    // 0↔24px height toggled with is-alt-screen; since Rust rewrites
    // is-alt-screen on every terminal rebuild, that height jump made the whole
    // shell block jitter vertically on connect/focus.  An absolute overlay
    // never changes the pane layout height, so the jitter is gone
    // (#alt-indicator-overlay).
    if !root.zen-mode && root.is-alt-screen : Rectangle {
        x: parent.width - 56px;
        y: 4px;
        width: 52px;
        height: 20px;
        background: Theme.bg-panel-alt;
        border-radius: Theme.radius-sm;
        Text {
            text: "[ALT]";
            color: Theme.success;
            font-size: Theme.fs-xs;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }
}
