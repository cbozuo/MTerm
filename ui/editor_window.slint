import { Icon } from "icons.slint";
import { Theme } from "theme.slint";
import { PickerMath } from "color_picker.slint";
import { EditorTabInfo } from "editor_types.slint";
import { ScrollView } from "std-widgets.slint";

// (#editor-hifi 2026-11-15) 内置文本编辑器 —— 按高保真 docs/design/sftp-editor-hifi-2026-11-14.html
// 100% 还原:rope 行级虚拟化渲染(全文不过 Slint 边界)+ 多文件 tab + 浮层查找替换 +
// 语法色 = 主题 ANSI16(Theme.ansi16)。旧版「全文 TextInput + 全量行号」退役。
// 数据流:Rust 持有 scroll-y/窗口模型权威值;Slint 只发 wheel/点击/键入事件。
export struct EditorFindResult {
    start: int,        // 命中起始字节(含)
    end: int,          // 命中结束字节(不含)
    count: int,        // 命中总数
    index: int,        // 当前命中序号(1 基;0 = 无)
}

// 菜单条目(右键菜单/查找浮层图标钮共用;无快捷键角标——用户定稿)
export struct MenuItem {
    label: string,
    cmd: string,
    disabled: bool,
}

export component EditorWindow inherits Window {
    title: "MTerm — " + root.editor-name;

    in-out property <bool> dark-mode <=> Theme.dark;
    in-out property <float> ui-scale <=> Theme.ui-scale;
    in-out property <string> ui-font-family <=> Theme.ui-font-family;
    in-out property <image> wallpaper-img <=> Theme.wallpaper;
    in-out property <bool> wallpaper-active <=> Theme.wallpaper-active;
    in-out property <color> wp-accent <=> Theme.wp-accent;
    in-out property <color> wp-tint <=> Theme.wp-tint;
    default-font-family: Theme.ui-font-family;

    no-frame: root.custom-titlebar;
    in property <bool> custom-titlebar: true;
    min-width: 420px;
    min-height: 280px;
    preferred-width: 1040px;
    preferred-height: 760px;
    background: Theme.window-base;

    // ══ 文档模型(Rust 下发) ══════════════════════════════════
    in-out property <[EditorTabInfo]> editor-tabs;
    /// 活动文档正文(与 TextInput two-way)。文本权威在 Slint 侧 TextInput:
    /// shaping / 光标 / 选择 / 剪贴板 / IME / 撤销全部原生,Rust 只在打开、
    /// 切 tab、格式化、整体替换时下发。
    in-out property <string> editor-content: "";
    /// 高亮输入:source 必须与正文逐字节一致(否则渲染侧拒绝着色,防串色);
    /// spans = 有序、互不重叠的 UTF-8 字节区间 `start:end:AARRGGBB;`。
    in-out property <string> editor-syntax-source: "";
    in-out property <string> editor-syntax-spans: "";
    /// 选区请求:Rust 无法直接调用 TextInput 内建函数,改 token 即触发一次定位
    /// (查找跳转 / 转到行)。
    in-out property <int> sel-request-start: 0;
    in-out property <int> sel-request-end: 0;
    in-out property <int> sel-request-token: 0;
    /// 命中行数(滚动条命中标记的分数分母;TextInput 不暴露行数)
    in-out property <int> editor-total-lines: 1;
    in-out property <bool> close-confirm-open: false;     // 丢弃未保存确认(tab 销毁路径)
    in-out property <string> close-confirm-text: "";
    in-out property <int> close-confirm-idx: -1;
    in-out property <string> close-confirm-cmd: "";
    callback close-confirm-discard();
    callback close-confirm-save();
    in-out property <int> editor-gutter-w: 56;           // 56;行号 ≥10 万行 → 74
    in-out property <string> editor-name: "";
    in-out property <string> editor-path: "";
    in-out property <string> editor-host: "";            // SFTP 主机名(标题栏路径前缀)
    in-out property <string> editor-encoding: "UTF-8";
    in-out property <bool> editor-readonly: false;
    in-out property <string> editor-lang-display: "纯文本";
    in-out property <string> editor-badge: "";           // "修改" / "只读" / "回传中" / ""
    in-out property <string> editor-badge-kind: "none";  // dirty / ro / up / none
    in-out property <int> editor-cursor-line: 1;         // 1 基(状态栏)
    in-out property <int> editor-cursor-col: 1;
    in-out property <int> editor-sel-lines: 0;
    in-out property <int> editor-sel-chars: 0;
    in-out property <string> editor-status-msg: "";
    in-out property <int> editor-upload-percent: -1;     // ≥0 = 回传中(状态栏进度)
    in-out property <string> editor-upload-text: "";
    in-out property <bool> editor-banner-visible: false; // 大文件提示条
    in-out property <string> editor-banner-text: "";
    in-out property <int> editor-indent-label: 4;        // 状态栏「缩进 N 空格」

    // 查找/替换浮层
    in-out property <bool> editor-find-open: false;
    in-out property <string> editor-find-query: "";
    in-out property <string> editor-replace-text: "";
    in-out property <int> editor-find-count: 0;
    in-out property <int> editor-find-cur: 0;            // 1 基;0=无
    in-out property <[int]> editor-find-hit-lines;
    in-out property <string> editor-download-name: "";   // 下载弹窗内容
    in-out property <string> editor-download-info: "";
    in-out property <string> editor-download-dir: "";

    // 浮层开关(Rust 触发/Slint 右键触发)
    in-out property <bool> ctx-open: false;              // 编辑区右键菜单
    in-out property <length> ctx-x: 0;
    in-out property <length> ctx-y: 0;
    in-out property <bool> tabmenu-open: false;          // tab 右键菜单
    in-out property <length> tabmenu-x: 0;
    in-out property <int> tabmenu-idx: -1;

    // ══ 回调 ══════════════════════════════════════════════════
    callback save-file();
    callback close-editor();
    callback win-drag();
    // 四边四角拖拽:方向 = right/bottom/right-bottom/left/top/…(winit ResizeDirection 映射)
    callback win-resize(string);
    callback tab-activate(int);
    callback tab-close(int);
    // tab 右键菜单命令:close / close-others / close-right / close-all / download / show-panel
    callback tab-menu(string, int);
    /// 正文被用户改动(标脏 + 排定高亮)
    callback content-changed();
    /// 防抖后的高亮请求:参数 = 当前正文;Rust 回填 editor-syntax-source / -spans
    callback editor-highlight(string);
    /// 光标/选区变化(UTF-8 字节偏移)→ 状态栏 Ln/Col + 选区行数
    callback cursor-moved(int /*caret 字节偏移*/, int /*anchor 字节偏移*/);
    /// 命中总数(text 与 query 由调用方给,大小写走 editor-find-case)
    callback editor-count-matches(string, string) -> int;
    /// 查找跳转:from = 当前光标字节偏移;返回命中区间 + 总数 + 序号(1 基)
    callback editor-find-step(string, string, int, bool) -> EditorFindResult;
    /// 全部替换:Rust 读 editor-replace-text / editor-find-case 后重写正文
    callback editor-replace-all(string, string);
    callback find-close();
    callback replace-all();
    callback format-doc();
    /// 编辑区右键菜单里需要宿主参与的命令(format/save/find/goto/download/close/sysopen)
    callback ctx-action(string);
    /// 转到行:参数 = 输入的行号文本
    callback goto-go(string);
    /// 下载:确认下载当前 tab → 弹窗已选目录在 editor-download-dir
    callback download-confirm();
    callback download-browse();

    // ══ 编辑器辅助函数(#editor-native) ═════════════════════════
    // 语法色由 Rust 端编码进 syntax-spans(AARRGGBB),Slint 侧不再做 kind→color 映射
    // (色值仍取自主题 ANSI16,由 Rust 读 Theme.ansi16 后写入,28 套主题照旧跟随)。

    /// 请求一次选区定位(查找跳转 / 转到行):Rust 改 sel-request-token 触发。
    changed sel-request-token => {
        if (root.sel-request-token > 0) {
            edit-input.set-selection-offsets(root.sel-request-start, root.sel-request-end);
            edit-input.focus();
        }
    }

    /// 光标滚入可视区。TextInput 不自带滚动,必须由 ScrollView 宿主负责
    /// (builtin_elements: "The TextInput does not scroll automatically")。
    function ensure-cursor-visible(y: length) {
        let top = y + 8px;                                   // 输入放在 (8,8)
        let line = 20px;
        let vy = 0px - ed-scroll.content-y;                  // 当前滚到哪
        let maxvy = max(0px, ed-scroll.content-height - ed-scroll.visible-height);
        if (top < vy) {
            ed-scroll.content-y = 0px - min(maxvy, max(0px, top - 8px));
            return;
        }
        if (top + line > vy + ed-scroll.visible-height) {
            ed-scroll.content-y = 0px - min(maxvy, top + line - ed-scroll.visible-height + 8px);
        }
    }

    /// 查找跳转:算命中 → 请求选区 → 记数。forward=false 往上游。
    function find-nav(forward: bool) {
        if (root.editor-find-query == "") { return; }
        let res = root.editor-find-step(
            root.editor-content, root.editor-find-query,
            edit-input.cursor-position-byte-offset, forward);
        root.editor-find-count = res.count;
        root.editor-find-cur = res.index;
        if (res.count > 0) {
            root.sel-request-start = res.start;
            root.sel-request-end = res.end;
            root.sel-request-token = root.sel-request-token + 1;
        }
    }

    /// 右键菜单:编辑类命令交给 TextInput 原生实现,其余转宿主。
    function ctx-run(cmd: string) {
        root.ctx-open = false;
        if (cmd == "copy") { edit-input.copy(); edit-input.focus(); return; }
        if (cmd == "cut") { edit-input.cut(); edit-input.focus(); return; }
        if (cmd == "paste") { edit-input.paste(); edit-input.focus(); return; }
        if (cmd == "select-all") { edit-input.select-all(); edit-input.focus(); return; }
        if (cmd == "undo") { edit-input.undo(); edit-input.focus(); return; }
        if (cmd == "redo") { edit-input.redo(); edit-input.focus(); return; }
        if (cmd == "goto") { edit-input.focus(); root.goto-open = true; return; }
        if (cmd == "find") { edit-input.focus(); root.editor-find-open = true; return; }
        root.ctx-action(cmd);
    }

    /// 应用级快捷键。挂在正文 TextInput 的 key-pressed 上(它在 TextInput 自己处理
    /// 之前触发;返回 true 表示已接管)。旧实现用一个 FocusScope 抢焦点自己搬键盘,
    /// 才会出现 CJK 定位漂移 / 单独的 IME 输入条这类问题。
    function editor-shortcut(e: KeyEvent) -> bool {
        if (e.modifiers.control && (e.text == "s" || e.text == "S" || e.text == "\u{0013}")) {
            root.save-file();
            return true;
        }
        if (e.modifiers.control && (e.text == "f" || e.text == "F" || e.text == "\u{0006}")) {
            root.editor-find-open = !root.editor-find-open;
            return true;
        }
        if (e.modifiers.control && (e.text == "h" || e.text == "H")) {
            root.editor-replace-open = !root.editor-replace-open;
            root.editor-find-open = true;
            return true;
        }
        if (e.modifiers.control && (e.text == "g" || e.text == "G")) {
            root.goto-open = true;
            return true;
        }
        if (e.modifiers.control && e.modifiers.shift && (e.text == "i" || e.text == "I")) {
            root.format-doc();
            return true;
        }
        if (e.modifiers.control && (e.text == "w" || e.text == "W")) {
            root.close-editor();
            return true;
        }
        if (e.text == Key.Escape) {
            if (root.ctx-open || root.tabmenu-open || root.goto-open
                || root.editor-find-open || root.dl-open || root.close-confirm-open) {
                root.ctx-open = false;
                root.tabmenu-open = false;
                root.goto-open = false;
                root.dl-open = false;
                root.editor-find-open = false;
                root.close-confirm-open = false;
                return true;
            }
            root.close-editor();
            return true;
        }
        return false;
    }


    // ══ 窗口本体 ══════════════════════════════════════════════
    Rectangle {
        width: parent.width;
        height: parent.height;
        background: Theme.bg-root;
    }

    VerticalLayout {
        spacing: 0;

        // ── 标题栏 36px(规格沿用旧版:保存钮 76×28 ink-on / 关闭 46×36 #e81123)──
        if root.custom-titlebar : Rectangle {
            height: 36px;
            background: Theme.bg-elevated;
            title-drag := TouchArea {
                pointer-event(e) => {
                    if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                        root.win-drag();
                    }
                }
            }
            HorizontalLayout {
                padding-left: 12px;
                spacing: 8px;
                Rectangle {
                    width: 16px;
                    height: 16px;
                    y: (parent.height - 16px) / 2;
                    border-radius: 4px;
                    background: Theme.text-primary;
                    Text {
                        text: "M";
                        color: Theme.bg-elevated;
                        font-size: 10px;
                        font-weight: 700;
                        width: parent.width;
                        height: parent.height;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
                Text {
                    text: root.editor-name;
                    color: Theme.text-primary;
                    font-size: Theme.fs-sm;
                    font-weight: 600;
                    vertical-alignment: center;
                    overflow: elide;
                    max-width: 220px;
                }
                // 状态徽章(修改/只读/回传中)
                if root.editor-badge != "" : Rectangle {
                    width: badge-text.preferred-width + 16px;
                    height: 20px;
                    y: 8px;
                    border-radius: 8px;
                    background: root.editor-badge-kind == "dirty" ? rgba(232,163,62,0.15)
                        : root.editor-badge-kind == "up" ? rgba(31,200,180,0.14)
                        : rgba(127,132,139,0.15);
                    badge-text := Text {
                        text: root.editor-badge;
                        font-size: Theme.fs-xs;
                        color: root.editor-badge-kind == "dirty" ? Theme.warning
                            : root.editor-badge-kind == "up" ? Theme.accent-solid : Theme.text-secondary;
                        width: parent.width;
                        height: parent.height;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
                Text {
                    text: root.editor-host + " · " + root.editor-path;
                    color: Theme.text-secondary;
                    font-size: Theme.fs-xs;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
                // 保存钮:PrimaryButton 同款(#btn-ink-unify)——accent 底 ink-on 深字+白叠
                if !root.editor-readonly : Rectangle {
                    width: 76px;
                    height: 28px;
                    y: 4px;
                    border-radius: Theme.radius-sm;
                    background: root.editor-upload-percent >= 0 ? Theme.bg-elevated : Theme.accent;
                    clip: true;
                    Rectangle {
                        border-radius: Theme.radius-sm;
                        background: #ffffff;
                        opacity: save-ta.has-hover && root.editor-upload-percent < 0 ? 0.12
                            : save-ta.pressed && root.editor-upload-percent < 0 ? 0.22 : 0;
                    }
                    save-ta := TouchArea {
                        mouse-cursor: default;
                        enabled: root.editor-upload-percent < 0;
                        clicked => { root.save-file(); }
                    }
                    if root.editor-upload-percent >= 0 : Text {
                        text: "回传中…";
                        color: Theme.text-muted;
                        font-size: Theme.fs-sm;
                        width: parent.width;
                        height: parent.height;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    if root.editor-upload-percent < 0 : Text {
                        text: @tr("Save");
                        color: PickerMath.ink-on(Theme.accent-hex);
                        font-size: Theme.fs-sm;
                        font-weight: 700;
                        width: parent.width;
                        height: parent.height;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
                // 关闭钮(DialogClose 口径:常态 muted ×,hover #e81123 红底白 ×,90ms)
                Rectangle {
                    width: 46px;
                    height: 36px;
                    background: close-ta.has-hover ? Theme.close-btn-hot : transparent;
                    animate background { duration: 90ms; }
                    close-ta := TouchArea {
                        mouse-cursor: default;
                        clicked => { root.close-editor(); }
                    }
                    Icon {
                        glyph: "close";
                        tint: close-ta.has-hover ? white : Theme.text-muted;
                        size: Theme.fs-md;
                    }
                }
            }
        }
        if root.custom-titlebar : Rectangle { height: 1px; background: Theme.border-subtle; }

        // ── tab 栏 34px(完整多文件;关闭键 = tabs.slint #tab-close-idea 14px accent 圆)──
        Rectangle {
            height: 34px;
            background: Theme.bg-panel;
            HorizontalLayout {
                spacing: 0;
                for t[i] in root.editor-tabs : Rectangle {
                    width: min(200px, max(120px, tab-name.preferred-width + 96px));
                    height: 34px;
                    background: t.active ? Theme.bg-root : transparent;
                    // 右侧 1px 分隔(Rectangle 无单侧 border,用独立矩形)
                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 8px;
                        spacing: 7px;
                        alignment: start;
                        // 文件类型图标块(14px 圆角+首字母;色按语言,设计稿 J橙/L灰/N绿/S粉)
                        Rectangle {
                            width: 14px;
                            height: 14px;
                            y: 10px;
                            border-radius: 4px;
                            background: tab-icon-color(t.lang);
                            Text {
                                text: t.letter;
                                color: Theme.bg-root;
                                font-size: 8px;
                                font-weight: 700;
                                width: parent.width;
                                height: parent.height;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                        tab-name := Text {
                            text: t.name;
                            color: t.active ? Theme.text-primary : Theme.text-secondary;
                            font-size: 12px;
                            vertical-alignment: center;
                            overflow: elide;
                            horizontal-stretch: 1;
                        }
                        // dirty 点(常态)/ hover 换关闭键(14px accent 圆 + panel 底色 ×)
                        if t.active && t.dirty && !tab-hover.has-hover : Rectangle {
                            width: 6px; height: 6px; y: 14px;
                            border-radius: 3px;
                            background: Theme.accent;
                        }
                        Rectangle {
                            width: 20px; height: 20px; y: 7px;
                            opacity: tab-hover.has-hover ? 1.0 : 0.0;
                            animate opacity { duration: 140ms; }
                            background: transparent;
                            tab-close-ta := TouchArea { mouse-cursor: default; }
                            Rectangle {
                                width: 14px; height: 14px;
                                x: (parent.width - 14px) / 2;
                                y: (parent.height - 14px) / 2;
                                border-radius: 7px;
                                background: tab-close-ta.has-hover ? Theme.accent : transparent;
                                animate background { duration: 100ms; }
                                Text {
                                    text: "✕";
                                    color: tab-close-ta.has-hover ? Theme.panel-solid : Theme.text-secondary;
                                    font-size: 8px;
                                    width: parent.width;
                                    height: parent.height;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }
                        if !t.active : Rectangle { width: 0px; height: 0px; }
                    }
                    tab-hover := TouchArea {
                        mouse-cursor: default;
                        clicked => { root.tab-activate(i); }
                        pointer-event(e) => {
                            if (e.kind == PointerEventKind.down && e.button == PointerEventButton.right) {
                                root.tabmenu-open = true;
                                root.tabmenu-idx = i;
                                root.tabmenu-x = self.absolute-position.x - root.absolute-position.x + self.mouse-x;
                            }
                        }
                    }
                    // 激活 tab 顶部 2px accent 条
                    if t.active : Rectangle {
                        x: 0; y: 0;
                        width: parent.width; height: 2px;
                        background: Theme.accent;
                    }
                    Rectangle {
                        x: parent.width - 1px; y: 0;
                        width: 1px; height: parent.height;
                        background: Theme.border-subtle;
                    }
                }
                Rectangle { horizontal-stretch: 1; }
            }
        }

        // ── 大文件提示条 30px ──
        if root.editor-banner-visible : Rectangle {
            height: 30px;
            background: rgba(31, 200, 180, 0.08);
            HorizontalLayout {
                padding-left: 14px;
                padding-right: 8px;
                spacing: 8px;
                alignment: start;
                Text { text: "ⓘ"; color: Theme.accent; font-size: 12px; vertical-alignment: center; }
                Text {
                    text: root.editor-banner-text;
                    color: Theme.text-secondary;
                    font-size: 12px;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
            }
            Rectangle {
                x: 0; y: parent.height - 1px;
                width: parent.width; height: 1px;
                background: Theme.border-subtle;
            }
        }

        // ── 编辑区(FocusScope 铺底收键盘)──
        // ── 编辑区(#editor-native:行号槽 + 原生 TextInput 正文)──
        // 文本、光标、选择、剪贴板、IME、撤销全部由 TextInput 原生实现;
        // 语法色经 syntax-spans(全文字节区间 + AARRGGBB)在 shaping 层叠加,
        // 因此中英文混排不再有「按格宽定位」造成的漂移。
        edit-body := Rectangle {
            vertical-stretch: 1;
            background: Theme.bg-root;
            clip: true;

            HorizontalLayout {
                spacing: 0;
                // 行号槽:一块只读 TextInput 镜像正文的字体/换行/宽度。
                // line-number-width > 0 时 Slint 只画逻辑行号(首个视觉基线,右对齐),
                // 并复用与正文完全相同的行盒,所以行号永远与正文对齐。
                Rectangle {
                    width: root.editor-gutter-w * 1px;
                    background: Theme.bg-panel;
                    clip: true;
                    TextInput {
                        x: 0px;
                        // 必须 +8px:与正文输入的 8px 顶部内衬对齐,否则行号整体浮高 8px
                        y: ed-scroll.content-y + 8px;
                        width: edit-input.width;
                        height: edit-input.height;
                        text: root.editor-content;
                        syntax-source: root.editor-content;
                        line-number-width: parent.width - 6px;
                        read-only: true;
                        enabled: false;
                        single-line: false;
                        wrap: no-wrap;
                        font-family: Theme.font-mono;
                        font-size: Theme.fs-sm;
                        color: Theme.text-muted;
                    }
                    TouchArea {
                        width: parent.width;
                        height: parent.height;
                        mouse-cursor: default;
                        scroll-event(e) => { root.wheel-scroll(e.delta-x, e.delta-y, e.modifiers.shift); accept }
                    }
                }
                Rectangle { width: 1px; background: Theme.border-subtle; }

                // 正文:ScrollView 提供滚动窗口;TextInput 自己排版(char-wrap)
                Rectangle {
                    horizontal-stretch: 1;
                    clip: true;
                    // TextInput 划选时抓走指针且自身不处理滚轮:在它后面接住被拒的滚轮
                    TouchArea {
                        width: parent.width;
                        height: parent.height;
                        mouse-cursor: default;
                        scroll-event(e) => { root.wheel-scroll(e.delta-x, e.delta-y, e.modifiers.shift); accept }
                    }
                    ed-scroll := ScrollView {
                        // 原生滚动条退役(#qs-scrollbar 2026-11-14 同口径:粗条+上下/左右
                        // 箭头与面板语言不搭)。不关会与下面的自绘条同时出现 —— 而且原生条
                        // 走 fluent 调色板,在深色主题下是一条浅色胶囊,明显不协调。
                        vertical-scrollbar-policy: ScrollBarPolicy.always-off;
                        horizontal-scrollbar-policy: ScrollBarPolicy.always-off;
                        content-width: max(self.visible-width, edit-input.preferred-width + 16px);
                        content-height: max(self.visible-height, edit-input.preferred-height + 16px);
                        edit-input := TextInput {
                            x: 8px;
                            y: 8px;
                            width: max(1px, ed-scroll.visible-width - 16px);
                            height: max(ed-scroll.visible-height - 16px, self.preferred-height);
                            text <=> root.editor-content;
                            syntax-source: root.editor-syntax-source;
                            syntax-spans: root.editor-syntax-spans;
                            read-only: root.editor-readonly;
                            single-line: false;
                            wrap: no-wrap;
                            color: Theme.text-primary;
                            selection-background-color: rgba(60, 120, 216, 0.35);
                            selection-foreground-color: Theme.text-primary;
                            font-family: Theme.font-mono;
                            font-size: Theme.fs-sm;
                            page-height: ed-scroll.visible-height;
                            // 标脏:仅用户键入触发(撤销也走这里 → 仍是「已改动」)
                            edited => { root.content-changed(); }
                            // 任何文本变化(键入/撤销/宿主整体替换)都重排高亮
                            changed text => { root.highlight-pending = true; }
                            cursor-position-changed(pos) => { root.ensure-cursor-visible(pos.y); }
                            changed cursor-position-byte-offset => {
                                root.cursor-moved(self.cursor-position-byte-offset,
                                                  self.anchor-position-byte-offset);
                            }
                            changed anchor-position-byte-offset => {
                                root.cursor-moved(self.cursor-position-byte-offset,
                                                  self.anchor-position-byte-offset);
                            }
                            // 应用级快捷键优先于输入法/编辑处理;其余一律 reject,
                            // 交还 TextInput(方向键/Home/End/PageUp/Down/Ctrl+C/V/X/A/Z/Y/IME)
                            key-pressed(e) => {
                                if (root.editor-shortcut(e)) { accept } else { reject }
                            }
                        }
                    }
                }
            }

            // 垂直滚动条(#qs-scrollbar 同款:轨道透明 + 4px 细圆角 thumb + 90ms 变色)
            if ed-scroll.content-height > ed-scroll.visible-height : vbar := Rectangle {
                x: parent.width - 8px;
                y: 0;
                width: 4px;
                height: parent.height;
                background: transparent;
                property <length> max-off: max(0px, ed-scroll.content-height - ed-scroll.visible-height);
                property <length> thumb-h: root.thumb-size(self.height, ed-scroll.content-height, ed-scroll.visible-height);
                // 查找命中标记(与查找浮层同源配色)
                for hl in root.editor-find-hit-lines : Rectangle {
                    x: 0;
                    y: hl * parent.height / max(1, root.editor-total-lines);
                    width: 4px;
                    height: 3px;
                    border-radius: 1px;
                    background: rgba(232, 163, 62, 0.45);
                }
                Rectangle {
                    width: 4px;
                    height: vbar.thumb-h;
                    border-radius: 2px;
                    y: vbar.max-off > 0px
                        ? ((0px - ed-scroll.content-y) / vbar.max-off) * (vbar.height - self.height)
                        : 0px;
                    background: vbar-ta.pressed || vbar-ta.has-hover ? Theme.border-strong : Theme.border-subtle;
                    animate background { duration: 90ms; }
                }
                vbar-ta := TouchArea {
                    mouse-cursor: default;
                    x: -2px;
                    width: parent.width + 4px;
                    height: parent.height;
                    property <length> grab-dy: 0px;
                    pointer-event(e) => {
                        if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                            self.grab-dy = self.mouse-y - (vbar.max-off > 0px
                                ? ((0px - ed-scroll.content-y) / vbar.max-off) * (vbar.height - vbar.thumb-h)
                                : 0px);
                        }
                    }
                    moved => {
                        if (self.pressed) {
                            let run = max(1px, vbar.height - vbar.thumb-h);
                            let want = clamp(self.mouse-y - self.grab-dy, 0px, run);
                            ed-scroll.content-y = 0px - (vbar.max-off * (want / run));
                        }
                    }
                }
            }

            // 横向滚动条(no-wrap 下长行不折行,靠它平移;样式同上)
            if ed-scroll.content-width > ed-scroll.visible-width + 2px : hbar := Rectangle {
                x: 0;
                y: parent.height - 6px;
                width: parent.width - 8px;
                height: 4px;
                background: transparent;
                property <length> max-off: max(0px, ed-scroll.content-width - ed-scroll.visible-width);
                property <length> thumb-w: root.thumb-size(self.width, ed-scroll.content-width, ed-scroll.visible-width);
                Rectangle {
                    width: hbar.thumb-w;
                    height: 4px;
                    border-radius: 2px;
                    x: hbar.max-off > 0px
                        ? ((0px - ed-scroll.content-x) / hbar.max-off) * (hbar.width - self.width)
                        : 0px;
                    background: hbar-ta.pressed || hbar-ta.has-hover ? Theme.border-strong : Theme.border-subtle;
                    animate background { duration: 90ms; }
                }
                hbar-ta := TouchArea {
                    mouse-cursor: default;
                    y: -2px;
                    height: parent.height + 4px;
                    width: parent.width;
                    property <length> grab-dx: 0px;
                    pointer-event(e) => {
                        if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                            self.grab-dx = self.mouse-x - (hbar.max-off > 0px
                                ? ((0px - ed-scroll.content-x) / hbar.max-off) * (hbar.width - hbar.thumb-w)
                                : 0px);
                        }
                    }
                    moved => {
                        if (self.pressed) {
                            let run = max(1px, hbar.width - hbar.thumb-w);
                            let want = clamp(self.mouse-x - self.grab-dx, 0px, run);
                            ed-scroll.content-x = 0px - (hbar.max-off * (want / run));
                        }
                    }
                }
            }

            // 高亮防抖:打字时不为每个字符重解析;撤销与宿主整体替换同样经 `changed text`
            // 排定,因此着色不会停在旧文本上。
            Timer {
                interval: 120ms;
                running: root.highlight-pending;
                triggered => {
                    root.highlight-pending = false;
                    root.editor-highlight(root.editor-content);
                }
            }

            // ── 查找/替换浮层(右上;行 1 查找+计数+图标钮,行 2 替换)──
            if root.editor-find-open : Rectangle {
                x: parent.width - 482px;
                y: 8px;
                width: 468px;
                height: root.editor-replace-open ? 74px : 40px;
                border-radius: 6px;
                background: Theme.bg-elevated;
                border-width: 1px;
                border-color: Theme.border-strong;
                drop-shadow-blur: 12px;
                drop-shadow-color: rgba(0, 0, 0, 0.45);
                VerticalLayout {
                    padding: 6px;
                    spacing: 6px;
                    HorizontalLayout {
                        spacing: 6px;
                        Rectangle {
                            height: 28px;
                            horizontal-stretch: 1;
                            border-radius: 4px;
                            background: Theme.field;
                            border-width: 1px;
                            border-color: Theme.border-strong;
                            find-input := TextInput {
                                x: 8px;
                                y: 4px;
                                width: parent.width - 16px;
                                height: 20px;
                                single-line: true;
                                font-family: Theme.font-mono;
                                font-size: Theme.fs-sm;
                                color: Theme.text-primary;
                                text <=> root.editor-find-query;
                                edited => { root.find-edited(root.find-case-on); }
                                key-pressed(e) => {
                                    if (e.text == Key.Escape) { root.editor-find-open = false; return accept; }
                                    if (e.text == Key.Return) { root.find-nav(!e.modifiers.shift); return accept; }
                                    reject
                                }
                            }
                        }
                        Text {
                            width: 48px;
                            text: root.editor-find-query == "" ? "" : root.editor-find-cur + " / " + root.editor-find-count;
                            color: Theme.text-secondary;
                            font-size: 11px;
                            vertical-alignment: center;
                            horizontal-alignment: center;
                        }
                        // 图标钮:大小写敏感/全词/正则(一期仅大小写生效,余占位)/↑↓/×
                        for it[i] in root.find-icons : Rectangle {
                            width: 28px;
                            height: 28px;
                            border-radius: 4px;
                            background: !it.disabled ? Theme.bg-active : transparent;
                            Text {
                                text: it.label;
                                color: !it.disabled ? Theme.accent-solid : Theme.text-secondary;
                                font-size: 11px;
                                width: parent.width;
                                height: parent.height;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            TouchArea {
                                clicked => {
                                    if (i == 0) { root.find-case-on = !root.find-case-on; }
                                    if (i == 1) { root.find-whole-on = !root.find-whole-on; }
                                    if (i == 2) { root.find-regex-on = !root.find-regex-on; }
                                    root.find-edited(root.find-case-on);
                                }
                            }
                        }
                        Rectangle {
                            width: 28px;
                            height: 28px;
                            border-radius: 4px;
                            Text { text: "↑"; color: Theme.text-secondary; font-size: 12px;
                                   width: parent.width; height: parent.height;
                                   horizontal-alignment: center; vertical-alignment: center; }
                            TouchArea { clicked => { root.find-nav(false); } }
                        }
                        Rectangle {
                            width: 28px;
                            height: 28px;
                            border-radius: 4px;
                            Text { text: "↓"; color: Theme.text-secondary; font-size: 12px;
                                   width: parent.width; height: parent.height;
                                   horizontal-alignment: center; vertical-alignment: center; }
                            TouchArea { clicked => { root.find-nav(true); } }
                        }
                        Rectangle {
                            width: 28px;
                            height: 28px;
                            border-radius: 4px;
                            Text { text: "✕"; color: Theme.text-secondary; font-size: 12px;
                                   width: parent.width; height: parent.height;
                                   horizontal-alignment: center; vertical-alignment: center; }
                            TouchArea { clicked => { root.find-close(); } }
                        }
                    }
                    if root.editor-replace-open : HorizontalLayout {
                        spacing: 6px;
                        Rectangle {
                            height: 28px;
                            horizontal-stretch: 1;
                            border-radius: 4px;
                            background: Theme.field;
                            border-width: 1px;
                            border-color: Theme.border-strong;
                            TextInput {
                                x: 8px;
                                y: 4px;
                                width: parent.width - 16px;
                                height: 20px;
                                single-line: true;
                                font-family: Theme.font-mono;
                                font-size: Theme.fs-sm;
                                color: Theme.text-primary;
                                text <=> root.editor-replace-text;
                            }
                        }
                        Rectangle {
                            height: 30px;
                            width: 64px;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: #31353e;
                            Text { text: @tr("Replace"); color: Theme.text-secondary; font-size: 12px;
                                   width: parent.width; height: parent.height;
                                   horizontal-alignment: center; vertical-alignment: center; }
                            TouchArea { clicked => { root.replace-one(edit-input.anchor-position-byte-offset, edit-input.cursor-position-byte-offset); } }
                        }
                        Rectangle {
                            height: 30px;
                            width: 76px;
                            border-radius: 6px;
                            background: Theme.accent;
                            clip: true;
                            Rectangle {
                                background: #ffffff;
                                opacity: ra-ta.has-hover ? 0.12 : ra-ta.pressed ? 0.22 : 0;
                            }
                            Text { text: @tr("Replace all"); color: PickerMath.ink-on(Theme.accent-hex);
                                   font-size: 12px; font-weight: 700;
                                   width: parent.width; height: parent.height;
                                   horizontal-alignment: center; vertical-alignment: center; }
                            ra-ta := TouchArea { mouse-cursor: default; clicked => { root.replace-all(); } }
                        }
                    }
                }
            }

            // ── 编辑区右键菜单(无快捷键角标——用户定稿)──
            if root.ctx-open : Rectangle {
                x: min(root.ctx-x, parent.width - 210px);
                y: min(root.ctx-y, parent.height - menu-h);
                width: 200px;
                // 高度随条目数走(28px 行 + 5px 上下内衬),加项不会再溢出卡片
                height: menu-h;
                property <length> menu-h: ctx-items.length * 28px + 10px;
                border-radius: Theme.radius-md;
                background: Theme.bg-elevated;
                border-width: 1px;
                border-color: Theme.border-strong;
                drop-shadow-blur: 16px;
                drop-shadow-color: rgba(0, 0, 0, 0.5);
                VerticalLayout {
                    padding: 5px;
                    spacing: 0;
                    for m in ctx-items : Rectangle {
                        height: 28px;
                        border-radius: 4px;
                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            Text { text: m.label; color: m.disabled ? Theme.text-muted : Theme.text-primary; font-size: 12px; vertical-alignment: center; }
                        }
                        m-ta := TouchArea {
                            mouse-cursor: default;
                            clicked => { root.ctx-run(m.cmd); }
                        }
                    }
                }
                property <[MenuItem]> ctx-items: [
                    { label: @tr("Copy"), cmd: "copy", disabled: false },
                    { label: @tr("Cut"), cmd: "cut", disabled: false },
                    { label: @tr("Paste"), cmd: "paste", disabled: false },
                    { label: @tr("Select all"), cmd: "select-all", disabled: false },
                    { label: "", cmd: "sep", disabled: true },
                    { label: @tr("Go to line"), cmd: "goto", disabled: false },
                    { label: @tr("Find"), cmd: "find", disabled: false },
                    { label: "", cmd: "sep", disabled: true },
                    { label: @tr("Format document"), cmd: "format", disabled: !root.can-format },
                    { label: @tr("Save"), cmd: "save", disabled: root.editor-readonly },
                ];
            }

            // ── 转到行浮层(Ctrl+G;一期 UI 直达,回车回调用 Rust 已接)──
            if root.goto-open : Rectangle {
                x: (parent.width - 340px) / 2;
                y: 56px;
                width: 340px;
                height: 92px;
                border-radius: 6px;
                background: Theme.bg-elevated;
                border-width: 1px;
                border-color: Theme.border-strong;
                drop-shadow-blur: 16px;
                drop-shadow-color: rgba(0, 0, 0, 0.5);
                VerticalLayout {
                    padding: 12px;
                    spacing: 8px;
                    HorizontalLayout {
                        Text { text: @tr("Go to line"); color: Theme.text-primary; font-size: 12px; }
                        Rectangle { horizontal-stretch: 1; }
                        Text { text: @tr("Enter to jump · Esc to cancel"); color: Theme.text-secondary; font-size: 11px; }
                    }
                    Rectangle {
                        height: 30px;
                        border-radius: 4px;
                        background: Theme.field;
                        border-width: 1px;
                        border-color: Theme.accent-solid;
                        goto-input := TextInput {
                            x: 8px; y: 5px;
                            width: parent.width - 16px;
                            height: 20px;
                            single-line: true;
                            font-family: Theme.font-mono;
                            font-size: 13px;
                            color: Theme.text-primary;
                            text <=> root.goto-line-text;
                            accepted => { root.goto-go(root.goto-line-text); }
                            key-pressed(e) => {
                                if (e.text == Key.Escape) { root.goto-open = false; return accept; }
                                reject
                            }
                        }
                    }
                }
            }

            // ── tab 右键菜单(150px;贴近右击点;无快捷键角标)──
            if root.tabmenu-open : Rectangle {
                x: min(root.tabmenu-x, parent.width - 160px);
                y: -70px;  // tabmenu-x/y 以 tab 栏为系;菜单从栏底贴下(见 Rust 侧换算)
                width: 150px;
                height: 178px;
                border-radius: Theme.radius-md;
                background: Theme.bg-elevated;
                border-width: 1px;
                border-color: Theme.border-strong;
                drop-shadow-blur: 16px;
                drop-shadow-color: rgba(0, 0, 0, 0.5);
                VerticalLayout {
                    padding: 5px;
                    for m in tabmenu-items : Rectangle {
                        height: 28px;
                        border-radius: 4px;
                        Text { text: m.label; color: m.disabled ? Theme.text-muted : Theme.text-primary;
                               font-size: 12px; x: 10px; vertical-alignment: center; }
                        TouchArea { clicked => { root.tab-menu(m.cmd, root.tabmenu-idx); } }
                    }
                }
                property <[MenuItem]> tabmenu-items: [
                    { label: @tr("Close"), cmd: "close", disabled: false },
                    { label: @tr("Close others"), cmd: "close-others", disabled: root.editor-tabs.length <= 1 },
                    { label: @tr("Close right"), cmd: "close-right", disabled: root.tabmenu-idx >= root.editor-tabs.length - 1 },
                    { label: @tr("Close all"), cmd: "close-all", disabled: false },
                    { label: "", cmd: "sep", disabled: true },
                    { label: @tr("Download…"), cmd: "download", disabled: false },
                    { label: @tr("Show in SFTP panel"), cmd: "show-panel", disabled: false },
                ];
            }

            // ── 下载弹窗(文件来源 + 保存到 + 浏览… + 下载/取消)──
            if root.dl-open : Rectangle {
                x: (parent.width - 460px) / 2;
                y: (parent.height - 132px) / 2;
                width: 460px;
                height: 132px;
                border-radius: Theme.radius-lg;
                background: Theme.bg-elevated;
                border-width: 1px;
                border-color: Theme.border-strong;
                drop-shadow-blur: 24px;
                drop-shadow-color: rgba(0, 0, 0, 0.55);
                VerticalLayout {
                    padding-top: 14px;
                    padding-bottom: 14px;
                    padding-left: 16px;
                    padding-right: 16px;
                    spacing: 8px;
                    Text { text: @tr("Download file"); color: Theme.text-primary; font-size: 13px; font-weight: 600; }
                    HorizontalLayout {
                        spacing: 8px;
                        Text { text: @tr("File"); color: Theme.text-secondary; font-size: 12px; width: 44px; vertical-alignment: center; }
                        Rectangle {
                            height: 28px;
                            horizontal-stretch: 1;
                            border-radius: 4px;
                            background: Theme.field;
                            border-width: 1px;
                            border-color: #31353e;
                            Text { text: root.editor-download-name + " · " + root.editor-download-info;
                                   color: Theme.text-secondary; font-size: 12px; x: 8px;
                                   width: parent.width - 16px; height: parent.height;
                                   vertical-alignment: center; overflow: elide; }
                        }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        Text { text: @tr("Save to"); color: Theme.text-secondary; font-size: 12px; width: 44px; vertical-alignment: center; }
                        Rectangle {
                            height: 28px;
                            horizontal-stretch: 1;
                            border-radius: 4px;
                            background: Theme.field;
                            border-width: 1px;
                            border-color: #31353e;
                            Text { text: root.editor-download-dir; color: Theme.text-primary; font-size: 12px; x: 8px;
                                   width: parent.width - 16px; height: parent.height;
                                   vertical-alignment: center; overflow: elide; }
                        }
                        Rectangle {
                            height: 28px;
                            width: browse-btn.preferred-width + 20px;
                            border-radius: 4px;
                            border-width: 1px;
                            border-color: #31353e;
                            browse-btn := Text { text: @tr("Browse…"); color: Theme.text-secondary; font-size: 12px;
                                   width: parent.width; height: parent.height;
                                   horizontal-alignment: center; vertical-alignment: center; }
                            TouchArea { clicked => { root.download-browse(); } }
                        }
                    }
                    HorizontalLayout {
                        alignment: end;
                        spacing: 8px;
                        Rectangle {
                            height: 30px;
                            width: 64px;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: #31353e;
                            Text { text: @tr("Cancel"); color: Theme.text-secondary; font-size: 12px;
                                   width: parent.width; height: parent.height;
                                   horizontal-alignment: center; vertical-alignment: center; }
                            TouchArea { clicked => { root.dl-open = false; } }
                        }
                        Rectangle {
                            height: 30px;
                            width: 76px;
                            border-radius: 6px;
                            background: Theme.accent;
                            clip: true;
                            Rectangle {
                                background: #ffffff;
                                opacity: dl-ta.has-hover ? 0.12 : dl-ta.pressed ? 0.22 : 0;
                            }
                            Text { text: @tr("Download"); color: PickerMath.ink-on(Theme.accent-hex);
                                   font-size: 12px; font-weight: 700;
                                   width: parent.width; height: parent.height;
                                   horizontal-alignment: center; vertical-alignment: center; }
                            dl-ta := TouchArea { mouse-cursor: default; clicked => { root.download-confirm(); } }
                        }
                    }
                }
            }
        }

        // ── 状态栏 26px ──
        Rectangle {
            height: 26px;
            background: Theme.bg-panel;
            Rectangle { // 状态栏顶线
                x: 0; y: 0;
                width: parent.width; height: 1px;
                background: Theme.border-subtle;
            }
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 14px;
                alignment: start;
                if root.editor-status-msg != "" : Text {
                    text: root.editor-status-msg;
                    color: Theme.accent-solid;
                    font-size: 11px;
                    vertical-alignment: center;
                }
                if root.editor-upload-percent < 0 && root.editor-status-msg == "" : Text {
                    text: "Ln " + root.editor-cursor-line + ", Col " + root.editor-cursor-col
                        + (root.editor-sel-lines > 0 ? "  ·  选区 " + root.editor-sel-lines + " 行 (" + root.editor-sel-chars + " 字符)" : "");
                    color: Theme.text-secondary;
                    font-size: 11px;
                    font-family: Theme.font-mono;
                    vertical-alignment: center;
                }
                if root.editor-upload-percent >= 0 : HorizontalLayout {
                    spacing: 8px;
                    Text { text: root.editor-upload-text; color: Theme.text-primary; font-size: 11px; font-family: Theme.font-mono; vertical-alignment: center; }
                    Rectangle {
                        width: 140px;
                        height: 4px;
                        y: 11px;
                        border-radius: 2px;
                        background: Theme.bg-active;
                        Rectangle {
                            width: parent.width * root.editor-upload-percent / 100;
                            height: 4px;
                            border-radius: 2px;
                            background: Theme.accent;
                        }
                    }
                    Text { text: root.editor-upload-percent + "%"; color: Theme.text-secondary; font-size: 11px; font-family: Theme.font-mono; vertical-alignment: center; }
                }
                Rectangle { horizontal-stretch: 1; }
                Text { text: root.editor-encoding; color: Theme.text-secondary; font-size: 11px; font-family: Theme.font-mono; vertical-alignment: center; }
                Text { text: "LF"; color: Theme.text-secondary; font-size: 11px; font-family: Theme.font-mono; vertical-alignment: center; }
                Text { text: "缩进 " + root.editor-indent-label + " 空格"; color: Theme.text-secondary; font-size: 11px; vertical-alignment: center; }
                Text { text: root.editor-lang-display; color: Theme.accent-solid; font-size: 11px; vertical-alignment: center; }
                if root.editor-readonly : Rectangle {
                    width: ro-text.preferred-width + 12px;
                    height: 16px;
                    y: 5px;
                    border-radius: 4px;
                    border-width: 1px;
                    border-color: rgba(232, 163, 62, 0.4);
                    ro-text := Text { text: "只读"; color: Theme.warning; font-size: 10px;
                        width: parent.width; height: parent.height;
                        horizontal-alignment: center; vertical-alignment: center; }
                }
            }
        }
    }

    // ══ 派生属性/工具 ════════════════════════════════════════
    in-out property <bool> editor-replace-open: false;
    in-out property <bool> dl-open: false;
    in-out property <bool> goto-open: false;
    in-out property <string> goto-line-text: "";
    in-out property <bool> can-format: false;
    /// 高亮防抖标志(120ms Timer 消费)
    in-out property <bool> highlight-pending: false;
    /// 下一帧聚焦正文(init/切 tab 时直接 focus 会重入 Windows 无障碍适配层)
    property <bool> focus-pending: false;

    /// 滚轮入口:纵向为主,shift = 横向(gutter 与正文都转发到这里)
    function wheel-scroll(dx: length, dy: length, shift: bool) {
        if (shift) { scroll-x-by(dy); } else { scroll-by(dy); }
    }
    function scroll-x-by(dx: length) {
        ed-scroll.content-x = clamp(
            ed-scroll.content-x + dx,
            min(0px, ed-scroll.visible-width - ed-scroll.content-width),
            0px);
    }
    /// 滚动条 thumb 尺寸(轨道长、内容长、可视长)——横竖共用
    function thumb-size(track: length, content: length, visible: length) -> length {
        return max(24px, track * (visible / max(1px, content)));
    }
    function scroll-by(dy: length) {
        ed-scroll.content-y = clamp(
            ed-scroll.content-y + dy,
            min(0px, ed-scroll.visible-height - ed-scroll.content-height),
            0px);
    }
    // tab 图标块底色(设计稿:J 橙 / L 灰 / N 绿 / S 粉;按语言显示名映射)
    function tab-icon-color(lang: string) -> color {
        if lang == "Java" { return #E8A33E; }
        if lang == "日志" { return #7F848B; }
        if lang == "nginx.conf" { return #73B00A; }
        if lang == "SQL" { return #C77DBB; }
        if lang == "JSON" { return #E8A33E; }
        if lang == "YAML" { return #73B00A; }
        if lang == "TOML" { return #E8A33E; }
        if lang == "Shell" { return #7CACF8; }
        if lang == "XML" { return #45C8E0; }
        if lang == "Python" { return #6677F7; }
        if lang == "Dockerfile" { return #45C8E0; }
        if lang == "Markdown" { return #7F848B; }
        if lang == "Properties" || lang == "Env" || lang == "INI" { return #7CACF8; }
        return #7F848B;
    }
    // find-icons 模型(大小写/全词/正则;一期仅大小写生效)
    property <[MenuItem]> find-icons: [
        { label: "Aa", cmd: "case", disabled: !root.find-case-on },
        { label: "ab|", cmd: "whole", disabled: !root.find-whole-on },
        { label: ".*", cmd: "regex", disabled: !root.find-regex-on },
    ];
    property <bool> find-case-on: true;
    property <bool> find-whole-on: false;
    property <bool> find-regex-on: false;
    callback find-edited(bool /*大小写敏感*/);
    /// 替换当前命中(查找浮层的「替换」钮;参数 = 选区字节区间)
    callback replace-one(int, int);

    init => {
        // 主题槽位已由主窗拷贝;这里只把焦点交给正文输入
        root.focus-pending = true;
    }
    Timer {
        interval: 0ms;
        running: root.focus-pending;
        triggered => {
            root.focus-pending = false;
            edit-input.focus();
        }
    }
    callback focus-editor();
    focus-editor => {
        edit-input.focus();
    }
}
