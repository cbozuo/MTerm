// (#double-shift-v1 2026-11-11) 双击 Shift 全局搜索浮层。
//
// 高保真稿：docs/design/double-shift-hifi-2026-11-06-v1.html §04。
// 规格：面板 920×568、顶部偏移 76px、输入区 52 / 分类条 38 / 结果行 48 /
// 分组头 24 / 脚注 34；主体左列表 56% / 右预览 44%。
//
// 架构约定（对齐 ping_dialog / send_cmd lib 面板）：
//   - 状态与数据全部挂在 AppWindow 根（`qs-*` 属性族 + 回调族），本组件只画；
//   - Rust 侧（src/app/search_ui.rs）重建索引 / 查询 / 跳组头选中 / 预览 / 执行；
//   - 恒实例 + visible（进场动画挂常驻元素——`if` 元素首帧不播的坑，
//     见 left_sidebar.slint #slot-box-persist 注释）；
//   - Esc 关闭后经 root.terminal-focus-sequence += 1 把焦点还给活动终端。

import { Theme } from "theme.slint";
import { Icon } from "icons.slint";
import { Scrim } from "widgets.slint";
import { ScrollView } from "std-widgets.slint";
import { PanelAnim } from "panel_anim.slint";

// 一行结果（kind 0 = 组头 / 1 = 结果行）。`qi` 是 Rust 侧扁平结果的索引，
// 组头为 -1 —— 执行与预览都按它回查，Slint 不持有业务对象。
// `cat`：0 会话 / 1 命令 / 2 设置 / 3 动作（图标着色与副标题等宽判定用）。
export struct QsRow {
    kind: int,
    cat: int,
    title: string,
    sub: string,
    icon: string,
    badge: string,
    open: bool,
    shortcut: string,
    qi: int,
    // (#qs-multiline-row 2026-11-13) 标题的换行数（≥1）。命令历史条目的
    // title = 命令原文，多行命令含 \n —— 行高按此展开，防内容溢出行盒
    // 与下一行重叠。
    lines: int,
}

// 预览区的一行 meta（标签 + 值）。
export struct QsMeta {
    label: string,
    value: string,
    mono: bool,
}

// 预览区整块数据（选中行变化时 Rust 重灌）。
export struct QsPreview {
    has-item: bool,
    icon: string,
    title: string,
    cat: string,
    desc: string,
    metas: [QsMeta],
    code: string,
    primary: string,
    secondary: string,
}

// 分类条的一个页签（文件内私有组件，实例 5 次）。
// 依赖全部走 in 属性 / 回调参数——组件内 root 指自身，够不到宿主。
component QsTab inherits Rectangle {
    in property <int> idx;
    in property <string> label;
    in property <int> count;
    in property <bool> on;
    callback picked(int);
    height: 100%;
    horizontal-stretch: 0;

    VerticalLayout {
        HorizontalLayout {
            padding-left: 11px; padding-right: 11px;
            padding-top: 4px; padding-bottom: 2px;
            spacing: 5px;
            alignment: center;
            Text {
                text: label;
                font-size: Theme.fs-xs;
                font-weight: on ? 700 : 400;
                color: on ? Theme.accent : Theme.text-secondary;
                vertical-alignment: center;
            }
            Rectangle {
                width: tab-count.preferred-width + 10px;
                height: 15px;
                border-radius: 8px;
                border-width: 1px;
                border-color: on ? Theme.accent.with-alpha(0.35) : Theme.border-subtle;
                background: on ? Theme.accent-soft : Theme.popup-bg-inset;
                tab-count := Text {
                    text: count;
                    font-size: 8px;
                    font-family: Theme.font-mono;
                    color: on ? Theme.accent : Theme.text-muted;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
        Rectangle { height: 4px; }
    }
    if on : Rectangle {
        x: 11px; y: parent.height - 2px;
        width: parent.width - 22px; height: 2px;
        border-radius: 1px;
        background: Theme.accent;
    }
    TouchArea {
        clicked => {
            if (!on) {
                picked(idx);
            }
        }
    }
}

export component QuickSearchDialog inherits Rectangle {
    // 组件自有状态（实例处与 AppWindow 根属性绑定——Slint 组件内 root
    // 指自身，双向绑定外部属性必须在宿主实例处写）。
    in-out property <bool> is-open;
    // 窗口尺寸由实例处传入（PingDialog 同款——组件内拿不到窗口 bounds）。
    in property <length> bounds-w;
    in property <length> bounds-h;
    in-out property <string> qs-search-text;
    in-out property <int> qs-cat;
    in-out property <int> qs-hi;
    in property <[QsRow]> qs-rows;
    in property <[string]> qs-recent-searches;
    in property <[string]> qs-empty-hints;
    // 空结果推荐 chips（高保真 §04 pe-chips：web / docker / 主题 / 日志）。
    in property <[string]> qs-empty-chips;
    in property <QsPreview> qs-preview;
    in property <int> qs-content-px;
    in property <int> qs-row-count;
    in property <string> qs-query-ms;
    in property <string> qs-open-ms;
    in property <int> qs-count-all;
    in property <int> qs-count-session;
    in property <int> qs-count-command;
    in property <int> qs-count-setting;
    in property <int> qs-count-action;

    background: transparent;

    callback close-requested();
    callback qs-open();                 // 打开编排：Rust 重建索引 + 推计数 + 空查询视图
    callback qs-refresh();              // 按 qs-search-text + qs-cat 重查询
    callback qs-move(int);              // ↑↓ / PageUp/Down：跳组头移动选中
    callback qs-sel(int);               // 鼠标点行 / Home / End：绝对选中（Rust clamp）
    callback qs-execute(int, bool);     // 执行（行索引含组头，secondary；Rust 侧经行 qi 解析条目）
    // 纯回调（文案拼装在 Rust：Slint 无 format / 千分位）。
    pure callback empty-title() -> string;
    pure callback index-count-text() -> string;
    pure callback timing-text() -> string;
    // (#qs-scroll-follow 2026-11-14) 行 i 的内容坐标 y / 高(行高拆账与
    // qs-content-px 同源:组头 24 / 数据行 49+17×(lines-1))——选中跟随滚动用。
    pure callback qs-row-top(int) -> length;
    pure callback qs-row-h(int) -> length;
    // (#qs-chips-del 2026-11-14 用户反馈)最近搜索维护:chip 悬停显 × 单条
    // 删除 / 节头右「清空」一键清——Rust 重推 qs-recent-searches。
    // (#qs-chips-del) tooltip(gm 同款自绘):150ms 出、贴指针右上角、出界
    // 翻转、移开即收——**不接 AppWindow 的 topbar-tip-* 槽**,那浮层 z 序在
    // 模态面板之下会被遮住。
    in-out property <string> tip-text: "";
    in-out property <length> tip-ax: 0px;
    in-out property <length> tip-ay: 0px;
    in-out property <bool> tip-show: false;
    qs-tip-timer := Timer {
        interval: 150ms;
        running: root.tip-text != "";
        triggered => { root.tip-show = true; }
    }
    function tip-on(text: string, ax: length, ay: length) {
        root.tip-text = text;
        root.tip-ax = ax;
        root.tip-ay = ay;
        root.tip-show = false;
    }
    function tip-at(ax: length, ay: length) {
        root.tip-ax = ax;
        root.tip-ay = ay;
    }
    function tip-off() {
        root.tip-text = "";
        root.tip-show = false;
    }
    callback qs-remove-recent-search(int /* idx */);
    callback qs-clear-recent-searches();

    property <bool> recent-mode: root.qs-search-text == "";

    // 列表列宽(行/组头显式宽——ScrollView 默认 content-width 会与子项
    // min-width 成环,显式常量断环)。
    // (#qs-narrow 2026-11-14 用户反馈「左右间距没必要这么大宽度」)列宽
    // 56%→52%;行宽再收 12px 给滚动条留独立 gutter(见 #qs-row-gutter)。
    property <length> list-w: card-w * 0.52;

    // 打开编排：复位输入/分类/选中 → 请求 Rust 重建索引 → 0ms Timer 延迟
    // 聚焦输入框（#343：init/事件内同步 focus 会崩，find_bar 同款延迟）。
    property <bool> focus-pending: false;
    changed is-open => {
        if (root.is-open) {
            root.qs-search-text = "";
            root.qs-cat = 0;
            root.qs-hi = 0;
            root.qs-open();
            root.focus-pending = true;
            // (#qs-prune-2026-11-13) 教练提示退役：呼出方式已在脚注/文档
            // 说明，弹一次的气泡是长期噪音（用户评审圈掉）。
        } else {
            // (#qs-drag) 拖动偏移复位：下次打开回到设计稿位。
            root.drag-dx = 0;
            root.drag-dy = 0;
            root.dragging = false;
        }
    }
    Timer {
        interval: 0ms;
        running: root.focus-pending;
        triggered => {
            root.focus-pending = false;
            qs-input.focus();
        }
    }

    // (#qs-scroll-follow 2026-11-14 用户反馈「方向键往下,搜索内容没跟着滚」)
    // 选中行滚入视口:↑↓ / PageUp/Down / 鼠标点行 / Home/End / refresh 全部
    // 只改 qs-hi,统一在 changed 里把行拉回可视区(顶/底钳制到内容范围)。
    changed qs-hi => {
        if (root.qs-hi < 0 || root.qs-row-count <= 0) { return; }
        let top = root.qs-row-top(root.qs-hi);
        let h = root.qs-row-h(root.qs-hi);
        let vh = list-sv.visible-height;
        let vy = -list-sv.viewport-y;
        let target = top < vy ? top
            : (top + h > vy + vh ? top + h - vh : vy);
        let maxoff = max(0px, list-sv.content-height - vh);
        list-sv.viewport-y = -min(target, maxoff);
    }

    // 面板尺寸：设计稿宽 920 固定，小窗口按 40px 边距收缩。
    // (#qs-h-fit 2026-11-14 用户反馈「长度有些长,根据主界面大小自适应」)
    // 高度改**内容自适应**:行数少时弹框收矮(头 90 + 内容 + 脚 34),
    // 行数多时到上限(窗高−100)出滚动;下限 340 保空结果态/极短内容。
    // body-px = 最近搜索 chips 带(64,条件) + 列表内容高(qs-content-px,
    // 与 Rust rows_from_groups 拆账同源)。高度变化跟 160ms 动画缓过渡。
    property <length> card-w: min(920px, root.bounds-w - 40px);
    property <length> body-px: (root.recent-mode && root.qs-recent-searches.length > 0 ? 64px : 0px)
        + root.qs-content-px * 1px;
    property <length> card-h: min(root.bounds-h - 100px, max(340px, 90px + body-px + 34px));
    property <length> card-x: Theme.snap-to-device((root.bounds-w - card-w) / 2);
    // 顶部偏移 76px（设计稿 padding-top），窗口过矮时钳回 20px。
    // (#qs-h-fit 2026-11-14) 高度自适应后 card-y 改**垂直居中**(边距 20 钳制,
    // 窗口过矮钳下限)——原顶部偏移 76px 会让矮卡片头重脚轻。
    property <length> card-y: Theme.snap-to-device(max(20px, min((root.bounds-h - card-h) / 2, root.bounds-h - card-h - 20px)));
    // (#qs-drag 2026-11-13) 卡片空白处拖动（高亮设置弹框同款）：不改写
    // card-x/card-y 绑定，只累计偏移；关面板复位归零。
    property <length> drag-dx: 0;
    property <length> drag-dy: 0;
    property <bool> dragging: false;
    property <length> drag-ox;
    property <length> drag-oy;
    property <length> drag-cx;
    property <length> drag-cy;

    // 进场动画（常驻元素：opacity / y 随 is-open 过渡）
    opacity: root.is-open ? 1.0 : 0.0;
    animate opacity { duration: PanelAnim.reduced ? 0ms : 120ms; easing: ease-out; }

    Scrim { visible: root.is-open; }

    // 点外关闭（滚动吞层：遮罩上滚轮不透传）
    TouchArea {
        visible: root.is-open;
        clicked => { root.close-requested(); }
        scroll-event(e) => { accept }
    }

    esc-scope := FocusScope {
        x: 0; y: 0; width: 1px; height: 1px;
        key-pressed(k) => {
            if (k.text == Key.Escape) { root.close-requested(); return accept; }
            return reject;
        }
    }

    // ── 卡片 ─────────────────────────────────────────────────────────
    card := Rectangle {
        x: card-x + drag-dx;
        y: (root.is-open ? card-y : card-y - 6px) + drag-dy;
        width: card-w;
        height: card-h;
        border-width: Theme.hairline();
        border-color: Theme.border-strong;
        // (#qs-border-hifi 2026-11-13) 边框/圆角对齐高亮设置弹框：radius-xl
        // （16px×缩放；此前 radius-lg 偏小，观感上「边框线和圆角线不协调」）。
        border-radius: Theme.radius-xl;
        background: Theme.popup-bg;
        drop-shadow-blur: 26px;
        drop-shadow-color: transparent;
        clip: true;
        visible: root.is-open;
        animate y { duration: PanelAnim.reduced ? 0ms : 140ms; easing: ease-out; }

        // 卡片空白吞层 + 空白处拖动（高亮设置弹框同款；8px 边距钳全窗）
        TouchArea {
            pointer-event(ev) => {
                if (ev.kind == PointerEventKind.down) {
                    root.dragging = true;
                    root.drag-ox = root.drag-dx;
                    root.drag-oy = root.drag-dy;
                    root.drag-cx = self.absolute-position.x + self.mouse-x;
                    root.drag-cy = self.absolute-position.y + self.mouse-y;
                } else if (ev.kind == PointerEventKind.up) {
                    root.dragging = false;
                }
            }
            moved => {
                if (root.dragging) {
                    root.drag-dx = clamp(
                        Theme.snap-to-device(root.drag-ox
                            + (self.absolute-position.x + self.mouse-x - root.drag-cx)),
                        8px - card-x, max(8px - card-x, root.bounds-w - card-w - card-x - 8px));
                    root.drag-dy = clamp(
                        Theme.snap-to-device(root.drag-oy
                            + (self.absolute-position.y + self.mouse-y - root.drag-cy)),
                        8px - card-y, max(8px - card-y, root.bounds-h - card-h - card-y - 8px));
                }
            }
        }

        // ── 输入区 52px（底边线独立画：Slint 无分段 border-width）─────
        Rectangle {
            y: 0; width: 100%; height: 52px;
            HorizontalLayout {
                padding-left: 17px; padding-right: 12px;
                spacing: 10px;
                Icon {
                    glyph: "search";
                    tint: Theme.accent;
                    size: 18px;
                    horizontal-stretch: 0;
                }
                // 输入框（占位符手工模拟；中文输入走 ui-font-family）
                input-box := Rectangle {
                    vertical-stretch: 1;
                    horizontal-stretch: 1;
                    qs-input := TextInput {
                        width: 100%;
                        vertical-alignment: center;
                        font-size: Theme.fs-lg;
                        font-family: Theme.ui-font-family;
                        color: Theme.text-primary;
                        single-line: true;
                        text <=> root.qs-search-text;
                        enabled: root.is-open;
                        changed text => {
                            root.qs-hi = 0;
                            root.qs-refresh();
                        }
                        key-pressed(e) => {
                            if (e.text == Key.Escape) {
                                root.close-requested();
                                return accept;
                            } else if (e.text == Key.DownArrow
                                    || (e.modifiers.control && (e.text == "n" || e.text == "N" || e.text == "\u{000e}"))) {
                                root.qs-move(1);
                                return accept;
                            } else if (e.text == Key.UpArrow
                                    || (e.modifiers.control && (e.text == "p" || e.text == "P" || e.text == "\u{0010}"))) {
                                root.qs-move(-1);
                                return accept;
                            } else if (e.text == Key.Return || e.text == "\n") {
                                // 传行索引（含量组头）——Rust 侧经行 qi 解析
                                // 条目（#qs-execute-row-fix）。
                                root.qs-execute(root.qs-hi, e.modifiers.control);
                                return accept;
                            } else if (e.text == Key.Tab) {
                                // Tab / Shift+Tab 循环切分类（焦点留在输入框）
                                root.qs-cat = Math.mod(root.qs-cat + (e.modifiers.shift ? 4 : 1), 5);
                                root.qs-hi = 0;
                                root.qs-refresh();
                                return accept;
                            } else if (e.modifiers.alt && e.text == "1") {
                                root.qs-cat = 0;
                                root.qs-hi = 0;
                                root.qs-refresh();
                                return accept;
                            } else if (e.modifiers.alt && e.text == "2") {
                                root.qs-cat = 1;
                                root.qs-hi = 0;
                                root.qs-refresh();
                                return accept;
                            } else if (e.modifiers.alt && e.text == "3") {
                                root.qs-cat = 2;
                                root.qs-hi = 0;
                                root.qs-refresh();
                                return accept;
                            } else if (e.modifiers.alt && e.text == "4") {
                                root.qs-cat = 3;
                                root.qs-hi = 0;
                                root.qs-refresh();
                                return accept;
                            } else if (e.modifiers.alt && e.text == "5") {
                                root.qs-cat = 4;
                                root.qs-hi = 0;
                                root.qs-refresh();
                                return accept;
                            } else if (e.text == Key.PageDown) {
                                root.qs-move(8);
                                return accept;
                            } else if (e.text == Key.PageUp) {
                                root.qs-move(-8);
                                return accept;
                            } else if (e.text == Key.Home) {
                                root.qs-sel(0);
                                return accept;
                            } else if (e.text == Key.End) {
                                root.qs-sel(100000);
                                return accept;
                            }
                            return reject;
                        }
                    }
                    if root.qs-search-text == "" : Text {
                        x: 0; y: (parent.height - self.preferred-height) / 2;
                        text: @tr("Search sessions, commands, settings or actions…");
                        font-size: Theme.fs-lg;
                        font-family: Theme.ui-font-family;
                        color: Theme.text-muted;
                        TouchArea { enabled: false; }
                    }
                }
                // (#qs-prune-2026-11-13 r3) 右上角 Esc 键帽钮退役：Esc 语义
                // 已在脚注快捷键行覆盖（用户评审圈掉）。
            }
            Rectangle {
                y: parent.height - 1px; width: 100%; height: 1px;
                background: Theme.border-subtle;
            }
        }

        // ── 分类条 38px ──────────────────────────────────────────────
        Rectangle {
            y: 52px; width: 100%; height: 38px;
            HorizontalLayout {
                padding-left: 12px; padding-right: 12px;
                spacing: 2px;
                QsTab {
                    idx: 0; label: @tr("All");
                    count: root.qs-count-all;
                    on: root.qs-cat == 0;
                    picked(i) => { root.qs-cat = i; root.qs-hi = 0; root.qs-refresh(); }
                }
                QsTab {
                    idx: 1; label: @tr("Sessions");
                    count: root.qs-count-session;
                    on: root.qs-cat == 1;
                    picked(i) => { root.qs-cat = i; root.qs-hi = 0; root.qs-refresh(); }
                }
                QsTab {
                    idx: 2; label: @tr("Commands");
                    count: root.qs-count-command;
                    on: root.qs-cat == 2;
                    picked(i) => { root.qs-cat = i; root.qs-hi = 0; root.qs-refresh(); }
                }
                QsTab {
                    idx: 3; label: @tr("Settings");
                    count: root.qs-count-setting;
                    on: root.qs-cat == 3;
                    picked(i) => { root.qs-cat = i; root.qs-hi = 0; root.qs-refresh(); }
                }
                QsTab {
                    idx: 4; label: @tr("Actions");
                    count: root.qs-count-action;
                    on: root.qs-cat == 4;
                    picked(i) => { root.qs-cat = i; root.qs-hi = 0; root.qs-refresh(); }
                }
                Rectangle { horizontal-stretch: 1; }
                Text {
                    text: @tr("Tab switch");
                    font-size: Theme.fs-2xs;
                    font-family: Theme.font-mono;
                    color: Theme.text-muted;
                    vertical-alignment: center;
                    horizontal-stretch: 0;
                }
            }
            Rectangle {
                y: parent.height - 1px; width: 100%; height: 1px;
                background: Theme.border-subtle;
            }
        }

        // ── 主体：左列表 56% / 右预览 44%（y=90 起，脚注 34px 收尾）──
        list-col := Rectangle {
            x: 0; // ★ Slint 未指定 x 的元素默认居中——必须显式钉左
            y: 90px; width: parent.width * 0.56; height: parent.height - 124px;
            clip: true;

            // 空查询视图顶部：最近搜索 chips（高保真 §04 recent-chips）。
            // 无历史时不占位；Rust 维护 qs-recent-searches（进程内存态）。
            // (#qs-chips-hifi 2026-11-13) 重排：标签升级为分节头行（与列表
            // 「最近使用」分节头同款——mono muted + 右延 1px 分隔线拉通），
            // chips 独立成行。
            // (#qs-chips-pretty 2026-11-14 用户反馈「这布局太丑」)chip 质感
            // 重做：26→28px、**去常驻边框**（1px 描边+胶囊+灰底三层叠=笨重，
            // 透明占位防 hover 高度跳动，hover 才显边）、节头与 chips 行距
            // 4→8 拉开呼吸、节头字 8.5→9px；死属性 selected 退役。
            // (#qs-chips-del 2026-11-14 用户反馈)三处交互补齐：① chip 内
            // 图标/文字交叉轴居中（固定高子项贴顶，坑⑪同族）；② chip 宽度
            // +26→+52——旧账只算了左内距+图标+间距，**右侧内距被 stretch
            // 压没**（文字贴右缘=「右侧很短」）；③ chip 悬停渐显 × 删除钮
            // （常驻占位不跳宽，点击只删不填入——chip-ta 垫底、删钮在其
            // 上层）+ 节头右端「清空」钮（tooltip 走 root.tip-on 桥）。
            if root.recent-mode && root.qs-recent-searches.length > 0 : Rectangle {
                x: 0; y: 0; width: 100%; height: 64px;
                VerticalLayout {
                    alignment: start;
                    // 节头行（分节头同款语言）+ 右端清空钮
                    Rectangle {
                        height: 24px;
                        HorizontalLayout {
                            padding-left: 10px; padding-right: 10px;
                            spacing: 6px;
                            Text {
                                text: @tr("Recent searches");
                                font-size: 9px;
                                font-family: Theme.font-mono;
                                letter-spacing: 1.2px;
                                color: Theme.text-muted;
                                vertical-alignment: center;
                                horizontal-stretch: 0;
                            }
                            Rectangle { height: 1px; background: Theme.border-subtle; opacity: 0.6; horizontal-stretch: 1; }
                            Rectangle {
                                height: 18px;
                                border-radius: 4px;
                                background: clr-ta.has-hover ? Theme.bg-hover : transparent;
                                HorizontalLayout {
                                    padding-left: 6px; padding-right: 6px;
                                    Text {
                                        text: @tr("Clear");
                                        font-size: 9px;
                                        font-family: Theme.font-mono;
                                        letter-spacing: 1px;
                                        color: clr-ta.has-hover ? Theme.text-primary : Theme.text-muted;
                                        vertical-alignment: center;
                                    }
                                }
                                clr-ta := TouchArea {
                                    mouse-cursor: default;
                                    changed has-hover => {
                                        if (self.has-hover) {
                                            root.tip-on(@tr("Clear search history"),
                                                self.absolute-position.x + self.mouse-x,
                                                self.absolute-position.y + self.mouse-y);
                                        } else { root.tip-off(); }
                                    }
                                    pointer-event(__ev) => {
                                        if (__ev.kind == PointerEventKind.move && self.has-hover) {
                                            root.tip-on(@tr("Clear search history"),
                                                self.absolute-position.x + self.mouse-x,
                                                self.absolute-position.y + self.mouse-y);
                                        }
                                    }
                                    clicked => { root.qs-clear-recent-searches(); }
                                }
                            }
                        }
                    }
                    // chips 行
                    HorizontalLayout {
                        padding-left: 10px; padding-right: 10px;
                        padding-top: 8px; padding-bottom: 0px;
                        spacing: 6px;
                        alignment: start;
                        for term[idx] in root.qs-recent-searches : Rectangle {
                            height: 28px;
                            width: chip-tx.preferred-width + 52px;
                            border-width: 1px;
                            border-color: chip-ta.has-hover ? Theme.border-strong : transparent;
                            border-radius: 14px;
                            background: chip-ta.has-hover ? Theme.bg-hover : Theme.popup-bg-inset;
                            animate background { duration: PanelAnim.reduced ? 0ms : 90ms; }
                            // 垫底点击区（先声明=在删除钮下层）：点击 chip 其它
                            // 区域=填入搜索框；删除钮在后声明=点击只删。
                            chip-ta := TouchArea {
                                width: 100%; height: 100%;
                                mouse-cursor: default;
                                clicked => {
                                    root.qs-search-text = term;
                                    root.qs-cat = 0;
                                }
                            }
                            HorizontalLayout {
                                cross-axis-alignment: center;
                                padding-left: 11px; padding-right: 8px;
                                spacing: 5px;
                                Icon {
                                    glyph: "clock";
                                    tint: chip-ta.has-hover ? Theme.text-primary : Theme.text-muted;
                                    size: 11px;
                                    horizontal-stretch: 0;
                                }
                                chip-tx := Text {
                                    text: term;
                                    font-size: Theme.fs-2xs;
                                    color: chip-ta.has-hover ? Theme.text-primary : Theme.text-secondary;
                                    vertical-alignment: center;
                                    horizontal-stretch: 0;
                                }
                                // 悬停渐显 ×（常驻占位不跳宽）；点击只删不填。
                                Rectangle {
                                    width: 12px; height: 12px;
                                    horizontal-stretch: 0;
                                    opacity: chip-ta.has-hover ? 1.0 : 0.0;
                                    border-radius: 3px;
                                    background: chip-dl.has-hover ? Theme.bg-active : transparent;
                                    Icon {
                                        glyph: "close";
                                        tint: chip-dl.has-hover ? Theme.text-primary : Theme.text-muted;
                                        size: 8px;
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                    }
                                    chip-dl := TouchArea {
                                        width: 100%; height: 100%;
                                        mouse-cursor: default;
                                        changed has-hover => {
                                            if (self.has-hover) {
                                                root.tip-on(@tr("Remove this search"),
                                                    self.absolute-position.x + self.mouse-x,
                                                    self.absolute-position.y + self.mouse-y);
                                            } else { root.tip-off(); }
                                        }
                                        pointer-event(__ev) => {
                                            if (__ev.kind == PointerEventKind.move && self.has-hover) {
                                                root.tip-on(@tr("Remove this search"),
                                                    self.absolute-position.x + self.mouse-x,
                                                    self.absolute-position.y + self.mouse-y);
                                            }
                                        }
                                        clicked => { root.qs-remove-recent-search(idx); }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            list-sv := ScrollView {
                x: 0;
                y: root.recent-mode && root.qs-recent-searches.length > 0 ? 64px : 0px;
                width: 100%;
                height: parent.height - (root.recent-mode && root.qs-recent-searches.length > 0 ? 64px : 0px);
                // (#qs-scrollbar 2026-11-14 用户反馈原生滚动条不协调:粗条+上下
                // 箭头键)原生条退役,右侧自绘细圆角 thumb(见 sv 后的叠层)。
                vertical-scrollbar-policy: ScrollBarPolicy.always-off;
                content-width: self.visible-width;
                content-height: max(self.visible-height, root.qs-content-px * 1px);
                VerticalLayout {
                    alignment: start;
                    for r[i] in root.qs-rows : VerticalLayout {
                        if r.kind == 0 : Rectangle {
                            width: root.list-w - 12px;   // (#qs-row-gutter) 右收 12px:选中底色不再压到滚动条下
                            height: 24px;
                            HorizontalLayout {
                                padding-left: 10px; padding-right: 8px;   // (#qs-narrow) 左右内距收紧
                                spacing: 6px;
                                Text {
                                    text: r.title;
                                    font-size: 8.5px;
                                    font-family: Theme.font-mono;
                                    letter-spacing: 1.2px;
                                    color: Theme.text-muted;
                                    vertical-alignment: center;
                                    horizontal-stretch: 0;
                                }
                                Rectangle { height: 1px; background: Theme.border-subtle; opacity: 0.6; horizontal-stretch: 1; }
                            }
                        }
                        if r.kind == 1 : Rectangle {
                            width: root.list-w - 12px;   // (#qs-row-gutter) 同行宽
                            // (#qs-multiline-row 2026-11-13) 多行命令行自适应：
                            // 基准 49px，标题每多一行 +17px（fs-sm 13px 行高
                            // 约 17px）。title wrap 交给标题 Text。
                            height: 49px + max(0, r.lines - 1) * 17px;
                            property <bool> sel: i == root.qs-hi;
                            property <bool> hov: row-ta.has-hover;
                            background: self.sel ? Theme.accent-soft
                                : self.hov ? Theme.bg-hover : transparent;
                            animate background { duration: PanelAnim.reduced ? 0ms : 90ms; }
                            // 左缘选中竖条（2px accent；选中不位移——高保真 §07）
                            if i == root.qs-hi : Rectangle {
                                x: 0; y: 8px;
                                width: 2px; height: parent.height - 16px;
                                border-radius: 1px;
                                background: Theme.accent;
                            }
                            HorizontalLayout {
                                padding-left: 10px; padding-right: 8px;   // (#qs-narrow)
                                spacing: 9px;
                                // 行图标 28×28（选中时 accent 化）。
                                // (#qs-ico-center 2026-11-13 用户截图"图标没有
                                // 居中") 28×28 固定高壳在 HL 交叉轴**顶对齐**
                                // （坑⑪同族）→ 壳改 100% 高拉伸、内层 28×28
                                // 绝对居中（hifi .pl-row align-items:center +
                                // .pl-ico place-items:center 同语义）。
                                Rectangle {
                                    width: 28px; height: parent.height;
                                    horizontal-stretch: 0;
                                    Rectangle {
                                        width: 28px; height: 28px;
                                        y: (parent.height - self.height) / 2;
                                        border-radius: 6px;
                                        // (#qs-ico-unify 2026-11-14 用户反馈「首列图标
                                        // 和尾部图标操作样式统一」)块底/边与尾部徽章
                                        // 同语言:未选中 inset+subtle、选中 bg-active
                                        // 实底+accent 40% 边 —— 旧选中底 elevated 是
                                        // alpha 混合色,叠在选中行 accent-soft 底上会
                                        // 融进行底(图标块视觉「消失」)。
                                        background: i == root.qs-hi ? Theme.bg-active : Theme.popup-bg-inset;
                                        border-width: 1px;
                                        border-color: i == root.qs-hi ? Theme.accent.with-alpha(0.40) : Theme.border-subtle;
                                        Icon {
                                            glyph: r.icon;
                                            tint: r.cat == 1 ? Theme.warning
                                                : r.cat == 3 ? Theme.accent : Theme.text-secondary;
                                            size: 14px;
                                            x: (parent.width - self.width) / 2;
                                            y: (parent.height - self.height) / 2;
                                        }
                                    }
                                }
                                // 主列：标题 + 副标题
                                Rectangle {
                                    horizontal-stretch: 1;
                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 1px;
                                        Text {
                                            text: r.title;
                                            font-size: Theme.fs-sm;
                                            color: r.kind == 1 && i == root.qs-hi ? Theme.text-primary : Theme.text-secondary;
                                            // (#qs-multiline-row) 多行命令原样换行
                                            // 展示；单行仍 elide 截断。
                                            wrap: r.lines > 1 ? word-wrap : no-wrap;
                                            overflow: elide;
                                        }
                                        Text {
                                            text: r.sub;
                                            font-size: Theme.fs-xs;
                                            color: Theme.text-muted;
                                            overflow: elide;
                                            // 命令与会话行的副标题等宽（高保真 .mono）
                                            font-family: r.cat <= 1 ? Theme.font-mono : Theme.ui-font-family;
                                        }
                                    }
                                }
                                // 右列：快捷键 / 已打开 / 分类徽章 / ↵
                                Rectangle {
                                    horizontal-stretch: 0;
                                    VerticalLayout {
                                        alignment: center;
                                        HorizontalLayout {
                                            alignment: end;
                                            spacing: 6px;
                                            if r.shortcut != "" : Rectangle {
                                                height: 16px;
                                                border-width: 1px;
                                                border-radius: 3px;
                                                background: Theme.popup-bg-inset;
                                                HorizontalLayout {
                                                    padding-left: 4px; padding-right: 4px;
                                                    Text {
                                                        text: r.shortcut;
                                                        font-size: 8px;
                                                        font-family: Theme.font-mono;
                                                        color: Theme.text-secondary;
                                                        vertical-alignment: center;
                                                    }
                                                }
                                                Rectangle {
                                                    y: parent.height - 1px; width: 100%; height: 1px;
                                                    background: Theme.border-subtle;
                                                }
                                            }
                                            if r.open : Rectangle {
                                                height: 16px;
                                                border-radius: 3px;
                                                background: Theme.success.with-alpha(0.14);
                                                HorizontalLayout {
                                                    padding-left: 4px; padding-right: 4px;
                                                    Text {
                                                        text: @tr("Open");
                                                        font-size: 8px;
                                                        color: Theme.success;
                                                        vertical-alignment: center;
                                                    }
                                                }
                                            }
                                            if r.badge != "" && !r.open : Rectangle {
                                                height: 16px;
                                                border-width: 1px; border-color: Theme.border-subtle;
                                                border-radius: 3px;
                                                background: Theme.popup-bg-inset;
                                                HorizontalLayout {
                                                    padding-left: 4px; padding-right: 4px;
                                                    Text {
                                                        text: r.badge;
                                                        font-size: 8px;
                                                        color: i == root.qs-hi ? Theme.accent : Theme.text-muted;
                                                        vertical-alignment: center;
                                                    }
                                                }
                                            }
                                            if i == root.qs-hi && r.badge == "" && r.shortcut == "" : Rectangle {
                                                // (#qs-ico-unify 2026-11-14) ↵ 也进
                                                // 键帽块(16×16 与徽章同规格,选中语言
                                                // bg-active+accent 边)——此前裸图标与
                                                // 尾部徽章风格不齐。
                                                width: 16px; height: 16px;
                                                border-radius: 3px;
                                                background: Theme.bg-active;
                                                border-width: 1px;
                                                border-color: Theme.accent.with-alpha(0.40);
                                                // (#qs-enter-glyph 2026-11-13 用户
                                                // 截图"每行后面的丨是什么") ↵ 字符
                                                // 在 mono 字体缺字形,回退渲染成
                                                // 「丨」——换 corner-down-left 图标
                                                // (高保真 .pl-enter 同位语义)。
                                                Icon {
                                                    glyph: "corner-down-left";
                                                    tint: Theme.accent;
                                                    size: 9px;
                                                    x: (parent.width - self.width) / 2;
                                                    y: (parent.height - self.height) / 2;
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                            row-ta := TouchArea {
                                clicked => {
                                    root.qs-sel(i);
                                }
                                double-clicked => {
                                    // 设计稿「行单击/双击：选中/执行」
                                    root.qs-sel(i);
                                    root.qs-execute(i, false);
                                }
                            }
                        }
                    }
                }
            }

            // (#qs-scrollbar 2026-11-14) 自绘滚动条：右缘 4px 细圆角 thumb
            // (轨道透明,无箭头——原生条粗+箭头键与面板语言不搭)。thumb 高/位
            // 由 viewport 比例驱动;拖拽 = 指针位移 × (内容高/轨道高) 映射回
            // viewport-y。位置叠在 sv 之上(x 缩进 9px 避让行尾徽章 12px 空隙)。
            if list-sv.content-height > list-sv.visible-height : sb-track := Rectangle {
                x: root.list-w - 8px;   // 在 12px gutter 内居中
                y: root.recent-mode && root.qs-recent-searches.length > 0 ? 66px : 0px;
                width: 4px;
                height: list-sv.visible-height;
                property <length> max-off: max(0px, list-sv.content-height - list-sv.visible-height);
                property <length> thumb-h: max(24px, self.height * (list-sv.visible-height / max(1px, list-sv.content-height)));
                Rectangle {
                    width: 4px;
                    height: sb-track.thumb-h;
                    // 位置 = 滚动进度比例 × (轨道高 − thumb 高)。
                    y: (list-sv.content-height > 0px && sb-track.max-off > 0px)
                        ? ((0px - list-sv.viewport-y) / sb-track.max-off) * (sb-track.height - self.height)
                        : 0px;
                    x: 0;
                    border-radius: 2px;
                    background: sb-ta.has-hover || sb-ta.pressed ? Theme.border-strong : Theme.border-subtle;
                    animate background { duration: 90ms; }
                    sb-ta := TouchArea {
                        width: parent.width + 4px;   // 抓区放宽到 8px
                        x: -2px;
                        height: parent.height;
                        mouse-cursor: default;
                        property <length> grab-y;
                        property <length> grab-vy;
                        pointer-event(ev) => {
                            if (ev.kind == PointerEventKind.down) {
                                self.grab-y = self.absolute-position.y + self.mouse-y;
                                self.grab-vy = list-sv.viewport-y;
                            }
                        }
                        moved => {
                            let dy = (self.absolute-position.y + self.mouse-y) - self.grab-y;
                            // thumb 满程(轨道高−thumb 高) ↔ 内容满程 max-off,
                            // 精确映射:拖到轨道底 = 内容到底。
                            let run = max(1px, sb-track.height - sb-track.thumb-h);
                            let scale = sb-track.max-off / run;
                            list-sv.viewport-y = max(-(sb-track.max-off), min(0px, self.grab-vy - dy * scale));
                        }
                    }
                }
            }

            // ── 空结果态（列表区覆盖层；空查询=最近视图，不进这里）────
            if root.qs-row-count == 0 && !root.recent-mode : Rectangle {
                x: 0; y: 0; width: 100%; height: 100%;
                background: Theme.popup-bg;
                VerticalLayout {
                    alignment: center;
                    spacing: 8px;
                    padding-left: 30px; padding-right: 30px; padding-bottom: 18px;
                    // 图标（HL 包裹才居中——VL 交叉轴默认左对齐）
                    HorizontalLayout {
                        width: 100%;
                        alignment: center;
                        Rectangle {
                            width: 44px; height: 44px;
                            horizontal-stretch: 0;
                            border-radius: Theme.radius-lg;
                            background: Theme.popup-bg-inset;
                            border-width: 1px; border-color: Theme.border-subtle;
                            Icon {
                                glyph: "search";
                                tint: Theme.text-muted;
                                size: 20px;
                            }
                        }
                    }
                    Text {
                        text: root.empty-title();
                        font-size: Theme.fs-sm;
                        color: Theme.text-primary;
                        horizontal-alignment: center;
                        width: 100%;
                    }
                    Text {
                        text: @tr("Check spelling, try a shorter keyword, or switch to a specific category with Tab.");
                        font-size: Theme.fs-2xs;
                        color: Theme.text-muted;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                        width: 100%;
                    }
                    for h in root.qs-empty-hints : Text {
                        text: h;
                        font-size: Theme.fs-2xs;
                        color: Theme.text-secondary;
                        horizontal-alignment: center;
                        width: 100%;
                    }
                    // 推荐 chips（高保真 §04 pe-chips）：点一下即把词填进搜索框
                    HorizontalLayout {
                        width: 100%;
                        alignment: center;
                        spacing: 5px;
                        for term in root.qs-empty-chips : Rectangle {
                            height: 22px;
                            horizontal-stretch: 0;
                            width: empty-chip-tx.preferred-width + 16px;
                            border-width: 1px; border-color: Theme.border-subtle;
                            border-radius: 11px;
                            background: Theme.popup-bg-inset;
                            empty-chip-tx := Text {
                                text: term;
                                font-size: Theme.fs-2xs;
                                color: Theme.text-secondary;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                horizontal-stretch: 0;
                            }
                            TouchArea {
                                clicked => {
                                    root.qs-search-text = term;
                                    root.qs-hi = 0;
                                    root.qs-refresh();
                                }
                            }
                        }
                    }
                }
            }
        }

        // ── 预览区 44% ────────────────────────────────────────────────
        Rectangle {
            x: parent.width * 0.56;
            y: 90px;
            width: parent.width * 0.44;
            height: parent.height - 124px;
            clip: true;

            if root.qs-preview.has-item : VerticalLayout {
                padding-top: 14px; padding-bottom: 12px;
                padding-left: 16px; padding-right: 16px;
                spacing: 10px;
                // 头部：图标 + 标题 + 分类 chip
                HorizontalLayout {
                    spacing: 9px;
                    Rectangle {
                        width: 32px; height: 32px;
                        horizontal-stretch: 0;
                        border-radius: 7px;
                        background: Theme.popup-bg-inset;
                        border-width: 1px; border-color: Theme.border-subtle;
                        Icon {
                            glyph: root.qs-preview.icon;
                            tint: Theme.accent;
                            size: 16px;
                        }
                    }
                    Text {
                        text: root.qs-preview.title;
                        font-size: Theme.fs-lg;
                        font-weight: 700;
                        color: Theme.text-primary;
                        overflow: elide;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    Rectangle {
                        width: pv-chip.preferred-width + 12px;
                        height: 18px;
                        border-radius: 3px;
                        background: Theme.accent-soft;
                        border-width: 1px; border-color: Theme.accent.with-alpha(0.35);
                        pv-chip := Text {
                            text: root.qs-preview.cat;
                            font-size: 8px;
                            color: Theme.accent;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
                // 描述（空 = 不占位）
                if root.qs-preview.desc != "" : Text {
                    text: root.qs-preview.desc;
                    font-size: Theme.fs-2xs;
                    color: Theme.text-secondary;
                    wrap: word-wrap;
                }
                // meta 表（66px 标签列 + 值列）
                for m in root.qs-preview.metas : HorizontalLayout {
                    spacing: 10px;
                    Text {
                        text: m.label;
                        font-size: Theme.fs-2xs;
                        color: Theme.text-muted;
                        width: 66px;
                        wrap: word-wrap;
                    }
                    Text {
                        text: m.value;
                        font-size: Theme.fs-xs;
                        color: Theme.text-primary;
                        font-family: m.mono ? Theme.font-mono : Theme.ui-font-family;
                        wrap: word-wrap;
                        horizontal-stretch: 1;
                    }
                }
                // 命令代码块（命令类专属）
                if root.qs-preview.code != "" : Rectangle {
                    border-width: 1px; border-color: Theme.border-subtle;
                    border-radius: 5px;
                    background: Theme.popup-field;
                    clip: true;
                    HorizontalLayout {
                        padding-left: 9px; padding-right: 9px;
                        padding-top: 7px; padding-bottom: 7px;
                        Text {
                            text: root.qs-preview.code;
                            font-size: Theme.fs-xs;
                            font-family: Theme.font-mono;
                            color: Theme.text-primary;
                            wrap: word-wrap;
                        }
                    }
                }
                Rectangle { vertical-stretch: 1; }
                // (#qs-prune-2026-11-13) 预览底部「Enter 连接 / Ctrl+Enter 新标
                // 签连接」按钮组退役：脚注已有同语义快捷键提示，主/次操作由
                // 行点击与键盘直接承担（用户评审圈掉）。
            }
            if !root.qs-preview.has-item : Text {
                text: root.recent-mode ? @tr("Type to search; results appear instantly.")
                    : @tr("Nothing to preview");
                font-size: Theme.fs-2xs;
                color: Theme.text-muted;
                horizontal-alignment: center;
                vertical-alignment: center;
                width: 100%; height: 100%;
            }
        }

        // ── 脚注 34px ─────────────────────────────────────────────────
        // (#qs-footer-radius 2026-11-13) 左下/右下圆角被脚注实色条压没：
        // 条铺满 100% 宽把卡片 border + radius-xl 的圆角区涂掉了。左右各
        // 收 1px 露出边线；高度 34px 不变（圆角 16px 只影响底部两角，
        // 34px 高的条左右缩进后圆角由卡片自身的底边线兜住）。
        Rectangle {
            x: 1px; y: parent.height - 34px; width: parent.width - 2px; height: 34px;
            background: Theme.popup-bg-inset;
            HorizontalLayout {
                padding-left: 12px; padding-right: 12px;
                spacing: 10px;
                HorizontalLayout {
                    spacing: 3px;
                    alignment: center;
                    Text { text: "↑↓"; font-size: 8px; font-family: Theme.font-mono; color: Theme.text-secondary; vertical-alignment: center; }
                    Text { text: @tr("Select"); font-size: 8.5px; color: Theme.text-muted; vertical-alignment: center; }
                }
                Text { text: "·"; font-size: 8.5px; color: Theme.border-subtle; vertical-alignment: center; }
                HorizontalLayout {
                    spacing: 3px;
                    alignment: center;
                    Text { text: "Enter"; font-size: 8px; font-family: Theme.font-mono; color: Theme.text-secondary; vertical-alignment: center; }
                    Text { text: @tr("Run"); font-size: 8.5px; color: Theme.text-muted; vertical-alignment: center; }
                }
                Text { text: "·"; font-size: 8.5px; color: Theme.border-subtle; vertical-alignment: center; }
                HorizontalLayout {
                    spacing: 3px;
                    alignment: center;
                    Text { text: "Ctrl+Enter"; font-size: 8px; font-family: Theme.font-mono; color: Theme.text-secondary; vertical-alignment: center; }
                    Text { text: @tr("Secondary"); font-size: 8.5px; color: Theme.text-muted; vertical-alignment: center; }
                }
                Text { text: "·"; font-size: 8.5px; color: Theme.border-subtle; vertical-alignment: center; }
                HorizontalLayout {
                    spacing: 3px;
                    alignment: center;
                    Text { text: "Tab"; font-size: 8px; font-family: Theme.font-mono; color: Theme.text-secondary; vertical-alignment: center; }
                    Text { text: @tr("Category"); font-size: 8.5px; color: Theme.text-muted; vertical-alignment: center; }
                }
                Rectangle { horizontal-stretch: 1; }
                // (#qs-prune-2026-11-13 r4) 孤立绿点退役：语义不明（原为
                // "索引就绪"状态指示），悬在索引文字上方位置怪（用户评审圈掉）。
                Text {
                    text: root.index-count-text();
                    font-size: 8.5px;
                    font-family: Theme.font-mono;
                    color: Theme.text-muted;
                    vertical-alignment: center;
                }
                Text {
                    text: root.timing-text();
                    font-size: 8.5px;
                    font-family: Theme.font-mono;
                    color: Theme.text-muted;
                    vertical-alignment: center;
                }
            }
        }

        // ── 悬浮提示浮层（gm 同款：贴指针右上角，右/顶出界翻转）──
        if root.tip-show && root.tip-text != "" : Rectangle {
            property <length> tip-w: qs-tip-label.preferred-width + 16px;
            x: root.tip-ax - root.absolute-position.x + 14px + tip-w > root.bounds-w - 8px
                ? root.tip-ax - root.absolute-position.x - tip-w - 14px
                : root.tip-ax - root.absolute-position.x + 14px;
            y: root.tip-ay - root.absolute-position.y - 28px < 8px
                ? root.tip-ay - root.absolute-position.y + 18px
                : root.tip-ay - root.absolute-position.y - 28px;
            height: 24px;
            width: tip-w;
            border-radius: 6px;
            border-width: 1px;
            border-color: Theme.border-strong;
            background: Theme.popup-bg-elevated;
            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                alignment: center;
                qs-tip-label := Text {
                    text: root.tip-text;
                    color: Theme.text-primary;
                    font-size: 11px;
                    vertical-alignment: center;
                    overflow: elide;
                    max-width: 240px;
                }
            }
        }
    }
}
