    in-out property <string> chbar-stat-tip;
    in-out property <length> chbar-stat-tip-x;
    in-out property <length> chbar-stat-tip-y;
    in-out property <string> menu-channel-letter: "";
    in-out property <bool> menu-channel-paused: false;
    // WebDAV config sync (#185): manual upload/download of portable session JSON.
    in-out property <bool> webdav-enabled: false;
    in-out property <string> webdav-url;
    in-out property <string> webdav-username;
    in-out property <string> webdav-password;
    in-out property <string> webdav-remote-path;
    in-out property <bool> webdav-accept-invalid-certs: false;
    in-out property <string> webdav-status;
    callback save-webdav-settings(bool, string, string, string, string, bool);
    callback webdav-upload();
    callback webdav-download();
    in-out property <length> sftp-panel-height: 220px; // shared; lets Rust locate the drop zone
    in-out property <length> sftp-panel-width: 380px;  // SFTP extent when docked left/right
    in-out property <string> sftp-dock: "bottom";      // SFTP dock edge, shared across tabs
    callback pick-download-dir();            // open a folder picker
    callback open-download-dir();            // reveal the folder in the OS
    callback clear-transfers();              // wipe the transfer history
    callback cancel-transfer(string);        // cancel an in-progress transfer by id (#100)
    callback set-language(string);           // switch UI language ("zh" / "en")

    // --- Built-in file viewer/editor (#70) --------------------------------
    in-out property <bool> editor-open: false;
    in-out property <string> editor-name;     // file name shown in the title
    in-out property <string> editor-path;     // remote path (used on save)
    in-out property <string> editor-content;  // text, two-way with the input
    in-out property <bool> editor-readonly;   // view = true, edit = false
    in-out property <bool> editor-dirty: false; // edited since load
    // Opening the dynamic editor and focusing its TextInput in the same event
    // can re-enter Windows AccessKit while it is registering the new item tree.
    property <bool> editor-focus-pending: false;
    in-out property <[string]> editor-lines; // logical lines, measured with editor wrapping
    in-out property <string> editor-find-query;
    in-out property <string> editor-replace-text;
    in-out property <int> editor-match-count: 0;
    in-out property <int> editor-find-position: -1;
    callback save-file();                     // Ctrl+S / Save button (edit only)
    callback close-editor();                  // X / Esc; discard unsaved edits (#287)
    callback editor-recount(string);          // rebuild line numbers after an edit
    callback editor-count-matches(string /* content */, string /* query */) -> int;
    callback editor-find-step(string /* content */, string /* query */, int /* current */, bool /* reverse */) -> EditorFindResult;
    callback editor-replace-all(string /* query */, string /* replacement */);
    // Editor card geometry: draggable by its title bar, resizable from the
    // bottom-right grip (same absolute-position pattern as the Interface
    // dialog). Defaults centre the card; user drags/resizes override them.
    property <length> ed-w: 760px;
    property <length> ed-h: 560px;
    property <length> ed-x: (root.width - root.ed-w) / 2;
    property <length> ed-y: (root.height - root.ed-h) / 2;
    property <bool> ed-dragging;
    property <bool> ed-resizing;
    property <length> ed-base-x;
    property <length> ed-base-y;
    property <length> ed-base-w;
    property <length> ed-base-h;
    property <length> ed-grab-x;
    property <length> ed-grab-y;

    // --- Session list ------------------------------------------------------
    in property <[SessionInfo]> sessions;
    // Bumped by Rust whenever the sessions model is rebuilt wholesale
    // (set_vec). A rebuild destroys the dragging row's pointer grab, so
    // Welcome watches this to clear its shared drag state instead of
    // leaving a card lifted forever.
    in property <int> sessions-revision: 0;
    // (#move-to-groups 2026-09-14) 成员右键菜单「移动到」的组清单,由 Rust
    // 在会话列表每次刷新时一并填好(session_models::move_target_groups_model):
    // **默认组恒居首位**,其后是具名组(存储顺序 = 组头拖动维护的顺序)。
    // 取代"遍历 sessions 再过滤"——那版里不可见的行仍各占一个布局 spacing,
    // 菜单中组与组之间被撑出一串空档(用户实测);且默认组在未分组成员被移空
    // 后整行消失,而"第一位永远是默认组"是定稿要求。
    in property <[string]> move-target-groups;
    in-out property <string> host-search-query;
    callback host-search-changed(string);

    // --- Tabs --------------------------------------------------------------
    in property <[TabInfo]> tabs;
    // --- Split panes (v0.5) — flattened from the Rust split tree -----------
    in property <[PaneInfo]> panes;
    in property <[SplitterInfo]> splitters;
    in-out property <string> active-tab-id: "welcome";
    // (#polish-topbar-r4) 切换标签后,把新活动终端的命令栏状态刷进全局镜像
    // (顶栏按钮的激活态随之联动)。
    in property <[TerminalState]> terminals;
    // (#rdp-vnc-embedded) Built-in remote-desktop tabs. Parallel to `terminals`:
    // a pane shows whichever of the two models its active tab belongs to.
    in property <[RemotePaneState]> remote-panes;

    // --- Dialog state ------------------------------------------------------
    in-out property <bool> dialog-open: false;
    in-out property <bool> dialog-editing: false;
    in-out property <string> dialog-id;
    in-out property <string> dialog-name;
    in-out property <string> dialog-host;
    in-out property <string> dialog-port: "22";
    in-out property <string> dialog-user;
    in-out property <string> dialog-auth: "password";
    in-out property <string> dialog-password;
    in-out property <string> dialog-key-path;
    in-out property <string> dialog-key-inline;
    in-out property <bool> dialog-key-inline-mode: false;
    // (#conn-path) 连接路径三分 + 代理协议与四字段(默认 SOCKS5、直连起步)。
    in-out property <string> dialog-path-type: "direct";  // "direct" | "proxy" | "jump"
    in-out property <string> dialog-proxy-type: "socks5";  // "socks5" | "http"
    in-out property <string> dialog-proxy-host;
    in-out property <string> dialog-proxy-port;
    in-out property <string> dialog-proxy-user;
    in-out property <string> dialog-proxy-pass;
    in-out property <string> dialog-group;
    // Existing group names (from Rust) for the dialog's group dropdown (#179).
    // (#group-dot 2026-09-14) 组名 + 组色:会话对话框的分组下拉要画色点。
    in property <[GroupEntry]> session-groups;
    // (#conn-path) 跳板机链:候选池 / 当前链 + 增删排序回调。
    // (#jump-pool-bind 2026-10-05) exhausted 死属性已删(ChainPicker 按
    // pool.length==0 自行推导),Rust 侧 wire 时一次性绑定两个 model。
    in property <[JumpEntry]> jump-pool;
    in property <[JumpEntry]> jump-chain;
    // (#chain-wrap 2026-10-05) 链分行 model(2 chip/行,Rust 侧分好)。
    // (#chain-cell-r3) 分行升级为按宽度贪心;row-offsets = 每行首 chip 全局序号。
    in property <[[JumpEntry]]> jump-chain-rows;
    in property <[int]> jump-chain-row-offsets;
    callback dialog-chain-add(string);
    // (#chain-width 2026-10-06) 链容器实际宽度(弹框打开/窗口变化时上报)。
    callback dialog-chain-width(float);
    callback dialog-chain-remove(int);
    callback dialog-chain-up(int);
    callback dialog-chain-down(int);
    in-out property <string> dialog-kind: "ssh";
    in-out property <string> dialog-serial-port;
    in-out property <string> dialog-baud: "115200";
    in-out property <string> dialog-data-bits: "8";
    in-out property <string> dialog-stop-bits: "1";
    in-out property <string> dialog-parity: "none";
    in-out property <string> dialog-flow: "none";
    in-out property <string> dialog-encoding: "UTF-8";
    in-out property <bool> dialog-vt100-drawing: false;
    in-out property <bool> dialog-disable-shell-integration: false;
    in-out property <string> dialog-note;
    // Windows logon domain for an RDP session ("" = none).
    in-out property <string> dialog-rdp-domain;
    // "fullscreen" | "custom" | "<width>x<height>" plus the custom size.
    in-out property <string> dialog-rdp-resolution: "1280x720";
    in-out property <string> dialog-rdp-width: "1280";
    in-out property <string> dialog-rdp-height: "720";
    // (#rdp-vnc-embedded) RDP「连接方式」: "system" (mstsc / FreeRDP, the
    // pre-existing behaviour and the default) or "embedded" (MTerm's own client
    // in a tab). Kept as a mirrored AppWindow property because Rust fills the
    // draft when editing an existing session; "system" is the value a draft
    // without this field deserializes to, so old sessions never change mode.
    in-out property <string> dialog-rdp-mode: "system";
    in-out property <bool> dialog-rdp-follow-tab-size: false;
    in-out property <bool> dialog-vnc-view-only: false;
    in-out property <string> dialog-vnc-security: "";
    in-out property <bool> dialog-vnc-clipboard: true;
    in-out property <string> dialog-test-status;

    // Delete-confirmation modal state (#28).
    in-out property <bool> confirm-delete-open: false;
    in-out property <bool> confirm-delete-batch: false;   // delete checked entries (#100)
    in-out property <string> confirm-delete-tab;
    in-out property <string> confirm-delete-path;

    // --- Callbacks up to Rust ---------------------------------------------
    callback new-session-clicked();
    callback import-ssh-config();             // import hosts from ~/.ssh/config
    in-out property <string> ssh-import-hint;  // result text shown after import
    callback export-sessions();               // export all sessions to a file (#46)
    callback import-sessions();               // import sessions from a file (#46)
    in-out property <bool> batch-import-open: false;  // text batch-import dialog (#150)
    in-out property <string> batch-import-text;       // the textarea content
    callback batch-import-confirm(string /* pasted text */);
    // Multi-line terminal paste safety prompt (#262).
    in-out property <bool> paste-confirm-open: false;
    in-out property <string> paste-confirm-tab;
    in-out property <string> paste-confirm-text;
    in-out property <string> paste-confirm-preview;
    in-out property <bool> paste-confirm-large: false;
    // (#sync-dialog-esc) in-out：同步输入弹框确定（Rust apply 路径）后由
    // Rust 递增，把键盘焦点还给活动终端（与下方粘贴确认卡的 += 1 同机制）。
    in-out property <int> terminal-focus-sequence;
    callback paste-confirmed(string /* tab-id */);
    callback paste-confirm-cancelled();
    callback connect-session(string /* session-id */);
    callback edit-session(string /* session-id */);
    callback duplicate-session(string /* session-id */);
    callback move-session(string /* session-id */, string /* group */);
    callback reorder-session(string /* session-id */, int /* dir: -1 up, 1 down */) -> bool;
    callback move-session-to(string /* session-id */, string /* target-id */, bool /* after */);   // (#drag-ghost-pointer) 几何落位:移到目标行前/后并继承其组(#in-group-only 唯一拖拽提交)
    callback reorder-group(string /* group */, string /* before-group */);   // (#group-sort-line-r2) 组排序:移到目标组之前(与插入线同源)
    callback reorder-session-end();
    callback toggle-group(string /* group */);
    callback remove-session(string /* session-id */);
    callback session-dialog-submit(SessionDraft);
    callback session-dialog-test(SessionDraft);
    callback session-dialog-cancel();
    callback session-dialog-pick-key();
    // Port forwards for the session being edited (#56).
    in-out property <[PortFwd]> dialog-forwards;
    in-out property <[TriggerDraft]> dialog-triggers;
    callback add-forward();
    callback update-forward(int /* index */, PortFwd);
    callback delete-forward(int /* index */);
    callback add-trigger();
    callback update-trigger(int /* index */, TriggerDraft);
    callback delete-trigger(int /* index */);
    callback add-sample-forward();
    callback add-sample-trigger();

    callback tab-selected(string);
    callback tab-closed(string);
    callback new-tab-clicked();
    callback new-window-clicked();   // open another application window (#multi-window)
    // Per-pane tab actions (v0.5): the int is the pane (leaf) id.
    callback pane-tab-selected(int /* pane-id */, string /* tab-id */);
    callback pane-tab-closed(int /* pane-id */, string /* tab-id */);
    callback pane-new-tab(int /* pane-id */);
    // Drag-to-reorder inside a pane's strip (#408), committed once on drop: move
    // the tab at `from` to `to`, where `to` indexes the list with `from` removed.
    callback pane-tab-move(int /* pane-id */, int /* from */, int /* to */);
    // Where a tab dragged in from elsewhere would land in this pane's strip;
    // -1 when the cursor left it. Rust remembers the last report and uses it when
    // the drop lands on a tab strip (#408).
    callback pane-tab-drop-index(int /* pane-id */, int /* index */);
    callback pane-focus(int /* pane-id */);
    callback cycle-tab(bool /* reverse */);
    // Split pane `pane-id`, peeling `tab-id` into a new pane on `dir`
    // ("left"/"right"/"up"/"down").
    callback pane-split(int /* pane-id */, string /* tab-id */, string /* dir */);
    callback pane-merge(int /* pane-id */);
    // Open another connection to the same session as `tab-id` (a new tab).
    callback tab-duplicate(string /* tab-id */);
    // Rename an open session's tab. Request pre-fills the dialog (Rust reads
    // the current title); submit applies the new display name.
    callback tab-rename-request(string /* tab-id */);
    callback rename-tab(string /* tab-id */, string /* new-title */);
    in-out property <bool> tab-rename-open: false;
    in-out property <string> tab-rename-id: "";
    in-out property <string> tab-rename-value: "";
    // Drag-to-split (v0.5): cursor moved / dropped while dragging `tab-id`, in
    // pane-area coordinates. Rust hit-tests the pane + edge zone. `over-own-strip`
    // means the source strip is already showing an insertion gap of its own, so no
    // pane drop-zone must light up (#408).
    callback tab-drag-move(string /* tab-id */, length /* x */, length /* y */,
                           bool /* over-own-strip */);
    callback tab-drag-drop(string /* tab-id */, length /* x */, length /* y */);
    // The drag ended without a drop (pointer grab lost, or an in-strip drag that
    // landed back on its own slot): clear whatever highlight it put up (#408).
    callback tab-drag-cancel();
    // Live tab-drag cursor in pane-area coordinates, republished so every pane's
    // tab strip can tell whether the drag is hovering over it (#408). Pane rects
    // come from the model, so the hit-test below needs nothing from the layout.
    property <bool> tab-drag-live;
    property <length> tab-drag-px;
    property <length> tab-drag-py;
    // Drop-zone highlight (set by Rust during a drag): the region the dropped
    // tab's new pane would occupy.
    in property <bool> drag-active;
    in property <length> drag-hl-x;
    in property <length> drag-hl-y;
    in property <length> drag-hl-w;
    in property <length> drag-hl-h;
    // Splitter drag: move split `split-id`'s boundary to `pos` (px along its axis).
    callback splitter-drag(int /* split-id */, length /* pos */, bool /* vertical */);
    // Reports the pane-area size to Rust so it can flatten the split tree into
    // absolute pane / splitter rects. Fired whenever the content area resizes.
    callback content-resized(length /* w */, length /* h */);
    // pane-area origin in window coordinates; tab drag-out converts
    // drop points to global screen coordinates with this (#tab-detach).
    out property <length> content-origin-x: pane-area.absolute-position.x;
    out property <length> content-origin-y: pane-area.absolute-position.y;
    // Asks Rust to recompute the sidebar (status + resources) for whatever tab
    // is now active.  Fired on every active-tab change, UI- or code-driven.
    callback refresh-sidebar();
    changed active-tab-id => {
        root.refresh-sidebar();
        // (#polish-topbar-r4) 切标签后把新活动终端的命令栏状态刷进全局镜像,
        // 顶栏"命令栏"按钮的激活态随之联动。
        root.sync-active-cmd-bar();
        // Closing the last session destroys the terminal's IME focus anchor
        // and nothing else re-claims focus — with no focused item, Slint
        // delivers keys nowhere, stranding the zen escape shortcut (and every
        // window-level shortcut). Re-anchor on the shortcut scope whenever the
        // welcome tab is active and no terminal remains.
        if (root.active-tab-id == "welcome" && root.terminals.length == 0) {
            shortcut-scope.focus();
        }
    }

    // Raw keystroke forwarding: Rust converts key+modifiers to PTY bytes.
    callback send-key(string /* tab-id */, string /* key */, bool /* ctrl */, bool /* alt */, bool /* shift */);
    callback diagnose-key-event(string /* tab-id */, string /* key */, bool /* raw control */, bool /* raw meta */, bool /* alt */, bool /* shift */);
    // Notifies Rust of a PTY resize (pixel dimensions; Rust converts to cols/rows).
    callback terminal-resize(string /* tab-id */, float /* width-px */, float /* height-px */);

    // --- SFTP callbacks ---------------------------------------------------
    // Navigate to a new remote directory (or ".." to go up).
    callback sftp-navigate(string /* tab-id */, string /* path */);
    // Trigger a download: Rust opens a save-folder dialog then transfers.
    callback sftp-download(string /* tab-id */, string /* remote-path */);
    // Trigger an upload: Rust opens a file-picker dialog then transfers.
    callback sftp-upload-clicked(string /* tab-id */, string /* remote-dir */, bool /* folder */);
    // Refresh the current directory listing.
    callback sftp-refresh(string /* tab-id */, string /* path */);
    // Toggle expand/collapse of a tree node (also navigates to that directory).
    callback sftp-tree-expand(string /* tab-id */, string /* path */);
    callback sftp-delete(string /* tab-id */, string /* path */);
    callback sftp-toggle-select(string /* tab-id */, int /* row */);   // (#100)
    callback sftp-download-selected(string /* tab-id */);              // (#100)
    callback sftp-download-selected-sequential(string /* tab-id */);    // (#100.4)
    callback sftp-download-archive(string /* tab-id */, string /* remote-path */); // (#sftp-archive-zip)
    callback sftp-delete-selected(string /* tab-id */);               // (#100)
    callback sftp-copy-to-target(string /* tab-id */, string /* remote-path */, string /* target-tab-id */);
    callback sftp-copy-selected-to-target(string /* tab-id */, string /* target-tab-id */);
    callback sftp-view(string /* tab-id */, string /* path */);
    callback sftp-edit(string /* tab-id */, string /* path */);
    callback sftp-open-external(string /* tab-id */, string /* path */);
    callback sftp-edit-external(string /* tab-id */, string /* path */);
    callback sftp-sort-request(string /* tab-id */, string /* key */);
    callback sftp-clear-sort(string /* tab-id */);
    callback tunnel-add(string /* tab-id */, string /* name */, string /* kind */, string /* bind */, string /* bind-port */, string /* host */, string /* host-port */);
    callback tunnel-stop(string /* tab-id */, string /* tunnel-id */);
    // SFTP context-menu extensions (#69): rename / chmod / mkdir / touch share
    // one single-input prompt dialog; copy-path goes straight to the clipboard.
    in-out property <bool> sftp-prompt-open: false;
    in-out property <string> sftp-prompt-kind;   // "rename"|"chmod"|"mkdir"|"touch"
    in-out property <string> sftp-prompt-tab;    // tab the action applies to
    in-out property <string> sftp-prompt-target; // path acted on (or parent dir)
    in-out property <string> sftp-prompt-value;  // user input
    callback sftp-prompt-submit(string /* tab */, string /* kind */, string /* target */, string /* value */);
    callback sftp-copy-path(string);             // put the path on the clipboard

    // Visual chmod dialog (#84). Rust decomposes the current mode into nine
    // bools when opening and recomposes on apply (Slint has no bitwise ops).
    in-out property <bool> chmod-open: false;
    in-out property <string> chmod-tab;
    in-out property <string> chmod-path;
    in-out property <string> chmod-name;
    in-out property <bool> chmod-or; in-out property <bool> chmod-ow; in-out property <bool> chmod-ox;
    in-out property <bool> chmod-gr; in-out property <bool> chmod-gw; in-out property <bool> chmod-gx;
    in-out property <bool> chmod-tr; in-out property <bool> chmod-tw; in-out property <bool> chmod-tx;
    callback sftp-chmod-open(string /* tab */, string /* path */, string /* name */, int /* mode */);
    callback sftp-chmod-apply();                  // reads the bools, chmods, closes

    // --- Clipboard callbacks ----------------------------------------------
    // Paste clipboard text into the active terminal.
    callback paste-from-clipboard(string /* tab-id */);
    // Copy the current terminal screen buffer to the clipboard.
    callback copy-terminal-text(string /* tab-id */);
    // Clear a session's terminal buffer (its visible screen + scrollback).
    callback clear-terminal(string /* tab-id */);
    // Recompute search highlights for a session's visible screen.
    callback find-query-changed(string /* tab-id */, string /* query */);
    // Scroll a session's scrollback history by N lines (+ = up/older).
    callback terminal-scroll(string /* tab-id */, float /* delta-lines (fractional, momentum-aware) */);
    // Wheel forwarded to an alt-screen program (#170): tab-id, dir (+1 up/-1 down), col, row.
    callback terminal-wheel(string, int, int, int);
    callback terminal-scroll-to(string /* tab-id */, int /* offset */); // scrollbar drag (#103)
    // Mouse event forwarded to a mouse-tracking TUI app (#terminal-mouse).
    callback terminal-mouse(string /* tab-id */, int /* kind */, int /* button */, int /* row */, int /* col */) -> bool;
    // --- Built-in remote desktop (#rdp-vnc-embedded) -------------------------
    // Coordinates arriving here are already remote-frame pixels: the view does
    // the letterbox mapping, so Rust never sees tab-local pixels (P0-8).
    callback remote-key(string /* tab-id */, string /* key */, bool /* down */,
                        bool /* ctrl */, bool /* shift */, bool /* alt */, bool /* meta */);
    // `action`: 0 = move, 1 = press, 2 = release. The button *mask* is rebuilt
    // in Rust, where the protocols actually need it.
    callback remote-pointer(string /* tab-id */, int /* x */, int /* y */, int /* button */, int /* action */);
    callback remote-wheel(string /* tab-id */, int /* x */, int /* y */, float /* dx */, float /* dy */);
    callback remote-release-keys(string /* tab-id */);
    callback remote-resized(string /* tab-id */, int /* width */, int /* height */);
    callback remote-reconnect(string /* tab-id */);
    callback remote-trust-decide(string /* tab-id */, bool /* accept */, bool /* remember */);
    // Drag-selection lifecycle (grid row/col coordinates).
    callback term-select-start(string /* tab-id */, int /* row */, int /* col */, bool /* ctrl */, bool /* shift */);
    callback term-select-update(string /* tab-id */, int /* row */, int /* col */);
    callback term-select-end(string /* tab-id */);
    callback term-select-word(string /* tab-id */, int /* row */, int /* col */);
    callback term-select-autoscroll(string /* tab-id */, int /* dir */);

    // Immersive wallpaper layer — painted behind everything, filling the window.
    // Panels/terminal frost over it (see Theme.frost). Only present when active.
    if Theme.wallpaper-active : Image {
        x: 0; y: 0;
        width: parent.width;
        height: parent.height;
        source: Theme.wallpaper;
        image-fit: cover;
        // (#theme-split) 图自身可见度由「壁纸可见度」滑杆独立控制（0–100）。
        opacity: Theme.wallpaper-visible;
    }

    // Zen (focus) mode keyboard toggle — same persist path as the Settings
    // switch (#zen).
    toggle-zen-key => {
        root.zen-mode = !root.zen-mode;
        root.set-zen-mode(root.zen-mode);
        // Entering zen with no terminals can leave nothing focused (the
        // welcome page may be hidden as a sidebar), which would strand the
        // Ctrl+Alt+Z escape shortcut — anchor focus on the shortcut scope.
        if (root.zen-mode && root.terminals.length == 0) {
            shortcut-scope.focus();
        }
    }

    // Window-wide shortcut interceptor (#multi-window). Slint delivers a key
    // to the focused item first and only bubbles it up the ancestor chain when
    // it is rejected there; a Window itself cannot bind key-pressed. This
    // passive FocusScope therefore wraps the whole main content and catches any
    // shortcut no descendant consumed — so new-window works on the welcome page
    // (where no TerminalView exists yet) and whenever focus is on a non-terminal
    // widget. It never takes focus itself (focus-on-click / focus-on-tab-
    // navigation are off), so it does not disturb the terminal IME anchor or any
    // other widget. A focused terminal accepts ⌘⇧N / Ctrl+Shift+N on its own
    // (terminal_view.slint), which stops propagation, so the two never
    // double-fire.
    shortcut-scope := FocusScope {
        focus-on-click: false;
        focus-on-tab-navigation: false;
        // A window restored into zen mode starts with nothing focused when no
        // focusable widget is on screen (e.g. the welcome page is hidden as a
        // sidebar and no terminal exists yet). Slint delivers keys only to the
        // focused item, so the Ctrl+Alt+Z escape shortcut would be stranded in
        // exactly that stuck state. Claim focus on the next event-loop turn —
        // deferred like the welcome scope so AccessKit/winit aren't re-entered
        // from `init` (#323); any real widget that takes focus later (welcome
        // page, terminal IME anchor) simply overrides this.
        property <bool> zen-focus-pending: false;
        init => { shortcut-scope.zen-focus-pending = root.zen-mode && root.terminals.length == 0; }
        Timer {
            interval: 0ms;
            running: shortcut-scope.zen-focus-pending;
            triggered => {
                shortcut-scope.zen-focus-pending = false;
                shortcut-scope.focus();
            }
        }
        key-pressed(e) => {
            // New window: ⌘⇧N / Ctrl+Shift+N (#multi-window). On macOS Slint
            // maps `control` to Cmd (#158), so this single condition yields ⌘⇧N
            // there and Ctrl+Shift+N elsewhere — identical to the TerminalView
            // branch. \u{000e} is the Ctrl-N control char some backends send.
            if (e.modifiers.control && e.modifiers.shift
                    && (e.text == "n" || e.text == "N"
                        || e.text == "\u{000e}")) {
                root.new-window-clicked();
                accept
            // Font zoom: Ctrl+= / Ctrl+- / Ctrl+0 zooms the active session;
            // adding Alt zooms every session in this window (Alt, not Shift:
            // Ctrl+Shift is the IME-switch hotkey on Chinese Windows). Same
            // keys as the focused-terminal branch (terminal_view.slint); a
            // focused terminal consumes them itself, so no double-fire.
            // Ctrl+- arrives as \u{001f} (^_) on some backends.
            } else if (e.modifiers.control && e.modifiers.alt
                    && (e.text == "=" || e.text == "+" || e.text == "-"
                        || e.text == "\u{001f}" || e.text == "0")) {
                root.zoom-term-font(root.active-tab-id,
                    e.text == "-" || e.text == "\u{001f}" ? -1
                        : e.text == "0" ? 0 : 1, true);
                accept
            } else if (e.modifiers.control && (e.text == "=" || e.text == "+")) {
                root.zoom-term-font(root.active-tab-id, 1, false);
                accept
            } else if (e.modifiers.control && (e.text == "-" || e.text == "\u{001f}")) {
                root.zoom-term-font(root.active-tab-id, -1, false);
                accept
            } else if (e.modifiers.control && e.text == "0") {
                root.zoom-term-font(root.active-tab-id, 0, false);
                accept
            // Zen (focus) mode: Ctrl+Alt+Z toggles, same as the terminal
            // branch below (#zen).
            } else if (e.modifiers.control && e.modifiers.alt
                    && (e.text == "z" || e.text == "Z" || e.text == "\u{001a}")) {
                root.toggle-zen-key();
                accept
            } else {
                reject
            }
        }

        VerticalLayout {
            spacing: 0;

            // macOS immersive bar: a strip under the native traffic-light buttons.
            // Frosted like the other panels (bg-panel) so it matches in both themes —
            // a plain transparent strip would show the raw wallpaper here and look dark
            // in light mode. Left as a plain reserve (no TouchArea) so macOS's own title
            // bar keeps handling the window drag in this region.
            if root.titlebar-inset > 0px : Rectangle {
                height: root.titlebar-inset;
                background: Theme.bg-panel;
            }

            // Immersive custom title bar (#119) — only on frameless platforms
            // (Windows/Linux). App icon + name on the left, a draggable middle
            // (move window / double-click to maximize), then the toolbar icons and
            // window controls on the right. macOS keeps its native title bar and
            // shows the toolbar icons via the overlay further below.
            if root.custom-titlebar : Rectangle {
                // (#titlebar-slim 2026-10-08) 38px → 32px：用户反馈标题栏偏厚，
                // 窄一些 + 左上角 LOGO 放大更协调（Rust app_content_area 的
                // 32.0 与此处联动，改一处必须同步另一处）。
                height: 32px;
                background: Theme.bg-panel;
                tb-drag := TouchArea {
                    pointer-event(e) => {
                        if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                            root.win-drag();
                        }
                    }
                    double-clicked => { root.win-maximize-toggle(); }
                }
                HorizontalLayout {
                    // (#polish-topbar-r5) 贴合窗口左缘:去掉标题栏左 padding,
                    // 呼吸空间由按钮自身的 padding-left(8px)提供。
                    spacing: 8px;
                    // (#logo-brand-btn 2026-10-08) 左上角品牌 LOGO 按钮的占位：
                    // BrandLogoBtn 以根层绝对定位盖在这里(32px),无热区垫片把
                    // 「新建会话」右移让位;垫片不带 TouchArea,点击落到 tb-drag。
                    Rectangle { width: 32px; }
                    // (#polish-topbar-r3 2026-09-05) DBeaver 式「图标 + 文字」
                    // 工具栏:品牌名移除(窗口标题/任务栏已可辨),文字自明故
                    // 无 tooltip;按钮组左对齐,右侧弹性,窗口控制靠右。
                    // 新建会话 —— 打开会话对话框(与左侧"+ 新建会话"入口
                    // 对等,DBeaver"新建连接"同型;#polish-topbar-r5)。
                    TopbarBtn { height: parent.height;
                        icon: "add";   // add —— "新建"
                        label: root.lang-en ? "New session" : "新建会话";
                        // 会话对话框(新建/编辑)打开期间保持选中(#polish-topbar-r5)。
                        active: root.dialog-open;
                        clicked => { root.new-session-clicked(); }
                    }
                    // 命令栏开关 —— 每会话独立(#polish-topbar-r4):只切换
                    // 当前活动终端,状态由 Rust 维护并在切标签时联动。
                    TopbarBtn { height: parent.height;
                        icon: "command-bar";   // terminal
                        label: root.lang-en ? "Command" : "命令栏";
                        active: !root.cmd-bar-hidden;
                        clicked => { root.toggle-cmd-bar-active(); }
                    }
                    // 会话同步 —— (#sync-dialog 2026-10-08) 点击弹**同步输入**
                    // 对话框（WindTerm 式：四频道页签 + 双栏成员管理）。
                    TopbarBtn { height: parent.height;
                        icon: "link";
                        label: root.lang-en ? "Sync input" : "同步输入";
                        active: SyncInputState.dialog-open;
                        clicked => { SyncInputState.open-dialog(); }
                    }
                    // 主题切换 —— 单色图标(去彩色特例)。
                    // (#theme-split §3-调整③) 主题速选 —— 图标从 sun/moon 换成
                    // 四宫格调色板（语义 =「配色」而非「亮暗」），点击弹 262px
                    // 速选面板（8 个代表变体 + 跟随系统 + 更多主题）。
                    theme-btn := TopbarBtn { height: parent.height;
                        icon: "palette-grid";
                        label: root.lang-en ? "Theme" : "主题";
                        active: root.theme-pick-open;
                        clicked => {
                            // 与设置页同款浮层（同一个 theme-pick 浮层本体）。
                            // (#theme-pick-anchor 2026-10-08) 旧锚点 = 点击点
                            //（click-y 在按钮内部）——浮层从按钮中间盖上来，
                            // 把「主题」标题都挡住（用户截图）。改锚到**按钮
                            // 矩形下缘** +4px：浮层永远在按钮下方展开。
                            // 打开时先清搜索恢复全量 + 重置键盘索引。
                            root.theme-pick-search = "";
                            root.theme-search-filter("");
                            root.theme-key-idx = -1;
                            root.theme-pick-x = self.click-x - 120px;
                            root.theme-pick-y = self.btn-y + self.btn-h + 4px;
                            root.theme-pick-open = !root.theme-pick-open;
                        }
                    }
                    // 传输管理 —— 呼吸灯 + 下载弹层锚点(transfer-btn)。
                    transfer-btn := TopbarBtn { height: parent.height;
                        icon: "swap-vert";
                        label: root.lang-en ? "Transfers" : "传输";
                        active: root.download-open;
                        breathe: root.has-active-transfers;
                        clicked => {
                            // (#topbar-click-anchor) 弹层跟随本次点击点右下角。
                            root.topbar-click-x = self.click-x;
                            root.topbar-click-y = self.click-y;
                            root.download-open = !root.download-open; root.settings-open = false;
                        }
                        // (#topbar-ctx) 右键同样唤出,位置跟随右击点。
                        ctx-clicked => {
                            root.topbar-click-x = self.click-x;
                            root.topbar-click-y = self.click-y;
                            root.download-open = true; root.settings-open = false;
                        }
                    }
                    // 更多 —— 设置菜单弹层锚点(菜单内第一项才是真正的设置)。
                    // 激活态:菜单开着,或从菜单进入的界面设置弹窗开着——
                    // "更多"在整条链路中保持选中(#polish-topbar-r5)。
                    set-btn := TopbarBtn { height: parent.height;
                        icon: "more-vert";   // more_vert —— "更多"语义(码点已验证)
                        label: root.lang-en ? "More" : "更多";
                        active: root.settings-open || root.interface-open;
                        clicked => {
                            // (#topbar-click-anchor) 弹层跟随本次点击点右下角。
                            root.topbar-click-x = self.click-x;
                            root.topbar-click-y = self.click-y;
                            root.topbar-anchor-x = self.btn-x;
                            root.topbar-anchor-y = self.btn-y;
                            root.topbar-anchor-w = self.btn-w;
                            root.topbar-anchor-h = self.btn-h;
                            root.settings-open = !root.settings-open; root.download-open = false; root.ssh-import-hint = "";
                        }
                        // (#topbar-ctx) 右键同样唤出,位置跟随右击点。
                        ctx-clicked => {
                            root.topbar-click-x = self.click-x;
                            root.topbar-click-y = self.click-y;
                            root.topbar-anchor-x = self.btn-x;
                            root.topbar-anchor-y = self.btn-y;
                            root.topbar-anchor-w = self.btn-w;
                            root.topbar-anchor-h = self.btn-h;
                            root.settings-open = true; root.download-open = false; root.ssh-import-hint = "";
                        }
                    }
                    // Draggable spacer (no TouchArea → clicks fall to tb-drag).
                    Rectangle { horizontal-stretch: 1; }
                    // Window controls only — the app toolbar icons live in the tab
                    // row below, not here (#119).
                    // (#winbtn-seamless) 三键贴连无间隙:高亮区连成一条整带,
                    // 悬停跨键时不断开(Windows 原生窗口控制样式)。
                    HorizontalLayout {
                        spacing: 0;
                        // (#winbtn-full-height) height 补齐行高(43px):与左侧
                        // TopbarBtn 同款实例绑定,hover 高亮铺满整行而非只剩
                        // 图标 preferred 高度(约 16px)。
                        WinBtn { height: parent.height; icon: "remove"; clicked => { root.win-minimize(); } }
                        WinBtn {
                            height: parent.height;
                            icon: root.window-maximized ? "restore" : "maximize";
                            clicked => { root.win-maximize-toggle(); }
                        }
                        WinBtn {
                            height: parent.height;
                            icon: "close";
                            danger: true;
                            // (#winbtn-round-corner) 高亮块贴窗口右上角,圆角随
                            // 最大化(系统改直角)收放,见组件注释。
                            round-top-right: !root.window-maximized;
                            clicked => { root.win-close(); }
                        }
                    }
                }
                // (#titlebar-underline 2026-10-10) 标题栏底缘分隔线:1px
                // border-subtle,与弹框内部分隔线同色同粗。标题栏(bg-panel)
                // 与下方 dock 区(bg-root)之间此前没有任何分界,两块底色的
                // 过渡含混(用户反馈缺一条边线条)。放在 HL 之后 → 盖在
                // WinBtn 悬停高亮的最后一行像素上,1px 无感。
                Rectangle {
                    // (#panel-line-hairline 2026-10-11) 1 设备像素 + 贴设备网格,
                    // 与窗口描边/面板外框同粗细(逻辑 1px 在 200% 屏上是 2 物理
                    // 像素,是主界面上唯一还剩的粗线)。
                    y: Theme.snap-to-device(parent.height) - Theme.hairline();
                    width: 100%;
                    height: Theme.hairline();
                    background: Theme.border-subtle;
                }
            }

            // Dock area — fills below the title bar. The resource sidebar and the
            // central content are positioned by absolute geometry computed from
            // `sidebar-dock`, so the sidebar can sit on any window edge (#dock).
            dock-area := Rectangle {
            vertical-stretch: 1;
            // Left-edge layout (welcome-as-sidebar mode): a thin always-on icon strip
            // (IDEA-style) + the welcome/session sidebar (0 when collapsed). The rest
            // (resource panel + central terminal, which never collapses) sits to their
            // right in `rest`.
            // Collapsed-only (M5): the icon strip shows only while collapsed; the
            // panel itself (welcome-w) only while expanded — one or the other.
            property <bool> sidebar-strip-outside:
                !root.zen-mode && root.welcome-as-sidebar && !root.welcome-collapsed
                && root.sidebar-collapsed && root.sidebar-dock == root.welcome-sidebar-dock;
            property <length> sidebar-outside-strip: dock-area.sidebar-strip-outside ? 36px : 0px;
            property <length> welcome-strip: (!root.zen-mode && root.welcome-as-sidebar && root.welcome-collapsed) ? 36px : 0px;
            property <length> welcome-size: (!root.zen-mode && root.welcome-as-sidebar && !root.welcome-collapsed) ? root.welcome-sidebar-width : 0px;
            property <length> welcome-taken: welcome-strip + welcome-size + sidebar-outside-strip;
            property <bool> welcome-horizontal: root.welcome-sidebar-horizontal;
            property <bool> welcome-sidebar-dragging;
            property <bool> combine-collapsed-tools:
                root.welcome-as-sidebar && root.welcome-collapsed
                && root.sidebar-collapsed && root.sidebar-dock == root.welcome-sidebar-dock;
            // A collapsed quick-command sidebar joins an existing collapsed strip
            // on the same edge. Only when no such strip exists does it reserve its
            // own outermost 36px slot (#215).
            property <bool> quick-merge-welcome:
                root.quick-panel-open && root.quick-panel-collapsed
                && root.welcome-as-sidebar && root.welcome-collapsed
                && root.quick-panel-dock == root.welcome-sidebar-dock;
            property <bool> quick-merge-sidebar:
                root.quick-panel-open && root.quick-panel-collapsed
                && !dock-area.quick-merge-welcome && root.sidebar-collapsed
                && root.quick-panel-dock == root.sidebar-dock;
            property <length> quick-outer-strip:
                !root.zen-mode && root.quick-panel-open && root.quick-panel-collapsed
                    && !dock-area.quick-merge-welcome && !dock-area.quick-merge-sidebar
                    ? 36px : 0px;
            property <bool> quick-outer-horizontal:
                root.quick-panel-dock == "left" || root.quick-panel-dock == "right";
            property <length> quick-left:
                root.quick-panel-dock == "left" ? dock-area.quick-outer-strip : 0px;
            property <length> quick-right:
                root.quick-panel-dock == "right" ? dock-area.quick-outer-strip : 0px;
            property <length> quick-top:
                root.quick-panel-dock == "top" ? dock-area.quick-outer-strip : 0px;
            property <length> quick-bottom:
                root.quick-panel-dock == "bottom" ? dock-area.quick-outer-strip : 0px;

            if dock-area.quick-outer-strip > 0px : ToolStrip {
                x: root.quick-panel-dock == "right" ? parent.width - parent.quick-outer-strip : 0px;
                y: root.quick-panel-dock == "bottom" ? parent.height - parent.quick-outer-strip : 0px;
                width: parent.quick-outer-horizontal ? parent.quick-outer-strip : parent.width;
                height: parent.quick-outer-horizontal ? parent.height : parent.quick-outer-strip;
                dock-edge: root.quick-panel-dock;
                glyph: "bolt";
                tooltip: @tr("Quick commands");
                expand => {
                    root.quick-panel-collapsed = false;
                    if (root.sidebar-dock == root.quick-panel-dock) {
                        root.sidebar-collapsed = true;
                        root.set-sidebar-collapsed(true);
                    }
                    if (root.welcome-as-sidebar
                            && root.welcome-sidebar-dock == root.quick-panel-dock) {
                        root.welcome-collapsed = true;
                        root.set-welcome-collapsed(true);
                    }
                }
            }

            // Collapsed welcome → a thin left icon strip (click the icon to re-open).
            if root.welcome-as-sidebar && root.welcome-collapsed : ToolStrip {
                x: root.welcome-sidebar-dock == "right"
                    ? parent.width - parent.quick-right - parent.welcome-strip
                    : root.welcome-sidebar-dock == "left" ? parent.quick-left : parent.quick-left;
                y: root.welcome-sidebar-dock == "bottom"
                    ? parent.height - parent.quick-bottom - parent.welcome-strip
                    : root.welcome-sidebar-dock == "top" ? parent.quick-top : parent.quick-top;
                width: parent.welcome-horizontal ? parent.welcome-strip
                    : parent.width - parent.quick-left - parent.quick-right;
                height: parent.welcome-horizontal
                    ? parent.height - parent.quick-top - parent.quick-bottom : parent.welcome-strip;
                dock-edge: root.welcome-sidebar-dock;
                glyph: "home";   // session list / welcome
                show-second: parent.combine-collapsed-tools || parent.quick-merge-welcome;
                second-glyph: parent.combine-collapsed-tools ? "dashboard" : "bolt";
                show-third: parent.combine-collapsed-tools && parent.quick-merge-welcome;
                third-glyph: "bolt";
                expand => {
                    root.welcome-collapsed = false;
                    root.set-welcome-collapsed(false);
                    if (root.sidebar-dock == root.welcome-sidebar-dock) {
                        root.sidebar-collapsed = true;
                        root.set-sidebar-collapsed(true);
                    }
                    if (root.quick-panel-open
                            && root.quick-panel-dock == root.welcome-sidebar-dock) {
                        root.quick-panel-collapsed = true;
                    }
                }
                expand-second => {
                    if (parent.combine-collapsed-tools) {
                        root.sidebar-collapsed = false;
                        root.set-sidebar-collapsed(false);
                        if (root.quick-panel-open && root.quick-panel-dock == root.sidebar-dock) {
                            root.quick-panel-collapsed = true;
                        }
                    } else {
                        root.quick-panel-collapsed = false;
                    }
                }
                expand-third => { root.quick-panel-collapsed = false; }
            }

            if dock-area.sidebar-strip-outside : ToolStrip {
                x: root.welcome-sidebar-dock == "right"
                    ? parent.width - parent.quick-right - parent.sidebar-outside-strip
                    : root.welcome-sidebar-dock == "left" ? parent.quick-left : parent.quick-left;
                y: root.welcome-sidebar-dock == "bottom"
                    ? parent.height - parent.quick-bottom - parent.sidebar-outside-strip
                    : root.welcome-sidebar-dock == "top" ? parent.quick-top : parent.quick-top;
                width: parent.welcome-horizontal ? parent.sidebar-outside-strip
                    : parent.width - parent.quick-left - parent.quick-right;
                height: parent.welcome-horizontal
                    ? parent.height - parent.quick-top - parent.quick-bottom : parent.sidebar-outside-strip;
                dock-edge: root.welcome-sidebar-dock;
                glyph: "dashboard";
                show-second: parent.quick-merge-sidebar;
                second-glyph: "bolt";
                expand => {
                    root.sidebar-collapsed = false;
                    root.set-sidebar-collapsed(false);
                    root.welcome-collapsed = true;
                    root.set-welcome-collapsed(true);
                    if (root.quick-panel-open && root.quick-panel-dock == root.sidebar-dock) {
                        root.quick-panel-collapsed = true;
                    }
                }
                expand-second => { root.quick-panel-collapsed = false; }
            }

            // Welcome / session list, to the right of the icon strip. Hidden when
            // collapsed — its icon stays in the strip; clicking it re-opens.
            if root.welcome-as-sidebar && !root.welcome-collapsed : Rectangle {
                x: root.welcome-sidebar-dock == "right" ? parent.width - parent.quick-right - parent.sidebar-outside-strip - parent.welcome-size
                 : root.welcome-sidebar-dock == "left" ? parent.quick-left + parent.sidebar-outside-strip
                 : parent.quick-left;
                y: root.welcome-sidebar-dock == "bottom" ? parent.height - parent.quick-bottom - parent.sidebar-outside-strip - parent.welcome-size
                 : root.welcome-sidebar-dock == "top" ? parent.quick-top + parent.sidebar-outside-strip
                 : parent.quick-top;
                width: parent.welcome-horizontal ? parent.welcome-size
                    : parent.width - parent.quick-left - parent.quick-right;
                height: parent.welcome-horizontal
                    ? parent.height - parent.quick-top - parent.quick-bottom : parent.welcome-size;
                background: Theme.bg-panel;
                clip: true;
                Welcome {
                    card-out-name <=> root.session-card-name;
                    card-out-host <=> root.session-card-host;
                    card-out-user <=> root.session-card-user;
                    card-out-auth <=> root.session-card-auth;
                    card-out-note <=> root.session-card-note;
                    card-out-x <=> root.session-card-x;
                    card-out-y <=> root.session-card-y;
                    drag-active <=> root.session-drag-active;
                    ctx-open-key <=> root.ctx-open-key;
                    ctx-menu-kind <=> root.ctx-menu-kind;
                    ctx-menu-group <=> root.ctx-menu-group;
                    ctx-menu-group-color <=> root.ctx-menu-group-color;
                    ctx-menu-group-color-hex <=> root.ctx-menu-group-color-hex;
                    group-color-picker-open <=> root.group-color-picker-open;
                    ctx-menu-empty <=> root.ctx-menu-empty;
                    ctx-menu-x <=> root.ctx-menu-x;
                    ctx-menu-y <=> root.ctx-menu-y;
                    ctx-menu-space-below <=> root.ctx-menu-space-below;
                    ctx-row-x <=> root.ctx-row-x;
                    ctx-row-y <=> root.ctx-row-y;
                    ctx-row-w <=> root.ctx-row-w;
                    ctx-row-h <=> root.ctx-row-h;
                    ctx-gen <=> root.ctx-gen;
                    reg-ctx-row(info) => { root.reg-ctx-row(info); }
                    drag-cancel-seq: root.session-drag-cancel-seq;
                    move-session-to(id, target, after) => { root.move-session-to(id, target, after); }
                    reorder-group(g, before) => { root.reorder-group(g, before); }
                    width: parent.width;
                    height: parent.height;
                    compact: true;
                    dock-edge: root.welcome-sidebar-dock;
                    sessions: root.sessions;
                    import-hint: root.ssh-import-hint;
                    search-query <=> root.host-search-query;
                    sessions-revision: root.sessions-revision;
                    search-changed(query) => { root.host-search-changed(query); }
                    collapse => {
                        root.welcome-collapsed = true;
                        root.set-welcome-collapsed(true);
                    }
                    dock-drag-move(ax, ay) => {
                        root.panel-dragging = true;
                        root.drag-nx = (ax - dock-area.absolute-position.x) / dock-area.width;
                        root.drag-ny = (ay - dock-area.absolute-position.y) / dock-area.height;
                    }
                    dock-drag-end() => {
                        if (root.dock-target != "") {
                            root.welcome-sidebar-dock = root.dock-target;
                            if (root.sidebar-dock == root.dock-target) {
                                root.sidebar-collapsed = true;
                                root.set-sidebar-collapsed(true);
                            }
                            if (root.quick-panel-open && root.quick-panel-dock == root.dock-target) {
                                root.quick-panel-collapsed = true;
                            }
                            root.persist-welcome-sidebar-dock(root.welcome-sidebar-dock);
                        }
                        root.panel-dragging = false;
                    }
                    new-session => { root.new-session-clicked(); }
                    import-ssh-config => { root.import-ssh-config(); }
                    connect-session(id) => { root.connect-session(id); }
                    edit-session(id) => { root.edit-session(id); }
                    duplicate-session(id) => { root.duplicate-session(id); }
                    move-session(id, group) => { root.move-session(id, group); }
                    reorder-session(id, dir) => { return root.reorder-session(id, dir); }
                    reorder-end => { root.reorder-session-end(); }
                    toggle-group(group) => { root.toggle-group(group); }
                    // (#ctx-blank-menu) 空白菜单与 Welcome 共用:全部展开/折叠 +
                    // 本地终端可见性双向绑定。
                    set-all-groups-collapsed(c) => { root.set-all-groups-collapsed(c); }
                    set-system-group-hidden(h) => { root.set-system-group-hidden(h); }
                    system-hidden <=> root.system-hidden;
                    new-group => {
                        root.group-dialog-orig = "";
                        root.group-dialog-name = "";
                        root.group-dialog-error = "";
                        // (#group-dialog-color 2026-09-14) 这两个 Welcome 入口只带
                        // **组名**、拿不到颜色,故一律以"无色"起(实际入口在组头
                        // 右键菜单,那里会连同当前色一起注入)。
                        root.group-dialog-color-hex = "";
                        root.group-dialog-color = #00000000;
                        root.group-dialog-open = true;
                    }
                    edit-group(name) => {
                        root.group-dialog-orig = name;
                        root.group-dialog-name = name;
                        root.group-dialog-error = "";
                        root.group-dialog-color-hex = "";
                        root.group-dialog-color = #00000000;
                        root.group-dialog-open = true;
                    }
                    delete-group(name) => { root.delete-group(name); }
                    remove-session(id) => { root.remove-session(id); }
                }
                Rectangle {
                    x: root.welcome-sidebar-dock == "left" ? parent.width - 1px : 0px;
                    y: root.welcome-sidebar-dock == "top" ? parent.height - 1px : 0px;
                    width: root.welcome-sidebar-horizontal ? 1px : parent.width;
                    height: root.welcome-sidebar-horizontal ? parent.height : 1px;
                    background: Theme.border-subtle;
                }
            }

            // Drag the welcome sidebar's right edge to resize it (v0.5 M3b).
            if root.welcome-as-sidebar && !root.welcome-collapsed : Rectangle {
                x: root.welcome-sidebar-dock == "left" ? parent.quick-left + parent.sidebar-outside-strip + parent.welcome-size - 2px
                 : root.welcome-sidebar-dock == "right" ? parent.width - parent.quick-right - parent.sidebar-outside-strip - parent.welcome-size - 2px
                 : parent.quick-left;
                y: root.welcome-sidebar-dock == "top" ? parent.quick-top + parent.sidebar-outside-strip + parent.welcome-size - 2px
                 : root.welcome-sidebar-dock == "bottom" ? parent.height - parent.quick-bottom - parent.sidebar-outside-strip - parent.welcome-size - 2px
                 : parent.quick-top;
                width: parent.welcome-horizontal ? 4px
                    : parent.width - parent.quick-left - parent.quick-right;
                height: parent.welcome-horizontal
                    ? parent.height - parent.quick-top - parent.quick-bottom : 4px;
                background: transparent;
                ws-split-ta := TouchArea {
                    mouse-cursor: dock-area.welcome-horizontal ? ew-resize : ns-resize;
                    pointer-event(ev) => {
                        if (ev.kind == PointerEventKind.down) {
                            dock-area.welcome-sidebar-dragging = true;
                        } else if (ev.kind == PointerEventKind.up) {
                            dock-area.welcome-sidebar-dragging = false;
                            root.persist-welcome-sidebar-width(root.welcome-sidebar-width / 1px);
                        }
                    }
                    moved => {
                        if (dock-area.welcome-sidebar-dragging) {
                            if (dock-area.welcome-horizontal) {
                                root.welcome-sidebar-width = clamp(
                                    root.welcome-sidebar-dock == "right"
                                        ? dock-area.absolute-position.x + dock-area.width
                                            - (self.absolute-position.x + self.mouse-x)
                                        : self.absolute-position.x + self.mouse-x
                                            - dock-area.absolute-position.x,
                                    160px, 480px);
                            } else {
                                root.welcome-sidebar-width = clamp(
                                    root.welcome-sidebar-dock == "bottom"
                                        ? dock-area.absolute-position.y + dock-area.height
                                            - (self.absolute-position.y + self.mouse-y)
                                        : self.absolute-position.y + self.mouse-y
                                            - dock-area.absolute-position.y,
                                    120px, 360px);
                            }
                        }
                    }
                }
                // 1px visible line, centred inside the 4px hit-area. Lights up in
                // the theme accent on hover / drag (Todo 3); otherwise a static
                // `border-subtle` thin line so it matches the left edge (Todo 2).
                // (#panel-line-hairline 2026-10-11) 线宽取 1 设备像素,与窗口描边/
                // 面板外框统一(逻辑 1px 在 125% 下是 1.25 设备行,显粗)。
                Rectangle {
                    x: parent.width < parent.height ? (parent.width - Theme.hairline()) / 2 : 0px;
                    y: parent.width < parent.height ? 0px : (parent.height - Theme.hairline()) / 2;
                    width:  parent.width < parent.height ? Theme.hairline() : parent.width;
                    height: parent.width < parent.height ? parent.height : Theme.hairline();
                    background: ws-split-ta.has-hover || dock-area.welcome-sidebar-dragging
                        ? Theme.accent : Theme.border-subtle;
                }
            }

            // Everything except the welcome strip/sidebar — the resource panel,
            // splitter and the central tab/pane content — sits to the right of them.
            rest := Rectangle {
            x: (root.welcome-sidebar-dock == "left" ? parent.welcome-taken : 0px)
                + parent.quick-left;
            y: (root.welcome-sidebar-dock == "top" ? parent.welcome-taken : 0px)
                + parent.quick-top;
            width: parent.width
                - (parent.welcome-horizontal ? parent.welcome-taken : 0px)
                - parent.quick-left - parent.quick-right;
            height: parent.height
                - (!parent.welcome-horizontal ? parent.welcome-taken : 0px)
                - parent.quick-top - parent.quick-bottom;
            // A shared ToolStrip is already reserved outside `rest` while the
            // welcome panel is expanded, or by the merged welcome strip while both
            // panels are collapsed. Do not reserve the same 36px a second time.
            property <length> sb-w: root.zen-mode ? 0px
                : dock-area.sidebar-strip-outside
                    || dock-area.combine-collapsed-tools ? 0px
                : root.sidebar-collapsed ? 36px : root.sidebar-width;
            property <length> sb-h: root.zen-mode ? 0px
                : dock-area.sidebar-strip-outside
                    || dock-area.combine-collapsed-tools ? 0px
                : root.sidebar-collapsed ? 36px : root.sidebar-height;
            // (#splitter-v2 2026-09-04) 间距归零：命中区跨立边界两侧（各压
            // 2px），面板之间不再留空档，否则会透出 dock-area 底色形成灰色
            // 空隙带。原值：root.zen-mode || root.sidebar-collapsed ? 0px : 4px
            property <length> sp: root.zen-mode || root.sidebar-collapsed ? 0px : 0px;
            // The collapsed bar (sb-h) already reserves the bottom strip now.
            property <length> bottom-strip-h: 0px;

            // Left sidebar — collapsible and drag-resizable, dockable to any edge.
            // Only shown while expanded; collapsing swaps it for the ToolStrip icon
            // bar below (mirrors the welcome sidebar), so no clipped widgets bleed
            // through the 36px strip (#resource-collapse).
            if !root.sidebar-collapsed : Rectangle {
                x: root.sidebar-dock == "right" ? parent.width - parent.sb-w
                 : 0px;
                y: root.sidebar-dock == "bottom" ? parent.height - parent.sb-h
                 : 0px;
                width: root.sidebar-horizontal ? parent.sb-w : parent.width;
                height: root.sidebar-horizontal ? parent.height : parent.sb-h;
                clip: true;
                Sidebar {
                width: parent.width;
                height: parent.height;
                // Docked top/bottom → lay the resource widgets out in a row.
                lay-horizontal: !root.sidebar-horizontal;
                dock-edge: root.sidebar-dock;
                animate width, height { duration: root.sidebar-dragging ? 0ms : 150ms; easing: ease-out; }
                connection-state: root.connection-state;
                conn-host: root.conn-host;
                conn-state: root.conn-state;
                resource-title: root.resource-title;
                cpu-percent: root.cpu-percent;
                mem-percent: root.mem-percent;
                swap-percent: root.swap-percent;
                mem-detail: root.mem-detail;
                swap-detail: root.swap-detail;
                net-top-up: root.net-top-up;
                net-top-down: root.net-top-down;
                net-top-history: root.net-top-history;
                net-bot-up: root.net-bot-up;
                net-bot-down: root.net-bot-down;
                net-bot-history: root.net-bot-history;
                net-ifaces: root.net-ifaces;
                net-selected: root.net-selected;
                net-show-selector: root.net-show-selector;
                disks: root.disks;
                system-info-available: root.system-info-available;
                proc-available: root.proc-available;
                app-version: root.app-version;
                select-net-iface(i) => { root.select-net-iface(i); }
                show-system-info() => { root.open-system-info(); }
                show-processes() => { root.open-processes(); }
                copy-host(h) => { root.copy-text(h); }   // reuse the clipboard helper (#192)
                // Drag the sidebar header to dock it to another edge. Coordinates
                // arrive in window space; convert to dock-area-relative fractions.
                dock-drag-move(ax, ay) => {
                    root.panel-dragging = true;
                    root.drag-nx = (ax - dock-area.absolute-position.x) / dock-area.width;
                    root.drag-ny = (ay - dock-area.absolute-position.y) / dock-area.height;
                }
                dock-drag-end() => {
                    if (root.dock-target != "") {
                        root.sidebar-dock = root.dock-target;
                        if (root.welcome-as-sidebar && root.welcome-sidebar-dock == root.dock-target) {
                            root.welcome-collapsed = true;
                            root.set-welcome-collapsed(true);
                        }
                        if (root.quick-panel-open && root.quick-panel-dock == root.dock-target) {
                            root.quick-panel-collapsed = true;
                        }
                        root.persist-sidebar-dock(root.sidebar-dock);
                    }
                    root.panel-dragging = false;
                }
                toggle-collapse() => {
                    root.sidebar-collapsed = !root.sidebar-collapsed;
                    root.set-sidebar-collapsed(root.sidebar-collapsed);
                }
                }
            }

            // Collapsed resource panel → a ToolStrip icon bar at the same docked edge
            // (M5), in place of the old floating expand button.
            if root.sidebar-collapsed && !dock-area.combine-collapsed-tools && !dock-area.sidebar-strip-outside : ToolStrip {
                x: root.sidebar-dock == "right" ? parent.width - parent.sb-w : 0px;
                y: root.sidebar-dock == "bottom" ? parent.height - parent.sb-h : 0px;
                width: root.sidebar-horizontal ? parent.sb-w : parent.width;
                height: root.sidebar-horizontal ? parent.height : parent.sb-h;
                dock-edge: root.sidebar-dock;
                glyph: "dashboard";   // dashboard — resource panel
                show-second: dock-area.quick-merge-sidebar;
                second-glyph: "bolt";
                expand => {
                    root.sidebar-collapsed = false;
                    root.set-sidebar-collapsed(false);
                    if (root.welcome-as-sidebar && root.welcome-sidebar-dock == root.sidebar-dock) {
                        root.welcome-collapsed = true;
                        root.set-welcome-collapsed(true);
                    }
                    if (root.quick-panel-open && root.quick-panel-dock == root.sidebar-dock) {
                        root.quick-panel-collapsed = true;
                    }
                }
                expand-second => { root.quick-panel-collapsed = false; }
            }

            // Splitter — drag to resize the sidebar. Orientation + which dimension it
            // adjusts follow the dock edge. Hidden while collapsed.
            //
            // The grab *hit-area* is a 4px transparent strip (mouse-cursor shows the
            // ew-resize/ns-resize affordance). The *visible* boundary is the 1px line
            // child below, sitting at the sidebar's inner edge. The line lights up in
            // Theme.accent on hover / drag, mirroring the welcome sidebar's
            // `ws-split-ta.has-hover` behaviour so both docked edges respond the
            // same way (Todo 2/3, #wip6).
            //
            // (#splitter-v2 2026-09-04) 恢复拖拽：改为与左侧 welcome 边界完全
            // 相同的模式 —— 4px 透明命中区跨立在边界两侧（各压 2px），1px 可见
            // 线居中在命中区内，hover/drag 切 Theme.accent。此前 term-bg 实心
            // 填充形成 #0e0f13 色带（#del-splitter 曾短暂整块禁用），透明背景
            // + 跨立布局让两侧面板各自透出，无新增色带。
            Rectangle {
                visible: !root.sidebar-collapsed;
                // Horizontal docks → a vertical 4px hit-area at the sidebar's inner
                // edge; vertical docks → a horizontal 4px hit-area (the visible 1px
                // line is the child Rectangle below, centred inside this area).
                // (#splitter-v2) 跨立边界：命中区中心对齐侧栏边缘（左/上侧
                // 从 sb-w/sb-h - 2px 起，右/下侧止于边界前 2px），与 welcome 侧
                // 的 -2px 模式一致，透明背景下两侧面板各透出 2px。
                x: root.sidebar-dock == "left"   ? parent.sb-w - 2px
                 : root.sidebar-dock == "right"  ? parent.width - parent.sb-w - 2px
                 : 0px;
                y: root.sidebar-dock == "top"    ? parent.sb-h - 2px
                 : root.sidebar-dock == "bottom" ? parent.height - parent.sb-h - 2px
                 : 0px;
                width:  root.sidebar-horizontal ? 4px : parent.width;
                height: root.sidebar-horizontal ? parent.height : 4px;
                // (#splitter-v2) transparent like the welcome splitter: the hit
                // area now straddles the boundary (sp=0, panes paint right up to
                // the sidebar edge), so both sides show their own surfaces and no
                // filler colour is needed. The earlier term-bg fill is what showed
                // as the #0e0f13 band (#wip8 → #del-splitter → #splitter-v2).
                background: transparent;
                sb-split-ta := TouchArea {
                    mouse-cursor: root.sidebar-horizontal ? ew-resize : ns-resize;
                    pointer-event(ev) => {
                        if (ev.kind == PointerEventKind.down) {
                            root.sidebar-dragging = true;
                        } else if (ev.kind == PointerEventKind.up) {
                            root.sidebar-dragging = false;
                            root.persist-sidebar-width(root.sidebar-width / 1px);
                        }
                    }
                    moved => {
                        if (root.sidebar-dragging) {
                            if (root.sidebar-horizontal) {
                                // Track the cursor in stable dock-area coordinates.
                                // The splitter moves while resizing, so adding local
                                // mouse deltas to the current width feeds the movement
                                // back into itself and can suddenly widen the panel
                                // on Win10 (#244).
                                root.sidebar-width = clamp(
                                    root.sidebar-dock == "right"
                                        ? dock-area.absolute-position.x + dock-area.width
                                            - (self.absolute-position.x + self.mouse-x)
                                        : (self.absolute-position.x + self.mouse-x)
                                            - dock-area.absolute-position.x,
                                    160px, 520px);
                            } else {
                                root.sidebar-height = clamp(
                                    root.sidebar-dock == "bottom"
                                        ? dock-area.absolute-position.y + dock-area.height
                                            - (self.absolute-position.y + self.mouse-y)
                                        : (self.absolute-position.y + self.mouse-y)
                                            - dock-area.absolute-position.y,
                                    120px, 480px);
                        }
                    }
                }
                // 1px visible line at the sidebar's INNER edge — the only
                // visible boundary between the shell and the sidebar. Sits
                // inside the splitter's hit-area so it can light up in
                // Theme.accent on hover / while dragging (mirrors the welcome
                // sidebar's `ws-split-ta` behaviour so the right edge has the
                // same affordance as the left, Todo 2). At rest it stays
                // `Theme.border-subtle` so it reads as a clean static thin
                // line matching the rest of the chrome (#wip6).
                Rectangle {
                    // (#splitter-v2) 居中于 4px 命中区（同 welcome 侧写法），
                    // 不再贴侧栏内缘。
                    // (#panel-line-hairline 2026-10-11) 线宽取 1 设备像素,与窗口
                    // 描边/面板外框统一(逻辑 1px 在 125% 下是 1.25 设备行,显粗)。
                    x: parent.width < parent.height ? (parent.width - Theme.hairline()) / 2 : 0px;
                    y: parent.width < parent.height ? 0px : (parent.height - Theme.hairline()) / 2;
                    width:  parent.width < parent.height ? Theme.hairline() : parent.width;
                    height: parent.width < parent.height ? parent.height : Theme.hairline();
                    background: sb-split-ta.has-hover || root.sidebar-dragging
                        ? Theme.accent : Theme.border-subtle;
                }
            }
            }

            // Right side: tabs + content — positioned in the rect left after the
            // sidebar is carved off its docked edge. Clipped so the terminal / SFTP
            // panel can never bleed (visually or for clicks) onto a panel docked on
            // the bottom or right (#dock).
            quick-area := Rectangle {
                x: root.sidebar-dock == "left" ? parent.sb-w + parent.sp : 0px;
                y: root.sidebar-dock == "top"  ? parent.sb-h + parent.sp : 0px;
                width:  root.sidebar-horizontal ? parent.width - parent.sb-w - parent.sp : parent.width;
                height: root.sidebar-horizontal ? parent.height : parent.height - parent.sb-h - parent.sp - parent.bottom-strip-h;
                clip: true;
                property <bool> quick-horizontal:
                    root.quick-panel-dock == "left" || root.quick-panel-dock == "right";
                property <length> quick-w:
                    !root.zen-mode && root.quick-panel-open && !root.quick-panel-collapsed ? root.quick-panel-width : 0px;
                property <length> quick-h:
                    !root.zen-mode && root.quick-panel-open && !root.quick-panel-collapsed ? root.quick-panel-height : 0px;
                property <length> quick-sp:
                    !root.zen-mode && root.quick-panel-open && !root.quick-panel-collapsed ? 4px : 0px;

                central := Rectangle {
                x: root.quick-panel-open && !root.quick-panel-collapsed && root.quick-panel-dock == "left"
                    ? parent.quick-w + parent.quick-sp : 0px;
                y: root.quick-panel-open && !root.quick-panel-collapsed && root.quick-panel-dock == "top"
                    ? parent.quick-h + parent.quick-sp : 0px;
                width: root.quick-panel-open && !root.quick-panel-collapsed && parent.quick-horizontal
                    ? parent.width - parent.quick-w - parent.quick-sp : parent.width;
                height: root.quick-panel-open && !root.quick-panel-collapsed && !parent.quick-horizontal
                    ? parent.height - parent.quick-h - parent.quick-sp : parent.height;
                clip: true;
                // Split-pane area (v0.5): panes tile this rect; each pane has its own
                // tab strip + active terminal / welcome. Rust flattens the split tree
                // into `panes` for the size we report here.
                pane-area := Rectangle {
                    width: parent.width;
                    height: parent.height;
                    changed width => { root.content-resized(self.width, self.height); }
                    changed height => { root.content-resized(self.width, self.height); }
                for pane[pi] in root.panes : Rectangle {
                    x: pane.x; y: pane.y; width: pane.w; height: pane.h;
                    clip: true;
                    VerticalLayout {
                    spacing: 0;

                    HorizontalLayout {
                    spacing: 0;
                    // (Collapsed resource panel now reserves its own ToolStrip slot in
                    // `rest`, so the tab strip no longer needs a spacer for it.)
                    TabBar {
                        horizontal-stretch: 1;
                        // Reserve room for the top-right toolbar icons that sit over
                        // this row so tabs don't slide underneath them (#122).
                        // (#polish-topbar) 方案 B:工具组迁入标题栏后,frameless
                        // 无需预留,标签全宽;macOS 浮动按钮仍需预留。
                        reserve-right: root.custom-titlebar ? 0px : pane.reserve-right;
                        show-new-tab: !root.welcome-as-sidebar;
                        can-merge-pane: root.panes.length > 1;
                    lang-en: root.lang-en;
                    menu-channel-letter <=> root.menu-channel-letter;
                    menu-channel-paused <=> root.menu-channel-paused;
                    tab-join-channel(t, slot) => { root.tab-join-channel(t, slot); }
                    tab-pause-channel(t) => { root.tab-pause-channel(t); }
                    tab-leave-channel(t) => { root.tab-leave-channel(t); }
                    show-channel-bar(t) => { root.show-channel-bar(t); }
                    // (#tab-card) tab 悬浮信息卡中转到根层集中浮层
                    // (#sync-dialog-v2) +user/auth/group 三参
                    tab-card-out(t, h, u, a, g, n, c, p, ax, ay) => {
                        root.tab-card-title = t;
                        root.tab-card-host = h;
                        root.tab-card-user = u;
                        root.tab-card-auth = a;
                        root.tab-card-group = g;
                        root.tab-card-note = n;
                        root.tab-card-channel = c;
                        root.tab-card-channel-paused = p;
                        root.tab-card-x = ax;
                        root.tab-card-y = ay;
                    }
                    tab-card-clear() => {
                        root.tab-card-title = "";
                        root.tab-card-host = "";
                        root.tab-card-user = "";
                        root.tab-card-auth = "";
                        root.tab-card-group = "";
                        root.tab-card-note = "";
                        root.tab-card-channel = "";
                        root.tab-card-channel-paused = false;
                    }
                        tabs: pane.tabs;
                        active-id: pane.active-id;
                        ext-drag-over: root.tab-drag-live
                            && root.tab-drag-px >= pane.x
                            && root.tab-drag-px <= pane.x + pane.w
                            && root.tab-drag-py >= pane.y
                            // (#tab-32) The strip row is the TabBar's own 32px（=标签高）。
                            && root.tab-drag-py <= pane.y + 32px;
                        ext-drag-x: root.tab-drag-px - pane.x;
                        tab-selected(id) => { root.pane-tab-selected(pane.id, id); }
                        tab-closed(id) => { root.pane-tab-closed(pane.id, id); }
                        new-tab() => { root.pane-new-tab(pane.id); }
                        tab-move(from-index, to-index) => {
                            root.tab-drag-live = false;
                            root.pane-tab-move(pane.id, from-index, to-index);
                        }
                        drop-index-changed(index) => {
                            root.pane-tab-drop-index(pane.id, index);
                        }
                        tab-split(id, dir) => { root.pane-split(pane.id, id, dir); }
                        merge-pane() => { root.pane-merge(pane.id); }
                        tab-duplicate(id) => { root.tab-duplicate(id); }
                        tab-rename-request(id) => { root.tab-rename-request(id); }
                        tab-drag-move(id, ax, ay, own-strip) => {
                            root.tab-drag-px = ax - pane-area.absolute-position.x;
                            root.tab-drag-py = ay - pane-area.absolute-position.y;
                            root.tab-drag-live = true;
                            root.tab-drag-move(id, root.tab-drag-px, root.tab-drag-py, own-strip);
                        }
                        tab-drag-drop(id, ax, ay) => {
                            root.tab-drag-live = false;
                            root.tab-drag-drop(id,
                                ax - pane-area.absolute-position.x,
                                ay - pane-area.absolute-position.y);
                        }
                        tab-drag-cancel() => {
                            root.tab-drag-live = false;
                            root.tab-drag-cancel();
                        }
                    }
                }

                // (#tab-32) 频道状态条：Rust 按 pane 计算（活动 tab 在频道时
                // visible），数据在 pane-channel-bars[pi]。
                if root.pane-channel-bars[pi].visible : ChannelBar {
                    channel-letter: root.pane-channel-bars[pi].letter;
                    channel-color: root.pane-channel-bars[pi].color;
                    paused: root.pane-channel-bars[pi].paused;
                    online-count: root.pane-channel-bars[pi].online;
                    member-total: root.pane-channel-bars[pi].total;
                    lang-en: root.lang-en;
                    leave-channel() => { root.tab-leave-channel(pane.active-id); }
                    pause-channel() => { root.tab-pause-channel(pane.active-id); }
                    pause-resume() => { root.tab-pause-channel(pane.active-id); }
                    close-channel() => { root.pane-close-channel(root.pane-channel-bars[pi].slot); }
                    hide-bar() => { root.tab-hide-channel-bar(pane.active-id); }
                    // (#chbar-menu-root) 菜单操作走根层浮层：注入操作目标 + 接上报
                    menu-tab-id: pane.active-id;
                    menu-slot: root.pane-channel-bars[pi].slot;
                    menu-request(r) => {
                        root.chbar-menu = r;
                        root.chbar-menu-open = true;
                    }
                    // (#chbar-tip-root) 截断提示上报转发到根层浮层
                    stat-tip(t, ax, ay) => {
                        root.chbar-stat-tip = t;
                        root.chbar-stat-tip-x = ax;
                        root.chbar-stat-tip-y = ay;
                    }
                    stat-tip-off() => { root.chbar-stat-tip = ""; }
                }
                // Content area swaps based on active tab kind.
                Rectangle {
                    vertical-stretch: 1;
                    // (#tabbar-term-bg 2026-10-11) 必须是 term-bg,不是 bg-root:
                    // TabBar 的条带底色恒为 term-bg(theme.slint #tab-flush:"三者
                    // 同色")。有会话时 TerminalView(term-bg)盖满这块,两者看着
                    // 一致;**无会话**时这里只剩容器底色,root≠tbg 的主题(自带
                    // MTerm 套 root #161619 / tbg #181A1D、darcula-dark、flexoki-dark,
                    // 以及任何开壁纸的场景)就会露出一条深浅相反的条带(用户截图)。
                    background: Theme.term-bg;

                    // Empty pane outside welcome-sidebar mode: keep a small hint for
                    // rare empty panes, but do not cover the wallpaper when the
                    // session list is already visible as a sidebar.
                    if pane.tabs.length == 0 && !root.welcome-as-sidebar : Rectangle {
                        width: parent.width;
                        height: parent.height;
                        Text {
                            text: root.lang-en
                                ? "Pick a session on the left to begin"
                                : "从左侧选择一个会话开始";
                            color: Theme.text-muted;
                            font-size: Theme.fs-sm;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    // Welcome tab — fill the content area explicitly (some renderers
                    // don't auto-fill, which spread the header/card apart) (#dock).
                    if pane.active-id == "welcome" : Welcome {
                        width: parent.width;
                        height: parent.height;
                        sessions: root.sessions;
                        import-hint: root.ssh-import-hint;
                        search-query <=> root.host-search-query;
                        sessions-revision: root.sessions-revision;
                        // (#session-drag-smooth) 信息卡片/拖拽落位中转(同侧栏实例)。
                        card-out-name <=> root.session-card-name;
                        card-out-host <=> root.session-card-host;
                        card-out-user <=> root.session-card-user;
                        card-out-auth <=> root.session-card-auth;
                        card-out-note <=> root.session-card-note;
                        card-out-x <=> root.session-card-x;
                        card-out-y <=> root.session-card-y;
                        drag-active <=> root.session-drag-active;
                        ctx-open-key <=> root.ctx-open-key;
                        ctx-menu-kind <=> root.ctx-menu-kind;
                        ctx-menu-group <=> root.ctx-menu-group;
                        ctx-menu-group-color <=> root.ctx-menu-group-color;
                        ctx-menu-group-color-hex <=> root.ctx-menu-group-color-hex;
                        group-color-picker-open <=> root.group-color-picker-open;
                        ctx-menu-empty <=> root.ctx-menu-empty;
                        ctx-menu-x <=> root.ctx-menu-x;
                        ctx-menu-y <=> root.ctx-menu-y;
                        ctx-menu-space-below <=> root.ctx-menu-space-below;
                        ctx-row-x <=> root.ctx-row-x;
                        ctx-row-y <=> root.ctx-row-y;
                        ctx-row-w <=> root.ctx-row-w;
                        ctx-row-h <=> root.ctx-row-h;
                        ctx-gen <=> root.ctx-gen;
                        reg-ctx-row(info) => { root.reg-ctx-row(info); }
                        drag-cancel-seq: root.session-drag-cancel-seq;
                        move-session-to(id, target, after) => { root.move-session-to(id, target, after); }
                        reorder-group(g, before) => { root.reorder-group(g, before); }
                        search-changed(query) => { root.host-search-changed(query); }
                        new-session => { root.new-session-clicked(); }
                        import-ssh-config => { root.import-ssh-config(); }
                        connect-session(id) => { root.connect-session(id); }
                        edit-session(id) => { root.edit-session(id); }
                        duplicate-session(id) => { root.duplicate-session(id); }
                        move-session(id, group) => { root.move-session(id, group); }
                        reorder-session(id, dir) => { return root.reorder-session(id, dir); }
                        reorder-end => { root.reorder-session-end(); }
                        toggle-group(group) => { root.toggle-group(group); }
                    // (#ctx-blank-menu) 空白菜单与 Welcome 共用:全部展开/折叠 +
                    // 本地终端可见性双向绑定。
                    set-all-groups-collapsed(c) => { root.set-all-groups-collapsed(c); }
                    set-system-group-hidden(h) => { root.set-system-group-hidden(h); }
                    system-hidden <=> root.system-hidden;
                        new-group => {
                            root.group-dialog-orig = "";
                            root.group-dialog-name = "";
                            root.group-dialog-error = "";
                            root.group-dialog-color-hex = "";
                            root.group-dialog-color = #00000000;
                            root.group-dialog-open = true;
                        }
                        edit-group(name) => {
                            root.group-dialog-orig = name;
                            root.group-dialog-name = name;
                            root.group-dialog-error = "";
                            root.group-dialog-color-hex = "";
                            root.group-dialog-color = #00000000;
                            root.group-dialog-open = true;
                        }
                        delete-group(name) => { root.delete-group(name); }
                        remove-session(id) => { root.remove-session(id); }
                        cycle-tab(reverse) => { root.cycle-tab(reverse); }
                    }

                    // Terminal tabs — one TerminalView per terminal state. Only
                    // the one matching `active-tab-id` is visible. Slint doesn't
                    // allow nesting `if` directly inside a `for`, so we toggle
                    // visibility instead and rely on the layout to overlap them.
                    for term[i] in root.terminals : TerminalView {
                        visible: term.id == pane.active-id;
                        active: term.id == root.active-tab-id;
                        zen-mode: root.zen-mode;
                        width: term.id == pane.active-id ? parent.width : 0px;
                        height: term.id == pane.active-id ? parent.height : 0px;
                        tab-id: term.id;
                        status-line: term.status;
                        spans: term.spans;
                        cursor-row: term.cursor-row;
                        cursor-col: term.cursor-col;
                        cursor-style: root.term-cursor-style;
                        cursor-color: root.term-cursor-color;
                        terminal-line-spacing: root.terminal-line-spacing;
                        extra-paste-shortcuts-enabled: root.extra-paste-shortcuts-enabled;
                        rows-used: term.rows-used;
                        scroll-max: term.scroll-max;
                        scroll-offset: term.scroll-offset;
                        is-alt-screen: term.is-alt-screen;
                        mouse-tracked: term.mouse-tracked;
                        find-matches: term.find-matches;
                        selection: term.selection;
                        sftp-panel-height: term.sftp-panel-height;
                        set-sftp-panel-height(v) => { root.set-pane-sftp-height(term.id, v); }
                        sftp-panel-width: term.sftp-panel-width;
                        set-sftp-panel-width(v) => { root.set-pane-sftp-width(term.id, v); }
                        sftp-dock <=> root.sftp-dock;
                        sftp-collapsed: term.sftp-collapsed;
                        set-sftp-collapsed(v) => { root.set-pane-sftp-collapsed(term.id, v); }
                        sftp-saved-height: term.sftp-saved-height;
                        set-sftp-saved-height(v) => { root.set-pane-sftp-saved-height(term.id, v); }
                        sftp-tree-width: root.sftp-tree-width;
                        persist-sftp-tree-width(v) => { root.persist-sftp-tree-width(v); }
                        sftp-show-type: root.sftp-show-type;
                        sftp-show-size: root.sftp-show-size;
                        sftp-show-modified: root.sftp-show-modified;
                        sftp-show-permissions: root.sftp-show-permissions;
                        sftp-show-owner: root.sftp-show-owner;
                        sftp-show-group: root.sftp-show-group;
                        toggle-sftp-column(key) => { root.toggle-sftp-column(key); }
                        sftp-path: term.sftp-path;
                        sftp-entries: term.sftp-entries;
                        sftp-status: term.sftp-status;
                        sftp-loading: term.sftp-loading;
                        sftp-tree-nodes: term.sftp-tree-nodes;
                        sftp-transfer-targets: root.tabs;
                        sftp-selected-count: term.sftp-selected-count;
                        sftp-single-selected-path: term.single-selected-path;
                        sftp-sort-key: term.sftp-sort-key;
                        sftp-sort-dir: term.sftp-sort-dir;
                        sftp-available: term.sftp-available;
                        tunnels: term.tunnels;
                        quick-commands: root.quick-commands;
                        quick-sidebar-enabled: root.quick-commands-as-sidebar;
                        quick-panel-docked: root.quick-panel-open;
                        cmd-bar-hidden: term.cmd-bar-hidden;   // (#polish-topbar-r4) 每会话独立
                        quick-external-command: root.quick-external-command;
                        quick-external-send-enter: root.quick-external-send-enter;
                        quick-external-sequence: root.quick-external-sequence;
                        focus-sequence: root.terminal-focus-sequence;
                        command-history: root.command-history;
                        history-view: root.history-view;
                        run-command(cmd, all) => { root.run-command(term.id, cmd, all); }
                        copy-text(t) => { root.copy-text(t); }
                        delete-history(i) => { root.delete-history(i); }
                        delete-history-cmd(c) => { root.delete-history-cmd(c); }
                        search-history(q) => { root.search-history(q); }
                        manage-quick-commands() => {
                            root.qcm-name = "";
                            root.qcm-command = "";
                            root.qcm-group = "";
                            root.qcm-edit-index = -1;
                            root.quick-cmd-manage-open = true;
                        }
                        quick-dock-drag-move(ax, ay) => {
                            root.panel-dragging = true;
                            root.drag-nx = (ax - dock-area.absolute-position.x) / dock-area.width;
                            root.drag-ny = (ay - dock-area.absolute-position.y) / dock-area.height;
                        }
                        quick-dock-drag-end() => {
                            if (root.dock-target != "") {
                                root.quick-panel-dock = root.dock-target;
                                root.quick-panel-open = true;
                                root.quick-panel-collapsed = false;
                                if (root.sidebar-dock == root.dock-target) {
                                    root.sidebar-collapsed = true;
                                    root.set-sidebar-collapsed(true);
                                }
                                if (root.welcome-as-sidebar
                                        && root.welcome-sidebar-dock == root.dock-target) {
                                    root.welcome-collapsed = true;
                                    root.set-welcome-collapsed(true);
                                }
                            }
                            root.panel-dragging = false;
                        }
                        toggle-quick-group(g) => { root.toggle-quick-group(g); }
                        edit-quick-command(i) => { root.edit-quick-command(i); }
                        duplicate-quick-command(i) => { root.duplicate-quick-command(i); }
                        delete-quick-command(i) => { root.delete-quick-command(i); }
                        move-quick-command(i, g) => { root.move-quick-command(i, g); }
                        new-quick-group() => { root.qcg-orig = ""; root.qcg-name = ""; root.qcg-open = true; }
                        rename-quick-group(g) => { root.qcg-orig = g; root.qcg-name = g; root.qcg-open = true; }
                        delete-quick-group(g) => { root.delete-quick-group(g); }
                        send-key(key, ctrl, alt, shift) => { root.send-key(term.id, key, ctrl, alt, shift) }
                        diagnose-key-event(key, control, meta, alt, shift) => {
                            root.diagnose-key-event(term.id, key, control, meta, alt, shift);
                        }
                        cycle-tab(reverse) => { root.cycle-tab(reverse); }
                        new-window-key() => { root.new-window-clicked(); }
                        zoom-key(direction, window-wide) => { root.zoom-term-font(term.id, direction, window-wide); }
                        zen-key() => { root.toggle-zen-key(); }
                        term-font-size-px: term.font-size > 0 ? term.font-size * 1.0 : root.term-font-size / 1px;
                        terminal-resize(w, h) => { root.terminal-resize(term.id, w, h) }
                        sftp-navigate(path) => { root.sftp-navigate(term.id, path); }
                        sftp-download(path) => { root.sftp-download(term.id, path); }
                        sftp-upload-clicked(dir, folder) => { root.sftp-upload-clicked(term.id, dir, folder); }
                        sftp-refresh(path) => { root.sftp-refresh(term.id, path); }
                        sftp-tree-expand(path) => { root.sftp-tree-expand(term.id, path); }
                        sftp-toggle-select(i) => { root.sftp-toggle-select(term.id, i); }
                        sftp-download-selected() => { root.sftp-download-selected(term.id); }
                        sftp-download-selected-sequential() => { root.sftp-download-selected-sequential(term.id); }
                        sftp-download-archive(path) => { root.sftp-download-archive(term.id, path); }
                        sftp-copy-to-target(path, target) => { root.sftp-copy-to-target(term.id, path, target); }
                        sftp-copy-selected-to-target(target) => { root.sftp-copy-selected-to-target(term.id, target); }
                        // Confirm before deleting the checked entries (#100), reusing
                        // the delete-confirm dialog in batch mode.
                        sftp-delete-selected() => {
                            // (#W4) Exactly one checked entry → open the SAME single-item
                            // confirmation dialog as an unselected right-click delete. The
                            // batch dialog is reserved for 2+ checked entries only.
                            if (term.single-selected-path != "") {
                                root.confirm-delete-tab = term.id;
                                root.confirm-delete-path = term.single-selected-path;
                                root.confirm-delete-open = true;
                            } else {
                                root.confirm-delete-tab = term.id;
                                root.confirm-delete-batch = true;
                                root.confirm-delete-path = root.lang-en ? "the selected items" : "选中的项目";
                                root.confirm-delete-open = true;
                            }
                        }
                        // Gate delete behind an in-app confirmation (#28): stash the
                        // target and open the modal; the real delete fires on confirm.
                        sftp-delete(path) => {
                            root.confirm-delete-tab = term.id;
                            root.confirm-delete-path = path;
                            root.confirm-delete-open = true;
                        }
                        sftp-view(path) => { root.sftp-view(term.id, path); }
                        sftp-edit(path) => { root.sftp-edit(term.id, path); }
                        sftp-open-external(path) => { root.sftp-open-external(term.id, path); }
                        sftp-edit-external(path) => { root.sftp-edit-external(term.id, path); }
                        sftp-sort-request(key) => { root.sftp-sort-request(term.id, key); }
                        sftp-clear-sort() => { root.sftp-clear-sort(term.id); }
                        tunnel-add(name, kind, bind, bind-port, host, host-port) => {
                            root.tunnel-add(term.id, name, kind, bind, bind-port, host, host-port);
                        }
                        tunnel-stop(id) => { root.tunnel-stop(term.id, id); }
                        // #69 context-menu extensions → shared prompt dialog.
                        sftp-rename-request(path, name) => {
                            root.sftp-prompt-kind = "rename";
                            root.sftp-prompt-tab = term.id;
                            root.sftp-prompt-target = path;
                            root.sftp-prompt-value = name;
                            root.sftp-prompt-open = true;
                        }
                        sftp-chmod-request(path, name, mode) => {
                            root.sftp-chmod-open(term.id, path, name, mode);
                        }
                        sftp-copy-path(path) => { root.sftp-copy-path(path); }
                        sftp-new-folder(dir) => {
                            root.sftp-prompt-kind = "mkdir";
                            root.sftp-prompt-tab = term.id;
                            root.sftp-prompt-target = dir;
                            root.sftp-prompt-value = "";
                            root.sftp-prompt-open = true;
                        }
                        sftp-new-file(dir) => {
                            root.sftp-prompt-kind = "touch";
                            root.sftp-prompt-tab = term.id;
                            root.sftp-prompt-target = dir;
                            root.sftp-prompt-value = "";
                            root.sftp-prompt-open = true;
                        }
                        paste-from-clipboard() => { root.paste-from-clipboard(term.id); }
                        copy-terminal-text() => { root.copy-terminal-text(term.id); }
                        clear-terminal() => { root.clear-terminal(term.id); }
                        find-query-changed(q) => { root.find-query-changed(term.id, q); }
                        terminal-scroll(d) => { root.terminal-scroll(term.id, d); }
                        terminal-wheel(d, c, r) => { root.terminal-wheel(term.id, d, c, r); }
                        terminal-scroll-to(o) => { root.terminal-scroll-to(term.id, o); }
                        terminal-mouse(kind, btn, r, c) => { root.terminal-mouse(term.id, kind, btn, r, c); }
                        select-start(r, c, ctrl, shift) => { root.term-select-start(term.id, r, c, ctrl, shift); }
                        select-update(r, c) => { root.term-select-update(term.id, r, c); }
                        select-end() => { root.term-select-end(term.id); }
                        select-word(r, c) => { root.term-select-word(term.id, r, c); }
                        select-autoscroll(dir) => { root.term-select-autoscroll(term.id, dir); }
                    }

                    // (#rdp-vnc-embedded) Built-in remote-desktop tabs — one view per
                    // remote pane, same visibility-toggling dispatch as the terminal
                    // loop above. A pane's active tab belongs to exactly one of the
                    // two models, so at most one of the two loops is ever visible:
                    // that is what keeps a keystroke from reaching both (P0-7).
                    for rem[i] in root.remote-panes : RemoteDesktopView {
                        visible: rem.id == pane.active-id;
                        active: rem.id == root.active-tab-id;
                        width: rem.id == pane.active-id ? parent.width : 0px;
                        height: rem.id == pane.active-id ? parent.height : 0px;
                        tab-id: rem.id;
                        state: rem.state;
                        status: rem.status;
                        error: rem.error;
                        frame: rem.image;
                        frame-w: rem.frame-w;
                        frame-h: rem.frame-h;
                        view-only: rem.view-only;
                        trust-open: rem.trust-open;
                        trust-title: rem.trust-changed
                            ? @tr("The {0} certificate has changed", rem.trust-protocol == "vnc" ? "VNC" : "RDP")
                            : @tr("Trust this {0} server?", rem.trust-protocol == "vnc" ? "VNC" : "RDP");
                        trust-host: rem.trust-host;
                        trust-fingerprint: rem.trust-fingerprint;
                        trust-subject: rem.trust-subject;
                        trust-issuer: rem.trust-issuer;
                        trust-validity: rem.trust-validity;
                        trust-changed: rem.trust-changed;
                        key-event(text, down, ctrl, shift, alt, meta) => {
                            root.remote-key(rem.id, text, down, ctrl, shift, alt, meta);
                        }
                        pointer-event(x, y, btn, action) => {
                            root.remote-pointer(rem.id, x, y, btn, action);
                        }
                        wheel-event(x, y, dx, dy) => { root.remote-wheel(rem.id, x, y, dx, dy); }
                        release-all-keys() => { root.remote-release-keys(rem.id); }
                        resized(w, h) => { root.remote-resized(rem.id, w, h); }
                        reconnect() => { root.remote-reconnect(rem.id); }
                        trust-decide(accept, remember) => {
                            root.remote-trust-decide(rem.id, accept, remember);
                        }
                    }

                    // Windows may show the terminal model being reconstructed when
                    // restoring from minimize (#183). Briefly cover the terminal area
                    // until the restore repaint settles; the underlying PTY/buffer is
                    // untouched.
                    if root.terminal-restore-cover && pane.active-id != "welcome" && pane.tabs.length > 0 : Rectangle {
                        width: parent.width;
                        height: parent.height;
                        background: Theme.term-bg;
                    }
                }
                }
                }

                // Draggable splitters between panes. Single pane => the model is
                // empty, so this renders nothing. The handle is a thin 4px bar
                // (matches the sidebar / welcome / quick-panel / SFTP splitters
                // so the visual thickness is consistent across the whole shell)
                // and its TouchArea reaches ±5px beyond so it's easy to grab.
                for sp[si] in root.splitters : Rectangle {
                    x: sp.x; y: sp.y; width: sp.w; height: sp.h;
                    // A tab dropped on a pane boundary leaves the pointer hovering
                    // over this splitter. Highlight only while the splitter itself
                    // is being dragged, otherwise that hover looks like a stuck
                    // full-height tab insertion caret.
                    // Highlight on hover too (Todo 3), but suppress it while a tab
                    // is being dragged onto a pane boundary — otherwise the hover
                    // looks like a stuck full-height tab-insertion caret (#dock).
                    background: (sp-ta.has-hover || sp-ta.pressed) && !root.drag-active
                        ? Theme.accent : Theme.border-strong;
                    animate background { duration: 100ms; }
                    sp-ta := TouchArea {
                        x: sp.vertical ? -5px : 0px;
                        y: sp.vertical ? 0px : -5px;
                        width: sp.vertical ? parent.width + 10px : parent.width;
                        height: sp.vertical ? parent.height : parent.height + 10px;
                        mouse-cursor: sp.vertical ? ew-resize : ns-resize;
                        moved => {
                            if (self.pressed) {
                                root.splitter-drag(sp.split-id,
                                    sp.vertical ? sp.x - 5px + self.mouse-x
                                                : sp.y - 5px + self.mouse-y,
                                    sp.vertical);
                            }
                        }
                    }
                }

                // Drag-to-split drop-zone highlight (v0.5). Purely visual (no
                // TouchArea) so it never eats the drag; Rust sets the rect.
                if root.drag-active : Rectangle {
                    x: root.drag-hl-x;
                    y: root.drag-hl-y;
                    width: root.drag-hl-w;
                    height: root.drag-hl-h;
                    background: Theme.accent.with-alpha(0.22);
                    border-width: 2px;
                    border-color: Theme.accent;
                    border-radius: Theme.radius-sm;
                }
                }
            }

            if root.quick-panel-open && !root.quick-panel-collapsed : QuickDockPanel {
                x: root.quick-panel-dock == "right" ? parent.width - parent.quick-w : 0px;
                y: root.quick-panel-dock == "bottom" ? parent.height - parent.quick-h : 0px;
                width: parent.quick-horizontal ? parent.quick-w : parent.width;
                height: parent.quick-horizontal ? parent.height : parent.quick-h;
                commands: root.quick-commands;
                dock-edge: root.quick-panel-dock;
                activate(command, send-enter) => {
                    root.quick-external-command = command;
                    root.quick-external-send-enter = send-enter;
                    root.quick-external-sequence += 1;
                }
                toggle-group(group) => { root.toggle-quick-group(group); }
                manage => {
                    root.qcm-name = "";
                    root.qcm-command = "";
                    root.qcm-group = "";
                    root.qcm-edit-index = -1;
                    root.quick-cmd-manage-open = true;
                }
                request-close => { root.quick-panel-collapsed = true; }
                dock-drag-move(ax, ay) => {
                    root.panel-dragging = true;
                    root.drag-nx = (ax - dock-area.absolute-position.x) / dock-area.width;
                    root.drag-ny = (ay - dock-area.absolute-position.y) / dock-area.height;
                }
                dock-drag-end => {
                    if (root.dock-target != "") {
                        root.quick-panel-dock = root.dock-target;
                        if (root.sidebar-dock == root.dock-target) {
                            root.sidebar-collapsed = true;
                            root.set-sidebar-collapsed(true);
                        }
                        if (root.welcome-as-sidebar
                                && root.welcome-sidebar-dock == root.dock-target) {
                            root.welcome-collapsed = true;
                            root.set-welcome-collapsed(true);
                        }
                    }
                    root.panel-dragging = false;
                }
            }

            Rectangle {
                visible: root.quick-panel-open && !root.quick-panel-collapsed;
                x: root.quick-panel-dock == "left" ? parent.quick-w
                 : root.quick-panel-dock == "right" ? parent.width - parent.quick-w - 4px
                 : 0px;
                y: root.quick-panel-dock == "top" ? parent.quick-h
                 : root.quick-panel-dock == "bottom" ? parent.height - parent.quick-h - 4px
                 : 0px;
                width: parent.quick-horizontal ? 4px : parent.width;
                height: parent.quick-horizontal ? parent.height : 4px;
                background: transparent;
                quick-split-ta := TouchArea {
                    x: quick-area.quick-horizontal ? -4px : 0px;
                    y: quick-area.quick-horizontal ? 0px : -4px;
                    width: quick-area.quick-horizontal ? 12px : parent.width;
                    height: quick-area.quick-horizontal ? parent.height : 12px;
                    mouse-cursor: quick-area.quick-horizontal ? ew-resize : ns-resize;
                    moved => {
                        if (self.pressed) {
                            if (quick-area.quick-horizontal) {
                                root.quick-panel-width = clamp(
                                    root.quick-panel-dock == "right"
                                        ? quick-area.width - ((self.absolute-position.x + self.mouse-x)
                                            - quick-area.absolute-position.x)
                                        : (self.absolute-position.x + self.mouse-x)
                                            - quick-area.absolute-position.x,
                                    180px, max(200px, quick-area.width - 240px));
                            } else {
                                root.quick-panel-height = clamp(
                                    root.quick-panel-dock == "bottom"
                                        ? quick-area.height - ((self.absolute-position.y + self.mouse-y)
                                            - quick-area.absolute-position.y)
                                        : (self.absolute-position.y + self.mouse-y)
                                            - quick-area.absolute-position.y,
                                    120px, max(140px, quick-area.height - 160px));
                            }
                        }
                    }
                }
                // 1px visible line, centred inside the 4px hit-area. Lights up in
                // the theme accent on hover (Todo 3); otherwise a static
                // `border-subtle` thin line so it matches the left edge (Todo 2).
                Rectangle {
                    x: parent.width < parent.height ? (parent.width - 1px) / 2 : 0px;
                    y: parent.width < parent.height ? 0px : (parent.height - 1px) / 2;
                    width:  parent.width < parent.height ? 1px : parent.width;
                    height: parent.width < parent.height ? parent.height : 1px;
                    background: quick-split-ta.has-hover ? Theme.accent : Theme.border-subtle;
                }
            }
            }
            }

            // (Resource collapse now uses a ToolStrip inside `rest`, above.)

            // Drag-to-dock snap overlay — four edge zones; the one under the cursor
            // (root.dock-target) lights up. Purely visual (no TouchArea) so the
            // header's drag keeps receiving move events (#dock).
            if root.panel-dragging : Rectangle {
                x: 0; y: 0;
                width: parent.width;
                height: parent.height;
                Rectangle {   // left zone
                    x: 0; y: 0; width: parent.width * 0.22; height: parent.height;
                    background: root.dock-target == "left"
                        ? Theme.accent.with-alpha(0.35) : Theme.accent.with-alpha(0.10);
                    border-width: root.dock-target == "left" ? 2px : 0px;
                    border-color: Theme.accent;
                }
                Rectangle {   // right zone
                    x: parent.width * 0.78; y: 0; width: parent.width * 0.22; height: parent.height;
                    background: root.dock-target == "right"
                        ? Theme.accent.with-alpha(0.35) : Theme.accent.with-alpha(0.10);
                    border-width: root.dock-target == "right" ? 2px : 0px;
                    border-color: Theme.accent;
                }
                Rectangle {   // top zone
                    x: 0; y: 0; width: parent.width; height: parent.height * 0.22;
                    background: root.dock-target == "top"
                        ? Theme.accent.with-alpha(0.35) : Theme.accent.with-alpha(0.10);
                    border-width: root.dock-target == "top" ? 2px : 0px;
                    border-color: Theme.accent;
                }
                Rectangle {   // bottom zone
                    x: 0; y: parent.height * 0.78; width: parent.width; height: parent.height * 0.22;
                    background: root.dock-target == "bottom"
                        ? Theme.accent.with-alpha(0.35) : Theme.accent.with-alpha(0.10);
                    border-width: root.dock-target == "bottom" ? 2px : 0px;
                    border-color: Theme.accent;
                }
            }
        }
        }
    }

    // App toolbar icons (settings/download/theme/sync). They sit at the top-right
    // of the tab row — below the custom title bar when frameless (y offset), or
    // at the very top on macOS where the native title bar is separate (#119).
    // (#polish-topbar 2026-09-05) 方案 B:应用工具组迁入标题栏(见品牌区),
    // 这组浮动按钮仅在 macOS(非自定义标题栏)平台保留原位;frameless 下
    // 隐藏,标签行全宽让位给标签。
    IconBtn {
        visible: !root.custom-titlebar;
        x: root.width - 34px - root.toolbar-x-off; y: root.toolbar-y;
        icon: "settings";
        tooltip: root.lang-en ? "Settings" : "设置";
        active: root.settings-open;
        clicked => { root.settings-open = !root.settings-open; root.download-open = false; root.ssh-import-hint = ""; }
    }
    IconBtn {
        visible: !root.custom-titlebar;
        x: root.width - 64px - root.toolbar-x-off; y: root.toolbar-y;
        icon: "swap-vert";   // Material "swap_vert" — symmetrical up+down arrows, clearer "transfer" semantic
        tooltip: @tr("Transfers manager");
        active: root.download-open;
        // Pulse the button's own background instead of a separate dot in the
        // corner; the dot was visually loud and broke the icon's silhouette
        // (#breathing-light).
        breathe: root.has-active-transfers;
        clicked => { root.download-open = !root.download-open; root.settings-open = false; }
    }
    // (Removed) External breathing-dot Rectangle that previously sat on the
    // top-left of the Transfers button. The pulse now lives on the IconBtn's
    // own background via `breathe: root.has-active-transfers` above, so the
    // icon stays clean and no stray dot shows over the toolbar (#breathing-light).
    IconBtn {
        visible: !root.custom-titlebar;
        x: root.width - 94px - root.toolbar-x-off; y: root.toolbar-y;
        icon: Theme.dark ? "sun" : "moon";
        // (#polish-topbar) 去彩色(原黄/紫特例),统一单色图标体系。
        // (#theme-dedupe §5 A 类 2026-10-15) 常态图标 = 前景色
        icon-color: Theme.text-primary;
        tooltip: root.lang-en ? "Toggle theme" : "切换主题";
        clicked => { root.cycle-theme(); }
    }
    IconBtn {
        visible: !root.custom-titlebar;
        x: root.width - 124px - root.toolbar-x-off; y: root.toolbar-y;
        icon: "link";
        icon-color: root.sync-input ? Theme.accent : Theme.text-primary;   // (#theme-dedupe §5 A 类 2026-10-15) 常态 = 前景色,激活 = accent
        active: root.sync-input;
        tooltip: root.lang-en
            ? (root.sync-input ? "Sync input: ON" : "Sync input")
            : (root.sync-input ? "会话同步：开" : "会话同步");
        clicked => { root.sync-input = !root.sync-input; root.set-sync-input(root.sync-input); }
    }
    IconBtn {
        visible: !root.custom-titlebar;
        x: root.width - 154px - root.toolbar-x-off; y: root.toolbar-y;
        icon: "command-bar";   // (#polish-topbar) Material "terminal" — 比 code(</>) 更直观
        active: !root.cmd-bar-hidden;
        tooltip: root.lang-en
            ? (root.cmd-bar-hidden ? "Show command bar" : "Hide command bar")
            : (root.cmd-bar-hidden ? "显示命令栏" : "隐藏命令栏");
        clicked => { root.toggle-cmd-bar-active(); }   // (#polish-topbar-r4) 每会话独立
    }

    // (#polish-topbar-r3) 工具组已改回标题栏内布局(DBeaver 式图标+文字按
    // 钮,见标题栏块),此前的居中浮层方案移除。macOS 浮动按钮保留纯图标。

    // (#polish-topbar 2026-09-05) 标题栏按钮 tooltip 的统一浮层:声明在窗
    if topbar-tip-text != "" : Rectangle {
        x: parent.topbar-tip-x - self.width;
        y: parent.topbar-tip-y;
        width: topbar-tip-txt.preferred-width + 16px;
        height: 22px;
        background: Theme.bg-elevated;
        border-radius: Theme.radius-sm;
        border-width: 1px;
        border-color: Theme.border-strong;
        drop-shadow-blur: 8px;
        drop-shadow-color: #00000070;
        topbar-tip-txt := Text {
            text: root.topbar-tip-text;
            color: Theme.text-primary;
            font-size: Theme.fs-xs;
            horizontal-alignment: center;
            vertical-alignment: center;
            width: parent.width;
            height: parent.height;
        }
    }

    // (#logo-brand-btn) 标题栏左上角品牌 LOGO 按钮：平时静默展示品牌徽章，
    // 悬浮淡入收/展图标 +「收起/展开侧边栏」提示，点击切换左侧面板（快速
    // 连接 welcome 侧栏，走 set-welcome-collapsed 持久化）。声明在 dock-area
    // 之后 → 徽章与提示气泡天然盖在下方内容之上。
    if root.custom-titlebar : BrandLogoBtn {
        x: 0;
        y: 0;
        collapsed: root.welcome-collapsed;
        lang-en: root.lang-en;
        // (#winbtn-round-corner) 高亮块贴窗口左上角,圆角随最大化收放。
        round-top-left: !root.window-maximized;
        clicked => {
            root.welcome-collapsed = !root.welcome-collapsed;
            root.set-welcome-collapsed(root.welcome-collapsed);
        }
    }

    // (#ctx-menu-backdrop 2026-09-08) 会话右键菜单集中浮层(替代 SessionRow/
    // 组头内嵌 PopupWindow):全窗口透明 backdrop 打底,点击即关+清 key——
    // 关闭事件 100% 确定感知,Slint 1.8 popup 无 closed 回调的残留问题根治。
    // 弹层在 backdrop 之后声明 = 上层,菜单项点击不会漏到 backdrop。
    // (#ctx-menu-autoclose 2026-09-09) 安全区自动关闭(用户定稿交互):
    // 安全区 = 被右击的触发行 ∪ 菜单本体。指针在安全区内菜单稳定显示,
    // 离开安全区(含"进入过菜单后又划出")持续 ~150ms → 自动关闭。
    // 实现:backdrop(全窗口) → row-probe(触发行,盖在 backdrop 上) →
    // 菜单本体(内含垫底 menu-pad) 三层 hover 探测,任一为真即安全。
    // 打开瞬间指针尚在触发行上不会误关(ever-safe 门槛:确认进入过
    // 安全区后才开始判不安全,最坏退化为菜单常驻、由点击关闭兜底)。
    // 右击菜单外 = 仅关闭(新菜单需再次右击目标行);Esc 亦可关闭。
    if root.ctx-open-key != "" : bd := TouchArea {
        width: parent.width;
        height: parent.height;
        clicked => {
            root.ctx-open-key = "";
            root.ctx-menu-kind = "";
        }
        pointer-event(e) => {
            if (e.kind == PointerEventKind.down && e.button == PointerEventButton.right) {
                // (#ctx-menu-autoclose) 右击命中行/组头 → 一步换菜单(关闭旧 +
                // 以右击点弹新);未命中(空白/面板外) → 仅关闭。命中判定与
                // 状态写入在 Rust(open_ctx_menu_at)。
                root.open-ctx-menu-at(self.mouse-x, self.mouse-y);
            }
        }
        // (#ctx-menu-autoclose r3 2026-09-09) 安全区判定改为【几何采样】:
        // has-hover=false → 指针在菜单上(垫底层/菜单项挡住 backdrop)→ 安全;
        // has-hover=true 且指针在触发行矩形内 → 安全(右击锚点行);
        // has-hover=true 且指针在外 → 不安全,150ms 后关闭。
        // 不再用 has-hover 转发链:新建探测层的 has-hover 初始化不可靠
        // (指针不动不重算,打开瞬间误记 true 后卡死,菜单自己消失)。
        // 副产物:鼠标完全不动时坐标不变 → 判定稳定,菜单常驻(符合直觉)。
        property <bool> ptr-outside-row:
            !(self.mouse-x >= root.ctx-row-x
                && self.mouse-x <= root.ctx-row-x + root.ctx-row-w
                && self.mouse-y >= root.ctx-row-y
                && self.mouse-y <= root.ctx-row-y + root.ctx-row-h);
        property <int> unsafe-ticks: 0;
        Timer {
            interval: 75ms;
            running: true;
            triggered => {
                // (#ctx-blank-menu-fix 2026-09-15) blank 菜单没有触发行安全区:
                // 右击空白后指针多半不在(可能上翻的)菜单上,又没有 ctx-row-* 可
                // 依托,150ms 就被误判"离开安全区"自动关闭——菜单一闪而过(实测)。
                // blank 全是全局动作、也无"一步换菜单"需求,改为纯点击/Esc 关闭,
                // 不参与 hover 自动关闭;组头/成员行菜单维持原机制。
                // (#grp-menu-sticky 2026-09-15) **组头菜单也改为移出不消失**
                // (用户定稿,与 blank 同款):组头菜单全是组级动作,没有"一步
                // 换菜单"的必要;移出就关让取色面板(贴菜单弹出)很难用。关闭
                // 路径保持:点空白/点菜单项/Esc/右击别处。成员行菜单(kind=row)
                // 维持原 hover 自动关闭。
                if (root.ctx-menu-kind == "blank" || root.ctx-menu-kind == "group") {
                    bd.unsafe-ticks = 0;
                } else if (!bd.has-hover) {
                    bd.unsafe-ticks = 0;
                } else if (bd.ptr-outside-row) {
                    bd.unsafe-ticks = bd.unsafe-ticks + 1;
                    if (bd.unsafe-ticks >= 2) {
                        root.ctx-open-key = "";
                        root.ctx-menu-kind = "";
                    }
                } else {
                    bd.unsafe-ticks = 0;
                }
            }
        }
    }
    // (#ctx-menu-autoclose) Esc 关闭右键菜单(键盘兜底)。
    if root.ctx-open-key != "" : FocusScope {
        x: 0;
        y: 0;
        width: 1px;
        height: 1px;
        property <bool> fs-focus-pending: false;
        init => { self.fs-focus-pending = true; }
        Timer {
            interval: 0ms;
            running: parent.fs-focus-pending;
            triggered => {
                parent.fs-focus-pending = false;
                parent.focus();
            }
        }
        key-pressed(e) => {
            if (e.text == Key.Escape) {
                root.ctx-open-key = "";
                root.ctx-menu-kind = "";
                // (#esc-cancel-drag 2026-09-13) Esc 也要**取消正在进行的拖拽**:
                // 走与 Rust 轮询完全同一条通路(seq +1 → Welcome 的
                // changed drag-cancel-seq → cancel-drag),ghost 飞回原槽、
                // 让位与两态一起复位。原来这里只关菜单,拖拽中按 Esc 毫无反应
                // (用户实测:"ghost 飞回原位置的功能没生效")。
                root.session-drag-cancel-seq += 1;
                accept
            } else {
                reject
            }
        }
    }
    // 成员行菜单(key = session.id):编辑/复制/删除 + 移动到组列表。
    // (#ctx-menu-backdrop) 显示条件必须同时带 key 非空:关闭只清 key(kind
    // 不变),只判 kind 会让菜单在关闭后永久驻留(用户实测关不掉)。
    if root.ctx-open-key != "" && root.ctx-menu-kind == "row" : row-menu-rect := Rectangle {
        // (#topbar-click-anchor 同式钳制) 点击点右下角展开;按钮/行靠右时
        // 贴窗口右缘,y 不超窗口底。
        x: max(8px, min(root.ctx-menu-x, parent.width - self.width - 8px));
        // (#ctx-menu-flip) 菜单底超出快速连接面板底(余量不足)→ 上翻,
        // 底边贴点击点;再钳窗口底兜底。
        y: min(
            self.height > root.ctx-menu-space-below
                ? max(8px, root.ctx-menu-y - self.height)
                : root.ctx-menu-y,
            parent.height - self.height - 8px);
        // (#row-menu-layout 2026-09-15) 不再固定 140px:组名稍长就会顶出,
        // 「移动到」分区也显得挤。跟组头菜单同一套:内容宽,下限 164 / 上限 220。
        width: min(220px, max(164px, row-menu-vl.preferred-width));
        height: row-menu-vl.preferred-height;
        background: Theme.popup-bg;
        border-radius: Theme.radius-sm;
        border-width: 1px;
        border-color: Theme.border-strong;
        drop-shadow-blur: 10px;
        drop-shadow-color: #00000050;
        // (#ctx-menu-autoclose) 垫底探测:指针在菜单内非菜单项区域(空隙/
        // padding/Move to 标签行)时由此层上报安全。菜单项 TouchArea 声明
        // 在其后 = 上层,点击不受影响。
        // (#ctx-menu-autoclose) 垫底探测:指针在菜单内非菜单项区域时空隙由
        // 此层挡住 backdrop 的 hover(bd.has-hover=false → 判定"在菜单上"安全)。
        menu-pad := TouchArea { width: 100%; height: 100%; }
        row-menu-vl := VerticalLayout {
            // (#ui-refresh-v3-4 2026-09-15) 对齐设计稿 .menu:外边距 5px、行间 0;
            // 行高 28px 为本菜单既有紧凑定稿(设计稿 30px 的统一行高只约束
            // ④ 的四类组头/空白菜单),图标槽/间距与其它菜单同规格。
            padding: 5px;
            spacing: 0px;
            Rectangle {
                height: 30px;
                border-radius: Theme.radius-sm;
                background: m-edit-ta.has-hover ? Theme.bg-hover : transparent;
                m-edit-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        // 先取 key 执行动作再清:清空后 key 读不到 id。
                        root.edit-session(root.ctx-open-key);
                        root.ctx-open-key = "";
                    }
                }
                HorizontalLayout {
                    // (#ui-refresh-v3-4) 图标槽 16px + 间距 9px,同 .mi 规格。
                    padding-left: 10px; spacing: 9px;
                    Icon {
    glyph: "edit";
    tint: Theme.text-primary;
    size: Theme.fs-sm;
}
                    Text { text: @tr("Edit"); color: Theme.text-primary; font-size: Theme.fs-md; vertical-alignment: center; horizontal-stretch: 1; }
                }
            }
            Rectangle {
                height: 30px;
                border-radius: Theme.radius-sm;
                background: m-dup-ta.has-hover ? Theme.bg-hover : transparent;
                m-dup-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.duplicate-session(root.ctx-open-key); root.ctx-open-key = ""; }
                }
                HorizontalLayout {
                    // (#ui-refresh-v3-4) 图标槽 16px + 间距 9px,同 .mi 规格。
                    padding-left: 10px; spacing: 9px;
                    Icon {
    glyph: "copy";
    tint: Theme.text-primary;
    size: Theme.fs-sm;
}
                    Text { text: @tr("Duplicate"); color: Theme.text-primary; font-size: Theme.fs-md; vertical-alignment: center; horizontal-stretch: 1; }
                }
            }
            Rectangle {
                height: 30px;
                border-radius: Theme.radius-sm;
                background: m-del-ta.has-hover ? #cc333320 : transparent;
                m-del-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.remove-session(root.ctx-open-key); root.ctx-open-key = ""; }
                }
                HorizontalLayout {
                    // (#ui-refresh-v3-4) 图标槽 16px + 间距 9px,同 .mi 规格。
                    padding-left: 10px; spacing: 9px;
                    Icon {
    glyph: "delete";
    tint: #cc3333;
    size: Theme.fs-sm;
}
                    Text { text: @tr("Delete"); color: #cc3333; font-size: Theme.fs-md; vertical-alignment: center; horizontal-stretch: 1; }
                }
            }
            // (#ui-refresh-v3-4) 分隔线统一为内缩式(9px 区高 + 线左右各缩 6px),
            // 与组头/空白菜单同一画法;旧 1px 全宽线顶到菜单边缘,分区感突兀。
            Rectangle {
                height: 9px;
                Rectangle { y: 4px; x: 0px; width: parent.width; height: 1px; background: Theme.border-subtle; }
            }
            // (#move-to-compact 2026-09-14) "移动到"分区紧凑化(第三轮):
            //  · 标题行 22 → 18px:标题只是分区标签,过高会在它与第一个组名
            //    之间堆出一段空白(用户实测"移动到和下面组别之间间距太多");
            //  · 外层 spacing 由 2 收到 1(见 row-menu-vl),条目之间的空档
            //    再收一半;
            //  · 末尾不再留 2px 呼吸位(它叠加在 spacing 上也是多余留白)。
            // 层级仍靠缩进差(标题 10 / 条目 20)+ 颜色(次要色 / 主色)表达。
            Rectangle {
                height: 30px;
                HorizontalLayout {
                    // (#move-to-icon 2026-09-15) 分区标题也走 16px 图标槽,与上面
                    // 编辑/复制/删除对齐;drive_file_move(E9A1) 表示"移到某组"。
                    padding-left: 10px; spacing: 9px;
                    Icon {
    glyph: "move-to-group";
    // (#theme-dedupe 2026-10-15) 分区标题 muted → 次级档(层级靠缩进+颜色,见 #move-to-compact)
    tint: Theme.text-secondary;
    size: Theme.fs-sm;
}
                    Text {
                        text: @tr("Move to");
                        // (#theme-dedupe 2026-10-15) 分区标题 muted → 次级档(条目是主色,见 #move-to-compact)
                        color: Theme.text-secondary;
                        font-size: Theme.fs-sm;
                        vertical-alignment: center;
                    }
                }
            }
            // (#move-to-groups 2026-09-14) 组清单改由 Rust 提供
            // (move-target-groups):**默认组恒居首位**,其后是具名组。
            // 旧实现遍历 root.sessions 再 `visible:` 过滤,有两个毛病(用户实测):
            //  ① `visible:false` 的行**仍各占一个 spacing** —— 几十个隐形行把
            //     菜单撑出一串空档,"组与组之间留有空隙、间距很大";
            //  ② 默认组只有在**存在未分组成员**时才有对应行,未分组会话移空后
            //     "默认组"整个从菜单里消失,而"第一位永远是默认组"是用户定稿。
            // 现在渲染的是"组"本身(不再是"恰好带组的行"),`visible` 换 `if`
            // ——条件为假时元素不进布局,也就不占 spacing,组与组严丝合缝。
            for g in root.move-target-groups : Rectangle {
                // (#move-to-hide-current 2026-09-14) 排除成员**当前所在的显示组**:
                // 具名组成员不列本组名;默认组成员(session.group 为空串,历史遗留
                // 也可能是 "default")不列「默认组」——点它本就是无操作,列着反而
                // 让人以为默认组有什么特殊地位(用户定稿撤销 #move-to-default-always)。
                // 默认组仍居清单首位,只是"人已在其中"时和其他组一样隐藏。
                visible: g != (root.ctx-menu-group == ""
                    || root.ctx-menu-group == "default" ? "default" : root.ctx-menu-group);
                height: self.visible ? 30px : 0px;
                border-radius: Theme.radius-sm;
                background: m-mv-ta.has-hover ? Theme.bg-hover : transparent;
                m-mv-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.move-session(root.ctx-open-key, g); root.ctx-open-key = ""; }
                }
                HorizontalLayout {
                    // (#row-menu-layout 2026-09-15) 组名与「移动到」标题同一左缘
                    // (10 + 16 图标槽 + 9),不再多缩进 10px —— 那会让文件夹图标
                    // 和上面几行错开,菜单显得乱。层级改由「标题 muted / 组名
                    // primary」表达,不必靠缩进。
                    padding-left: 10px; spacing: 9px;
                    Icon {
    glyph: "folder";
    tint: Theme.text-primary;
    size: Theme.fs-sm;
}
                    Text {
                        // (#move-to-default-label) 默认组存储名是 "default",菜单里
                        // 与组头/落点标签同一口径显示「默认组」,避免中文界面下
                        // 冒出英文 "default"(用户实测)。
                        text: g == "default" ? @tr("Default group") : g;
                        color: Theme.text-primary;
                        font-size: Theme.fs-md;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }
                }
            }
        }
    }
    // 组头菜单(key = "hdr:"+组名):编辑分组/删除分组(空组)/新建分组。
    // 同成员菜单:条件带 key 非空,否则关闭后不消失。
    // (#ctx-blank-menu 2026-09-13) 列表**空白处**右键菜单:全部展开 / 全部折叠 /
    // 隐藏·显示本地终端。三项都是**全局**动作,与具体组无关。
    if root.ctx-open-key == "blank" && root.ctx-menu-kind == "blank" : blank-menu-rect := Rectangle {
        x: max(8px, min(root.ctx-menu-x, parent.width - self.width - 8px));
        y: min(
            self.height > root.ctx-menu-space-below
                ? max(8px, root.ctx-menu-y - self.height - 4px)
                : root.ctx-menu-y,
            parent.height - self.height - 8px);
        // (#ctx-blank-menu-fix 2026-09-15) 上翻时补 4px 间隙:菜单底边不死贴
        // 右击点,更接近系统右键菜单手感。
        // (#ctx-menu-fit 2026-09-13) 宽度**跟着内容走**:固定宽会让较长的条目
        // (如英文 "Hide Local Terminals")顶出右缘、和左边距也不对称。取布局
        // 首选宽 + 10px —— 与条目内部的 padding-left(10px) 相加后,左右两侧
        // 留下的空白完全一致,任何语言都刚好包住文字。
        // (#ctx-menu-narrow 2026-09-15) 统一固定 190px(与组头菜单一致)。
        width: 190px;
        height: blank-menu-vl.preferred-height;
        background: Theme.popup-bg;
        border-radius: Theme.radius-sm;
        border-width: 1px;
        border-color: Theme.border-strong;
        drop-shadow-blur: 10px;
        drop-shadow-color: #00000050;
        b-pad := TouchArea { width: 100%; height: 100%; }
        blank-menu-vl := VerticalLayout {
            // (#ui-refresh-v3-4 2026-09-15) 对齐设计稿 .menu:外边距 5px、行间 0。
            padding: 5px;
            spacing: 0px;
            // (#ctx-blank-menu-fix 2026-09-15) 增补「新建会话 / 新建分组」:
            // 空白处右键新建是高频直觉操作(设计稿 v3 增补项)。动作与标题栏
            // "+ 新建会话"、组头菜单「新建分组」完全同源。
            Rectangle {
                height: 30px;
                border-radius: Theme.radius-sm;
                background: b-new-sess-ta.has-hover ? Theme.bg-hover : transparent;
                b-new-sess-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.ctx-open-key = ""; root.ctx-menu-kind = ""; root.new-session-clicked(); }
                }
                HorizontalLayout {
                    // (#ui-refresh-v3-4) 图标槽 16px + 间距 9px,同 .mi 规格。
                    padding-left: 10px; spacing: 9px;
                    Icon {
    glyph: "new-session";
    tint: Theme.text-primary;
    size: Theme.fs-sm;
}
                    Text { text: root.lang-en ? "New session" : "新建会话"; color: Theme.text-primary; font-size: Theme.fs-md; vertical-alignment: center; horizontal-stretch: 1; }
                }
            }
            Rectangle {
                height: 30px;
                border-radius: Theme.radius-sm;
                background: b-new-grp-ta.has-hover ? Theme.bg-hover : transparent;
                b-new-grp-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.ctx-open-key = "";
                        root.ctx-menu-kind = "";
                        root.group-dialog-orig = "";
                        root.group-dialog-name = "";
                        root.group-dialog-error = "";
                        root.group-dialog-color-hex = "";
                        root.group-dialog-color = #00000000;
                        root.group-dialog-open = true;
                    }
                }
                HorizontalLayout {
                    // (#ui-refresh-v3-4) 图标槽 16px + 间距 9px,同 .mi 规格。
                    padding-left: 10px; spacing: 9px;
                    Icon {
    glyph: "create-new-folder";
    tint: Theme.text-primary;
    size: Theme.fs-sm;
}
                    Text { text: @tr("New group"); color: Theme.text-primary; font-size: Theme.fs-md; vertical-alignment: center; horizontal-stretch: 1; }
                }
            }
            Rectangle {
                height: 9px;
                Rectangle { y: 4px; x: 0px; width: parent.width; height: 1px; background: Theme.border-subtle; }
            }
            Rectangle {
                height: 30px;
                border-radius: Theme.radius-sm;
                background: b-exp-ta.has-hover ? Theme.bg-hover : transparent;
                b-exp-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.ctx-open-key = ""; root.set-all-groups-collapsed(false); }
                }
                HorizontalLayout {
                    // (#ui-refresh-v3-4) 图标槽 16px + 间距 9px,同 .mi 规格。
                    padding-left: 10px; spacing: 9px;
                    Icon {
    glyph: "unfold-more";
    tint: Theme.text-primary;
    size: Theme.fs-sm;
}
                    Text { text: @tr("Expand all"); color: Theme.text-primary; font-size: Theme.fs-md; vertical-alignment: center; horizontal-stretch: 1; }
                }
            }
            Rectangle {
                height: 30px;
                border-radius: Theme.radius-sm;
                background: b-col-ta.has-hover ? Theme.bg-hover : transparent;
                b-col-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.ctx-open-key = ""; root.set-all-groups-collapsed(true); }
                }
                HorizontalLayout {
                    // (#ui-refresh-v3-4) 图标槽 16px + 间距 9px,同 .mi 规格。
                    padding-left: 10px; spacing: 9px;
                    Icon {
    glyph: "unfold-less";
    tint: Theme.text-primary;
    size: Theme.fs-sm;
}
                    Text { text: @tr("Collapse all"); color: Theme.text-primary; font-size: Theme.fs-md; vertical-alignment: center; horizontal-stretch: 1; }
                }
            }
            // 分隔线(高保真 v3:新建 ─ 展开/折叠 ─ 隐藏本地终端)。
            Rectangle {
                height: 9px;
                Rectangle { y: 4px; x: 0px; width: parent.width; height: 1px; background: Theme.border-subtle; }
            }
            Rectangle {
                height: 30px;
                border-radius: Theme.radius-sm;
                background: b-sys-ta.has-hover ? Theme.bg-hover : transparent;
                b-sys-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.ctx-open-key = ""; root.set-system-group-hidden(!root.system-hidden); }
                }
                HorizontalLayout {
                    // (#ui-refresh-v3-4) 图标槽 16px + 间距 9px,同 .mi 规格。
                    padding-left: 10px; spacing: 9px;
                    Icon {
    glyph: root.system-hidden ? "visibility" : "visibility-off";
    tint: Theme.text-primary;
    size: Theme.fs-sm;
}
                    Text { text: root.system-hidden ? @tr("Show Local Terminals") : @tr("Hide Local Terminals"); color: Theme.text-primary; font-size: Theme.fs-md; vertical-alignment: center; horizontal-stretch: 1; }
                }
            }
        }
    }

    if root.ctx-open-key != "" && root.ctx-menu-kind == "group" : grp-menu-rect := Rectangle {
        x: max(8px, min(root.ctx-menu-x, parent.width - self.width - 8px));
        y: min(
            self.height > root.ctx-menu-space-below
                ? max(8px, root.ctx-menu-y - self.height)
                : root.ctx-menu-y,
            parent.height - self.height - 8px);
        // (#ctx-menu-fit 2026-09-13) 宽度跟着内容走,左右留白一致。
        // (#ui-menu-compact-right 2026-09-15) 不再固定 190px:那会把"分组颜色"
        // 行的色块+箭头硬顶到菜单右缘,中间被 stretch 撑出一大块空档(用户
        // 截图"右侧看起来很空")。改回内容宽,色块紧贴文字;下限 164px 保证
        // 「隐藏本地终端」放得下,上限 220px 防英文长条目撑破。
        width: min(220px, max(164px, grp-menu-vl.preferred-width));
        height: grp-menu-vl.preferred-height;
        background: Theme.popup-bg;
        border-radius: Theme.radius-sm;
        border-width: 1px;
        border-color: Theme.border-strong;
        drop-shadow-blur: 10px;
        drop-shadow-color: #00000050;
        // (#ctx-menu-autoclose) 垫底探测 + 安全区聚合 + 自动关闭,
        // 同 row 菜单(组头菜单无动态项,全静态聚合)。
        // (#ctx-menu-autoclose) 垫底探测:同 row 菜单,挡住 backdrop hover。
        g-pad := TouchArea { width: 100%; height: 100%; }
        grp-menu-vl := VerticalLayout {
            // (#ui-refresh-v3-4 2026-09-15) 对齐设计稿 .menu:外边距 5px、
            // **行间 0**(行高 30px 自带紧凑感,行与行之间不再加空档)。
            padding: 5px;
            spacing: 0px;
            // (#default-group-locked 2026-09-10) 默认组是保留组、不可重命名
            // (Rust rename_group 会以"该名称为系统保留分组"拒绝)。隐藏入口,
            // 避免"点开对话框 → 提交 → 才报错"的空转。删除项本就不出现:
            // 默认组头行是成员行(id 非空),ctx-menu-empty 恒 false。
            // (#group-color-reserved 2026-09-14) system 组头现在也能右击(为改色),
            // 同样按保留名收起"编辑分组" —— 这条判断是唯一的门禁。
            if root.ctx-menu-group != "default" && root.ctx-menu-group != "system" : Rectangle {
                height: 30px;
                border-radius: Theme.radius-sm;
                background: g-edit-ta.has-hover ? Theme.bg-hover : transparent;
                g-edit-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.ctx-open-key = "";
                        root.group-dialog-orig = root.ctx-menu-group;
                        root.group-dialog-name = root.ctx-menu-group;
                        root.group-dialog-error = "";
                        // (#group-dialog-color 2026-09-14) 带上该组**当前色**做草稿
                        // 初值 —— 右击时已注入 ctx-menu-group-color(-hex),这里直接
                        // 借用,不必再让 Rust 查一次。
                        root.group-dialog-color-hex = root.ctx-menu-group-color-hex;
                        root.group-dialog-color = root.ctx-menu-group-color;
                        root.group-dialog-open = true;
                    }
                }
                HorizontalLayout {
                    // (#ui-refresh-v3-4 2026-09-15) 对齐设计稿 .mi:图标槽恒
                    // **16px 居中**(Material 字形宽窄不一,无固定槽时各行文字
                    // 起点参差 —— "菜单文字排版乱"的主因),图标与文字间距 9px。
                    padding-left: 10px; spacing: 9px;
                    Icon {
    glyph: "edit";
    tint: Theme.text-primary;
    size: Theme.fs-sm;
}
                    Text { text: @tr("Edit group"); color: Theme.text-primary; font-size: Theme.fs-md; vertical-alignment: center; horizontal-stretch: 1; }
                }
            }
            // (#group-color 2026-09-14) 分组颜色入口。点击**不清 ctx-open-key**
            // —— 菜单保持打开,取色面板贴菜单边缘出现(用户定稿:"点击色卡出现
            // 控件、菜单不消失,左侧面板一起联动")。
            // 对**所有组**可见(含 default / system):"编辑分组"那项只对具名组
            // 可见(default 是保留名),两者条件不同,故是两个独立块。
            Rectangle {
                height: 30px;
                border-radius: Theme.radius-sm;
                // 面板展开时保持高亮,提示"正在调这一组的色"。
                background: g-color-ta.has-hover || root.group-color-picker-open ? Theme.bg-hover : transparent;
                g-color-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.group-color-picker-open = !root.group-color-picker-open; }
                }
                HorizontalLayout {
                    // (#ui-fix-align 2026-09-15) **不能设 alignment: center**:
                    // 那是主轴(水平)对齐,会让整行内容居中、stretch 失效 ——
                    // 色块贴着文字、箭头漂移,与其它行(图标恒从左缘 10px 起)
                    // 规则不一致,三个菜单全都错位(用户截图)。删掉后本行与
                    // 其它行同一套规则:图标槽 16px 从左缘起,色块 + ▶ 靠右缘。
                    padding-left: 10px; padding-right: 8px; spacing: 9px;
                    Icon {
    glyph: "palette";
    tint: Theme.text-primary;
    size: Theme.fs-sm;
}
                    Text { text: @tr("Group color"); color: Theme.text-primary; font-size: Theme.fs-md; vertical-alignment: center; }
                    // (#ui-menu-compact-right 2026-09-15) **不要 stretch**:stretch
                    // 会把色块+箭头推到菜单右缘,中间空出一大块(用户截图)。色块
                    // 紧跟文字 6px,箭头再跟 4px,整组作为文字的后缀。菜单其它行
                    // 文字带 horizontal-stretch,整菜单宽度由最长行("隐藏本地终端")
                    // 决定,本行自然短一截、右侧不再空。
                    Rectangle { width: 6px; }
                    // (#ui-fix-align) 色块垂直居中靠**外壳**:壳横向 13px、纵向
                    // 撑满行高(布局交叉轴拉伸),内层 13×13 手算 y 居中 ——
                    // Slint 的 Rectangle 没有 vertical-alignment,裸放固定高度
                    // 的色块会偏上行高的一半(用户截图:色块与文字不在一条线)。
                    // 13×13 / 圆角 3.5,同高保真 .mi .sw 规格;无色 = 透明底 +
                    // 描边,与取色面板 / 对话框里的当前色块同口径。
                    Rectangle {
                        width: 13px;
                        Rectangle {
                            y: (parent.height - 13px) / 2;
                            width: 13px;
                            height: 13px;
                            border-radius: 3.5px;
                            background: root.ctx-menu-group-color-hex != ""
                                ? root.ctx-menu-group-color : transparent;
                            border-width: 1px;
                            border-color: root.ctx-menu-group-color-hex != ""
                                ? Theme.border-strong : Theme.text-muted;
                        }
                    }
                    // ▶ 展开箭头:暗示侧挂取色面板。槽收成 12px,紧贴色块。
                    // (#icon-svg-migration) 显式 width 沿用原 Text 的 12px 槽:
                    // Icon 在布局里取 preferred(=size=13px),比原槽宽 1px,会把
                    // 后面的色块右推。宽度与 size 分开，与原 Text「12px 槽里居中」
                    // 一一对应。
                    Icon {
                        width: 12px;
                        glyph: "chevron-right";
                        tint: Theme.text-muted;
                        size: Theme.fs-sm;
                    }
                }
            }
            // 分隔线A(高保真 v3:编辑分组/分组颜色 ─ 新建/删除 ─ 隐藏本地终端)。
            Rectangle {
                height: 9px;
                Rectangle { y: 4px; x: 0px; width: parent.width; height: 1px; background: Theme.border-subtle; }
            }
            // (#ctx-menu-narrow 2026-09-15) system(本地终端)保留组收起「新建分组」:
            // 保留组是容器不是分类,不该往里建组;菜单与设计稿一致只留 改色+隐藏。
            // (#ui-fix-menu-sep 2026-09-15) 顺序对齐设计稿:新建在前、删除在后
            // (危险项收尾,同分区不加分隔线)。
            if root.ctx-menu-group != "system" : Rectangle {
                height: 30px;
                border-radius: Theme.radius-sm;
                background: g-new-ta.has-hover ? Theme.bg-hover : transparent;
                g-new-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.ctx-open-key = "";
                        root.group-dialog-orig = "";
                        root.group-dialog-name = "";
                        root.group-dialog-error = "";
                        // 新建组的颜色草稿从"无色"起(默认就不该有颜色)。
                        root.group-dialog-color-hex = "";
                        root.group-dialog-color = #00000000;
                        root.group-dialog-open = true;
                    }
                }
                HorizontalLayout {
                    // (#ui-refresh-v3-4) 图标槽 16px + 间距 9px,同 .mi 规格。
                    padding-left: 10px; spacing: 9px;
                    Icon {
    glyph: "create-new-folder";
    tint: Theme.text-primary;
    size: Theme.fs-sm;
}
                    Text { text: @tr("New group"); color: Theme.text-primary; font-size: Theme.fs-md; vertical-alignment: center; horizontal-stretch: 1; }
                }
            }
            // (#ctx-menu-narrow 2026-09-15) system 保留组无「删除分组」可谈
            // (它永远非空且不可删),一并收起。
            if root.ctx-menu-empty && root.ctx-menu-group != "system" : Rectangle {
                height: 30px;
                border-radius: Theme.radius-sm;
                background: g-del-ta.has-hover ? #cc333320 : transparent;
                g-del-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.ctx-open-key = ""; root.delete-group(root.ctx-menu-group); }
                }
                HorizontalLayout {
                    // (#ui-refresh-v3-4) 图标槽 16px + 间距 9px,同 .mi 规格。
                    padding-left: 10px; spacing: 9px;
                    Icon {
    glyph: "delete";
    tint: #cc3333;
    size: Theme.fs-sm;
}
                    Text { text: @tr("Delete group"); color: #cc3333; font-size: Theme.fs-md; vertical-alignment: center; horizontal-stretch: 1; }
                }
            }
            // 分隔线B(新建/删除 ─ 隐藏本地终端)。(#ui-fix-menu-sep) **仅当
            // 中段有内容行**(新建分组可见,即非 system)才渲染 —— 本地终端
            // 菜单中段整段隐藏,两条分隔线直接相邻叠出"两条横线"(用户截图),
            // 这里收掉一条,只留分隔线A。
            if root.ctx-menu-group != "system" : Rectangle {
                height: 9px;
                Rectangle { y: 4px; x: 0px; width: parent.width; height: 1px; background: Theme.border-subtle; }
            }
            // (#ctx-blank-menu 2026-09-13) 组头菜单里也放一份"隐藏 / 显示本地终端":
            // 手上正按着某个组时不必先去找空白处。文案随状态切换。
            Rectangle {
                height: 30px;
                border-radius: Theme.radius-sm;
                background: g-sys-ta.has-hover ? Theme.bg-hover : transparent;
                g-sys-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.ctx-open-key = ""; root.set-system-group-hidden(!root.system-hidden); }
                }
                HorizontalLayout {
                    // (#ui-refresh-v3-4) 图标槽 16px + 间距 9px,同 .mi 规格。
                    padding-left: 10px; spacing: 9px;
                    Icon {
    glyph: root.system-hidden ? "visibility" : "visibility-off";
    tint: Theme.text-primary;
    size: Theme.fs-sm;
}
                    Text { text: root.system-hidden ? @tr("Show Local Terminals") : @tr("Hide Local Terminals"); color: Theme.text-primary; font-size: Theme.fs-md; vertical-alignment: center; horizontal-stretch: 1; }
                }
            }
        }

        // (#group-color 2026-09-14) 取色面板:与菜单**并存**(菜单不消失)。
        // 必须声明在 grp-menu-rect **内部** —— Slint 不允许从条件元素外部访问
        // 它的 id(实测 "Cannot access id 'grp-menu-rect'"),而面板要贴菜单边缘
        // 就得读菜单几何。作为菜单的子元素绝对定位到菜单矩形之外即可(父元素
        // 默认不裁剪)。z 序在 grp-menu-vl 之后 = 最上层:指针落在面板上时
        // backdrop 的 has-hover 为 false,自动关闭逻辑天然把它算作安全区。
        if root.group-color-picker-open : gc-panel := Rectangle {
            // (#group-color-field-r2 2026-09-15) 200 → 242px:容纳 32px 大色格
            // (6 列 222px + 内边距 20px = 242)。宽度必须与内容严丝合缝 ——
            // GridLayout 会拉伸子项,面板过宽时色格变宽扁、不再是正方形(实测)。
            property <length> pw: 242px;
            // 相对菜单:右侧(菜单宽 + 4px)/ 左侧(x 为负)。4px 缝是刻意的
            // (两块卡片分离),鼠标横穿几毫秒,不足以触发 150ms 的关闭防抖。
            property <length> right-x: parent.width + 4px;
            property <length> left-x: -self.pw - 4px;
            // 菜单贴窗口右缘时右侧放不下 → 翻到左侧;左侧也越界则钳到窗口左缘
            // (极端窄窗口下与菜单重叠,兜底)。
            property <bool> fits-right: parent.x + self.right-x + self.pw + 8px <= root.width;
            x: self.fits-right ? self.right-x : max(8px - parent.x, self.left-x);
            // 顶与菜单对齐;面板比菜单高时上移,保证底边不越窗口底。
            y: min(0px, root.height - parent.y - self.height - 8px);
            width: self.pw;
            height: gc-body.preferred-height;
            background: Theme.popup-bg;
            border-radius: Theme.radius-md;
            border-width: 1px;
            border-color: Theme.border-strong;
            drop-shadow-blur: 12px;
            drop-shadow-color: #00000060;

            // 垫底:吃掉面板空白处的点击(与菜单的 g-pad 同责),不让它落到
            // backdrop 上把菜单关掉。
            gc-pad := TouchArea { width: 100%; height: 100%; }

            gc-body := VerticalLayout {
                padding: 10px;
                spacing: 0px;
                // (#group-color-field 2026-09-14) 面板内容整体交给共用组件:与新建 /
                // 编辑分组对话框**同一套控件**,布局只在组件里维护一份。
                // 面板语义 = 点即提交(写盘 + 广播 + 回写菜单色块),与对话框的
                // "先暂存、随确定提交"区别只体现在这个回调里。
                // (#picker-no-dup-header 2026-09-15) 关掉头部:菜单项已经是
                // 「分组颜色 + 色块 + hex」,面板再画一行圆点/标题/hex 就是
                // 重复(用户截图)。面板只留色格 + 无颜色 + 输入。
                GroupColorField {
                    show-header: false;
                    hex <=> root.ctx-menu-group-color-hex;
                    value: root.ctx-menu-group-color;
                    palette: root.group-palette;
                    // 面板语义 = 点即提交:落盘 + 广播 + 回写这两个 property,
                    // 颜色因此由 Rust 归一化后的结果决定,不在 UI 侧猜。
                    picked(hex) => { root.set-group-color(root.ctx-menu-group, hex); }
                }
            }
        }
    }

    // (#session-hover-card 2026-09-05) 成员行悬停信息卡片的集中浮层:
    // SessionRow 经 Welcome 中转写入(名称/主机/备注 + 坐标),窗口根尾部
    // 渲染 = 最顶层且不被列表裁剪;普通元素不拦截鼠标,hover 离开即消失。
    // (#session-hover-card-r2) 键值逐行排版(名称/主机/备注各一行,标签
    // 固定宽左列对齐),备注有内容才显示。
    // (#conn-path 2026-10-04 高保真 #proxy-fields) 信息卡升级:键值对带全角
    // 冒号(名称：/主机：/用户：/认证：/备注：),用户与认证行新增(非空才显示;
    // 无分组行 —— 列表已按分组组织);**跟随鼠标、光标右上角**(welcome 侧
    // Timer 150ms 首锚 + pointer-event move 跟手;此处按卡宽/卡高做翻转)。
    // (#session-hover-card-r4 2026-10-06) 更贴近指针:右偏 14→10px、上偏
    // 12→8px;翻转阈值 8px 不变。
    // (#jumptip-pos-r3 2026-10-05) **弹框打开时隐藏**:SessionDialog 是后渲染
    // 的全屏遮罩,但本卡挂根尾部 z 序更高——悬停列表后开弹框,卡残留浮在
    // 弹框标题上(用户截图);会话弹框/删除确认等任一打开即不显示。
    if session-card-name != "" && !root.dialog-open
        && !root.confirm-delete-open && !root.paste-confirm-open
        && !root.hostkey-prompt-open : Rectangle {
        property <int> row-n: 2 + (session-card-user != "" ? 1 : 0)
            + (session-card-auth != "" ? 1 : 0) + (session-card-note != "" ? 1 : 0);
        x: session-card-x + 10px + self.width > parent.width - 8px
            ? max(8px, session-card-x - self.width - 10px) : session-card-x + 10px;
        y: session-card-y - self.height - 8px < 8px
            ? session-card-y + 20px : session-card-y - self.height - 8px;
        // 卡宽 = 最宽行内容 + 键列 44 + 内边距;备注长则 elide。上限钳到窗宽。
        width: min(parent.width - 60px,
            Math.max(sc-host.preferred-width, sc-name.preferred-width) + 76px);
        height: 18px + self.row-n * 22px;
        // (#session-card-twin 2026-10-05) 视觉参数对齐跳板机 tip 卡(#proxy-fields):
        // elevated 底 / 9px 圆角 / subtle 边框 / 24px 大投影 / 行距 2px,
        // 名称行主色、其余次色 —— 两处悬浮卡同款(用户要求)。
        background: Theme.bg-elevated;
        border-radius: 9px;
        border-width: 1px;
        border-color: Theme.border-subtle;
        drop-shadow-blur: 24px;
        drop-shadow-color: #00000045;
        VerticalLayout {
            padding: 9px;
            padding-left: 12px;
            padding-right: 12px;
            spacing: 2px;
            // (#conn-path) 键值单行连排(同跳板信息卡):避免全角冒号+键列宽叠加
            // 出现的大间隙。
            sc-name := Text {
                text: (root.lang-en ? "Name:" : "名称：") + root.session-card-name;
                color: Theme.text-primary;
                font-size: Theme.fs-xs;
                overflow: elide;
            }
            sc-host := Text {
                text: (root.lang-en ? "Host:" : "主机：") + root.session-card-host;
                // (#hover-card-uniform 2026-10-11) 各行亮度统一为**主文本色**
                // （用户反馈：次级色比名称行暗一档不协调）。
                color: Theme.text-primary;
                font-size: Theme.fs-xs;
                overflow: elide;
            }
            if session-card-user != "" : Text {
                text: (root.lang-en ? "User:" : "用户：") + root.session-card-user;
                color: Theme.text-primary;
                font-size: Theme.fs-xs;
                overflow: elide;
            }
            if session-card-auth != "" : Text {
                text: (root.lang-en ? "Auth:" : "认证：") + root.session-card-auth-display();
                color: Theme.text-primary;
                font-size: Theme.fs-xs;
                overflow: elide;
            }
            if session-card-note != "" : Text {
                text: (root.lang-en ? "Note:" : "备注：") + root.session-card-note;
                color: Theme.text-primary;
                font-size: Theme.fs-xs;
                overflow: elide;
            }
        }
    }

    // (#tab-card 2026-10-11) tab 悬浮信息卡：与左侧组内成员信息卡同款视觉
    // （elevated 底 / 9px 圆角 / subtle 边框 / 24px 投影 / 键值单行连排），
    // 新增「频道」行（已加入频道才有；暂停态附注）。跟手/翻转公式同上卡。
    // (#sync-dialog-v2 2026-10-12) 补 用户/认证/组别 三行（行序与同步输入卡
    // 一致：名称/主机/用户/认证/组别/备注/频道）。认证显示名复用
    // session-card-auth-display（同一张映射）。⚠️ 行显隐用 `if`（visible:false
    // 在 Slint 布局里仍占位会留空行）；卡宽测量用**隐藏测量元素**（卡片层
    // 直挂、不在 VerticalLayout 内，不占布局，读 preferred-width 即可——if 行
    // 的 id 在外层不可见，所以走这路）。
    if tab-card-title != "" && !root.dialog-open : Rectangle {
        property <int> row-n: 1 + (tab-card-host != "" ? 1 : 0)
            + (tab-card-user != "" ? 1 : 0) + (tab-card-auth != "" ? 1 : 0)
            + (tab-card-group != "" ? 1 : 0) + (tab-card-note != "" ? 1 : 0)
            + (tab-card-channel != "" ? 1 : 0);
        x: tab-card-x + 10px + self.width > parent.width - 8px
            ? max(8px, tab-card-x - self.width - 10px) : tab-card-x + 10px;
        y: tab-card-y - self.height - 8px < 8px
            ? tab-card-y + 20px : tab-card-y - self.height - 8px;
        width: min(parent.width - 60px,
            Math.max(tc-m-title.preferred-width, tc-m-host.preferred-width,
                     tc-m-user.preferred-width, tc-m-auth.preferred-width,
                     tc-m-group.preferred-width,
                     tc-m-channel.preferred-width) + 76px);
        height: 18px + self.row-n * 22px;
        background: Theme.bg-elevated;
        border-radius: 9px;
        border-width: 1px;
        border-color: Theme.border-subtle;
        drop-shadow-blur: 24px;
        drop-shadow-color: #00000045;
        // 隐藏测量元素（不参与布局：直挂卡片层 + visible false）
        tc-m-title := Text {
            visible: false;
            text: (root.lang-en ? "Name:" : "名称：") + root.tab-card-title;
            font-size: Theme.fs-xs;
        }
        tc-m-host := Text {
            visible: false;
            text: (root.lang-en ? "Host:" : "主机：") + root.tab-card-host;
            font-size: Theme.fs-xs;
        }
        tc-m-user := Text {
            visible: false;
            text: (root.lang-en ? "User:" : "用户：") + root.tab-card-user;
            font-size: Theme.fs-xs;
        }
        tc-m-auth := Text {
            visible: false;
            text: (root.lang-en ? "Auth:" : "认证：") + root.auth-display-name(root.tab-card-auth);
            font-size: Theme.fs-xs;
        }
        tc-m-group := Text {
            visible: false;
            text: (root.lang-en ? "Group:" : "组别：") + root.tab-card-group;
            font-size: Theme.fs-xs;
        }
        tc-m-channel := Text {
            visible: false;
            text: (root.lang-en ? "Channel:" : "频道：")
                + (root.lang-en ? "Channel " : "频道 ") + root.tab-card-channel
                + (root.tab-card-channel-paused
                    ? (root.lang-en ? " (paused)" : "（已暂停同步）") : "");
            font-size: Theme.fs-xs;
        }
        VerticalLayout {
            padding: 9px;
            padding-left: 12px;
            padding-right: 12px;
            spacing: 2px;
            Text {
                text: (root.lang-en ? "Name:" : "名称：") + root.tab-card-title;
                color: Theme.text-primary;
                font-size: Theme.fs-xs;
                overflow: elide;
            }
            if tab-card-host != "" : Text {
                text: (root.lang-en ? "Host:" : "主机：") + root.tab-card-host;
                // (#hover-card-uniform) 亮度与名称行统一（主文本色）
                color: Theme.text-primary;
                font-size: Theme.fs-xs;
                overflow: elide;
            }
            if tab-card-user != "" : Text {
                text: (root.lang-en ? "User:" : "用户：") + root.tab-card-user;
                color: Theme.text-primary;
                font-size: Theme.fs-xs;
                overflow: elide;
            }
            if tab-card-auth != "" : Text {
                text: (root.lang-en ? "Auth:" : "认证：") + root.auth-display-name(root.tab-card-auth);
                color: Theme.text-primary;
                font-size: Theme.fs-xs;
                overflow: elide;
            }
            if tab-card-group != "" : Text {
                text: (root.lang-en ? "Group:" : "组别：") + root.tab-card-group;
                color: Theme.text-primary;
                font-size: Theme.fs-xs;
                overflow: elide;
            }
            if tab-card-note != "" : Text {
                text: (root.lang-en ? "Note:" : "备注：") + root.tab-card-note;
                color: Theme.text-primary;
                font-size: Theme.fs-xs;
                overflow: elide;
            }
            if tab-card-channel != "" : Text {
                text: (root.lang-en ? "Channel:" : "频道：")
                    + (root.lang-en ? "Channel " : "频道 ") + root.tab-card-channel
                    + (root.tab-card-channel-paused
                        ? (root.lang-en ? " (paused)" : "（已暂停同步）") : "");
                color: Theme.text-primary;
                font-size: Theme.fs-xs;
                overflow: elide;
            }
        }
    }

    // (#chbar-tip-root 2026-10-11) 频道状态条截断提示：单行浮层跟随鼠标
    // （指针上方，翻转公式同 session-card）；hover 离开即消失（text 清空）。
    if chbar-stat-tip != "" : Rectangle {
        property <length> tip-w: chbar-tip-txt.preferred-width + 16px;
        x: chbar-stat-tip-x + 10px + self.tip-w > parent.width - 8px
            ? max(8px, chbar-stat-tip-x - self.tip-w - 10px) : chbar-stat-tip-x + 10px;
        y: chbar-stat-tip-y - self.height - 8px < 8px
            ? chbar-stat-tip-y + 20px : chbar-stat-tip-y - self.height - 8px;
        width: self.tip-w;
        height: 22px;
        background: Theme.bg-elevated;
        border-radius: Theme.radius-sm;
        border-width: 1px;
        border-color: Theme.border-strong;
        drop-shadow-blur: 8px;
        drop-shadow-color: #00000070;
        chbar-tip-txt := Text {
            width: 100%; height: 100%;
            text: root.chbar-stat-tip;
            color: Theme.text-primary; font-size: Theme.fs-xs;
            horizontal-alignment: center; vertical-alignment: center;
        }
    }

    // (#chbar-menu-root 2026-10-11) 频道 ⋮ 菜单的根层集中浮层。结构 =
    // 全窗透明 backdrop（点击即关）+ 菜单本体（backdrop 之后声明 = 更高层）。
    // 定位：右缘贴 ChannelBar 上报的条身右缘 ax（= 终端右边线，随条宽自适应），
    // y 压条身底 4px。菜单里只列**被收起**的项（has-* = 平铺可见态，取反）。
    if root.chbar-menu-open : Rectangle {
        width: 100%; height: 100%;
        TouchArea {
            clicked => { root.chbar-menu-open = false; }
        }
    }
    if root.chbar-menu-open : Rectangle {
        property <int> menu-n: (root.chbar-menu.has-pause ? 0 : 1)
            + (root.chbar-menu.has-leave ? 0 : 1)
            + (root.chbar-menu.has-close ? 0 : 1)
            + (root.chbar-menu.has-hide ? 0 : 1);
        property <bool> menu-sep: !root.chbar-menu.has-pause;
        x: root.chbar-menu.ax - self.width;
        y: root.chbar-menu.ay + 4px;
        // (#chbar-menu-w 2026-10-11) 宽度自适应：原 150px 固定宽对 11px 字太空。
        // 测量最长项文案（暂停/继续参与频道）+ 左右内距 20 + 边框余量 4。
        cm-m := Text {
            visible: false;
            font-size: 11px;
            text: root.chbar-menu.paused
                ? (root.lang-en ? "Resume channel" : "继续参与频道")
                : (root.lang-en ? "Pause channel" : "暂停参与频道");
        }
        width: max(cm-m.preferred-width + 24px, 96px);
        // 稿 .mpop：padding 4px、行高 26px、间距 1px、分隔线 1px + 上下 3px
        height: 8px + self.menu-n * 26px + (self.menu-sep ? 7px : 0px)
                + (self.menu-n + (self.menu-sep ? 1 : 0) >= 2
                    ? (self.menu-n + (self.menu-sep ? 1 : 0) - 1) * 1px : 0px);
        background: Theme.popup-bg;
        border-radius: 7px;
        border-width: 1px; border-color: Theme.border-strong;
        drop-shadow-blur: 12px; drop-shadow-color: #00000060;
        VerticalLayout {
            padding: 4px;
            spacing: 1px;
            // 暂停 = 主操作：稿 .mi.pri —— 强调色文字 + accent-soft 悬停
            if !root.chbar-menu.has-pause : Rectangle {
                height: 26px;
                background: cmi-pause-ta.has-hover ? Theme.accent-soft : transparent;
                border-radius: 5px;
                Text {
                    x: 10px;
                    text: root.chbar-menu.paused
                        ? (root.lang-en ? "Resume channel" : "继续参与频道")
                        : (root.lang-en ? "Pause channel" : "暂停参与频道");
                    color: Theme.accent; font-size: 11px; font-weight: 600;
                    vertical-alignment: center;
                }
                cmi-pause-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.chbar-menu-open = false;
                        root.tab-pause-channel(root.chbar-menu.tab-id);
                    }
                }
            }
            if !root.chbar-menu.has-pause : Rectangle {
                height: 7px;
                Rectangle {
                    x: 6px; y: 3px;
                    width: parent.width - 12px; height: 1px;
                    background: Theme.border-subtle;
                }
            }
            if !root.chbar-menu.has-leave : Rectangle {
                height: 26px;
                // (#chbar-menu-hover 2026-10-11) 普通项悬浮底用**中性蒙版**：
                // bg-panel-strong 与 popup-bg 同族几乎无差（用户实测"移过去像
                // 没移过去"）；中性蒙版深浅主题都一眼可辨。
                background: cmi-leave-ta.has-hover
                    ? (Theme.dark ? #ffffff.with-alpha(0.08) : #000000.with-alpha(0.06))
                    : transparent;
                border-radius: 5px;
                Text {
                    x: 10px;
                    text: root.lang-en ? "Leave channel" : "离开频道";
                    color: Theme.text-secondary; font-size: 11px;
                    vertical-alignment: center;
                }
                cmi-leave-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.chbar-menu-open = false;
                        root.tab-leave-channel(root.chbar-menu.tab-id);
                    }
                }
            }
            if !root.chbar-menu.has-close : Rectangle {
                height: 26px;
                background: cmi-close-ta.has-hover ? Theme.danger-strong.with-alpha(0.22) : transparent;
                border-radius: 5px;
                Text {
                    x: 10px;
                    text: root.lang-en ? "Close channel" : "关闭频道";
                    color: Theme.danger-strong; font-size: 11px;
                    vertical-alignment: center;
                }
                cmi-close-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.chbar-menu-open = false;
                        root.pane-close-channel(root.chbar-menu.slot);
                    }
                }
            }
            if !root.chbar-menu.has-hide : Rectangle {
                height: 26px;
                background: cmi-hide-ta.has-hover
                    ? (Theme.dark ? #ffffff.with-alpha(0.08) : #000000.with-alpha(0.06))
                    : transparent;
                border-radius: 5px;
                Text {
                    x: 10px;
                    text: root.lang-en ? "Hide status bar" : "隐藏状态条";
                    color: Theme.text-secondary; font-size: 11px;
                    vertical-alignment: center;
                }
                cmi-hide-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.chbar-menu-open = false;
                        root.tab-hide-channel-bar(root.chbar-menu.tab-id);
                    }
                }
            }
        }
    }
    // Frameless resize edges (#119): thin hit-zones.
    // (#self-drawn-resize 2026-09-20) 不再启动 OS 模态 resize(拖动中 Slint
    // 不重绘,空白到松手);改为 begin 记方向+按下点、moved 逐帧上报指针的
    // 窗口内坐标,由 Rust 逐帧 set_position/set_size。Hidden when maximized.
    if root.custom-titlebar && !root.window-maximized : Rectangle {
        width: 100%;
        height: 100%;
        TouchArea {  // top (N)
            x: 8px; y: 0; width: parent.width - 16px; height: 5px;
            mouse-cursor: ns-resize;
            pointer-event(e) => {
                if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                    root.win-resize-begin(0,
                        self.absolute-position.x + self.mouse-x,
                        self.absolute-position.y + self.mouse-y);
                }
            }
            moved => {
                root.win-resize-move(self.absolute-position.x + self.mouse-x,
                                     self.absolute-position.y + self.mouse-y);
            }
        }
        TouchArea {  // bottom (S)
            x: 8px; y: parent.height - 5px; width: parent.width - 16px; height: 5px;
            mouse-cursor: ns-resize;
            pointer-event(e) => {
                if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                    root.win-resize-begin(1,
                        self.absolute-position.x + self.mouse-x,
                        self.absolute-position.y + self.mouse-y);
                }
            }
            moved => {
                root.win-resize-move(self.absolute-position.x + self.mouse-x,
                                     self.absolute-position.y + self.mouse-y);
            }
        }
        TouchArea {  // left (W)
            x: 0; y: 8px; width: 5px; height: parent.height - 16px;
            mouse-cursor: ew-resize;
            pointer-event(e) => {
                if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                    root.win-resize-begin(3,
                        self.absolute-position.x + self.mouse-x,
                        self.absolute-position.y + self.mouse-y);
                }
            }
            moved => {
                root.win-resize-move(self.absolute-position.x + self.mouse-x,
                                     self.absolute-position.y + self.mouse-y);
            }
        }
        TouchArea {  // right (E)
            x: parent.width - 5px; y: 8px; width: 5px; height: parent.height - 16px;
            mouse-cursor: ew-resize;
            pointer-event(e) => {
                if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                    root.win-resize-begin(2,
                        self.absolute-position.x + self.mouse-x,
                        self.absolute-position.y + self.mouse-y);
                }
            }
            moved => {
                root.win-resize-move(self.absolute-position.x + self.mouse-x,
                                     self.absolute-position.y + self.mouse-y);
            }
        }
        TouchArea {  // top-left (NW)
            x: 0; y: 0; width: 8px; height: 8px;
            mouse-cursor: nwse-resize;
            pointer-event(e) => {
                if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                    root.win-resize-begin(5,
                        self.absolute-position.x + self.mouse-x,
                        self.absolute-position.y + self.mouse-y);
                }
            }
            moved => {
                root.win-resize-move(self.absolute-position.x + self.mouse-x,
                                     self.absolute-position.y + self.mouse-y);
            }
        }
        TouchArea {  // top-right (NE)
            x: parent.width - 8px; y: 0; width: 8px; height: 8px;
            mouse-cursor: nesw-resize;
            pointer-event(e) => {
                if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                    root.win-resize-begin(4,
                        self.absolute-position.x + self.mouse-x,
                        self.absolute-position.y + self.mouse-y);
                }
            }
            moved => {
                root.win-resize-move(self.absolute-position.x + self.mouse-x,
                                     self.absolute-position.y + self.mouse-y);
            }
        }
        TouchArea {  // bottom-left (SW)
            x: 0; y: parent.height - 8px; width: 8px; height: 8px;
            mouse-cursor: nesw-resize;
            pointer-event(e) => {
                if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                    root.win-resize-begin(7,
                        self.absolute-position.x + self.mouse-x,
                        self.absolute-position.y + self.mouse-y);
                }
            }
            moved => {
                root.win-resize-move(self.absolute-position.x + self.mouse-x,
                                     self.absolute-position.y + self.mouse-y);
            }
        }
        TouchArea {  // bottom-right (SE)
            x: parent.width - 8px; y: parent.height - 8px; width: 8px; height: 8px;
            mouse-cursor: nwse-resize;
            pointer-event(e) => {
                if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                    root.win-resize-begin(6,
                        self.absolute-position.x + self.mouse-x,
                        self.absolute-position.y + self.mouse-y);
                }
            }
            moved => {
                root.win-resize-move(self.absolute-position.x + self.mouse-x,
                                     self.absolute-position.y + self.mouse-y);
            }
        }
    }

    // --- Built-in file viewer / editor (#70) ------------------------------
    // View = read-only (selectable/copyable); Edit = writable, Ctrl+S or the
    // Save button uploads, and closing uploads any unsaved changes.
    // EditorWindow is the active top-level editor. Keep this legacy block
    // disabled while retaining the old properties for source compatibility.
    if false && root.editor-open : Rectangle {
        // Modal backdrop; clicking it does NOT close (avoids losing edits to a
        // stray click) — use the close button or Esc. Also swallow wheel events
        // so scrolling can't leak through to the terminal underneath (#70).
        background: #00000088;
        TouchArea {
            scroll-event(event) => { accept }
        }
        edit-fs := FocusScope {
            // Ctrl+S saves, Esc closes. These bubble up from the focused
            // TextInput because it doesn't consume them.
            key-pressed(e) => {
                // ⌘S on macOS, Ctrl+S elsewhere. (Slint maps `control` to Cmd on
                // macOS — see #158, so no platform branch is needed here.) On macOS
                // Cmd+letter arrives as the C0 control char (Cmd+S = "\u{13}"), not
                // "s" — confirmed on an M4 — so accept both forms (#158).
                if (e.modifiers.control && (e.text == "s" || e.text == "S" || e.text == "\u{0013}")) {
                    root.save-file();
                    return accept;
                }
                if (e.text == Key.Escape) {
                    root.close-editor();
                    return accept;
                }
                return reject;
            }
            Rectangle {
                x: root.ed-x;
                y: root.ed-y;
                width: root.ed-w;
                height: root.ed-h;
                background: Theme.popup-bg;
                border-radius: Theme.radius-md;
                border-width: 1px;
                border-color: Theme.border-strong;
                drop-shadow-blur: 24px;
                drop-shadow-color: #00000080;
                clip: true;

                VerticalLayout {
                    // Title bar — drag to move; the buttons stay on top.
                    Rectangle {
                        height: 40px;
                        background: Theme.popup-bg-alt;
                        ed-title-drag := TouchArea {
                            mouse-cursor: move;
                            pointer-event(e) => {
                                if (e.kind == PointerEventKind.down) {
                                    root.ed-dragging = true;
                                    root.ed-base-x = root.ed-x;
                                    root.ed-base-y = root.ed-y;
                                    root.ed-grab-x = self.absolute-position.x + self.mouse-x;
                                    root.ed-grab-y = self.absolute-position.y + self.mouse-y;
                                } else if (e.kind == PointerEventKind.up) {
                                    root.ed-dragging = false;
                                }
                            }
                            moved => {
                                if (root.ed-dragging) {
                                    root.ed-x = root.ed-base-x + (self.absolute-position.x + self.mouse-x - root.ed-grab-x);
                                    root.ed-y = root.ed-base-y + (self.absolute-position.y + self.mouse-y - root.ed-grab-y);
                                }
                            }
                        }
                        HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 8px;
                            // Centre the 28px buttons inside the 40px bar so the
                            // Save button isn't glued to the top edge (#70).
                            padding-top: 6px;
                            padding-bottom: 6px;
                            spacing: 8px;
                            Text {
                                text: root.editor-name
                                    + (root.editor-readonly
                                        ? "  ·  " + @tr("Read-only")
                                        : (root.editor-dirty ? "  ·  " + @tr("Modified") : ""));
                                color: Theme.text-primary;
                                font-size: Theme.fs-md;
                                font-weight: Theme.fw-strong;
                                font-family: Theme.ui-font-family;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                                overflow: elide;
                            }
                            if !root.editor-readonly : Rectangle {
                                width: 76px; height: 28px;
                                border-radius: Theme.radius-sm;
                                background: ed-save-ta.has-hover ? Theme.accent-hover : Theme.accent;
                                ed-save-ta := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.save-file(); }
                                }
                                Text { text: @tr("Save"); color: #ffffff; font-size: Theme.fs-sm;
                                       horizontal-alignment: center; vertical-alignment: center; }
                            }
                            Rectangle {
                                width: 28px; height: 28px;
                                border-radius: Theme.radius-sm;
                                background: ed-close-ta.has-hover ? Theme.bg-hover : transparent;
                                ed-close-ta := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.close-editor(); }
                                }
                                Icon {
    glyph: "close";
    tint: Theme.text-primary;
    size: Theme.fs-md;
}
                            }
                        }
                    }
                    Rectangle { height: 1px; background: Theme.border-subtle; }

                    // Lightweight find/replace bar (#287). Replacement is
                    // explicit; closing the editor never writes the file.
                    Rectangle {
                        height: 38px;
                        background: Theme.popup-bg;
                        HorizontalLayout {
                            padding-left: 8px; padding-right: 8px;
                            padding-top: 5px; padding-bottom: 5px; spacing: 6px;
                            Text { text: @tr("Find"); color: Theme.text-muted; vertical-alignment: center; }
                            TextInput {
                                horizontal-stretch: 1;
                                single-line: true;
                                vertical-alignment: center;
                                font-family: Theme.ui-font-family;
                                font-size: Theme.fs-md;
                                color: Theme.text-primary;
                                text <=> root.editor-find-query;
                                edited => {
                                    root.editor-find-position = -1;
                                    root.editor-match-count = root.editor-count-matches(
                                        root.editor-content, root.editor-find-query);
                                }
                            }
                            Text {
                                width: 42px;
                                text: root.editor-find-query == "" ? "" : root.editor-match-count;
                                color: Theme.text-muted;
                                vertical-alignment: center;
                                horizontal-alignment: center;
                            }
                            Rectangle {
                                width: 28px;
                                border-radius: Theme.radius-sm;
                                background: find-prev-ta.has-hover ? Theme.bg-hover : Theme.bg-elevated;
                                find-prev-ta := TouchArea {
                                    enabled: root.editor-match-count > 0;
                                    clicked => {
                                        let found = root.editor-find-step(root.editor-content,
                                            root.editor-find-query, root.editor-find-position, true);
                                        root.editor-find-position = found.start;
                                        root.editor-match-count = found.count;
                                        edit-input.set-selection-offsets(found.start, found.end);
                                        edit-input.focus();
                                    }
                                }
                                Icon { glyph: "arrow-up"; tint: Theme.text-primary; size: Theme.fs-md; }
                            }
                            Rectangle {
                                width: 28px;
                                border-radius: Theme.radius-sm;
                                background: find-next-ta.has-hover ? Theme.bg-hover : Theme.bg-elevated;
                                find-next-ta := TouchArea {
                                    enabled: root.editor-match-count > 0;
                                    clicked => {
                                        let found = root.editor-find-step(root.editor-content,
                                            root.editor-find-query, root.editor-find-position, false);
                                        root.editor-find-position = found.start;
                                        root.editor-match-count = found.count;
                                        edit-input.set-selection-offsets(found.start, found.end);
                                        edit-input.focus();
                                    }
                                }
                                Icon { glyph: "arrow-down"; tint: Theme.text-primary; size: Theme.fs-md; }
                            }
                            Text { text: @tr("Replace"); color: Theme.text-muted; vertical-alignment: center; }
                            TextInput {
                                horizontal-stretch: 1;
                                single-line: true;
                                vertical-alignment: center;
                                font-family: Theme.ui-font-family;
                                font-size: Theme.fs-md;
                                color: Theme.text-primary;
                                text <=> root.editor-replace-text;
                            }
                            Rectangle {
                                width: 88px;
                                border-radius: Theme.radius-sm;
                                background: replace-all-ta.has-hover ? Theme.bg-hover : Theme.bg-elevated;
                                replace-all-ta := TouchArea {
                                    enabled: !root.editor-readonly && root.editor-find-query != "";
                                    clicked => {
                                        root.editor-replace-all(root.editor-find-query, root.editor-replace-text);
                                    }
                                }
                                Text {
                                    text: @tr("Replace all");
                                    color: replace-all-ta.enabled ? Theme.text-primary : Theme.text-muted;
                                    font-size: Theme.fs-sm;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                    Rectangle { height: 1px; background: Theme.border-subtle; }

                    // Text area: a line-number gutter on the left + the editor.
                    // Wrap long lines to the visible editor width so text and
                    // selection painting cannot overflow to the right (#387).
                    // The gutter stays pinned and follows vertical scrolling.
                    Rectangle {
                        vertical-stretch: 1;
                        background: Theme.bg-root;
                        HorizontalLayout {
                            spacing: 0;
                            Rectangle {
                                width: 48px;
                                background: Theme.bg-panel-alt;
                                clip: true;
                                VerticalLayout {
                                    y: ed-scroll.content-y + 8px;
                                    width: parent.width;
                                    height: self.preferred-height;
                                    spacing: 0px;
                                    padding: 0px;
                                    for line[index] in root.editor-lines: Rectangle {
                                        height: line-measure.preferred-height;
                                        // Use TextInput for identical font fallback,
                                        // wrapping and empty-line metrics. The clipped
                                        // measurement sits outside the visible gutter.
                                        line-measure := TextInput {
                                            x: parent.width;
                                            width: edit-input.width;
                                            height: self.preferred-height;
                                            text: line;
                                            read-only: true;
                                            single-line: false;
                                            wrap: char-wrap;
                                            font-family: edit-input.font-family;
                                            font-size: edit-input.font-size;
                                        }
                                        Text {
                                            width: parent.width - 6px;
                                            height: line-measure.preferred-height;
                                            text: "\{index + 1}";
                                            horizontal-alignment: right;
                                            vertical-alignment: top;
                                            font-family: edit-input.font-family;
                                            font-size: edit-input.font-size;
                                            color: Theme.text-muted;
                                        }
                                    }
                                }
                            }
                            Rectangle { width: 1px; background: Theme.border-subtle; }
                            editor-viewport := Rectangle {
                                horizontal-stretch: 1;
                                clip: true;
                                // TextInput owns the pointer grab while selecting
                                // and ignores wheel events. Catch the rejected
                                // wheel behind it and scroll the editor (#388).
                                editor-wheel := TouchArea {
                                    scroll-event(event) => {
                                        ed-scroll.content-y = clamp(
                                            ed-scroll.content-y + event.delta-y,
                                            min(0px, ed-scroll.visible-height - ed-scroll.content-height),
                                            0px);
                                        accept
                                    }
                                }
                                ed-scroll := ScrollView {
                                    content-width: self.visible-width;
                                    content-height: max(self.visible-height, edit-input.preferred-height + 16px);
                                    edit-input := TextInput {
                                        x: 8px;
                                        y: 8px;
                                        width: max(1px, ed-scroll.visible-width - 16px);
                                        height: max(ed-scroll.visible-height - 16px, self.preferred-height);
                                        text <=> root.editor-content;
                                        read-only: root.editor-readonly;
                                        single-line: false;
                                        wrap: char-wrap;
                                        color: Theme.text-primary;
                                        font-family: Theme.ui-font-family;
                                        font-size: Theme.fs-md;
                                        page-height: ed-scroll.visible-height;
                                        cursor-position-changed(position) => {
                                            // Keep a keyboard/drag selection endpoint
                                            // visible. During a pointer grab this also
                                            // advances the viewport as the mouse moves
                                            // beyond its top or bottom edge (#388).
                                            let cursor-y = position.y + self.y + ed-scroll.content-y;
                                            if (cursor-y < 12px) {
                                                ed-scroll.content-y = min(0px,
                                                    ed-scroll.content-y + 12px - cursor-y);
                                            } else if (cursor-y > ed-scroll.visible-height - 12px) {
                                                ed-scroll.content-y = max(
                                                    min(0px, ed-scroll.visible-height - ed-scroll.content-height),
                                                    ed-scroll.content-y
                                                        - (cursor-y - ed-scroll.visible-height + 12px));
                                            }
                                        }
                                        edited => {
                                            root.editor-dirty = true;
                                            root.editor-recount(root.editor-content);
                                            root.editor-match-count = root.editor-count-matches(
                                                root.editor-content, root.editor-find-query);
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // Bottom-right resize grip (#70).
                Rectangle {
                    x: parent.width - 18px;
                    y: parent.height - 18px;
                    width: 18px;
                    height: 18px;
                    ed-resize-ta := TouchArea {
                        mouse-cursor: nwse-resize;
                        pointer-event(e) => {
                            if (e.kind == PointerEventKind.down) {
                                root.ed-resizing = true;
                                root.ed-base-w = root.ed-w;
                                root.ed-base-h = root.ed-h;
                                root.ed-grab-x = self.absolute-position.x + self.mouse-x;
                                root.ed-grab-y = self.absolute-position.y + self.mouse-y;
                            } else if (e.kind == PointerEventKind.up) {
                                root.ed-resizing = false;
                            }
                        }
                        moved => {
                            if (root.ed-resizing) {
                                root.ed-w = max(420px, root.ed-base-w + (self.absolute-position.x + self.mouse-x - root.ed-grab-x));
                                root.ed-h = max(280px, root.ed-base-h + (self.absolute-position.y + self.mouse-y - root.ed-grab-y));
                            }
                        }
                    }
                    // (#grip-icon-3dots) 原为字体字符 "◢" —— 8 处右下角柄里漏掉统一的两处
                    // 之一。改用与另 6 处同款的 3 点；盒宽 18px(另 6 处 16px)不影响落点，
                    // 因点位按右下角偏移计算。悬停提亮沿用原绑定。
                    Icon { glyph: "resize-se"; tint: ed-resize-ta.has-hover ? Theme.text-secondary : Theme.text-muted; size: 18px; }   // (#icon-svg-migration) 单一事实源 = assets/icons/resize-se.svg
                }
            }
            // Defer focus until the next UI turn. Focusing directly from init
            // re-enters Slint's Windows accessibility adapter and can panic
            // with "RefCell already borrowed" (#386).
            init => { root.editor-focus-pending = true; }
            editor-focus-timer := Timer {
                interval: 0ms;
                running: root.editor-focus-pending;
                triggered => {
                    root.editor-focus-pending = false;
                    edit-input.focus();
                }
            }
        }
    }

    // --- Download manager popup -------------------------------------------
    // Click-outside-to-close: a full-window transparent sensor sitting *under*
    // the popup. Clicking anywhere outside the popup hits this and closes it;
    // clicks inside the popup are caught by the popup's own TouchArea first.
    if root.download-open : TouchArea {
        width: parent.width;
        height: parent.height;
        clicked => { root.download-open = false; }
    }
    // Always present; toggled via `visible` (avoids destroying interactive
    // elements mid-event, which crashes when created/removed at the Window root).
    Rectangle {
        // (#topbar-click-anchor 2026-09-08) 跟随鼠标点击点右下角展开:
        // 左上角贴点击点,x 钳制防溢出窗口右缘(按钮靠右时自动贴右),
        // y 钳制防溢出窗口底。两种标题栏形态统一此规则。
        x: max(8px, min(root.topbar-click-x, parent.width - self.width - 12px));
        y: min(root.topbar-click-y, parent.height - self.height - 12px);
        width: root.dl-w;
        height: root.dl-h;
        visible: root.download-open;
        background: Theme.popup-bg;
        border-radius: Theme.radius-md;
        border-width: 1px;
        border-color: Theme.border-strong;
        drop-shadow-blur: 16px;
        drop-shadow-color: #00000070;

        // Swallow pointer events so right-clicks don't fall through to the
        // terminal's context menu underneath.
        TouchArea {}

        VerticalLayout {
            padding: 14px;
            spacing: 10px;

            HorizontalLayout {
                Text {
                    text: @tr("Transfers manager");
                    color: Theme.text-primary;
                    font-size: Theme.fs-md;
                    font-weight: Theme.fw-strong;
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                }
                Rectangle {
                    width: 20px; height: 20px;
                    border-radius: Theme.radius-sm;
                    // Match ProcWindow's close button: red (#e81123) on hover,
                    // white glyph, smooth 90ms transition (#close-hover-red).
                    background: close-ta.has-hover ? #e81123 : transparent;
                    animate background { duration: 90ms; }
                    close-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.download-open = false; }
                    }
                    Icon {
    glyph: "close";
    tint: Theme.text-primary;
    size: Theme.fs-md;
}
                }
            }

                Text {
                    text: @tr("Save downloads to:");
                    // (#dialog-label-sync 2026-10-15) 字段标签对齐设置面板:常态 = 前景色
                    color: Theme.text-primary;
                    font-size: Theme.fs-sm;
                }

                // Current path display
                Rectangle {
                    height: 26px;
                    background: Theme.bg-root;
                    border-radius: Theme.radius-sm;
                    Text {
                        x: 8px;
                        width: parent.width - 16px;
                        height: parent.height;
                        text: root.download-dir == "" ? @tr("(ask every time)") : root.download-dir;
                        color: root.download-dir == "" ? Theme.text-muted : Theme.text-primary;
                        font-size: Theme.fs-sm;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;

                    Rectangle {
                        width: 110px; height: 28px;
                        border-radius: Theme.radius-sm;
                        background: pick-ta.has-hover ? Theme.accent-hover : Theme.accent;
                        pick-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.pick-download-dir(); }
                        }
                        Text { text: @tr("Choose save path"); color: #ffffff; font-size: Theme.fs-sm;
                               horizontal-alignment: center; vertical-alignment: center; }
                    }
                    Rectangle {
                        width: 76px; height: 28px;
                        border-radius: Theme.radius-sm;
                        background: open-ta.has-hover ? Theme.bg-hover : Theme.bg-elevated;
                        open-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.open-download-dir(); }
                        }
                        Text { text: @tr("Open folder"); color: Theme.text-primary; font-size: Theme.fs-sm;
                               horizontal-alignment: center; vertical-alignment: center; }
                    }
                }

                Rectangle { height: 1px; background: Theme.border-subtle; }

                // Transfer records (download/upload progress + history).
                HorizontalLayout {
                    Text {
                        text: @tr("Transfers");
                        color: Theme.text-secondary;
                        font-size: Theme.fs-sm;
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                    }
                    Rectangle {
                        width: 44px; height: 20px;
                        border-radius: Theme.radius-sm;
                        background: clr-ta.has-hover ? Theme.bg-hover : transparent;
                        clr-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.clear-transfers(); }
                        }
                        Text { text: @tr("Clear"); color: Theme.text-muted; font-size: Theme.fs-xs;
                               horizontal-alignment: center; vertical-alignment: center; }
                    }
                }

                Flickable {
                    vertical-stretch: 1;
                    content-width: self.width;
                    content-height: max(self.height, xfer-col.preferred-height);
                    xfer-col := VerticalLayout {
                        alignment: start;
                        spacing: 4px;

                        if root.transfers.length == 0 : Text {
                            text: @tr("No transfers yet");
                            color: Theme.text-muted;
                            font-size: Theme.fs-xs;
                        }

                        for t in root.transfers : Rectangle {
                            height: 36px;
                            border-radius: Theme.radius-sm;
                            background: Theme.bg-root;
                            VerticalLayout {
                                padding-left: 8px; padding-right: 8px;
                                padding-top: 4px; padding-bottom: 4px;
                                spacing: 3px;
                                HorizontalLayout {
                                    spacing: 4px;
                                    Icon {
    glyph: t.is-upload ? "arrow-up" : "arrow-down";
    tint: t.is-upload ? #639922 : #7c3aed;
    size: Theme.fs-md;
} // up / down arrow
                                    Text {
                                        text: t.name;
                                        color: Theme.text-primary;
                                        font-size: Theme.fs-xs;
                                        horizontal-stretch: 1;
                                        overflow: elide;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        text: t.detail;
                                        color: t.state == 2 ? Theme.danger
                                             : t.state == 1 ? Theme.success
                                             : Theme.text-muted;
                                        font-size: Theme.fs-xs;
                                        vertical-alignment: center;
                                    }
                                    // Cancel button — only while the transfer is
                                    // active (0) or preparing (3) (#100).
                                    if t.state == 0 || t.state == 3 : Rectangle {
                                        width: 16px; height: 16px;
                                        border-radius: Theme.radius-sm;
                                        background: cancel-ta.has-hover ? Theme.danger.with-alpha(0.18) : transparent;
                                        cancel-ta := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { root.cancel-transfer(t.id); }
                                        }
                                        Icon {
    glyph: "close";
    tint: Theme.text-primary;
    size: Theme.fs-md;
} // close
                                    }
                                }
                                // progress bar
                                Rectangle {
                                    height: 4px;
                                    border-radius: 2px;
                                    background: Theme.bg-elevated;
                                    Rectangle {
                                        x: 0; y: 0; height: parent.height;
                                        width: parent.width * clamp(t.percent, 0.0, 1.0);
                                        border-radius: 2px;
                                        background: t.state == 2 ? Theme.danger
                                                  : t.state == 1 ? Theme.success
                                                  : Theme.accent;
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        // --- Bottom-right resize grip (#dl-resize) -------------------------
        // Mirrors the interface dialog's grip: same Material "open_in_full"
        // glyph + nwse-resize cursor, pure-Slint drag-resize (the popup is an
        // embedded Rectangle, so OS drag_resize_window can't be used here).
        Rectangle {
            // #dl-resize: bottom-right resize grip — switched from
            // "open_in_full" glyph to the 3-dot diagonal pattern used by
            // ProcWindow (#grip-icon-3dots) so all three affordances share
            // one visual. Background stays transparent even on hover so the
            // hover state never paints a 16x16 grey block (which read as a
            // "shadow"). Hover feedback is given by the 3 dots shifting to
            // text-secondary below.
            x: parent.width - 16px;
            y: parent.height - 16px;
            width: 16px;
            height: 16px;
            background: transparent;
            Icon { glyph: "resize-se"; tint: Theme.text-muted; size: 16px; }   // (#icon-svg-migration) 单一事实源 = assets/icons/resize-se.svg
            dl-resize-ta := TouchArea {
                mouse-cursor: nwse-resize;
                pointer-event(e) => {
                    if (e.kind == PointerEventKind.down) {
                        root.dl-resizing = true;
                        root.dl-base-w = root.dl-w;
                        root.dl-base-h = root.dl-h;
                        root.dl-grab-x = self.absolute-position.x + self.mouse-x;
                        root.dl-grab-y = self.absolute-position.y + self.mouse-y;
                    } else if (e.kind == PointerEventKind.up) {
                        root.dl-resizing = false;
                    }
                }
                moved => {
                    if (root.dl-resizing) {
                        root.dl-w = clamp(
                            round((root.dl-base-w + (self.absolute-position.x + self.mouse-x - root.dl-grab-x)) / 1px) * 1px,
                            300px, 900px);
                        root.dl-h = clamp(
                            round((root.dl-base-h + (self.absolute-position.y + self.mouse-y - root.dl-grab-y)) / 1px) * 1px,
                            320px, 900px);
                    }
                }
            }
        }

    // Process monitor is now ProcWindow (a detachable top-level window); the
    // former in-app overlay was removed in favour of a real OS window (#23).

    // --- Settings menu popup (top-right) ----------------------------------
    // Click-outside-to-close backdrop (same pattern as the download popup).
    // (#settings-menu-autoclose 2026-09-09) 指针移出菜单 → 自动关闭;锚点
    // 豁免:菜单从"更多"按钮弹出,指针初始停在按钮上(菜单外)——距点击点
    // 40px 内视为"仍在打开锚点"不算离开,防止手停在按钮上读菜单被误关。
    if root.settings-open : settings-bd := TouchArea {
        width: parent.width;
        height: parent.height;
        clicked => { root.settings-open = false; }
        // 指针是否在锚点(打开菜单的按钮矩形,四边外扩 4px 呼吸空间)内:
        // 在按钮上/贴近按钮 = 仍在打开它的位置,不算离开菜单。
        property <bool> ptr-outside-anchor:
            !(self.mouse-x >= root.topbar-anchor-x - 4px
                && self.mouse-x <= root.topbar-anchor-x + root.topbar-anchor-w + 4px
                && self.mouse-y >= root.topbar-anchor-y - 4px
                && self.mouse-y <= root.topbar-anchor-y + root.topbar-anchor-h + 4px);
        property <int> unsafe-ticks: 0;
        Timer {
            interval: 75ms;
            running: true;
            triggered => {
                if (settings-bd.has-hover && settings-bd.ptr-outside-anchor) {
                    settings-bd.unsafe-ticks = settings-bd.unsafe-ticks + 1;
                    if (settings-bd.unsafe-ticks >= 2) {
                        root.settings-open = false;
                    }
                } else {
                    settings-bd.unsafe-ticks = 0;
                }
            }
        }
    }
    settings-menu-rect := Rectangle {
        // (#topbar-click-anchor 2026-09-08) 跟随"更多"按钮的点击点右下角
        // 展开,钳制不出窗口(规则同下载弹层);替代旧 set-btn 右缘锚点。
        x: max(8px, min(root.topbar-click-x, parent.width - self.width - 12px));
        y: min(root.topbar-click-y, parent.height - self.height - 12px);
        width: 198px;
        // Size to the menu's content so adding/removing items (or the
        // ~/.ssh/config import hint expanding) never overflows the card (#150-fix).
        height: menu-vl.preferred-height;
        visible: root.settings-open;
        background: Theme.popup-bg;
        border-radius: Theme.radius-md;
        border-width: 1px;
        border-color: Theme.border-strong;
        drop-shadow-blur: 14px;
        drop-shadow-color: #00000060;

        TouchArea {}   // swallow events so they don't reach the terminal

        // (#settings-menu-autoclose) 垫底探测:指针在菜单内非菜单项区域时
        // 挡住 backdrop 的 hover(settings-bd.has-hover=false → 判定安全)。
        settings-pad := TouchArea { width: 100%; height: 100%; }
        // 菜单内任一处 hover(垫底 + 8 个菜单项),与 backdrop 露出互斥。
        property <bool> menu-any-hover:
            settings-pad.has-hover || iface-ta.has-hover || export-ta.has-hover
            || impconn-ta.has-hover || batchimp-ta.has-hover || import-ta.has-hover
            || lang-ta.has-hover || keys-ta.has-hover || about-ta.has-hover;
        menu-vl := VerticalLayout {
            padding: 4px;
            spacing: 1px;
            // Interface (font) settings.
            Rectangle {
                height: 28px;
                border-radius: Theme.radius-sm;
                background: iface-ta.has-hover ? Theme.bg-hover : transparent;
                iface-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.settings-open = false;
                        // (#ifd-page-reset 2026-10-15) 每次打开都回到默认页
                        // (主题)。此前弹框实例在会话内复用时停在上次点开的页,
                        // 重启后又回默认 —— 两种行为混着来最不可预期;统一为
                        // "固定入口 → 固定首页"(与主题速选 Tab 直达的既有重置
                        // :8040 同口径)。
                        root.ifd-page = "theme";
                        root.interface-open = true;
                    }
                }
                HorizontalLayout {
                    padding-left: 8px; spacing: 8px;
                    Icon {
    glyph: "settings";
    tint: Theme.text-primary;
    size: Theme.fs-md;
}
                    Text { text: root.lang-en ? "Settings" : "设置";
                           color: Theme.text-primary; font-size: Theme.fs-md;
                           vertical-alignment: center; horizontal-stretch: 1; }
                }
            }
            // Export all connections to a portable file (#46).
            Rectangle {
                height: 28px;
                border-radius: Theme.radius-sm;
                background: export-ta.has-hover ? Theme.bg-hover : transparent;
                export-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.settings-open = false;
                        root.export-sessions();
                    }
                }
                HorizontalLayout {
                    padding-left: 8px; spacing: 8px;
                    Icon {
    glyph: "arrow-up";
    tint: Theme.text-primary;
    size: Theme.fs-md;
} // ↑ export
                    Text { text: root.lang-en ? "Export connections" : "导出连接";
                           color: Theme.text-primary; font-size: Theme.fs-md;
                           vertical-alignment: center; horizontal-stretch: 1; }
                }
            }
            // Import connections from a portable file (#46).
            Rectangle {
                height: 28px;
                border-radius: Theme.radius-sm;
                background: impconn-ta.has-hover ? Theme.bg-hover : transparent;
                impconn-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.settings-open = false;
                        root.import-sessions();
                    }
                }
                HorizontalLayout {
                    padding-left: 8px; spacing: 8px;
                    Icon {
    glyph: "arrow-down";
    tint: Theme.text-primary;
    size: Theme.fs-md;
} // ↓ import
                    Text { text: root.lang-en ? "Import connections" : "导入连接";
                           color: Theme.text-primary; font-size: Theme.fs-md;
                           vertical-alignment: center; horizontal-stretch: 1; }
                }
            }
            // Batch-import connections from pasted text (#150).
            Rectangle {
                height: 28px;
                border-radius: Theme.radius-sm;
                background: batchimp-ta.has-hover ? Theme.bg-hover : transparent;
                batchimp-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.settings-open = false;
                        root.batch-import-text = "";
                        root.batch-import-open = true;
                    }
                }
                HorizontalLayout {
                    padding-left: 8px; spacing: 8px;
                    Icon {
    glyph: "table-rows";
    tint: Theme.text-primary;
    size: Theme.fs-md;
} // table/rows
                    Text { text: root.lang-en ? "Batch import (text)" : "批量导入(文本)";
                           color: Theme.text-primary; font-size: Theme.fs-md;
                           vertical-alignment: center; horizontal-stretch: 1; }
                }
            }
            // Import hosts from ~/.ssh/config. Keep the menu open so the result
            // (e.g. "imported 3" / "no new hosts") is visible right here — it used
            // to only show on the welcome page, so importing while a session was
            // open looked like nothing happened (#133).
            Rectangle {
                height: root.ssh-import-hint != "" ? 46px : 28px;
                border-radius: Theme.radius-sm;
                background: import-ta.has-hover ? Theme.bg-hover : transparent;
                import-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.import-ssh-config(); }
                }
                HorizontalLayout {
                    padding-left: 8px; padding-right: 8px; spacing: 8px;
                    Icon {
    glyph: "input";
    tint: Theme.text-primary;
    size: Theme.fs-md;
} // input/import
                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: center;
                        Text { text: @tr("Import ~/.ssh/config"); color: Theme.text-primary; font-size: Theme.fs-md;
                               vertical-alignment: center; }
                        if root.ssh-import-hint != "" : Text {
                            text: root.ssh-import-hint;
                            color: Theme.text-muted; font-size: Theme.fs-xs;
                            overflow: elide;
                        }
                    }
                }
            }
            // Language toggle: shows the language you'll switch TO.
            Rectangle {
                height: 28px;
                border-radius: Theme.radius-sm;
                background: lang-ta.has-hover ? Theme.bg-hover : transparent;
                lang-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.settings-open = false;
                        root.set-language(root.lang-en ? "zh" : "en");
                    }
                }
                HorizontalLayout {
                    padding-left: 8px; spacing: 8px;
                    Icon {
    glyph: "language";
    tint: Theme.text-primary;
    size: Theme.fs-md;
} // language/translate
                    Text { text: root.lang-en ? "切换到中文" : "Switch to English";
                           color: Theme.text-primary; font-size: Theme.fs-md;
                           vertical-alignment: center; horizontal-stretch: 1; }
                }
            }
            // Keyboard shortcuts reference (#103).
            Rectangle {
                height: 28px;
                border-radius: Theme.radius-sm;
                background: keys-ta.has-hover ? Theme.bg-hover : transparent;
                keys-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.settings-open = false;
                        root.shortcuts-open = true;
                    }
                }
                HorizontalLayout {
                    padding-left: 8px; spacing: 8px;
                    Icon {
    glyph: "keyboard";
    tint: Theme.text-primary;
    size: Theme.fs-md;
} // keyboard
                    Text { text: root.lang-en ? "Shortcuts" : "快捷键";
                           color: Theme.text-primary; font-size: Theme.fs-md;
                           vertical-alignment: center; horizontal-stretch: 1; }
                }
            }
            Rectangle {
                height: 28px;
                border-radius: Theme.radius-sm;
                background: about-ta.has-hover ? Theme.bg-hover : transparent;
                about-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.settings-open = false;
                        root.about-open = true;
                    }
                }
                HorizontalLayout {
                    padding-left: 8px; spacing: 8px;
                    Icon {
    glyph: "info";
    tint: Theme.text-primary;
    size: Theme.fs-md;
} // Info
                    Text { text: @tr("About"); color: Theme.text-primary; font-size: Theme.fs-md;
                           vertical-alignment: center; horizontal-stretch: 1; }
                }
            }
        }
    }

    // --- Group create / rename dialog (#41) -------------------------------
        if root.group-dialog-open : Rectangle {
        width: parent.width;
        height: parent.height;
        background: #00000080;
        TouchArea { clicked => { root.group-dialog-open = false; } }

        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            // (#group-dialog-preview 2026-09-15) 340 → 362px(高保真 v3)。
            width: 362px;
            // (#group-dialog-color 2026-09-14) 高度改为随内容自适应:对话框新增
            // 了「分组颜色」字段,固定 208px 会把色板挤出卡片外。
            height: gd-body.preferred-height;
            background: Theme.popup-bg;
            border-radius: Theme.radius-md;
            border-width: 1px;
            border-color: Theme.border-strong;
            drop-shadow-blur: 24px;
            drop-shadow-color: #000000a0;
            TouchArea {}   // swallow inside clicks

            gd-body := VerticalLayout {
                padding: 0px;
                spacing: 0px;
                // (#group-dialog-layout 2026-09-15) 对齐高保真 v3 的三段式:
                // 标题栏(独立 padding + 底部分隔) / 内容区 / 按钮栏。旧版把
                // 标题、字段、预览、按钮全塞进同一 18px padding + 12px spacing
                // 的 VL,区块节奏糊成一团。
                property <int> pv-active: 0;
                // —— 标题栏 ——
                VerticalLayout {
                    padding-left: 18px;
                    padding-right: 18px;
                    padding-top: 14px;
                    padding-bottom: 12px;
                    spacing: 0px;
                    Text {
                        text: root.group-dialog-orig == ""
                            ? (root.lang-en ? "New group" : "新建分组")
                            : (root.lang-en ? "Edit group" : "编辑分组");
                        color: Theme.text-primary;
                        font-size: Theme.fs-lg;
                        font-weight: Theme.fw-strong;
                    }
                }
                Rectangle { height: 1px; background: Theme.border-subtle; }
                // —— 内容区 ——
                VerticalLayout {
                    padding-left: 18px;
                    padding-right: 18px;
                    padding-top: 16px;
                    padding-bottom: 4px;
                    spacing: 6px;
                    Text {
                        text: @tr("Group name");
                        // (#dialog-label-sync 2026-10-15) 字段标签对齐设置面板:常态 = 前景色
                        color: Theme.text-primary;
                        font-size: Theme.fs-sm;
                        font-weight: Theme.fw-strong;
                    }
                    // (#hex-input-plain) 不用 std LineEdit:自带清叉在短栏里
                    // 像搜索框。名称输入同样改 TextInput,与会话对话框其它
                    // 字段同一视觉语言。
                    Rectangle {
                        height: 32px;
                        border-radius: Theme.radius-sm;
                        background: Theme.bg-root;
                        border-width: 1px;
                        border-color: ge-input.has-focus ? Theme.accent-solid : Theme.border-strong;
                        if root.group-dialog-name == "" && !ge-input.has-focus : Text {
                            x: 10px;
                            width: parent.width - 20px;
                            height: parent.height;
                            text: @tr("Group name");
                            color: Theme.text-muted;
                            font-family: Theme.ui-font-family;
                            font-size: Theme.fs-md;
                            vertical-alignment: center;
                        }
                        ge-input := TextInput {
                            x: 10px;
                            width: parent.width - 20px;
                            height: parent.height;
                            text <=> root.group-dialog-name;
                            font-family: Theme.ui-font-family;
                            font-size: Theme.fs-md;
                            color: Theme.text-primary;
                            vertical-alignment: center;
                            single-line: true;
                            edited => { root.group-dialog-error = ""; }
                            accepted => {
                                if (root.group-dialog-name != "") {
                                    root.group-dialog-error = root.submit-group(
                                        root.group-dialog-orig,
                                        root.group-dialog-name,
                                        root.group-dialog-color-hex,
                                    );
                                    if (root.group-dialog-error == "") {
                                        root.group-dialog-open = false;
                                    }
                                }
                            }
                        }
                    }
                    if root.group-dialog-error != "" : Text {
                        text: root.group-dialog-error;
                        color: Theme.danger;
                        font-size: Theme.fs-xs;
                    }
                    Rectangle { height: 8px; }
                    Text {
                        text: @tr("Group color");
                        // (#dialog-label-sync 2026-10-15) 字段标签对齐设置面板:常态 = 前景色
                        color: Theme.text-primary;
                        font-size: Theme.fs-sm;
                        font-weight: Theme.fw-strong;
                    }
                    GroupColorField {
                        show-header: false;
                        // (#ui-refresh-v3-6) 362px 对话框内容宽 326px,6 列 49px 格
                        // (6×49 + 5×6 = 324)铺满色板区,对齐设计稿 grid6 满宽。
                        cell-size: 49px;
                        hex <=> root.group-dialog-color-hex;
                        value: root.group-dialog-color;
                        palette: root.group-palette;
                        picked(hex) => {
                            root.group-dialog-color-hex = hex;
                            root.group-dialog-color = root.resolve-color(hex);
                        }
                    }
                    Rectangle { height: 8px; }
                // (#group-dialog-preview 2026-09-15) 可交互实时预览:所见即「确定」
                // 后的效果。上半 = 页签条(点击切换活动态),下半 = 列表组头(点击
                // 折叠/展开,编辑态展开该组现有成员,超高滚动)。颜色全部读草稿
                // group-dialog-color,「无颜色」回落次级前景灰 —— 与列表实际
                // 渲染同一条 group-color() 规则。
                Rectangle {
                    border-radius: Theme.radius-md;
                    border-width: 1px;
                    border-color: Theme.border-subtle;
                    clip: true;
                    VerticalLayout {
                    spacing: 0px;
                    // (#group-dialog-preview 2026-09-15) 预览标题行(高保真 v3)。
                    Rectangle {
                        height: 22px;
                        background: Theme.bg-panel-alt;
                        Text {
                            x: 10px;
                            height: parent.height;
                            text: root.lang-en
                                ? "Live preview · click tabs to switch"
                                : "实时预览 · 页签可点击切换";
                            color: Theme.text-muted;
                            font-size: Theme.fs-xs;
                            vertical-alignment: center;
                        }
                    }
                    // 页签条 mock(4px 顶留白 + 36px 页签 + 底部方角贴"终端")
                    Rectangle {
                        height: 40px;
                        background: Theme.tab-bar-bg;
                        HorizontalLayout {
                            padding-top: 4px;
                            padding-left: 3px;
                            spacing: 3px;
                            property <color> pc: root.group-dialog-color-hex != ""
                                ? root.group-dialog-color : Theme.text-secondary;
                            // 页签 0
                            Rectangle {
                                width: 92px;
                                background: gd-body.pv-active == 0 ? Theme.tab-active-bg : Theme.bg-elevated;
                                border-radius: Theme.radius-md;
                                border-bottom-left-radius: 0px;
                                border-bottom-right-radius: 0px;
                                if root.group-dialog-color-hex != "" : Rectangle {
                                    x: 4px;
                                    y: 7px;
                                    width: 3px;
                                    height: parent.height - 14px;
                                    border-radius: 2px;
                                    background: pc;
                                    opacity: gd-body.pv-active == 0 ? 1.0 : 0.55;
                                }
                                Text {
                                    x: 13px;
                                    width: parent.width - 34px;
                                    text: @tr("New tab");
                                    color: gd-body.pv-active == 0 ? Theme.text-primary : Theme.text-secondary;
                                    font-size: Theme.fs-sm;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                                // (#group-dialog-preview) 活动页签显示关闭键(视觉,
                                // 与真实页签一致)。
                                // (#icon-svg-migration) 显式 width:这处的父是整条
                                // 页签预览(非图标槽),Icon 默认铺满父容器 —— 配上
                                // x: parent.width - 20px 会一路溢出到右侧。原 Text
                                // 自己带 16px 宽,这里按原值保留。
                                if gd-body.pv-active == 0 : Icon {
                                    x: parent.width - 20px;
                                    width: 16px;
                                    glyph: "close";
                                    tint: Theme.text-muted;
                                    size: Theme.fs-sm;
                                }
                                pv-t0 := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { gd-body.pv-active = 0; }
                                }
                            }
                            // 页签 1
                            Rectangle {
                                width: 100px;
                                background: gd-body.pv-active == 1 ? Theme.tab-active-bg : Theme.bg-elevated;
                                border-radius: Theme.radius-md;
                                border-bottom-left-radius: 0px;
                                border-bottom-right-radius: 0px;
                                if root.group-dialog-color-hex != "" : Rectangle {
                                    x: 4px;
                                    y: 7px;
                                    width: 3px;
                                    height: parent.height - 14px;
                                    border-radius: 2px;
                                    background: pc;
                                    opacity: gd-body.pv-active == 1 ? 1.0 : 0.55;
                                }
                                Text {
                                    x: 13px;
                                    width: parent.width - 24px;
                                    text: @tr("Other tab");
                                    color: gd-body.pv-active == 1 ? Theme.text-primary : Theme.text-secondary;
                                    font-size: Theme.fs-sm;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                                pv-t1 := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { gd-body.pv-active = 1; }
                                }
                            }
                        }
                    }
                    Rectangle {
                        height: 1px;
                        background: Theme.border-subtle;
                    }
                    // (#group-dialog-preview-static 2026-09-15) 组头预览 = **静态
                    // 折叠态**,照搬左侧会话列表组头(chevron ▸ + 闭合文件夹 +
                    // 组名 + 计数徽章),不可点击折叠。成员列表一并去掉。
                    Rectangle {
                        height: 32px;
                        background: Theme.bg-panel;
                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            spacing: 4px;
                            property <color> pc: root.group-dialog-color-hex != ""
                                ? root.group-dialog-color : Theme.text-secondary;
                            // 折叠三角 ▸,与左侧组头折叠态同字形、同字号。
                            Icon {
    glyph: "chevron-right";
    tint: pc;
    size: Theme.fs-xl;
}
                            // 闭合文件夹,与左侧折叠组头同口径。
                            Icon {
    glyph: "folder";
    tint: pc;
    size: Theme.fs-xl;
}
                            Text {
                                text: root.group-dialog-name == ""
                                    ? @tr("Group name")
                                    : root.group-dialog-name;
                                // (#dialog-label-sync 2026-10-15) 组名预览:有名 = 前景色(与字段
                                // 标签同档);空 = 弱化档占位(原先单一描述灰,两态不分)。
                                color: root.group-dialog-name == "" ? Theme.text-muted : Theme.text-primary;
                                font-size: Theme.fs-md;
                                font-weight: Theme.fw-strong;
                                vertical-alignment: center;
                                overflow: elide;
                                horizontal-stretch: 1;
                                horizontal-alignment: left;
                            }
                            VerticalLayout {
                                alignment: center;
                                Rectangle {
                                    height: 16px;
                                    width: pv-num.preferred-width + 12px;
                                    border-radius: 8px;
                                    background: Theme.bg-elevated;
                                    pv-num := Text {
                                        x: 6px;
                                        height: parent.height;
                                        text: "0";
                                        color: Theme.text-secondary;
                                        font-size: Theme.fs-xs;
                                        vertical-alignment: center;
                                    }
                                    // 编辑态:组头行(group-header == 组名)带真实
                                    // group-size,叠在 "0" 上盖住;新建组无匹配行,
                                    // 底下的 0 就是正确值。
                                    for s in root.sessions : Text {
                                        visible: root.group-dialog-orig != ""
                                            && s.group-header == root.group-dialog-orig;
                                        x: 6px;
                                        height: parent.height;
                                        text: "\{s.group-size}";
                                        color: Theme.text-secondary;
                                        font-size: Theme.fs-xs;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }
                    }
                    }
                }
                // —— 按钮栏 ——
                HorizontalLayout {
                    padding-left: 18px;
                    padding-right: 18px;
                    padding-top: 12px;
                    padding-bottom: 16px;
                    alignment: end;
                    spacing: 8px;
                    Button {
                        text: root.lang-en ? "Cancel" : "取消";
                        clicked => { root.group-dialog-open = false; }
                    }
                    Button {
                        text: root.lang-en ? "OK" : "确定";
                        primary: true;
                        enabled: root.group-dialog-name != "";
                        clicked => {
                            root.group-dialog-error = root.submit-group(
                                root.group-dialog-orig,
                                root.group-dialog-name,
                                root.group-dialog-color-hex,
                            );
                            if (root.group-dialog-error == "") {
                                root.group-dialog-open = false;
                            }
                        }
                    }
                }
            }
        }
    }

    // --- Rename-session dialog ----------------------------------------------
    // Tab context menu → Rename: a display-name override for one open session.
    // Submitting an empty name restores the saved session name.
    if root.tab-rename-open : Rectangle {
        width: parent.width;
        height: parent.height;
        background: #00000080;
        TouchArea { clicked => { root.tab-rename-open = false; } }

        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 340px;
            height: 196px;
            background: Theme.popup-bg;
            border-radius: Theme.radius-md;
            border-width: 1px;
            border-color: Theme.border-strong;
            drop-shadow-blur: 24px;
            drop-shadow-color: #000000a0;
            TouchArea {}   // swallow inside clicks

            VerticalLayout {
                padding: 18px;
                spacing: 12px;
                Text {
                    text: root.lang-en ? "Rename session" : "重命名会话";
                    color: Theme.text-primary;
                    font-size: Theme.fs-lg;
                    font-weight: Theme.fw-strong;
                }
                Text {
                    text: @tr("Session name");
                    // (#dialog-label-sync 2026-10-15) 字段标签对齐设置面板:常态 = 前景色
                    color: Theme.text-primary;
                    font-size: Theme.fs-sm;
                }
                tr-input := LineEdit {
                    text <=> root.tab-rename-value;
                    font-family: Theme.ui-font-family; // CJK-capable (#54)
                    placeholder-text: @tr("Session name");
                    // (#drag-ghost-pointer 2026-09-06) 曾尝试打开时自动聚焦
                    // (tr-input.focus()/self.focus() 两种写法):Slint 编译器
                    // 对 LineEdit.focus() 的可解析性依赖 inner_components 处
                    // 理顺序,ui 任意增删元素即翻转(两种写法各自在不同序爆
                    // "focus() can only be called on focusable elements",
                    // 见 passes/focus_handling.rs 的 gen_focus_functions 时
                    // 序)。可靠替代 = 聚焦原生 TextInput(内置 accepts_
                    // focus,session_dialog/terminal_view 均如此);本框暂
                    // 保留 LineEdit 视觉,自动聚焦让位给点击输入。
                    accepted => {
                        root.rename-tab(root.tab-rename-id, root.tab-rename-value);
                    }
                }
                Text {
                    text: @tr("Leave empty to restore the default name");
                    color: Theme.text-muted;
                    font-size: Theme.fs-xs;
                }
                Rectangle { vertical-stretch: 1; }
                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    Button {
                        text: root.lang-en ? "Cancel" : "取消";
                        clicked => { root.tab-rename-open = false; }
                    }
                    Button {
                        text: root.lang-en ? "OK" : "确定";
                        primary: true;
                        clicked => {
                            root.rename-tab(root.tab-rename-id, root.tab-rename-value);
                        }
                    }
                }
            }
        }
    }

    // --- Quick-command manage dialog (#55) --------------------------------
        if root.quick-cmd-manage-open : Rectangle {
        width: parent.width;
        height: parent.height;
        background: #00000080;
        TouchArea { clicked => { root.quick-cmd-manage-open = false; } }

        qcm-card := Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: min(root.qcm-dialog-width, parent.width - 32px);
            height: min(root.qcm-dialog-height, parent.height - 32px);
            background: Theme.popup-bg;
            border-radius: Theme.radius-md;
            border-width: 1px;
            border-color: Theme.border-strong;
            drop-shadow-blur: 24px;
            drop-shadow-color: #000000a0;
            TouchArea {}   // swallow inside clicks

            VerticalLayout {
                padding: 18px;
                spacing: 10px;
                HorizontalLayout {
                    Text {
                        text: @tr("Quick commands");
                        color: Theme.text-primary;
                        font-size: Theme.fs-lg;
                        font-weight: Theme.fw-strong;
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                    }
                    Rectangle {
                        width: 22px; height: 22px;
                        border-radius: Theme.radius-sm;
                        // Match ProcWindow's close button: red (#e81123) on hover,
                        // white glyph, smooth 90ms transition (#close-hover-red).
                        background: qcm-close.has-hover ? #e81123 : transparent;
                        animate background { duration: 90ms; }
                        qcm-close := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.quick-cmd-manage-open = false; }
                        }
                        Icon {
    glyph: "close";
    tint: qcm-close.has-hover ? white : Theme.text-secondary;
    size: Theme.fs-md;
}
                    }
                }

                // Add / edit form: name + group (optional) + command.
                Text { text: @tr("Name"); color: Theme.text-primary; font-size: Theme.fs-sm; }   // (#dialog-label-sync 2026-10-15)
                qcm-name-in := LineEdit {
                    text <=> root.qcm-name;
                    font-family: Theme.ui-font-family;
                    placeholder-text: @tr("e.g. tail log");
                }
                Text { text: @tr("Group (optional)"); color: Theme.text-primary; font-size: Theme.fs-sm; }   // (#dialog-label-sync 2026-10-15)
                qcm-group-in := LineEdit {
                    text <=> root.qcm-group;
                    font-family: Theme.ui-font-family;
                    placeholder-text: @tr("leave empty → default");
                }
                Text { text: @tr("Command"); color: Theme.text-primary; font-size: Theme.fs-sm; }   // (#dialog-label-sync 2026-10-15)
                HorizontalLayout {
                    spacing: 8px;
                    Rectangle {
                        horizontal-stretch: 1;
                        height: 72px;
                        border-radius: Theme.radius-sm;
                        border-width: 1px;
                        border-color: qcm-cmd-in.has-focus ? Theme.accent : Theme.border-subtle;
                        background: Theme.bg-root;
                        clip: true;
                        Flickable {
                            content-width: self.width;
                            content-height: max(self.height, qcm-cmd-in.preferred-height + 12px);
                            qcm-cmd-in := TextInput {
                                x: 8px; y: 6px;
                                width: parent.width - 16px;
                                text <=> root.qcm-command;
                                color: Theme.text-primary;
                                // Not the mono chain: this is free text and a quick
                                // command is as likely to be Chinese as not. Native
                                // TextInput does no glyph fallback (#54) and every
                                // mono family here is CJK-less, so a mono face
                                // renders 中文 as tofu the moment it is typed.
                                font-family: Theme.ui-font-family;
                                font-size: Theme.fs-sm;
                                single-line: false;
                                wrap: no-wrap;
                            }
                        }
                    }
                    // Cancel only while editing an existing entry.
                    if root.qcm-edit-index >= 0 : Button {
                        text: root.lang-en ? "Cancel" : "取消";
                        clicked => {
                            root.qcm-edit-index = -1;
                            root.qcm-name = ""; root.qcm-command = ""; root.qcm-group = ""; root.qcm-send-enter = true;
                        }
                    }
                    Button {
                        text: root.qcm-edit-index >= 0 ? (root.lang-en ? "Save" : "保存")
                                                       : (root.lang-en ? "Add" : "添加");
                        primary: true;
                        enabled: root.qcm-name != "" && root.qcm-command != "";
                        clicked => {
                            if (root.qcm-edit-index >= 0) {
                                root.save-quick-command(root.qcm-edit-index, root.qcm-name, root.qcm-command, root.qcm-group, root.qcm-send-enter);
                            } else {
                                root.add-quick-command(root.qcm-name, root.qcm-command, root.qcm-group, root.qcm-send-enter);
                            }
                            root.qcm-edit-index = -1;
                            root.qcm-name = ""; root.qcm-command = ""; root.qcm-group = ""; root.qcm-send-enter = true;
                        }
                    }
                }

                // Whether a click sends+executes or just fills the input box to
                // tweak first (B站 suggestion).
                CheckBox {
                    text: root.lang-en
                        ? "Send + run on click (off: fill input box only)"
                        : "点击即发送执行(关闭则只填入输入框,可修改后再发)";
                    checked <=> root.qcm-send-enter;
                }

                // New (empty) group.
                HorizontalLayout {
                    Rectangle { horizontal-stretch: 1; }
                    Button {
                        text: root.lang-en ? "+ New group" : "+ 新建分组";
                        clicked => { root.qcg-orig = ""; root.qcg-name = ""; root.qcg-open = true; }
                    }
                }

                Rectangle { height: 1px; background: Theme.border-subtle; }

                // Existing commands list with delete buttons.
                Flickable {
                    vertical-stretch: 1;
                    content-width: self.width;
                    content-height: max(self.height, qcm-list.preferred-height);
                    qcm-list := VerticalLayout {
                        alignment: start;
                        spacing: 2px;
                        if root.quick-commands.length == 0 : Text {
                            text: @tr("No quick commands yet");
                            color: Theme.text-muted; font-size: Theme.fs-xs;
                        }
                        for q in root.quick-commands : VerticalLayout {
                            // Group header on the first row of each group (#55).
                            // Right-click to rename / delete (empty) / new group.
                            if q.group-header != "" : Rectangle {
                                height: 26px;
                                property <length> gmx;
                                property <length> gmy;
                                HorizontalLayout {
                                    padding-left: 4px; padding-top: 6px; spacing: 4px;
                                    Icon {
    glyph: "folder";
    tint: Theme.text-primary;
    size: Theme.fs-md;
}
                                    Text { text: q.group; color: Theme.text-muted; font-size: Theme.fs-xs;
                                           font-weight: Theme.fw-strong; vertical-alignment: center;
                                           horizontal-stretch: 1; horizontal-alignment: left; }
                                }
                                TouchArea {
                                    clicked => { }  // grab so right-click pointer-events register inside the Flickable
                                    pointer-event(e) => {
                                        if (e.kind == PointerEventKind.down && e.button == PointerEventButton.right) {
                                            gmx = self.mouse-x; gmy = self.mouse-y; qgrp-menu.show();
                                        }
                                    }
                                }
                                qgrp-menu := PopupWindow {
                                    x: gmx; y: gmy; width: 150px;
                                    height: (q.orig-index == -1 ? 3 : 2) * 30px + 9px;
                                    Rectangle {
                                        background: Theme.popup-bg; border-radius: Theme.radius-sm;
                                        border-width: 1px; border-color: Theme.border-strong;
                                        drop-shadow-blur: 10px; drop-shadow-color: #00000050;
                                        VerticalLayout {
                                            padding: 4px; spacing: 1px;
                                            Rectangle {
                                                height: 30px; border-radius: Theme.radius-sm;
                                                background: qeg-ta.has-hover ? Theme.bg-hover : transparent;
                                                qeg-ta := TouchArea { mouse-cursor: pointer;
                                                    clicked => { root.qcg-orig = q.group; root.qcg-name = q.group; root.qcg-open = true; } }
                                                HorizontalLayout { padding-left: 10px; spacing: 8px;
                                                    Icon {
    glyph: "edit";
    tint: Theme.text-primary;
    size: Theme.fs-sm;
}
                                                    Text { text: root.lang-en ? "Rename group" : "重命名分组"; color: Theme.text-primary; font-size: Theme.fs-md; vertical-alignment: center; horizontal-stretch: 1; } }
                                            }
                                            if q.orig-index == -1 : Rectangle {
                                                height: 30px; border-radius: Theme.radius-sm;
                                                background: qdg-ta.has-hover ? #cc333320 : transparent;
                                                qdg-ta := TouchArea { mouse-cursor: pointer; clicked => { root.delete-quick-group(q.group); } }
                                                HorizontalLayout { padding-left: 10px; spacing: 8px;
                                                    Icon {
    glyph: "delete";
    tint: #cc3333;
    size: Theme.fs-sm;
}
                                                    Text { text: root.lang-en ? "Delete group" : "删除分组"; color: #cc3333; font-size: Theme.fs-md; vertical-alignment: center; horizontal-stretch: 1; } }
                                            }
                                            Rectangle {
                                                height: 30px; border-radius: Theme.radius-sm;
                                                background: qng-ta.has-hover ? Theme.bg-hover : transparent;
                                                qng-ta := TouchArea { mouse-cursor: pointer; clicked => { root.qcg-orig = ""; root.qcg-name = ""; root.qcg-open = true; } }
                                                HorizontalLayout { padding-left: 10px; spacing: 8px;
                                                    Icon {
    glyph: "create-new-folder";
    tint: Theme.text-primary;
    size: Theme.fs-sm;
}
                                                    Text { text: root.lang-en ? "New group" : "新建分组"; color: Theme.text-primary; font-size: Theme.fs-md; vertical-alignment: center; horizontal-stretch: 1; } }
                                            }
                                        }
                                    }
                                }
                            }

                            // Command row (skip the empty-group placeholder).
                            if q.orig-index >= 0 : Rectangle {
                                height: 38px;
                                border-radius: Theme.radius-sm;
                                background: Theme.bg-root;
                                property <length> ctx-x;
                                property <length> ctx-y;
                                item-ta := TouchArea {
                                    clicked => { }  // grab so right-click pointer-events register inside the Flickable
                                    pointer-event(e) => {
                                        if (e.kind == PointerEventKind.down && e.button == PointerEventButton.right) {
                                            ctx-x = self.mouse-x; ctx-y = self.mouse-y; qctx-menu.show();
                                        }
                                    }
                                }
                                HorizontalLayout {
                                    padding-left: 8px; padding-right: 6px; spacing: 6px;
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        alignment: center;
                                        Text { text: q.name; color: Theme.text-primary; font-size: Theme.fs-sm;
                                               overflow: elide; }
                                        Text { text: q.command; color: Theme.text-muted; font-size: Theme.fs-xs;
                                               overflow: elide; font-family: Theme.ui-font-family; }
                                    }
                                    Rectangle {
                                        width: 24px; height: 28px;
                                        border-radius: Theme.radius-sm;
                                        background: up-ta.has-hover ? Theme.bg-hover : transparent;
                                        up-ta := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { root.reorder-quick-command(q.orig-index, true); }
                                        }
                                        Icon {
    glyph: "arrow-up";
    tint: Theme.text-primary;
    size: Theme.fs-md;
}
                                    }
                                    Rectangle {
                                        width: 24px; height: 28px;
                                        border-radius: Theme.radius-sm;
                                        background: down-ta.has-hover ? Theme.bg-hover : transparent;
                                        down-ta := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { root.reorder-quick-command(q.orig-index, false); }
                                        }
                                        Icon {
    glyph: "arrow-down";
    tint: Theme.text-primary;
    size: Theme.fs-md;
}
                                    }
                                    Rectangle {
                                        width: 28px;
                                        y: (parent.height - self.height) / 2;
                                        height: 28px;
                                        border-radius: Theme.radius-sm;
                                        background: del-ta.has-hover ? Theme.danger.with-alpha(0.18) : transparent;
                                        del-ta := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { root.delete-quick-command(q.orig-index); }
                                        }
                                        Icon {
    glyph: "delete";
    tint: Theme.text-primary;
    size: Theme.fs-md;
}
                                    }
                                }
                                qctx-menu := PopupWindow {
                                    x: ctx-x; y: ctx-y; width: 160px;
                                    height: qctx-vl.preferred-height;
                                    Rectangle {
                                        background: Theme.popup-bg; border-radius: Theme.radius-sm;
                                        border-width: 1px; border-color: Theme.border-strong;
                                        drop-shadow-blur: 10px; drop-shadow-color: #00000050;
                                        qctx-vl := VerticalLayout {
                                            padding: 4px; spacing: 1px;
                                            Rectangle { height: 28px; border-radius: Theme.radius-sm;
                                                background: qe-ta.has-hover ? Theme.bg-hover : transparent;
                                                qe-ta := TouchArea { mouse-cursor: pointer; clicked => { root.edit-quick-command(q.orig-index); } }
                                                HorizontalLayout { padding-left: 10px; spacing: 8px;
                                                    Icon {
    glyph: "edit";
    tint: Theme.text-primary;
    size: Theme.fs-sm;
}
                                                    Text { text: @tr("Edit"); color: Theme.text-primary; font-size: Theme.fs-md; vertical-alignment: center; horizontal-stretch: 1; } } }
                                            Rectangle { height: 28px; border-radius: Theme.radius-sm;
                                                background: qd-ta.has-hover ? Theme.bg-hover : transparent;
                                                qd-ta := TouchArea { mouse-cursor: pointer; clicked => { root.duplicate-quick-command(q.orig-index); } }
                                                HorizontalLayout { padding-left: 10px; spacing: 8px;
                                                    Icon {
    glyph: "copy";
    tint: Theme.text-primary;
    size: Theme.fs-sm;
}
                                                    Text { text: @tr("Duplicate"); color: Theme.text-primary; font-size: Theme.fs-md; vertical-alignment: center; horizontal-stretch: 1; } } }
                                            Rectangle { height: 28px; border-radius: Theme.radius-sm;
                                                background: qx-ta.has-hover ? #cc333320 : transparent;
                                                qx-ta := TouchArea { mouse-cursor: pointer; clicked => { root.delete-quick-command(q.orig-index); } }
                                                HorizontalLayout { padding-left: 10px; spacing: 8px;
                                                    Icon {
    glyph: "delete";
    tint: #cc3333;
    size: Theme.fs-sm;
}
                                                    Text { text: @tr("Delete"); color: #cc3333; font-size: Theme.fs-md; vertical-alignment: center; horizontal-stretch: 1; } } }
                                            Rectangle { height: 1px; background: Theme.border-subtle; }
                                            // (#theme-dedupe 2026-10-15) 「Move to」分区标签 muted → 次级档(下面组条目是主色)
                                            HorizontalLayout { padding-left: 10px; padding-top: 2px; spacing: 6px;
                                                Icon {
    glyph: "folder";
    // (#theme-dedupe 2026-10-15) 分区标签图标跟文字同档(次级)
    tint: Theme.text-secondary;
    size: Theme.fs-xs;
}
                                                Text { text: @tr("Move to"); color: Theme.text-secondary; font-size: Theme.fs-xs; vertical-alignment: center; horizontal-stretch: 1; } }
                                            if q.group != "default" : Rectangle { height: 28px; border-radius: Theme.radius-sm;
                                                background: qmd-ta.has-hover ? Theme.bg-hover : transparent;
                                                qmd-ta := TouchArea { mouse-cursor: pointer; clicked => { root.move-quick-command(q.orig-index, "default"); } }
                                                HorizontalLayout { padding-left: 10px; spacing: 8px;
                                                    Icon {
    glyph: "folder";
    tint: Theme.text-primary;
    size: Theme.fs-sm;
}
                                                    Text { text: "default"; color: Theme.text-primary; font-size: Theme.fs-md; vertical-alignment: center; horizontal-stretch: 1; } } }
                                            for s in root.quick-commands : Rectangle {
                                                visible: s.group-header != "" && s.group != "default" && s.group != q.group;
                                                height: self.visible ? 28px : 0px;
                                                border-radius: Theme.radius-sm;
                                                background: qm-ta.has-hover ? Theme.bg-hover : transparent;
                                                qm-ta := TouchArea { mouse-cursor: pointer; clicked => { root.move-quick-command(q.orig-index, s.group); } }
                                                HorizontalLayout { padding-left: 10px; spacing: 8px;
                                                    Icon {
    glyph: "folder";
    tint: Theme.text-primary;
    size: Theme.fs-sm;
}
                                                    Text { text: s.group; color: Theme.text-primary; font-size: Theme.fs-md; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; } } }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // Bottom-right resize grip. The chosen size is retained while the
            // application is running, and remains clamped to the main window.
            Rectangle {
                // #qcm-resize: bottom-right resize grip — switched from
                // "open_in_full" glyph to the 3-dot diagonal pattern used by
                // ProcWindow (#grip-icon-3dots) so all affordances share one visual.
                x: parent.width - 16px;
                y: parent.height - 16px;
                width: 16px;
                height: 16px;
                background: transparent;
                Icon { glyph: "resize-se"; tint: Theme.text-muted; size: 16px; }   // (#icon-svg-migration) 单一事实源 = assets/icons/resize-se.svg
                qcm-resize-ta := TouchArea {
                    mouse-cursor: nwse-resize;
                    pointer-event(e) => {
                        if (e.kind == PointerEventKind.down) {
                            root.qcm-dialog-resizing = true;
                            root.qcm-resize-base-width = root.qcm-dialog-width;
                            root.qcm-resize-base-height = root.qcm-dialog-height;
                            root.qcm-resize-grab-x = self.absolute-position.x + self.mouse-x;
                            root.qcm-resize-grab-y = self.absolute-position.y + self.mouse-y;
                        } else if (e.kind == PointerEventKind.up) {
                            root.qcm-dialog-resizing = false;
                        }
                    }
                    moved => {
                        if (root.qcm-dialog-resizing) {
                            root.qcm-dialog-width = clamp(
                                root.qcm-resize-base-width
                                    + self.absolute-position.x + self.mouse-x - root.qcm-resize-grab-x,
                                460px, max(460px, root.width - 32px));
                            root.qcm-dialog-height = clamp(
                                root.qcm-resize-base-height
                                    + self.absolute-position.y + self.mouse-y - root.qcm-resize-grab-y,
                                420px, max(420px, root.height - 32px));
                        }
                    }
                }
            }
        }
    }

    // --- Quick-command group name dialog (#55): new / rename --------------
        if root.qcg-open : Rectangle {
        width: parent.width;
        height: parent.height;
        background: #00000080;
        TouchArea { clicked => { root.qcg-open = false; } }

        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 340px;
            height: 178px;
            background: Theme.popup-bg;
            border-radius: Theme.radius-md;
            border-width: 1px;
            border-color: Theme.border-strong;
            drop-shadow-blur: 24px;
            drop-shadow-color: #000000a0;
            TouchArea {}   // swallow inside clicks

            VerticalLayout {
                padding: 18px;
                spacing: 12px;
                Text {
                    text: root.qcg-orig == ""
                        ? (root.lang-en ? "New group" : "新建分组")
                        : (root.lang-en ? "Rename group" : "重命名分组");
                    color: Theme.text-primary;
                    font-size: Theme.fs-lg;
                    font-weight: Theme.fw-strong;
                }
                Text { text: @tr("Group name"); color: Theme.text-primary; font-size: Theme.fs-sm; }   // (#dialog-label-sync 2026-10-15)
                qcg-input := LineEdit {
                    text <=> root.qcg-name;
                    font-family: Theme.ui-font-family;
                    placeholder-text: @tr("Group name");
                    accepted => {
                        if (root.qcg-name != "") {
                            root.submit-quick-group(root.qcg-orig, root.qcg-name);
                            root.qcg-open = false;
                        }
                    }
                }
                Rectangle { vertical-stretch: 1; }
                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    Button {
                        text: root.lang-en ? "Cancel" : "取消";
                        clicked => { root.qcg-open = false; }
                    }
                    Button {
                        text: root.lang-en ? "OK" : "确定";
                        primary: true;
                        enabled: root.qcg-name != "";
                        clicked => {
                            root.submit-quick-group(root.qcg-orig, root.qcg-name);
                            root.qcg-open = false;
                        }
                    }
                }
            }
        }
    }

    // --- SFTP prompt dialog (#69): rename / chmod / mkdir / touch ----------
        if root.sftp-prompt-open : Rectangle {
        width: parent.width;
        height: parent.height;
        background: #00000080;
        TouchArea { clicked => { root.sftp-prompt-open = false; } }

        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 340px;
            height: 178px;
            background: Theme.popup-bg;
            border-radius: Theme.radius-md;
            border-width: 1px;
            border-color: Theme.border-strong;
            drop-shadow-blur: 24px;
            drop-shadow-color: #000000a0;
            TouchArea {}   // swallow inside clicks

            VerticalLayout {
                padding: 18px;
                spacing: 12px;
                Text {
                    text: root.sftp-prompt-kind == "rename"
                        ? @tr("Rename")
                        : (root.sftp-prompt-kind == "chmod"
                            ? @tr("Permissions")
                            : (root.sftp-prompt-kind == "mkdir"
                                ? @tr("New folder") : @tr("New file")));
                    color: Theme.text-primary;
                    font-size: Theme.fs-lg;
                    font-weight: Theme.fw-strong;
                }
                Text {
                    text: root.sftp-prompt-kind == "chmod"
                        ? @tr("Octal mode, e.g. 755")
                        : (root.sftp-prompt-kind == "rename"
                            ? @tr("New name") : @tr("Name"));
                    // (#dialog-label-sync 2026-10-15) 字段标签对齐设置面板:常态 = 前景色
                    color: Theme.text-primary;
                    font-size: Theme.fs-sm;
                }
                sp-input := LineEdit {
                    text <=> root.sftp-prompt-value;
                    font-family: Theme.ui-font-family; // CJK-capable (#54)
                    placeholder-text: root.sftp-prompt-kind == "chmod" ? "755" : "";
                    accepted => {
                        if (root.sftp-prompt-value != "") {
                            root.sftp-prompt-submit(
                                root.sftp-prompt-tab, root.sftp-prompt-kind,
                                root.sftp-prompt-target, root.sftp-prompt-value);
                            root.sftp-prompt-open = false;
                        }
                    }
                }
                Rectangle { vertical-stretch: 1; }
                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    Button {
                        text: root.lang-en ? "Cancel" : "取消";
                        clicked => { root.sftp-prompt-open = false; }
                    }
                    Button {
                        text: root.lang-en ? "OK" : "确定";
                        primary: true;
                        enabled: root.sftp-prompt-value != "";
                        clicked => {
                            root.sftp-prompt-submit(
                                root.sftp-prompt-tab, root.sftp-prompt-kind,
                                root.sftp-prompt-target, root.sftp-prompt-value);
                            root.sftp-prompt-open = false;
                        }
                    }
                }
            }
        }
    }

    // --- Confirm-before-close dialog (#88 / #close-behavior) --------------
    // 四段式:头部(标题 + ×)/ 关闭行为卡片 / 活动会话清单 / 底部(只留「取消」)。
    // 卡片本身就是操作按钮(点哪张就执行哪个),故底部不再放「关闭」主按钮 ——
    // 破坏性预警改由「完全退出」卡片的 hover 变红承担。
    //
    // 注:设计稿的毛玻璃(Slint 无元素级 backdrop-filter,1.16 的
    // i-slint-core/compiler/renderer 里均无该能力)这里用不透明的
    // Theme.popup-bg 近似 —— 观感接近,但身后内容不会被真正模糊。
    if root.confirm-close-open : Rectangle {
        width: parent.width;
        height: parent.height;
        background: #00000088;
        TouchArea { clicked => { root.confirm-close-open = false; } }
        // 抓键盘:让下面的终端停止收键位;Esc 取消(卡片改为点选式后,
        // 不再有 Enter/Space 直接确认的动作)。
        FocusScope {
            init => { self.focus(); }
            key-pressed(e) => {
                if (e.text == Key.Escape) {
                    root.confirm-close-open = false;
                    accept
                } else {
                    accept   // modal: swallow everything else
                }
            }
        }

        card := Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 440px;
            height: close-body.preferred-height;
            background: Theme.popup-bg;
            border-radius: Theme.radius-lg;
            border-width: 1px;
            border-color: Theme.border-strong;
            drop-shadow-blur: 24px;
            drop-shadow-color: #000000a0;
            TouchArea {}

            close-body := VerticalLayout {
                spacing: 0;

                // ---- ① 头部:标题 + 说明 + ×(取消) ----
                // (#close-dialog-lines 2026-09-18) 各段**固定整数高度**:
                // 弹框垂直居中 + 1.25 UI 缩放会让 1px 分隔线落在不同亚像素相位,
                // 一条清晰一条发糊(用户实测"上下两条横线粗细不一致")。段高恒定
                // 后,两条线的 y 只差整数 → 同相位 → 粗细观感一致。
                //
                // (#close-head-oneline 2026-09-20) 头部改**单行**:标题与说明同一行,
                // 74px → 52px。原先说明独占一行占掉弹框 27%,而它只起"这里要选一下"
                // 的引子作用 —— 卡片本身已把意思表达完。压成一行后弹框更紧凑,层级
                // 仍然清晰(标题 15px/700 vs 说明 12px text-secondary)。
                // 文案随之换短句:完整句「请选择这次关闭的行为。」在标题旁会显得啰嗦。
                HorizontalLayout {
                    height: 52px;
                    padding-left: 18px;
                    padding-right: 12px;
                    spacing: 9px;
                    // (#close-head-left 2026-09-20) **不要**在这里写 alignment:center。
                    // HorizontalLayout 的 alignment 是**主轴(水平)**对齐:即便说明
                    // 文本带了 horizontal-stretch:1,整组「标题+说明+×」仍会被推到
                    // 弹框正中,标题与左侧脱开(用户截图)。去掉后按声明顺序左排,
                    // 说明吸收剩余空间、× 自然贴右。
                    Text {
                        text: root.lang-en ? "Close main window" : "关闭主窗口";
                        color: Theme.text-primary;
                        font-size: Theme.fs-lg;
                        font-weight: Theme.fw-strong;
                        vertical-alignment: center;
                    }
                    Text {
                        text: root.lang-en ? "Choose how to close" : "选择关闭方式";
                        color: Theme.text-secondary;
                        font-size: Theme.fs-sm;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }
                    // (#close-head-valign 2026-09-20) × 要包一层 VerticalLayout 才能垂直居中。
                    // HorizontalLayout 只会把**没有固定尺寸**的子元素拉伸到满高(标题 / 说明
                    // 那种),26px 固定高的按钮会被留在行的起始位置 —— 实测表现为"× 比标题
                    // 高一截"。套一层带 alignment: center 的竖直布局即可对齐。
                    VerticalLayout {
                        alignment: center;
                        close-x := Rectangle {
                            width: 26px;
                            height: 26px;
                            border-radius: Theme.radius-sm;
                            background: close-x-ta.has-hover ? Theme.close-red : transparent;
                            animate background { duration: 120ms; }
                            close-x-ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.confirm-close-open = false; }
                            }
                            Icon {
    glyph: "close";
    tint: close-x-ta.has-hover ? white : Theme.text-muted;
    size: Theme.fs-sm;
}
                        }
                    }
                }
                Rectangle { height: 1px; background: Theme.border-subtle; }

                // ---- ② 关闭行为:卡片即操作 ----
                VerticalLayout {
                    // (#close-dialog-lines) 固定段高,见头部注释。
                    // (#close-footer-line-phase 2026-10-10) 段高 139:头部线与
                    // 页脚线的间隔 = 段高 + 头部线 1px = 140 逻辑 px,取 4 的
                    // 倍数 —— 1.25/1.5/2 倍 DPI 下乘出来都是整数设备像素,
                    // 两条线永远落在同一亚像素相位,粗细观感一致。旧值 140
                    // (间隔 141)在 125% 缩放下间隔 176.25 设备像素,页脚线
                    // 比头部线偏 1/4 像素相位,发糊显粗(用户截图"页脚顶部
                    // 横线粗了")。间隙 12 → 11 找出这 1px,勾选行仍 18px。
                    // 139 = 14 + 勾选行 18 + 间隙 11 + 卡片 82 + 14
                    height: 139px;
                    padding-left: 18px; padding-right: 18px;
                    padding-top: 14px; padding-bottom: 14px;
                    spacing: 11px;
                    // 「记住我的选择」必须在卡片上方:卡片点击即执行,勾选要来得及。
                    // (#close-remember-align 2026-10-07) 复选框 14px 固定高在 HL 里
                    // **顶对齐**(文字行高更高),视觉上比文字偏上——包一层
                    // alignment:center 的 VL 垂直居中(同 chip 徽章的修法)。
                    // 文字包进 TouchArea:点文字 = 点复选框(翻转同一状态),
                    // 光标 pointer,点击区拉满剩余宽。
                    HorizontalLayout {
                        spacing: 8px;
                        VerticalLayout {
                            alignment: center;
                            close-rem := Rectangle {
                                width: 14px;
                                height: 14px;
                                border-radius: 3px;
                                border-width: 1px;
                                border-color: root.close-remember ? Theme.accent : Theme.border-strong;
                                background: root.close-remember ? Theme.accent : transparent;
                                ta := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.close-remember = !root.close-remember; }
                                }
                                Icon {
                                    // (#icon-svg-migration) 补回被迁移丢弃的 visible:
                                    // 原 Text 写的是 `visible: root.close-remember` —— 勾只在
                                    // 勾选后显示。丢了它会让未勾选时也画出一个白勾（用户截图:
                                    // 灰边框里带着勾）。父是固定 14×14,visible 与 if 等价。
                                    glyph: "check";
                                    tint: white;
                                    size: 11px;
                                    visible: root.close-remember;
                                }
                            }
                        }
                        remember-ta := TouchArea {
                            horizontal-stretch: 1;
                            mouse-cursor: pointer;
                            clicked => { root.close-remember = !root.close-remember; }
                            Text {
                                text: root.lang-en
                                    ? "Remember my choice, don't ask again"
                                    : "记住我的选择，下次不再提示";
                                color: Theme.text-secondary;
                                font-size: Theme.fs-sm;
                                vertical-alignment: center;
                                width: 100%;
                                height: 100%;
                            }
                        }
                    }
                    close-actions := HorizontalLayout {
                        spacing: 10px;

                        // 最小化到托盘 ── 非破坏性:hover 走 accent
                        tray-card := Rectangle {
                            horizontal-stretch: 1;
                            // (#close-cards-equal 2026-09-20) 两张卡必须**等宽**。只靠
                            // horizontal-stretch:1 做不到 —— 布局按"preferred + 均分
                            // 剩余"分配,文案更长的「最小化到托盘」会比「完全退出」宽出
                            // 约 16px(用户截图肉眼可见)。给两张卡同一个 min-width,
                            // 而它恰好等于可用宽的一半(min 已占满),布局没有剩余可偏向,
                            // 于是强制等宽。parent 是外层 HorizontalLayout。
                            min-width: (parent.width - 10px) / 2;
                            height: 82px;
                            border-radius: Theme.radius-md;
                            border-width: 1px;
                            border-color: tray-ta.has-hover ? Theme.accent : Theme.border-subtle;
                            background: tray-ta.has-hover ? Theme.chip : Theme.bg-root;
                            animate background, border-color { duration: 120ms; }
                            tray-ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.close-confirmed(
                                        root.close-remember ? "tray,remember" : "tray");
                                    root.confirm-close-open = false;
                                }
                            }
                            // 设置里把「最小化到托盘」选成默认时,给个角标
                            if root.close-behavior == "tray" : Rectangle {
                                x: parent.width - self.width - 6px;
                                y: 6px;
                                // 30px was sized around 9px "默认" — and "default"
                                // already overflowed it by ~4px. 9px bold CJK is the
                                // worst case in the app: bold plus a CJK stem that
                                // thin under unhinted grayscale AA. The badge
                                // positions from its own width, so growing it is
                                // safe (it eats leftward into the row's empty
                                // space), and scaling both together keeps the
                                // 10px label and its chip in proportion.
                                width: 46px * Theme.ui-scale;
                                height: 16px * Theme.ui-scale;
                                border-radius: 3px * Theme.ui-scale;
                                background: Theme.chip;
                                Text {
                                    text: root.lang-en ? "default" : "默认";
                                    color: Theme.accent;
                                    font-size: Theme.fs-2xs;
                                    font-weight: Theme.fw-strong;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                spacing: 6px;
                                Icon {
                                        // (#hifi-tray-icon 2026-09-19) flip_to_back:"翻到后台",
                                        // 语义"最小化到托盘保持后台运行"(原齿轮图标语义不符)。
    glyph: "minimize-to-tray";
    tint: tray-ta.has-hover ? Theme.accent : Theme.text-secondary;
    size: 22px;
}
                                Text {
                                    text: root.lang-en ? "Minimize to tray" : "最小化到托盘";
                                    color: Theme.text-primary;
                                    font-size: Theme.fs-sm;
                                    font-weight: Theme.fw-strong;
                                    horizontal-alignment: center;
                                }
                                Text {
                                    // (#close-card-count 2026-09-20) 会话数写在**会导致
                                    // 丢失的那张卡片**的副标签上:原先靠下方的「活动会话」
                                    // 列表段承载,那段与头部文案重复、又把弹框拉成四段拼盘。
                                    text: root.close-sessions.length > 0
                                        ? @tr("Keeps {0} connections", root.close-sessions.length)
                                        : (root.lang-en ? "Keeps running" : "保持后台运行");
                                    color: Theme.text-muted;
                                    font-size: Theme.fs-xs;
                                    horizontal-alignment: center;
                                }
                            }
                        }

                        // 完全退出 ── 破坏性:hover 变红(去掉主按钮后的预警承担者)
                        exit-card := Rectangle {
                            horizontal-stretch: 1;
                            // 同 tray-card:等宽,见上方注释。
                            min-width: (parent.width - 10px) / 2;
                            height: 82px;
                            border-radius: Theme.radius-md;
                            border-width: 1px;
                            border-color: exit-ta.has-hover ? Theme.close-red : Theme.border-subtle;
                            background: exit-ta.has-hover
                                ? Theme.close-red.with-alpha(0.14) : Theme.bg-root;
                            animate background, border-color { duration: 120ms; }
                            exit-ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.close-confirmed(
                                        root.close-remember ? "exit,remember" : "exit");
                                    root.confirm-close-open = false;
                                }
                            }
                            if root.close-behavior == "exit" : Rectangle {
                                x: parent.width - self.width - 6px;
                                y: 6px;
                                // Same sizing rationale as the "tray" badge above.
                                width: 46px * Theme.ui-scale;
                                height: 16px * Theme.ui-scale;
                                border-radius: 3px * Theme.ui-scale;
                                background: Theme.chip;
                                Text {
                                    text: root.lang-en ? "default" : "默认";
                                    color: Theme.accent;
                                    font-size: Theme.fs-2xs;
                                    font-weight: Theme.fw-strong;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                            VerticalLayout {
                                alignment: center;
                                spacing: 6px;
                                Icon {
                                        // 完全退出：开口容器 + 穿出箭头（离开应用容器，非"关掉设备"）。
    glyph: "quit";
    tint: exit-ta.has-hover ? Theme.close-red : Theme.text-secondary;
    size: 22px;
}
                                Text {
                                    text: root.lang-en ? "Quit completely" : "完全退出";
                                    color: Theme.text-primary;
                                    font-size: Theme.fs-sm;
                                    font-weight: Theme.fw-strong;
                                    horizontal-alignment: center;
                                }
                                Text {
                                    // 同上:把"会断开什么"写在会导致断开的这张卡上。
                                    text: root.close-sessions.length > 0
                                        ? @tr("Closes {0} connections", root.close-sessions.length)
                                        : (root.lang-en ? "Closes the app" : "关闭应用");
                                    color: Theme.text-muted;
                                    font-size: Theme.fs-xs;
                                    horizontal-alignment: center;
                                }
                            }
                            // (#close-focus-scope-removed 2026-09-20) 这里原有一个
                            // exit-focus := FocusScope,用来给「完全退出」补键盘聚焦态。
                            // **已移除**:FocusScope 被点击时会自己去获取焦点、把这一击
                            // 消费掉 —— 于是第一次点卡片到不了下面那个 TouchArea,
                            // 表现为"点一次没反应、点第二次才退出"(用户实测:第一下
                            // 连卡片都不关,hover 却正常)。
                            // 危险预警仍由 hover 承担(卡片的红边)。
                            // TODO(#close-focus-visible):若要恢复键盘聚焦态,需要找
                            // 一种不消费点击的写法(例如把 FocusScope 尺寸压到 0 后再
                            // 单独处理 Tab),不能直接盖在卡片上。
                        }
                    }
                }
                // ---- ④ 底部:只留「取消」 ----
                Rectangle { height: 1px; background: Theme.border-subtle; }
                HorizontalLayout {
                    // (#close-dialog-lines) 固定段高,见头部注释。
                    height: 62px;
                    padding-left: 18px; padding-right: 18px;
                    padding-top: 14px; padding-bottom: 14px;
                    spacing: 8px;
                    Text {
                        text: root.lang-en ? "Esc  cancel" : "Esc  取消";
                        color: Theme.text-muted;
                        font-size: Theme.fs-xs;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    GhostButton {
                        // (#close-cancel-width 2026-09-20) 走内容宽。不传这两个参
                        // 数时 GhostButton 用默认 min-width:80px / max-width:100000px,
                        // 而底部布局里没有别的 stretch 元素 → 剩余空间被它吃掉,
                        // 「取消」被撑成一条横贯右半边的长条(用户截图)。
                        // 与 session_dialog 页脚的两颗按钮写法保持一致。
                        horizontal-stretch: 0;
                        btn-min-width: 0px;
                        hug-width: true;
                        text: root.lang-en ? "Cancel" : "取消";
                        clicked => { root.confirm-close-open = false; }
                    }
                }
            }
        }
    }

    // --- Visual chmod dialog (#84): Owner/Group/Other × Read/Write/Execute --
    if root.chmod-open : Rectangle {
        width: parent.width;
        height: parent.height;
        background: #00000080;
        TouchArea { clicked => { root.chmod-open = false; } }

        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 320px;
            height: 270px;
            background: Theme.popup-bg;
            border-radius: Theme.radius-md;
            border-width: 1px;
            border-color: Theme.border-strong;
            drop-shadow-blur: 24px;
            drop-shadow-color: #000000a0;
            TouchArea {}

            VerticalLayout {
                padding: 18px;
                spacing: 10px;
                Text {
                    text: root.lang-en ? "Permissions" : "修改文件权限";
                    color: Theme.text-primary; font-size: Theme.fs-lg; font-weight: Theme.fw-strong;
                }
                Text {
                    text: root.chmod-name;
                    color: Theme.text-secondary; font-size: Theme.fs-sm;
                    font-family: Theme.ui-font-family; overflow: elide;
                }

                for grp in [
                    { lbl: root.lang-en ? "Owner" : "所有者", g: 0 },
                    { lbl: root.lang-en ? "Group" : "组",     g: 1 },
                    { lbl: root.lang-en ? "Other" : "其他",   g: 2 },
                ] : VerticalLayout {
                    spacing: 2px;
                    Text { text: grp.lbl; color: Theme.text-secondary; font-size: Theme.fs-xs; }
                    HorizontalLayout {
                        spacing: 14px;
                        CheckBox {
                            text: root.lang-en ? "Read" : "读取";
                            checked: grp.g == 0 ? root.chmod-or : (grp.g == 1 ? root.chmod-gr : root.chmod-tr);
                            toggled => {
                                if (grp.g == 0) { root.chmod-or = self.checked; }
                                else if (grp.g == 1) { root.chmod-gr = self.checked; }
                                else { root.chmod-tr = self.checked; }
                            }
                        }
                        CheckBox {
                            text: root.lang-en ? "Write" : "写入";
                            checked: grp.g == 0 ? root.chmod-ow : (grp.g == 1 ? root.chmod-gw : root.chmod-tw);
                            toggled => {
                                if (grp.g == 0) { root.chmod-ow = self.checked; }
                                else if (grp.g == 1) { root.chmod-gw = self.checked; }
                                else { root.chmod-tw = self.checked; }
                            }
                        }
                        CheckBox {
                            text: root.lang-en ? "Execute" : "执行";
                            checked: grp.g == 0 ? root.chmod-ox : (grp.g == 1 ? root.chmod-gx : root.chmod-tx);
                            toggled => {
                                if (grp.g == 0) { root.chmod-ox = self.checked; }
                                else if (grp.g == 1) { root.chmod-gx = self.checked; }
                                else { root.chmod-tx = self.checked; }
                            }
                        }
                    }
                }

                Rectangle { vertical-stretch: 1; }
                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    Button {
                        text: root.lang-en ? "Cancel" : "取消";
                        clicked => { root.chmod-open = false; }
                    }
                    Button {
                        text: root.lang-en ? "OK" : "确定";
                        primary: true;
                        clicked => { root.sftp-chmod-apply(); root.chmod-open = false; }
                    }
                }
            }
        }
    }


    // --- Keyboard shortcuts dialog (#103) ---------------------------------
    Rectangle {
        width: parent.width;
        height: parent.height;
        visible: root.shortcuts-open;
        background: #00000080;
        TouchArea { clicked => { root.shortcuts-open = false; } }

        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 424px;
            height: 432px;
            background: Theme.popup-bg;
            border-radius: Theme.radius-md;
            border-width: 1px;
            border-color: Theme.border-strong;
            drop-shadow-blur: 24px;
            drop-shadow-color: #000000a0;
            TouchArea {}

            VerticalLayout {
                padding: 18px;
                spacing: 5px;

                HorizontalLayout {
                    Text {
                        text: root.lang-en ? "Keyboard shortcuts" : "快捷键";
                        color: Theme.text-primary;
                        font-size: Theme.fs-lg;
                        font-weight: Theme.fw-strong;
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                    }
                    Rectangle {
                        width: 22px; height: 22px;
                        border-radius: Theme.radius-sm;
                        background: sc-close.has-hover ? Theme.bg-hover : transparent;
                        sc-close := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.shortcuts-open = false; }
                        }
                        Icon {
    glyph: "close";
    tint: Theme.text-primary;
    size: Theme.fs-md;
}
                    }
                }

                // Scrollable so the list never overflows the fixed-height card (#140).
                ScrollView {
                    vertical-stretch: 1;
                    VerticalLayout {
                        spacing: 5px;

                // (#theme-dedupe 2026-10-15) 快捷键弹框四个分区标题 muted → 次级档(§3.5 小节标题口径)
                Text { text: root.lang-en ? "Tabs" : "标签页";
                       color: Theme.text-secondary; font-size: Theme.fs-xs; }
                ShortcutRow { keys: root.is-mac ? "⌃Tab" : "Ctrl+Tab"; desc: root.lang-en ? "Next tab" : "下一个标签页"; }
                ShortcutRow { keys: root.is-mac ? "⌃⇧Tab" : "Ctrl+Shift+Tab"; desc: root.lang-en ? "Previous tab" : "上一个标签页"; }

                Rectangle { height: 6px; }
                Text { text: root.lang-en ? "Window" : "窗口";
                       color: Theme.text-secondary; font-size: Theme.fs-xs; }
                ShortcutRow { keys: root.is-mac ? "⌘⇧N" : "Ctrl+Shift+N"; desc: root.lang-en ? "New window" : "新建窗口"; }
                ShortcutRow { keys: root.is-mac ? "⌘⌥Z" : "Ctrl+Alt+Z"; desc: root.lang-en ? "Toggle zen (focus) mode" : "切换专注模式"; }

                Rectangle { height: 6px; }
                Text { text: root.lang-en ? "Terminal" : "终端";
                       color: Theme.text-secondary; font-size: Theme.fs-xs; }
                ShortcutRow { keys: root.is-mac ? "⌘C" : "Ctrl+Shift+C"; desc: root.lang-en ? "Copy selection" : "复制选中内容"; }
                ShortcutRow { keys: root.is-mac ? "⌘V" : "Ctrl+V"; desc: root.lang-en ? "Paste" : "粘贴"; }
                ShortcutRow { keys: root.is-mac ? "⌘F" : "Ctrl+F"; desc: root.lang-en ? "Find in terminal" : "查找"; }
                ShortcutRow { keys: root.is-mac ? "⌘⇧R" : "Ctrl+Shift+R"; desc: root.lang-en ? "Jump to command history search" : "跳到命令历史搜索"; }
                ShortcutRow { keys: root.is-mac ? "⌘=" : "Ctrl+="; desc: root.lang-en ? "Enlarge terminal font (this session)" : "放大终端字体（当前会话）"; }
                ShortcutRow { keys: root.is-mac ? "⌘-" : "Ctrl+-"; desc: root.lang-en ? "Shrink terminal font (this session)" : "缩小终端字体（当前会话）"; }
                ShortcutRow { keys: root.is-mac ? "⌘0" : "Ctrl+0"; desc: root.lang-en ? "Reset terminal font size (this session)" : "重置终端字体大小（当前会话）"; }
                ShortcutRow { keys: root.is-mac ? "⌘⌥=" : "Ctrl+Alt+="; desc: root.lang-en ? "Enlarge terminal font (all sessions in window)" : "放大终端字体（本窗口所有会话）"; }
                ShortcutRow { keys: root.is-mac ? "⌘⌥-" : "Ctrl+Alt+-"; desc: root.lang-en ? "Shrink terminal font (all sessions in window)" : "缩小终端字体（本窗口所有会话）"; }
                ShortcutRow { keys: root.is-mac ? "⌘⌥0" : "Ctrl+Alt+0"; desc: root.lang-en ? "Reset terminal font size (all sessions in window)" : "重置终端字体大小（本窗口所有会话）"; }
                ShortcutRow { keys: root.lang-en ? "Drag" : "鼠标拖动"; desc: root.lang-en ? "Select text" : "选择文本"; }
                ShortcutRow { keys: root.lang-en ? "Wheel / Scrollbar" : "滚轮 / 滚动条"; desc: root.lang-en ? "Scroll history" : "滚动历史"; }

                Rectangle { height: 6px; }
                Text { text: root.lang-en ? "Command box" : "命令输入框";
                       color: Theme.text-secondary; font-size: Theme.fs-xs; }
                ShortcutRow { keys: "Enter"; desc: root.lang-en ? "Send command" : "发送命令"; }
                ShortcutRow { keys: "↑ / ↓"; desc: root.lang-en ? "Previous / next in history" : "上一条 / 下一条历史"; }
                ShortcutRow { keys: root.is-mac ? "⌃R" : "Ctrl+R"; desc: root.lang-en ? "Search history (↑↓ select, Enter run, Esc close)" : "搜索命令历史(↑↓ 选择,回车执行,Esc 关闭)"; }
                ShortcutRow { keys: "Esc"; desc: root.lang-en ? "Close history / focus terminal" : "关闭历史 / 聚焦终端"; }
                ShortcutRow { keys: root.is-mac ? "⌃A" : "Ctrl+A"; desc: root.lang-en ? "Move to start of line" : "移到行首"; }
                ShortcutRow { keys: root.is-mac ? "⌃E" : "Ctrl+E"; desc: root.lang-en ? "Move to end of line" : "移到行尾"; }
                ShortcutRow { keys: root.is-mac ? "⌃K" : "Ctrl+K"; desc: root.lang-en ? "Delete to end of line" : "删除到行尾"; }
                ShortcutRow { keys: root.is-mac ? "⌃U" : "Ctrl+U"; desc: root.lang-en ? "Delete to start of line" : "删除到行首"; }
                        Rectangle { height: 2px; }
                    }
                }
            }
        }
    }

    // --- About dialog (centered on the window, with dim backdrop) ---------
    Rectangle {
        width: parent.width;
        height: parent.height;
        visible: root.about-open;
        background: #00000080;            // dim backdrop
        TouchArea { clicked => { root.about-open = false; } }

        // Landscape card: logo on the left, a short intro + repo link on the right.
        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: 520px;
            height: 188px;
            background: Theme.popup-bg;
            border-radius: Theme.radius-lg;
            border-width: 1px;
            border-color: Theme.border-strong;
            drop-shadow-blur: 24px;
            drop-shadow-color: #000000a0;

            // Swallow clicks so the backdrop doesn't close when clicking inside.
            TouchArea {}

            // Close (×) in the top-right corner.
            Rectangle {
                x: parent.width - 30px;
                y: 8px;
                width: 22px; height: 22px;
                border-radius: Theme.radius-sm;
                background: ab-close-ta.has-hover ? Theme.bg-hover : transparent;
                ab-close-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.about-open = false; }
                }
                Icon {
    glyph: "close";
    tint: Theme.text-primary;
    size: Theme.fs-md;
}
            }

            HorizontalLayout {
                padding: 24px;
                spacing: 20px;

                VerticalLayout {
                    alignment: center;
                    Image {
                        source: @image-url("../assets/icon.png");
                        width: 76px;
                        height: 76px;
                    }
                }

                VerticalLayout {
                    alignment: center;
                    spacing: 7px;
                    horizontal-stretch: 1;

                    HorizontalLayout {
                        alignment: start;
                        spacing: 8px;
                        Text {
                            text: "MTerm";
                            color: Theme.text-primary;
                            font-size: 22px;
                            font-weight: Theme.fw-strong;
                            vertical-alignment: center;
                        }
                        // The "vX.Y.Z" chip was removed from the title card —
                        // the bottom version footnote already shows the same
                        // string in muted text (#ui-title-card).
                    }

                    Text {
                        text: @tr("MTerm — a lightweight Rust + Slint SSH client by 'lil meatball'");
                        color: Theme.text-secondary;
                        font-size: Theme.fs-sm;
                        wrap: word-wrap;
                    }

                    // Clickable open-source link → opens the GitHub page.
                    HorizontalLayout {
                        alignment: start;
                        spacing: 6px;
                        Text {
                            text: @tr("Open source");
                            color: Theme.text-muted;
                            font-size: Theme.fs-sm;
                            vertical-alignment: center;
                        }
                        Rectangle {
                            border-radius: Theme.radius-sm;
                            background: repo-ta.has-hover ? Theme.bg-hover : transparent;
                            HorizontalLayout {
                                padding-left: 4px; padding-right: 4px;
                                Text {
                                    text: "github.com/cbozuo/MTerm";
                                    color: Theme.accent;
                                    font-size: Theme.fs-sm;
                                    vertical-alignment: center;
                                }
                            }
                            repo-ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.open-repo(); }
                            }
                        }
                    }

                    Text {
                        text: "MIT / Apache-2.0";
                        color: Theme.text-muted;
                        font-size: Theme.fs-xs;
                    }
                }
            }
        }
    }

    // --- Modal dialog -----------------------------------------------------
    SessionDialog {
        width: parent.width;
        height: parent.height;
        bounds-w: root.width;
        bounds-h: root.height;
        // Only the placeholder text depends on it (#credential-store): on
        // Windows a blank password field may be filled from the Credential
        // Manager, so "prompt on connect" is not the whole truth there.
        is-windows: root.is-windows;
        is-open <=> root.dialog-open;
        is-editing <=> root.dialog-editing;
        draft-id <=> root.dialog-id;
        draft-name <=> root.dialog-name;
        draft-host <=> root.dialog-host;
        draft-port <=> root.dialog-port;
        draft-user <=> root.dialog-user;
        draft-auth <=> root.dialog-auth;
        draft-password <=> root.dialog-password;
        draft-key-path <=> root.dialog-key-path;
        draft-key-inline <=> root.dialog-key-inline;
        draft-key-inline-mode <=> root.dialog-key-inline-mode;
        draft-proxy-type <=> root.dialog-proxy-type;
        draft-path-type <=> root.dialog-path-type;
        draft-proxy-host <=> root.dialog-proxy-host;
        draft-proxy-port <=> root.dialog-proxy-port;
        draft-proxy-user <=> root.dialog-proxy-user;
        draft-proxy-pass <=> root.dialog-proxy-pass;
        draft-group <=> root.dialog-group;
        session-groups: root.session-groups;
        jump-pool: root.jump-pool;
        jump-chain: root.jump-chain;
        jump-chain-rows: root.jump-chain-rows;
        jump-chain-row-offsets: root.jump-chain-row-offsets;
        chain-add(id) => { root.dialog-chain-add(id); }
        chain-width-changed(w) => { root.dialog-chain-width(w); }
        chain-remove(i) => { root.dialog-chain-remove(i); }
        chain-up(i) => { root.dialog-chain-up(i); }
        chain-down(i) => { root.dialog-chain-down(i); }
        draft-kind <=> root.dialog-kind;
        draft-serial-port <=> root.dialog-serial-port;
        draft-baud <=> root.dialog-baud;
        draft-data-bits <=> root.dialog-data-bits;
        draft-stop-bits <=> root.dialog-stop-bits;
        draft-parity <=> root.dialog-parity;
        draft-flow <=> root.dialog-flow;
        draft-encoding <=> root.dialog-encoding;
        draft-vt100-drawing <=> root.dialog-vt100-drawing;
        draft-disable-shell-integration <=> root.dialog-disable-shell-integration;
        draft-note <=> root.dialog-note;
        draft-rdp-domain <=> root.dialog-rdp-domain;
        draft-rdp-resolution <=> root.dialog-rdp-resolution;
        draft-rdp-width <=> root.dialog-rdp-width;
        draft-rdp-height <=> root.dialog-rdp-height;
        draft-rdp-mode <=> root.dialog-rdp-mode;
        draft-rdp-follow-tab-size <=> root.dialog-rdp-follow-tab-size;
        draft-vnc-view-only <=> root.dialog-vnc-view-only;
        draft-vnc-security <=> root.dialog-vnc-security;
        draft-vnc-clipboard <=> root.dialog-vnc-clipboard;
        test-status <=> root.dialog-test-status;
        forwards: root.dialog-forwards;
        triggers: root.dialog-triggers;
        submit(draft) => { root.session-dialog-submit(draft); }
        test-connection(draft) => { root.session-dialog-test(draft); }
        cancel => { root.session-dialog-cancel(); }
        pick-key-file => { root.session-dialog-pick-key(); }
        add-forward => { root.add-forward(); }
        update-forward(i, f) => { root.update-forward(i, f); }
        delete-forward(i) => { root.delete-forward(i); }
        add-trigger => { root.add-trigger(); }
        update-trigger(i, trigger) => { root.update-trigger(i, trigger); }
        delete-trigger(i) => { root.delete-trigger(i); }
        add-sample-forward => { root.add-sample-forward(); }
        add-sample-trigger => { root.add-sample-trigger(); }
    }

    // --- Delete confirmation (#28) ----------------------------------------
    ConfirmDialog {
        width: parent.width;
        height: parent.height;
        is-open <=> root.confirm-delete-open;
        title: @tr("Confirm delete");
        message: root.confirm-delete-batch
            ? (root.lang-en ? "Delete the checked items? This cannot be undone."
                            : "删除选中的多个项目?此操作不可撤销。")
            : @tr("Delete this item? This cannot be undone.");
        detail: root.confirm-delete-path;
        confirm-label: @tr("Delete");
        confirm => {
            if (root.confirm-delete-batch) {
                root.sftp-delete-selected(root.confirm-delete-tab);
                root.confirm-delete-batch = false;
            } else {
                root.sftp-delete(root.confirm-delete-tab, root.confirm-delete-path);
            }
            root.confirm-delete-open = false;
        }
        cancel => { root.confirm-delete-batch = false; root.confirm-delete-open = false; }
    }

    // Multi-line paste can execute several shell commands at once. Keep the
    // prompt explicit; clicking the backdrop never accepts the paste (#262),
    // while Enter provides the expected keyboard confirmation (#392).
    ConfirmDialog {
        width: parent.width;
        height: parent.height;
        is-open <=> root.paste-confirm-open;
        covered: root.confirm-close-open;
        dismiss-on-backdrop: false;
        confirm-on-enter: true;
        title: root.lang-en ? "Confirm multi-line paste" : "确认多行粘贴";
        message: root.lang-en
            ? "The clipboard contains line breaks and may execute multiple commands. Review it before pasting."
            : "剪贴板内容包含换行，粘贴后可能连续执行多个命令，请确认内容后再继续。";
        detail: root.paste-confirm-preview;
        large-detail: root.paste-confirm-large;
        confirm-label: root.lang-en ? "Paste" : "粘贴";
        confirm => {
            root.paste-confirmed(root.paste-confirm-tab);
            root.paste-confirm-open = false;
            root.terminal-focus-sequence += 1;
        }
        cancel => {
            root.paste-confirm-cancelled();
            root.paste-confirm-open = false;
            root.terminal-focus-sequence += 1;
        }
    }

    // Host-key confirmation (#109-5). Reuses the confirm-dialog card. The backdrop
    // is NOT a dismiss here (#152): clicking outside the card used to count as a
    // reject and — worse — poison the host for the whole run. The user must pick
    // "Trust & connect" or the explicit Cancel/Reject button.
    ConfirmDialog {
        width: parent.width;
        height: parent.height;
        is-open <=> root.hostkey-prompt-open;
        dismiss-on-backdrop: false;
        title: root.hostkey-title;
        message: root.hostkey-message;
        detail: root.hostkey-detail;
        confirm-label: root.hostkey-confirm-label;
        confirm => { root.hostkey-accept(); }
        cancel => { root.hostkey-reject(); }
    }

    // Batch-import connections from pasted text (#150).
    if root.batch-import-open : Rectangle {
        width: parent.width;
        height: parent.height;
        background: #000000aa;
        TouchArea { clicked => { root.batch-import-open = false; } }   // backdrop closes
        Rectangle {
            width: 540px;
            height: 440px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: Theme.popup-bg;
            border-radius: Theme.radius-lg;
            border-width: 1px;
            border-color: Theme.border-strong;
            drop-shadow-blur: 24px;
            drop-shadow-color: #00000080;
            TouchArea {}   // swallow clicks inside the card

            VerticalLayout {
                padding: 20px;
                spacing: 10px;
                Text {
                    text: root.lang-en ? "Batch import connections" : "批量导入连接";
                    color: Theme.text-primary;
                    font-size: Theme.fs-xl;
                    font-weight: Theme.fw-strong;
                }
                Text {
                    text: root.lang-en
                        ? "One per line:  host|port|user|password|name   (port/user/password/name optional)"
                        : "每行一个:  host|port|user|password|name   (端口/用户/密码/名称可省略)";
                    color: Theme.text-secondary;
                    font-size: Theme.fs-sm;
                    wrap: word-wrap;
                }
                // Paste area — themed multiline input.
                Rectangle {
                    vertical-stretch: 1;
                    border-radius: Theme.radius-sm;
                    border-width: 1px;
                    border-color: bi-input.has-focus ? Theme.accent : Theme.border-subtle;
                    background: Theme.bg-root;
                    clip: true;
                    Flickable {
                        content-height: max(self.height, bi-input.preferred-height + 16px);
                        bi-input := TextInput {
                            x: 10px;
                            y: 8px;
                            width: parent.width - 20px;
                            text <=> root.batch-import-text;
                            color: Theme.text-primary;
                            // The placeholder right below is
                            // "…|pass@123|服务器1" — this field is specified to
                            // carry CJK session names. Mono has no CJK and
                            // TextInput never falls back, so it would tofu on the
                            // very first Chinese name. ui-font-family is the
                            // CJK-capable face Rust resolves at startup.
                            font-family: Theme.ui-font-family;
                            font-size: Theme.fs-md;
                            single-line: false;
                            wrap: no-wrap;
                        }
                    }
                    if root.batch-import-text == "" : Text {
                        x: 10px;
                        y: 8px;
                        text: "192.168.1.108|22|root|pass@123|服务器1";
                        color: Theme.text-muted;
                        // Must match bi-input above: a sans placeholder over a sans
                        // field, so the two overlay pixel-for-pixel. A mono
                        // placeholder over the sans field would also fall back
                        // mid-string on the CJK tail and break its own metrics.
                        font-family: Theme.ui-font-family;
                        font-size: Theme.fs-md;
                    }
                }
                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    GhostButton {
                        text: @tr("Cancel");
                        clicked => { root.batch-import-open = false; }
                    }
                    PrimaryButton {
                        text: root.lang-en ? "Import" : "导入";
                        clicked => {
                            root.batch-import-confirm(root.batch-import-text);
                            root.batch-import-open = false;
                        }
                    }
                }
            }
        }
    }

    // Connect-time credential prompt (#110). Backdrop / Cancel abort the connect.
    if root.cred-prompt-open : Rectangle {
        width: parent.width;
        height: parent.height;
        background: #000000aa;
        TouchArea { clicked => { root.cred-reject(); } }
        Rectangle {
            width: 360px;
            height: cred-card.preferred-height;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: Theme.popup-bg;
            border-radius: Theme.radius-lg;
            border-width: 1px;
            border-color: Theme.border-strong;
            drop-shadow-blur: 24px;
            drop-shadow-color: #00000080;
            TouchArea {}   // swallow clicks inside the card
            cred-card := VerticalLayout {
                padding: 20px;
                spacing: 12px;
                Text {
                    text: @tr("Login");
                    color: Theme.text-primary;
                    font-size: Theme.fs-xl;
                    font-weight: Theme.fw-strong;
                }
                Text {
                    text: root.cred-host;
                    color: Theme.text-secondary;
                    font-family: Theme.font-mono;
                    font-size: Theme.fs-sm;
                }
                if root.cred-need-user : LabeledInput {
                    label: @tr("Username");
                    placeholder: "root";
                    value <=> root.cred-user;
                    accepted => { root.cred-accept(); }
                    canceled => { root.cred-reject(); }   // Esc cancels (#140-3)
                }
                if root.cred-need-password : LabeledInput {
                    label: @tr("Password");
                    placeholder: "••••••••";
                    password: true;
                    value <=> root.cred-password;
                    accepted => { root.cred-accept(); }
                    canceled => { root.cred-reject(); }   // Esc cancels (#140-3)
                }
                CheckBox {
                    text: @tr("Remember for this session");
                    checked <=> root.cred-remember;
                }
                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    GhostButton {
                        text: @tr("Cancel");
                        clicked => { root.cred-reject(); }
                    }
                    PrimaryButton {
                        text: @tr("Connect");
                        clicked => { root.cred-accept(); }
                    }
                }
            }
        }
    }

    // MFA / keyboard-interactive prompt (#86-MFA). A bastion (JumpServer with MFA
    // forced on) challenges for a verification code mid-login; backdrop / Cancel
    // abort the connect.
    if root.mfa-prompt-open : Rectangle {
        width: parent.width;
        height: parent.height;
        background: #000000aa;
        TouchArea { clicked => { root.mfa-cancel(); } }
        Rectangle {
            width: 360px;
            height: mfa-card.preferred-height;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            background: Theme.popup-bg;
            border-radius: Theme.radius-lg;
            border-width: 1px;
            border-color: Theme.border-strong;
            drop-shadow-blur: 24px;
            drop-shadow-color: #00000080;
            TouchArea {}   // swallow clicks inside the card
            mfa-card := VerticalLayout {
                padding: 20px;
                spacing: 12px;
                Text {
                    text: root.lang-en ? "Two-factor verification" : "双重验证 (MFA)";
                    color: Theme.text-primary;
                    font-size: Theme.fs-xl;
                    font-weight: Theme.fw-strong;
                }
                Text {
                    text: root.mfa-host;
                    color: Theme.text-secondary;
                    font-family: Theme.font-mono;
                    font-size: Theme.fs-sm;
                }
                // The server's own prompt text (falls back to a generic hint).
                Text {
                    text: root.mfa-prompt != "" ? root.mfa-prompt
                        : (root.lang-en ? "Enter your verification code" : "请输入验证码");
                    color: Theme.text-secondary;
                    font-size: Theme.fs-sm;
                    wrap: word-wrap;
                }
                code-input := LabeledInput {
                    label: root.lang-en ? "Code" : "验证码";
                    placeholder: "123456";
                    password: !root.mfa-echo;
                    value <=> root.mfa-answer;
                    auto-focus: true;
                    accepted => { root.mfa-submit(); }   // Enter submits
                    canceled => { root.mfa-cancel(); }   // Esc cancels (#140-3)
                }
                HorizontalLayout {
                    alignment: end;
                    spacing: 8px;
                    GhostButton {
                        text: @tr("Cancel");
                        clicked => { root.mfa-cancel(); }
                    }
                    PrimaryButton {
                        text: root.lang-en ? "Verify" : "验证";
                        clicked => { root.mfa-submit(); }
                    }
                }
            }
        }
    }

    // --- Interface settings (modal overlay) -------------------------------
    // (#settings-extract 2026-10-14) 弹框 chrome（遮罩/模态焦点域/标题栏/✕/
    // 空白区拖动/缩放手柄）提取到 settings_dialog.slint（同 session_dialog.slint
    // 模式）。内容 InterfacePanel 实例与全部状态绑定作为 @children 槽位传进去：
    // 这些状态都在 AppWindow 根上，root.xxx 原样不动，免去一层透传。
    // 空白区拖动：#settings-drag —— 卡片吞层收全部空白按下（面板内不再铺
    // blank-ta，那会把按下吞在拖动层之上；ScrollView 的 Flickable
    // mouse-drag-pan-enabled=false，鼠标按下直接下穿），字段/按钮不受影响。
    if root.interface-open : SettingsDialog {
        lang-en: root.lang-en;
        is-windows: root.is-windows;
        bounds-w: root.width;
        bounds-h: root.height;
        ifd-x <=> root.ifd-x;
        ifd-y <=> root.ifd-y;
        ifd-w <=> root.ifd-w;
        ifd-h <=> root.ifd-h;
        ifd-dragging <=> root.ifd-dragging;
        ifd-resizing <=> root.ifd-resizing;
        ifd-base-x <=> root.ifd-base-x;
        ifd-base-y <=> root.ifd-base-y;
        ifd-base-w <=> root.ifd-base-w;
        ifd-base-h <=> root.ifd-base-h;
        ifd-grab-x <=> root.ifd-grab-x;
        ifd-grab-y <=> root.ifd-grab-y;
        close-requested => {
            root.interface-open = false;
            // 同时收掉根层浮层开关（Esc 同款处理）
            root.accent-pop-open = false;
            root.accent-pick-open = false;
            root.theme-pick-open = false;
        }
        esc-requested => {
            // 浮层开着先关浮层（强调色预设弹框/取色盘/主题下拉），再按一次才
            // 关设置卡。否则 Esc 直接关卡会把根层浮层遗留在屏上（浮层在
            // overlay 之外，不随 interface-open 隐藏）。定稿语义：调色盘 Esc =
            // 放弃修改；预设弹框 Esc = 还原选定色。
            if (root.accent-pick-open) {
                root.accent-pick-open = false;
            } else if (root.accent-pop-open) {
                root.accent-stage = root.accent-guard.eff;
                root.accent-pop-open = false;
            } else if (root.theme-pick-open) {
                root.theme-pick-open = false;
                root.theme-pick-search = "";
                root.theme-search-filter("");
                root.preview-theme(root.theme-chosen);
            } else {
                root.interface-open = false;
            }
        }
        request-full-redraw => { root.request-full-redraw(); }
        blank-clicked => { iface-panel.blank-clicked(); }
        iface-panel := InterfacePanel {
            vertical-stretch: 1;
            lang-en: root.lang-en;
            is-windows: root.is-windows;
            // (#theme-split) 主题/强调色/三滑杆/通透度
            theme-entries: root.theme-entries;
            theme-chosen <=> root.theme-chosen;
            follow-system <=> root.follow-system;
            accent-mode <=> root.accent-mode;
            accent-preset <=> root.accent-preset;
            accent-custom <=> root.accent-custom;
            accent-stage <=> root.accent-stage;
            accent-guard <=> root.accent-guard;
            accent-pop-open <=> root.accent-pop-open;
            wallpaper-active <=> root.wallpaper-active;
            term-alpha <=> root.term-alpha;
            wallpaper-visible <=> root.wallpaper-visible;
            popup-transparency <=> root.popup-transparency;
            wallpaper-color-pickup <=> root.wallpaper-color-pickup;
            ifd-page <=> root.ifd-page;
            theme-pick-open <=> root.theme-pick-open;
            theme-pick-x <=> root.theme-pick-x;
            theme-pick-y <=> root.theme-pick-y;
            theme-pick-search <=> root.theme-pick-search;
            theme-search-filter(q) => { root.theme-search-filter(q); }
            theme-name <=> root.theme-name;
            preview-theme(id) => { root.preview-theme(id); }
            set-theme(id) => { root.set-theme(id); }
            set-follow-system(v) => { root.set-follow-system(v); }
            set-accent-mode(m, v) => { root.set-accent-mode(m, v); }
            accent-hex-color(h) => { root.accent-hex-color(h); }
            accent-ink-on(h) => { root.accent-ink-on(h); }
            set-panel-alpha(v) => { root.set-panel-alpha(v); }
            set-term-alpha(v) => { root.set-term-alpha(v); }
            set-wallpaper-visible(v) => { root.set-wallpaper-visible(v); }
            set-popup-transparency(v) => { root.set-popup-transparency(v); }
            set-wallpaper-color-pickup(v) => { root.set-wallpaper-color-pickup(v); }
            // (#settings-divider-line) Nav switching rebuilds the right
            // pane's whole subtree; one clean full frame per page change
            // keeps the title divider from being composited out of
            // stale buffer strips by the incremental path.
            request-full-redraw => root.request-full-redraw();
            renderer-mode <=> root.renderer-mode;
            term-fonts: root.term-fonts;
            term-font-chosen: root.term-font-chosen;
            term-font-default-name: root.term-font-default-name;
            // Interface › Font › Interface font. One-way on the value
            // (Rust owns the resolution) and one-way out through the
            // callback, mirroring term-font-family so the two pickers
            // read the same way.
            ui-fonts: root.ui-fonts;
            ui-font-chosen: root.ui-font-chosen;
            ui-font-default-name: root.ui-font-default-name;
            set-ui-font(v) => { root.set-ui-font(v); }
            term-font-size: root.term-font-size;
            terminal-line-spacing <=> root.terminal-line-spacing;
            // (#close-behavior) 设置 › 窗口 的「关闭按钮行为」双向绑定。
            close-behavior <=> root.close-behavior;
            set-close-behavior(v) => { root.set-close-behavior(v); }
            // (#storage-location) 存储位置卡转发。
            storage-current: root.storage-current;
            storage-default: root.storage-default;
            storage-target <=> root.storage-target;
            storage-status <=> root.storage-status;
            storage-status-error <=> root.storage-status-error;
            storage-host-count: root.storage-host-count;
            storage-quick-count: root.storage-quick-count;
            open-storage-dir() => { root.open-storage-dir(); }
            copy-storage-path() => { root.copy-storage-path(); }
            pick-storage-dir() => { root.pick-storage-dir(); }
            reset-storage-dir() => { root.reset-storage-dir(); }
            switch-storage(m) => { return root.switch-storage(m); }
            term-font-bold: root.term-font-bold;
            term-cursor-style <=> root.term-cursor-style;
            term-cursor-color-hex <=> root.term-cursor-color-hex;
            term-cursor-color: root.term-cursor-color;
            output-highlight-enabled <=> root.output-highlight-enabled;
            json-format-output <=> root.json-format-output;
            output-highlight-preset <=> root.output-highlight-preset;
            output-highlight-rules: root.output-highlight-rules;
            output-highlight-rule-status <=> root.output-highlight-rule-status;
            ui-scale: root.ui-scale;
            sftp-follow-cd <=> root.sftp-follow-cd;
            collapse-sidebar-default <=> root.collapse-sidebar-default;
            collapse-sftp-default <=> root.collapse-sftp-default;
            sync-upload-enabled <=> root.sync-upload-enabled;
            webdav-enabled <=> root.webdav-enabled;
            webdav-url <=> root.webdav-url;
            webdav-username <=> root.webdav-username;
            webdav-password <=> root.webdav-password;
            webdav-remote-path <=> root.webdav-remote-path;
            webdav-accept-invalid-certs <=> root.webdav-accept-invalid-certs;
            webdav-status <=> root.webdav-status;
            download-always-ask <=> root.download-always-ask;
            paste-confirm-enabled <=> root.paste-confirm-enabled;
            extra-paste-shortcuts-enabled <=> root.extra-paste-shortcuts-enabled;
            zen-mode <=> root.zen-mode;
            welcome-as-sidebar <=> root.welcome-as-sidebar;
            quick-commands-as-sidebar <=> root.quick-commands-as-sidebar;
            mcp-enabled <=> root.mcp-enabled;
            mcp-use-saved-credentials <=> root.mcp-use-saved-credentials;
            mcp-allow-commands <=> root.mcp-allow-commands;
            mcp-allow-file-transfers <=> root.mcp-allow-file-transfers;
            wallpaper-overlay <=> root.wallpaper-overlay;
            current-wallpaper: root.current-wallpaper;
            custom-wallpaper-name: root.custom-wallpaper-name;
            wsl-profiles: root.wsl-profiles;
            wsl-new-directory <=> root.wsl-new-directory;
            set-wallpaper(v) => { root.set-wallpaper(v); }
            pick-wallpaper-file() => { root.pick-wallpaper-file(); }
            set-term-font(v) => { root.set-term-font(v); }
            set-term-font-size(v) => { root.set-term-font-size(v); }
            set-terminal-line-spacing(v) => { root.set-terminal-line-spacing(v); }
            set-term-font-bold(v) => { root.set-term-font-bold(v); }
            set-term-cursor-style(v) => { root.set-term-cursor-style(v); }
            set-term-cursor-color(v) => { root.set-term-cursor-color(v) }
            set-output-highlight(enabled, preset) => {
                root.set-output-highlight(enabled, preset);
            }
            set-json-format-output(enabled) => { root.set-json-format-output(enabled); }
            add-output-highlight-rule(pattern, regex, case-sensitive, whole-line, color) => {
                root.add-output-highlight-rule(
                    pattern, regex, case-sensitive, whole-line, color)
            }
            remove-output-highlight-rule(index) => {
                root.remove-output-highlight-rule(index);
            }
            set-output-highlight-rule-enabled(index, enabled) => {
                root.set-output-highlight-rule-enabled(index, enabled);
            }
            set-ui-scale(v) => { root.set-ui-scale(v); }
            set-panel-font(v) => { root.set-panel-font(v); }
            set-renderer-mode(v) => { root.set-renderer-mode(v); }
            set-sftp-follow-cd(v) => { root.set-sftp-follow-cd(v); }
            set-collapse-sidebar-default(v) => { root.set-collapse-sidebar-default(v); }
            set-collapse-sftp-default(v) => { root.set-collapse-sftp-default(v); }
            set-sync-upload-enabled(v) => { root.set-sync-upload-enabled(v); }
            save-webdav-settings(enabled, url, username, password, remote-path, accept-invalid-certs) => {
                root.save-webdav-settings(enabled, url, username, password, remote-path, accept-invalid-certs);
            }
            webdav-upload => { root.webdav-upload(); }
            webdav-download => { root.webdav-download(); }
            set-download-always-ask(v) => { root.set-download-always-ask(v); }
            set-paste-confirm-enabled(v) => { root.set-paste-confirm-enabled(v); }
            set-extra-paste-shortcuts-enabled(v) => { root.set-extra-paste-shortcuts-enabled(v); }
            set-zen-mode(v) => { root.set-zen-mode(v); }
            set-welcome-as-sidebar(v) => { root.set-welcome-as-sidebar(v); }
            set-quick-commands-as-sidebar(v) => {
                root.quick-commands-as-sidebar = v;
                if (!v) {
                    root.quick-panel-open = false;
                    root.quick-panel-collapsed = false;
                }
                root.set-quick-commands-as-sidebar(v);
            }
            set-mcp-permissions(enabled, credentials, commands, files) => {
                root.set-mcp-permissions(enabled, credentials, commands, files);
            }
            add-wsl-profile(name, distribution, directory) => { root.add-wsl-profile(name, distribution, directory); }
            remove-wsl-profile(id) => { root.remove-wsl-profile(id); }
            pick-wsl-directory => { root.pick-wsl-directory(); }
            persist-wallpaper-overlay(v) => { root.persist-wallpaper-overlay(v); }
        }
    }

    // --- Bottom-right resize grip (frameless platforms) -------------------
    // #main-resize-grip: mirrors ProcWindow's grip so the main window has the
    // same visual affordance + drag-resize behavior when the OS title bar is
    // hidden (custom-titlebar mode). Only rendered in frameless mode; otherwise
    // the OS frame already provides this corner.
    // (#self-drawn-resize 2026-09-20) 改自绘 resize(dir=6 SE),拖动中 UI 实时
    // 跟手;最大化下不响应(与边缘热区一致)。
    if root.custom-titlebar && !root.window-maximized : Rectangle {
        width: 16px;
        height: 16px;
        x: root.width - self.width;
        y: root.height - self.height;
        TouchArea {
            mouse-cursor: nwse-resize;
            pointer-event(e) => {
                if (e.kind == PointerEventKind.down && e.button == PointerEventButton.left) {
                    root.win-resize-begin(6,
                        self.absolute-position.x + self.mouse-x,
                        self.absolute-position.y + self.mouse-y);
                }
            }
            moved => {
                root.win-resize-move(self.absolute-position.x + self.mouse-x,
                                     self.absolute-position.y + self.mouse-y);
            }
        }
        Icon { glyph: "resize-se"; tint: Theme.text-muted; size: 16px; }   // (#icon-svg-migration) 单一事实源 = assets/icons/resize-se.svg
    }
    // (#theme-split v2) 主题下拉浮层：AppWindow 根层自绘（ChainPicker 模式
    // ——不用 PopupWindow：独立作用域里定位与外部回调都绕）。悬停行实时预览
    // 主界面（终端/面板/强调色全部即时换装，不落盘），点击行确认，吞层点击
    // 关闭并恢复当前主题。
    // (#theme-split v3) 主题下拉浮层：宽度与触发按钮一致(240px)、顶部搜索
    // 框（稿内 tpk-search）、行色块=该套**强调色**（panel 底色白/黑不可辨）。
    // 悬停行=主界面实时预览，点击=确认，点浮层外=关闭并恢复当前主题。
    if root.theme-pick-open : Rectangle {
        // (#theme-empty-h 2026-10-08) 无结果态下 preferred-height 只算到
        // 占位条的一小截，浮层被压得比占位文字还矮（用户截图：提示被底边
        // 裁掉）——钳一个能完整放下「搜索行 + 动作行 + 占位提示」的最小高度。
        //（#theme-dedupe §5 修正：高度 = 列表内容 + 固定镶边。镶边 = 上内衬 6 +
        // 搜索行 30 + 间距 4 + 动作行 24 + 间距 4 + 间距 4 + 底栏 29 + 下内衬 6
        // = 107；另留 10 松弛。旧式「内容 + 10」漏掉顶部两行，离屏探针实测浮层
        // 被压到只露出一行。上限 459 = 镶边 107 + mock 的 .lst max-height 342。）
        property <length> list-h: max(min(459px, pick-lay.preferred-height + 117px), 180px);
        width: parent.width;
        height: parent.height;
        TouchArea { clicked => { root.theme-pick-open = false; root.theme-pick-search = ""; root.theme-search-filter(""); root.preview-theme(root.theme-chosen); } }
        Rectangle {
            x: min(max(8px, root.theme-pick-x), parent.width - self.width - 12px);
            y: min(root.theme-pick-y, parent.height - self.height - 12px);
            // (#theme-dedupe §5) 240 → 360px：行内新增 3 色阶条 + ANSI 八色带 +
            // 星标区（预留 70px 文案位）；360 保证最长名（Solarized · 亮）与选中
            // 行（多一个 ✓）都不截断。圆角 9 → 11（mock .pop）。
            width: 360px;
            height: parent.list-h;
            border-radius: 11px;
            background: Theme.popup-bg;
            border-width: 1px; border-color: Theme.border-strong;
            drop-shadow-blur: 16px; drop-shadow-color: #00000060;
            clip: true;
            // (#theme-dedupe §5 键盘) ↑↓ 移动 / Enter 确认 / Esc 还原 / Tab 直达强调色。
            // forward-focus 把焦点交给搜索框：开浮层即可直接输入；键事件在本域兜底。
            FocusScope {
                forward-focus: theme-input;
                key-pressed(event) => {
                    if (event.text == Key.UpArrow) {
                        root.theme-key-idx = root.theme-key-move(root.theme-key-idx, -1);
                        return accept;
                    }
                    if (event.text == Key.DownArrow) {
                        root.theme-key-idx = root.theme-key-move(root.theme-key-idx, 1);
                        return accept;
                    }
                    if (event.text == Key.Return) {
                        if (root.theme-key-idx >= 0 && root.theme-key-idx < root.theme-entries.length) {
                            root.set-theme(root.theme-entries[root.theme-key-idx].id);
                            root.theme-pick-open = false;
                            root.theme-pick-search = "";
                            root.theme-search-filter("");
                        }
                        return accept;
                    }
                    if (event.text == Key.Escape) {
                        root.theme-pick-open = false;
                        root.theme-pick-search = "";
                        root.theme-search-filter("");
                        root.preview-theme(root.theme-chosen);
                        return accept;
                    }
                    if (event.text == Key.Tab) {
                        // Tab 直达强调色：关浮层 → 打开设置·主题页 + 强调色弹框
                        root.theme-pick-open = false;
                        root.theme-pick-search = "";
                        root.theme-search-filter("");
                        root.preview-theme(root.theme-chosen);
                        root.interface-open = true;
                        root.ifd-page = "theme";
                        root.accent-stage = root.accent-guard.eff;
                        root.accent-pop-open = true;
                        return accept;
                    }
                    return reject;
                }
                VerticalLayout {
                    padding: 6px;
                    spacing: 4px;
                    // 搜索行（高保真 §5 定稿的 sear）：**扁平行**（无输入框底/边框）
                    // + 底部细线 + 右端套数（accent）。匹配 中文名 / id / 色相名
                    // （Rust 过滤）。占位文案同步改「搜索主题 / 色相 / 名称…」。
                    Rectangle {
                        height: 30px;
                        background: transparent;
                        theme-input := TextInput {
                            x: 11px;
                            // 右端计数（「28 套」）的固定让位：约 54px
                            width: parent.width - 22px - 54px;
                            text <=> root.theme-pick-search;
                            // 输入即过滤：Rust 重发过滤后的 entries（含组头处理）
                            changed text => { root.theme-search-filter(self.text); }
                            font-size: 11.5px;
                            color: Theme.text-primary;
                            vertical-alignment: center;
                            single-line: true;
                        }
                        if root.theme-pick-search == "" : Text {
                            x: 11px;
                            text: root.lang-en ? "Search theme / hue / name…" : "搜索主题 / 色相 / 名称…";
                            color: Theme.text-muted; font-size: 11.5px;
                            vertical-alignment: center;
                            // 占位文字不挡输入
                            TouchArea { enabled: false; }
                        }
                        // 右端目录总数（高保真 mock：accent 小字「28 套」）
                        Text {
                            x: parent.width - 11px - self.width;
                            text: root.theme-total + (root.lang-en ? " themes" : " 套");
                            color: Theme.accent-solid; font-size: 11.5px;
                            vertical-alignment: center;
                        }
                        // 底部分隔线（mock .sear 的 border-bottom: 1px solid --line）
                        Rectangle {
                            y: parent.height - 1px;
                            width: 100%; height: 1px;
                            background: Theme.border-control;
                        }
                    }
                    // (#theme-dedupe §5) 顶部常驻动作行：跟随系统 / 反向（亮↔暗）
                    HorizontalLayout {
                        spacing: 6px;
                        // 跟随系统（当前跟随态高亮；点击 = 回到跟随）
                        Rectangle {
                            height: 24px;
                            horizontal-stretch: 1;
                            border-radius: 6px;
                            background: root.follow-system ? Theme.accent.with-alpha(0.15) : Theme.bg-panel-alt;
                            border-width: 1px;
                            border-color: root.follow-system ? transparent : Theme.border-control;
                            Text {
                                text: root.lang-en ? "Follow system" : "跟随系统";
                                color: root.follow-system ? Theme.accent-solid : Theme.text-primary;
                                font-size: 11px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.set-follow-system(true);
                                    root.theme-pick-open = false;
                                    root.theme-pick-search = "";
                                    root.theme-search-filter("");
                                }
                            }
                        }
                        // 反向（亮↔暗）：切到当前套的明暗配对档（落盘生效）
                        Rectangle {
                            height: 24px;
                            horizontal-stretch: 1;
                            border-radius: 6px;
                            background: Theme.bg-panel-alt;
                            border-width: 1px;
                            border-color: Theme.border-control;
                            Text {
                                text: root.lang-en ? "Invert light/dark" : "反向（亮↔暗）";
                                color: Theme.text-primary;
                                font-size: 11px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    root.invert-theme();
                                    root.theme-pick-open = false;
                                    root.theme-pick-search = "";
                                    root.theme-search-filter("");
                                }
                            }
                        }
                    }
                    Flickable {
                        // (#theme-dedupe §5 修正) 扣减 = 固定镶边 107（上内衬 6 +
                        // 搜索行 30 + 间距 4 + 动作行 24 + 间距 4 + 间距 4 + 底栏 29
                        // + 下内衬 6）。旧式「- 32 - 28」是搜索框还在 28px 时代的残留，
                        // 动作行加入后少扣 14px，列表底部被裁。
                        height: parent.height - 107px;
                    content-height: pick-lay.preferred-height;
                    pick-lay := VerticalLayout {
                        spacing: 1px; alignment: start;
                        // 带索引的 for：索引供键盘游标高亮用
                        for e[i] in root.theme-entries : row-rect := Rectangle {
                            height: e.kind == "header" ? 21px : 28px;
                            // (#theme-hover-bg 2026-10-08) 滑动选中背景：鼠标
                            // 悬浮哪行哪行亮，高亮块随指针在行间"滑动"；选中
                            // 行的 ✓ 与强调色文字不变。高亮色用 (#menu-hover)
                            // —— bg-hover 底色是写死的深灰，浅色主题下几乎
                            // 看不见（用户反馈）。
                            // （#theme-dedupe §5 键盘）↑↓ 游标行同用该高亮。
                            // 组头行 = 高保真 mock 的 hd8：更深的色带（.darker）。
                            property <bool> row-hover: false;
                            background: e.kind == "header"
                                ? Theme.popup-bg.darker(0.15)
                                : ((row-rect.row-hover || i == root.theme-key-idx)
                                   ? Theme.bg-hover : transparent);
                            border-radius: 6px;
                            // 搜索过滤：组头仅在无搜索词时显示；行按 zh/id 匹配
                            visible: e.kind == "header"
                                ? root.theme-pick-search == ""
                                : (root.theme-pick-search == ""
                                   || e.matched);   // Rust 在过滤重发时写好的行级标记
                            HorizontalLayout {
                                padding-left: 11px;
                                padding-right: 11px;
                                spacing: 9px; alignment: start;
                                // 交叉轴居中（Slint 1.18）：默认 stretch 下固定尺寸
                                // 子项（色点 11 / 色阶条 15 / 八色带 8）会退化贴顶
                                // —— 必须显式 center，行内才与文字同一中线。
                                cross-axis-alignment: center;
                                // 组头左右结构（mock hd8）：左标签（mono 半粗 +
                                // 字距）+ 弹性 + 右端计数。
                                if e.kind == "header" : Text {
                                    text: e.zh;
                                    color: Theme.text-muted;
                                    font-size: 9.5px; font-weight: 600; letter-spacing: 0.8px;
                                    vertical-alignment: center;
                                }
                                if e.kind == "header" : Rectangle { horizontal-stretch: 1; }
                                if e.kind == "header" && e.mode != "" : Text {
                                    text: e.mode;
                                    color: Theme.text-muted;
                                    font-size: 9.5px; font-weight: 500;
                                    vertical-alignment: center;
                                }
                                // 行色点 = 该套**强调色**（#theme-dedupe §5：改圆形 11px，
                                // 高保真 mock 同款 —— 强调色一眼可辨）
                                if e.kind != "header" : Rectangle {
                                    width: 11px; height: 11px; border-radius: 5.5px;
                                    background: e.ac;
                                }
                                if e.kind != "header" : Text {
                                    text: e.zh + " · " + e.mode;
                                    color: e.id == root.theme-chosen ? Theme.accent-solid : Theme.text-primary;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                                // (#theme-dedupe §5) 3 色阶条 root→panel→tbg（mock 的 n3：
                                // 7×13 ×3 + 1.5 间距 + 棋盘衬底 + 内描边）。棋盘衬底是
                                // mock 的手法（repeating-conic-gradient）——让近黑/近白档
                                // 的色块在任何主题下都可辨；这里以 4.8×4.34 小格近似。
                                if e.kind != "header" : Rectangle {
                                    width: 26px; height: 15px;
                                    border-radius: 2.5px;
                                    // 棋盘衬底（15 格 = 5×3，交错两色；Slint 无 % 运算符，
                                    // 用 Math.mod）。三条循环对应棋盘的三行。
                                    for k in [0, 1, 2, 3, 4] : Rectangle {
                                        x: k * 4.8px; y: 0px;
                                        width: 4.8px; height: 4.34px;
                                        background: Math.mod(k, 2) == 0 ? #343841 : #1e2128;
                                    }
                                    for k in [0, 1, 2, 3, 4] : Rectangle {
                                        x: k * 4.8px; y: 4.34px;
                                        width: 4.8px; height: 4.34px;
                                        background: Math.mod(k, 2) == 0 ? #1e2128 : #343841;
                                    }
                                    for k in [0, 1, 2, 3, 4] : Rectangle {
                                        x: k * 4.8px; y: 8.68px;
                                        width: 4.8px; height: 4.34px;
                                        background: Math.mod(k, 2) == 0 ? #343841 : #1e2128;
                                    }
                                    Rectangle {
                                        x: 1px; y: 1px;
                                        HorizontalLayout {
                                            spacing: 1.5px;
                                            Rectangle { width: 7px; height: 13px; border-radius: 1.5px; background: e.root; }
                                            Rectangle { width: 7px; height: 13px; border-radius: 1.5px; background: e.panel; }
                                            Rectangle { width: 7px; height: 13px; border-radius: 1.5px; background: e.tbg; }
                                        }
                                    }
                                    // 内描边（mock box-shadow: inset 0 0 0 1px rgba(255,255,255,.14)）
                                    Rectangle {
                                        width: 100%; height: 100%;
                                        border-radius: 2.5px;
                                        border-width: 1px; border-color: #ffffff24;
                                    }
                                }
                                Rectangle { horizontal-stretch: 1; }
                                // (#theme-dedupe §5) ANSI 八色带（槽 1/2/3/4/5/6/9/14）；
                                // 悬停时淡出让位给「设为常用」（同一位置两个操作不打架）
                                if e.kind != "header" : Rectangle {
                                    width: 75px; height: 8px;
                                    // 悬停淡出（mock .n8.hideOnFav → .15）；常态
                                    // 满不透明（mock 的 .n8 无 opacity —— 0.9 是
                                    // 旧值，离屏探针实测八色带整体被压暗一档）。
                                    opacity: row-rect.row-hover ? 0.15 : 1;
                                    animate opacity { duration: 120ms; }
                                    HorizontalLayout {
                                        spacing: 1.5px;
                                        cross-axis-alignment: center;
                                        for c in e.ansi-eight : Rectangle {
                                            width: 8px; height: 6px; border-radius: 1px;
                                            background: c;
                                        }
                                    }
                                }
                                if e.kind != "header" && e.id == root.theme-chosen : Text {
                                    text: "✓"; color: Theme.accent-solid; font-size: 10px;
                                    vertical-alignment: center;
                                }
                                // (#theme-dedupe §5) 星标区（mock 的 fav）：11px 星形
                                // + 5 间距 + 11px 文案位。星形用 mock 的同一段 SVG
                                // 路径（Slint Path，16 视图盒缩到 11px）——实心 =
                                // 已收藏（warning）、描边 = 未收藏（accent）。
                                // 文案位常驻（opacity 切换而非元素增删），悬停时
                                // 不产生位移；整区预留 70px = 10 左余 + 11 星 +
                                // 5 间距 + 44 文案。
                                if e.kind != "header" : Rectangle {
                                    width: 70px; height: parent.height;
                                    opacity: row-rect.row-hover ? 1 : (e.faved ? 0.5 : 0);
                                    animate opacity { duration: 120ms; }
                                    HorizontalLayout {
                                        alignment: end; spacing: 5px;
                                        cross-axis-alignment: center;
                                        if e.faved : Path {
                                            width: 11px; height: 11px;
                                            viewbox-width: 16; viewbox-height: 16;
                                            fill: Theme.warning;
                                            commands: "M8 1.6l1.9 3.9 4.3.6-3.1 3 .7 4.3L8 11.4l-3.8 2 .7-4.3-3.1-3 4.3-.6z";
                                        }
                                        if !e.faved : Path {
                                            width: 11px; height: 11px;
                                            viewbox-width: 16; viewbox-height: 16;
                                            fill: transparent;
                                            stroke: Theme.accent-solid;
                                            stroke-width: 1px;
                                            commands: "M8 1.6l1.9 3.9 4.3.6-3.1 3 .7 4.3L8 11.4l-3.8 2 .7-4.3-3.1-3 4.3-.6z";
                                        }
                                        Text {
                                            text: e.faved
                                                ? (root.lang-en ? "Unpin" : "移出常用")
                                                : (root.lang-en ? "Pin" : "设为常用");
                                            color: e.faved ? Theme.warning : Theme.accent-solid;
                                            font-size: 11px; font-weight: 600;
                                            vertical-alignment: center;
                                            opacity: row-rect.row-hover ? 1 : 0;
                                            animate opacity { duration: 120ms; }
                                        }
                                    }
                                }
                            }
                            if e.kind != "header" : row-hit := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    // (#theme-dedupe §5) 行右端星标区点击 = 收藏增删
                                    //（判定宽 80px ≈ 星标区 70 + 行距 9 + 边距），
                                    // 其余位置 = 选中主题（原行为）。
                                    if (self.mouse-x > row-rect.width - 80px) {
                                        root.toggle-favorite-theme(e.id);
                                    } else {
                                        root.theme-chosen = e.id;
                                        root.set-theme(e.id);
                                        root.theme-pick-open = false;
                                        root.theme-pick-search = "";
                                        root.theme-search-filter("");
                                    }
                                }
                                // (#theme-dedupe §5) 悬停预览：250ms 触发（1500ms →
                                // 250ms，高保真 §5 定稿）。预览同步终端色表（Rust
                                // 侧走完整应用路径），预览与落盘观感一致。
                                // 移出行即取消定时器并恢复当前主题。
                                row-delay := Timer {
                                    interval: 250ms;
                                    triggered => {
                                        // 复查仍悬浮（changed 初始求值会误启一次）
                                        if (row-hit.has-hover) { root.preview-theme(e.id); }
                                    }
                                }
                                changed has-hover => {
                                    row-rect.row-hover = self.has-hover;
                                    if (self.has-hover) {
                                        row-delay.restart();
                                    } else {
                                        row-delay.running = false;
                                        // 恢复当前主题（不点击就不变更；同帧
                                        // out→in 时最终值是 in 行的预览，不闪）
                                        root.preview-theme(root.theme-chosen);
                                    }
                                }
                            }
                        }
                        // (#theme-search-empty 2026-10-08) 无结果占位：搜索词非空
                        // 且没有任何可见行时显示（旧实现只留一个空搜索框，用户
                        // 反馈「搜不到就只剩搜索框」）。theme-has-match 由 Rust
                        // 过滤后回写——Slint 侧遍历模型判空代价高且时机不稳。
                        if root.theme-pick-search != "" && !root.theme-has-match : Rectangle {
                            height: 64px;
                            Text {
                                width: 100%;
                                text: root.lang-en ? "No matching themes" : "未找到匹配的主题";
                                color: Theme.text-muted; font-size: 12px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                    // ↑ pick-lay 结束；下一行收 Flickable —— 底栏是浮层 VerticalLayout
                    // 的子项（固定在底部，不随列表滚动）。
                    }
                    // (#theme-dedupe §5) 底部说明栏（mock 的 .foot）：左「悬停即预览 ·
                    // 点击即落盘」、右「常用写进 config」；11px muted + 顶部分隔线。
                    // 2026-10-15 用户确认保留（mock 的 .foot 与「现状」mock 的注解栏
                    // 成对出现，但作为常驻产品文案成立：行为提示 + 落盘位置说明）。
                    Rectangle {
                        height: 29px;
                        background: transparent;
                        Rectangle {   // 顶部分隔线（mock .foot 的 border-top）
                            y: 0; width: 100%; height: 1px;
                            background: Theme.border-control;
                        }
                        HorizontalLayout {
                            padding-left: 11px; padding-right: 11px;
                            cross-axis-alignment: center;
                            Text {
                                text: root.lang-en ? "Hover to preview · Click to apply" : "悬停即预览 · 点击即落盘";
                                color: Theme.text-muted; font-size: 11px;
                                vertical-alignment: center;
                            }
                            Rectangle { horizontal-stretch: 1; }
                            Text {
                                text: root.lang-en ? "Favorites saved in config" : "常用写进 config";
                                color: Theme.text-muted; font-size: 11px;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
            // ↑ popup 卡片结束；fav 提示叠在主题下拉浮层根矩形上（不进卡片）
            if root.fav-hint-tick > 0 : Rectangle {
                x: 8px; width: parent.width - 16px;
                y: parent.height - 26px; height: 20px;
                border-radius: 5px;
                background: Theme.popup-bg;
                border-width: 1px; border-color: Theme.border-subtle;
                Text {
                    text: root.lang-en ? "Remove one first (max 8)" : "常用已满 8 套，先移出一套";
                    color: Theme.warning; font-size: 10.5px;
                    horizontal-alignment: center; vertical-alignment: center;
                }
            }
            Timer {
                running: root.fav-hint-tick > 0;
                interval: 2600ms;
                triggered => { root.fav-hint-tick = 0; }
            }
        }
    }

    // ── (#accent-pop-v2 2026-10-13) 强调色预设弹框（定稿高保真）──────────
    // 居中于窗口、头部整行可拖动（边界钳制）。交互定稿：
    //   * 网格/最近/随机点选 = 仅选中（选定色原样保留，守卫调亮只在「应用」）；
    //   * 右上药丸 = 调亮后的真实生效色（与「应用」按钮一致）；
    //   * 左下「选定」色票 = 用户选的原色，点它开调色盘（调色盘从它起调）；
    //   * 「应用」= fit_contrast 后生效（唯一生效点）；空白/取消/✕/Esc = 还原。
    // 只在设置卡开着且停在主题页时渲染，切页/关卡自动收起。
    if root.interface-open && root.ifd-page == "theme" && root.accent-pop-open : Rectangle {
        // (#cur-seam 2026-10-15) 两道修一起上，缺一不可：
        // ① 卡片高度/落位过 snap-to-device：preferred-height 是内容累加出的
        //    小数逻辑高度，卡片框本身先要落在设备网格上（与设置卡 ifd-x/y、
        //    主窗口 #win-edge-frame-r5 同范式）；
        // ② cur-card 边框与 well/分割线/hint 的纵向内缩全改 hairline：1px 逻辑
        //    在 125% 下是 1.25 物理，well 底边与边框顶边这个公共值永远带 .25
        //    小数，填充与描边两条渲染路径取整不一致时中间空出一行卡片底色，
        //    即「选定」按钮底边那道缝（用户截图实测 x=160 列：y59 色块末行 /
        //    y60 卡片底色 / y61 卡片底边框）。改 1 物理像素后纵向边界全整数。
        property <length> pop-h: Theme.snap-to-device(
            min(root.height - 16px, accent-pop-lay.preferred-height));
        width: parent.width;
        height: parent.height;
        background: #080A0E3E;   // 轻遮罩：点空白 = 还原并关闭
        TouchArea {
            clicked => {
                root.accent-stage = root.accent-guard.eff;
                root.accent-pop-open = false;
            }
        }
        pop := Rectangle {
            width: 656px;
            height: parent.pop-h;
            x: clamp(Theme.snap-to-device(root.ifd-x + (root.ifd-w - self.width) / 2),
                8px, max(8px, parent.width - self.width - 12px));
            y: clamp(Theme.snap-to-device((parent.height - self.height) / 2),
                8px, max(8px, parent.height - self.height - 12px));
            background: Theme.popup-bg;
            border-radius: 12px;
            border-width: 1px;
            border-color: Theme.border-strong;
            drop-shadow-blur: 24px;
            drop-shadow-color: #000000a0;
            // 卡片留白吞层（点 padding 不落到遮罩）；空白区也可拖动卡片
            card-ta := TouchArea {
                clicked => {}
                pointer-event(ev) => {
                    if (ev.kind == PointerEventKind.down) {
                        pop.dragging = true;
                        pop.drag-ox = pop.x;
                        pop.drag-oy = pop.y;
                        pop.drag-cx = card-ta.absolute-position.x + card-ta.mouse-x;
                        pop.drag-cy = card-ta.absolute-position.y + card-ta.mouse-y;
                    } else if (ev.kind == PointerEventKind.up) {
                        pop.dragging = false;
                    }
                }
                moved => {
                    // (#cur-seam) 拖动落点同样走设备网格，与设置卡拖动同款
                    pop.x = Theme.snap-to-device(Math.max(8px, Math.min(
                        pop.drag-ox + (card-ta.absolute-position.x + card-ta.mouse-x - pop.drag-cx),
                        Math.max(8px, root.width - pop.width - 8px))));
                    pop.y = Theme.snap-to-device(Math.max(8px, Math.min(
                        pop.drag-oy + (card-ta.absolute-position.y + card-ta.mouse-y - pop.drag-cy),
                        Math.max(8px, root.height - pop.height - 8px))));
                }
            }
            property <string> fitted: PickerMath.fit-hex(root.accent-stage);
            property <bool> warn: self.fitted != root.accent-stage;
            property <bool> dirty: root.accent-stage != root.accent-guard.eff;
            property <length> drag-ox;
            property <length> drag-oy;
            property <length> drag-cx;   // 按下时指针的窗口绝对坐标（拖动期间稳定）
            property <length> drag-cy;
            property <bool> dragging: false;
            accent-pop-lay := VerticalLayout {
                padding-top: 14px;
                padding-bottom: 14px;
                padding-left: 16px;
                padding-right: 16px;
                spacing: 10px;
                // ── 副标题行：说明文字 + 色号色块（悬停显示信息卡）────────────
                // 三态各一行（互斥）：警示 / 已选未生效 / 中性提示。
                if pop.warn : HorizontalLayout {
                    spacing: 4px;
                    // (#swatch-parity 2026-10-14) 交叉轴居中：默认的
                    // cross-axis-alignment:stretch 下，设了固定高的色块无法撑满
                    // 行高，退化成顶部对齐（比同行的 11px 文字中心偏上 3px）。
                    cross-axis-alignment: center;
                    Text {
                        height: 20px;
                        horizontal-stretch: 0;
                        vertical-alignment: center;
                        text: root.lang-en ? "Selected" : "已选择";
                        color: Theme.warning;
                        font-size: 11px;
                    }
                    InfoSwatch { hex: root.accent-stage; card-below: false; }
                    Text {
                        height: 20px;
                        horizontal-stretch: 0;
                        vertical-alignment: center;
                        text: root.lang-en
                            ? "not applied — below 3:1 on the panel; applying lightens to"
                            : "（未生效）—— 对面板对比度不足 3:1，应用时将自动调亮为";
                        color: Theme.warning;
                        font-size: 11px;
                    }
                    InfoSwatch { hex: pop.fitted; card-below: false; }
                    Text {
                        height: 20px;
                        horizontal-stretch: 0;
                        vertical-alignment: center;
                        text: root.lang-en ? ". Apply takes effect; Cancel / ✕ / blank reverts."
                            : "；点「应用」生效，取消 / 关闭还原。";
                        color: Theme.warning;
                        font-size: 11px;
                    }
                    // (#accent-pop-flow 2026-10-14) 尾部吸空块。无 stretch 子项时
                    // Slint 把多余宽**均摊给"可生长"的子项**(Text 的 max=∞ 可生长,
                    // 定宽色块 max=宽 不可生长)——于是每段文字框各被撑宽一段,色块
                    // 被推离文字(用户截图①:色块孤零零悬在行中偏右)。补一块
                    // stretch=1 的吸空块后,余量只归它,整行从左侧自然排下来,
                    // 色块紧贴前一段文字的末尾。
                    Rectangle { horizontal-stretch: 1; }
                }
                if !pop.warn && pop.dirty : HorizontalLayout {
                    spacing: 4px;
                    cross-axis-alignment: center;   // (#swatch-parity) 同「警示」行：色块/文字垂直居中
                    Text {
                        height: 20px;
                        horizontal-stretch: 0;
                        vertical-alignment: center;
                        text: root.lang-en ? "Selected" : "已选择";
                        color: Theme.text-muted;
                        font-size: 11px;
                    }
                    InfoSwatch { hex: root.accent-stage; card-below: false; }
                    Text {
                        height: 20px;
                        horizontal-stretch: 0;
                        vertical-alignment: center;
                        text: root.lang-en
                            ? "(not applied). Apply takes effect; Cancel / ✕ / blank reverts."
                            : "（未生效）；点「应用」生效，取消 / 关闭还原。";
                        color: Theme.text-muted;
                        font-size: 11px;
                    }
                    // (#accent-pop-flow) 同「警示」行:尾部吸空,整行左贴、色块贴文字。
                    Rectangle { horizontal-stretch: 1; }
                }
                if !pop.warn && !pop.dirty : HorizontalLayout {
                    spacing: 4px;
                    cross-axis-alignment: center;   // (#swatch-parity) 同「警示」行：色块/文字垂直居中
                    Text {
                        height: 20px;
                        horizontal-stretch: 0;
                        vertical-alignment: center;
                        text: root.lang-en
                            ? "Pick a swatch to select; Apply takes effect. Cancel / ✕ / blank reverts to"
                            : "点选色块仅选中；「应用」后生效，取消 / 关闭还原当前色";
                        color: Theme.text-muted;
                        font-size: 11px;
                    }
                    InfoSwatch { hex: root.accent-guard.eff; card-below: false; }
                    Text {
                        height: 20px;
                        horizontal-stretch: 0;
                        vertical-alignment: center;
                        text: ".";
                        color: Theme.text-muted;
                        font-size: 11px;
                    }
                    // (#accent-pop-flow) 尾部吸空:本行是「…还原当前色【色块】。」
                    // 的句子,色块必须紧贴"当前色"三个字,不能被均摊的余量推开。
                    Rectangle { horizontal-stretch: 1; }
                }
                // ── 最近使用（点选 = 仅选中；空时回落显示当前生效色）────────
                HorizontalLayout {
                    spacing: 6px;
                    cross-axis-alignment: center;   // (#swatch-parity) 与副标题行同款：色块与 11px 文字垂直居中
                    Text {
                        text: root.lang-en ? "Recent" : "最近";
                        color: Theme.text-muted;
                        font-size: 11px;
                        vertical-alignment: center;
                        horizontal-stretch: 0;
                    }
                    for r in (root.accent-recent.length > 0 ? root.accent-recent : [root.accent-guard.eff]) : Rectangle {
                        // (#swatch-size-match 2026-10-15) 20px → 14px、圆角 6→4：
                        // 与「主题」下拉选择框里的色块同规格（14×14 / 圆角 4，截图
                        // 实测），也与副标题行的 InfoSwatch 同批改——两处必须一致，
                        // 否则又回到「第一行/第二行色块不等大」（用户第三轮反馈）。
                        width: 14px;
                        height: 14px;
                        border-radius: 4px;
                        background: root.accent-hex-color(r);
                        border-width: r-ta.has-hover ? 2px : 1px;
                        border-color: r-ta.has-hover ? root.accent-ink-on(r).with-alpha(0.72) : #ffffff26;
                        drop-shadow-blur: r-ta.has-hover ? 10px : 0px;
                        drop-shadow-color: #00000066;
                        animate drop-shadow-blur { duration: 100ms; }
                        Rectangle {
                            border-radius: 4px;
                            background: #ffffff;
                            opacity: r-ta.has-hover ? 0.10 : 0;
                        }
                        // 悬浮信息卡：与副标题行色块的卡**同一组件**
                        // （#color-info-card 2026-10-14 用户要求「用上面的同款」：
                        // 同尺寸、同字号、同字色 —— 此前本处另抄了一份、首行放大到
                        // 12px 且 RGB/HSV/HSL 用 text-secondary，两处灰白不一）。
                        // 色卡未 clip，允许卡片向上越界浮出。
                        ColorInfoCard {
                            hex: r;
                            x: (parent.width - self.width) / 2 - 8px;
                            y: -(self.height + 7px);
                            visible: r-ta.has-hover;
                        }
                        r-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.accent-stage = r; }
                        }
                    }
                    // (#accent-pop-flow 2026-10-14) 尾部吸空:不加这块时,本行唯一
                    // "可生长"的子项是「最近」文字框,余量全灌给它 → 色块被顶到行尾
                    // (用户截图②:最近行色块贴在弹框最右侧)。加块后余量归它,
                    // 「最近」之后紧接着就是最近使用色块,与网格左缘同一列起排。
                    Rectangle { horizontal-stretch: 1; }
                }
                // ── 47 预设网格：按色相重排，8 列，名称 + 色号（点选仅选中）──
                GridLayout {
                    spacing: 6px;
                    for p[i] in [
                        { n: "番茄色", h: "#F44333" }, { n: "植物红", h: "#B71C1C" }, { n: "珊瑚色", h: "#FF7F6B" }, { n: "鲑鱼色", h: "#F29E7B" },
                        { n: "橘黄色", h: "#FFA565" }, { n: "橙色", h: "#F0862C" }, { n: "琥珀橙", h: "#FF9B0B" }, { n: "金色", h: "#FFC069" },
                        { n: "茶色", h: "#FFC100" }, { n: "蟹青色", h: "#FFE831" }, { n: "青柠", h: "#C8FF00" }, { n: "钢色", h: "#B9B119" },
                        { n: "苔藓色", h: "#B1C784" }, { n: "黄绿色", h: "#A5FF80" }, { n: "鲜绿色", h: "#7CB342" }, { n: "绝命毒药色", h: "#368A3F" }, { n: "微信绿", h: "#07C160" },
                        { n: "翡翠绿", h: "#29A383" }, { n: "薄荷色", h: "#95E0C1" }, { n: "绿松石色", h: "#88CBBC" }, { n: "海蓝宝石色", h: "#64FFDD" },
                        { n: "青绿色", h: "#089B8B" }, { n: "天空色", h: "#64FFFF" }, { n: "水蓝色", h: "#5CCFE6" }, { n: "鲜蓝色", h: "#73D8FF" },
                        { n: "水色", h: "#42A5F5" }, { n: "品牌蓝", h: "#0969DA" }, { n: "宝蓝色", h: "#2979F5" }, { n: "霓虹色", h: "#1D49B1" },
                        { n: "靛蓝色", h: "#2F51B5" }, { n: "仿紫色", h: "#651FFF" }, { n: "夜色", h: "#676E9A" }, { n: "石板色", h: "#607D8B" },
                        { n: "海星色", h: "#546E7A" }, { n: "淡紫色", h: "#DFBFFF" }, { n: "薰衣草色", h: "#7E57C2" }, { n: "紫水晶色", h: "#AB47BC" },
                        { n: "深红色", h: "#E916B5" }, { n: "草绿粉", h: "#FF40CC" }, { n: "洋红", h: "#E1306C" }, { n: "玫瑰色", h: "#F279B9" },
                        { n: "沙色", h: "#D9AE91" }, { n: "咖啡色", h: "#795548" }, { n: "白光色", h: "#FAFAFA" }, { n: "灰色", h: "#9E9E9E" },
                        { n: "铅黑色", h: "#616161" }, { n: "碳素色", h: "#424242" }, { n: "MTerm 青", h: "#1FC8B4" },
                    ] : Rectangle {
                        row: i / 8;
                        col: Math.mod(i, 8);
                        width: 72px;
                        height: 40px;
                        border-radius: 8px;
                        background: root.accent-hex-color(p.h);
                        border-width: root.accent-stage == p.h ? 2px : p-ta.has-hover ? 2px : 1px;
                        // 悬停环 = 自适应字色 @72%：深色块白环、浅色块黑环，
                        // 半透明更柔和；选中态保持全强度以区分层级
                        border-color: root.accent-stage == p.h
                            ? root.accent-ink-on(p.h)
                            : p-ta.has-hover ? root.accent-ink-on(p.h).with-alpha(0.72) : #ffffff1a;
                        // 悬浮突起：投影 + 提亮，移出还原（高保真 hover 效果）；
                        // 不 clip —— 投影要落在色块边界外才有「浮起」感
                        drop-shadow-blur: p-ta.has-hover ? 12px : 0px;
                        drop-shadow-color: #00000066;
                        animate drop-shadow-blur { duration: 100ms; }
                        Rectangle {
                            border-radius: 8px;
                            background: #ffffff;
                            opacity: p-ta.has-hover ? 0.10 : 0;
                        }
                        VerticalLayout {
                            padding-left: 7px;
                            padding-right: 5px;
                            alignment: center;
                            Text {
                                text: p.n;
                                color: root.accent-ink-on(p.h);
                                font-size: 10px;
                                font-weight: 600;
                                overflow: elide;
                            }
                            Text {
                                text: p.h;
                                color: root.accent-ink-on(p.h);
                                opacity: 0.78;
                                font-size: 8.5px;
                                font-family: Theme.term-font-family;
                                overflow: elide;
                            }
                        }
                        p-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.accent-stage = p.h; }
                        }
                    }
                }
                // ── 页脚：顶部横线；左下「选定 | 调色盘」合并按钮；右下 随机/取消/应用
                //    控件统一 36px 高。────────────────────────────────────────
                Rectangle { height: 1px; background: #3a3d46; }
                Rectangle {
                    height: 36px;
                    // (#cur-merged 2026-10-15) 「选定色票」+「调色盘」由两个独立按钮
                    // 合成**一个**按钮，中间一条 1px 分割线（用户第 4 轮反馈）。
                    // 规格 = 定稿高保真 .mt-cur / .mt-curwell / .mt-curhint：
                    //   * 卡片：1px 边框 + 圆角 10 + overflow:hidden（此处 clip）；
                    //   * 左段 well：填**选定原色**，深色(ink-on)双行「选定 / #hex」左贴；
                    //   * 右段 hint：「调色盘 ›」12px，**不设内衬底色**——弹框通透档
                    //     alpha<1 时叠同色会二次混色反而显形（#popup-inner-fill 结论）；
                    //   * 悬停 = 整卡统一反馈：边框转选定色 + 3px 柔光外环（.mt-cur:hover）。
                    // 两段点击动作本就完全相同（都开调色盘），故整卡一个 TouchArea。
                    // 宽度：1px 边框 + well 104 + 分割线 1 + hint 88 = 194px。
                    // 柔光环先声明 = 垫在卡片下（后声明者在上）。
                    Rectangle {
                        x: -3px;
                        y: -3px;
                        width: 194px + 6px;
                        height: parent.height + 6px;
                        border-radius: 13px;
                        border-width: 3px;
                        border-color: root.accent-hex-color(root.accent-stage).with-alpha(0.14);
                        visible: cur-ta.has-hover;
                    }
                    cur-card := Rectangle {
                        x: 0;
                        width: 194px;
                        height: parent.height;
                        border-radius: 10px;
                        // (#cur-seam) 边框改 hairline（1 **设备**像素）：1px 逻辑在
                        // 125% 下是 1.25 物理，与 well 的 1px 内缩（同为 1.25）相减后
                        // 公共边界值落在物理网格外，填充与描边两条渲染路径取整不
                        // 一致时中间空出一行卡片底色（用户截图「选定」按钮底边缝）。
                        // 1 物理像素后所有纵向边界都是整数，恒相接。同范式：设置卡
                        // hairline 边框、主窗口 #win-edge-frame-r3。
                        border-width: Theme.hairline();
                        // 悬停转「选定色」= 即将应用的色，顺带把卡片和 well 缝成一色
                        border-color: cur-ta.has-hover
                            ? root.accent-hex-color(root.accent-stage) : Theme.border-strong;
                        clip: true;
                        animate border-color { duration: 120ms; }
                        // 左段 well：内缩 1 设备像素让出卡片边框（CSS 里 border 不被子元素盖住），
                        // (#cur-well-corner 2026-10-15) 左角必须跟着卡片圆角切：卡片
                        // 圆角 10px − 边框 1px = **9px 同心内圆角**。不写时粉块是直角，
                        // 与卡片圆弧之间露出一块卡片底色三角（用户第 5 轮截图①
                        // 「选定区域左侧，怎么有两个角」——直角色块 + 圆角边框弧）。
                        // (#cur-seam) 边框改 1 设备像素后同心理论值 = 10 − 0.8 = 9.2，
                        // 保留 9px：0.25 物理像素的差肉眼不可辨，改 9.2 反而引入新的
                        // 小数边界。card 的 clip 是矩形裁剪（不裁圆角），只能靠自身
                        // 圆角对齐。
                        Rectangle {
                            // (#cur-seam) 横向保持 1px 逻辑：x=1px + width=103px 在
                            // 125% 下合计恰好 130 物理，与分割线 x=104px 精确重合，
                            // 改成 hairline 反而错开 0.25。纵向单独走 hairline。
                            x: 1px;
                            y: Theme.hairline();
                            width: 103px;
                            height: parent.height - 2 * Theme.hairline();
                            border-top-left-radius: 9px;
                            border-bottom-left-radius: 9px;
                            background: root.accent-hex-color(root.accent-stage);
                            sel-lay := VerticalLayout {
                                x: 10px;
                                alignment: center;
                                Text {
                                    text: root.lang-en ? "Selected" : "选定";
                                    color: root.accent-ink-on(root.accent-stage);
                                    font-size: 9px;
                                    font-weight: 600;
                                    opacity: 0.85;
                                }
                                Text {
                                    text: root.accent-stage;
                                    color: root.accent-ink-on(root.accent-stage);
                                    font-size: 10px;
                                    font-family: Theme.term-font-family;
                                }
                            }
                        }
                        // 分割线（well / hint 之间，上下同样内缩 1 设备像素）
                        Rectangle {
                            x: 104px;
                            y: Theme.hairline();
                            width: 1px;
                            height: parent.height - 2 * Theme.hairline();
                            background: Theme.border-strong;
                        }
                        // 右段 hint：透明底 + 居中
                        Text {
                            x: 105px;
                            y: Theme.hairline();
                            width: parent.width - 105px - 1px;
                            height: parent.height - 2 * Theme.hairline();
                            text: root.lang-en ? "Palette ›" : "调色盘 ›";
                            color: cur-ta.has-hover ? Theme.text-primary : Theme.text-secondary;
                            font-size: 12px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        cur-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.accent-pick-fmt = "rgb";
                                root.accent-picker-open(root.accent-stage);
                                root.accent-pick-open = true;
                            }
                        }
                    }
                    // 右下三键（绝对定位右对齐）
                    Rectangle {
                        x: parent.width - 64px - 8px - 64px - 8px - 64px;
                        width: 64px;
                        height: parent.height;
                        border-radius: 8px;
                        background: rnd-ta.has-hover ? Theme.bg-hover : transparent;
                        border-width: 1px;
                        border-color: rnd-ta.has-hover ? Theme.text-muted : Theme.border-strong;
                        Text {
                            width: 100%;
                            height: 100%;
                            text: root.lang-en ? "Random" : "随机";
                            color: rnd-ta.has-hover ? Theme.text-primary : Theme.text-secondary;
                            font-size: 12px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        rnd-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.accent-stage = root.accent-random-hex(); }
                        }
                    }
                    Rectangle {
                        x: parent.width - 64px - 8px - 64px;
                        width: 64px;
                        height: parent.height;
                        border-radius: 8px;
                        background: pop-cancel-ta.has-hover ? Theme.bg-hover : transparent;
                        border-width: 1px;
                        border-color: pop-cancel-ta.has-hover ? Theme.text-muted : Theme.border-strong;
                        Text {
                            width: 100%;
                            height: 100%;
                            text: root.lang-en ? "Cancel" : "取消";
                            color: pop-cancel-ta.has-hover ? Theme.text-primary : Theme.text-secondary;
                            font-size: 12px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        pop-cancel-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.accent-stage = root.accent-guard.eff;
                                root.accent-pop-open = false;
                            }
                        }
                    }
                    Rectangle {
                        x: parent.width - 64px;
                        width: 64px;
                        height: parent.height;
                        border-radius: 8px;
                        background: root.accent-hex-color(pop.fitted);
                        clip: true;
                        // 悬停提亮 + 按下压暗（圆角同按钮，否则直角层会露出四个角）
                        Rectangle {
                            border-radius: 8px;
                            background: #ffffff;
                            opacity: pop-ok-ta.has-hover ? 0.12 : pop-ok-ta.pressed ? 0.22 : 0;
                        }
                        Text {
                            width: 100%;
                            height: 100%;
                            text: root.lang-en ? "Apply" : "应用";
                            color: root.accent-ink-on(pop.fitted);
                            font-size: 12px;
                            font-weight: 600;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        pop-ok-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.accent-custom = root.accent-stage;
                                root.set-accent-mode("custom", root.accent-stage);
                                root.accent-recent-push(pop.fitted);
                                root.accent-pop-open = false;
                            }
                        }
                    }
                }
            }
        }
    }

    // 调色盘：ColorPickerDialog 通用组件（ui/color_picker.slint + src/picker
    // 业务模块）。从「选定」色起调；「确认」只写回选定色，「应用」才生效；
    // 遮罩/✕/取消/Esc = 放弃调色盘内的修改。@children = 强调色示例三件套。
    if root.interface-open && root.ifd-page == "theme" && root.accent-pick-open : Rectangle {
        width: parent.width;
        height: parent.height;
        background: Theme.modal-scrim;
        TouchArea { clicked => { root.accent-pick-open = false; } }
        ColorPickerDialog {
            x: clamp(root.ifd-x + (root.ifd-w - self.width) / 2, 8px, max(8px, root.width - self.width - 12px));
            y: clamp(root.ifd-y + (root.ifd-h - self.height) / 2, 8px, max(8px, root.height - self.height - 12px));
            bounds-w: root.width;
            bounds-h: root.height;
            title: root.lang-en ? "Palette" : "调色盘";
            en: root.lang-en;
            hex <=> root.accent-pick-hex;
            fmt <=> root.accent-pick-fmt;
            wheel-mx <=> root.accent-wheel-mx;
            wheel-my <=> root.accent-wheel-my;
            val-my <=> root.accent-val-my;
            pick-v <=> root.accent-pick-v;
            sync-pos => root.sync-picker-pos();
            // (#picker-channel 2026-10-15 方案 B) HEX 行复制键 → 复用既有剪贴板
            // 回调（与命令历史「复制」同一条通路，Rust 侧 arboard 写系统剪贴板）。
            copy-requested(h) => { root.copy-text(h); }
            cancelled => { root.accent-pick-open = false; }
            confirmed => {
                root.accent-stage = root.accent-pick-hex;
                root.accent-pick-open = false;
            }
        }
    }

    // (#sync-dialog-r2 2026-10-08) 同步输入对话框宿主：**根层末尾**（z 序最上）。
    // ⚠️ 不能放进主题选择浮层内部 —— 那样只有主题选择器开着时才渲染，
    // 单独点「同步输入」永远不弹（上一版实测的 bug）。
    // (#sync-dialog-esc) 关框（Esc/✕/取消）后焦点归还活动终端，与粘贴确认卡
    // 同一机制；确定走 Rust apply，由 Rust 侧递增 terminal-focus-sequence。
    // 欢迎页无终端时 sequence 无人接手（终端侧 changed focus-sequence 只对
    // active 终端生效），把焦点还给窗口快捷键 Scope —— 与 changed
    // active-tab-id 的欢迎页兜底同一手法。
    SyncDialogHost {
        bounds-w: root.width;
        bounds-h: root.height;
        request-terminal-focus => {
            root.terminal-focus-sequence += 1;
            if (root.active-tab-id == "welcome" && root.terminals.length == 0) {
                shortcut-scope.focus();
            }
        }
    }

    // (#win-edge-frame 2026-10-10) 主窗口四边 1px 描边 + 圆角,与弹框卡片
    // (border-strong + 圆角)同一套边线语言。窗口本体是无边框不透明窗口
    // (no-frame + with_undecorated_shadow(false)),深色主题下与桌面融成
    // 一片,四边轮廓不可辨;Rust apply_window_chrome 给的 DWMWCP_ROUND
    // 圆角也因为没有边线而看不出来(用户反馈"四边缺少边线和圆角")。
    // 这里在内容最上层画一圈**不接事件**的描边(Rectangle 无 TouchArea,
    // 命中测试直接落到下面的自绘 resize 热区/内容)。
    // 圆角取 Theme.radius-win(= 8 物理像素按 device-pixel-ratio 换算回
    // 逻辑值):Win11 DWM 窗口圆角是固定 8 物理像素、不随 DPI 缩放,只有
    // 按物理值对齐,描边弧才能与 DWM 裁剪弧同心(详见 theme.slint
    // radius-win 注释)。不用 radius-lg(随 ui-scale 缩放,会跟 DWM 半径脱钩)。
    // (#win-edge-frame-r2 2026-10-10) 整圈描边向内缩 1 设备像素(hairline),
    // 半径同步减 1 保持与裁剪弧同心:描边外缘若正好压在 DWM 裁剪边界上,
    // 弧线的抗锯齿外 fringe 会被硬裁掉,细线弧在对角段覆盖率跌破可见阈值
    // —— 四个角统一断成虚点/折角(像素扫描实测:四角同在第 3、6-7 行缺
    // 弧段)。缩进后整条弧完整参与 AA。
    // (#win-edge-frame-r3 2026-10-10) 线宽同样取 hairline(1 **设备**像素):
    // 逻辑 1px 在 125% 下占 1.25 设备行,内缩不被裁剪后"1 实行 + 25% 鬼影
    // 行"整条显形,四条边看着发粗(用户截图)。整数设备行对齐的 1 设备
    // 像素线只有一条实行,锐利不糊;弧段为 1 设备像素宽的同心环带(r∈[6,7]
    // 物理px,裁剪弧 r=8),AA 完整、连续不断。缩进留出的缝隙填窗口底色,
    // 与桌面同深,不可见。
    // (#win-edge-frame-r4 2026-10-10) 四条边改画**四个"1 设备像素厚"的扁矩形**,
    // 不再用一个带 border-radius 的矩形描一圈。原因(真机像素实测):
    // r3 的"半像素内缩 + 亚像素线宽"在软件渲染器下确实只吃 1 个设备像素,但
    // **真实应用走 femtovg(GPU),同一条 0.8 逻辑px 的边被渲染成 2 个物理像素**
    // (亮度 58 + 81,合计墨量≈1.59px;四边完全一致——这就是用户看到的"边线加粗")。
    // 半像素内缩 = 让一条**边**去凑设备网格,而描边的覆盖量由渲染器自己决定,
    // 各后端不一致,靠不住了。
    // 现在把线宽与位置都放进"设备网格整数"语义:每条边厚 1 设备像素 =
    // hairline() 逻辑px,**左下角**贴设备网格,x/y 为**整数个** hairline()
    // (0 或 -1 个),于是矩形的上下/左右边界天然落在设备像素整数坐标上,
    // 不产生任何跨像素覆盖 —— 与后端无关。四者在四角互相重叠(同色,不可见);
    // 圆角交给 DWM 的 DWMWCP_ROUND 裁剪弧切,不需要自绘弧线。
    // 原 r2/r3 的注释保留在上,记录为什么走弯路:一个矩形描一圈时,弧段与直边
    // 用的是同一条描边,想同时满足"弧段不被裁剪"和"直边不糊"在亚像素下无解。
    // 最大化时系统把四角改直角、窗口贴满工作区,描边随 window-maximized
    // 隐藏;macOS 走原生装饰(custom-titlebar=false),不画。
    if root.custom-titlebar && !root.window-maximized : Rectangle {
        background: transparent;

        // ⚠️ 四条的 x/y 都取**1 个设备像素**（hairline()），不是 0：描边以路径
        // 线为中心向两侧各铺半条，贴 0 会让外侧半条被窗口边界裁掉，剩下的
        // 半条落在设备像素中间 → 反锯齿糊成 2 个物理像素。内移整 1 个设备
        // 像素后，0.8 逻辑px 的线完整落在窗口内、边界对齐设备网格。
        // (#win-edge-frame-r5 2026-10-11) 右/下两条的位置改走 snap-to-device:
        // parent.width/height 是逻辑像素,在 125%/150% 这类分数缩放下换算回
        // 物理像素会落在栅格中间,描边被摊到两个物理行(看着发粗)。对齐后
        // hairline() 的 1 个设备像素才是完整的一行。
        // (#win-edge-frame-r6 2026-10-12) 四角改**自绘弧**,不再靠 DWM 裁剪弧
        // 切直边端点。r4/r5 只画四条直边、圆角外包给 DWMWCP_ROUND 裁剪,实测
        // 四角弧段亮度只有直边的 37~75%(裁剪斜切 + AA 渐隐),且四角形态不一
        // (左下角竖线在第 6~8 行先断、弧线隔 1px 才爬起,形成肉眼可见的凹口)。
        // 现在:直边缩短到角弧切点、四角各画一段 1 设备像素宽的 90° 弧,与直边
        // 同色同宽、无缝衔接,四角形态统一、弧段连续。
        // 几何(逻辑像素):DWM 裁剪弧半径 8 物理、圆心在窗角内侧 8 物理处;主线
        // 外缘内缩 1 物理(hairline)、线宽 hairline,故弧中心线半径 = 8 - 1.5 =
        // 6.5 物理。角弧 Path 用 viewbox 8×8 表达固定坐标(1 单位 = 1 物理像素),
        // stroke-width 独立于 viewbox、取 hairline = 1 设备像素。角弧与右/下边
        // 共用 snap 后的 win-w/win-h,保证弧与直边端点精确重合。
        property <length> win-w: Theme.snap-to-device(parent.width);
        property <length> win-h: Theme.snap-to-device(parent.height);
        property <length> cr: Theme.radius-win;

        // 上边（止于角弧切点）
        Rectangle {
            x: parent.cr; y: Theme.hairline();
            width: parent.win-w - 2 * parent.cr;
            height: Theme.hairline();
            background: Theme.border-strong;
        }
        // 下边
        Rectangle {
            x: parent.cr; y: parent.win-h - 2 * Theme.hairline();
            width: parent.win-w - 2 * parent.cr;
            height: Theme.hairline();
            background: Theme.border-strong;
        }
        // 左边
        Rectangle {
            x: Theme.hairline(); y: parent.cr;
            width: Theme.hairline();
            height: parent.win-h - 2 * parent.cr;
            background: Theme.border-strong;
        }
        // 右边
        Rectangle {
            x: parent.win-w - 2 * Theme.hairline(); y: parent.cr;
            width: Theme.hairline();
            height: parent.win-h - 2 * parent.cr;
            background: Theme.border-strong;
        }
        // 左上角弧
        Path {
            x: 0; y: 0;
            width: parent.cr; height: parent.cr;
            viewbox-width: 8; viewbox-height: 8;
            stroke: Theme.border-strong;
            stroke-width: Theme.hairline();
            fill: transparent;
            clip: false;
            commands: "M 1.5 8 A 6.5 6.5 0 0 1 8 1.5";
        }
        // 右上角弧
        Path {
            x: parent.win-w - parent.cr; y: 0;
            width: parent.cr; height: parent.cr;
            viewbox-width: 8; viewbox-height: 8;
            stroke: Theme.border-strong;
            stroke-width: Theme.hairline();
            fill: transparent;
            clip: false;
            commands: "M 0 1.5 A 6.5 6.5 0 0 1 6.5 8";
        }
        // 右下角弧
        Path {
            x: parent.win-w - parent.cr; y: parent.win-h - parent.cr;
            width: parent.cr; height: parent.cr;
            viewbox-width: 8; viewbox-height: 8;
            stroke: Theme.border-strong;
            stroke-width: Theme.hairline();
            fill: transparent;
            clip: false;
            commands: "M 6.5 0 A 6.5 6.5 0 0 1 0 6.5";
        }
        // 左下角弧
        Path {
            x: 0; y: parent.win-h - parent.cr;
            width: parent.cr; height: parent.cr;
            viewbox-width: 8; viewbox-height: 8;
            stroke: Theme.border-strong;
            stroke-width: Theme.hairline();
            fill: transparent;
            clip: false;
            commands: "M 8 6.5 A 6.5 6.5 0 0 1 1.5 0";
        }
    }

}
