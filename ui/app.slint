    in-out property <string> group-dialog-color-hex;
    in-out property <color> group-dialog-color;
    callback delete-group(string /* name */);
    callback submit-group(string /* orig */, string /* name */, string /* hex */) -> string;
    // (#group-dialog-color 2026-09-14) 纯解析、**不落盘**:对话框的颜色草稿要
