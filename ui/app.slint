    callback accent-random-hex() -> string;           // 守卫后的随机强调色
    callback accent-recent-push(string);              // 最近使用去重入列（≤20）
    callback accent-picker-open(string);              // 带 hex 打开调色盘（回填 h/s/v）
    callback sync-picker-pos();                           // 数值改动后回填取样点位置
    callback set-panel-alpha(float);
    callback set-term-alpha(float);
    callback set-wallpaper-visible(float);
    callback set-popup-transparency(int);
    callback set-follow-system(bool);
    callback set-wallpaper-color-pickup(bool);
    // Session sync / broadcast input (#78 pt.4): mirror keystrokes to every
    // online session. Default off (it types into ALL sessions at once).
    in-out property <bool> sync-input: false;
    callback set-sync-input(bool);
    // Mirror SFTP uploads to other sessions while sync-input is on (#sync).
    in-out property <bool> sync-upload-enabled: false;
    callback set-sync-upload-enabled(bool);
    // (#tab-32) 频道（tab-row-idia 稿）：菜单回调与状态桥（TabBar 转发）。
