    in-out property <string> tab-card-title;
    in-out property <string> tab-card-host;
    in-out property <string> tab-card-user;
    in-out property <string> tab-card-auth;
    in-out property <string> tab-card-group;
    in-out property <string> tab-card-note;
    in-out property <string> tab-card-channel;
    in-out property <bool> tab-card-channel-paused;
    in-out property <length> tab-card-x;
    in-out property <length> tab-card-y;
    // (#chbar-tip-root 2026-10-11) 频道状态条截断提示的集中渲染槽（ChannelBar
