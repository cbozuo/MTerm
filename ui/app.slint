    // mterm 暗/亮间快速翻转。
    callback set-theme(string /* theme id */);
    callback preview-theme(string /* theme id — 悬停实时预览 */);
    callback theme-search-filter(string /* query */);   // Rust 重发过滤后的 theme-entries
    callback cycle-theme();
    // (#theme-dedupe §5) 速选面板：反向（亮↔暗 = 切当前套的明暗配对档）/
    // 「常用」增删 / 键盘 ↑↓ 行移动（返回新的行索引；Enter 落盘复用 set-theme）。
    callback invert-theme();
    callback toggle-favorite-theme(string /* theme id */);
    callback theme-key-move(int /* 当前行索引 */, int /* ±1 */) -> int;
    // 「常用」写满 8 套时的提示触发计数（UI 侧显示「先移出一套」并定时消失）
    in-out property <int> fav-hint-tick: 0;
    // 强调色三态与三滑杆/通透度的设置入口（设置「主题」页 + 速选面板用）。
    callback set-accent-mode(string /* follow|preset|custom */, string /* preset key or #hex */);
    // ── 取色盘：色块渲染回调留在 AppWindow（设置行 chip/弹框网格共用）；
