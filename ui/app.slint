// (#tab-32) 每个 pane 的频道状态条数据（Rust 计算）。
export struct ChannelBarInfo {
    visible: bool,
    letter: string,
    color: color,
    paused: bool,
    online: int,   // 频道内在线会话数（含自己；条上显示「另外 N 个」= online-1）
    total: int,    // 成员总数（含离线）
    slot: int,     // 频道槽位（关闭频道用）
}

