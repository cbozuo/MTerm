    // + 菜单项漂移）→ 改为点击 ⋮ 事件期上报请求，菜单在窗口根尾部绘制
    // （welcome 悬浮卡/主题下拉同款模式），backdrop 点击即关。
    in-out property <bool> chbar-menu-open: false;
    in-out property <ChannelMenuRequest> chbar-menu: {
        ax: 0px, ay: 0px, paused: false,
        has-pause: false, has-leave: false, has-close: false, has-hide: false,
        tab-id: "", slot: 0,
    };
    // (#tab-card 2026-10-11) tab 悬浮信息卡（左侧组内成员同款）的集中渲染槽：
