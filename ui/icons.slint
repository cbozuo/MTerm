// Central SVG icon set (#icon-svg-migration 2026-10-02).
//
// One component for every icon in the app. The artwork lives in
// assets/icons/*.svg (24-grid, 2px round-cap stroke, single color); this
// component is the only place that references those files, so adding or
// redrawing an icon never touches call sites.
//
// glyph = SVG file name without extension; tint recolors the rasterized
// strokes (Image.colorize keeps alpha); size defaults to the 16px icon-slot
// spec. The name-to-image mapping lives in ONE global pure function: the
// per-instance image constants (if-chain and ternary-chain forms) blew up
// rustc-LLVM memory, while a global function body is compiled once and
// every instance just calls it. tint, not color: Rectangle's deprecated
// color alias would shadow a property of that name.
import { Theme } from "theme.slint";

export global IconImages {
    // Resolve an icon name to its SVG. Unknown names fall back to "add".
    public pure function src(glyph: string) -> image {
        if (glyph == "add") { return @image-url("../assets/icons/add.svg"); }
        if (glyph == "arrow-down") { return @image-url("../assets/icons/arrow-down.svg"); }
        if (glyph == "arrow-left") { return @image-url("../assets/icons/arrow-left.svg"); }
        if (glyph == "arrow-right") { return @image-url("../assets/icons/arrow-right.svg"); }
        if (glyph == "arrow-up") { return @image-url("../assets/icons/arrow-up.svg"); }
        if (glyph == "bolt") { return @image-url("../assets/icons/bolt.svg"); }
        if (glyph == "check") { return @image-url("../assets/icons/check.svg"); }
        if (glyph == "checkbox") { return @image-url("../assets/icons/checkbox.svg"); }
        if (glyph == "chevron-left") { return @image-url("../assets/icons/chevron-left.svg"); }
        if (glyph == "chevron-right") { return @image-url("../assets/icons/chevron-right.svg"); }
        if (glyph == "close") { return @image-url("../assets/icons/close.svg"); }
        if (glyph == "cloud") { return @image-url("../assets/icons/cloud.svg"); }
        if (glyph == "command-bar") { return @image-url("../assets/icons/command-bar.svg"); }
        if (glyph == "command-history") { return @image-url("../assets/icons/command-history.svg"); }
        if (glyph == "computer") { return @image-url("../assets/icons/computer.svg"); }
        if (glyph == "connectivity-test") { return @image-url("../assets/icons/connectivity-test.svg"); }
        if (glyph == "copy") { return @image-url("../assets/icons/copy.svg"); }
        if (glyph == "create-new-folder") { return @image-url("../assets/icons/create-new-folder.svg"); }
        if (glyph == "cut") { return @image-url("../assets/icons/cut.svg"); }
        if (glyph == "dashboard") { return @image-url("../assets/icons/dashboard.svg"); }
        if (glyph == "delete") { return @image-url("../assets/icons/delete.svg"); }
        if (glyph == "display") { return @image-url("../assets/icons/display.svg"); }
        if (glyph == "download") { return @image-url("../assets/icons/download.svg"); }
        if (glyph == "drag-grip") { return @image-url("../assets/icons/drag-grip.svg"); }
        if (glyph == "edit") { return @image-url("../assets/icons/edit.svg"); }
        if (glyph == "error") { return @image-url("../assets/icons/error.svg"); }
        if (glyph == "expand-less") { return @image-url("../assets/icons/expand-less.svg"); }
        if (glyph == "expand-more") { return @image-url("../assets/icons/expand-more.svg"); }
        if (glyph == "file") { return @image-url("../assets/icons/file.svg"); }
        if (glyph == "folder-open") { return @image-url("../assets/icons/folder-open.svg"); }
        if (glyph == "folder") { return @image-url("../assets/icons/folder.svg"); }
        if (glyph == "fullscreen-enter") { return @image-url("../assets/icons/fullscreen-enter.svg"); }
        if (glyph == "fullscreen-exit") { return @image-url("../assets/icons/fullscreen-exit.svg"); }
        if (glyph == "home") { return @image-url("../assets/icons/home.svg"); }
        if (glyph == "info") { return @image-url("../assets/icons/info.svg"); }
        if (glyph == "input") { return @image-url("../assets/icons/input.svg"); }
        if (glyph == "keyboard") { return @image-url("../assets/icons/keyboard.svg"); }
        if (glyph == "language") { return @image-url("../assets/icons/language.svg"); }
        if (glyph == "link") { return @image-url("../assets/icons/link.svg"); }
        if (glyph == "maximize") { return @image-url("../assets/icons/maximize.svg"); }
        if (glyph == "minimize-to-tray") { return @image-url("../assets/icons/minimize-to-tray.svg"); }
        if (glyph == "moon") { return @image-url("../assets/icons/moon.svg"); }
        if (glyph == "more-vert") { return @image-url("../assets/icons/more-vert.svg"); }
        if (glyph == "move-to-group") { return @image-url("../assets/icons/move-to-group.svg"); }
        if (glyph == "new-session") { return @image-url("../assets/icons/new-session.svg"); }
        if (glyph == "no-color") { return @image-url("../assets/icons/no-color.svg"); }
        if (glyph == "notebook-pen") { return @image-url("../assets/icons/notebook-pen.svg"); }
        if (glyph == "open-in-full") { return @image-url("../assets/icons/open-in-full.svg"); }
        if (glyph == "output-highlight") { return @image-url("../assets/icons/output-highlight.svg"); }
        if (glyph == "palette") { return @image-url("../assets/icons/palette.svg"); }
        if (glyph == "paste") { return @image-url("../assets/icons/paste.svg"); }
        if (glyph == "pencil") { return @image-url("../assets/icons/pencil.svg"); }
        if (glyph == "play") { return @image-url("../assets/icons/play.svg"); }
        if (glyph == "plug") { return @image-url("../assets/icons/plug.svg"); }
        if (glyph == "quit") { return @image-url("../assets/icons/quit.svg"); }
        if (glyph == "refresh") { return @image-url("../assets/icons/refresh.svg"); }
        if (glyph == "remote-desktop") { return @image-url("../assets/icons/remote-desktop.svg"); }
        if (glyph == "remove") { return @image-url("../assets/icons/remove.svg"); }
        if (glyph == "rendering") { return @image-url("../assets/icons/rendering.svg"); }
        if (glyph == "resize-se") { return @image-url("../assets/icons/resize-se.svg"); }
        if (glyph == "restore") { return @image-url("../assets/icons/restore.svg"); }
        if (glyph == "search") { return @image-url("../assets/icons/search.svg"); }
        if (glyph == "select-all") { return @image-url("../assets/icons/select-all.svg"); }
        if (glyph == "serial-port") { return @image-url("../assets/icons/serial-port.svg"); }
        if (glyph == "session-disconnect") { return @image-url("../assets/icons/session-disconnect.svg"); }
        if (glyph == "session-reconnect") { return @image-url("../assets/icons/session-reconnect.svg"); }
        if (glyph == "settings") { return @image-url("../assets/icons/settings.svg"); }
        if (glyph == "sidebar-left-collapse") { return @image-url("../assets/icons/sidebar-left-collapse.svg"); }
        if (glyph == "sidebar-left-expand") { return @image-url("../assets/icons/sidebar-left-expand.svg"); }
        if (glyph == "sidebar-right-collapse") { return @image-url("../assets/icons/sidebar-right-collapse.svg"); }
        if (glyph == "sidebar-right-expand") { return @image-url("../assets/icons/sidebar-right-expand.svg"); }
        if (glyph == "split-horizontal") { return @image-url("../assets/icons/split-horizontal.svg"); }
        if (glyph == "split-vertical") { return @image-url("../assets/icons/split-vertical.svg"); }
        if (glyph == "sun") { return @image-url("../assets/icons/sun.svg"); }
        if (glyph == "swap-vert") { return @image-url("../assets/icons/swap-vert.svg"); }
        if (glyph == "system-update") { return @image-url("../assets/icons/system-update.svg"); }
        if (glyph == "table-rows") { return @image-url("../assets/icons/table-rows.svg"); }
        if (glyph == "terminal") { return @image-url("../assets/icons/terminal.svg"); }
        if (glyph == "tune") { return @image-url("../assets/icons/tune.svg"); }
        if (glyph == "tunnel") { return @image-url("../assets/icons/tunnel.svg"); }
        if (glyph == "unfold-less") { return @image-url("../assets/icons/unfold-less.svg"); }
        if (glyph == "unfold-more") { return @image-url("../assets/icons/unfold-more.svg"); }
        if (glyph == "upload") { return @image-url("../assets/icons/upload.svg"); }
        if (glyph == "visibility-off") { return @image-url("../assets/icons/visibility-off.svg"); }
        if (glyph == "visibility") { return @image-url("../assets/icons/visibility.svg"); }
        if (glyph == "wallpaper") { return @image-url("../assets/icons/wallpaper.svg"); }
        if (glyph == "warning") { return @image-url("../assets/icons/warning.svg"); }
        if (glyph == "window-asset") { return @image-url("../assets/icons/window-asset.svg"); }
        return @image-url("../assets/icons/add.svg");
    }
}

export component Icon inherits Rectangle {
    in property <string> glyph;
    in property <brush> tint: Theme.text-secondary;
    in property <length> size: 16px;
    // (#icon-align 2026-10-02) 图形**居中于父容器**，而不是停在左上角 / 顶部。
    //
    // 迁移前每个调用点用的是 `Text`：Text 的 width/height 默认铺满父容器，
    // 再靠 horizontal/vertical-alignment: center 把字形摆到正中。改成写死
    // `width: size; height: size` 的 Icon 之后，两条路径都断了：
    //   ① 父是非布局 Rectangle（ToolStrip 按钮等，68 处）→ 停在 (0,0) 左上角；
    //   ② 父是 HorizontalLayout（TopbarBtn / GhostButton 等，51 处）→ 宽度还能
    //      固定，但交叉轴上固定高会**顶对齐**（TopbarBtn 注释里已记过这个坑：
    //      “规避 HL 固定高子项的顶对齐问题”）。
    //
    // 所以这里不再写死尺寸：宽度走 preferred + stretch:0 —— 布局里锁 0 不撑开
    // 按钮（session_dialog 的 footer-status 行依赖这一点），非布局时默认 100%
    // 铺满；高度交给布局拉伸（非布局时同样默认 100%）。再由内部 Image 按 size
    // 居中，两条路径就都与原来的 Text 等价。
    // min-width 必须给：否则空间不足时布局会把 Icon 压窄，Image 的居中基准
    // 跟着变小，反倒把图标推偏。
    // (#icon-empty-glyph 2026-10-02) 空 glyph = "无图标"，与迁移前的空 Text 等价：
    // 不绘制、且在布局里**完全不占位**。
    //
    // 这是迁移的一处语义丢失：原来 `Text { text: "" }` 的 preferred-width 是 0，
    // 空串天然"消失"（session_dialog 的 footer-status 行正是靠这个表达"当前没有
    // 状态"）；而 IconImages.src("") 不是空集 —— 它会回落到 add.svg，于是空状态
    // 下凭空冒出一个 "+"。
    //
    // ⚠️ 两个刻意的选择：
    //  1. 只写 visible: false 不够 —— Slint 的 visible 不脱离布局（不同于 CSS 的
    //     display:none），必须同时把宽度约束归零，否则空 glyph 仍占掉一个 size 的槽。
    //  2. 隐藏放在**内部 Image** 而非组件自身：组件一旦绑定 visible，调用点就不能再
    //     设 visible（Slint 的属性绑定不可被外部覆盖），而「有 glyph 但某条件下隐藏」
    //     是真实需求 —— app.slint 关闭弹框的「记住我的选择」复选框就靠 visible 控制勾。
    preferred-width: root.glyph != "" ? size : 0px;
    min-width: root.glyph != "" ? size : 0px;
    horizontal-stretch: 0;
    // (#icon-vl-height 2026-10-02) 高度与宽度同理 —— 但只在**主轴**上需要补：
    // VerticalLayout 的主轴是高度，而 Rectangle 的默认 preferred 高度是 0，
    // 于是 Icon 在 VL 里被压成 0 高，内部 22px 的 Image 按
    // `y = (0 - 22) / 2 = -11px` 居中，向上溢出正好压住同列的文字
    // （关闭弹框两张卡片的"图标叠在标题上"就是这么来的，用户截图）。
    // 与宽度对称：空 glyph 归 0（占位语义一致），非空给 size。
    //
    // ⚠️ 刻意**不**加 vertical-stretch: 0 —— HorizontalLayout 的交叉轴靠默认
    // stretch 把 Icon 撑到按钮全高（Image 再在盒子内居中）；设 0 会让固定高的
    // 盒子在更高的按钮里顶对齐，正是上文记过的那个坑。
    // 已全库扫描确认：Icon 直接做 VL 子项的只有关闭弹框两处，其余 119 处
    // （68 非布局 + 51 HL）行为不变。
    preferred-height: root.glyph != "" ? size : 0px;
    min-height: root.glyph != "" ? size : 0px;
    Image {
        source: IconImages.src(root.glyph);
        colorize: root.tint;
        visible: root.glyph != "";
        width: root.size;
        height: root.size;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }
}
