// (#cmd-hint 2026-10-27 · 修订 2026-10-30) 命令提示框 —— 轻量两段半浮层。
//
// 高保真稿：docs/design/terminal-command-hint-hifi-2026-10-27.html（修订 10-30）
// 数据侧：src/command_hint/（领域层）+ src/app/command_hint_ui.rs（宿主桥）
//
// ★ 这个组件**只负责画和响应**，不认识「命令栏」也不认识「终端」：
//   两处宿主（命令栏 / 终端内联）各算自己的锚点，传进来即可。这是高保真
//   §7 最后一条「两处宿主共用一组件」的落地方式 —— 别再长出第二份实现
//   （send_cmd_window 已经踩过这个坑）。
//
// ★ 修订 10-30 的结构定稿（用户实测反馈：头部信息提示符里就有、详情区
//   未选中时整块空白）—— 原「四段式」砍成**两段半**：
//     ① 候选列表 3–5 行（主体，说明长在行内副标题）
//     ② 危险告警条 ~30px（**条件渲染**，仅命中 danger-token 时出现在列表上方）
//     ③ 键盘脚注 23px
//   原 27px 上下文条（user@host : cwd + 阶段胶囊 + 计数）与 94px 详情区退役。
//
// ★ 键盘契约同批定稿（§5）：Tab **永远透传 shell**（提示框不接管）；
//   Enter 未导航=执行当前输入、已导航=**执行选中候选**；
//   Shift+Enter / →(鬼影) / 鼠标点击 = 仅填入。选中态由 ↑↓ 显式建立，
//   刚弹出时无选中（selected = -1，不高亮任何行）。

import { Icon } from "icons.slint";
import { Theme } from "theme.slint";

// 一条候选。字段与 `HintRowData`（Rust）一一对应。
export struct HintRow {
    text: string,
    kind: int,          // 1 = 快捷命令(bolt) / 0 = 历史(时钟)
    subtitle: string,   // 一句话副标题；空则不占位
    source: string,     // 来源标签：「快捷命令」/「内置」/「历史」
    signature: string,  // 语法签名（详情区已退役，字段保留给未来知识库面板）
    description: string,// 说明（同上）
    // ★ 选中这一条后，命令行**整行**应该变成什么。
    //   由 Rust 侧算好（`HintInput` 已经知道怎么拆词，UI 侧 Slint 1.18 的
    //   string 没有 trim-end/rfind/substr，拼不出来）。两个用途：
    //     ① Shift+Enter / 鼠标点击 → 差量填入；
    //     ② Enter 已导航 → 整行替换后执行。
    apply: string,
}

export component CommandHint inherits Rectangle {
    // ── 数据 ────────────────────────────────────────────────────────────
    in property <[HintRow]> rows;
    // ★ 无选中态：刚弹出时不高亮任何行（高保真 §5 —— 未导航 Enter=执行
    //   当前输入，防止「敲完一条完整命令回车被候选偷换」）。↑↓ 才建立导航。
    in property <int> selected: -1;
    in property <bool> open: false;
    // 危险命令命中的模式原文；非空 → 列表上方出现红色告警条。
    // 数据由 Rust 侧算（`danger_of`，与 terminal_view.slint 的
    // danger-token() 同表镜像）—— 终端内联与命令栏共用同一份。
    in property <string> danger-token: "";
    in property <string> danger-why: "";

    // ── 回调 ────────────────────────────────────────────────────────────
    // 用户点了某一行（单击=选中+**填入**，不执行 —— §5 鼠标行；
    // 与历史面板「点行=填入」同口径，执行只交给 Enter）。
    callback picked(int);
    // 悬停某一行（只高亮，不改选中 —— 避免列表跟鼠标抖）。
    callback hovered(int);

    // ★ 压终端上**不能用 popup-bg**：高保真 §2 ④ 实测
    //   popup-bg(= slot-panel) 与终端底 term-bg(= slot-tbg) 在 MTerm 两套
    //   主题里是**同一个值**（深 #181A1D / 亮 #FAF8F4），压上去框会「消失」，
    //   只剩一圈边框。必须升到 slot-elev + border-strong 描边。
    background: Theme.bg-elevated;
    // ★ 圆角用 radius-lg（10px），与主界面的弹窗（命令管理 / 确认框 / 设置）
    //   同一档。原来写 radius-md（6px），用户实测反馈「主界面四个圆角看得清，
    //   这个提示框像没设圆角」—— 6px 在深色底上确实几乎看不出来。
    border-radius: Theme.radius-lg;
    border-width: 1px;
    border-color: Theme.border-strong;
    drop-shadow-blur: 14px;
    drop-shadow-color: #00000066;
    // 内层布局已内缩 1px 避开边框（见下方 VerticalLayout 的注释），
    // 这里开 clip 只是防止列表行文字溢出圆角。
    clip: true;
    visible: root.open;

    // ★ 键盘上下选择时把选中行滚进视口；鼠标滚轮仍可自由滚（Flickable 自己处理）。
    changed selected => {
        if (root.selected >= 0) {
            let cur = list-flick.viewport-y;
            let row-top = root.selected * 28px;
            let row-bottom = row-top + 28px;
            let target = row-top < cur
                ? row-top
                : (row-bottom > cur + list-flick.height ? row-bottom - list-flick.height : cur);
            let max-y = max(0px, root.rows.length * 28px + 6px - list-flick.height);
            list-flick.viewport-y = clamp(target, 0px, max-y);
        }
    }

    // 可见行数 = min(候选数, 50)。高度按它算，所以 1↔3 条之间切换时
    // 框高度不变（高保真 §4 的「锁 3 行」）。
    // 数据侧可能给到几十条（见 HINT_MAX_ROWS），视图只开固定视口。
    out property <int> shown: min(root.rows.length, 50);
    // ★ 视口行数：1–3 条锁定 3 行；3–5 条跟着长；**超过 5 条不再长高**，
    //   改为滚动（高保真 §3：候选 5 行封顶）。
    out property <int> list-rows: min(max(3, root.shown), 5);
    // ★ 自然高度必须**自己算**，不能读 `self.preferred-height`：
    //   根是 Rectangle，Slint 不会从内容反推 Rectangle 的 preferred-height
    //   （实测恒为 0，于是宿主侧的 min(自然高, 可用高) 完全失效）。
    //   两段固定 + 条件告警条：
    //     列表(list-rows*28+6) + 告警 30（仅危险命令）+ 脚注 23
    out property <length> natural-height:
        (root.list-rows * 28px + 6px)
        + (root.danger-token != "" ? 30px : 0px)
        + 23px;

    // ★ 内层内容直接作为根的子级，由根统一裁切。
    //   边框由根 Rectangle 的 border 画，四段内容带直角背景；
    //   它们贴边但不越过根（根有 border-radius 收边）。
    // ★ 内层布局必须**内缩 1px**（四边各让出边框的位置）。
    //   Slint 的 Rectangle border 画在边界内侧，而子元素是画在边框**之上**的
    //   —— 内层段（告警 / 脚注）带背景且铺满全宽时，会把边框整整一圈盖掉。
    //   高保真用 CSS `overflow:hidden` 解决同一件事；Slint 的等价做法就是
    //   让内容避开边框那 1px。
    VerticalLayout {
        x: 1px;
        y: 1px;
        width: parent.width - 2px;
        height: parent.height - 2px;
        spacing: 0px;
        alignment: start;

        // ── ① 危险告警条（**条件渲染**，仅危险命令时出现在列表上方）────
        // 高保真 §3②：约 30px 单行。安全警示要醒目，但不值得为它常驻一整块
        // ——原「列表下方 94px 接管详情区」的结构随详情区一起退役。
        if root.danger-token != "" : Rectangle {
            height: 30px;
            width: parent.width;
            clip: true;
            background: Theme.danger.with-alpha(0.13);

            Rectangle {
                y: 0px;
                width: parent.width;
                height: 1phx;
                background: Theme.danger.with-alpha(0.42);
            }

            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                spacing: 7px;
                Icon {
                    glyph: "warning";
                    tint: Theme.danger-strong;
                    size: 13px;
                    width: 13px;
                    height: 13px;
                    y: (parent.height - self.height) / 2;
                }
                Text {
                    // 模式原文不翻译（命令原文）；前缀走 i18n。
                    text: @tr("Dangerous command") + " · " + root.danger-token;
                    color: Theme.danger-strong;
                    font-size: Theme.fs-xs;
                    font-weight: Theme.fw-strong;
                    vertical-alignment: center;
                }
                Text {
                    text: root.danger-why;
                    color: Theme.text-secondary;
                    font-size: 10.5px;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
            }
        }

        // ── ② 候选列表（3–5 行，主体）───────────────────────────────────
        Rectangle {
            // 高保真 §4：候选 1→3 条时高度锁定在 3 行，超过才长高。
            // 28px 行高 + 上下 3px 内衬。
            height: root.list-rows * 28px + 6px;
            width: parent.width;
            background: transparent;
            clip: true;

            // ★ 固定视口 + 滚动：候选可以很多，框高不变。
            list-flick := Flickable {
                width: parent.width;
                height: parent.height;
                viewport-width: self.width;
                // 内容高 = 全部候选；不足一屏时也不留空白。
                viewport-height: max(self.height, root.rows.length * 28px + 6px);
                interactive: true;

            VerticalLayout {
                padding: 3px;
                spacing: 0px;
                alignment: start;

                for r[idx] in root.rows : Rectangle {
                    height: 28px;
                    border-radius: Theme.radius-sm;
                    background: idx == root.selected ? Theme.accent-soft
                              : (row-ta.has-hover ? Theme.bg-hover : transparent);

                    // 选中项左侧 2px 竖条（高保真 .hb-row.on::before）。
                    if idx == root.selected : Rectangle {
                        x: 0px;
                        y: 4px;
                        width: 2px;
                        height: parent.height - 8px;
                        border-radius: 1px;
                        background: Theme.accent;
                    }

                    row-ta := TouchArea {
                        // 悬停只发信号，不改选中 —— 鼠标扫过时列表不该自己跳。
                        pointer-event(e) => {
                            if (e.kind == PointerEventKind.move) {
                                root.hovered(idx);
                            }
                        }
                        clicked => { root.picked(idx); }
                    }

                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 7px;
                        spacing: 7px;
                        // ★ 别写 alignment: start —— 项目 pitfalls 点名的坑：
                        //   它会把主轴 flex_grow 全部归零，右侧的来源徽章
                        //   推不到行尾（用户实测：徽章悬在文本旁边）。
                        //   右对齐靠末尾的「吸空块」。

                        // 类型图标：快捷命令 bolt / 历史 时钟。
                        Icon {
                            glyph: r.kind == 1 ? "bolt" : "command-history";
                            tint: idx == root.selected ? Theme.accent
                                : (r.kind == 1 ? Theme.accent : Theme.text-muted);
                            size: 12px;
                            width: 12px;
                            height: 12px;
                            y: (parent.height - self.height) / 2;
                        }

                        // 主文本：等宽（命令原文）。占满剩余宽，副标题/徽章靠右。
                        Text {
                            text: r.text;
                            color: Theme.text-primary;
                            font-family: Theme.font-mono;
                            font-size: Theme.fs-xs;
                            vertical-alignment: center;
                            overflow: elide;
                            wrap: no-wrap;
                            horizontal-stretch: 1;
                        }

                        // 一句话副标题（说明长在行内，§3 定稿——详情区已退役）。
                        // 宽度不够先丢它（高保真：副标题是「扫视时可跳过」的信息）。
                        if r.subtitle != "" : Text {
                            text: r.subtitle;
                            color: Theme.text-secondary;
                            font-size: 10.5px;
                            vertical-alignment: center;
                            overflow: elide;
                            width: min(parent.width / 2, self.preferred-width);
                        }

                        // 来源徽章：**靠右**（吸空块在它后面不行——它自己就是
                        // 最后一个有宽度的元素，剩余空间由主文本的 stretch 吃掉）。
                        if r.source != "" : Rectangle {
                            height: 15px;
                            width: min(parent.width - 24px, src-tx.preferred-width + 8px);
                            border-radius: 3px;
                            y: (parent.height - self.height) / 2;
                            background: idx == root.selected ? Theme.accent-soft : transparent;
                            border-width: 1px;
                            border-color: idx == root.selected ? Theme.accent : Theme.border-subtle;
                            clip: true;
                            src-tx := Text {
                                text: r.source;
                                color: idx == root.selected ? Theme.accent : Theme.text-muted;
                                font-size: 9px;
                                font-family: Theme.font-mono;
                                vertical-alignment: center;
                                horizontal-alignment: center;
                                width: parent.width;
                                height: parent.height;
                            }
                        }
                    }
                }
            }
            }
        }

        // ── ③ 键盘脚注 23px ─────────────────────────────────────────────
        // §3③：六项常驻，并刻意不出现「Tab 填入」——Tab 已定稿**永远透传
        // shell**（§5），脚注本身就是这个契约的声明。键帽一律用英文字母
        // （用户定稿：↵/⇧ 符号不可用）。
        Rectangle {
            height: 23px;
            width: parent.width;
            background: Theme.bg-panel;

            Rectangle {
                y: 0px;
                width: parent.width;
                height: 1phx;
                background: Theme.slot-line.brighter(0.14);
            }

            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                spacing: 9px;
                alignment: start;
                Text {
                    text: "↑↓ " + @tr("Select");
                    color: Theme.text-muted;
                    font-size: 10px;
                    vertical-alignment: center;
                }
                Text {
                    // §5 定稿：未导航 Enter=执行当前输入；已导航=执行选中候选。
                    text: "Enter " + @tr("Run");
                    color: Theme.text-muted;
                    font-size: 10px;
                    vertical-alignment: center;
                }
                Text {
                    // 仅填入（不执行）——想接着敲参数的入口。
                    text: "Shift+Enter " + @tr("Insert");
                    color: Theme.text-muted;
                    font-size: 10px;
                    vertical-alignment: center;
                }
                Text {
                    // 内联鬼影补全（词级 / 整行预测），Tab 归 shell 后的补命令捷径。
                    text: "→ " + @tr("Complete");
                    color: Theme.text-muted;
                    font-size: 10px;
                    vertical-alignment: center;
                }
                Text {
                    text: "Tab=shell";
                    color: Theme.text-muted;
                    font-size: 10px;
                    vertical-alignment: center;
                }
                Text {
                    text: "Esc " + @tr("Close");
                    color: Theme.text-muted;
                    font-size: 10px;
                    vertical-alignment: center;
                }
                Rectangle { horizontal-stretch: 1; }
            }
        }
    }
}
