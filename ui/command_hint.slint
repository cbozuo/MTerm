// (#cmd-hint 2026-10-27) 命令提示框 —— 高保真四段式浮层。
//
// 高保真稿：docs/design/terminal-command-hint-hifi-2026-10-27.html
// 数据侧：src/app/command_hint.rs
//
// ★ 这个组件**只负责画和响应**，不认识「命令栏」也不认识「终端」：
//   两处宿主（命令栏 / 终端内联）各算自己的锚点，传进来即可。这是高保真
//   §7 最后一条「两处宿主共用一组件」的落地方式 —— 别再长出第二份实现
//   （send_cmd_window 已经踩过这个坑）。
//
// 四段的结构与尺寸都锁死，理由见高保真 §3：
//   ① 上下文条 27px  ② 候选列表 3–5 行  ③ 详情区 94px  ④ 键盘脚注 23px
//   ②③ 的高度不随候选数量/选中项变化 —— 「换一条候选整个框跳一下」是这类
//   浮层最刺眼的毛病。

import { Icon } from "icons.slint";
import { Theme } from "theme.slint";

// 一条候选。字段与 `HintRowData`（Rust）一一对应。
export struct HintRow {
    text: string,
    kind: int,          // 1 = 快捷命令(bolt) / 0 = 历史(时钟)
    subtitle: string,   // 一句话副标题；空则不占位
    source: string,     // 来源标签：「快捷命令」/「历史」/「内置」
    signature: string,  // 详情区语法签名；空 = 无 spec
    description: string,// 详情区说明
    // ★ 选中这一条后，命令行**整行**应该变成什么。
    //   由 Rust 侧算好（`HintInput` 已经知道怎么拆词，UI 侧 Slint 1.18 的
    //   string 没有 trim-end/rfind/substr，拼不出来）。两个用途：
    //     ① Tab / 鼠标点击 → 直接写进输入框；
    //     ② Enter 两段式 → 拿它跟当前整行比，相等就执行、不等就先填入。
    apply: string,
}

export component CommandHint inherits Rectangle {
    // ── 数据 ────────────────────────────────────────────────────────────
    in property <[HintRow]> rows;
    in property <int> selected: 0;
    in property <bool> open: false;
    // 阶段胶囊文案（Rust 侧已按语言定好）。
    in property <string> phase-label: "";
    // 上下文条左侧：`user@host : cwd`。
    in property <string> context-text: "";
    // 命中总数（可能 > rows.length，行数按 8 封顶）。
    in property <int> total-count: 0;
    // 危险命令命中的模式原文；非空 → 详情区整块换成红色告警条。
    // 复用命令栏既有的 danger 语言（高保真 §3 ③）。
    in property <string> danger-token: "";
    in property <string> danger-why: "";

    // ── 回调 ────────────────────────────────────────────────────────────
    // 用户点了某一行（单击填入，不执行 —— 高保真 §5 鼠标行）。
    callback picked(int);
    // 悬停某一行（只高亮，不改选中 —— 避免列表跟鼠标抖）。
    callback hovered(int);

    // ★ 压终端上**不能用 popup-bg**：高保真 §2 ④ 实测
    //   popup-bg(= slot-panel) 与终端底 term-bg(= slot-tbg) 在 MTerm 两套
    //   主题里是**同一个值**（深 #181A1D / 亮 #FAF8F4），压上去框会「消失」，
    //   只剩一圈边框。必须升到 slot-elev + border-strong 描边。
    background: Theme.bg-elevated;
    // ★ 圆角用 radius-lg（10px），与主界面的弹窗（命令管理 / 确认框 / 设置）
    //   同一档。原来写 radius-md（6px），用户实测反馈「主界面四个圆角看得清，
    //   这个提示框像没设圆角」—— 6px 在深色底上确实几乎看不出来。
    border-radius: Theme.radius-lg;
    border-width: 1px;
    border-color: Theme.border-strong;
    drop-shadow-blur: 14px;
    drop-shadow-color: #00000066;
    // 内层布局已内缩 1px 避开边框（见下方 VerticalLayout 的注释），
    // 这里开 clip 只是防止列表行文字溢出圆角。
    clip: true;
    visible: root.open;

    // ★ 键盘上下选择时把选中行滚进视口；鼠标滚轮仍可自由滚（Flickable 自己处理）。
    changed selected => {
        if (root.selected >= 0) {
            let cur = list-flick.viewport-y;
            let row-top = root.selected * 28px;
            let row-bottom = row-top + 28px;
            let target = row-top < cur
                ? row-top
                : (row-bottom > cur + list-flick.height ? row-bottom - list-flick.height : cur);
            let max-y = max(0px, root.rows.length * 28px + 6px - list-flick.height);
            list-flick.viewport-y = clamp(target, 0px, max-y);
        }
    }

    // 可见行数 = min(候选数, 8)。高度按它算，所以 1↔5 条之间切换时
    // 框会变高，但 **3 条以内不变**（高保真 §4 的「锁 3 行」）。
    // 数据侧可能给到几十条（见 HINT_MAX_ROWS），视图只开固定视口。
    out property <int> shown: min(root.rows.length, 50);
    // ★ 视口行数：1–3 条锁定 3 行；3–6 条跟着长；**超过 6 条不再长高**，
    //   改为滚动（用户定稿：「信息框的高度不变，支持滚动翻找」）。
    out property <int> list-rows: min(max(3, root.shown), 6);
    // ★ 自然高度必须**自己算**，不能读 `self.preferred-height`：
    //   根是 Rectangle，Slint 不会从内容反推 Rectangle 的 preferred-height
    //   （实测恒为 0，于是宿主侧的 min(自然高, 可用高) 完全失效，
    //   浮层在离屏里恒为 257px、翻转判据也跟着错）。
    //   三段固定 + 可选的危险告警条：
    //     上下文条 27 + 列表(list-rows*28+6) + 告警 94（仅危险命令）+ 脚注 23
    out property <length> natural-height:
        27px + (root.list-rows * 28px + 6px)
        + (root.danger-token != "" ? 94px : 0px)
        + 23px;

    // ★ 内层内容直接作为根的子级，由根统一裁切。
    //   边框由根 Rectangle 的 border 画，四段内容带直角背景；
    //   它们贴边但不越过根（根有 border-radius 收边）。
    // ★ 内层布局必须**内缩 1px**（四边各让出边框的位置）。
    //   Slint 的 Rectangle border 画在边界内侧，而子元素是画在边框**之上**的
    //   —— 四个内层段（上下文条 / 详情 / 脚注）带背景且铺满全宽时，会把
    //   边框整整一圈盖掉（用户实测反馈「四角缺少细线」，其实是四边都被盖，
    //   角上最明显）。高保真用 CSS `overflow:hidden` 解决同一件事；Slint 的
    //   等价做法就是让内容避开边框那 1px。
    VerticalLayout {
        x: 1px;
        y: 1px;
        width: parent.width - 2px;
        height: parent.height - 2px;
        spacing: 0px;
        alignment: start;
        // ── ① 上下文条 27px ─────────────────────────────────────────────
        Rectangle {
            height: 27px;
            width: parent.width;
            background: Theme.bg-panel;
            HorizontalLayout {
                padding-left: 10px;
                padding-right: 9px;
                spacing: 8px;
                // ★ 不写 alignment：上下文文本吃 stretch，胶囊/计数自然靠右；
                //   写了 start 会把胶囊的宽度约束打乱（pillfalls 坑）。
                Text {
                    text: root.context-text;
                    color: Theme.text-muted;
                    font-size: Theme.fs-2xs;
                    font-family: Theme.font-mono;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
                // 阶段胶囊。宽度随文案（中英文长度不同），所以不写死。
                // ★ 高度 16 + y 手动居中：27px 条里固定高度子项默认**顶对齐**
                //   （pitfalls：交叉轴没有属性可设），用户实测「没有居中显示」。
                Rectangle {
                    height: 16px;
                    width: phase-tx.preferred-width + 12px;
                    y: (parent.height - self.height) / 2;
                    border-radius: 8px;
                    background: Theme.accent-soft;
                    border-width: 1px;
                    border-color: Theme.accent;
                    phase-tx := Text {
                        text: root.phase-label;
                        color: Theme.accent;
                        font-size: 9.5px;
                        font-weight: Theme.fw-strong;
                        vertical-alignment: center;
                        horizontal-alignment: center;
                        width: parent.width;
                        height: parent.height;
                    }
                }
                Text {
                    text: root.total-count + "";
                    color: Theme.text-muted;
                    font-size: 10px;
                    font-family: Theme.font-mono;
                    vertical-alignment: center;
                }
            }
            // 底部分隔线：1phx（高保真 §3，别用 border —— 四边都会画）
            Rectangle {
                y: parent.height - 1phx;
                width: parent.width;
                height: 1phx;
                background: Theme.slot-line.brighter(0.14);
            }
        }

        // ── ② 候选列表（3–5 行）─────────────────────────────────────────
        Rectangle {
            // 高保真 §4：候选 1→3 条时高度锁定在 3 行，超过才长高。
            // 28px 行高 + 上下 3px 内衬。
            height: root.list-rows * 28px + 6px;
            width: parent.width;
            background: transparent;
            clip: true;

            // ★ 固定视口 + 滚动：候选可以很多，框高不变。
            list-flick := Flickable {
                width: parent.width;
                height: parent.height;
                viewport-width: self.width;
                // 内容高 = 全部候选；不足一屏时也不留空白。
                viewport-height: max(self.height, root.rows.length * 28px + 6px);
                interactive: true;

            VerticalLayout {
                padding: 3px;
                spacing: 0px;
                alignment: start;

                for r[idx] in root.rows : Rectangle {
                    height: 28px;
                    border-radius: Theme.radius-sm;
                    background: idx == root.selected ? Theme.accent-soft
                              : (row-ta.has-hover ? Theme.bg-hover : transparent);

                    // 选中项左侧 2px 竖条（高保真 .hb-row.on::before）。
                    if idx == root.selected : Rectangle {
                        x: 0px;
                        y: 4px;
                        width: 2px;
                        height: parent.height - 8px;
                        border-radius: 1px;
                        background: Theme.accent;
                    }

                    row-ta := TouchArea {
                        // 悬停只发信号，不改选中 —— 鼠标扫过时列表不该自己跳。
                        pointer-event(e) => {
                            if (e.kind == PointerEventKind.move) {
                                root.hovered(idx);
                            }
                        }
                        clicked => { root.picked(idx); }
                    }

                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 7px;
                        spacing: 7px;
                        // ★ 别写 alignment: start —— 项目 pitfalls 点名的坑：
                        //   它会把主轴 flex_grow 全部归零，右侧的来源徽章
                        //   推不到行尾（用户实测：徽章悬在文本旁边）。
                        //   右对齐靠末尾的「吸空块」。

                        // 类型图标：快捷命令 bolt / 历史 时钟。
                        Icon {
                            glyph: r.kind == 1 ? "bolt" : "command-history";
                            tint: idx == root.selected ? Theme.accent
                                : (r.kind == 1 ? Theme.accent : Theme.text-muted);
                            size: 12px;
                            width: 12px;
                            height: 12px;
                            y: (parent.height - self.height) / 2;
                        }

                        // 主文本：等宽（命令原文）。占满剩余宽，副标题/徽章靠右。
                        Text {
                            text: r.text;
                            color: Theme.text-primary;
                            font-family: Theme.font-mono;
                            font-size: Theme.fs-xs;
                            vertical-alignment: center;
                            overflow: elide;
                            wrap: no-wrap;
                            horizontal-stretch: 1;
                        }

                        // 来源徽章：**靠右**（吸空块在它后面不行——它自己就是
                        // 最后一个有宽度的元素，剩余空间由主文本的 stretch 吃掉）。
                        if r.source != "" : Rectangle {
                            height: 15px;
                            width: min(parent.width - 24px, src-tx.preferred-width + 8px);
                            border-radius: 3px;
                            y: (parent.height - self.height) / 2;
                            background: idx == root.selected ? Theme.accent-soft : transparent;
                            border-width: 1px;
                            border-color: idx == root.selected ? Theme.accent : Theme.border-subtle;
                            clip: true;
                            src-tx := Text {
                                text: r.source;
                                color: idx == root.selected ? Theme.accent : Theme.text-muted;
                                font-size: 9px;
                                font-family: Theme.font-mono;
                                vertical-alignment: center;
                                horizontal-alignment: center;
                                width: parent.width;
                                height: parent.height;
                            }
                        }
                    }
                }
            }
            }
        }

        // ── ③ 危险告警条（**仅危险命令时出现**）────────────────────────
        //
        // ★ 用户实测反馈：「下面的描述说明块没必要加进去，把空间让给命令」。
        //   原来这里常驻 94px 显示语法签名 / 一句话说明 / 来源元信息，普通命令
        //   根本没人看那几行，却把浮层撑得很长（用户：「感觉有些太长了」）。
        //   现在只在**危险命令**时出现 —— 那是真正需要用户停下来看一眼的信息，
        //   其余情况整块不占高度。
        if root.danger-token != "" : Rectangle {
            height: 94px;
            width: parent.width;
            clip: true;
            background: Theme.danger.with-alpha(0.13);

            Rectangle {
                y: 0px;
                width: parent.width;
                height: 1phx;
                background: Theme.danger.with-alpha(0.42);
            }

            HorizontalLayout {
                padding-left: 11px;
                padding-right: 11px;
                spacing: 8px;
                Icon {
                    glyph: "warning";
                    tint: Theme.danger-strong;
                    size: 14px;
                    width: 14px;
                    height: 14px;
                    y: (parent.height - self.height) / 2;
                }
                VerticalLayout {
                    alignment: center;
                    spacing: 2px;
                    horizontal-stretch: 1;
                    Text {
                        text: @tr("Dangerous command") + " · " + root.danger-token;
                        color: Theme.danger-strong;
                        font-size: Theme.fs-xs;
                        font-weight: Theme.fw-strong;
                        overflow: elide;
                    }
                    Text {
                        text: root.danger-why;
                        color: Theme.text-secondary;
                        font-size: 10.5px;
                        overflow: elide;
                    }
                }
            }
        }

        // ── ④ 键盘脚注 23px ─────────────────────────────────────────────
        Rectangle {
            height: 23px;
            width: parent.width;
            background: Theme.bg-panel;

            Rectangle {
                y: 0px;
                width: parent.width;
                height: 1phx;
                background: Theme.slot-line.brighter(0.14);
            }

            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                spacing: 9px;
                alignment: start;
                Text {
                    text: "↑↓ " + @tr("Select");
                    color: Theme.text-muted;
                    font-size: 10px;
                    vertical-alignment: center;
                }
                Text {
                    text: "Tab " + @tr("Insert");
                    color: Theme.text-muted;
                    font-size: 10px;
                    vertical-alignment: center;
                }
                Text {
                    // ★ 用户定稿：「tab 回车都是填入，不需要执行」。
                    //   早先这里写的是「↵ 执行」，与实际行为不符。
                    text: "↵ " + @tr("Insert");
                    color: Theme.text-muted;
                    font-size: 10px;
                    vertical-alignment: center;
                }
                Text {
                    text: "Esc " + @tr("Close");
                    color: Theme.text-muted;
                    font-size: 10px;
                    vertical-alignment: center;
                }
                Rectangle { horizontal-stretch: 1; }
            }
        }
    }
}
