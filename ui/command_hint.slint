// (#cmd-hint 2026-10-27 · 修订 2026-10-30) 命令提示框 —— 轻量两段半浮层。
//
// 高保真稿：docs/design/terminal-command-hint-hifi-2026-10-27.html（修订 10-30）
// 数据侧：src/command_hint/（领域层）+ src/app/command_hint_ui.rs（宿主桥）
//
// ★ 这个组件**只负责画和响应**，不认识「命令栏」也不认识「终端」：
//   两处宿主（命令栏 / 终端内联）各算自己的锚点，传进来即可。这是高保真
//   §7 最后一条「两处宿主共用一组件」的落地方式 —— 别再长出第二份实现
//   （send_cmd_window 已经踩过这个坑）。
//
// ★ 修订 10-30（实测二轮）：
//   · 边框配方与「高亮设置」弹框对齐（用户：边框线和四个圆角要和高亮设置
//     里面对齐）—— radius-xl + hairline 细线 + border-strong，同
//     highlight_dialog.slint 的 dlg 根节点与 history_panel 的 #hist-round5。
//   · 列表改 ScrollView 承载**全量行**（#cmd-hint-scroll）：可见行数 5 → 8
//     （用户：展示的有些少）；鼠标滚轮翻找、↑↓ 选中出视口自动跟随。
//     旧 Flickable 方案死于两个坑：a) `viewport-y` 是**负值域**（0=顶、
//     −max=底），键盘跟随写了正值 `row-top`，内容被整体向下平移推出视口，
//     露出下层终端 —— 用户截图「箭头往下滚看不到背景」；b) 行文本带 `\n`
//     （多行粘贴的历史条目）把 28px 行盒撑爆叠到邻行（显示侧压平修复，
//     见 command_hint_ui.rs）。
//
// ★ 键盘契约（§7 定稿 2026-10-30 三轮，终端内联与命令栏两处宿主**完全同一套**）：
//   弹出即选中首条（候选按相关度排好，首条就是最佳）；
//   Enter = 填入选中候选并收框（确认靠收框表达，不做行==apply 文本比对——
//   打字打出的完整命令与候选天然相等，比对必漏：用户实测 `ll` 回车直接执行）；
//   框关了 Enter = 执行当前输入；Shift+Enter = 强制执行选中候选；
//   →(鬼影) / 鼠标点击 = 仅填入；Tab 永远透传 shell。

import { Icon } from "icons.slint";
import { Theme } from "theme.slint";
import { ScrollView } from "std-widgets.slint";

// 一条候选。字段与 `HintRowData`（Rust）一一对应。
export struct HintRow {
    text: string,
    kind: int,          // 1 = 快捷命令(bolt) / 0 = 历史(时钟)
    subtitle: string,   // 一句话副标题；空则不占位
    source: string,     // 来源标签：「快捷命令」/「内置」/「历史」
    signature: string,  // 语法签名（详情区已退役，字段保留给未来知识库面板）
    description: string,// 说明（同上）
    // ★ 选中这一条后，命令行**整行**应该变成什么。
    //   由 Rust 侧算好（`HintInput` 已经知道怎么拆词，UI 侧 Slint 1.18 的
    //   string 没有 trim-end/rfind/substr，拼不出来）。两个用途：
    //     ① Enter / 鼠标点击 → 差量填入（框开着永远填入）；
    //     ② Shift+Enter → 整行替换后直接执行。
    apply: string,
}

export component CommandHint inherits Rectangle {
    // ── 数据 ────────────────────────────────────────────────────────────
    in property <[HintRow]> rows;
    // ★ 选中项由宿主持有并传入（两处宿主各管各的）：弹出即指向首条
    // （高保真 §7 收敛 —— 候选按相关度排好，首条就是最佳，Enter 直接确认）。
    in property <int> selected: -1;
    in property <bool> open: false;
    // 危险命令命中的模式原文；非空 → 列表上方出现红色告警条。
    // 数据由 Rust 侧算（`danger_of`，与 terminal_view.slint 的
    // danger-token() 同表镜像）—— 终端内联与命令栏共用同一份。
    in property <string> danger-token: "";
    in property <string> danger-why: "";

    // ── 回调 ────────────────────────────────────────────────────────────
    // 用户点了某一行（单击=选中+**填入**，不执行 —— §5 鼠标行；
    // 与历史面板「点行=填入」同口径，执行只交给 Enter）。
    callback picked(int);
    // 悬停某一行（只高亮，不改选中 —— 避免列表跟鼠标抖）。
    callback hovered(int);

    // ★ 压终端上**不能用 popup-bg**：高保真 §2 ④ 实测
    //   popup-bg(= slot-panel) 与终端底 term-bg(= slot-tbg) 在 MTerm 两套
    //   主题里是**同一个值**（深 #181A1D / 亮 #FAF8F4），压上去框会「消失」，
    //   只剩一圈边框。必须升到 slot-elev + border-strong 描边。
    background: Theme.bg-elevated;
    // (#cmd-hint-border 2026-10-30) 边框配方与「高亮设置」弹框对齐（用户实测
    // 反馈：边框线和四个圆角要和高亮设置里面对齐）：radius-xl + hairline 细线
    // + border-strong —— 同 highlight_dialog.slint 的 dlg 根节点、history_panel
    // 的 #hist-round5。原 radius-lg（10px）低一档，四角弧线与全应用弹框不一致。
    border-radius: Theme.radius-xl;
    border-width: Theme.hairline();
    border-color: Theme.border-strong;
    // (#cmd-hint-chrome 2026-10-30) 投影对齐「高亮设置」弹框 / 历史面板同款：
    // 26px transparent —— 立体感靠比终端底亮一档的 elevated 底 + 细边撑，
    // 不画真投影。原 14px #00000066 的黑影让框看起来比同配方的高亮设置
    // 「重一档」，用户实测点名不像。
    drop-shadow-blur: 26px;
    drop-shadow-color: transparent;
    // 内层布局已内缩 1px 避开边框（见下方 VerticalLayout 的注释），
    // 这里开 clip 只是防止列表行文字溢出圆角。
    clip: true;
    visible: root.open;

    // ── 滚动几何（#cmd-hint-scroll 2026-10-30）──────────────────────────
    // 行高 28px 与列表区内衬 3px 是本组件的基准数（多处引用，集中在这）。
    out property <length> row-h: 28px;
    out property <length> list-pad: 3px;
    // 可见行数 = min(候选数, 50)。高度按它算，所以 1↔3 条之间切换时
    // 框高度不变（高保真 §4 的「锁 3 行」）。
    // 数据侧可能给到几十条（HINT_MAX_ROWS=50），视图只开固定视口。
    out property <int> shown: min(root.rows.length, 50);
    // ★ 视口行数：1–3 条锁定 3 行；3–8 条跟着长；**超过 8 条不再长高**，
    //   改为框内滚动（用户实测「展示的有些少」5 → 8）。
    out property <int> list-rows: min(max(3, root.shown), 8);
    // ★ 自然高度必须**自己算**，不能读 `self.preferred-height`：
    //   根是 Rectangle，Slint 不会从内容反推 Rectangle 的 preferred-height
    //   （实测恒为 0，于是宿主侧的 min(自然高, 可用高) 完全失效）。
    //   两段固定 + 条件告警条：
    //     列表(list-rows*28+6) + 告警 30（仅危险命令）+ 脚注 23
    out property <length> natural-height:
        (root.list-rows * root.row-h + 6px)
        + (root.danger-token != "" ? 30px : 0px)
        + 23px;

    // ★ 键盘上下选择时把选中行滚进视口（#cmd-hint-scroll）：写入走
    //   list-scroll（ScrollView 的 content-y 镜像，负值域 0=顶/−max=底 ——
    //   见 history_panel.slint #hist-fix-keynav 同款坑）。ensure-selected-
    //   visible 是三段 clamp 的标准写法：行顶出视口 → 对齐顶；行底出视口 →
    //   对齐底；都不出 → 保持。
    function ensure-selected-visible() {
        if (root.rows.length == 0 || root.rows.length <= root.list-rows
                || root.selected < 0) {
            list-scroll = 0;
            return;
        }
        let row-top = root.list-pad + root.selected * root.row-h;
        let row-bottom = row-top + root.row-h;
        let win-h = root.list-rows * root.row-h + 6px;
        if (row-top < -list-scroll) {
            list-scroll = -row-top;
        } else if (row-bottom > -list-scroll + win-h) {
            list-scroll = -(row-bottom - win-h);
        }
    }

    changed selected => { root.ensure-selected-visible(); }
    // 候选集变化（新输入）→ 滚动位置归零：新列表从顶看起。
    // （selected 的复位由宿主做；这里只管滚动窗口。）
    changed rows => { list-scroll = 0; }
    // 滚动偏移（fluent content-y 负值域）。由下面的 ScrollView 双向绑定。
    property <length> list-scroll: 0px;

    // ★ 内层内容直接作为根的子级，由根统一裁切。
    //   边框由根 Rectangle 的 border 画，四段内容带直角背景；
    //   它们贴边但不越过根（根有 border-radius 收边）。
    // ★ 内层布局必须**内缩 1px**（四边各让出边框的位置）。
    //   Slint 的 Rectangle border 画在边界内侧，而子元素是画在边框**之上**的
    //   —— 内层段（告警 / 脚注）带背景且铺满全宽时，会把边框整整一圈盖掉。
    //   高保真用 CSS `overflow:hidden` 解决同一件事；Slint 的等价做法就是
    //   让内容避开边框那 1px。
    VerticalLayout {
        x: 1px;
        y: 1px;
        width: parent.width - 2px;
        height: parent.height - 2px;
        spacing: 0px;
        alignment: start;

        // ── ① 危险告警条（**条件渲染**，仅危险命令时出现在列表上方）────
        // 高保真 §3②：约 30px 单行。安全警示要醒目，但不值得为它常驻一整块
        // ——原「列表下方 94px 接管详情区」的结构随详情区一起退役。
        if root.danger-token != "" : Rectangle {
            height: 30px;
            // (#cmd-hint-chrome 2026-10-30) 告警条同样内衬 1px（顶角同脚注）。
            x: 1px;
            width: parent.width - 2px;
            clip: true;
            background: Theme.danger.with-alpha(0.13);

            Rectangle {
                y: 0px;
                width: parent.width;
                height: 1phx;
                background: Theme.danger.with-alpha(0.42);
            }

            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                spacing: 7px;
                Icon {
                    glyph: "warning";
                    tint: Theme.danger-strong;
                    size: 13px;
                    width: 13px;
                    height: 13px;
                    y: (parent.height - self.height) / 2;
                }
                Text {
                    // 模式原文不翻译（命令原文）；前缀走 i18n。
                    text: @tr("Dangerous command") + " · " + root.danger-token;
                    color: Theme.danger-strong;
                    font-size: Theme.fs-xs;
                    font-weight: Theme.fw-strong;
                    vertical-alignment: center;
                }
                Text {
                    text: root.danger-why;
                    color: Theme.text-secondary;
                    font-size: 10.5px;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
            }
        }

        // ── ② 候选列表（3–8 行，主体）───────────────────────────────────
        Rectangle {
            // 高保真 §4：候选 1→3 条时高度锁定在 3 行，超过才长高。
            // 28px 行高 + 上下 3px 内衬。
            height: root.list-rows * root.row-h + 6px;
            width: parent.width;
            background: transparent;
            clip: true;

            // (#cmd-hint-scroll 2026-10-30) 列表滚动：ScrollView 承载**全部行**
            // ——鼠标滚轮翻找、↑↓ 选中出视口自动跟随（ensure-selected-visible
            // 写 list-scroll，负值域）。滚动条整条去掉（#hist-round6 同款：
            // 灰柱丑；滚轮 + ↑↓ 已覆盖）。旧 Flickable 的 viewport-y 正值写入
            // 会把内容平移出视口（用户截图「往下滚看不到背景」），整段退役。
            list-scr := ScrollView {
                width: parent.width;
                height: parent.height;
                content-width: parent.width;
                content-height: max(self.height,
                    root.rows.length * root.row-h + 6px);
                content-y <=> list-scroll;
                vertical-scrollbar-policy: ScrollBarPolicy.always-off;

                VerticalLayout {
                    x: 0px;
                    y: root.list-pad;
                    width: parent.width;
                    height: root.rows.length * root.row-h;
                    spacing: 0px;
                    alignment: start;

                for r[idx] in root.rows : Rectangle {
                    height: root.row-h;
                    // (#cmd-hint-chrome 2026-10-30) 行高亮**内衬式**（历史面板同款）：
                    // 水平内衬 4px，不贴弹框边——原先全宽贴边的直角行背景在弹框
                    // 左上/右上角戳出 radius-xl 弧线之外 4~5px，把圆角线盖掉
                    // （用户截图：第一行背景超出了）。弹出即选中首条后该行永远
                    // 存在，问题必现；竖条也随内衬挪进来。
                    x: 4px;
                    width: parent.width - 8px;
                    border-radius: Theme.radius-sm;
                    background: idx == root.selected ? Theme.accent-soft
                              : (row-ta.has-hover ? Theme.bg-hover : transparent);

                    // 选中项左侧 2px 竖条（高保真 .hb-row.on::before）。
                    if idx == root.selected : Rectangle {
                        x: 0px;
                        y: 4px;
                        width: 2px;
                        height: parent.height - 8px;
                        border-radius: 1px;
                        background: Theme.accent;
                    }

                    row-ta := TouchArea {
                        // 悬停只发信号，不改选中 —— 鼠标扫过时列表不该自己跳。
                        pointer-event(e) => {
                            if (e.kind == PointerEventKind.move) {
                                root.hovered(idx);
                            }
                        }
                        clicked => { root.picked(idx); }
                    }

                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 7px;
                        spacing: 7px;
                        // ★ 别写 alignment: start —— 项目 pitfalls 点名的坑：
                        //   它会把主轴 flex_grow 全部归零，右侧的来源徽章
                        //   推不到行尾（用户实测：徽章悬在文本旁边）。
                        //   右对齐靠末尾的「吸空块」。

                        // 类型图标：快捷命令 bolt / 历史 时钟。
                        Icon {
                            glyph: r.kind == 1 ? "bolt" : "command-history";
                            tint: idx == root.selected ? Theme.accent
                                : (r.kind == 1 ? Theme.accent : Theme.text-muted);
                            size: 12px;
                            width: 12px;
                            height: 12px;
                            y: (parent.height - self.height) / 2;
                        }

                        // 主文本：等宽（命令原文）。占满剩余宽，副标题/徽章靠右。
                        Text {
                            text: r.text;
                            color: Theme.text-primary;
                            font-family: Theme.font-mono;
                            font-size: Theme.fs-xs;
                            vertical-alignment: center;
                            overflow: elide;
                            wrap: no-wrap;
                            horizontal-stretch: 1;
                        }

                        // 一句话副标题（说明长在行内，§3 定稿——详情区已退役）。
                        // 宽度不够先丢它（高保真：副标题是「扫视时可跳过」的信息）。
                        if r.subtitle != "" : Text {
                            text: r.subtitle;
                            color: Theme.text-secondary;
                            font-size: 10.5px;
                            vertical-alignment: center;
                            overflow: elide;
                            width: min(parent.width / 2, self.preferred-width);
                        }

                        // 来源徽章：**靠右**（吸空块在它后面不行——它自己就是
                        // 最后一个有宽度的元素，剩余空间由主文本的 stretch 吃掉）。
                        if r.source != "" : Rectangle {
                            height: 15px;
                            width: min(parent.width - 24px, src-tx.preferred-width + 8px);
                            border-radius: 3px;
                            y: (parent.height - self.height) / 2;
                            background: idx == root.selected ? Theme.accent-soft : transparent;
                            border-width: 1px;
                            border-color: idx == root.selected ? Theme.accent : Theme.border-subtle;
                            clip: true;
                            src-tx := Text {
                                text: r.source;
                                color: idx == root.selected ? Theme.accent : Theme.text-muted;
                                font-size: 9px;
                                font-family: Theme.font-mono;
                                vertical-alignment: center;
                                horizontal-alignment: center;
                                width: parent.width;
                                height: parent.height;
                            }
                        }
                    }
                }
            }
            }
        }

        // ── ③ 键盘脚注 23px ─────────────────────────────────────────────
        // §3③：六项常驻，并刻意不出现「Tab 填入」——Tab 已定稿**永远透传
        // shell**（§5），脚注本身就是这个契约的声明。键帽一律用英文字母
        // （用户定稿：↵/⇧ 符号不可用）。
        // (#cmd-hint-chrome 2026-10-30) 脚注水平内衬 1px：Slint 的 clip 是
        // 矩形裁切不认圆角，全宽直角底会盖掉底部两个圆角的弧线内缘
        // （与行高亮溢出同一机理）；让出边框那 1px 弧线就完整了。
        Rectangle {
            height: 23px;
            x: 1px;
            width: parent.width - 2px;
            background: Theme.bg-panel;

            Rectangle {
                y: 0px;
                width: parent.width;
                height: 1phx;
                background: Theme.slot-line.brighter(0.14);
            }

            HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                spacing: 9px;
                alignment: start;
                Text {
                    text: "↑↓ " + @tr("Select");
                    color: Theme.text-muted;
                    font-size: 10px;
                    vertical-alignment: center;
                }
                Text {
                    // (§7 定稿 2026-10-30 三轮) Enter = 填入选中候选并收框；
                    // 框关了 Enter 才执行当前输入。终端与命令栏同一契约。
                    text: "Enter " + @tr("Insert");
                    color: Theme.text-muted;
                    font-size: 10px;
                    vertical-alignment: center;
                }
                Text {
                    // Shift+Enter = 跳过填入直接执行选中候选（清行重打 + 回车）。
                    text: "Shift+Enter " + @tr("Run");
                    color: Theme.text-muted;
                    font-size: 10px;
                    vertical-alignment: center;
                }
                Text {
                    // 内联鬼影补全（词级 / 整行预测），Tab 归 shell 后的补命令捷径。
                    text: "→ " + @tr("Complete");
                    color: Theme.text-muted;
                    font-size: 10px;
                    vertical-alignment: center;
                }
                Text {
                    text: "Tab=shell";
                    color: Theme.text-muted;
                    font-size: 10px;
                    vertical-alignment: center;
                }
                Text {
                    text: "Esc " + @tr("Close");
                    color: Theme.text-muted;
                    font-size: 10px;
                    vertical-alignment: center;
                }
                Rectangle { horizontal-stretch: 1; }
            }
        }
    }
}
