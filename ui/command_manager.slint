// 命令管理弹框 —— 高保真落地（docs/design/quick-command-manager-hifi-2026-10-24.html）
//
// 结构（与稿子一一对应）：
//  ① 760×560：52px 头（图标块 + 标题 + 计数胶囊 · 搜索框 · 新建命令 · 关闭键）、
//     主体双栏（左 224 分组导航，可拖 180–320，双击复位；右卡片墙）、48px 完成条。
//  ② 左栏：全部命令 / 默认分组 / 「我的分组」小节 + 自定义组（计数、悬停 ↑↓、
//     拖拽排序、双击行内改名、拖卡落点 +N）；底部虚线「新建分组」吸底。
//  ③ 右栏：单组视图 46px 组头（双击改名 / 全选 / 删组入口 → 删除条选去向）；
//     「全部命令」视图无头部。卡片 2 列：徽章 28 + 名称/备注 + 右上发送方式
//     图标钮（点一下即切换）+ 两行 mono 预览 + 底部分组 chip（跳转）与悬停操作。
//  ④ 卡片操作：单删二段式（垃圾桶 → 原地红底「确认」，点别处取消，底栏常驻
//     警告）；复制 = 命令进剪贴板；↑↓ 相邻移动；双击卡片进编辑。
//  ⑤ 勾选（组视图，点卡片任意处；Shift 范围）浮出批量条：已选 N / 全选 /
//     移动至 ▾ / 删除（内联确认）/ ✕。拖已勾选多卡 = 整块。
//  ⑥ 拖拽：卡到左栏组行 = 移动（+N 徽标）；卡之间 = 排序（四向插入线，
//     全部命令 = 全局扁平序、单组 = 组内序；搜索态不排序）。
//  ⑦ 二级编辑卡（440px，弹框中央 + 内遮罩）：名称+分组同行（分组 = 新建会话
//     同款组合框：ghost 补全 / ▾ 勾选 / × 清空 / 动态描述四态 / 输入即建组）、
//     备注（note 字段）、命令多行、「使用时」两档滑动分段（填入/执行）。
//  ⑧ 搜索：名称/命令/分组名三搜；左栏计数 命中/总数、0 命中压暗；空态三分支。
//  ⑨ 反馈：底栏状态行三态（常态隐藏 / 结果 flash 2.6s / 待删除警告常驻）。
//
// 与 group_manager.slint 同族语言（DialogClose / Scrim / 选中竖条 / 批量条 /
// 插入线 / 行内改名 commit_edit），落地约束也同：
//  · 布局子项不能设 x/y/width；Rectangle 没有 padding，要包 Layout。
//  · 组件函数不能带连字符；函数体没有 if/for，用三元；局部 let 不能二次赋值。
//  · 拖拽落点用「绝对坐标 − 内容原点 / 行高」推算；不缓存 absolute-position。
//  · 过滤/计数都在 Rust（Slint 字符串没有 contains，数组没有 filter）。
import { Theme } from "theme.slint";
import { Icon } from "icons.slint";
import { DialogClose, Scrim } from "widgets.slint";
import { SegGroup } from "seg.slint";
import { ScrollView } from "std-widgets.slint";

// 左栏一行 / 下拉菜单里的一项。key = 存储名（"" = 默认分组）或 "__all"；
// kind：0 = 全部命令（固定第一行）、1 = 默认分组（兜底，不可改名/删除/排序）、
// 2 = 自定义组。display = 显示名（"全部命令"/"默认分组"/组名）。
export struct CmGroupRow {
    key: string,
    display: string,
    count: int,
    hit: int,
    kind: int,
}

// 一张命令卡。key = Rust 侧 uid（弹框会话内稳定），picked/can-up/can-down/
// show-group 由 Rust 随视图算好；command 是原文本（预览区两行截断）。
export struct CmCard {
    key: string,
    name: string,
    note: string,
    command: string,
    group-key: string,
    group-display: string,
    send-enter: bool,
    picked: bool,
    can-up: bool,
    can-down: bool,
    show-group: bool,
}

// 左栏「我的分组 N」小节标题（同 gm GmCaption 语言）。
component CmCaption inherits Rectangle {
    in property <string> label;
    in property <int> count;
    height: 28px;
    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        padding-top: 4px;
        spacing: 7px;
        // (#cm-caption-badge 2026-10-25) 不写 alignment 时主轴默认 stretch：
        // label 与计数块会被一起拉宽，计数块于是拉成一枚长胶囊、数字也不居中
        // （用户截图）。靠左排 + 计数块定宽 = 稿子里的「我的分组 (7)」圆点。
        alignment: start;
        cross-axis-alignment: center;
        Text {
            text: root.label;
            color: Theme.text-secondary;
            font-size: 11.5px;
            font-weight: 600;
            vertical-alignment: center;
        }
        Rectangle {
            // 1–2 位数字 = 正圆（16×16，半径 8）；3 位以上按内容长出去，
            // 仍保持全圆角（半径 = 高的一半）。
            width: max(16px, cnt-num.preferred-width + 10px);
            height: 16px;
            border-radius: 8px;
            background: Theme.accent-soft;
            HorizontalLayout {
                alignment: center;
                cnt-num := Text {
                    text: root.count;
                    color: Theme.accent;
                    font-size: 10px;
                    font-family: Theme.font-mono;
                    font-weight: 600;
                    vertical-alignment: center;
                    horizontal-alignment: center;
                }
            }
        }
    }
}

// 空态里的文字按钮（清除搜索 / 去「全部命令」看）。
component CmLinkBtn inherits Rectangle {
    in property <string> label;
    callback clicked();
    height: 24px;
    border-radius: 6px;
    border-width: 1px;
    border-color: ta.has-hover ? Theme.accent.with-alpha(0.42) : Theme.mgr-line-strong;
    background: ta.has-hover ? Theme.accent.with-alpha(0.10) : transparent;
    ta := TouchArea {
        mouse-cursor: default;
        clicked => { root.clicked(); }
    }
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 12px;
        alignment: center;
        Text {
            text: root.label;
            color: ta.has-hover ? Theme.accent-solid : Theme.text-secondary;
            font-size: 11.5px;
            vertical-alignment: center;
        }
    }
}

// 批量条 / 删除条上的小按钮（26px、11.5px、ghost 描边）。
component CmSmBtn inherits Rectangle {
    in property <string> label;
    in property <bool> danger: false;
    in property <bool> solid: false;       // 确认态的实心红
    in property <length> btn-width: 0px;   // >0 = 定宽（两字按钮 54/64）
    in property <length> btn-height: 26px;
    callback clicked();
    height: root.btn-height;
    // 定宽（两字按钮 54/64）用 min/max 钉死；不定宽时按内容 preferred
    min-width: root.btn-width > 0px ? root.btn-width : 0px;
    max-width: root.btn-width > 0px ? root.btn-width : 100000px;
    border-radius: 6px;
    border-width: 1px;
    border-color: root.solid
        ? Theme.danger
        : (root.danger ? Theme.danger.with-alpha(0.34)
           : (ta.has-hover ? Theme.mgr-line-strong : Theme.mgr-line-strong));
    background: root.solid
        ? (ta.has-hover ? Theme.danger-strong : Theme.danger)
        : (root.danger
            ? (ta.has-hover ? Theme.danger.with-alpha(0.22) : Theme.danger.with-alpha(0.14))
            : (ta.has-hover ? Theme.bg-hover : transparent));
    animate background { duration: 100ms; }
    ta := TouchArea {
        mouse-cursor: default;
        clicked => { root.clicked(); }
    }
    HorizontalLayout {
        padding-left: root.btn-width > 0px ? 0px : 12px;
        padding-right: root.btn-width > 0px ? 0px : 12px;
        alignment: center;
        Text {
            text: root.label;
            color: root.solid
                ? white
                : (root.danger
                    ? (Theme.dark ? #ff8b84 : Theme.danger-strong)
                    : (ta.has-hover ? Theme.text-primary : Theme.text-secondary));
            font-size: 11.5px;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }
}

// 卡片右上角的发送方式图标钮（22px，恒 accent，只换图形：play=执行 / fill-in=填入）。
component CmSendBadge inherits Rectangle {
    in property <bool> send;
    out property <bool> hover: ta.has-hover;
    callback clicked();
    // 悬浮提示（高保真 title：切换说明文案由调用方给）
    in property <string> tip: "";
    callback tip-at(bool /*enter*/, length, length);
    callback tip-track(length, length);
    width: 22px;
    height: 22px;
    border-radius: 6px;
    background: ta.has-hover ? Theme.chip : transparent;
    animate background { duration: 100ms; }
    ta := TouchArea {
        mouse-cursor: default;
        clicked => { root.clicked(); }
        changed has-hover => {
            root.tip-at(self.has-hover,
                self.absolute-position.x + self.mouse-x,
                self.absolute-position.y + self.mouse-y);
        }
        pointer-event(ev) => {
            if (ev.kind == PointerEventKind.move && self.has-hover) {
                root.tip-track(self.absolute-position.x + self.mouse-x,
                    self.absolute-position.y + self.mouse-y);
            }
        }
    }
    Icon {
        glyph: root.send ? "play" : "fill-in";
        tint: Theme.accent-solid;
        size: 14px;
    }
}

// 悬停操作区的一枚 20px 小图标钮。
component CmActBtn inherits Rectangle {
    in property <string> glyph;
    in property <bool> danger: false;
    in property <bool> enabled: true;
    out property <bool> hover: ta.has-hover;
    callback clicked();
    // 悬浮提示（高保真 title 属性的落地：文案由调用方给，坐标贴指针）
    in property <string> tip: "";
    callback tip-at(bool /*enter*/, length, length);
    callback tip-track(length, length);
    width: 20px;
    height: 20px;
    border-radius: 4px;
    opacity: root.enabled ? 1.0 : 0.28;
    background: !root.enabled ? transparent
        : (ta.has-hover
            ? (root.danger ? Theme.danger.with-alpha(0.16) : Theme.bg-hover)
            : transparent);
    animate background { duration: 80ms; }
    ta := TouchArea {
        mouse-cursor: default;
        enabled: root.enabled;
        clicked => { root.clicked(); }
        changed has-hover => {
            root.tip-at(self.has-hover,
                self.absolute-position.x + self.mouse-x,
                self.absolute-position.y + self.mouse-y);
        }
        pointer-event(ev) => {
            if (ev.kind == PointerEventKind.move && self.has-hover) {
                root.tip-track(self.absolute-position.x + self.mouse-x,
                    self.absolute-position.y + self.mouse-y);
            }
        }
    }
    Icon {
        glyph: root.glyph;
        tint: root.enabled
            ? (root.danger && ta.has-hover ? (Theme.dark ? #ff8b84 : Theme.danger-strong)
               : (root.danger ? Theme.danger : Theme.text-muted))
            : Theme.text-muted;
        size: root.glyph == "arrow-up" || root.glyph == "arrow-down" ? 10px : 11px;
    }
}

// 一张命令卡（网格槽位）。手势全在这里：点击 = 勾选（组视图）、双击 = 编辑、
// 按住拖 >5px = 起拖（分派回根组件算落点）。
component CmCardSlot inherits Rectangle {
    in property <CmCard> card;
    in property <bool> lang-en;
    in property <bool> is-all;         // 「全部命令」视图：无勾选
    in property <bool> armed;          // 单删二段式：确认态常驻显示操作组
    in property <bool> dragging;       // 这张卡正在被拖（含整块）
    in property <int> ins-mode;        // 插入指示：-1 无 / 0 上 / 1 下 / 2 左 / 3 右
    in property <int> picked-count;

    callback toggle-pick(string /* key */, bool /* shift */);
    callback open-edit(string, string, string, string, string, string, bool);
    callback step(string /* key */, int /* dir */);
    callback copy-cmd(string /* key */);
    callback arm(string /* key */);
    callback confirm-del(string /* key */);
    callback toggle-send(string /* key */);
    callback jump(string /* group key */);
    callback press(string /* key */);
    callback card-drag-start(string /* key */, length /* ax */, length /* ay */, int /* n */);
    callback card-dropped();
    // 悬浮提示转发（高保真各按钮 title → 根的 tip 浮层）
    callback tip-armed(string, length, length);
    callback tip-armed2(bool /*enter*/, string, length, length);
    callback tip-move(length, length);
    callback tip-clear();

    property <length> press-x: 0px;
    property <length> press-y: 0px;

    border-radius: 9px;
    border-width: 1px;
    border-color: root.armed
        ? Theme.danger.with-alpha(0.34)
        : (root.card.picked
            ? Theme.accent.with-alpha(0.42)
            : (card-ta.has-hover || acts-hover() ? Theme.mgr-line-strong : Theme.mgr-line));
    background: root.armed
        ? Theme.danger.with-alpha(0.06)
        : (root.card.picked
            ? Theme.accent.with-alpha(Theme.dark ? 0.10 : 0.08)
            : (card-ta.has-hover || acts-hover() ? Theme.popup-field-2 : Theme.popup-field));
    opacity: root.dragging ? 0.4 : 1.0;
    animate background { duration: 100ms; }

    function acts-hover() -> bool {
        // 不含确认钮：它现在挂在 `if root.armed` 里（条件元素内的 id 出不了
        // 作用域），而 armed 本身就走 danger 配色，不再需要这一个悬停位。
        return up-btn.hover || down-btn.hover || edit-btn.hover
            || dup-btn.hover || del-btn.hover
            || chip-ta.has-hover || send-ta.hover;
    }

    card-ta := TouchArea {
        mouse-cursor: default;
        clicked => {
            // 「全部命令」视图无勾选（跨组挑选冗余；跨组操作走拖拽+悬停单条钮）
            if (root.is-all) { return; }
            root.press(root.card.key);
            root.toggle-pick(root.card.key, false);
        }
        double-clicked => {
            root.open-edit(root.card.key, root.card.name, root.card.note,
                root.card.command, root.card.group-key, root.card.group-display,
                root.card.send-enter);
        }
        pointer-event(ev) => {
            if (ev.kind == PointerEventKind.down) {
                root.press-x = self.absolute-position.x + self.mouse-x;
                root.press-y = self.absolute-position.y + self.mouse-y;
            } else if (ev.kind == PointerEventKind.move && self.pressed) {
                let ax = self.absolute-position.x + self.mouse-x;
                let ay = self.absolute-position.y + self.mouse-y;
                let dx = ax - root.press-x;
                let dy = ay - root.press-y;
                // >5px 才算拖动手势（纯点击不会误拖）；起拖/移动统一交给根
                // 组件分派（根函数内部判「已起拖 = 只更新落点」）
                if (dx > -5px && dx < 5px && dy > -5px && dy < 5px) { return; }
                let n = root.card.picked && root.picked-count > 1
                    ? root.picked-count : 1;
                root.card-drag-start(root.card.key, ax, ay, n);
            } else if (ev.kind == PointerEventKind.up) {
                root.card-dropped();
            }
        }
    }

    VerticalLayout {
        padding-left: 11px;
        padding-right: 11px;
        padding-top: 9px;
        padding-bottom: 8px;
        spacing: 5px;

        // 卡片头：徽章 + 名称/备注堆叠 + 右上发送方式钮
        HorizontalLayout {
            spacing: 10px;
            // 徽章 28×28（与标题图标块同款）；图标三态：
            // 勾选 = checkbox / 悬停（可勾选视图未勾选）= checkbox-blank / 常态 = command-bar
            Rectangle {
                width: 28px;
                height: 28px;
                border-radius: 8px;
                background: Theme.accent-soft;
                Icon {
                    glyph: root.card.picked ? "checkbox"
                        : (card-ta.has-hover && !root.is-all ? "checkbox-blank" : "command-bar");
                    tint: Theme.accent-solid;
                    size: root.card.picked || (card-ta.has-hover && !root.is-all) ? 16px : 18px;
                }
            }
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                spacing: 2px;
                Text {
                    text: root.card.name;
                    color: Theme.text-primary;
                    font-size: 12.5px;
                    font-weight: 600;
                    overflow: elide;
                }
                if root.card.note != "" : Text {
                    text: root.card.note;
                    color: Theme.text-muted;
                    font-size: 10.5px;
                    overflow: elide;
                }
            }
            send-ta := CmSendBadge {
                send: root.card.send-enter;
                tip: root.card.send-enter
                    ? (root.lang-en ? "On use: fill + Enter to run (click to switch)" : "使用时：填入并回车执行（点击切换为填入）")
                    : (root.lang-en ? "On use: fill the command bar only (click to switch)" : "使用时：只填入命令栏，不改后执行（点击切换为执行）");
                clicked => { root.toggle-send(root.card.key); }
                tip-at(enter, ax, ay) => {
                    if (enter) { root.tip-armed(send-ta.tip, ax, ay); } else { root.tip-clear(); }
                }
                tip-track(ax, ay) => { root.tip-move(ax, ay); }
            }
        }

        // 两行 mono 预览（固定高 33px 截断 = line-clamp 2 语义）
        Rectangle {
            height: 33px;
            clip: true;
            Text {
                width: parent.width;
                text: root.card.command;
                color: Theme.text-secondary;
                font-size: 10.5px;
                font-family: Theme.font-mono;
                wrap: word-wrap;
                overflow: elide;
            }
        }

        // 底行：分组 chip（跨组视图显示、点击跳组）+ 悬停操作（确认态常驻）
        HorizontalLayout {
            spacing: 6px;
            height: 20px;
            Rectangle {
                visible: root.card.show-group;
                height: 20px;
                border-radius: 10px;
                background: chip-ta.has-hover ? Theme.accent-soft : Theme.bg-active;
                animate background { duration: 100ms; }
                chip-ta := TouchArea {
                    mouse-cursor: default;
                    clicked => { root.jump(root.card.group-key); }
                    changed has-hover => {
                        root.tip-armed2(self.has-hover,
                            (root.lang-en ? "Go to group " : "跳转到「") + root.card.group-display + (root.lang-en ? "" : "」分组"),
                            self.absolute-position.x + self.mouse-x,
                            self.absolute-position.y + self.mouse-y);
                    }
                    pointer-event(ev) => {
                        if (ev.kind == PointerEventKind.move && self.has-hover) {
                            root.tip-move(self.absolute-position.x + self.mouse-x,
                                self.absolute-position.y + self.mouse-y);
                        }
                    }
                }
                HorizontalLayout {
                    // (#cm-chip-center 2026-10-25) 不写 alignment 时主轴默认
                    // stretch：Text 被撑满剩余宽度、文字靠左，右侧留一大块空白
                    // （用户截图「文字不居中，右侧比较空」）。居中 + 左右对称
                    // padding，chip 才与稿子 `.c-grp{padding:3px 7px 3px 5px}`
                    // 的观感一致。
                    padding-left: 6px;
                    padding-right: 6px;
                    spacing: 5px;
                    alignment: center;
                    cross-axis-alignment: center;
                    Rectangle {
                        width: 6px;
                        height: 6px;
                        border-radius: 3px;
                        background: chip-ta.has-hover ? Theme.accent-solid : Theme.text-muted;
                    }
                    Text {
                        text: root.card.group-display;
                        color: chip-ta.has-hover ? Theme.accent-solid : Theme.text-muted;
                        font-size: 10px;
                        font-family: Theme.font-mono;
                        vertical-alignment: center;
                        horizontal-alignment: center;
                        overflow: elide;
                    }
                }
            }
            Rectangle { horizontal-stretch: 1; height: 1px; }
            // 操作组：悬停渐显。武装态五个钮只是不显示 —— **宽度照旧**，
            // 卡片的 preferred-width（= 网格列宽）因此完全不变；红底「确认」
            // 是卡片根上的绝对定位块，原地盖住删除钮（见下方 CmCardSlot 根）。
            HorizontalLayout {
                spacing: 1px;
                alignment: end;
                opacity: root.armed || card-ta.has-hover || acts-hover() ? 1.0 : 0.0;
                animate opacity { duration: 120ms; }
                up-btn := CmActBtn {
                    visible: !root.armed;
                    glyph: "arrow-up";
                    enabled: root.card.can-up;
                    tip: root.card.can-up ? (root.lang-en ? "Move up" : "上移") : (root.lang-en ? "At top" : "已在首位");
                    clicked => { root.step(root.card.key, -1); }
                    tip-at(enter, ax, ay) => {
                        if (enter) { root.tip-armed(up-btn.tip, ax, ay); } else { root.tip-clear(); }
                    }
                    tip-track(ax, ay) => { root.tip-move(ax, ay); }
                }
                down-btn := CmActBtn {
                    visible: !root.armed;
                    glyph: "arrow-down";
                    enabled: root.card.can-down;
                    tip: root.card.can-down ? (root.lang-en ? "Move down" : "下移") : (root.lang-en ? "At bottom" : "已在末位");
                    clicked => { root.step(root.card.key, 1); }
                    tip-at(enter, ax, ay) => {
                        if (enter) { root.tip-armed(down-btn.tip, ax, ay); } else { root.tip-clear(); }
                    }
                    tip-track(ax, ay) => { root.tip-move(ax, ay); }
                }
                edit-btn := CmActBtn {
                    visible: !root.armed;
                    glyph: "edit";
                    tip: root.lang-en ? "Edit" : "编辑";
                    clicked => {
                        root.open-edit(root.card.key, root.card.name, root.card.note,
                            root.card.command, root.card.group-key, root.card.group-display,
                            root.card.send-enter);
                    }
                    tip-at(enter, ax, ay) => {
                        if (enter) { root.tip-armed(edit-btn.tip, ax, ay); } else { root.tip-clear(); }
                    }
                    tip-track(ax, ay) => { root.tip-move(ax, ay); }
                }
                dup-btn := CmActBtn {
                    visible: !root.armed;
                    glyph: "copy";
                    tip: root.lang-en ? "Copy command" : "复制命令";
                    clicked => { root.copy-cmd(root.card.key); }
                    tip-at(enter, ax, ay) => {
                        if (enter) { root.tip-armed(dup-btn.tip, ax, ay); } else { root.tip-clear(); }
                    }
                    tip-track(ax, ay) => { root.tip-move(ax, ay); }
                }
                del-btn := CmActBtn {
                    visible: !root.armed;
                    glyph: "delete";
                    danger: true;
                    tip: root.lang-en ? "Delete" : "删除";
                    clicked => { root.arm(root.card.key); }
                    tip-at(enter, ax, ay) => {
                        if (enter) { root.tip-armed(del-btn.tip, ax, ay); } else { root.tip-clear(); }
                    }
                    tip-track(ax, ay) => { root.tip-move(ax, ay); }
                }
            }
        }
    }

    // 单删二段式的确认钮（#cm-confirm-inplace 2026-10-25）：**绝对定位在卡片
    // 右下角**，右缘/下缘与删除钮同参（padding 11 / 8、20 高），看起来就是
    // 删除钮原地变成红底「确认」。
    // ⚠️ 不能塞进底行的操作组：那里五个图标钮 `visible: false` 仍占 20px 宽，
    // 把确认钮排在组内会被顶到卡片中间（用户截图）；而把五个钮的宽度归零会让
    // 卡片的 preferred-width 一起缩，网格列宽从 247 掉到 211，整块卡片跟着
    // 重新排版 —— 两种都不行。绝对定位不参与布局，卡片纹丝不动。
    if root.armed : Rectangle {
        x: parent.width - 11px - self.width;
        y: parent.height - 8px - self.height;
        // 宽度按文案算（英文 "Confirm" 比「确认」宽），右缘固定，只向左扩。
        width: max(34px, ok-label.preferred-width + 14px);
        height: 20px;
        border-radius: 4px;
        background: ok-ta.has-hover ? Theme.danger-strong : Theme.danger;
        animate background { duration: 100ms; }
        ok-ta := TouchArea {
            mouse-cursor: default;
            clicked => { root.confirm-del(root.card.key); }
            changed has-hover => {
                root.tip-armed2(self.has-hover,
                    root.lang-en ? "Confirm delete this command" : "确认删除这条命令",
                    self.absolute-position.x + self.mouse-x,
                    self.absolute-position.y + self.mouse-y);
            }
            pointer-event(ev) => {
                if (ev.kind == PointerEventKind.move && self.has-hover) {
                    root.tip-move(self.absolute-position.x + self.mouse-x,
                        self.absolute-position.y + self.mouse-y);
                }
            }
        }
        HorizontalLayout {
            padding-left: 7px;
            padding-right: 7px;
            alignment: center;
            ok-label := Text {
                text: root.lang-en ? "Confirm" : "确认";
                color: white;
                font-size: 10px;
                font-weight: 600;
                vertical-alignment: center;
            }
        }
    }

    // 四向插入指示线（2px accent + 3px 光晕），方向随网格几何
    if root.ins-mode == 0 : Rectangle {
        x: 6px;
        y: -5px;
        width: parent.width - 12px;
        height: 2px;
        border-radius: 1px;
        background: Theme.accent-solid;
    }
    if root.ins-mode == 1 : Rectangle {
        x: 6px;
        y: parent.height + 3px;
        width: parent.width - 12px;
        height: 2px;
        border-radius: 1px;
        background: Theme.accent-solid;
    }
    if root.ins-mode == 2 : Rectangle {
        x: -5px;
        y: 6px;
        width: 2px;
        height: parent.height - 12px;
        border-radius: 1px;
        background: Theme.accent-solid;
    }
    if root.ins-mode == 3 : Rectangle {
        x: parent.width + 3px;
        y: 6px;
        width: 2px;
        height: parent.height - 12px;
        border-radius: 1px;
        background: Theme.accent-solid;
    }
}

export component CommandManagerDialog inherits Rectangle {
    in property <bool> lang-en;
    in property <bool> open;
    // 当前视图："__all" = 全部命令；"" = 默认分组；其余 = 组名。
    in-out property <string> selected: "__all";
    in property <[CmGroupRow]> groups;        // 左栏全部行（含「全部命令」）
    in property <[CmGroupRow]> menu-groups;   // 默认分组 + 自定义组（下拉/菜单/去向）
    in property <[CmCard]> cards;             // 当前视图卡片（已按搜索过滤）
    in property <int> picked-count;
    in property <bool> all-picked;            // 当前视图是否全部勾上
    in property <int> custom-count;           // 自定义组数（小节徽章 + 副标题）
    in property <int> total-count;            // 命令总数
    in property <string> cur-name;            // 右栏头部显示名
    in property <int> cur-count;              // 当前组命令总数（未过滤）
    in property <bool> cur-custom;            // 当前是自定义组（可删）
    in property <int> cur-index;              // 当前视图在左栏中的行号（键盘 ↑↓）
    in property <int> view-count;             // 当前视图可见卡数（cards.length）
    in property <string> subtitle;            // 头部计数胶囊文案
    in property <int> search-hits;            // 全局命中数（空态分支）
    in property <string> search-jump;         // 「别处还有命中」的跳转组
    in property <bool> has-any;               // 一条命令都没有（空态分支）

    callback close();
    callback search(string /* query */);
    callback select(string /* group key */);
    callback validate-group(string /* text */, string /* orig */) -> string;
    callback rename-group(string /* orig */, string /* name */) -> string;
    callback create-group(string /* name */) -> string;
    callback remove-group(string /* name */, string /* target */);
    callback move-group(string /* group */, int /* dir */);
    callback reorder-group(string /* drag */, string /* target */, bool /* after */);
    callback save-cmd(string /* key(""=new) */, string /* name */, string /* note */,
        string /* command */, string /* group */, bool /* send */) -> string;
    callback copy-cmd(string /* key */);
    callback del-cmd(string /* key */);
    callback toggle-send(string /* key */);
    callback toggle-pick(string /* key */, bool /* shift */);
    callback clear-picks();
    callback set-all-picked(bool /* on */);
    callback move-picked(string /* target */) -> int;
    callback del-picked() -> int;
    callback step-cmd(string /* key */, int /* dir */);
    callback drop-group(string /* key */, string /* target */) -> int;
    callback drop-cards(string /* key */, string /* before-key */, bool /* after */) -> int;
    // 空态「从预置导入」（#preset-commands）：注入出厂清单，返回实际导入条数。
    callback import-presets() -> int;

    // ── 弹框内临时态（不落盘）──
    in-out property <string> query: "";
    in-out property <string> toast: "";
    in-out property <bool> toast-error: false;
    // 行内改名 / 新建分组（同 gm：commit_edit 闸门）
    in-out property <string> editing: "";
    in-out property <string> editing-text: "";
    in-out property <string> editing-error: "";
    in-out property <bool> creating: false;
    in-out property <string> edit-where: "";
    // 删除条（组视图）
    in-out property <string> confirm-del: "";
    in-out property <string> del-target: "";
    in-out property <bool> del-menu: false;
    in-out property <length> del-menu-x: 0px;
    // 单删二段式：武装中的卡 key
    in-out property <string> armed: "";
    // 批量条
    in-out property <bool> batch-confirm: false;
    in-out property <bool> move-menu: false;
    // 「移动至」菜单锚点：按钮中心的**窗口绝对** x（菜单在右栏容器里，定位时
    // 减去 rcol.absolute-position.x 换算成局部坐标 —— 存相对弹窗的坐标会让菜单
    // 整体右移一个左栏宽度，#cm-move-menu-anchor）。
    in-out property <length> move-menu-x: 0px;
    // 二级编辑卡
    in-out property <bool> ed-open: false;
    in-out property <string> ed-mode: "new";       // "new" | "edit"
    in-out property <string> ed-key: "";
    in-out property <string> ed-name: "";
    in-out property <string> ed-note: "";
    in-out property <string> ed-cmd: "";
    in-out property <string> ed-group: "";
    in-out property <bool> ed-send: false;
    in-out property <bool> ed-name-err: false;
    in-out property <bool> ed-cmd-err: false;
    in-out property <bool> gc-pop: false;
    // 左栏宽度（默认 224，拖 180–320，双击复位）
    in-out property <length> left-w: 224px;
    // 二级编辑卡的宽度与「名称 / 分组」两列的列宽。
    // (#cm-ed-cols 2026-10-25) 两列都写 `horizontal-stretch: 1` 只保证"都能长"，
    // 宽度 = preferred + 按 stretch 均分的剩余量 —— 两列 preferred 不同（分组列
    // 多了 hint 与 ▾），结果就是名称框明显比分组框窄（用户截图：两框大小不一致）。
    // 改成把卡宽算出来、两列都钉死成同一半宽，才是稿子里的 minmax(0,1fr) 等分。
    // 44 = 表单左右 padding 16×2 + 列间距 12。
    property <length> ed-card-w: min(440px, self.width - 32px);
    property <length> ed-col-w: (root.ed-card-w - 44px) / 2;
    in-out property <bool> sp-on: false;
    in-out property <length> sp-start: 0px;
    in-out property <length> sp-base: 224px;
    // 键盘 ↑↓ / Space 的落点
    in-out property <string> press-card: "";
    // 拖拽（卡 / 组行两种手势互斥）
    in-out property <bool> dragging: false;
    in-out property <string> drag-kind: "";        // "card" | "group"
    in-out property <string> drag-key: "";
    in-out property <string> drag-label: "";
    in-out property <length> drag-abs-x: -1000px;
    in-out property <length> drag-abs-y: -1000px;
    in-out property <bool> over-group: false;      // 指针在左栏组行上（drag 落点分派用）
    in-out property <int> drop-gi: -1;
    in-out property <bool> g-ins-after: false;     // 组拖拽：插到目标行之后
    in-out property <int> drag-insert-slot: -1;    // 插入指示目标卡下标
    in-out property <int> drag-ins: -1;            // 0 top/1 bottom/2 left/3 right
    in-out property <length> press-x: 0px;
    in-out property <length> press-y: 0px;
    // 拖拽命中的几何快照（if open 内元素在每次手势回调里刷新；根函数只读这些）
    in-out property <length> geo-left-edge: 0px;
    in-out property <length> geo-glay-y: 0px;
    in-out property <length> geo-mgrid-x: 0px;
    in-out property <length> geo-mgrid-y: 0px;
    in-out property <length> geo-mgrid-w: 0px;
    // 弹框拖动
    in-out property <length> win-dx: 0px;
    in-out property <length> win-dy: 0px;
    in-out property <bool> win-dragging: false;
    in-out property <length> win-start-x: 0px;
    in-out property <length> win-start-y: 0px;
    in-out property <length> win-base-x: 0px;
    in-out property <length> win-base-y: 0px;

    property <bool> is-all: root.selected == "__all";
    // 键盘焦点脉冲：行内输入框（改名/新建分组/编辑卡）销毁或提交后，焦点
    // 会掉回 window 层，Esc 就到不了弹框的 FocusScope —— 每次「收起输入态」
    // 都 +1，fs 盯着它把自己重新推上焦点链。
    property <int> focus-pulse: 0;

    // ── 几何常量 ──
    property <length> row-h: 36px;      // 左栏组行
    property <length> cap-h: 28px;      // 「我的分组」小节
    property <length> card-h: 108px;    // 卡高（固定：徽章28+5+预览33+5+底行20+上下内衬）
    property <length> card-gap: 8px;
    property <length> card-row-h: root.card-h + root.card-gap;
    // (#cm-card-eq 2026-10-26) 列宽**必须由行宽算**，不能让每行自己分：行内两张卡
    // 的 preferred 宽度随命令/备注文字长度走，Slint 的 box layout 以 pref 为起点
    // 再均摊余量 → 同一列在不同行宽度不同（用户截图实测 229/289/299/191 四种，
    // 最窄那行的分组 chip 被压成「…」）。列宽 = (行宽 − 列间距) / 2，行宽由
    // mgrid 决定（网格横向内衬 14×2），故行内算好后两张卡都取它。

    function flash(m: string) {
        root.toast = m;
        root.toast-error = false;
    }
    function flash-bad(m: string) {
        root.toast = m;
        root.toast-error = true;
    }

    // 进入行内改名（双击左栏组名 / 右栏头部组名）
    function start-edit(name: string) {
        root.editing = name;
        root.editing-text = name;
        root.editing-error = "";
        root.creating = false;
    }

    // 确认改名 / 新建（Enter / 点空白 / 关闭前）。返回 false = 名字非法，
    // 调用方不得继续关窗 / 切组 / 开编辑卡。
    function commit-edit() -> bool {
        let active = root.creating || root.editing != "";
        if (!active) { return true; }
        if (root.editing-text == "") {
            root.editing = "";
            root.creating = false;
            root.editing-text = "";
            root.editing-error = "";
            root.edit-where = "";
            root.focus-pulse += 1;
            return true;
        }
        let err = root.creating
            ? root.create-group(root.editing-text)
            : root.rename-group(root.editing, root.editing-text);
        let ok = err == "";
        root.editing-error = ok ? "" : err;
        if (!ok && !root.creating && root.edit-where == "left") {
            root.flash-bad(root.editing-error);
        }
        if (ok) {
            root.editing = "";
            root.creating = false;
            root.editing-text = "";
            root.edit-where = "";
            root.focus-pulse += 1;
        }
        return ok;
    }

    // 取消单删武装态
    function cancel-armed() {
        if (root.armed != "") { root.armed = ""; }
    }

    // ── 悬浮提示（高保真各按钮的 title）：150ms 出、跟指针、移开即收 ──
    in-out property <string> tip-text: "";
    in-out property <length> tip-ax: 0px;   // 指针绝对坐标（窗口系）
    in-out property <length> tip-ay: 0px;
    in-out property <bool> tip-show: false;
    tip-timer := Timer {
        interval: 150ms;
        running: root.tip-text != "";
        triggered => { root.tip-show = true; }
    }
    function tip-on(text: string, ax: length, ay: length) {
        root.tip-text = text;
        root.tip-ax = ax;
        root.tip-ay = ay;
        root.tip-show = false;   // 换目标重新计 150ms
    }
    function tip-at(ax: length, ay: length) {
        root.tip-ax = ax;
        root.tip-ay = ay;
    }
    function tip-off() {
        root.tip-text = "";
        root.tip-show = false;
    }

    // 结果提示 2.6s 回落；错误（待删除警告 / 重名）不自动消失
    toast-timer := Timer {
        interval: 2600ms;
        running: root.toast != "" && !root.toast-error;
        triggered => { root.toast = ""; }
    }

    changed ed-open => {
        if (!root.ed-open) {
            root.focus-pulse += 1;
        }
    }

    changed open => {
        if (root.open) {
            // 打开瞬间把键盘焦点拉回弹框层：fs 的 init focus 抢不过「快捷浮层
            // 关闭后焦点归还终端」的时序，首按 F2/Esc 会丢给终端输入框
            root.focus-pulse += 1;
        }
        if (!root.open) {
            tip-off();
            root.armed = "";
            root.confirm-del = "";
            root.del-menu = false;
            root.move-menu = false;
            root.batch-confirm = false;
            root.ed-open = false;
            root.gc-pop = false;
            root.editing = "";
            root.creating = false;
            root.editing-error = "";
            root.edit-where = "";
            root.drop-gi = -1;
            root.dragging = false;
            root.drag-kind = "";
            root.drag-insert-slot = -1;
            root.press-card = "";
            root.win-dx = 0px;
            root.win-dy = 0px;
            root.win-dragging = false;
        }
    }

    width: 100%;
    height: 100%;

    if root.open : Rectangle {
        width: 100%;
        height: 100%;
        // 显式透明：遮罩由 Scrim 组件画（tests/dialog_scrim_drag 的遮罩来源
        // 审计要求覆盖层底不写色值）。
        background: transparent;

        Scrim { }
        TouchArea {
            width: 100%;
            height: 100%;
            clicked => { if (commit-edit()) { root.close(); } }
        }

        cm := Rectangle {
            x: (parent.width - self.width) / 2 + root.win-dx;
            y: (parent.height - self.height) / 2 + root.win-dy;
            width: min(760px, parent.width - 32px);
            height: min(560px, parent.height - 32px);
            background: Theme.popup-bg;
            border-radius: Theme.radius-lg;
            border-width: 1px;
            border-color: Theme.mgr-line-strong;
            clip: true;

            // 弹框内空白：拖动弹框；点空白 = 确认行内编辑 + 收起浮层 + 取消武装
            bg-ta := TouchArea {
                pointer-event(ev) => {
                    if (ev.kind == PointerEventKind.down) {
                        root.win-start-x = self.absolute-position.x + self.mouse-x;
                        root.win-start-y = self.absolute-position.y + self.mouse-y;
                        root.win-base-x = root.win-dx;
                        root.win-base-y = root.win-dy;
                        root.win-dragging = false;
                    } else if (ev.kind == PointerEventKind.up) {
                        if (!root.win-dragging) {
                            commit-edit();
                            cancel-armed();
                            root.move-menu = false;
                            root.del-menu = false;
                            root.gc-pop = false;
                            root.focus-pulse += 1;
                        }
                        root.win-dragging = false;
                    }
                }
                moved => {
                    let ax = self.absolute-position.x + self.mouse-x;
                    let ay = self.absolute-position.y + self.mouse-y;
                    let dx = ax - root.win-start-x;
                    let dy = ay - root.win-start-y;
                    if (!root.win-dragging
                        && (dx > 3px || dx < -3px || dy > 3px || dy < -3px)) {
                        root.win-dragging = true;
                    }
                    if (root.win-dragging) {
                        let sx = Math.max(0px, (root.width - cm.width) / 2);
                        let sy = Math.max(0px, (root.height - cm.height) / 2);
                        root.win-dx = Math.max(-sx, Math.min(sx, root.win-base-x + dx));
                        root.win-dy = Math.max(-sy, Math.min(sy, root.win-base-y + dy));
                    }
                }
            }

            // Esc 逐级退出：编辑卡 → 批量确认 → 单删武装 → 行内编辑 → 勾选 →
            // 搜索 → 关窗；Ctrl+F 聚焦搜索；Ctrl+N 新建；↑↓ 切组；Space 勾选。
            fs := FocusScope {
                x: 0px;
                y: 0px;
                width: 100%;
                height: 100%;
                init => { self.focus(); }
                property <int> pulse: root.focus-pulse;
                changed pulse => { self.focus(); }
                key-pressed(ev) => {
                    if (ev.text == Key.Escape) {
                        if (root.ed-open) {
                            root.ed-open = false;
                            root.gc-pop = false;
                        } else if (root.batch-confirm) {
                            root.batch-confirm = false;
                        } else if (root.armed != "") {
                            root.armed = "";
                        } else if (root.editing != "" || root.creating) {
                            root.editing = "";
                            root.creating = false;
                            root.editing-error = "";
                        } else if (root.move-menu || root.del-menu) {
                            root.move-menu = false;
                            root.del-menu = false;
                        } else if (root.confirm-del != "") {
                            root.confirm-del = "";
                        } else if (root.picked-count > 0) {
                            root.clear-picks();
                        } else if (root.query != "") {
                            root.query = "";
                            root.search("");
                        } else {
                            root.close();
                        }
                        return accept;
                    }
                    if (root.ed-open) {
                        if (ev.modifiers.control && ev.text == Key.Return) {
                            save-editor();
                            return accept;
                        }
                        return reject;
                    }
                    if (root.editing != "" || root.creating) { return reject; }
                    if (ev.modifiers.control && (ev.text == "f" || ev.text == "F")) {
                        q-input.focus();
                        return accept;
                    }
                    if (ev.modifiers.control && (ev.text == "n" || ev.text == "N")) {
                        open-editor-new();
                        return accept;
                    }
                    if (ev.text == Key.UpArrow || ev.text == Key.DownArrow) {
                        if (q-input.has-focus) { return reject; }
                        let d = ev.text == Key.UpArrow ? -1 : 1;
                        let to = Math.max(0, Math.min(root.groups.length - 1,
                            root.cur-index + d));
                        if (to != root.cur-index && to >= 0 && to < root.groups.length) {
                            let g = root.groups[to];
                            if (!commit-edit()) { return accept; }
                            root.cancel-armed();
                            root.selected = g.key;
                            root.confirm-del = "";
                            root.batch-confirm = false;
                            root.press-card = "";
                            root.clear-picks();
                            root.select(root.selected);
                        }
                        return accept;
                    }
                    if (ev.text == " " && root.press-card != "" && !root.is-all) {
                        root.toggle-pick(root.press-card, false);
                        return accept;
                    }
                    if (ev.text == Key.Delete) {
                        if (root.picked-count > 0) {
                            root.batch-confirm = true;
                        } else if (!root.is-all && root.cur-custom && root.confirm-del == "") {
                            root.confirm-del = root.selected;
                            root.del-target = "";
                        }
                        return accept;
                    }
                    if (ev.text == Key.F2 && root.cards.length > 0) {
                        let c0 = root.cards[0];
                        open-editor-edit(c0.key, c0.name, c0.note, c0.command,
                            c0.group-key, c0.group-display, c0.send-enter);
                        return accept;
                    }
                    if (ev.text == Key.Return && root.armed != "") {
                        root.del-cmd(root.armed);
                        root.armed = "";
                        root.press-card = "";
                        return accept;
                    }
                    return reject;
                }
            }

            VerticalLayout {
                spacing: 0px;

                // ══ 头部 52px ══
                Rectangle {
                    height: 52px;
                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 12px;
                        spacing: 14px;
                        cross-axis-alignment: center;
                        // 标题块：图标（新建会话弹框同款 28/8/ac-soft/18）+ 标题 + 计数胶囊
                        HorizontalLayout {
                            spacing: 9px;
                            cross-axis-alignment: center;
                            Rectangle {
                                width: 28px;
                                height: 28px;
                                border-radius: 8px;
                                background: Theme.accent-soft;
                                Icon {
                                    glyph: "quick-command";
                                    tint: Theme.accent-solid;
                                    size: 18px;
                                }
                            }
                            Text {
                                text: root.lang-en ? "Command manager" : "命令管理";
                                color: Theme.text-primary;
                                font-size: 15px;
                                font-weight: 650;
                                vertical-alignment: center;
                            }
                            Rectangle {
                                height: 20px;
                                border-radius: 8px;
                                background: Theme.accent-soft;
                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    alignment: center;
                                    Text {
                                        text: root.subtitle;
                                        color: Theme.accent;
                                        font-size: 10.5px;
                                        font-family: Theme.font-mono;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                        Rectangle { horizontal-stretch: 1; height: 1px; }
                        // 搜索框（28px：icon + 输入 + 清除 ×）
                        Rectangle {
                            width: 220px;
                            height: 28px;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: q-input.has-focus
                                ? Theme.accent.with-alpha(0.42) : Theme.mgr-line;
                            background: Theme.popup-field;
                            if q-input.has-focus : Rectangle {
                                x: -3px; y: -3px;
                                width: parent.width + 6px;
                                height: parent.height + 6px;
                                border-radius: 11px;
                                border-width: 3px;
                                border-color: Theme.accent-soft;
                            }
                            HorizontalLayout {
                                padding-left: 9px;
                                padding-right: 24px;
                                spacing: 7px;
                                cross-axis-alignment: center;
                                Icon {
                                    glyph: "search";
                                    tint: Theme.text-muted;
                                    size: 13px;
                                    opacity: 0.8;
                                }
                                q-input := TextInput {
                                    width: parent.width;
                                    height: parent.height;
                                    vertical-alignment: center;
                                    font-size: 12px;
                                    color: Theme.text-primary;
                                    single-line: true;
                                    text <=> root.query;
                                    edited => { root.search(root.query); }
                                }
                            }
                            if root.query == "" && !q-input.has-focus : Text {
                                x: 29px;
                                width: parent.width - 55px;
                                height: parent.height;
                                vertical-alignment: center;
                                font-size: 12px;
                                color: Theme.text-muted;
                                text: root.lang-en ? "Search name, command or group" : "搜索名称、命令或分组";
                                overflow: elide;
                            }
                            // 清除键（有内容才显；悬停 accent 实心圆）
                            if root.query != "" : Rectangle {
                                x: parent.width - 24px;
                                y: (parent.height - self.height) / 2;
                                width: 20px;
                                height: 20px;
                                qc-ta := TouchArea {
                                    mouse-cursor: default;
                                changed has-hover => {
                                    if (self.has-hover) {
                                        root.tip-on(root.lang-en ? "Clear search" : "清除搜索",
                                            self.absolute-position.x + self.mouse-x,
                                            self.absolute-position.y + self.mouse-y);
                                    } else { root.tip-off(); }
                                }
                                pointer-event(ev) => {
                                    if (ev.kind == PointerEventKind.move && self.has-hover) {
                                        root.tip-at(self.absolute-position.x + self.mouse-x,
                                            self.absolute-position.y + self.mouse-y);
                                    }
                                }
                                    clicked => {
                                        root.query = "";
                                        root.search("");
                                        q-input.focus();
                                    }
                                }
                                Rectangle {
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                    width: 14px;
                                    height: 14px;
                                    border-radius: 7px;
                                    background: qc-ta.has-hover ? Theme.accent : transparent;
                                    animate background { duration: 100ms; }
                                    Icon {
                                        glyph: "close";
                                        tint: qc-ta.has-hover ? #131417 : Theme.text-secondary;
                                        size: 8px;
                                    }
                                }
                            }
                        }
                        // 新建命令（主按钮 30px）
                        Rectangle {
                            height: 30px;
                            border-radius: 7px;
                            background: newcmd-ta.has-hover
                                ? Theme.accent-hover : Theme.accent;
                            animate background { duration: 120ms; }
                            newcmd-ta := TouchArea {
                                mouse-cursor: default;
                                clicked => { open-editor-new(); }
                            }
                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 14px;
                                alignment: center;
                                spacing: 6px;
                                // (#cm-new-btn-plain 2026-10-26) 加号整个去掉（用户点名）：
                                // 与「完成」一致，主按钮纯文案、宽度随字走。
                                // 字色 = 稿子的 --ac-ink（#06201d）：深色主题下 accent 是
                                // 亮青，白字偏"发灰"、对比也不如深墨绿；浅色主题 accent 是
                                // 深青，仍用白字（Theme.dark 取反色，同 ScopeRow 勾选那套口径）。
                                Text {
                                    text: root.lang-en ? "New command" : "新建命令";
                                    color: Theme.dark ? #06201d : #ffffff;
                                    font-size: 12.5px;
                                    font-weight: 650;
                                    vertical-alignment: center;
                                }
                            }
                        }
                        DialogClose {
                            btn-size: 28px;
                            glyph-size: 15px;
                            clicked => { if (commit-edit()) { root.close(); } }
                        }
                    }
                    Rectangle {
                        y: parent.height - 1px;
                        width: 100%;
                        height: 1px;
                        background: Theme.mgr-line-soft;
                    }
                }

                // ══ 主体双栏 ══
                HorizontalLayout {
                    spacing: 0px;
                    vertical-stretch: 1;

                    // ── 左栏：分组导航 ──
                    Rectangle {
                        width: root.left-w;
                        VerticalLayout {
                            spacing: 0px;
                            glist := Rectangle {
                                vertical-stretch: 1;
                                clip: true;
                                gsv := ScrollView {
                                    width: 100%;
                                    height: 100%;
                                    mouse-drag-pan-enabled: false;
                                    glay := VerticalLayout {
                                        padding-top: 8px;
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        padding-bottom: 3px;
                                        spacing: 0px;
                                        alignment: start;

                                        for i in root.groups.length : VerticalLayout {
                                            spacing: 0px;
                                            // 「我的分组 N」小节：第一个自定义组前
                                            if root.groups[i].kind == 2
                                                && (i == 0 || root.groups[i - 1].kind != 2) : CmCaption {
                                                label: root.lang-en ? "My groups" : "我的分组";
                                                count: root.custom-count;
                                            }
                                            Rectangle {
                                                height: root.row-h;
                                                border-radius: 8px;
                                                // 拖组中源行淡化；搜索 0 命中压暗
                                                opacity: root.drag-kind == "group"
                                                    && root.drag-key == root.groups[i].key ? 0.4
                                                    : (root.query != "" && root.groups[i].hit == 0 ? 0.45 : 1.0);
                                                background: root.selected == root.groups[i].key
                                                    ? Theme.accent.with-alpha(Theme.dark ? 0.10 : 0.08)
                                                    : (root.drop-gi == i && root.drag-kind == "card"
                                                        ? Theme.accent.with-alpha(Theme.dark ? 0.18 : 0.12)
                                                        : (grow-ta.has-hover || gu-ta.has-hover || gd-ta.has-hover
                                                            ? Theme.bg-hover : transparent));
                                                // 选中左缘 2px 竖条
                                                if root.selected == root.groups[i].key : Rectangle {
                                                    x: 0px;
                                                    y: 9px;
                                                    width: 2px;
                                                    height: parent.height - 18px;
                                                    border-radius: 1px;
                                                    background: Theme.accent-solid;
                                                }
                                                // 拖卡悬停：1px accent 内描边
                                                if root.drop-gi == i && root.drag-kind == "card" : Rectangle {
                                                    width: 100%;
                                                    height: 100%;
                                                    border-radius: 8px;
                                                    border-width: 1px;
                                                    border-color: Theme.accent.with-alpha(0.42);
                                                    background: transparent;
                                                }
                                                // 拖组排序：目标行上/下缘 2px 插入线
                                                if root.drop-gi == i && root.drag-kind == "group"
                                                    && !root.g-ins-after : Rectangle {
                                                    x: 6px;
                                                    y: -1px;
                                                    width: parent.width - 12px;
                                                    height: 2px;
                                                    border-radius: 1px;
                                                    background: Theme.accent-solid;
                                                }
                                                if root.drop-gi == i && root.drag-kind == "group"
                                                    && root.g-ins-after : Rectangle {
                                                    x: 6px;
                                                    y: parent.height - 1px;
                                                    width: parent.width - 12px;
                                                    height: 2px;
                                                    border-radius: 1px;
                                                    background: Theme.accent-solid;
                                                }

                                                grow-ta := TouchArea {
                                                    mouse-cursor: default;
                                                changed has-hover => {
                                                    if (self.has-hover) {
                                                        root.tip-on(root.groups[i].kind == 2 ? (root.lang-en ? "Double-click to rename" : "双击改名") : "",
                                                            self.absolute-position.x + self.mouse-x,
                                                            self.absolute-position.y + self.mouse-y);
                                                    } else { root.tip-off(); }
                                                }
                                                    clicked => {
                                                        if (!commit-edit()) { return; }
                                                        root.cancel-armed();
                                                        root.move-menu = false;
                                                        if (root.selected != root.groups[i].key) {
                                                            root.selected = root.groups[i].key;
                                                            root.confirm-del = "";
                                                            root.batch-confirm = false;
                                                            root.press-card = "";
                                                            root.clear-picks();
                                                            root.select(root.selected);
                                                        }
                                                    }
                                                    double-clicked => {
                                                        // 默认分组 / 全部命令不可改名
                                                        if (root.groups[i].kind == 2) {
                                                            start-edit(root.groups[i].key);
                                                            root.edit-where = "left";
                                                        }
                                                    }
                                                    moved => {
                                                        if (root.groups[i].kind != 2) { return; }
                                                        if (root.editing != "" || root.creating) { return; }
                                                        let ax = self.absolute-position.x + self.mouse-x;
                                                        let ay = self.absolute-position.y + self.mouse-y;
                                                        root.drag-abs-x = ax;
                                                        root.drag-abs-y = ay;
                                                        let dx = ax - root.press-x;
                                                        let dy = ay - root.press-y;
                                                        if (!root.dragging) {
                                                            if (dx > -5px && dx < 5px
                                                                && dy > -5px && dy < 5px) { return; }
                                                            root.dragging = true;
                                                            root.drag-kind = "group";
                                                            root.drag-key = root.groups[i].key;
                                                            root.drag-label = root.groups[i].display;
                                                        }
                                                        // 拖组落点：行上缘 = 插到目标前，下缘 = 之后
                                                        //（只认自定义组行；含「我的分组」小节的 28px 偏移）
                                                        let gy = ay - glay.absolute-position.y;
                                                        let to = gi-at(gy);
                                                        if (to >= 0 && to < root.groups.length
                                                            && root.groups[to].kind == 2
                                                            && root.groups[to].key != root.drag-key) {
                                                            root.drop-gi = to;
                                                            root.g-ins-after = gy - gi-top(to)
                                                                > root.row-h / 2;
                                                        } else {
                                                            root.drop-gi = -1;
                                                        }
                                                    }
                                                    pointer-event(ev) => {
                                                        if (ev.kind == PointerEventKind.move && self.has-hover) {
                                                            root.tip-at(self.absolute-position.x + self.mouse-x,
                                                                self.absolute-position.y + self.mouse-y);
                                                        }
                                                        if (ev.kind == PointerEventKind.down) {
                                                            root.press-x = self.absolute-position.x + self.mouse-x;
                                                            root.press-y = self.absolute-position.y + self.mouse-y;
                                                            root.dragging = false;
                                                        } else if (ev.kind == PointerEventKind.up
                                                            && root.dragging && root.drag-kind == "group") {
                                                            let drag = root.drag-key;
                                                            let to = root.drop-gi;
                                                            let after = root.g-ins-after;
                                                            root.dragging = false;
                                                            root.drag-kind = "";
                                                            root.drag-key = "";
                                                            root.drop-gi = -1;
                                                            if (to >= 0 && to < root.groups.length
                                                                && root.groups[to].kind == 2
                                                                && root.groups[to].key != drag) {
                                                                root.reorder-group(drag,
                                                                    root.groups[to].key, after);
                                                            }
                                                        }
                                                    }
                                                }

                                                HorizontalLayout {
                                                    padding-left: 8px;
                                                    padding-right: 6px;
                                                    spacing: 8px;
                                                    cross-axis-alignment: center;
                                                    Icon {
                                                        // 全部命令 = dashboard；分组 = folder / folder-open（选中开）
                                                        glyph: root.groups[i].kind == 0 ? "dashboard"
                                                            : (root.groups[i].kind == 1
                                                                ? (root.selected == root.groups[i].key ? "folder-open" : "folder")
                                                                : (root.selected == root.groups[i].key ? "folder-open" : "folder"));
                                                        tint: root.selected == root.groups[i].key
                                                            ? Theme.accent-solid : Theme.text-muted;
                                                        size: 14px;
                                                    }
                                                    // 名称 / 行内改名输入框
                                                    if root.editing == root.groups[i].key
                                                        && root.edit-where == "left" : Rectangle {
                                                        horizontal-stretch: 1;
                                                        height: 24px;
                                                        border-radius: 5px;
                                                        background: grow-edit.has-focus
                                                            ? Theme.popup-field-2 : Theme.popup-field;
                                                        border-width: 1px;
                                                        border-color: root.editing-error != ""
                                                            ? Theme.danger
                                                            : (grow-edit.has-focus ? Theme.accent.with-alpha(0.42) : Theme.mgr-line-strong);
                                                        if grow-edit.has-focus && root.editing-error == "" : Rectangle {
                                                            x: -3px; y: -3px;
                                                            width: parent.width + 6px;
                                                            height: parent.height + 6px;
                                                            border-radius: 8px;
                                                            border-width: 3px;
                                                            border-color: Theme.accent-soft;
                                                        }
                                                        grow-edit := TextInput {
                                                            x: 7px;
                                                            width: parent.width - 14px;
                                                            height: parent.height;
                                                            init => { self.focus(); }
                                                            text <=> root.editing-text;
                                                            font-size: 12.5px;
                                                            color: Theme.text-primary;
                                                            vertical-alignment: center;
                                                            single-line: true;
                                                            edited => {
                                                                root.editing-error =
                                                                    root.validate-group(root.editing-text, root.editing);
                                                            }
                                                            accepted => { commit-edit(); }
                                                        }
                                                    }
                                                    if !(root.editing == root.groups[i].key
                                                        && root.edit-where == "left") : Text {
                                                        horizontal-stretch: 1;
                                                        text: root.groups[i].display;
                                                        color: root.selected == root.groups[i].key
                                                            || grow-ta.has-hover
                                                            || gu-ta.has-hover || gd-ta.has-hover
                                                            ? Theme.text-primary : Theme.text-secondary;
                                                        font-size: 12.5px;
                                                        vertical-alignment: center;
                                                        overflow: elide;
                                                    }
                                                    // 计数（搜索态 = 命中/总数；悬停让位 ↑↓）
                                                    Text {
                                                        visible: !(grow-ta.has-hover || gu-ta.has-hover || gd-ta.has-hover)
                                                            || root.groups[i].kind != 2
                                                            || (root.drop-gi == i && root.drag-kind == "card");
                                                        text: root.query != ""
                                                            ? root.groups[i].hit + "/" + root.groups[i].count
                                                            : root.groups[i].count;
                                                        color: root.selected == root.groups[i].key
                                                            || (root.query != "" && root.groups[i].hit > 0)
                                                            ? Theme.accent-solid : Theme.text-muted;
                                                        font-size: 10.5px;
                                                        font-family: Theme.font-mono;
                                                        vertical-alignment: center;
                                                    }
                                                    // 拖卡悬停：+N 徽标（N = 实际拖拽条数）
                                                    if root.drop-gi == i && root.drag-kind == "card" : Rectangle {
                                                        height: 16px;
                                                        border-radius: 8px;
                                                        background: Theme.accent-solid;
                                                        HorizontalLayout {
                                                            padding-left: 6px;
                                                            padding-right: 6px;
                                                            alignment: center;
                                                            Text {
                                                                text: root.drag-n > 1 ? "+" + root.drag-n : "";
                                                                color: white;
                                                                font-size: 9.5px;
                                                                font-family: Theme.font-mono;
                                                                font-weight: 700;
                                                                vertical-alignment: center;
                                                            }
                                                        }
                                                    }
                                                    // ↑↓（自定义组悬停显示；首位/末位置灰）
                                                    HorizontalLayout {
                                                        visible: root.groups[i].kind == 2;
                                                        spacing: 1px;
                                                        opacity: grow-ta.has-hover
                                                            || gu-ta.has-hover || gd-ta.has-hover ? 1.0 : 0.0;
                                                        animate opacity { duration: 120ms; }
                                                        Rectangle {
                                                            width: 17px;
                                                            height: 17px;
                                                            border-radius: 4px;
                                                            background: gu-ta.has-hover ? Theme.bg-hover : transparent;
                                                            gu-ta := TouchArea {
                                                                // 首位 = 前一行不是自定义组（↑置灰）
                                                                enabled: root.groups[i].kind == 2
                                                                    && i > 0 && root.groups[i - 1].kind == 2;
                                                                mouse-cursor: default;
                                                                changed has-hover => {
                                                                    if (self.has-hover) {
                                                                        root.tip-on((i > 0 && root.groups[i - 1].kind == 2) ? (root.lang-en ? "Move group up" : "上移分组") : (root.lang-en ? "Already at top" : "已在最上"),
                                                                            self.absolute-position.x + self.mouse-x,
                                                                            self.absolute-position.y + self.mouse-y);
                                                                    } else { root.tip-off(); }
                                                                }
                                                                pointer-event(ev) => {
                                                                    if (ev.kind == PointerEventKind.move && self.has-hover) {
                                                                        root.tip-at(self.absolute-position.x + self.mouse-x,
                                                                            self.absolute-position.y + self.mouse-y);
                                                                    }
                                                                }
                                                                clicked => {
                                                                    root.move-group(root.groups[i].key, -1);
                                                                }
                                                            }
                                                            Icon {
                                                                glyph: "arrow-up";
                                                                tint: Theme.text-secondary;
                                                                size: 10px;
                                                                opacity: i > 0 && root.groups[i - 1].kind == 2 ? 1.0 : 0.35;
                                                            }
                                                        }
                                                        Rectangle {
                                                            width: 17px;
                                                            height: 17px;
                                                            border-radius: 4px;
                                                            background: gd-ta.has-hover ? Theme.bg-hover : transparent;
                                                            gd-ta := TouchArea {
                                                                enabled: root.groups[i].kind == 2
                                                                    && i + 1 < root.groups.length
                                                                    && root.groups[i + 1].kind == 2;
                                                                mouse-cursor: default;
                                                                changed has-hover => {
                                                                    if (self.has-hover) {
                                                                        root.tip-on((i + 1 < root.groups.length && root.groups[i + 1].kind == 2) ? (root.lang-en ? "Move group down" : "下移分组") : (root.lang-en ? "Already at bottom" : "已在最下"),
                                                                            self.absolute-position.x + self.mouse-x,
                                                                            self.absolute-position.y + self.mouse-y);
                                                                    } else { root.tip-off(); }
                                                                }
                                                                pointer-event(ev) => {
                                                                    if (ev.kind == PointerEventKind.move && self.has-hover) {
                                                                        root.tip-at(self.absolute-position.x + self.mouse-x,
                                                                            self.absolute-position.y + self.mouse-y);
                                                                    }
                                                                }
                                                                clicked => {
                                                                    root.move-group(root.groups[i].key, 1);
                                                                }
                                                            }
                                                            Icon {
                                                                glyph: "arrow-down";
                                                                tint: Theme.text-secondary;
                                                                size: 10px;
                                                                opacity: i + 1 < root.groups.length
                                                                    && root.groups[i + 1].kind == 2 ? 1.0 : 0.35;
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                        }

                                        // 新建分组（编辑态输入行 + 重名错误）
                                        if root.creating : VerticalLayout {
                                            spacing: 0px;
                                            padding-top: 6px;
                                            Rectangle {
                                                height: 28px;
                                                border-radius: 8px;
                                                background: new-name.has-focus
                                                    ? Theme.popup-field-2 : Theme.popup-field;
                                                border-width: 1px;
                                                border-color: root.editing-error != ""
                                                    ? Theme.danger
                                                    : (new-name.has-focus ? Theme.accent.with-alpha(0.42) : Theme.mgr-line-strong);
                                                if new-name.has-focus && root.editing-error == "" : Rectangle {
                                                    x: -3px; y: -3px;
                                                    width: parent.width + 6px;
                                                    height: parent.height + 6px;
                                                    border-radius: 11px;
                                                    border-width: 3px;
                                                    border-color: Theme.accent-soft;
                                                }
                                                HorizontalLayout {
                                                    padding-left: 9px;
                                                    padding-right: 5px;
                                                    spacing: 7px;
                                                    cross-axis-alignment: center;
                                                    Icon {
                                                        glyph: "create-new-folder";
                                                        tint: Theme.text-muted;
                                                        size: 12px;
                                                    }
                                                    Rectangle {
                                                        horizontal-stretch: 1;
                                                        height: 100%;
                                                        new-name := TextInput {
                                                            width: 100%;
                                                            height: 100%;
                                                            init => { self.focus(); }
                                                            text <=> root.editing-text;
                                                            font-size: 12.5px;
                                                            color: Theme.text-primary;
                                                            vertical-alignment: center;
                                                            single-line: true;
                                                            edited => {
                                                                root.editing-error =
                                                                    root.validate-group(root.editing-text, "");
                                                            }
                                                            accepted => { commit-edit(); }
                                                        }
                                                        if root.editing-text == "" : Text {
                                                            width: 100%;
                                                            height: 100%;
                                                            text: root.lang-en ? "New group name" : "新分组名";
                                                            color: Theme.text-muted;
                                                            font-size: 12.5px;
                                                            vertical-alignment: center;
                                                            overflow: elide;
                                                        }
                                                    }
                                                    if root.editing-text != "" : Rectangle {
                                                        width: 20px;
                                                        height: 20px;
                                                        nclear-ta := TouchArea {
                                                            mouse-cursor: default;
                                                            clicked => {
                                                                root.editing-text = "";
                                                                root.editing-error = "";
                                                            }
                                                        }
                                                        Rectangle {
                                                            x: (parent.width - self.width) / 2;
                                                            y: (parent.height - self.height) / 2;
                                                            width: 14px;
                                                            height: 14px;
                                                            border-radius: 7px;
                                                            background: nclear-ta.has-hover ? Theme.accent : transparent;
                                                            animate background { duration: 100ms; }
                                                            Icon {
                                                                glyph: "close";
                                                                tint: nclear-ta.has-hover ? #131417 : Theme.text-muted;
                                                                size: 8px;
                                                            }
                                                        }
                                                    }
                                                }
                                            }
                                            if root.editing-error != "" : HorizontalLayout {
                                                padding-left: 9px;
                                                padding-top: 4px;
                                                Text {
                                                    text: root.editing-error;
                                                    color: Theme.danger;
                                                    font-size: 10.5px;
                                                    overflow: elide;
                                                }
                                            }
                                        }
                                    }
                                }
                            }

                            // 从预置导入（#preset-groups 2026-10-26）：**常驻**入口。
                            // 以前只挂在「一条命令都没有」的空态里 —— 用户删过几条、
                            // 或换过机器后就没地方补了，新用户也发现不了出厂清单。
                            // 常驻后任何时候都能补：按命令文本去重，已有的不重复加。
                            HorizontalLayout {
                                height: 32px;
                                padding-left: 8px;
                                padding-right: 8px;
                                Rectangle {
                                    horizontal-stretch: 1;
                                    border-radius: 8px;
                                    background: pre-ta.has-hover ? Theme.accent.with-alpha(0.10) : transparent;
                                    animate background { duration: 120ms; }
                                    pre-ta := TouchArea {
                                        mouse-cursor: default;
                                        clicked => {
                                            if (!commit-edit()) { return; }
                                            let n = root.import-presets();
                                            if (n > 0) {
                                                root.flash(root.lang-en
                                                    ? "Imported \{n} preset commands"
                                                    : "已导入 \{n} 条预置命令");
                                                // 导入的条目分散在 4 个分类组里，跳到
                                                // 「全部命令」才看得见结果。
                                                root.query = "";
                                                root.search("");
                                                root.clear-picks();
                                                root.selected = "__all";
                                                root.select("__all");
                                            } else {
                                                root.flash(root.lang-en
                                                    ? "All preset commands are already in the list"
                                                    : "预置命令都在列表里了");
                                            }
                                        }
                                    }
                                    HorizontalLayout {
                                        alignment: center;
                                        spacing: 6px;
                                        Icon {
                                            glyph: "download";
                                            tint: pre-ta.has-hover ? Theme.accent-solid : Theme.text-muted;
                                            size: 12px;
                                        }
                                        Text {
                                            text: root.lang-en ? "Import presets" : "从预置导入";
                                            color: pre-ta.has-hover ? Theme.accent-solid : Theme.text-muted;
                                            font-size: 11.5px;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }

                            // 新建分组按钮（吸底虚线框；编辑态让位）
                            HorizontalLayout {
                                height: root.creating ? 0px : 40px;
                                visible: !root.creating;
                                padding: 4px;
                                padding-left: 8px;
                                padding-right: 8px;
                                Rectangle {
                                    horizontal-stretch: 1;
                                    border-radius: 8px;
                                    border-width: 1px;
                                    border-color: newg-ta.has-hover
                                        ? Theme.accent.with-alpha(0.42) : Theme.mgr-line-strong;
                                    background: newg-ta.has-hover
                                        ? Theme.accent.with-alpha(0.10) : transparent;
                                    newg-ta := TouchArea {
                                        mouse-cursor: default;
                                        clicked => {
                                            if (!commit-edit()) { return; }
                                            root.creating = true;
                                            root.edit-where = "left";
                                            root.editing = "";
                                            root.editing-text = "";
                                            root.editing-error = "";
                                        }
                                    }
                                    HorizontalLayout {
                                        alignment: center;
                                        spacing: 6px;
                                        Icon {
                                            glyph: "create-new-folder";
                                            tint: newg-ta.has-hover ? Theme.accent-solid : Theme.text-muted;
                                            size: 12px;
                                        }
                                        Text {
                                            text: root.lang-en ? "New group" : "新建分组";
                                            color: newg-ta.has-hover ? Theme.accent-solid : Theme.text-muted;
                                            font-size: 12px;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // 5px 分隔条（拖 180–320，双击回 224）
                    Rectangle {
                        width: 5px;
                        background: transparent;
                        sp-ta := TouchArea {
                            mouse-cursor: col-resize;
                        changed has-hover => {
                            if (self.has-hover) {
                                root.tip-on(root.lang-en ? "Drag to resize · double-click to reset" : "拖动调整左栏宽度 · 双击复位",
                                    self.absolute-position.x + self.mouse-x,
                                    self.absolute-position.y + self.mouse-y);
                            } else { root.tip-off(); }
                        }
                        pointer-event(ev) => {
                            if (ev.kind == PointerEventKind.move && self.has-hover) {
                                root.tip-at(self.absolute-position.x + self.mouse-x,
                                    self.absolute-position.y + self.mouse-y);
                            }
                            if (ev.kind == PointerEventKind.down) {
                                root.sp-start = self.absolute-position.x + self.mouse-x;
                                    root.sp-base = root.left-w;
                                    root.sp-on = true;
                                } else if (ev.kind == PointerEventKind.up
                                    || ev.kind == PointerEventKind.cancel) {
                                    root.sp-on = false;
                                } else if (ev.kind == PointerEventKind.move && root.sp-on) {
                                    let dx = self.absolute-position.x + self.mouse-x - root.sp-start;
                                    root.left-w = Math.max(180px, Math.min(320px, root.sp-base + dx));
                                }
                            }
                            double-clicked => { root.left-w = 224px; }
                        }
                        Rectangle {
                            x: 2px;
                            width: root.sp-on || sp-ta.has-hover ? 2px : 1px;
                            height: 100%;
                            background: root.sp-on || sp-ta.has-hover
                                ? Theme.accent-solid : Theme.mgr-line;
                            animate background { duration: 120ms; }
                        }
                    }

                    // ── 右栏 ──
                    rcol := Rectangle {
                        horizontal-stretch: 1;
                        clip: true;
                        VerticalLayout {
                            spacing: 0px;

                            // 组头 46px（「全部命令」视图不渲染——设计稿：左栏已选中，
                            // 右侧重复无信息量；整行让位给卡片列表）
                            if !root.is-all : Rectangle {
                                height: 46px;
                                HorizontalLayout {
                                    padding-left: 16px;
                                    padding-right: 14px;
                                    spacing: 10px;
                                    cross-axis-alignment: center;
                                    // 组名 / 头部就地改名（双击；默认分组除外）
                                    if root.editing != "" && root.editing == root.selected
                                        && root.edit-where == "right" : Rectangle {
                                        height: 26px;
                                        border-radius: 5px;
                                        background: rhd-edit.has-focus
                                            ? Theme.popup-field-2 : Theme.popup-field;
                                        border-width: 1px;
                                        border-color: root.editing-error != ""
                                            ? Theme.danger
                                            : (rhd-edit.has-focus ? Theme.accent.with-alpha(0.42) : Theme.mgr-line-strong);
                                        if rhd-edit.has-focus && root.editing-error == "" : Rectangle {
                                            x: -3px; y: -3px;
                                            width: parent.width + 6px;
                                            height: parent.height + 6px;
                                            border-radius: 8px;
                                            border-width: 3px;
                                            border-color: Theme.accent-soft;
                                        }
                                        rhd-edit := TextInput {
                                            x: 6px;
                                            width: parent.width - 12px;
                                            height: parent.height;
                                            init => { self.focus(); }
                                            text <=> root.editing-text;
                                            font-size: 14px;
                                            font-weight: 650;
                                            color: Theme.text-primary;
                                            vertical-alignment: center;
                                            single-line: true;
                                            edited => {
                                                root.editing-error =
                                                    root.validate-group(root.editing-text, root.editing);
                                            }
                                            accepted => { commit-edit(); }
                                        }
                                    }
                                    if !(root.editing != "" && root.editing == root.selected
                                        && root.edit-where == "right") : Rectangle {
                                        height: 26px;
                                        rname-ta := TouchArea {
                                            mouse-cursor: root.cur-custom ? text : default;
                                        changed has-hover => {
                                            if (self.has-hover) {
                                                root.tip-on(root.cur-custom ? (root.lang-en ? "Double-click to rename" : "双击改名") : "",
                                                    self.absolute-position.x + self.mouse-x,
                                                    self.absolute-position.y + self.mouse-y);
                                            } else { root.tip-off(); }
                                        }
                                        pointer-event(ev) => {
                                            if (ev.kind == PointerEventKind.move && self.has-hover) {
                                                root.tip-at(self.absolute-position.x + self.mouse-x,
                                                    self.absolute-position.y + self.mouse-y);
                                            }
                                        }
                                            double-clicked => {
                                                if (root.cur-custom) {
                                                    start-edit(root.selected);
                                                    root.edit-where = "right";
                                                }
                                            }
                                        }
                                        HorizontalLayout {
                                            padding-left: 5px;
                                            padding-right: 5px;
                                            spacing: 6px;
                                            cross-axis-alignment: center;
                                            Text {
                                                text: root.cur-name;
                                                color: Theme.text-primary;
                                                font-size: 14px;
                                                font-weight: 650;
                                                vertical-alignment: center;
                                                overflow: elide;
                                                max-width: 240px;
                                            }
                                            if rname-ta.has-hover && root.cur-custom : Text {
                                                text: "✎";
                                                color: Theme.text-muted;
                                                font-size: 11px;
                                                vertical-alignment: center;
                                            }
                                        }
                                        background: rname-ta.has-hover && root.cur-custom
                                            ? Theme.bg-hover : transparent;
                                        border-radius: 5px;
                                    }
                                    // 计数胶囊
                                    Rectangle {
                                        height: 20px;
                                        border-radius: 8px;
                                        background: Theme.accent-soft;
                                        HorizontalLayout {
                                            padding-left: 8px;
                                            padding-right: 8px;
                                            alignment: center;
                                            Text {
                                                text: root.cur-count
                                                    + (root.lang-en ? " commands" : " 条命令");
                                                color: Theme.accent;
                                                font-size: 11px;
                                                font-family: Theme.font-mono;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                    Rectangle { horizontal-stretch: 1; height: 1px; }
                                    // 全选 / 清除全选（单组视图）
                                    Rectangle {
                                        height: 26px;
                                        border-radius: 6px;
                                        background: all-ta.has-hover ? Theme.bg-hover : transparent;
                                        all-ta := TouchArea {
                                            mouse-cursor: default;
                                            clicked => {
                                                root.cancel-armed();
                                                root.set-all-picked(!root.all-picked);
                                            }
                                        }
                                        HorizontalLayout {
                                            padding-left: 9px;
                                            padding-right: 9px;
                                            alignment: center;
                                            Text {
                                                text: root.all-picked
                                                    ? (root.lang-en ? "Clear all" : "清除全选")
                                                    : (root.lang-en ? "Select all" : "全选");
                                                color: root.all-picked
                                                    ? Theme.accent-solid : Theme.text-secondary;
                                                font-size: 11.5px;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                    // 删除分组（唯一入口，1px 竖线隔开；默认分组没有）
                                    if root.cur-custom : Rectangle {
                                        width: 1px;
                                        height: 16px;
                                        background: Theme.mgr-line;
                                    }
                                    if root.cur-custom : Rectangle {
                                        width: 28px;
                                        height: 28px;
                                        border-radius: 6px;
                                        background: delg-ta.has-hover
                                            ? Theme.danger.with-alpha(0.14) : transparent;
                                        animate background { duration: 100ms; }
                                        delg-ta := TouchArea {
                                            mouse-cursor: default;
                                        changed has-hover => {
                                            if (self.has-hover) {
                                                root.tip-on(root.lang-en ? "Delete group" : "删除分组",
                                                    self.absolute-position.x + self.mouse-x,
                                                    self.absolute-position.y + self.mouse-y);
                                            } else { root.tip-off(); }
                                        }
                                        pointer-event(ev) => {
                                            if (ev.kind == PointerEventKind.move && self.has-hover) {
                                                root.tip-at(self.absolute-position.x + self.mouse-x,
                                                    self.absolute-position.y + self.mouse-y);
                                            }
                                        }
                                            clicked => {
                                                commit-edit();
                                                root.cancel-armed();
                                                root.confirm-del = root.selected;
                                                root.del-target = "";
                                                root.move-menu = false;
                                            }
                                        }
                                        Icon {
                                            glyph: "delete";
                                            tint: delg-ta.has-hover ? Theme.danger : Theme.text-muted;
                                            size: 14px;
                                        }
                                    }
                                }
                                Rectangle {
                                    y: parent.height - 1px;
                                    width: 100%;
                                    height: 1px;
                                    background: Theme.mgr-line-soft;
                                }
                            }

                            // 删除条 46px：组头整条替换（N 条命令 → [去向 ▾]）
                            if root.confirm-del != "" : Rectangle {
                                height: 46px;
                                background: Theme.danger.with-alpha(0.10);
                                HorizontalLayout {
                                    padding-left: 16px;
                                    padding-right: 12px;
                                    spacing: 10px;
                                    cross-axis-alignment: center;
                                    Icon { glyph: "warning"; tint: Theme.danger; size: 14px; }
                                    Text {
                                        text: (root.lang-en ? "Delete \"" : "删除「") + root.cur-name
                                            + (root.lang-en ? "\"? " : "」？");
                                        color: Theme.text-primary;
                                        font-size: 12px;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                    Text {
                                        text: root.cur-count == 0
                                            ? (root.lang-en ? "Empty group." : "该分组为空。")
                                            : (root.cur-count + (root.lang-en
                                                ? " commands →" : " 条命令 →"));
                                        color: Theme.text-secondary;
                                        font-size: 11.5px;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                    if root.cur-count > 0 : Rectangle {
                                        height: 26px;
                                        border-radius: 6px;
                                        background: Theme.popup-field;
                                        border-width: 1px;
                                        border-color: root.del-menu ? Theme.accent.with-alpha(0.42) : Theme.mgr-line-strong;
                                        dsel-ta := TouchArea {
                                            mouse-cursor: default;
                                            clicked => {
                                                root.del-menu-x = dsel-ta.absolute-position.x
                                                    + dsel-ta.width / 2 - cm.absolute-position.x;
                                                root.del-menu = !root.del-menu;
                                                root.move-menu = false;
                                            }
                                        }
                                        HorizontalLayout {
                                            padding-left: 9px;
                                            padding-right: 7px;
                                            spacing: 5px;
                                            cross-axis-alignment: center;
                                            Text {
                                                text: root.del-target == ""
                                                    ? (root.lang-en ? "Default" : "默认分组")
                                                    : root.del-target;
                                                color: Theme.text-primary;
                                                font-size: 11.5px;
                                                vertical-alignment: center;
                                            }
                                            Icon {
                                                glyph: "expand-more";
                                                tint: Theme.text-muted;
                                                size: 11px;
                                            }
                                        }
                                    }
                                    Rectangle { horizontal-stretch: 1; height: 1px; }
                                    CmSmBtn {
                                        label: root.lang-en ? "Cancel" : "取消";
                                        btn-width: 54px;
                                        clicked => { root.confirm-del = ""; root.del-menu = false; }
                                    }
                                    CmSmBtn {
                                        label: root.lang-en ? "Delete" : "删除";
                                        danger: true;
                                        btn-width: 54px;
                                        clicked => {
                                            let n = root.cur-count;
                                            let g = root.confirm-del;
                                            let t = root.del-target;
                                            root.remove-group(g, t);
                                            root.confirm-del = "";
                                            root.del-menu = false;
                                            root.flash(root.lang-en
                                                ? "Deleted group, " + n + " commands moved"
                                                : "已删除分组「" + g + "」，" + n + " 条命令已迁移");
                                        }
                                    }
                                }
                                Rectangle {
                                    y: parent.height - 1px;
                                    width: 100%;
                                    height: 1px;
                                    background: Theme.danger.with-alpha(0.34);
                                }
                            }

                            // 卡片列表（2 列网格）
                            Rectangle {
                                vertical-stretch: 1;
                                clip: true;
                                msv := ScrollView {
                                    width: 100%;
                                    height: 100%;
                                    mouse-drag-pan-enabled: false;
                                    property <string> sel-watch: root.selected;
                                    changed sel-watch => { self.content-y = 0px; }
                                    mgrid := VerticalLayout {
                                        padding-top: 10px;
                                        padding-left: 14px;
                                        padding-right: 14px;
                                        padding-bottom: 56px;   // 批量条留位
                                        spacing: root.card-gap;
                                        alignment: start;

                                        // 空态①：一条命令都没有
                                        if root.view-count == 0 && !root.has-any : Rectangle {
                                            height: 240px;
                                            VerticalLayout {
                                                alignment: center;
                                                padding-left: 40px;
                                                padding-right: 40px;
                                                spacing: 9px;
                                                HorizontalLayout {
                                                    alignment: center;
                                                    Rectangle {
                                                        width: 100%;
                                                        height: 130px;
                                                        border-radius: 10px;
                                                        border-width: 1px;
                                                        border-color: Theme.mgr-line-strong;
                                                        VerticalLayout {
                                                            alignment: center;
                                                            spacing: 9px;
                                                            HorizontalLayout {
                                                                alignment: center;
                                                                Rectangle {
                                                                    width: 34px;
                                                                    height: 34px;
                                                                    border-radius: 9px;
                                                                    background: Theme.bg-active;
                                                                    Icon {
                                                                        glyph: "add";
                                                                        tint: Theme.text-muted;
                                                                        size: 17px;
                                                                    }
                                                                }
                                                            }
                                                            Text {
                                                                text: root.lang-en ? "No commands yet" : "还没有快捷命令";
                                                                color: Theme.text-secondary;
                                                                font-size: 12.5px;
                                                                horizontal-alignment: center;
                                                            }
                                                            Text {
                                                                text: root.lang-en
                                                                    ? "Save frequent commands, then click to send"
                                                                    : "把常用的命令存进分组，点击即可发送到当前终端";
                                                                color: Theme.text-muted;
                                                                font-size: 11px;
                                                                horizontal-alignment: center;
                                                                wrap: word-wrap;
                                                            }
                                                        }
                                                    }
                                                }
                                                HorizontalLayout {
                                                    alignment: center;
                                                    height: 30px;
                                                    spacing: 9px;
                                                    // (#cm-empty-btn 2026-10-26) 与头部/页脚主按钮同款：
                                                    // 30 高 / 12.5 字 / padding 0 14、宽度随文案，
                                                    // 深色主题墨绿字（--ac-ink），去掉全角「＋」。
                                                    Rectangle {
                                                        width: max(54px, first-txt.preferred-width + 28px);
                                                        height: 30px;
                                                        border-radius: 7px;
                                                        background: first-ta.has-hover
                                                            ? Theme.accent-hover : Theme.accent;
                                                        animate background { duration: 120ms; }
                                                        first-ta := TouchArea {
                                                            mouse-cursor: default;
                                                            clicked => { open-editor-new(); }
                                                        }
                                                        first-txt := Text {
                                                            text: root.lang-en ? "First command" : "新建第一条";
                                                            color: Theme.dark ? #06201d : #ffffff;
                                                            font-size: 12.5px;
                                                            font-weight: 650;
                                                            horizontal-alignment: center;
                                                            vertical-alignment: center;
                                                        }
                                                    }
                                                    // (#cm-empty-import 2026-10-26) 从预置导入：
                                                    // 次级 ghost 框（同「新建分组」的描边/悬停口径）。
                                                    // 出厂清单全部只读诊断类，命令文本去重。
                                                    Rectangle {
                                                        width: max(54px, imp-txt.preferred-width + 28px);
                                                        height: 30px;
                                                        border-radius: 7px;
                                                        border-width: 1px;
                                                        border-color: imp-ta.has-hover
                                                            ? Theme.accent.with-alpha(0.42) : Theme.mgr-line-strong;
                                                        background: imp-ta.has-hover
                                                            ? Theme.accent.with-alpha(0.10) : transparent;
                                                        animate background { duration: 120ms; }
                                                        imp-ta := TouchArea {
                                                            mouse-cursor: default;
                                                            clicked => {
                                                                let n = root.import-presets();
                                                                if (n > 0) {
                                                                    root.flash(root.lang-en
                                                                        ? "Imported \{n} preset commands"
                                                                        : "已导入 \{n} 条预置命令");
                                                                }
                                                            }
                                                        }
                                                        imp-txt := Text {
                                                            text: root.lang-en ? "Import presets" : "从预置导入";
                                                            color: imp-ta.has-hover
                                                                ? Theme.accent-solid : Theme.text-secondary;
                                                            font-size: 12.5px;
                                                            font-weight: 600;
                                                            horizontal-alignment: center;
                                                            vertical-alignment: center;
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                        // 空态②：搜索全局无命中
                                        if root.view-count == 0 && root.query != "" && root.search-hits == 0
                                            && root.has-any : Rectangle {
                                            height: 240px;
                                            VerticalLayout {
                                                alignment: center;
                                                padding-left: 40px;
                                                padding-right: 40px;
                                                spacing: 9px;
                                                Rectangle {
                                                    width: 100%;
                                                    border-radius: 10px;
                                                    border-width: 1px;
                                                    border-color: Theme.border-control;
                                                    VerticalLayout {
                                                        alignment: center;
                                                        padding-top: 26px;
                                                        padding-bottom: 26px;
                                                        padding-left: 18px;
                                                        padding-right: 18px;
                                                        spacing: 9px;
                                                HorizontalLayout {
                                                    alignment: center;
                                                    Rectangle {
                                                        width: 34px;
                                                        height: 34px;
                                                        border-radius: 9px;
                                                        background: Theme.bg-active;
                                                        Icon {
                                                            glyph: "search";
                                                            tint: Theme.text-muted;
                                                            size: 17px;
                                                        }
                                                    }
                                                }
                                                        Text {
                                                            text: root.lang-en ? "No matching command" : "没有匹配的快捷命令";
                                                    color: Theme.text-secondary;
                                                    font-size: 12.5px;
                                                    horizontal-alignment: center;
                                                }
                                                Text {
                                                    text: "「" + root.query + "」"
                                                        + (root.lang-en
                                                            ? " matched no name, command or group"
                                                            : " 没有命中名称、命令或分组");
                                                    color: Theme.text-muted;
                                                    font-size: 11px;
                                                    horizontal-alignment: center;
                                                            wrap: word-wrap;
                                                        }
                                                    }
                                                }
                                                HorizontalLayout {
                                                    alignment: center;
                                                    height: 24px;
                                                    CmLinkBtn {
                                                        label: root.lang-en ? "Clear search" : "清除搜索";
                                                        clicked => {
                                                            root.query = "";
                                                            root.search("");
                                                            q-input.focus();
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                        // 空态③：本组没有，别处有 → 跳「全部命令」
                                        if root.view-count == 0 && root.query != "" && root.search-hits > 0 : Rectangle {
                                            height: 240px;
                                            VerticalLayout {
                                                alignment: center;
                                                padding-left: 40px;
                                                padding-right: 40px;
                                                spacing: 9px;
                                                Rectangle {
                                                    width: 100%;
                                                    border-radius: 10px;
                                                    border-width: 1px;
                                                    border-color: Theme.border-control;
                                                    VerticalLayout {
                                                        alignment: center;
                                                        padding-top: 26px;
                                                        padding-bottom: 26px;
                                                        padding-left: 18px;
                                                        padding-right: 18px;
                                                        spacing: 9px;
                                                HorizontalLayout {
                                                    alignment: center;
                                                    Rectangle {
                                                        width: 34px;
                                                        height: 34px;
                                                        border-radius: 9px;
                                                        background: Theme.bg-active;
                                                        Icon {
                                                            glyph: "search";
                                                            tint: Theme.text-muted;
                                                            size: 17px;
                                                        }
                                                    }
                                                }
                                                        Text {
                                                            text: root.lang-en ? "No match in this group" : "本分组没有匹配";
                                                    color: Theme.text-secondary;
                                                    font-size: 12.5px;
                                                    horizontal-alignment: center;
                                                }
                                                Text {
                                                    text: (root.lang-en
                                                        ? root.search-hits + " results in other groups"
                                                        : "其他分组里还有 " + root.search-hits + " 条结果");
                                                    color: Theme.text-muted;
                                                    font-size: 11px;
                                                    horizontal-alignment: center;
                                                            wrap: word-wrap;
                                                        }
                                                    }
                                                }
                                                HorizontalLayout {
                                                    alignment: center;
                                                    height: 24px;
                                                    CmLinkBtn {
                                                        label: root.lang-en
                                                            ? "See all commands" : "去「全部命令」看";
                                                        clicked => {
                                                            root.query = "";
                                                            root.search("");
                                                            root.selected = "__all";
                                                            root.clear-picks();
                                                            root.select("__all");
                                                        }
                                                    }
                                                }
                                            }
                                        }
                                        // 空态④：空分组（真实路径引导，不虚构拖放落点）
                                        if root.view-count == 0 && root.query == "" && root.has-any
                                            && !root.is-all : Rectangle {
                                            height: 240px;
                                            VerticalLayout {
                                                alignment: center;
                                                padding-left: 40px;
                                                padding-right: 40px;
                                                spacing: 9px;
                                                Rectangle {
                                                    width: 100%;
                                                    border-radius: 10px;
                                                    border-width: 1px;
                                                    border-color: Theme.border-control;
                                                    VerticalLayout {
                                                        alignment: center;
                                                        padding-top: 26px;
                                                        padding-bottom: 26px;
                                                        padding-left: 18px;
                                                        padding-right: 18px;
                                                        spacing: 9px;
                                                        HorizontalLayout {
                                                            alignment: center;
                                                            Rectangle {
                                                                width: 34px;
                                                                height: 34px;
                                                                border-radius: 9px;
                                                                background: Theme.bg-active;
                                                                Icon {
                                                                    glyph: "folder";
                                                                    tint: Theme.text-muted;
                                                                    size: 17px;
                                                                }
                                                            }
                                                        }
                                                        Text {
                                                            text: root.lang-en ? "This group is empty" : "这个分组还是空的";
                                                    color: Theme.text-secondary;
                                                    font-size: 12.5px;
                                                    horizontal-alignment: center;
                                                }
                                                Text {
                                                    text: root.lang-en
                                                        ? "Pick commands elsewhere and Move to here, or drop cards on this group's row on the left."
                                                            : "到其他分组勾选命令后「移动至」这里，或把命令卡拖到左栏的本分组行上";
                                                            color: Theme.text-muted;
                                                            font-size: 11px;
                                                            horizontal-alignment: center;
                                                            wrap: word-wrap;
                                                        }
                                                    }
                                                }
                                            }
                                        }

                                        // 卡片两列（Rust 下发扁平序，这里按 2 张一行摊开）
                                        for r in root.card-rows : HorizontalLayout {
                                            // 列宽只在这里算一次（#cm-card-eq）：视口宽（msv，
                                            // 由外层容器决定，与卡片内容无关）减网格内衬 28
                                            // 与列间距后对半。**不能用行宽 self.width**：
                                            // 行宽是 flickable 按内容推的，会立刻成环。
                                            property <length> cw: Math.max(150px,
                                                (msv.width - 28px - root.card-gap) / 2);
                                            height: root.card-h;
                                            spacing: root.card-gap;
                                            if r * 2 < root.cards.length : CmCardSlot {
                                                width: parent.cw;
                                                card: root.cards[r * 2];
                                                lang-en: root.lang-en;
                                                is-all: root.is-all;
                                                picked-count: root.picked-count;
                                                armed: root.armed == root.cards[r * 2].key;
                                                ins-mode: root.drag-insert-slot == r * 2 ? root.drag-ins : -1;
                                                dragging: root.dragging && root.drag-kind == "card"
                                                    && (root.cards[r * 2].picked || root.drag-key == root.cards[r * 2].key);
                                                toggle-pick(key, s) => {
                                                    root.cancel-armed();
                                                    root.toggle-pick(key, s);
                                                }
                                                open-edit(c-key, n, note, cmd, g-key, g-disp, send) => {
                                                    open-editor-edit(c-key, n, note, cmd, g-key, g-disp, send);
                                                }
                                                step(key, d) => { root.step-cmd(key, d); }
                                                copy-cmd(key) => {
                                                    root.copy-cmd(key);
                                                    root.flash(root.lang-en
                                                        ? "Command copied to clipboard"
                                                        : "命令已复制到剪贴板");
                                                }
                                                arm(key) => { root.armed = key; }
                                                confirm-del(key) => {
                                                    root.del-cmd(key);
                                                    root.armed = "";
                                                    root.press-card = "";
                                                }
                                                toggle-send(key) => { root.toggle-send(key); }
                                                jump(g-key) => {
                                                    root.query = "";
                                                    root.search("");
                                                    root.selected = g-key;
                                                    root.cancel-armed();
                                                    root.clear-picks();
                                                    root.batch-confirm = false;
                                                    root.select(root.selected);
                                                }
                                                press(key) => { root.press-card = key; }
                                                card-drag-start(key, ax, ay, n) => {
                                                    root.geo-left-edge = cm.absolute-position.x;
                                                    root.geo-glay-y = glay.absolute-position.y;
                                                    root.geo-mgrid-x = mgrid.absolute-position.x;
                                                    root.geo-mgrid-y = mgrid.absolute-position.y;
                                                    root.geo-mgrid-w = mgrid.width;
                                                    start-card-drag(key, ax, ay, n);
                                                }
                                                card-dropped() => { finish-card-drag(); }
                                                tip-armed(text, ax, ay) => { tip-on(text, ax, ay); }
                                                tip-armed2(enter, text, ax, ay) => {
                                                    if (enter) { tip-on(text, ax, ay); } else { tip-off(); }
                                                }
                                                tip-move(ax, ay) => { tip-at(ax, ay); }
                                                tip-clear() => { tip-off(); }
                                            }
                                            if r * 2 + 1 >= root.cards.length : Rectangle {
                                                horizontal-stretch: 1;
                                                height: root.card-h;
                                            }
                                            if r * 2 + 1 < root.cards.length : CmCardSlot {
                                                width: parent.cw;
                                                card: root.cards[r * 2 + 1];
                                                lang-en: root.lang-en;
                                                is-all: root.is-all;
                                                picked-count: root.picked-count;
                                                armed: root.armed == root.cards[r * 2 + 1].key;
                                                ins-mode: root.drag-insert-slot == r * 2 + 1 ? root.drag-ins : -1;
                                                dragging: root.dragging && root.drag-kind == "card"
                                                    && (root.cards[r * 2 + 1].picked || root.drag-key == root.cards[r * 2 + 1].key);
                                                toggle-pick(key, s) => {
                                                    root.cancel-armed();
                                                    root.toggle-pick(key, s);
                                                }
                                                open-edit(c-key, n, note, cmd, g-key, g-disp, send) => {
                                                    open-editor-edit(c-key, n, note, cmd, g-key, g-disp, send);
                                                }
                                                step(key, d) => { root.step-cmd(key, d); }
                                                copy-cmd(key) => {
                                                    root.copy-cmd(key);
                                                    root.flash(root.lang-en
                                                        ? "Command copied to clipboard"
                                                        : "命令已复制到剪贴板");
                                                }
                                                arm(key) => { root.armed = key; }
                                                confirm-del(key) => {
                                                    root.del-cmd(key);
                                                    root.armed = "";
                                                    root.press-card = "";
                                                }
                                                toggle-send(key) => { root.toggle-send(key); }
                                                jump(g-key) => {
                                                    root.query = "";
                                                    root.search("");
                                                    root.selected = g-key;
                                                    root.cancel-armed();
                                                    root.clear-picks();
                                                    root.batch-confirm = false;
                                                    root.select(root.selected);
                                                }
                                                press(key) => { root.press-card = key; }
                                                card-drag-start(key, ax, ay, n) => {
                                                    root.geo-left-edge = cm.absolute-position.x;
                                                    root.geo-glay-y = glay.absolute-position.y;
                                                    root.geo-mgrid-x = mgrid.absolute-position.x;
                                                    root.geo-mgrid-y = mgrid.absolute-position.y;
                                                    root.geo-mgrid-w = mgrid.width;
                                                    start-card-drag(key, ax, ay, n);
                                                }
                                                card-dropped() => { finish-card-drag(); }
                                                tip-armed(text, ax, ay) => { tip-on(text, ax, ay); }
                                                tip-armed2(enter, text, ax, ay) => {
                                                    if (enter) { tip-on(text, ax, ay); } else { tip-off(); }
                                                }
                                                tip-move(ax, ay) => { tip-at(ax, ay); }
                                                tip-clear() => { tip-off(); }
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // 批量条（右栏底部浮出）
                        if root.picked-count > 0 : Rectangle {
                            x: 10px;
                            y: parent.height - self.height - 10px;
                            width: parent.width - 20px;
                            height: 42px;
                            border-radius: 9px;
                            border-width: 1px;
                            border-color: root.batch-confirm
                                ? Theme.danger.with-alpha(0.34) : Theme.accent.with-alpha(0.42);
                            background: root.batch-confirm
                                ? Theme.danger.with-alpha(0.12) : Theme.accent.with-alpha(0.10);
                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 10px;
                                spacing: 8px;
                                cross-axis-alignment: center;
                                Text {
                                    text: root.batch-confirm
                                        ? (root.lang-en
                                            ? "Delete " + root.picked-count + " commands? This cannot be undone"
                                            : "删除 " + root.picked-count + " 条命令？此操作不可恢复")
                                        : ((root.lang-en ? "Selected " : "已选 ")
                                            + root.picked-count + (root.lang-en ? "" : " 条"));
                                    color: root.batch-confirm ? Theme.text-primary : Theme.text-primary;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }
                                Rectangle { horizontal-stretch: 1; height: 1px; }
                                if !root.batch-confirm : CmSmBtn {
                                    label: root.all-picked
                                        ? (root.lang-en ? "Clear all" : "清除全选")
                                        : (root.lang-en ? "Select all" : "全选");
                                    visible: !root.is-all;
                                    clicked => { root.set-all-picked(!root.all-picked); }
                                }
                                // 移动至 ▾（手写：记录按钮中心 x 作菜单锚点）
                                if !root.batch-confirm : bmove := Rectangle {
                                    height: 26px;
                                    border-radius: 6px;
                                    border-width: 1px;
                                    border-color: bmove-ta.has-hover ? Theme.mgr-line-strong : Theme.mgr-line-strong;
                                    background: bmove-ta.has-hover ? Theme.bg-hover : transparent;
                                    animate background { duration: 100ms; }
                                    bmove-ta := TouchArea {
                                        mouse-cursor: default;
                                        clicked => {
                                            // (#cm-move-menu-anchor 2026-10-25) 存**绝对**中心 x：
                                            // 菜单挂在右栏容器里（rcol），以前存的是相对弹窗
                                            // 的坐标，菜单按它定位就整体右移了一个左栏宽度
                                            // （用户截图：菜单没对准「移动至」）。
                                            root.move-menu-x = bmove-ta.absolute-position.x
                                                + bmove-ta.width / 2;
                                            root.move-menu = !root.move-menu;
                                        }
                                    }
                                    HorizontalLayout {
                                        padding-left: 12px;
                                        padding-right: 12px;
                                        alignment: center;
                                        spacing: 5px;
                                        cross-axis-alignment: center;
                                        Text {
                                            // ▾ 不写字符：字体里没有 U+25BE 时整支图标消失
                                            // （用户截图「丢失下拉的符号」），一律用 Icon。
                                            text: root.lang-en ? "Move to" : "移动至";
                                            color: bmove-ta.has-hover ? Theme.text-primary : Theme.text-secondary;
                                            font-size: 11.5px;
                                            vertical-alignment: center;
                                        }
                                        Icon {
                                            glyph: "expand-more";
                                            tint: bmove-ta.has-hover ? Theme.text-primary : Theme.text-muted;
                                            size: 11px;
                                        }
                                    }
                                }
                                if !root.batch-confirm : CmSmBtn {
                                    label: root.lang-en ? "Delete" : "删除";
                                    danger: true;
                                    clicked => { root.batch-confirm = true; }
                                }
                                if !root.batch-confirm : Rectangle {
                                    width: 1px;
                                    height: 16px;
                                    background: Theme.mgr-line;
                                }
                                if !root.batch-confirm : DialogClose {
                                    btn-size: 24px;
                                    glyph-size: 13px;
                                    clicked => {
                                        root.clear-picks();
                                        root.batch-confirm = false;
                                    }
                                }
                                if root.batch-confirm : CmSmBtn {
                                    label: root.lang-en ? "Cancel" : "取消";
                                    clicked => { root.batch-confirm = false; }
                                }
                                if root.batch-confirm : CmSmBtn {
                                    label: root.lang-en ? "Delete" : "删除";
                                    danger: true;
                                    solid: true;
                                    clicked => {
                                        let n = root.del-picked();
                                        root.batch-confirm = false;
                                        root.flash((root.lang-en
                                            ? "Deleted " : "已删除 ") + n
                                            + (root.lang-en ? " commands" : " 条命令"));
                                    }
                                }
                            }
                        }

                        // 删除条「去向」下拉（锚定去向按钮中心，其下方 4px）
                        if root.del-menu && root.confirm-del != "" : Rectangle {
                            x: Math.max(8px, Math.min(parent.width - self.width - 8px,
                                root.del-menu-x - self.width / 2));
                            y: 50px + 4px;
                            width: max(dm-col.preferred-width + 10px, 160px);
                            height: dm-col.preferred-height + 10px;
                            border-radius: 10px;
                            border-width: 1px;
                            border-color: Theme.border-strong;
                            background: Theme.popup-bg;
                            dm-col := VerticalLayout {
                                padding: 5px;
                                spacing: 0px;
                                for mi in root.menu-groups : Rectangle {
                                    height: 30px;
                                    border-radius: 6px;
                                    background: dm-ta.has-hover
                                        ? Theme.accent.with-alpha(0.08) : transparent;
                                    dm-ta := TouchArea {
                                        mouse-cursor: default;
                                        clicked => {
                                            root.del-target = mi.key;
                                            root.del-menu = false;
                                        }
                                    }
                                    HorizontalLayout {
                                        padding-left: 9px;
                                        padding-right: 9px;
                                        spacing: 8px;
                                        cross-axis-alignment: center;
                                        Icon {
                                            glyph: "folder";
                                            tint: Theme.text-muted;
                                            size: 13px;
                                        }
                                        Text {
                                            horizontal-stretch: 1;
                                            text: mi.display;
                                            color: mi.key == root.del-target
                                                ? Theme.accent-solid : Theme.text-primary;
                                            font-size: 12px;
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }
                                        Text {
                                            text: mi.count;
                                            color: Theme.text-muted;
                                            font-size: 10px;
                                            font-family: Theme.font-mono;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }

                        // 移动至菜单（水平中心对准触发钮，上方 4px 弹出）
                        if root.move-menu && root.picked-count > 0 : Rectangle {
                            // move-menu-x 是按钮中心的**绝对** x，这里减去右栏容器
                            // 的绝对左缘换算成局部坐标，再居中（同稿子 .move-pop）。
                            x: Math.max(8px, Math.min(parent.width - self.width - 8px,
                                root.move-menu-x - rcol.absolute-position.x - self.width / 2));
                            y: parent.height - 52px - 4px - self.height;
                            width: max(mmenu-col.preferred-width + 10px, 160px);
                            height: mmenu-col.preferred-height + 10px;
                            border-radius: 10px;
                            border-width: 1px;
                            border-color: Theme.border-strong;
                            background: Theme.popup-bg;
                            mmenu-col := VerticalLayout {
                                padding: 5px;
                                spacing: 0px;
                                for mi in root.menu-groups : Rectangle {
                                    height: 30px;
                                    border-radius: 6px;
                                    // 当前组置灰（目标 = 源 = 无意义移动）
                                    opacity: mi.key == root.selected && !root.is-all ? 0.45 : 1.0;
                                    background: mm-ta.has-hover
                                        && !(mi.key == root.selected && !root.is-all)
                                        ? Theme.accent.with-alpha(0.08) : transparent;
                                    mm-ta := TouchArea {
                                        mouse-cursor: default;
                                        enabled: !(mi.key == root.selected && !root.is-all);
                                        clicked => {
                                            // 先拷 display：mi.key 进回调后再用 mi 的字段会被当成 move
                                            let disp = mi.display;
                                            let n = root.move-picked(mi.key);
                                            root.move-menu = false;
                                            root.flash((root.lang-en ? "" : "已移动 ")
                                                + n + (root.lang-en
                                                    ? " commands → " : " 条命令 → ")
                                                + disp);
                                        }
                                    }
                                    HorizontalLayout {
                                        padding-left: 9px;
                                        padding-right: 9px;
                                        spacing: 8px;
                                        cross-axis-alignment: center;
                                        Icon {
                                            glyph: "folder";
                                            tint: Theme.text-muted;
                                            size: 13px;
                                        }
                                        Text {
                                            horizontal-stretch: 1;
                                            text: mi.display;
                                            color: Theme.text-primary;
                                            font-size: 12px;
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }
                                        Text {
                                            text: mi.count;
                                            color: Theme.text-muted;
                                            font-size: 10px;
                                            font-family: Theme.font-mono;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // ══ 底部 48px ══
                // (#cm-foot-bg 2026-10-25) 底色改回弹窗底同色：稿子 .qm-foot 的
                // #17191c 相对弹窗底 #181a1d 只深 1/255，分区靠那条 1px 顶线；
                // 之前用 popup-bg-inset（= bg-root，深得多）会在底部糊出一块
                // 明显更黑的横条，与高保真对不上。
                Rectangle {
                    height: 48px;
                    background: Theme.popup-bg;
                    Rectangle {
                        y: 0px;
                        width: 100%;
                        height: 1px;
                        background: Theme.mgr-line-soft;
                    }
                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 14px;
                        spacing: 10px;
                        cross-axis-alignment: center;
                        // 状态行三态：常态隐藏 / flash accent / 待删除警告（红，常驻）
                        if root.armed != "" : HorizontalLayout {
                            spacing: 6px;
                            cross-axis-alignment: center;
                            Icon { glyph: "warning"; tint: Theme.danger; size: 13px; }
                            Text {
                                text: root.lang-en
                                    ? "Pending delete — click Confirm to apply, click elsewhere to cancel"
                                    : "待删除 — 点「确认」执行，点击其它位置取消";
                                color: Theme.danger;
                                font-size: 11px;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }
                        if root.armed == "" && root.toast != "" : HorizontalLayout {
                            spacing: 6px;
                            cross-axis-alignment: center;
                            Icon {
                                glyph: root.toast-error ? "warning" : "check";
                                tint: root.toast-error ? Theme.danger : Theme.accent;
                                size: 13px;
                            }
                            Text {
                                text: root.toast;
                                color: root.toast-error ? Theme.danger : Theme.accent;
                                font-size: 11px;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }
                        Rectangle { horizontal-stretch: 1; height: 1px; }
                        // (#cm-foot-btn 2026-10-25) 页脚主按钮按稿子 `.primary`
                        // 的默认档（30 高 / 12.5 字 / padding 0 14，宽度随文案），
                        // 与头部「新建命令」同高 —— 之前写死 64×28，和头部差 2px
                        // 且比稿子小一号（用户截图：两个主按钮没对齐高保真）。
                        // 编辑卡底栏那两个按钮是稿子明确规定的 64×28，不动。
                        Rectangle {
                            width: max(54px, done-txt.preferred-width + 28px);
                            height: 30px;
                            border-radius: 7px;
                            background: done-ta.has-hover ? Theme.accent-hover : Theme.accent;
                            animate background { duration: 120ms; }
                            done-ta := TouchArea {
                                mouse-cursor: default;
                                clicked => { if (commit-edit()) { root.close(); } }
                            }
                            done-txt := Text {
                                text: root.lang-en ? "Done" : "完成";
                                // 同头部主按钮：稿子 --ac-ink；浅色主题反过来用白字。
                                color: Theme.dark ? #06201d : #ffffff;
                                font-size: 12.5px;
                                font-weight: 650;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }

            // ══ 二级编辑卡（弹框中央 + 内遮罩）══
            if root.ed-open : Rectangle {
                x: 0px;
                y: 0px;
                width: 100%;
                height: 100%;
                background: #00000059;
                TouchArea {
                    mouse-cursor: default;
                    clicked => { root.ed-open = false; root.gc-pop = false; }
                }
                // 键盘层：Esc 关卡 / Ctrl+Enter 保存。不聚焦任何输入框
                // （用户点名：聚焦光环 + 输入法被动弹出都嫌吵）。
                FocusScope {
                    x: 0px; y: 0px; width: 0px; height: 0px;
                    init => { self.focus(); }
                    key-pressed(ev) => {
                        if (ev.text == Key.Escape) {
                            root.ed-open = false;
                            root.gc-pop = false;
                            return accept;
                        }
                        if (ev.modifiers.control && ev.text == Key.Return) {
                            save-editor();
                            return accept;
                        }
                        return reject;
                    }
                }
                Rectangle {
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                    width: min(440px, parent.width - 32px);
                    height: ed-col.preferred-height + 8px;
                    border-radius: 11px;
                    border-width: 1px;
                    border-color: Theme.border-strong;
                    background: Theme.popup-bg;
                    // 不 clip：▾ 分组下拉挂在卡片底缘之外，clip 会把它剪掉
                    TouchArea { mouse-cursor: default; }   // 吞掉点穿
                    ed-col := VerticalLayout {
                        spacing: 0px;
                        // 编辑卡头 44px
                        Rectangle {
                            height: 44px;
                            HorizontalLayout {
                                padding-left: 16px;
                                padding-right: 8px;
                                spacing: 9px;
                                cross-axis-alignment: center;
                                Rectangle {
                                    height: 17px;
                                    border-radius: 4px;
                                    background: Theme.accent-soft;
                                    HorizontalLayout {
                                        padding-left: 6px;
                                        padding-right: 6px;
                                        alignment: center;
                                        Text {
                                            text: root.ed-mode == "new"
                                                ? (root.lang-en ? "NEW" : "新建")
                                                : (root.lang-en ? "EDIT" : "编辑");
                                            color: Theme.accent;
                                            font-size: 9.5px;
                                            font-family: Theme.font-mono;
                                            font-weight: 600;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                                Text {
                                    text: root.ed-mode == "new"
                                        ? (root.lang-en ? "New command" : "新建命令")
                                        : (root.lang-en ? "Edit command" : "编辑命令");
                                    color: Theme.text-primary;
                                    font-size: 13.5px;
                                    font-weight: 650;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                    overflow: elide;
                                }
                                DialogClose {
                                    btn-size: 28px;
                                    glyph-size: 14px;
                                    clicked => { root.ed-open = false; root.gc-pop = false; }
                                }
                            }
                            Rectangle {
                                y: parent.height - 1px;
                                width: 100%;
                                height: 1px;
                                background: Theme.mgr-line-soft;
                            }
                        }
                        // 表单
                        VerticalLayout {
                            padding-left: 16px;
                            padding-right: 16px;
                            padding-top: 14px;
                            padding-bottom: 4px;
                            spacing: 12px;
                            // 名称 + 分组 同行：两列钉死成同一半宽（root.ed-col-w），
                            // 见属性区 #cm-ed-cols 的注释。
                            HorizontalLayout {
                                spacing: 12px;
                                VerticalLayout {
                                    spacing: 6px;
                                    min-width: root.ed-col-w;
                                    max-width: root.ed-col-w;
                                    Text {
                                        text: root.lang-en ? "Name" : "名称";
                                        color: Theme.text-secondary;
                                        font-size: 11.5px;
                                        font-weight: 600;
                                        height: 16px;
                                        vertical-alignment: center;
                                    }
                                    Rectangle {
                                        height: 30px;
                                        border-radius: 7px;
                                        border-width: 1px;
                                        border-color: root.ed-name-err
                                            ? Theme.danger
                                            : (ed-name.has-focus ? Theme.accent.with-alpha(0.42)
                                               : Theme.mgr-line-strong);
                                        background: ed-name.has-focus
                                            ? Theme.popup-field-2 : Theme.popup-field;
                                        if ed-name.has-focus && !root.ed-name-err : Rectangle {
                                            x: -3px; y: -3px;
                                            width: parent.width + 6px;
                                            height: parent.height + 6px;
                                            border-radius: 10px;
                                            border-width: 3px;
                                            border-color: Theme.accent-soft;
                                        }
                                        ed-name := TextInput {
                                            x: 9px;
                                            width: parent.width - 18px;
                                            height: parent.height;
                                            text <=> root.ed-name;
                                            font-size: 12.5px;
                                            color: Theme.text-primary;
                                            vertical-alignment: center;
                                            single-line: true;
                                            edited => { root.ed-name-err = root.ed-name == ""; }
                                        }
                                        if root.ed-name == "" && !ed-name.has-focus : Text {
                                            x: 9px;
                                            width: parent.width - 18px;
                                            height: parent.height;
                                            text: root.lang-en ? "e.g. Restart Nginx" : "例如：重启 Nginx";
                                            color: Theme.text-muted;
                                            font-size: 12.5px;
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }
                                    }
                                    if root.ed-name-err : Text {
                                        text: root.lang-en ? "Name is required" : "名称不能为空";
                                        color: Theme.danger;
                                        font-size: 10.5px;
                                    }
                                }
                                VerticalLayout {
                                    spacing: 6px;
                                    min-width: root.ed-col-w;
                                    max-width: root.ed-col-w;
                                    // 分组 label + 动态 hint 同行
                                    HorizontalLayout {
                                        spacing: 6px;
                                        height: 16px;
                                        Text {
                                            text: root.lang-en ? "Group" : "分组";
                                            color: Theme.text-secondary;
                                            font-size: 11.5px;
                                            font-weight: 600;
                                            vertical-alignment: center;
                                        }
                                        Rectangle { horizontal-stretch: 1; height: 1px; }
                                        Text {
                                            text: gc-hint();
                                            color: Theme.text-muted;
                                            font-size: 10.5px;
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }
                                    }
                                    // 分组组合框（ghost 补全 / × 清空 / ▾ 勾选）
                                    Rectangle {
                                        height: 30px;
                                        border-radius: 7px;
                                        border-width: 1px;
                                        border-color: root.gc-pop || ed-group.has-focus
                                            ? Theme.accent.with-alpha(0.42) : Theme.mgr-line-strong;
                                        background: root.gc-pop || ed-group.has-focus
                                            ? Theme.popup-field-2 : Theme.popup-field;
                                        if root.gc-pop || ed-group.has-focus : Rectangle {
                                            x: -3px; y: -3px;
                                            width: parent.width + 6px;
                                            height: parent.height + 6px;
                                            border-radius: 10px;
                                            border-width: 3px;
                                            border-color: Theme.accent-soft;
                                        }
                                        // ghost 补全：整段画 muted 完整名（声明在 ed-group
                                        // 之前 → 输入文字画在它上面，已输入的字被盖住，
                                        // 只露后缀，得到浏览器式灰色补全）
                                        if gc-match() != "" : Text {
                                            x: 9px;
                                            width: parent.width - 60px;
                                            height: parent.height;
                                            text: gc-match();
                                            color: Theme.text-muted;
                                            font-size: 12px;
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }
                                        ed-group := TextInput {
                                            x: 9px;
                                            width: parent.width - 60px;
                                            height: parent.height;
                                            text <=> root.ed-group;
                                            font-size: 12px;
                                            color: Theme.text-primary;
                                            vertical-alignment: center;
                                            single-line: true;
                                            edited => { root.gc-pop = false; }
                                            accepted => {
                                                if (gc-match() != "") {
                                                    root.ed-group = gc-match();
                                                }
                                            }
                                        }
                                        if root.ed-group == "" && !ed-group.has-focus : Text {
                                            x: 9px;
                                            width: parent.width - 60px;
                                            height: parent.height;
                                            text: root.lang-en
                                                ? "Default / type a new group" : "默认分组 / 输入新分组名";
                                            color: Theme.text-muted;
                                            font-size: 12px;
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }
                                        // × 清空（回默认分组）
                                        if root.ed-group != "" : Rectangle {
                                            x: parent.width - 48px;
                                            y: 0px;
                                            width: 24px;
                                            height: 100%;
                                            gcc-ta := TouchArea {
                                                mouse-cursor: default;
                                            changed has-hover => {
                                                if (self.has-hover) {
                                                    root.tip-on(root.lang-en ? "Clear (back to default group)" : "清空（回到默认分组）",
                                                        self.absolute-position.x + self.mouse-x,
                                                        self.absolute-position.y + self.mouse-y);
                                                } else { root.tip-off(); }
                                            }
                                            pointer-event(ev) => {
                                                if (ev.kind == PointerEventKind.move && self.has-hover) {
                                                    root.tip-at(self.absolute-position.x + self.mouse-x,
                                                        self.absolute-position.y + self.mouse-y);
                                                }
                                            }
                                                clicked => {
                                                    root.ed-group = "";
                                                    root.gc-pop = false;
                                                    ed-group.focus();
                                                }
                                            }
                                            Rectangle {
                                                x: (parent.width - self.width) / 2;
                                                y: (parent.height - self.height) / 2;
                                                width: 13px;
                                                height: 13px;
                                                border-radius: 7px;
                                                background: gcc-ta.has-hover ? Theme.accent : transparent;
                                                animate background { duration: 100ms; }
                                                Icon {
                                                    glyph: "close";
                                                    tint: gcc-ta.has-hover ? #131417 : Theme.text-secondary;
                                                    size: 7px;
                                                }
                                            }
                                        }
                                        // ▾ 展开勾选列表
                                        Rectangle {
                                            x: parent.width - 24px;
                                            y: 0px;
                                            width: 22px;
                                            height: 100%;
                                            gcd-ta := TouchArea {
                                                mouse-cursor: default;
                                            changed has-hover => {
                                                if (self.has-hover) {
                                                    root.tip-on(root.lang-en ? "Pick an existing group" : "选择已有分组",
                                                        self.absolute-position.x + self.mouse-x,
                                                        self.absolute-position.y + self.mouse-y);
                                                } else { root.tip-off(); }
                                            }
                                            pointer-event(ev) => {
                                                if (ev.kind == PointerEventKind.move && self.has-hover) {
                                                    root.tip-at(self.absolute-position.x + self.mouse-x,
                                                        self.absolute-position.y + self.mouse-y);
                                                }
                                            }
                                                clicked => { root.gc-pop = !root.gc-pop; }
                                            }
                                            Icon {
                                                glyph: "expand-more";
                                                tint: gcd-ta.has-hover ? Theme.text-primary : Theme.text-muted;
                                                size: 11px;
                                            }
                                        }
                                    }
                                }
                            }
                            // 备注
                            VerticalLayout {
                                spacing: 6px;
                                // (#cm-note-hint 2026-10-26) hint 用撑条钉到行尾：原来
                                // 裸排两个 Text，布局会把无约束的文字拉伸填空，提示
                                // 悬在行中间（分组行有撑条所以正常，同款口径对齐）。
                                HorizontalLayout {
                                    spacing: 6px;
                                    height: 16px;
                                    Text {
                                        text: root.lang-en ? "Note" : "备注";
                                        color: Theme.text-secondary;
                                        font-size: 11.5px;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                    }
                                    Rectangle { horizontal-stretch: 1; height: 1px; }
                                    Text {
                                        text: root.lang-en
                                            ? "optional; shown under the card name"
                                            : "可选；显示在卡片名称下方";
                                        color: Theme.text-muted;
                                        font-size: 10.5px;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                }
                                Rectangle {
                                    height: 30px;
                                    border-radius: 7px;
                                    border-width: 1px;
                                    border-color: ed-note.has-focus
                                        ? Theme.accent.with-alpha(0.42) : Theme.mgr-line-strong;
                                    background: ed-note.has-focus
                                        ? Theme.popup-field-2 : Theme.popup-field;
                                    ed-note := TextInput {
                                        x: 9px;
                                        width: parent.width - 18px;
                                        height: parent.height;
                                        text <=> root.ed-note;
                                        font-size: 12.5px;
                                        color: Theme.text-primary;
                                        vertical-alignment: center;
                                        single-line: true;
                                    }
                                    if root.ed-note == "" && !ed-note.has-focus : Text {
                                        x: 9px;
                                        width: parent.width - 18px;
                                        height: parent.height;
                                        text: root.lang-en
                                            ? "e.g. intranet only · needs approval"
                                            : "例如：仅内网可访问 · 变更需审批";
                                        color: Theme.text-muted;
                                        font-size: 12.5px;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                }
                            }
                            // 命令（多行 mono 区域）
                            VerticalLayout {
                                spacing: 6px;
                                Text {
                                    text: root.lang-en ? "Command" : "命令";
                                    color: Theme.text-secondary;
                                    font-size: 11.5px;
                                    font-weight: 600;
                                }
                                Rectangle {
                                    height: 88px;
                                    border-radius: 7px;
                                    border-width: 1px;
                                    border-color: root.ed-cmd-err
                                        ? Theme.danger
                                        : (ed-cmd.has-focus ? Theme.accent.with-alpha(0.42)
                                           : Theme.mgr-line-strong);
                                    background: ed-cmd.has-focus
                                        ? Theme.popup-field-2 : Theme.popup-field;
                                    clip: true;
                                    Flickable {
                                        width: 100%;
                                        height: 100%;
                                        content-width: self.width;
                                        content-height: max(self.height, ed-cmd.preferred-height + 14px);
                                        ed-cmd := TextInput {
                                            x: 9px;
                                            y: 7px;
                                            width: parent.width - 18px;
                                            text <=> root.ed-cmd;
                                            // mono 链无 CJK（#54）：命令是自由文本，中文
                                            // 可能出现 → UI 字体兜底（与旧弹框同一决定）。
                                            font-family: Theme.ui-font-family;
                                            font-size: 11.5px;
                                            color: Theme.text-primary;
                                            single-line: false;
                                            wrap: no-wrap;
                                            edited => { root.ed-cmd-err = root.ed-cmd == ""; }
                                        }
                                    }
                                }
                                if root.ed-cmd-err : Text {
                                    text: root.lang-en ? "Command is required" : "命令内容不能为空";
                                    color: Theme.danger;
                                    font-size: 10.5px;
                                }
                            }
                            // 使用时（两档滑动分段）
                            VerticalLayout {
                                spacing: 6px;
                                Text {
                                    text: root.lang-en ? "When used" : "使用时";
                                    color: Theme.text-secondary;
                                    font-size: 11.5px;
                                    font-weight: 600;
                                }
                                SegGroup {
                                    height: 30px;
                                    compact: true;
                                    active-index: root.ed-send ? 1 : 0;
                                    count: 2;
                                    HorizontalLayout {
                                        padding: 0px;
                                        spacing: 0px;
                                        Rectangle {
                                            horizontal-stretch: 1;
                                            height: 100%;
                                            fill-ta := TouchArea {
                                                mouse-cursor: default;
                                                clicked => { root.ed-send = false; }
                                            changed has-hover => {
                                                if (self.has-hover) {
                                                    root.tip-on(root.lang-en ? "Drop into the command bar, review before sending" : "放进命令栏，检查修改后再发",
                                                        self.absolute-position.x + self.mouse-x,
                                                        self.absolute-position.y + self.mouse-y);
                                                } else { root.tip-off(); }
                                            }
                                            pointer-event(ev) => {
                                                if (ev.kind == PointerEventKind.move && self.has-hover) {
                                                    root.tip-at(self.absolute-position.x + self.mouse-x,
                                                        self.absolute-position.y + self.mouse-y);
                                                }
                                            }
                                            }
                                            HorizontalLayout {
                                                alignment: center;
                                                spacing: 6px;
                                                cross-axis-alignment: center;
                                                Icon {
                                                    glyph: "fill-in";
                                                    tint: root.ed-send ? Theme.text-muted : Theme.accent-solid;
                                                    size: 14px;
                                                }
                                                Text {
                                                    text: root.lang-en ? "Fill" : "填入";
                                                    color: root.ed-send ? Theme.text-muted : Theme.accent-solid;
                                                    font-size: 11.5px;
                                                    font-weight: root.ed-send ? 400 : 600;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }
                                        Rectangle {
                                            horizontal-stretch: 1;
                                            height: 100%;
                                            run-ta := TouchArea {
                                                mouse-cursor: default;
                                                clicked => { root.ed-send = true; }
                                            changed has-hover => {
                                                if (self.has-hover) {
                                                    root.tip-on(root.lang-en ? "Append Enter and run immediately" : "追加回车，立即执行",
                                                        self.absolute-position.x + self.mouse-x,
                                                        self.absolute-position.y + self.mouse-y);
                                                } else { root.tip-off(); }
                                            }
                                            pointer-event(ev) => {
                                                if (ev.kind == PointerEventKind.move && self.has-hover) {
                                                    root.tip-at(self.absolute-position.x + self.mouse-x,
                                                        self.absolute-position.y + self.mouse-y);
                                                }
                                            }
                                            }
                                            HorizontalLayout {
                                                alignment: center;
                                                spacing: 6px;
                                                cross-axis-alignment: center;
                                                Icon {
                                                    glyph: "play";
                                                    tint: root.ed-send ? Theme.accent-solid : Theme.text-muted;
                                                    size: 12px;
                                                }
                                                Text {
                                                    text: root.lang-en ? "Run" : "执行";
                                                    color: root.ed-send ? Theme.accent-solid : Theme.text-muted;
                                                    font-size: 11.5px;
                                                    font-weight: root.ed-send ? 600 : 400;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }
                                    }
                                }
                                Text {
                                    text: root.lang-en
                                        ? "Fill = drop into the command bar to review before sending (default). Run = fill + Enter. Applies to the \"Quick\" panel and docked panel; typed completions always fill first."
                                        : "填入 = 放进命令栏，检查修改后再发（默认）；执行 = 填入并追加回车立即运行。在命令栏「快捷」面板、停靠面板点击时按此方式；打字补全里选中则总是先填入输入框。";
                                    color: Theme.text-muted;
                                    font-size: 10.5px;
                                    wrap: word-wrap;
                                }
                            }
                        }
                        // 编辑卡底：取消 / 保存（64×28 定宽）
                        Rectangle {
                            height: 54px;
                            HorizontalLayout {
                                padding-left: 16px;
                                padding-right: 16px;
                                spacing: 8px;
                                cross-axis-alignment: center;
                                Rectangle { horizontal-stretch: 1; height: 1px; }
                                CmSmBtn {
                                    label: root.lang-en ? "Cancel" : "取消";
                                    btn-width: 64px;
                                    btn-height: 28px;
                                    clicked => { root.ed-open = false; root.gc-pop = false; }
                                }
                                Rectangle {
                                    width: 64px;
                                    height: 28px;
                                    border-radius: 7px;
                                    opacity: ed-name-ok() && ed-cmd-ok() ? 1.0 : 0.45;
                                    background: edsave-ta.has-hover ? Theme.accent-hover : Theme.accent;
                                    animate background { duration: 120ms; }
                                    edsave-ta := TouchArea {
                                        mouse-cursor: default;
                                        clicked => { save-editor(); }
                                    }
                                    Text {
                                        text: root.lang-en ? "Save" : "保存";
                                        color: #ffffff;
                                        font-size: 12px;
                                        font-weight: 650;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }
                    // ▾ 分组下拉（勾选列表）
                    if root.gc-pop : Rectangle {
                        x: 0px;
                        y: parent.height;
                        width: parent.width;
                        height: gcpop-col.preferred-height + 8px;
                        border-radius: 9px;
                        border-width: 1px;
                        border-color: Theme.border-strong;
                        background: Theme.popup-bg;
                        gcpop-col := VerticalLayout {
                            padding: 4px;
                            spacing: 0px;
                            VerticalLayout {
                                padding-left: 8px;
                                padding-top: 4px;
                                padding-bottom: 2px;
                                Text {
                                    text: root.lang-en ? "MY GROUPS" : "我的分组";
                                    color: Theme.text-muted;
                                    font-size: 9.5px;
                                    letter-spacing: 0.6px;
                                }
                            }
                            for gi2 in root.menu-groups : Rectangle {
                                height: 28px;
                                border-radius: 6px;
                                background: gcp-ta.has-hover
                                    ? Theme.accent.with-alpha(0.08) : transparent;
                                gcp-ta := TouchArea {
                                    mouse-cursor: default;
                                    clicked => {
                                        root.ed-group = gi2.display;
                                        root.gc-pop = false;
                                        ed-group.focus();
                                    }
                                }
                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    spacing: 8px;
                                    cross-axis-alignment: center;
                                    Icon {
                                        glyph: gi2.kind == 1 ? "folder" : "folder-open";
                                        tint: gi2.kind == 1 ? Theme.text-muted : Theme.text-muted;
                                        size: 12px;
                                    }
                                    Text {
                                        horizontal-stretch: 1;
                                        text: gi2.display;
                                        color: gi2.key == gc-value() ? Theme.accent-solid : Theme.text-primary;
                                        font-size: 12px;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                    // 当前选中打勾
                                    if gi2.key == gc-value() : Icon {
                                        glyph: "check";
                                        tint: Theme.accent-solid;
                                        size: 12px;
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // ══ 悬浮提示浮层（贴指针右上角；右/顶出界翻转；盖住编辑卡）══
            if root.tip-show && root.tip-text != "" : Rectangle {
                property <length> tip-w: tip-label.preferred-width + 16px;
                x: root.tip-ax - cm.absolute-position.x + 14px + tip-w > cm.width - 8px
                    ? root.tip-ax - cm.absolute-position.x - tip-w - 14px
                    : root.tip-ax - cm.absolute-position.x + 14px;
                y: root.tip-ay - cm.absolute-position.y - 28px < 8px
                    ? root.tip-ay - cm.absolute-position.y + 18px
                    : root.tip-ay - cm.absolute-position.y - 28px;
                height: 24px;
                width: tip-w;
                border-radius: 6px;
                border-width: 1px;
                border-color: Theme.border-strong;
                background: Theme.popup-bg-elevated;
                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    alignment: center;
                    tip-label := Text {
                        text: root.tip-text;
                        color: Theme.text-primary;
                        font-size: 11px;
                        vertical-alignment: center;
                        overflow: elide;
                        max-width: 240px;
                    }
                }
            }

            // ══ 拖动浮层（跟手 +14/+14 的 ghost 标签）══
            if root.dragging : Rectangle {
                x: root.drag-abs-x - cm.absolute-position.x + 14px;
                y: root.drag-abs-y - cm.absolute-position.y + 14px;
                width: drag-glow.preferred-width + 20px;
                height: 26px;
                border-radius: 6px;
                border-width: 1px;
                border-color: Theme.accent.with-alpha(0.42);
                background: Theme.popup-bg;
                drag-glow := HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    spacing: 6px;
                    cross-axis-alignment: center;
                    Icon {
                        glyph: root.drag-kind == "group" ? "folder" : "command-bar";
                        tint: Theme.accent-solid;
                        size: 12px;
                    }
                    Text {
                        text: root.drag-label;
                        color: Theme.text-primary;
                        font-size: 11.5px;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }
            }
        }
    }

    // ══════════ 辅助函数 / 子逻辑 ══════════

    // 行数：卡片按 2 张一行摊开
    property <int> card-rows: (root.cards.length + 1) / 2;
    // 拖拽中的实际条数（整块 = picked；否则 1）——+N 徽标用
    in-out property <int> drag-n: 1;

    function ed-name-ok() -> bool { return root.ed-name != ""; }
    function ed-cmd-ok() -> bool { return root.ed-cmd != ""; }

    // 分组组合框的当前值：空 /「默认分组」→ ""（默认分组）
    function gc-value() -> string {
        let v = root.ed-group;
        if (v == "" || v == (root.lang-en ? "Default" : "默认分组")) { return ""; }
        return v;
    }

    // ghost 补全：已输入是某组前缀（大小写不敏感，跳过完全相等）→ 该组名。
    // ⚠️ Slint 函数体不支持 for / 递归，只能定长展开（16 组上限，与新建会话
    // GroupCombo 同一约束）。
    function gc-match() -> string {
        let v = root.ed-group;
        if (v == "") { return ""; }
        if (root.menu-groups.length > 0 && root.menu-groups[0].display != v
            && root.menu-groups[0].display.to-lowercase().starts-with(v.to-lowercase())) {
            return root.menu-groups[0].display;
        }
        if (root.menu-groups.length > 1 && root.menu-groups[1].display != v
            && root.menu-groups[1].display.to-lowercase().starts-with(v.to-lowercase())) {
            return root.menu-groups[1].display;
        }
        if (root.menu-groups.length > 2 && root.menu-groups[2].display != v
            && root.menu-groups[2].display.to-lowercase().starts-with(v.to-lowercase())) {
            return root.menu-groups[2].display;
        }
        if (root.menu-groups.length > 3 && root.menu-groups[3].display != v
            && root.menu-groups[3].display.to-lowercase().starts-with(v.to-lowercase())) {
            return root.menu-groups[3].display;
        }
        if (root.menu-groups.length > 4 && root.menu-groups[4].display != v
            && root.menu-groups[4].display.to-lowercase().starts-with(v.to-lowercase())) {
            return root.menu-groups[4].display;
        }
        if (root.menu-groups.length > 5 && root.menu-groups[5].display != v
            && root.menu-groups[5].display.to-lowercase().starts-with(v.to-lowercase())) {
            return root.menu-groups[5].display;
        }
        if (root.menu-groups.length > 6 && root.menu-groups[6].display != v
            && root.menu-groups[6].display.to-lowercase().starts-with(v.to-lowercase())) {
            return root.menu-groups[6].display;
        }
        if (root.menu-groups.length > 7 && root.menu-groups[7].display != v
            && root.menu-groups[7].display.to-lowercase().starts-with(v.to-lowercase())) {
            return root.menu-groups[7].display;
        }
        if (root.menu-groups.length > 8 && root.menu-groups[8].display != v
            && root.menu-groups[8].display.to-lowercase().starts-with(v.to-lowercase())) {
            return root.menu-groups[8].display;
        }
        if (root.menu-groups.length > 9 && root.menu-groups[9].display != v
            && root.menu-groups[9].display.to-lowercase().starts-with(v.to-lowercase())) {
            return root.menu-groups[9].display;
        }
        if (root.menu-groups.length > 10 && root.menu-groups[10].display != v
            && root.menu-groups[10].display.to-lowercase().starts-with(v.to-lowercase())) {
            return root.menu-groups[10].display;
        }
        if (root.menu-groups.length > 11 && root.menu-groups[11].display != v
            && root.menu-groups[11].display.to-lowercase().starts-with(v.to-lowercase())) {
            return root.menu-groups[11].display;
        }
        if (root.menu-groups.length > 12 && root.menu-groups[12].display != v
            && root.menu-groups[12].display.to-lowercase().starts-with(v.to-lowercase())) {
            return root.menu-groups[12].display;
        }
        if (root.menu-groups.length > 13 && root.menu-groups[13].display != v
            && root.menu-groups[13].display.to-lowercase().starts-with(v.to-lowercase())) {
            return root.menu-groups[13].display;
        }
        if (root.menu-groups.length > 14 && root.menu-groups[14].display != v
            && root.menu-groups[14].display.to-lowercase().starts-with(v.to-lowercase())) {
            return root.menu-groups[14].display;
        }
        if (root.menu-groups.length > 15 && root.menu-groups[15].display != v
            && root.menu-groups[15].display.to-lowercase().starts-with(v.to-lowercase())) {
            return root.menu-groups[15].display;
        }
        return "";
    }

    // 精确命中已有组（含 ghost 目标）→ 该组 key；否则 ""
    function gc-exact() -> string {
        let v = root.ed-group;
        let m = gc-match();
        let target = m != "" ? m : v;
        if (root.menu-groups.length > 0 && root.menu-groups[0].display == target) {
            return root.menu-groups[0].key;
        }
        if (root.menu-groups.length > 1 && root.menu-groups[1].display == target) {
            return root.menu-groups[1].key;
        }
        if (root.menu-groups.length > 2 && root.menu-groups[2].display == target) {
            return root.menu-groups[2].key;
        }
        if (root.menu-groups.length > 3 && root.menu-groups[3].display == target) {
            return root.menu-groups[3].key;
        }
        if (root.menu-groups.length > 4 && root.menu-groups[4].display == target) {
            return root.menu-groups[4].key;
        }
        if (root.menu-groups.length > 5 && root.menu-groups[5].display == target) {
            return root.menu-groups[5].key;
        }
        if (root.menu-groups.length > 6 && root.menu-groups[6].display == target) {
            return root.menu-groups[6].key;
        }
        if (root.menu-groups.length > 7 && root.menu-groups[7].display == target) {
            return root.menu-groups[7].key;
        }
        if (root.menu-groups.length > 8 && root.menu-groups[8].display == target) {
            return root.menu-groups[8].key;
        }
        if (root.menu-groups.length > 9 && root.menu-groups[9].display == target) {
            return root.menu-groups[9].key;
        }
        if (root.menu-groups.length > 10 && root.menu-groups[10].display == target) {
            return root.menu-groups[10].key;
        }
        if (root.menu-groups.length > 11 && root.menu-groups[11].display == target) {
            return root.menu-groups[11].key;
        }
        if (root.menu-groups.length > 12 && root.menu-groups[12].display == target) {
            return root.menu-groups[12].key;
        }
        if (root.menu-groups.length > 13 && root.menu-groups[13].display == target) {
            return root.menu-groups[13].key;
        }
        if (root.menu-groups.length > 14 && root.menu-groups[14].display == target) {
            return root.menu-groups[14].key;
        }
        if (root.menu-groups.length > 15 && root.menu-groups[15].display == target) {
            return root.menu-groups[15].key;
        }
        return "";
    }

    // 分组命中数（hint「已有分组「X」 · N 条」）
    function gc-count() -> int {
        let k = gc-exact();
        if (root.menu-groups.length > 0 && root.menu-groups[0].key == k) {
            return root.menu-groups[0].count;
        }
        if (root.menu-groups.length > 1 && root.menu-groups[1].key == k) {
            return root.menu-groups[1].count;
        }
        if (root.menu-groups.length > 2 && root.menu-groups[2].key == k) {
            return root.menu-groups[2].count;
        }
        if (root.menu-groups.length > 3 && root.menu-groups[3].key == k) {
            return root.menu-groups[3].count;
        }
        if (root.menu-groups.length > 4 && root.menu-groups[4].key == k) {
            return root.menu-groups[4].count;
        }
        if (root.menu-groups.length > 5 && root.menu-groups[5].key == k) {
            return root.menu-groups[5].count;
        }
        if (root.menu-groups.length > 6 && root.menu-groups[6].key == k) {
            return root.menu-groups[6].count;
        }
        if (root.menu-groups.length > 7 && root.menu-groups[7].key == k) {
            return root.menu-groups[7].count;
        }
        if (root.menu-groups.length > 8 && root.menu-groups[8].key == k) {
            return root.menu-groups[8].count;
        }
        if (root.menu-groups.length > 9 && root.menu-groups[9].key == k) {
            return root.menu-groups[9].count;
        }
        if (root.menu-groups.length > 10 && root.menu-groups[10].key == k) {
            return root.menu-groups[10].count;
        }
        if (root.menu-groups.length > 11 && root.menu-groups[11].key == k) {
            return root.menu-groups[11].count;
        }
        if (root.menu-groups.length > 12 && root.menu-groups[12].key == k) {
            return root.menu-groups[12].count;
        }
        if (root.menu-groups.length > 13 && root.menu-groups[13].key == k) {
            return root.menu-groups[13].count;
        }
        if (root.menu-groups.length > 14 && root.menu-groups[14].key == k) {
            return root.menu-groups[14].count;
        }
        if (root.menu-groups.length > 15 && root.menu-groups[15].key == k) {
            return root.menu-groups[15].count;
        }
        return 0;
    }

    // 分组动态描述四态：空值引导 / 「默认分组」字面 / 命中已有 · N 条 / 将新建
    function gc-hint() -> string {
        let v = root.ed-group;
        if (v == "") {
            return root.lang-en ? "empty → default group" : "留空归入默认分组；可输入新名称";
        }
        if (v == (root.lang-en ? "Default" : "默认分组")) {
            return root.lang-en ? "will go to the default group" : "命令将归入默认分组";
        }
        if (gc-exact() != "") {
            return (root.lang-en ? "existing group · " : "已有分组 · ") + gc-count()
                + (root.lang-en ? "" : " 条");
        }
        return (root.lang-en ? "will create group \"" : "将新建分组「") + v
            + (root.lang-en ? "\"" : "」");
    }

    // 打开编辑卡（新建）：不自动聚焦任何输入框（用户点名：聚焦光环 + 输入法
    // 被动弹出都嫌吵）
    function open-editor-new() {
        root.ed-mode = "new";
        root.ed-key = "";
        root.ed-name = "";
        root.ed-note = "";
        root.ed-cmd = "";
        root.ed-group = "";
        root.ed-send = false;      // 新建默认「填入」—— 更安全的档位
        root.ed-name-err = false;
        root.ed-cmd-err = false;
        root.gc-pop = false;
        root.ed-open = true;
    }

    // 打开编辑卡（编辑）：初值来自被点的卡
    function open-editor-edit(c-key: string, n: string, note: string, cmd: string,
        g-key: string, g-disp: string, send: bool) {
        root.ed-mode = "edit";
        root.ed-key = c-key;
        root.ed-name = n;
        root.ed-note = note;
        root.ed-cmd = cmd;
        root.ed-group = g-disp;
        root.ed-send = send;
        root.ed-name-err = false;
        root.ed-cmd-err = false;
        root.gc-pop = false;
        root.ed-open = true;
    }

    // 保存编辑卡：名称/命令空 → 红字即时提示（保存恒在，disabled 表达）
    function save-editor() {
        root.ed-name-err = root.ed-name == "";
        root.ed-cmd-err = root.ed-cmd == "";
        if (root.ed-name-err || root.ed-cmd-err) { return; }
        let is-new = root.ed-mode == "new";
        let name = root.ed-name;
        let err = root.save-cmd(root.ed-key, name, root.ed-note,
            root.ed-cmd, root.ed-group, root.ed-send);
        if (err == "name") { root.ed-name-err = true; return; }
        if (err == "cmd") { root.ed-cmd-err = true; return; }
        if (err != "") { return; }
        root.ed-open = false;
        root.gc-pop = false;
        root.focus-pulse += 1;
        root.flash(is-new
            ? (root.lang-en ? "Created \"" : "已新建「") + name
                + (root.lang-en ? "\"" : "」")
            : (root.lang-en ? "Updated \"" : "已更新「") + name
                + (root.lang-en ? "\"" : "」"));
    }

    // ── 卡片拖拽：起拖 / 拖动 / 落点 ──
    // 卡片 TouchArea 的 move（>5px）统一回调 start-card-drag：第一次 = 起拖，
    // 之后 = 只更新落点；up 一律走 finish-card-drag 分派（组行 / 卡间）。
    function start-card-drag(key: string, ax: length, ay: length, n: int) {
        if (root.dragging) { move-card-drag(ax, ay); return; }
        if (root.editing != "" || root.creating) { return; }
        root.dragging = true;
        root.drag-kind = "card";
        root.drag-key = key;
        root.drag-abs-x = ax;
        root.drag-abs-y = ay;
        root.drag-n = n;   // 整块 = 拖的卡已勾选且勾了多条（卡内已算好）
        update-drop(ax, ay);
    }

    function move-card-drag(ax: length, ay: length) {
        root.drag-abs-x = ax;
        root.drag-abs-y = ay;
        update-drop(ax, ay);
    }

    // 组行号 → 行顶部 y（glay 内容原点，含 8px padding-top；「我的分组」小节
    // 在第一个自定义组前占 28px）。groups 序列由 Rust 保证为
    // [全部命令, 默认分组, 自定义组...]，所以 cap 只出现一次且必在自定义组段前。
    function gi-top(i: int) -> length {
        let cap = root.custom-count > 0 ? root.cap-h : 0px;
        return 8px + i * root.row-h + (i >= 2 ? cap : 0px);
    }
    // 内容 y → 组行号（clamp；含小节偏移）
    function gi-at(y: length) -> int {
        let cap = root.custom-count > 0 ? root.cap-h : 0px;
        // 指针落在小节标题带（或其上方）→ 按无小节的行高直算（0/1 行）；
        // 函数体不能二次赋值 → 单表达式。
        let above-cap = y - 8px < cap;
        let i = above-cap
            ? Math.floor((y - 8px) / root.row-h)
            : Math.floor((y - 8px - cap) / root.row-h) + 2;
        return Math.max(0, Math.min(root.groups.length - 1, i));
    }

    // 拖动落点：指针在左栏 → 组行（drop-gi，只认 kind>=1 的行）；在网格 →
    // 四向插入（slot+方向）。搜索态不排序（过滤后的相邻是假相邻）。
    function update-drop(ax: length, ay: length) {
        // 左栏命中区 = 弹框内 x < 左栏宽（几何快照由手势回调刷新）
        let in-left = ax < root.geo-left-edge + root.left-w;
        root.over-group = in-left;
        if (in-left) {
            let gi = gi-at(ay - root.geo-glay-y);
            // 「全部命令」行不是落点 → 悬停反馈也不给（JS：无意义落点不响应）
            if (gi >= 0 && gi < root.groups.length && root.groups[gi].kind == 0) {
                root.drop-gi = -1;
            } else {
                root.drop-gi = gi;
            }
            root.drag-insert-slot = -1;
            root.drag-ins = -1;
            return;
        }
        root.drop-gi = -1;
        root.drag-insert-slot = -1;
        root.drag-ins = -1;
        if (root.query != "") { return; }
        // 网格内：按内容坐标推算行列（mgrid 的 padding 10/14）
        let gy = ay - root.geo-mgrid-y - 10px;
        let gx = ax - root.geo-mgrid-x - 14px;
        if (gy < 0px || gx < 0px) { return; }
        let col-w = (root.geo-mgrid-w - 28px - root.card-gap) / 2;
        let row = Math.floor(gy / root.card-row-h);
        let col = Math.min(1, Math.floor(gx / (col-w + root.card-gap)));
        let slot = row * 2 + col;
        if (slot < 0 || slot >= root.cards.length) { return; }
        // 四向：鼠标相对目标卡中心的主导轴（左右邻 = 竖线，上下邻 = 横线）
        let cx = root.geo-mgrid-x + 14px + col * (col-w + root.card-gap) + col-w / 2;
        let cy = root.geo-mgrid-y + 10px + row * root.card-row-h + root.card-h / 2;
        let dx = ax - cx;
        let dy = ay - cy;
        root.drag-insert-slot = slot;
        root.drag-ins = Math.abs(dx) > Math.abs(dy)
            ? (dx < 0px ? 2 : 3)
            : (dy < 0px ? 0 : 1);
    }

    // 卡片 up 的统一分派：不是卡拖拽（纯点击的 up 也会来）直接吞掉。
    function finish-card-drag() {
        if (!root.dragging || root.drag-kind != "card") { return; }
        let key = root.drag-key;
        let gi = root.drop-gi;
        let slot = root.drag-insert-slot;
        let ins = root.drag-ins;
        reset-drag();
        if (gi >= 0 && gi < root.groups.length) {
            // 卡 → 左栏组行 = 移动分组（kind==0 已在 update-drop 排除）
            let g = root.groups[gi];
            let n = root.drop-group(key, g.key);
            if (n > 0) {
                root.flash((root.lang-en ? "" : "已移动 ") + n
                    + (root.lang-en ? " commands → " : " 条命令 → ") + g.display);
            }
            return;
        }
        if (slot < 0 || slot >= root.cards.length || ins < 0) { return; }
        // 卡 → 卡之间 = 排序（top/left = 插到目标之前）
        let after = ins == 1 || ins == 3;
        let n = root.drop-cards(key, root.cards[slot].key, after);
        if (n > 0) {
            root.flash((root.lang-en ? "Moved " : "已移动 ") + n
                + (root.lang-en ? " commands" : " 条"));
        }
    }

    function reset-drag() {
        root.dragging = false;
        root.drag-kind = "";
        root.drag-key = "";
        root.over-group = false;
        root.drop-gi = -1;
        root.drag-insert-slot = -1;
        root.drag-ins = -1;
        root.drag-n = 1;
    }
}
