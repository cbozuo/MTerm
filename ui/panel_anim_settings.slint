// (#panel-anim 2026-11-05) 设置弹框「侧栏」页新增分组：收展动效。
//
// 高保真 docs/design/two-sidebar-hifi-2026-11-04.html（V9）§01：预设一键套用
// （4 chips）+ 一套 形态/时长/缓动/减少动效 配置，**同时作用于左右两栏**。
// 数据源 = global PanelAnim（ui/panel_anim.slint，Rust 启动 seed + 这里修改
// 后经回调由 Rust 回写并落盘）；词表/出厂值/预设三元组与 src/panel_anim.rs
// 同源（两边一起改）。
//
// 行样式自带（SettingRow/Switch 是 interface_panel 内部组件，跨文件不可
// import），公共件复用 SegGroup（seg.slint）与 MTermSlider（widgets.slint）；
// 段件遵循 #seg-uniform-cells 协议（min/preferred-width 归零 + stretch）。
import { Theme } from "theme.slint";
import { SegGroup } from "seg.slint";
import { MTermSlider } from "widgets.slint";
import { PanelAnim } from "panel_anim.slint";

// SegGroup 段件：纯文字，等分格（#seg-uniform-cells）。
component AnimSeg inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    callback clicked();
    horizontal-stretch: 1;
    min-width: 0px;
    preferred-width: 0px;
    border-radius: 6px;
    background: root.active ? transparent : (ta.has-hover ? Theme.bg-hover : transparent);
    Text {
        text: root.label;
        color: root.active ? Theme.accent : (ta.has-hover ? Theme.text-primary : Theme.text-secondary);
        font-size: Theme.fs-sm;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }
    ta := TouchArea { mouse-cursor: default; clicked => { root.clicked(); } }
}

// 预设胶囊 chip（高保真 .pm-chip：名称 + 副标两行，顺滑带「默认」角标）。
component PresetChip inherits Rectangle {
    in property <string> name;
    in property <string> sub;
    in property <string> tag;
    in property <bool> active;
    callback clicked();
    height: 40px;
    horizontal-stretch: 1;
    min-width: 0px;
    preferred-width: 0px;
    border-radius: 8px;
    border-width: 1px;
    border-color: root.active ? Theme.accent : Theme.border-control;
    background: root.active ? Theme.chip : (ta.has-hover ? Theme.bg-hover : Theme.popup-field);
    animate background, border-color { duration: 120ms; }
    VerticalLayout {
        alignment: center;
        spacing: 1px;
        padding-left: 8px;
        padding-right: 8px;
        HorizontalLayout {
            spacing: 4px;
            Text {
                text: root.name;
                color: root.active ? Theme.accent : Theme.text-primary;
                font-size: 12px * Theme.panel-font;
                font-weight: Theme.fw-strong;
                vertical-alignment: center;
                overflow: elide;
            }
            // 「默认」角标（仅顺滑）：右上小字。
            if root.tag != "" : Rectangle {
                border-radius: 3px;
                border-width: 1px;
                border-color: Theme.accent;
                background: transparent;
                min-width: tag-t.preferred-width + 6px;
                height: 13px;
                tag-t := Text {
                    text: root.tag;
                    color: Theme.accent;
                    font-size: 8.5px * Theme.panel-font;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
        Text {
            text: root.sub;
            color: Theme.text-muted;
            font-size: 9.5px * Theme.panel-font;
            vertical-alignment: center;
        }
    }
    ta := TouchArea { mouse-cursor: default; clicked => { root.clicked(); } }
}

export component PanelAnimGroup inherits Rectangle {
    in property <bool> lang-en;
    // 修改走显式回调（app.slint 转发 → Rust 落盘 + 回写 global）；回显直接
    // 读 PanelAnim global（绑定自动更新）。
    callback set-shape(string);
    callback set-ms(int);
    callback set-easing(string);
    callback set-reduced-anim(bool);
    callback set-preset(string);

    // ── 显示用词表/映射（与 src/panel_anim.rs 同源）────────────────────
    pure function shape-name(s: string) -> string {
        return s == "instant" ? (root.lang-en ? "Instant" : "瞬时")
            : s == "push" ? (root.lang-en ? "Push" : "推挤")
            : s == "swallow" ? (root.lang-en ? "Swallow" : "吞没")
            : s == "accordion" ? (root.lang-en ? "Accordion" : "手风琴")
            : s == "homing" ? (root.lang-en ? "Homing" : "归巢")
            : (root.lang-en ? "Jelly" : "果冻");
    }
    pure function shape-desc(s: string) -> string {
        return s == "instant" ? (root.lang-en
                ? "No transition: the width jumps into place. Most stable, but loses the sense of direction."
                : "无过渡，宽度直接跳位；最稳，但看不出收去哪了。")
            : s == "push" ? (root.lang-en
                ? "The width squeezes the terminal and it reflows — closest to a native collapse."
                : "宽度跟随挤压重排，最贴近「原生收缩」。")
            : s == "swallow" ? (root.lang-en
                ? "The outer edge collapses while the content stays full-width; a scan line sweeps the closing edge."
                : "外层收宽、内容保持满宽；收口处一条扫描线收束。")
            : s == "accordion" ? (root.lang-en
                ? "The content narrows one step behind the edge, like folding the panel up."
                : "内容比收口边缘慢半拍收窄，像把面板折起来。")
            : s == "homing" ? (root.lang-en
                ? "The content flies toward the collapse button and fades out; the panel then narrows."
                : "内容飞向收起按钮并淡出，面板随后收宽。")
            : (root.lang-en
                ? "A slight overshoot and settle-back for a springy feel."
                : "过冲后回弹，带一点手感。");
    }
    pure function easing-name(e: string) -> string {
        return e == "standard" ? (root.lang-en ? "Standard" : "标准")
            : e == "spring" ? (root.lang-en ? "Springy" : "弹性")
            : (root.lang-en ? "Smooth" : "顺滑");
    }
    // 当前三元组命中的预设 key（"" = 自定义）。与 PRESETS 同源。
    pure function preset-key() -> string {
        return PanelAnim.shape == "push" && PanelAnim.ms == 120 && PanelAnim.easing == "standard" ? "follow"
            : PanelAnim.shape == "push" && PanelAnim.ms == 240 && PanelAnim.easing == "smooth" ? "smooth"
            : PanelAnim.shape == "swallow" && PanelAnim.ms == 320 && PanelAnim.easing == "smooth" ? "cinema"
            : PanelAnim.shape == "jelly" && PanelAnim.ms == 380 && PanelAnim.easing == "spring" ? "lively"
            : "";
    }
    pure function preset-name() -> string {
        return root.preset-key() == "follow" ? (root.lang-en ? "Follow" : "跟手")
            : root.preset-key() == "smooth" ? (root.lang-en ? "Smooth" : "顺滑")
            : root.preset-key() == "cinema" ? (root.lang-en ? "Cinematic" : "电影感")
            : root.preset-key() == "lively" ? (root.lang-en ? "Lively" : "活泼")
            : (root.lang-en ? "Custom" : "自定义");
    }

    height: pal.preferred-height;
    background: transparent;
    pal := VerticalLayout {
        spacing: 0;
        // ── 分组标题（SectionHeader 语言 + 新增徽章）────────────────────
        Rectangle {
            height: 30px;
            HorizontalLayout {
                spacing: 8px;
                alignment: start;
                Text {
                    text: root.lang-en ? "Collapse / expand animation" : "收展动效";
                    font-size: 11px * Theme.panel-font;
                    font-weight: Theme.fw-strong;
                    color: Theme.text-muted;
                    vertical-alignment: center;
                }
                Rectangle {
                    border-radius: 999px;
                    border-width: 1px;
                    border-color: Theme.accent;
                    background: Theme.accent.with-alpha(0.12);
                    min-width: badge-t.preferred-width + 12px;
                    height: 15px;
                    badge-t := Text {
                        text: root.lang-en ? "New" : "新增";
                        color: Theme.accent;
                        font-size: 8.5px * Theme.panel-font;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // ── 预设行：label + 当前回显；下方 4 chips ─────────────────────
        VerticalLayout {
            spacing: 4px;
            padding-top: 6px;
            HorizontalLayout {
                spacing: 14px;
                Text {
                    text: root.lang-en ? "Preset" : "预设";
                    color: Theme.text-primary;
                    font-size: 13px * Theme.panel-font;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                Text {
                    // 「当前：顺滑（推挤 · 240ms · 顺滑）」/「当前：自定义（…）」
                    text: (root.lang-en ? "Current: " : "当前：") + root.preset-name()
                        + (root.lang-en ? " (" : "（")
                        + shape-name(PanelAnim.shape) + " · " + PanelAnim.ms + "ms · "
                        + easing-name(PanelAnim.easing)
                        + (root.lang-en ? ")" : "）");
                    color: Theme.text-muted;
                    font-size: 11px * Theme.panel-font;
                    vertical-alignment: center;
                }
            }
            HorizontalLayout {
                spacing: 6px;
                PresetChip {
                    name: root.lang-en ? "Follow" : "跟手";
                    sub: "120ms";
                    tag: "";
                    active: root.preset-key() == "follow";
                    clicked => { root.set-preset("follow"); }
                }
                PresetChip {
                    name: root.lang-en ? "Smooth" : "顺滑";
                    sub: "240ms";
                    tag: root.lang-en ? "Default" : "默认";
                    active: root.preset-key() == "smooth";
                    clicked => { root.set-preset("smooth"); }
                }
                PresetChip {
                    name: root.lang-en ? "Cinematic" : "电影感";
                    sub: "320ms";
                    tag: "";
                    active: root.preset-key() == "cinema";
                    clicked => { root.set-preset("cinema"); }
                }
                PresetChip {
                    name: root.lang-en ? "Lively" : "活泼";
                    sub: "380ms";
                    tag: "";
                    active: root.preset-key() == "lively";
                    clicked => { root.set-preset("lively"); }
                }
            }
        }

        // ── 形态行：6 选 SegGroup + 说明 ───────────────────────────────
        VerticalLayout {
            spacing: 4px;
            padding-top: 10px;
            Text {
                text: root.lang-en ? "Shape" : "形态";
                color: Theme.text-primary;
                font-size: 13px * Theme.panel-font;
            }
            SegGroup {
                height: 30px;
                compact: true;
                count: 6;
                active-index: PanelAnim.shape == "instant" ? 0
                    : PanelAnim.shape == "push" ? 1
                    : PanelAnim.shape == "swallow" ? 2
                    : PanelAnim.shape == "accordion" ? 3
                    : PanelAnim.shape == "homing" ? 4
                    : 5;
                AnimSeg { label: root.lang-en ? "Instant" : "瞬时"; active: PanelAnim.shape == "instant"; clicked => { root.set-shape("instant"); } }
                AnimSeg { label: root.lang-en ? "Push" : "推挤"; active: PanelAnim.shape == "push"; clicked => { root.set-shape("push"); } }
                AnimSeg { label: root.lang-en ? "Swallow" : "吞没"; active: PanelAnim.shape == "swallow"; clicked => { root.set-shape("swallow"); } }
                AnimSeg { label: root.lang-en ? "Accordion" : "手风琴"; active: PanelAnim.shape == "accordion"; clicked => { root.set-shape("accordion"); } }
                AnimSeg { label: root.lang-en ? "Homing" : "归巢"; active: PanelAnim.shape == "homing"; clicked => { root.set-shape("homing"); } }
                AnimSeg { label: root.lang-en ? "Jelly" : "果冻"; active: PanelAnim.shape == "jelly"; clicked => { root.set-shape("jelly"); } }
            }
            Text {
                text: shape-name(PanelAnim.shape) + " · " + shape-desc(PanelAnim.shape);
                color: Theme.text-muted;
                font-size: 10.5px * Theme.panel-font;
                wrap: word-wrap;
            }
        }

        // ── 时长行：80–600ms，步进 10（拖动中只显数，松手落盘）──────────
        VerticalLayout {
            spacing: 4px;
            padding-top: 10px;
            HorizontalLayout {
                spacing: 14px;
                Text {
                    text: root.lang-en ? "Duration" : "时长";
                    color: Theme.text-primary;
                    font-size: 13px * Theme.panel-font;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
                Text {
                    text: PanelAnim.ms + "ms";
                    color: Theme.text-primary;
                    font-size: 12px * Theme.panel-font;
                    vertical-alignment: center;
                }
            }
            MTermSlider {
                width: 100%;
                minimum: 80;
                maximum: 600;
                default-value: 240;
                value: PanelAnim.ms * 1.0;
                // 步进 10 量化后再落盘（UI 拖动是连续浮点）。
                released(v) => { root.set-ms(round(v / 10.0) * 10); }
            }
        }

        // ── 缓动行：标准 / 顺滑 / 弹性 ─────────────────────────────────
        VerticalLayout {
            spacing: 4px;
            padding-top: 10px;
            Text {
                text: root.lang-en ? "Easing" : "缓动";
                color: Theme.text-primary;
                font-size: 13px * Theme.panel-font;
            }
            SegGroup {
                height: 30px;
                compact: true;
                count: 3;
                active-index: PanelAnim.easing == "standard" ? 0
                    : PanelAnim.easing == "spring" ? 2 : 1;
                AnimSeg { label: root.lang-en ? "Standard" : "标准"; active: PanelAnim.easing == "standard"; clicked => { root.set-easing("standard"); } }
                AnimSeg { label: root.lang-en ? "Smooth" : "顺滑"; active: PanelAnim.easing == "smooth"; clicked => { root.set-easing("smooth"); } }
                AnimSeg { label: root.lang-en ? "Springy" : "弹性"; active: PanelAnim.easing == "spring"; clicked => { root.set-easing("spring"); } }
            }
        }

        // ── 减少动效（跟随系统）────────────────────────────────────────
        Rectangle {
            height: pa-sw.preferred-height;
            pa-sw := HorizontalLayout {
                spacing: 14px;
                padding-top: 10px;
                padding-bottom: 2px;
                VerticalLayout {
                    horizontal-stretch: 1;
                    alignment: center;
                    spacing: 3px;
                    Text {
                        text: root.lang-en ? "Reduce motion" : "减少动效";
                        color: Theme.text-primary;
                        font-size: 13px * Theme.panel-font;
                    }
                    Text {
                        text: root.lang-en
                            ? "Follow the OS setting: durations collapse to 0 while the system asks for less animation."
                            : "跟随系统设置：命中时过渡时长归零（不做形态降级）。";
                        color: Theme.text-muted;
                        font-size: 11px * Theme.panel-font;
                        wrap: word-wrap;
                    }
                }
                // iOS 风格开关（与 SettingRow 内 Switch 同构：显示态由 global
                // 驱动，点击发新值，避免自赋值断绑定）。
                Rectangle {
                    width: 38px;
                    height: 22px;
                    border-radius: 11px;
                    background: PanelAnim.reduced-follow ? Theme.accent : Theme.popup-bg-active;
                    animate background { duration: 120ms; }
                    Rectangle {
                        width: 16px;
                        height: 16px;
                        border-radius: 8px;
                        y: 3px;
                        x: PanelAnim.reduced-follow ? parent.width - self.width - 3px : 3px;
                        background: white;
                        animate x { duration: 120ms; easing: ease-out; }
                    }
                    TouchArea {
                        mouse-cursor: default;
                        clicked => { root.set-reduced-anim(!PanelAnim.reduced-follow); }
                    }
                }
            }
        }

        // ── 脚注 ───────────────────────────────────────────────────────
        Rectangle { height: 6px; }
        Text {
            text: root.lang-en
                ? "One config for both sidebars. Changes apply immediately."
                : "配置同时作用于左右两侧，修改即时生效。";
            color: Theme.text-muted;
            font-size: 10px * Theme.panel-font;
        }
    }
}
