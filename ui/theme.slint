// Central design tokens for MTerm.
//
// (#theme-split 2026-10-07) 主题/强调色/壁纸三层解耦后的 token 层。
//
// ★ 色槽的取值来源变了：20 个语义色槽（slot-*）由 **Rust 侧查表写入**
//   （src/theme/ → palettes.rs，38 套官方色表），不再是 `dark ? x : y`
//   三元式。属性名全部保持不变——所有调用点零改动。Rust 在
//   apply_theme() 里一次性写入当前套的槽位，切主题 = 重写属性。
//
// 三层模型（design/theme-wallpaper-split-2026-10-05.html §1）：
//   L1 主题 Theme   = 整套中性色阶 + 语义色 + 终端 ANSI（唯一的对比度责任人）
//   L2 强调色 Accent = 独立于主题（跟随主题 / 9 预设 / 自定义，3:1 守卫在 Rust）
//   L3 壁纸 Wallpaper = 一张图 + 三个独立透明度，不读不写主题
//
// 绘制栈：z0 窗口底色(不透明) → z1 壁纸图(受「壁纸透明度」与「作用域」)
// → z2 四分区雾面(标题栏 / 标签栏 / 侧栏 / 终端区各自 alpha，作用域=终端时
//    前三个强制不透明) → z3 弹窗(主题面色 × 弹窗透明度) + Scrim 遮罩(9 样式)。

export global Theme {
    // ── 当前主题（Rust 在 apply_theme 里写）──────────────────────────
    // 主题 id（palettes.rs 的 38 套之一）；空串 = 尚未应用（仅启动瞬间）。
    in-out property <string> theme-id: "";
    // 当前主题显示名（「石墨 · 暗」），apply 时写入（设置页按钮/速选面板用）。
    in-out property <string> theme-name: "";
    // 明暗：不再是用户开关，而是**当前主题的属性**（派生自表内 dark 列，
    // 由 Rust 写入）。子窗口的 `dark-mode <=> Theme.dark` 绑定与
    // std-widgets 色彩方案联动保持原样。
    in-out property <bool> dark: true;

    // ── 20 语义色槽（★Rust 写入★，0xRRGGBB → color）────────────────
    in-out property <color> slot-root:  #1b1d23;
    in-out property <color> slot-panel: #23262d;
    in-out property <color> slot-palt:  #2a2d35;
    in-out property <color> slot-elev:  #25282f;
    in-out property <color> slot-hov:   #373a44;
    in-out property <color> slot-act:   #3f4350;
    in-out property <color> slot-line:  #3a3d46;
    in-out property <color> slot-lstr:  #4a4e59;
    in-out property <color> slot-t1:    #e6e8ee;
    in-out property <color> slot-t2:    #b4b9c4;
    in-out property <color> slot-t3:    #9196a3;
    in-out property <color> slot-tbg:   #0e0f13;
    in-out property <color> slot-tfg:   #d4d4d4;
    // 强调色：最终生效值（三层叠加已算完——跟随=表 ac，覆盖=守卫校正后的色）。
    in-out property <color> slot-ac:    #4a90e2;
    in-out property <color> slot-ok:    #4ec9b0;
    in-out property <color> slot-wr:    #e2a84a;
    in-out property <color> slot-dg:    #e25c5c;

    // ── 分组色 24 / 频道色 4（★Rust 按主题写入★，声明见文件后段）──────

    // ── L3 壁纸：只负责"背后那张图"，不参与任何颜色决策 ───────────────
    in-out property <image> wallpaper;
    in-out property <bool>  wallpaper-active: false;
    // (#wallpaper-transparency 2026-10-17) 壁纸图自身**透明度**（0 = 完全
    // 清晰，1 = 完全透明）。滑杆语义 = 透明程度，图 alpha = 1 − 本值。
    in-out property <float> wallpaper-transparency: 0.0;
    // (#wallpaper-scope 2026-10-17) 壁纸作用域：0 = 整个界面 / 1 = 终端区。
    // 作用域 = 终端时，标题栏/标签栏/侧栏三区强制不透明，只有终端区允许透出。
    in-out property <int> wallpaper-scope: 0;
    // 填充方式："auto" 自动 / "cover" 填充 / "contain" 适应 / "fill" 拉伸。
    in-out property <string> wallpaper-fit: "auto";
    // (#wallpaper-auto-fit 2026-10-18) 当前壁纸图片的纵横比（宽 ÷ 高），
    // Rust 在 apply_wallpaper 里按解码后的真实尺寸回写。默认 1.6 = 内置
    // 程序化壁纸（1600×1000）。自动填充靠它 + 元素自身尺寸判定：
    // 图片与区域比例接近（裁切 ≤ 25%）→ 填充；差得远 → 适应（不裁切）。
    in-out property <float> wallpaper-aspect: 1.6;
    // 计算实际生效的 image-fit：0 = cover（填充）/ 1 = contain（适应）/
    // 2 = fill（拉伸）。"auto" 按上面那条规则在 0/1 之间选。
    public pure function wallpaper-fit-mode(w: length, h: length) -> int {
        if (root.wallpaper-fit == "contain") { return 1; }
        if (root.wallpaper-fit == "fill") { return 2; }
        if (root.wallpaper-fit != "auto") { return 0; }
        let region = w / h;
        let image = root.wallpaper-aspect;
        if (image <= 0.0 || region <= 0.0) { return 0; }
        let crop = 1.0 - min(image, region) / max(image, region);
        return crop <= 0.25 ? 0 : 1;
    }
    // 「跟随图片取色」开启时，Rust 把图片主色写进来（仅作 accent 来源，
    // 不再染面板、不再反写深浅）。wp-tint 保留仅为兼容既有桥属性/同步代码
    // （frost 已不再混色——界面被壁纸染色的根源已拆）。
    in-out property <color> wp-accent: #4a90e2;
    in-out property <color> wp-tint: #808080;
    // 非分区表面（菜单 / 卡片 / 独立窗口）的基准雾面。四分区各有自己的滑杆
    // 后，面板基准不再由 UI 驱动，保持 #theme-split 的 0.85 观感。
    property <float> panel-alpha: 0.85;

    // ── (#zone-alpha 2026-10-17) 四分区透明度（0 = 不透明，1 = 全透）──────
    // 语义与「壁纸透明度」一致：滑杆值 = 透明程度，面板 alpha = 1 − 值。
    in-out property <float> titlebar-transparency: 0.15;
    in-out property <float> tabbar-transparency: 0.15;
    in-out property <float> sidebar-transparency: 0.15;
    in-out property <float> term-transparency: 0.0;
    // (#zone-alpha-desktop 2026-10-18) 四区恒按各自透明度生效 —— 唯一的例外是
    // 「有壁纸 + 作用域=终端」：那时壁纸铺满全窗，三区必须不透明才能把壁纸挡住
    // （作用域语义），其余情况（**尤其是没有壁纸**）都按滑杆真实半透明。
    // 以前的写法是"作用域=终端就一律强制 1.0"，于是无壁纸时三根滑杆也是死的
    //（用户反馈「四个设置透明没生效」）。
    out property <bool> zones-masked: root.wallpaper-active && root.wallpaper-scope == 1;
    out property <float> titlebar-alpha: root.zones-masked ? 1.0 : 1.0 - root.titlebar-transparency;
    out property <float> tabbar-alpha:   root.zones-masked ? 1.0 : 1.0 - root.tabbar-transparency;
    out property <float> sidebar-alpha:  root.zones-masked ? 1.0 : 1.0 - root.sidebar-transparency;
    out property <float> term-alpha:     1.0 - root.term-transparency;
    // (#popup-transparency 2026-10-17 语义定稿) 弹窗**透明度**：0 = 实心，
    // 1 = 完全透明。它和「遮罩浓度」是两个独立参数 —— 前者管弹窗自己透多少，
    // 后者管弹窗背后压多暗；不做任何互相联动/隐藏加成。
    in-out property <float> popup-transparency: 0.0;

    // Frost a base surface: with a wallpaper active it becomes translucent so
    // the image shows through; otherwise the plain opaque base (#theme-split:
    // 不再向 wp-tint 混色——那是"面板被壁纸染色"的根源，已拆)。
    pure function frost(base: color, alpha: float) -> brush {
        return root.wallpaper-active
            ? base.with-alpha(alpha)
            : base;
    }

    // (#zone-alpha-fix 2026-10-17) 四分区 / 终端区**始终**按 alpha 半透明：
    // `frost()` 在没有壁纸时直接返回实色，于是「分区透明度」四根滑杆被短路
    // （用户截图：调到 100% 毫无变化）。页面文案本来就写着"没有壁纸时透出窗口
    // 底色、效果较弱" —— 窗口底色（root）与面板色只差 2~4 级，所以效果弱，
    // 但不该是"零"。其余表面（菜单/卡片/独立窗口）仍走 frost，默认观感不变。
    pure function zone-frost(base: color, alpha: float) -> brush {
        return base.with-alpha(alpha);
    }

    // --- Palette -----------------------------------------------------------
    // Opaque window base — used by standalone windows (editor / process /
    // system info) and by the about window. The main window no longer paints it:
    // its background is transparent so the four zones can reveal the desktop
    // through their own alpha (#zone-alpha-desktop 2026-10-18).
    out property <brush> window-base: root.slot-root;

    property <color> base-bg-root:      root.slot-root;
    property <color> base-bg-panel:     root.slot-panel;
    property <color> base-bg-panel-alt: root.slot-palt;
    property <color> base-bg-elevated:  root.slot-elev;
    property <color> base-bg-active:    root.slot-act;

    // bg-root frosts lighter (lower alpha) so the wallpaper reads clearly in
    // empty / inset areas; panels stay mostly opaque for legible text.
    out property <brush> bg-root:      frost(base-bg-root, max(0.0, root.panel-alpha - 0.44));
    out property <brush> bg-panel:     frost(base-bg-panel, root.panel-alpha);
    out property <brush> bg-panel-alt: frost(base-bg-panel-alt, root.panel-alpha);
    out property <brush> bg-elevated:  frost(base-bg-elevated, root.panel-alpha);
    // (#zone-alpha 2026-10-17) 四分区专用底：主界面标题栏 / 标签栏 / 侧栏
    // 各读自己的 alpha（终端区走 term-bg）。其余表面（菜单、弹框内衬、独立
    // 窗口）继续用 bg-panel / bg-root —— 它们不属于任何分区。
    out property <brush> zone-titlebar: root.zone-frost(base-bg-panel, root.titlebar-alpha);
    out property <brush> zone-sidebar:  root.zone-frost(base-bg-panel, root.sidebar-alpha);
    // (#sidebar-bottom-panel 2026-10-18) 下方面板（命令栏 / 文件传输栏 / 停靠的
    // 快捷命令面板）在语义上属于「侧栏」这一档（设置页文案：侧栏含左右侧栏与
    // 下方面板）。它们各自原本的底色档位不同（panel / panel-alt / elevated），
    // 这里按档位各给一个 token：alpha = 1 时与原色逐像素相同，调低才一起变透。
    out property <brush> zone-sidebar-alt:  root.zone-frost(base-bg-panel-alt, root.sidebar-alpha);
    out property <brush> zone-sidebar-elev: root.zone-frost(base-bg-elevated, root.sidebar-alpha);
    // 文件面板里的"列头 / 目录树标题"这类**压暗一档的条带**（原 bg-root）。
    out property <brush> zone-sidebar-root: root.zone-frost(base-bg-root, root.sidebar-alpha);
    out property <brush> zone-tabbar:   root.zone-frost(root.slot-tbg,  root.tabbar-alpha);
    // (#hover-accent 2026-10-10) 悬浮高亮统一跟随强调色（用户定稿），
    // 取代原来「frost(slot-hov)」的绝对色写法。原写法的两个问题：
    //   ① slot-hov 是绝对色，各套取值随意，相对底色亮度倍率实测从 0.60 抖到
    //      7.28（12 倍）——换主题就换一种"重的程度"；
    //   ② 同时另有一个写死的 `menu-hover`（12% 白/8% 黑反色蒙版）用在列表行，
    //      于是同一屏左侧列表与右侧工具栏是两套语言，同一套内两者能差 4.72
    //      （solarized-dark）——用户反馈的"很乱"。
    // 现策略：取 accent **压暗 10%** 后叠 8% —— 同一屏里所有悬浮点（列表行、
    // 工具栏图标、按钮、标签）都是"同色系的一点染色"，不再有两种语言。
    // 参数是扫出来的，不是在几种里挑的：37 套 × 4 种底面（panel/palt/elev/root）
    // 共 148 个组合逐一算 t1 正文对比度，要求**不劣于现网基线**再取 ΔRGB 最大者。
    // 为什么方向是"压暗"而不是"提亮"：深色主题正文 t1 本来就是浅灰（如 #b4b4b4），
    // 悬浮底一提亮就贴上文字——实测提亮方案把 t1 压到 2.08（69/148 低于 4.5），
    // 压暗则远离文字。最终 mix=0.10/alpha=0.08：t1 最低 3.25、低于 4.5 的组合
    // 7/148，比现网 bg-hover 基线的 8 个还少一个。
    // 需要更实的"选中态"仍走 accent-soft / chip，悬浮只做一眼可辨的浅染。
    property <color> hover-tint: root.accent-solid.darker(0.10);
    out property <brush> bg-hover: root.hover-tint.with-alpha(0.08);
    out property <brush> bg-active:    frost(base-bg-active, min(1.0, root.panel-alpha + 0.08));
    // Settings dialog: 20% less transparent than the other panels so its dense
    // grey labels stay legible even at a low wallpaper overlay (user request).
    out property <brush> bg-panel-strong: frost(base-bg-panel, min(1.0, root.panel-alpha + 0.20));

    // 弹窗不透明度 = 1 − 透明度，**一条直线**：0% 实心，100% 完全透明。
    // 刻意不做下限 / 分段 / 高光 —— 用户定稿「通透度就是透明度，100% 就该
    // 看到背后的内容」；弹窗透出来的"黑"是背后内容 × 遮罩浓度，由遮罩这个
    // 独立参数决定，不在这里偷偷联动。
    out property <float> popup-alpha: 1.0 - root.popup-transparency;
    out property <brush> popup-bg: base-bg-panel.with-alpha(root.popup-alpha);
    out property <brush> popup-bg-alt: base-bg-panel-alt.with-alpha(root.popup-alpha);
    // (#popup-inset-alpha 2026-10-16) 弹窗内衬底：root 色 × 弹窗通透档。
    // 弹框内的「卡中卡 / 选项块」（关闭方式两块、会话弹框空态与链、确认弹框
    // 详情块）用它 —— 旧写法 `bg-root` 在无壁纸时**不透明**（frost 只在壁纸档
    // 半透明），通透档下把弹窗玻璃「焊死」：只有悬浮（chip 半透明）才透
    // （用户截图「中间两块怎么没有，只有鼠标悬浮的时候才会有」）。
    // 与弹框底 popup-bg 同透明度来源（settings_dialog「与弹窗同源」的口径，
    // 从「卡片本体」推广到「内衬」）。标准档 popup-alpha=1.0 → 与 bg-root 同观感。
    // ⚠️ 别用 popup-bg 本身：同色 × 半透明叠在同色卡底上会「二次混色反而显形」
    // （#foot-flat 教训），内衬必须保持 root↔panel 的色差才有层级。
    out property <brush> popup-bg-inset: base-bg-root.with-alpha(root.popup-alpha);
    // (#popup-surface-alpha 2026-10-16) 弹框内**全部内容表面**的 popup 版：
    // 输入框/下拉（field、field-2）、抬升面（elevated）、选中/按压面（active）
    // 与渐变端点用的 color 版 panel。用户第二轮反馈「其它弹框的没生效（比如
    // 会话的输入框）」——弹框内的表面不跟随档位时，通透档下就是一块块实心贴片。
    // 各 token 语义与对应基础 token 完全一致，只是乘上 popup-alpha；标准档
    // （alpha=1.0）下与基础 token 逐像素同值，零回归。使用范围 = 弹框系文件
    // （session/sync/confirm/color_picker/settings 页/seg/widgets 的 dialog
    // 分支/app.slint 内联弹框），主界面与独立窗口继续用基础 token。
    out property <brush> popup-bg-elevated: base-bg-elevated.with-alpha(root.popup-alpha);
    out property <brush> popup-bg-active: base-bg-active.with-alpha(root.popup-alpha);
    out property <brush> popup-field: root.field.with-alpha(root.popup-alpha);
    out property <brush> popup-field-2: root.field-2.with-alpha(root.popup-alpha);
    // color 版（渐隐条等 linear-gradient 端点需要 color 而非 brush）。
    out property <color> popup-panel: base-bg-panel.with-alpha(root.popup-alpha);

    // (#tab-flush 2026-09-14 / #tab-32 2026-10-07) 选中标签底色与标签栏底色
    // 都 = 终端底色（tab-row-idia 稿：条带底色 = term-bg，选中态全靠 3px 横线，
    // 三者同色）。(#zone-alpha 2026-10-17) 标签栏改读**自己的**分区 alpha。
    out property <brush> tab-active-bg: root.zone-tabbar;
    out property <brush> tab-bar-bg: root.zone-tabbar;
    // (#tab-32) 旧 tab-active-border（1px 灰线）删除：零引用死 token，选中
    // 标识已改为顶部 3px accent 横线（tabs.slint）。

    out property <brush> border-subtle: root.slot-line;
    out property <brush> border-strong: root.slot-lstr;
    // (#hifi-v17 2026-09-18) 控件常态边框:高保真 .control 的 --line,比
    // border-subtle 亮半档、比 border-strong 淡一档 —— 输入框"看得见但不
    // 抢眼"。新建会话对话框用;终端等既有界面仍用上面两档。
    // 会话对话框专用槽不属于主题 20 槽体系（设计稿未覆盖），按明暗保留常量。
    out property <brush> border-control: dark ? #31353e : #dcdce3;
    // (#hifi-v17) 新建会话对话框专用面/线:原型 --field / --field-2 / --line-2。
    // 独立于 bg-elevated,避免把终端面板一起改暗。
    out property <brush> field: dark ? #191b21 : #f4f5f8;
    out property <brush> field-2: dark ? #1d2027 : #eef0f4;
    out property <brush> line-2: dark ? #3f444f : #c7c7cc;
    // (#foot-flat 2026-10-14) 旧 `panel-hi`(会话弹窗页脚色带,dark #282b34 /
    // light #eef0f4,曾为页脚与正文的分色而加深)已**删除**:用户要求页脚背景色
    // 与标题行对齐,唯一引用(session_dialog 的页脚内衬)整块删掉,零引用死
    // token 不再保留(同 #tab-32 删 tab-active-border 的口径)。页脚区从此直接
    // 露卡片底 popup-bg,分区只靠 1phx 分隔线。

    out property <brush> text-primary:   root.slot-t1;
    // Light-mode secondary/muted darkened further (was #55555a / #7c7c82): over a
    // see-through frosted-wallpaper panel the greys were still too faint to read.
    out property <brush> text-secondary: root.slot-t2;
    out property <brush> text-muted:     root.slot-t3;

    // (#default-group-accent 2026-09-10) 强调色三态叠加后的**最终值**由 Rust
    // 写入 slot-ac（跟随=表 ac；预设/自定义=3:1 守卫校正后）。hover/pressed
    // 就地派生——覆盖任意强调色时也能得到正确的悬停/按压层次。
    out property <color> accent-solid:   root.slot-ac;
    out property <brush> accent:         root.accent-solid;
    out property <brush> accent-hover:   root.accent-solid.brighter(0.12);
    out property <brush> accent-pressed: root.accent-solid.darker(0.12);

    // (#close-behavior) 关闭键语义红:世界通用的「关闭」红,与通用
    // danger(按主题查表)刻意分开 —— 关闭键要一眼可辨。
    // UI/app.slint 的 WinBtn 与确认卡的「完全退出」卡片共用这两档。
    out property <color> close-red:         dark ? #e81123 : #c42b1c;
    out property <color> close-red-pressed: dark ? #c50f1f : #a52216;
    // (#tab-32) tab 关闭键 hover 前景（tab-row-idia 稿新增 token；只染红 ×、
    // 不染底。不要复用 #e81123——那是"红底白字"方案的底色，作前景在亮色
    // 档只有 3.59:1）。值 = palettes.rs 的 DANGER_STRONG，这里保持同步。
    out property <color> danger-strong: #dc4b44;

    // (#v4-session-dialog) 选择器选中态 / 开关淡染 / 弹窗遮罩。chip 与 accent-soft
    // 跟强调色走，避免实心 accent 和「创建」主按钮抢层级。modal-scrim 是方案 A：
    // 低 alpha 纯色，无 blur（Slint 无元素级 backdrop-filter）。全屏弹窗要
    // 看得出遮罩，alpha 略高于原型舞台值（暗 0.32 / 亮 0.36）。
    out property <brush> chip:        root.accent-solid.with-alpha(root.dark ? 0.22 : 0.14);
    out property <brush> accent-soft: root.accent-solid.with-alpha(root.dark ? 0.16 : 0.12);

    // ── (#scrim-style 2026-10-17) 遮罩样式 9 选 + 浓度滑杆 ─────────────
    // 样式：auto / dark / light / tint / soft / frost / spot / sheen / random
    // 浓度：0..1（默认 0.32 = 原「标准档」基线）。**不随弹窗透明度联动**。
    in-out property <string> scrim-style: "auto";
    in-out property <float> scrim-strength: 0.32;
    in-out property <int> scrim-random-pick: 0;
    callback scrim-roll();

    public pure function scrim-name(i: int) -> string {
        return i == 1 ? "dark" : i == 2 ? "light" : i == 3 ? "tint"
            : i == 4 ? "soft" : i == 5 ? "frost" : i == 6 ? "spot"
            : i == 7 ? "sheen" : "auto";
    }
    public pure function scrim-label(id: string, en: bool) -> string {
        return id == "dark" ? (en ? "Dark" : "深色")
            : id == "light" ? (en ? "Light" : "浅色")
            : id == "tint" ? (en ? "Tinted glass" : "染色玻璃")
            : id == "soft" ? (en ? "Soft light" : "柔光")
            : id == "frost" ? (en ? "Frost" : "磨砂")
            : id == "spot" ? (en ? "Spotlight" : "聚光")
            : id == "sheen" ? (en ? "Sheen" : "高光")
            : id == "random" ? (en ? "Random (each time)" : "随机（每次打开换）")
            : (en ? "Auto" : "自动");
    }
    out property <string> scrim-eff: root.scrim-style == "random"
        ? root.scrim-name(root.scrim-random-pick)
        : root.scrim-style;

    // 遮罩浓度 = 用户设的值，就是这个值（不随弹窗透明度自动加重）。
    out property <float> scrim-alpha: root.scrim-strength;
    property <color> scrim-base: root.dark ? #0c0d11 : #f4f5f8;
    property <color> scrim-ink: root.dark ? #000000 : #18140e;
    // 压暗基座：五种装饰样式由 Scrim 组件叠加（基座透明），其余为纯色基座。
    out property <float> scrim-base-alpha:
        root.scrim-eff == "tint" || root.scrim-eff == "soft"
        || root.scrim-eff == "frost" || root.scrim-eff == "spot"
        || root.scrim-eff == "sheen" ? 0.0
        : root.scrim-alpha;
    out property <brush> modal-scrim: (root.scrim-eff == "dark" ? #0c0d11
        : root.scrim-eff == "light" ? #f4f5f8
        : root.scrim-base).with-alpha(root.scrim-base-alpha);

    out property <color> scrim-tint-a: root.accent-solid.with-alpha(root.scrim-alpha * 0.85);
    out property <color> scrim-tint-b: root.accent-solid.with-alpha(root.scrim-alpha * 0.40);
    out property <color> scrim-soft-a: root.scrim-ink.with-alpha(min(root.scrim-alpha * 1.15, 0.80));
    out property <color> scrim-soft-b: root.scrim-ink.with-alpha(root.scrim-alpha * 0.30);
    out property <color> scrim-spot-a: root.scrim-ink.with-alpha(root.scrim-alpha * 0.22);
    out property <color> scrim-spot-b: root.scrim-ink.with-alpha(min(root.scrim-alpha * 1.10, 1.0));
    out property <color> scrim-sheen-a: #ffffff.with-alpha(root.scrim-alpha * 0.38);
    out property <color> scrim-sheen-b: #ffffff.with-alpha(0.0);
    out property <color> scrim-sheen-c: root.scrim-ink.with-alpha(root.scrim-alpha * 0.78);
    out property <color> scrim-frost-top: #ffffff.with-alpha(min(root.scrim-alpha * 0.16, 0.10));
    out property <color> scrim-frost-body: root.scrim-base.with-alpha(root.scrim-alpha * 0.70);
    // 滚动渐隐用的不透明面板色（不能走 frost 后的 brush，否则渐变混成灰）。
    out property <color> panel-solid: root.base-bg-panel;

    // 语义色按主题查表（§3-调整⑤：否则"换了主题、状态色还是老配色"）。
    out property <brush> success: root.slot-ok;
    out property <brush> warning: root.slot-wr;
    out property <brush> danger:  root.slot-dg;

    // Terminal uses its own background so it stays readable regardless of
    // what the shell / remote app outputs via ANSI colour codes. With a
    // wallpaper it frosts (kept neutral, not tinted) at the **terminal's own**
    // transparency（#zone-alpha 2026-10-17：下限 0.75 已按用户要求移除）。
    property <color> base-term-bg: root.slot-tbg;
    out property <brush> term-bg: root.zone-frost(base-term-bg, root.term-alpha);
    out property <brush> term-fg: root.slot-tfg;

    // True on macOS (set by Rust). App shortcuts use Cmd (⌘) here instead of
    // Ctrl, so the physical Ctrl key stays free for the shell (^C/^X…) (#158).
    in-out property <bool> is-mac: false;

    // Whether the app window is focused & visible. Rust drives this from winit
    // focus/minimize/occlusion events; the terminal cursor stops blinking when
    // it's false, so an idle background window doesn't repaint (#127).
    in-out property <bool> window-focused: true;

    // Global UI scale (#100/#117/#118). Rust sets this from the saved setting;
    // all font sizes and spacing/radii below multiply by it, so the whole UI
    // grows/shrinks live (the terminal font has its own size setting).
    in-out property <float> ui-scale: 1.0;
    // Settings-panel font scale (#v0.5). The settings card + its text multiply by
    // this so the panel (which is exempt from ui-scale) can still be enlarged.
    in-out property <float> panel-font: 1.0;

    // The window's real device pixel ratio (winit scale-factor, i.e. the OS
    // display scaling — 1.25/1.5/2.0 on typical Windows setups). Slint
    // rasterizes logical px × scale-factor, so a "1px" line always covers
    // scale-factor device rows and any logical-integer position can sit on a
    // fractional device pixel. hairline()/snap-to-device()/radius-win below use
    // it to keep every chrome line exactly one *device* pixel and crisp.
    //
    // (#dpr-hairline 2026-10-11) This property deliberately **shadows** Slint's
    // built-in window property of the same name (Theme is a global, so it has no
    // window context to read it from). Rust therefore cannot feed it through
    // `Window::set_device_pixel_ratio` — it writes the Theme slot directly
    // (`crate::theme::set_dpr`, mirrored on init + on every scale-factor change
    // + re-queried on each winit event, because the pre-run mirror sees the
    // unmapped-window value 1.0). Before that was wired, this stayed at 1.0 and
    // every "1 device pixel" line rendered at 1 *logical* px = 2 physical px on a
    // 200% screen.
    in-out property <float> device-pixel-ratio: 1.0;

    // --- Typography --------------------------------------------------------
    // 12px was the worst rung in the ladder for CJK: Slint rasterizes text with
    // unhinted grayscale AA (no LCD subpixel), and a 12px YaHei/Noto CJK stroke
    // is only ~2 device px wide, so no pixel reaches full coverage and the
    // stroke renders as a bead of half-intensity dots. 13px is the smallest size
    // that still holds a solid stem, so fs-sm now equals fs-md.
    //
    // Both tokens are kept on purpose: they mean different things (small label
    // vs body copy) and ~120 call sites read them. Same rendered size today, but
    // moving fs-md later must not drag every small label with it.
    out property <length> fs-2xs: 10px * root.ui-scale;
    out property <length> fs-xs: 11px * root.ui-scale;
    out property <length> fs-sm: 13px * root.ui-scale;
    out property <length> fs-md: 13px * root.ui-scale;
    out property <length> fs-lg: 15px * root.ui-scale;
    out property <length> fs-xl: 18px * root.ui-scale;

    // Exactly two weight tiers. CJK system fonts (雅黑/Heiti) ship regular+bold
    // only, so every bare 500/600/800 collapsed onto one of these via font
    // matching anyway — spelling intermediates just produced same-rank drift
    // (welcome 600 vs sidebar 400). All UI code reads these; no literal weights.
    out property <int> fw-regular: 400;
    out property <int> fw-strong: 700;

    // Monospace for machine literals only (IPs, paths, ports, keycaps, command
    // examples) — plain numbers and labels read in the UI sans so same-rank
    // text shares one face. Rust resolves the first usable system mono at
    // startup (#font-chain); empty = platform default. Nothing is embedded.
    in-out property <string> font-mono: "";

    // UI (sans) font for editable inputs. The mono chain has no CJK glyphs and
    // native TextInput doesn't glyph-fallback like Text does, so typing Chinese
    // into a bare TextInput renders tofu. Rust sets this to a CJK-capable
    // system font on startup (empty = platform default).
    in-out property <string> ui-font-family: "";

    // Terminal font — Rust sets it from the saved Interface setting, falling
    // back to the resolved system-mono chain default when unset/stale. The
    // cell-probe in terminal_view measures whatever this resolves to, so
    // "" (platform default) still produces a consistent grid.
    in-out property <string> term-font-family: "";
    in-out property <length> term-font-size: 13px;
    in-out property <bool> term-font-bold: false;

    // --- Protocol icon (#proto-icon 2026-09-17, #icon-svg-migration 2026-10-02) ---
    // 连接协议 → SVG 图标名（assets/icons/ 下，经 ui/icons.slint 的 Icon 渲染）。
    // **唯一的协议图标来源**:新建会话对话框的协议下拉框与左侧会话列表的成员
    // 图标都调它,两处恒一致(用户定稿"下拉框里的图标和成员行左侧的图标保持一致")。
    // ssh / local / 未知协议统一回落 terminal。
    //
    // 显式 `public`:被 session_dialog.slint 与 welcome.slint 跨文件调用。
    public pure function protocol-icon(id: string) -> string {
        if (id == "serial") { return "serial-port"; }             // D-sub 接头
        if (id == "telnet") { return "window-asset"; }            // 窗口+标题栏
        if (id == "rdp" || id == "vnc") { return "remote-desktop"; } // 并排双屏
        return "terminal";                                        // 终端窗+提示符
    }

    // --- Group colour (#group-color 2026-09-14) ----------------------------
    // 分组颜色由**用户在右键菜单里设定**(Rust 侧存 HashMap<组名, hex>,
    // 见 config::set_group_color / group_colors),主题层不再派生任何颜色。
    //
    // 旧的"组名 hash → 8 色调色板"派生机制整体退役:颜色随机、且**改个组名
    // 就换色**,无法承担"身份标识"的职责。用户定稿:"默认就是没有色彩的"。
    //
    // 无色(has-color == false)= 回落该主题的**次级前景色**(text-secondary,
    // 与组头文字同一档),**不是更暗的置灰** —— 此前回落 border-subtle
    // (#3a3d46)时,暗底上 caret / 文件夹图标几乎隐形(用户实测"不要置灰,
    // 无色就好")。
    //
    // 显式 `public`:被 welcome.slint 跨组件调用(Slint 1.8 起对私有跨组件
    // 调用会告警,下一版升为 error)。
    public pure function group-color(has-color: bool, value: color) -> color {
        return has-color ? value : root.text-secondary;
    }

    // (#group-color 2026-09-14 / #theme-split 2026-10-07) 取色面板的 24 色
    // 候选：色环上均匀取 18 档 + 6 档中性灰。原 dark/light 两套常量退役——
    // 改为**按当前主题查表**（Rust 写入 group-colors，见 §3-调整⑤：每套
    // 主题的 24 色按其明度重新取档，保证 1px 树线在各自背景上清晰）。
    // 面板按索引取色，长度恒 24。默认值 = meat-dark 档（启动瞬间/Rust 未写时）。
    in-out property <[color]> group-colors: [
        #f87171, #fb923c, #fbbf24, #facc15, #a3e635, #4ade80,
        #34d399, #2dd4bf, #22d3ee, #38bdf8, #60a5fa, #818cf8,
        #a78bfa, #c084fc, #e879f9, #f472b6, #fb7185, #fda4af,
        #f1f5f9, #e2e8f0, #cbd5e1, #a8a29e, #94a3b8, #64748b,
    ];
    // 频道色 4 槽（tab-row-idia：A 蓝 / B 绿 / C 琥珀 / D 紫）。(#tab-32-colors
    // 2026-10-08) 旧四色高饱和且深浅共用——浅色底上刺眼、深色底上发闷（用户
    // 反馈"眼花"）。改按主题取**降饱和中间调**：暗色提亮（tokyo-night 系），
    // 亮色加深保对比；同时作为 tab 字母药丸底色（白字）与状态条颜色都清晰。
    in-out property <[color]> channel-colors: root.dark ? [
        #82aaff, #5dd0bb, #d9a55e, #b98df2,
    ] : [
        #3568c0, #177f5b, #a86f14, #8248bd,
    ];

    // --- Geometry ----------------------------------------------------------
    out property <length> radius-sm: 4px * root.ui-scale;
    out property <length> radius-md: 6px * root.ui-scale;
    out property <length> radius-lg: 10px * root.ui-scale;
    out property <length> radius-xl: 16px * root.ui-scale;

    // (#win-edge-frame-r7 2026-10-18) 主窗口四角的 DWM 裁剪半径 = **8 DIP（逻辑
    // 像素）**，**随 DPI 缩放**（= 8 × device-pixel-ratio 物理像素）。
    //
    // 2026-10-18 真机实测（200% DPI，把 DWMWA_BORDER_COLOR 染成主题色后拟合窗口
    // 外缘圆）：圆心距窗角 ≈16.5 物理、半径 ≈16.1~16.3 物理 → 8.0~8.15 DIP。
    // 旧注释（r1 2026-10-10）断言"Win11 圆角固定 8 物理像素、不随 DPI 缩放"是
    // **错的**：把 100% 缩放下的 8 物理与 8 DIP 混为一谈了。按旧值
    // `8px / device-pixel-ratio`，200% 下只得到 8 物理像素（= 真实裁剪半径的一
    // 半），自绘角弧整段落在 DWM 裁剪区外被裁掉 → 四角没有边框线。
    // 真机像素实测（200%）：窗口外缘 16 物理像素半径处才从桌面切进窗口。
    // 该 token 同时用于 BrandLogoBtn / 关闭键的角落高亮圆角（必须与裁剪弧一致）。
    out property <float> radius-win-px: 8.0;
    out property <length> radius-win: root.radius-win-px * 1px;

    out property <length> gap-xs: 4px * root.ui-scale;
    out property <length> gap-sm: 8px * root.ui-scale;
    out property <length> gap-md: 12px * root.ui-scale;
    out property <length> gap-lg: 16px * root.ui-scale;

    // (#settings-drag-ghost) Snap a length onto the physical-pixel grid.
    // (#settings-divider-line 2026-09-30) The grid step is one *device* pixel
    // expressed in logical lengths — 1px / scale-factor — which at 125% scaling
    // is 0.8 logical px. The old step (1px * ui-scale) was the wrong baseline:
    // ui-scale is the in-app zoom setting, not the renderer's DPR, so on a
    // 125% display the snap was a no-op and every odd logical card position
    // split the card's 1px chrome lines across two device rows — soft and
    // doubled on some drags, crisp on others. Keeping the card's x/y/w/h on
    // this grid makes its lines rasterize identically at every position.
    public pure function snap-to-device(v: length) -> length {
        round(v / (1px / root.device-pixel-ratio)) * (1px / root.device-pixel-ratio);
    }

    // (#settings-divider-line 2026-09-30) Exactly one *device* pixel, as a
    // logical length. At 100% scaling this equals 1px; at 125% it is 0.8px, so
    // a hairline rectangle aligned to the device grid rasterizes to a single
    // crisp row instead of one solid row plus a faint ghost row (what a
    // logical 1px line always costs at 125%). Only use it where the position is
    // device-snapped too (settings card chrome); an unaligned hairline would
    // anti-alias into a fainter, blurrier line than plain 1px.
    public pure function hairline() -> length {
        return 1px / root.device-pixel-ratio;
    }
}
