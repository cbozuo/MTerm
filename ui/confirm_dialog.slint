import { Icon } from "icons.slint";
import { Theme } from "theme.slint";
import { GhostButton } from "widgets.slint";
import { ScrollView } from "std-widgets.slint";

// A destructive (red) action button, matching PrimaryButton's shape.
component DangerButton inherits Rectangle {
    in property <string> text;
    callback clicked();
    height: 30px;
    min-width: 80px;
    border-radius: Theme.radius-sm;
    background: touch.pressed ? #c44a4a : (touch.has-hover ? #ec6a6a : Theme.danger);
    animate background { duration: 120ms; }
    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        alignment: center;
        Text {
            text: root.text;
            color: white;
            font-size: Theme.fs-md;
            font-weight: Theme.fw-strong;
            vertical-alignment: center;
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// In-app modal confirmation dialog, styled to match the rest of MTerm
// (a dark card over a dimmed backdrop, like SessionDialog).  Purely
// presentational: it emits `confirm` / `cancel` and the caller decides what
// to do.  Used for the irreversible SFTP delete (#28).
export component ConfirmDialog inherits Rectangle {
    in-out property <bool> is-open: false;
    in property <string> title: @tr("Please confirm");
    in property <string> message;
    in property <string> detail;                  // optional, e.g. the file path
    in property <string> confirm-label: @tr("Confirm");
    // Opt in per call site: destructive confirmations must not become
    // keyboard-confirmable merely because they share this component.
    in property <bool> confirm-on-enter: false;
    // Long AI prompts and other large multi-line pastes need a review surface
    // comparable to the system-information window, with fixed footer actions.
    in property <bool> large-detail: false;
    // Temporarily hide this modal behind a higher-priority prompt without
    // discarding its state (for example, app-exit confirmation).
    in property <bool> covered: false;
    // Whether clicking the dimmed backdrop dismisses (cancels) the dialog. Off for
    // security prompts (e.g. host-key trust) so an accidental click outside the card
    // doesn't count as "reject" and abort the connection (#152).
    in property <bool> dismiss-on-backdrop: true;
    callback confirm();
    callback cancel();

    visible: is-open && !covered;
    // (#scrim-unify 2026-10-15) 遮罩统一到 Theme.modal-scrim:旧写死 #000000aa
    // 比会话/同步输入等弹框的 modal-scrim 重一档,同屏不同弹框遮罩深浅不一。
    background: Theme.modal-scrim;

    confirm-key-scope := FocusScope {
        focus-on-click: false;
        focus-on-tab-navigation: false;
        property <bool> active: root.visible && root.confirm-on-enter;
        changed active => {
            if (self.active) {
                self.focus();
            }
        }
        key-pressed(event) => {
            if (root.confirm-on-enter && event.text == Key.Return) {
                root.confirm();
                accept
            } else {
                reject
            }
        }
    }

    // Backdrop click cancels — unless disabled for a must-decide prompt.
    TouchArea {
        width: 100%;
        height: 100%;
        clicked => { if (root.dismiss-on-backdrop) { root.cancel(); } }
    }

    // (#dialog-drag 2026-10-14) 空白区拖动卡片：按下记录卡片原点与指针窗口
    // 绝对坐标（拖动期间稳定），moved 以绝对坐标差值移动；每次打开回中。
    property <bool> card-dragging: false;
    property <length> drag-ox;
    property <length> drag-oy;
    property <length> drag-cx;
    property <length> drag-cy;
    changed is-open => {
        if (self.is-open) {
            card.x = (root.width - card.width) / 2;
            card.y = (root.height - card.height) / 2;
        }
    }

    Rectangle {
        width: root.large-detail ? min(parent.width - 40px, 1160px) : 380px;
        height: root.large-detail ? min(parent.height - 40px, 760px) : card.preferred-height;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        background: Theme.popup-bg;
        border-radius: Theme.radius-lg;
        border-width: 1px;
        border-color: Theme.border-strong;
        drop-shadow-blur: 24px;
        drop-shadow-color: #00000080;

        // Swallow clicks inside the card so they don't hit the backdrop;
        // 空白区按住可拖动卡片（绝对坐标差值，与其它弹框一致）。
        TouchArea {
            width: 100%; height: 100%;
            pointer-event(ev) => {
                if (ev.kind == PointerEventKind.down) {
                    root.card-dragging = true;
                    root.drag-ox = card.x;
                    root.drag-oy = card.y;
                    root.drag-cx = self.absolute-position.x + self.mouse-x;
                    root.drag-cy = self.absolute-position.y + self.mouse-y;
                } else if (ev.kind == PointerEventKind.up) {
                    root.card-dragging = false;
                }
            }
            moved => {
                if (root.card-dragging) {
                    card.x = Math.max(8px, Math.min(
                        root.drag-ox + (self.absolute-position.x + self.mouse-x - root.drag-cx),
                        Math.max(8px, root.width - card.width - 8px)));
                    card.y = Math.max(8px, Math.min(
                        root.drag-oy + (self.absolute-position.y + self.mouse-y - root.drag-cy),
                        Math.max(8px, root.height - card.height - 8px)));
                }
            }
        }

        card := VerticalLayout {
            padding: 20px;
            spacing: 12px;

            HorizontalLayout {
                spacing: 8px;
                Icon {
                    glyph: "warning";
                    tint: Theme.danger;
                    size: Theme.fs-xl;
                }
                Text {
                    text: root.title;
                    color: Theme.text-primary;
                    font-size: Theme.fs-xl;
                    font-weight: Theme.fw-strong;
                    vertical-alignment: center;
                }
            }

            Text {
                text: root.message;
                color: Theme.text-secondary;
                font-size: Theme.fs-md;
                wrap: word-wrap;
            }

            if root.detail != "" && !root.large-detail : Text {
                text: root.detail;
                color: Theme.text-primary;
                font-family: Theme.font-mono;
                font-size: Theme.fs-sm;
                wrap: word-wrap;
            }

            if root.detail != "" && root.large-detail : Rectangle {
                vertical-stretch: 1;
                min-height: 220px;
                // (#popup-inset-alpha 2026-10-16) 详情大块属弹框内衬：跟随通透档。
                background: Theme.popup-bg-inset;
                border-width: 1px;
                border-color: Theme.border-subtle;
                border-radius: Theme.radius-sm;
                clip: true;

                detail-scroll := ScrollView {
                    x: 1px;
                    y: 1px;
                    width: parent.width - 2px;
                    height: parent.height - 2px;
                    content-width: self.visible-width;
                    content-height: max(self.visible-height, detail-text.preferred-height + 16px);

                    detail-text := Text {
                        x: 8px;
                        y: 8px;
                        width: max(1px, detail-scroll.visible-width - 16px);
                        text: root.detail;
                        color: Theme.text-primary;
                        font-family: Theme.font-mono;
                        font-size: Theme.fs-sm;
                        wrap: word-wrap;
                    }
                }
            }

            HorizontalLayout {
                alignment: end;
                spacing: 8px;
                GhostButton {
                    text: @tr("Cancel");
                    clicked => { root.cancel(); }
                }
                DangerButton {
                    text: root.confirm-label;
                    clicked => { root.confirm(); }
                }
            }
        }
    }
}
