// (#editor-hifi 2026-11-15) 编辑器窗口数据结构。仿 group_types.slint:独立文件避开
// app↔组件循环引用;由 app.slint import 后供 editor_window.slint 使用。
// 注意:EditorSpanKind 枚举顺序必须与 Rust src/editor/struct/highlight.rs 的
// SpanKind 完全同序(整型桥接,改动须两处同改)!
export enum EditorSpanKind {
    plain,      // 0  默认前景
    kw,         // 1  关键字 → ANSI 品红
    ty,         // 2  类型/类名 → ANSI 亮黄
    fn,         // 3  函数/指令 → ANSI 亮蓝
    str,        // 4  字符串/路径 → ANSI 亮绿
    num,        // 5  数字 → ANSI 黄
    com,        // 6  注释 → ANSI 亮黑 + 斜体
    ann,        // 7  注解/变量 $x/时间戳 → ANSI 亮青
    ts,         // 8  日志时间戳
    thr,        // 9  日志线程 [xxx]
    lvl-error,  // 10 ERROR/FATAL → 亮红粗
    lvl-warn,   // 11 WARN → 亮黄粗
    lvl-info,   // 12 INFO → 亮绿
    lvl-debug,  // 13 DEBUG/TRACE → 亮黑
    exc,        // 14 异常类名
    at,         // 15 堆栈 at 行
    cs,         // 16 Caused by:
    hl,         // 17 查找命中(琥珀底)
    hl-cur,     // 18 当前查找命中(亮琥珀+描边)
}

export struct EditorSpan {
    text: string, // 已切片文本
    start: int,   // 字符列起点(0 基,等宽像素定位用)
    width: length,// 像素宽(Rust 侧按 unicode-width 算,CJK 2 格)
    kind: EditorSpanKind,
}

// 一行 = 行号 + 内容 + 着色片段 + 当前行/选区/修改标记(窗口模型,仅可见行 ± 缓冲)。
export struct EditorLineRow {
    line: int,          // 1 基行号(显示)
    text: string,
    spans: [EditorSpan],
    is-current: bool,
    cursor-x: length,   // 光标像素 x(Rust 换算,含 CJK 宽度;仅 is-current 有效)
    sel-x: length,      // 选区矩形像素 x / 宽(w=0 无选区)
    sel-w: length,
    mark: bool,         // gutter 右缘 3px 修改标记
    hit: bool,          // 查找命中行
}

// tab 栏条目(多文件 tab;同会话 SFTP 连接复用)。
export struct EditorTabInfo {
    id: string,
    name: string,
    dirty: bool,
    active: bool,
    lang: string,       // 显示名(Java/日志/nginx.conf…)
    letter: string,     // 图标块首字母
    icon-color: color,
}
