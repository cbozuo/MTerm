import { ThemeEntry } from "theme_entry.slint";
import { WallpaperEntry } from "wallpaper_entry.slint";
import { Icon } from "icons.slint";
// Interface settings content (#23 follow-up).
//
// Embedded panel (not a window): it lives inside AppWindow's modal overlay, so
// the settings can't be dragged out of the parent and block input while open —
// while keeping the clean, minimal "label-left · control-right" design.
// Typography is fixed (literal px in the chrome) so it stays compact regardless
// of the global UI scale; only the font-preview reflects the real terminal size.

import { Theme } from "theme.slint";
import { ScrollView } from "std-widgets.slint";
import { SegGroup } from "seg.slint";
import { SelectField } from "widgets.slint";
import { LabeledInput, PrimaryButton, GhostButton, MTermSlider, Scrim } from "widgets.slint";
import { StorageSettings } from "storage_settings.slint";

export struct OutputRuleItem {
    pattern: string,
    regex: bool,
    case-sensitive: bool,
    whole-line: bool,
    color: string,
    enabled: bool,
}

export struct WslProfileInfo {
    id: string,
    name: string,
    distribution: string,
    directory: string,
}

// 强调色对比度守卫信息（§3.8 提示行）。Rust apply_theme 每次重算回写：
// eff = 实际生效色（守卫后）、panel = 主题面板色、raw = 守卫前原色、
// ratio = eff 对 panel 的 WCAG 对比度（已格式化成 "3.42"）、adjusted =
// 守卫是否改过色。跟随态 raw == eff == 主题 ac。
export struct AccentGuard {
    eff: string,
    panel: string,
    raw: string,
    ratio: string,
    adjusted: bool,
}

// One left-nav row (icon + label).
// (#accent-seg 2026-10-12) 强调色两态分段：容器用公共 SegGroup（ui/seg.slint），
// 段件就地定义（同 sync_input_dialog 的频道段做法）——只需文字，无色点/徽标。
// preferred-width 归零是必须的：格宽不均会让 SegGroup 的滑块与格子错位。
component AccentSeg inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    callback clicked();
    height: 30px;
    horizontal-stretch: 1;
    min-width: 0px;
    preferred-width: 0px;
    border-radius: 7px;
    // 段内无边框（外框由 SegGroup 画）：选中透出滑层，未选中透明
    background: active ? transparent : (ta.has-hover ? Theme.bg-hover : transparent);
    Text {
        text: root.label;
        color: active ? Theme.accent : (ta.has-hover ? Theme.text-primary : Theme.text-secondary);
        font-size: Theme.fs-sm;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }
    ta := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
}
component NavItem inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <bool> active;
    callback clicked();
    height: 30px;
    border-radius: 6px;
    // (#nav-follow-dropdown 2026-10-17) 选中语言对齐下拉/主题行（用户定稿）：
    // 不再用底色块表达选中（用户反馈「选中的菜单不要这个灰色阴影部分」），
    // 改为「透明底 + 主题色文字 + 主题色图标」；悬浮保持 bg-hover 浅染。
    background: ta.has-hover ? Theme.bg-hover : transparent;
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    HorizontalLayout {
        padding-left: 10px;
        spacing: 9px;
        // (#nav-icon-accent 2026-10-05) 选中项图标**跟随主题色**:
    // 高保真 .item.active svg { stroke: accent } —— 只靠底色区分选中时
    // 层级偏弱,图标点亮后更清晰。
    Icon {
    glyph: root.icon;
    tint: root.active ? Theme.accent-solid : Theme.text-primary;
    size: Theme.fs-md;
}
        Text { text: root.label;
               // (#nav-follow-dropdown 2026-10-17) 选中 = 主题色文字（原恒定
               // primary、选中态由底色承担 —— 用户要求与下拉选择一致）。
               color: root.active ? Theme.accent-solid : Theme.text-primary;
               font-size: 13px * Theme.panel-font; vertical-alignment: center; horizontal-stretch: 1; }
    }
}

// Small muted group heading (字体 / 预览 / SFTP …).
component SectionHeader inherits Text {
    font-size: 11px * Theme.panel-font;
    font-weight: Theme.fw-strong;
    color: Theme.text-muted;
    vertical-alignment: center;
}

// A settings row: label (+ optional description) on the left, a control slot on
// the right via @children. Right-aligned and vertically centered.
component SettingRow inherits Rectangle {
    in property <string> label;
    in property <string> desc;
    in property <bool> show-divider: true;
    VerticalLayout {
        HorizontalLayout {
            spacing: 14px;
            padding-top: 9px;
            padding-bottom: 9px;
            VerticalLayout {
                horizontal-stretch: 1;
                alignment: center;
                spacing: 3px;
                Text { text: root.label; font-size: 13px * Theme.panel-font; color: Theme.text-primary; }
                if root.desc != "" : Text { text: root.desc; font-size: 11px * Theme.panel-font;
                       color: Theme.text-muted; wrap: word-wrap; }
            }
            VerticalLayout {
                alignment: center;
                @children
            }
        }
        if root.show-divider : Rectangle { height: 1px; background: Theme.border-subtle; }
    }
}

// iOS-style toggle switch. Display-only `on` (driven by the parent); a tap emits
// the intended new value so the parent owns the state (avoids Slint's
// binding-break-on-self-assign gotcha).
component Switch inherits Rectangle {
    in property <bool> on;
    callback toggled(bool);
    width: 38px;
    height: 22px;
    border-radius: 11px;
    background: root.on ? Theme.accent : Theme.popup-bg-active;
    animate background { duration: 120ms; }
    Rectangle {
        width: 16px;
        height: 16px;
        border-radius: 8px;
        y: 3px;
        x: root.on ? parent.width - self.width - 3px : 3px;
        background: white;
        animate x { duration: 120ms; easing: ease-out; }
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.toggled(!root.on); }
    }
}

// [- value +] stepper. Display-only `value`; emits the clamped new value.
component Stepper inherits Rectangle {
    in property <int> value;
    in property <int> minimum: 0;
    in property <int> maximum: 100;
    in property <int> step: 1;
    in property <string> unit;
    callback changed(int);
    width: 112px;
    height: 26px;
    border-radius: 6px;
    background: Theme.popup-bg-elevated;
    border-width: 1px;
    border-color: Theme.border-subtle;
    clip: true;
    HorizontalLayout {
        Rectangle {
            width: 30px;
            background: minus-ta.has-hover ? Theme.bg-hover : transparent;
            minus-ta := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.changed(max(root.minimum, root.value - root.step)); }
            }
            Icon {
    glyph: "remove";
    tint: Theme.text-primary;
    size: 14px * Theme.panel-font;
}
        }
        Rectangle { width: 1px; background: Theme.border-subtle; }
        Text { text: root.value + root.unit; horizontal-stretch: 1;
               font-size: 12px * Theme.panel-font; color: Theme.text-primary;
               horizontal-alignment: center; vertical-alignment: center; }
        Rectangle { width: 1px; background: Theme.border-subtle; }
        Rectangle {
            width: 30px;
            background: plus-ta.has-hover ? Theme.bg-hover : transparent;
            plus-ta := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.changed(min(root.maximum, root.value + root.step)); }
            }
            Icon {
    glyph: "add";
    tint: Theme.text-primary;
    size: 14px * Theme.panel-font;
}
        }
    }
}

// Font picker for the settings rows: a custom dropdown, not std ComboBox —
// it needs this panel's row chrome, a scrollable list (system families run
// into the hundreds) and a 默认 sentinel row that is "" in the model and
// stores "" back (= re-run the chain in Rust). Popup anatomy mirrors
// SelectField in widgets.slint.
// (#ifd-combo-unify 2026-10-01) Generalized beyond fonts: the renderer /
// rule-set / keyword / colour dropdowns use it too (replacing the last std
// ComboBoxes), so it now carries an `enabled` state like they had.
component FontCombo inherits Rectangle {
    in property <bool> lang-en;
    in property <[string]> values;
    in property <string> value;          // raw choice; "" = chain default
    in property <string> default-name;   // resolved chain family behind 默认
    in property <bool> enabled: true;
    callback selected(string);
    // (#combo-focus-decoupled 2026-10-02) 聚焦态 = 「我是最近一次被操作的下拉」
    // （代际时钟，与 session_dialog 同一套），**与弹层开闭无关**。
    // 曾用 `drop-open || has-hover` 作判据，而 drop-open 只在选中项时才清 ——
    // 点弹层外部关闭后它仍是 true，边框会**永久**保持高亮。卡片吞层的空白
    // 点击经 blank-clicked 推进 combo-clock 即失焦（与弹框三路清时钟等价）；
    // 弹层开合已改读 `font-pop.is-open`。
    in-out property <int> focus-clock: 0;
    property <int> focus-stamp: -1;
    property <bool> focused: root.focus-stamp == root.focus-clock;
    // (#combo-tip 2026-10-01) Hover tooltip for rows whose name is elided:
    // tip-text is the hovered row's full label ("" = none), tip-y the row's y
    // within the popup surface. The overlay itself is drawn inside the popup,
    // above the list.
    property <string> tip-text: "";
    property <length> tip-y: 0px;

    function label-for(v: string) -> string {
        if (v != "") { return v; }
        if (root.default-name == "") {
            return root.lang-en ? "Default" : "默认";
        }
        return (root.lang-en ? "Default" : "默认") + "（" + root.default-name + "）";
    }

    width: 220px;
    height: 30px;
    border-radius: 6px;
    border-width: 1px;
    border-color: root.enabled && (root.focused || fta.has-hover) ? Theme.line-2 : Theme.border-subtle;
    background: Theme.popup-bg-elevated;
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 8px;
        spacing: 6px;
        Text {
            text: root.label-for(root.value);
            color: root.enabled ? Theme.text-primary : Theme.text-muted;
            font-size: 12px * Theme.panel-font;
            vertical-alignment: center;
            horizontal-stretch: 1;
            overflow: elide;
        }
        Icon {
    glyph: "expand-more";
    tint: root.focused || fta.has-hover ? Theme.text-secondary : Theme.text-muted;
    size: 14px * Theme.panel-font;
} // expand_more
    }
    fta := TouchArea {
        mouse-cursor: root.enabled ? pointer : default;
        clicked => {
            if (root.enabled) {
                root.tip-text = "";
                // (#combo-focus-decoupled) 打上聚焦戳：弹层被 close-on-click-outside
                // 收起后高亮仍在，只有空白点击经 blank-clicked 推进 combo-clock 才清。
                root.focus-clock += 1;
                root.focus-stamp = root.focus-clock;
                font-pop.show();
            }
        }
    }

    font-pop := PopupWindow {
        x: 0;
        y: parent.height + 4px;
        // (#ifd-combo-align 2026-10-01) Same width as the closed box — the old
        // 260px minimum made the open list overhang the box on both sides.
        width: parent.width;
        height: min(root.values.length * 29px + 10px, 300px);
        close-policy: close-on-click-outside;
        Rectangle {
            background: Theme.popup-bg;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.line-2;
            drop-shadow-blur: 18px;
            drop-shadow-color: transparent;
            pop-scroll := ScrollView {
                width: 100%;
                height: 100%;
                content-width: self.visible-width;
                content-height: max(self.visible-height, pop-list.preferred-height);
                pop-list := VerticalLayout {
                    width: pop-scroll.visible-width;
                    padding: 5px;
                    spacing: 1px;
                    for v in root.values : Rectangle {
                        // (#select-row-follow-theme 2026-10-17) 选中/悬浮对齐
                        // 主题下拉行：hover = bg-hover（原 field-2 灰系）、
                        // 选中 = 透明底 + accent 文字 + accent ✓（原 accent-soft
                        // 底染色；用户反馈"这两个下拉也修改"）。
                        height: 28px;
                        border-radius: 5px;
                        background: r-ta.has-hover ? Theme.bg-hover : transparent;
                        r-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.tip-text = "";
                                root.selected(v);
                                font-pop.close();
                            }
                            changed has-hover => {
                                if (self.has-hover) {
                                    // Row shows width - 41px of text (9px
                                    // left inset + 32px checkmark zone).
                                    if (measure.preferred-width > font-pop.width - 41px) {
                                        root.tip-text = root.label-for(v);
                                        root.tip-y = 5px + parent.y + pop-scroll.content-y;
                                    } else {
                                        root.tip-text = "";
                                    }
                                } else if (root.tip-text == root.label-for(v)) {
                                    root.tip-text = "";
                                }
                            }
                        }
                        // Hidden single-line render of the full label: its
                        // natural width tells whether the visible (elided)
                        // text actually overflows the row. (measure sits in a
                        // plain Rectangle, so invisible = no layout impact.)
                        measure := Text {
                            visible: false;
                            text: root.label-for(v);
                            font-size: 12px * Theme.panel-font;
                            wrap: no-wrap;
                        }
                        Text {
                            x: 9px;
                            width: parent.width - 32px;
                            height: parent.height;
                            text: root.label-for(v);
                            color: root.value == v ? Theme.accent-solid : Theme.text-primary;
                            font-size: 12px * Theme.panel-font;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        Rectangle {
                            x: parent.width - 23px;
                            y: (parent.height - 14px) / 2;
                            width: 14px;
                            height: 14px;
                            Icon {
    glyph: root.value == v ? "check" : "";
    tint: Theme.accent-solid;
    size: 14px;
}
                        }
                    }
                }
                // (#combo-tip) Full-label overlay for the hovered elided row,
                // drawn above the list. No TouchArea, so it never steals the
                // pointer; word-wrap guarantees the complete name is readable
                // even when it exceeds the popup width. Positioned just under
                // the hovered row, clamped into the popup.
                if root.tip-text != "" : Rectangle {
                    width: min(tip-label.preferred-width + 16px, parent.width - 8px);
                    height: tip-label.preferred-height + 12px;
                    x: parent.width - self.width - 2px;
                    y: clamp(root.tip-y + 27px, 2px, parent.height - self.height - 2px);
                    background: Theme.popup-bg-active;
                    border-radius: 6px;
                    border-width: 1px;
                    border-color: Theme.line-2;
                    drop-shadow-blur: 10px;
                    drop-shadow-color: transparent;
                    tip-label := Text {
                        x: 8px;
                        y: 6px;
                        width: parent.width - 16px;
                        text: root.tip-text;
                        color: Theme.text-primary;
                        font-size: 12px * Theme.panel-font;
                        wrap: word-wrap;
                    }
                }
            }
        }
    }
}

// Compact cursor-shape choice with a live visual sample (#275).
// (#cursor-seg 2026-10-17) 光标类型段：示意图标 + 文字，供 SegGroup 滑动
// 分段使用（用户定稿「使用（统一提取的）滑块的方式」）。原 CursorStyleButton
// 三个独立按钮（自带边框 / 固定 74px 宽 / 面底染色）已并入 SegGroup ——
// 选中块由滑层（thumb）承担，段自身只负责「透明 / 悬浮浅染 + 文字色」，
// 与 AccentSeg 同构（等宽格子协议：stretch 1 + min/preferred 归零）。
component CursorSeg inherits Rectangle {
    in property <string> label;
    in property <string> cursor-kind;
    in property <bool> active;
    callback clicked();
    height: 30px;
    horizontal-stretch: 1;
    min-width: 0px;
    preferred-width: 0px;
    border-radius: 7px;
    background: active ? transparent : (ta.has-hover ? Theme.bg-hover : transparent);
    ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    HorizontalLayout {
        padding-left: 7px;
        padding-right: 7px;
        spacing: 6px;
        alignment: center;
        Rectangle {
            width: 14px;
            height: 100%;
            background: transparent;
            Rectangle {
                y: (parent.height - self.height) / 2;
                width: 14px;
                height: 18px;
                background: Theme.term-bg;
                Rectangle {
                    x: 2px;
                    y: root.cursor-kind == "underline" ? parent.height - 3px : 2px;
                    width: root.cursor-kind == "bar" ? 2px : 10px;
                    height: root.cursor-kind == "underline" ? 2px : 14px;
                    background: Theme.term-fg;
                }
            }
        }
        Text {
            text: root.label;
            color: root.active ? Theme.accent : (ta.has-hover ? Theme.text-primary : Theme.text-secondary);
            font-size: 11px * Theme.panel-font;
            vertical-alignment: center;
        }
    }
}

component CursorPaletteSwatch inherits Rectangle {
    in property <string> hex;
    in property <color> swatch-color;
    in property <bool> selected;
    callback chosen(string);
    width: 26px;
    height: 26px;
    border-radius: 5px;
    border-width: root.selected ? 2px : 1px;
    border-color: root.selected ? Theme.accent : Theme.border-strong;
    background: root.swatch-color;
    swatch-ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.chosen(root.hex); }
    }
}

// Hex RGB editor with a live swatch. Incomplete/invalid input remains editable
// but is marked red and is not applied or persisted.
component CursorColorInput inherits Rectangle {
    in-out property <string> value;
    in property <color> preview-color;
    property <bool> valid: true;
    callback apply-color(string) -> bool;
    width: 160px;
    height: 30px;
    border-radius: 6px;
    border-width: 1px;
    border-color: root.valid ? Theme.border-subtle : #e05252;
    background: Theme.popup-bg-elevated;
    Rectangle {
        x: 7px;
        y: 6px;
        width: 18px;
        height: 18px;
        border-radius: 4px;
        border-width: 1px;
        border-color: Theme.border-strong;
        background: root.preview-color;
        color-button := TouchArea {
            mouse-cursor: pointer;
            clicked => { color-picker.show(); }
        }
    }
    color-input := TextInput {
        x: 34px;
        width: parent.width - 41px;
        height: parent.height;
        text <=> root.value;
        color: Theme.text-primary;
        font-family: Theme.term-font-family;
        font-size: 12px * Theme.panel-font;
        vertical-alignment: center;
        single-line: true;
        changed text => { root.valid = root.apply-color(self.text); }
    }
    color-picker := PopupWindow {
        x: parent.width - self.width;
        y: parent.height + 4px;
        width: 210px;
        height: 160px;
        Rectangle {
            background: Theme.popup-bg;
            border-radius: 8px;
            border-width: 1px;
            border-color: Theme.border-strong;
            drop-shadow-blur: 12px;
            drop-shadow-color: transparent;
            VerticalLayout {
                padding: 10px;
                spacing: 7px;
                Text {
                    text: root.value;
                    color: Theme.text-secondary;
                    font-family: Theme.term-font-family;
                    font-size: 11px * Theme.panel-font;
                    vertical-alignment: center;
                }
                HorizontalLayout {
                    spacing: 6px;
                    CursorPaletteSwatch { hex: "#D4D4D4"; swatch-color: #D4D4D4; selected: root.value == self.hex; chosen(v) => { if root.apply-color(v) { root.value = v; root.valid = true; color-picker.close(); } } }
                    CursorPaletteSwatch { hex: "#FFFFFF"; swatch-color: #FFFFFF; selected: root.value == self.hex; chosen(v) => { if root.apply-color(v) { root.value = v; root.valid = true; color-picker.close(); } } }
                    CursorPaletteSwatch { hex: "#FF5252"; swatch-color: #FF5252; selected: root.value == self.hex; chosen(v) => { if root.apply-color(v) { root.value = v; root.valid = true; color-picker.close(); } } }
                    CursorPaletteSwatch { hex: "#FF9800"; swatch-color: #FF9800; selected: root.value == self.hex; chosen(v) => { if root.apply-color(v) { root.value = v; root.valid = true; color-picker.close(); } } }
                    CursorPaletteSwatch { hex: "#FFD740"; swatch-color: #FFD740; selected: root.value == self.hex; chosen(v) => { if root.apply-color(v) { root.value = v; root.valid = true; color-picker.close(); } } }
                    CursorPaletteSwatch { hex: "#69F0AE"; swatch-color: #69F0AE; selected: root.value == self.hex; chosen(v) => { if root.apply-color(v) { root.value = v; root.valid = true; color-picker.close(); } } }
                }
                HorizontalLayout {
                    spacing: 6px;
                    CursorPaletteSwatch { hex: "#00E676"; swatch-color: #00E676; selected: root.value == self.hex; chosen(v) => { if root.apply-color(v) { root.value = v; root.valid = true; color-picker.close(); } } }
                    CursorPaletteSwatch { hex: "#00E5FF"; swatch-color: #00E5FF; selected: root.value == self.hex; chosen(v) => { if root.apply-color(v) { root.value = v; root.valid = true; color-picker.close(); } } }
                    CursorPaletteSwatch { hex: "#40C4FF"; swatch-color: #40C4FF; selected: root.value == self.hex; chosen(v) => { if root.apply-color(v) { root.value = v; root.valid = true; color-picker.close(); } } }
                    CursorPaletteSwatch { hex: "#448AFF"; swatch-color: #448AFF; selected: root.value == self.hex; chosen(v) => { if root.apply-color(v) { root.value = v; root.valid = true; color-picker.close(); } } }
                    CursorPaletteSwatch { hex: "#7C4DFF"; swatch-color: #7C4DFF; selected: root.value == self.hex; chosen(v) => { if root.apply-color(v) { root.value = v; root.valid = true; color-picker.close(); } } }
                    CursorPaletteSwatch { hex: "#E040FB"; swatch-color: #E040FB; selected: root.value == self.hex; chosen(v) => { if root.apply-color(v) { root.value = v; root.valid = true; color-picker.close(); } } }
                }
                HorizontalLayout {
                    spacing: 6px;
                    CursorPaletteSwatch { hex: "#F48FB1"; swatch-color: #F48FB1; selected: root.value == self.hex; chosen(v) => { if root.apply-color(v) { root.value = v; root.valid = true; color-picker.close(); } } }
                    CursorPaletteSwatch { hex: "#FF8A65"; swatch-color: #FF8A65; selected: root.value == self.hex; chosen(v) => { if root.apply-color(v) { root.value = v; root.valid = true; color-picker.close(); } } }
                    CursorPaletteSwatch { hex: "#FFF176"; swatch-color: #FFF176; selected: root.value == self.hex; chosen(v) => { if root.apply-color(v) { root.value = v; root.valid = true; color-picker.close(); } } }
                    CursorPaletteSwatch { hex: "#A5D6A7"; swatch-color: #A5D6A7; selected: root.value == self.hex; chosen(v) => { if root.apply-color(v) { root.value = v; root.valid = true; color-picker.close(); } } }
                    CursorPaletteSwatch { hex: "#80CBC4"; swatch-color: #80CBC4; selected: root.value == self.hex; chosen(v) => { if root.apply-color(v) { root.value = v; root.valid = true; color-picker.close(); } } }
                    CursorPaletteSwatch { hex: "#90CAF9"; swatch-color: #90CAF9; selected: root.value == self.hex; chosen(v) => { if root.apply-color(v) { root.value = v; root.valid = true; color-picker.close(); } } }
                }
                HorizontalLayout {
                    spacing: 6px;
                    CursorPaletteSwatch { hex: "#B39DDB"; swatch-color: #B39DDB; selected: root.value == self.hex; chosen(v) => { if root.apply-color(v) { root.value = v; root.valid = true; color-picker.close(); } } }
                    CursorPaletteSwatch { hex: "#CE93D8"; swatch-color: #CE93D8; selected: root.value == self.hex; chosen(v) => { if root.apply-color(v) { root.value = v; root.valid = true; color-picker.close(); } } }
                    CursorPaletteSwatch { hex: "#BCAAA4"; swatch-color: #BCAAA4; selected: root.value == self.hex; chosen(v) => { if root.apply-color(v) { root.value = v; root.valid = true; color-picker.close(); } } }
                    CursorPaletteSwatch { hex: "#9E9E9E"; swatch-color: #9E9E9E; selected: root.value == self.hex; chosen(v) => { if root.apply-color(v) { root.value = v; root.valid = true; color-picker.close(); } } }
                    CursorPaletteSwatch { hex: "#607D8B"; swatch-color: #607D8B; selected: root.value == self.hex; chosen(v) => { if root.apply-color(v) { root.value = v; root.valid = true; color-picker.close(); } } }
                    CursorPaletteSwatch { hex: "#2D2D2F"; swatch-color: #2D2D2F; selected: root.value == self.hex; chosen(v) => { if root.apply-color(v) { root.value = v; root.valid = true; color-picker.close(); } } }
                }
            }
        }
    }
}

// ── (#wallpaper-library 2026-10-18) 壁纸画廊卡 ──────────────────────────────
// 与主题卡同语言：79×50 缩略 + 4px 间距 + 10px 标题。@children = 缩略内容
// （内置渐变 / 自定义缩略图 / 「无」占位），选中态 accent 描边 + ✓ 角标。
//
// 自定义卡（removable）悬停时右上角出现 ×：**只有一张 TouchArea** —— 用点击
// 坐标判定落在 × 区域就删除，否则选中。这样避免"× 自己一个 TouchArea 抢走
// hover 导致 × 闪没"（两个重叠 TouchArea 的经典抖动）与「透明区仍可点击」。
component WallpaperCard inherits Rectangle {
    in property <string> caption;
    in property <bool> selected: false;
    in property <bool> removable: false;
    in property <bool> dashed: false;      // ＋上传图片（虚线感：淡描边 + 图标）
    width: 79px;
    height: 68px;
    background: transparent;
    // 指针是否正压在右上角的 × 上（决定 × 变红 + 点击语义）
    property <bool> x-hot: card-ta.has-hover
        && card-ta.mouse-x > self.width - 24px && card-ta.mouse-y < 24px;
    VerticalLayout {
        spacing: 4px;
        Rectangle {
            height: 50px;
            border-radius: 8px;
            border-width: root.selected ? 2px : 1px;
            border-color: root.selected ? Theme.accent-solid
                : (root.dashed
                    ? Theme.border-strong
                    : (card-ta.has-hover ? Theme.border-strong : Theme.border-subtle));
            background: root.dashed ? transparent : Theme.window-base;
            clip: true;
            @children
            if root.dashed : Icon {
                glyph: "add";
                tint: card-ta.has-hover ? Theme.text-secondary : Theme.text-muted;
                size: 16px;
            }
            // 选中 ✓（自定义卡：悬停时让位给 ×，二者同一位）
            if root.selected && !(root.removable && card-ta.has-hover) : Rectangle {
                x: parent.width - self.width - 4px;
                y: 4px;
                width: 15px;
                height: 15px;
                border-radius: 7.5px;
                background: Theme.accent-solid;
                Icon {
                    glyph: "check";
                    tint: Theme.dark ? #08221E : #ffffff;
                    size: 9px;
                }
            }
            // 悬停 ×：收在卡片内部（外层 clip 会裁掉悬出的部分）
            if root.removable && card-ta.has-hover : Rectangle {
                x: parent.width - self.width - 3px;
                y: 3px;
                width: 18px;
                height: 18px;
                border-radius: 9px;
                background: root.x-hot ? #E81123 : Theme.popup-bg-alt;
                border-width: 1px;
                border-color: root.x-hot ? #E81123 : Theme.border-strong;
                Icon {
                    glyph: "close";
                    tint: root.x-hot ? #ffffff : Theme.text-secondary;
                    size: 9px;
                }
            }
        }
        Text {
            text: root.caption;
            color: root.selected ? Theme.accent-solid : Theme.text-secondary;
            font-size: 10px;
            height: 14px;
            horizontal-alignment: center;
            overflow: elide;
        }
    }
    card-ta := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            if (root.removable && root.x-hot) {
                root.remove();
            } else {
                root.clicked();
            }
        }
    }
    callback clicked();
    callback remove();
}

// ── (#theme-gallery 2026-10-17) 外观页专属组件 ─────────────────────────────
// 主题画廊卡：主题根底色块 + 强调色圆点 + 明暗角标（82px，与壁纸卡同语言）。
// 悬停 220ms 后主界面实时预览（不落盘）；点击才切换并落盘 ——
// 「悬停是看，点击才是选」。
component ThemeCard inherits Rectangle {
    in property <ThemeEntry> entry;
    in property <bool> selected;
    callback clicked();
    callback preview(string);
    callback restore();
    width: 82px;
    height: 70px;
    background: transparent;
    VerticalLayout {
        spacing: 4px;
        Rectangle {
            height: 52px;
            border-radius: 8px;
            border-width: root.selected ? 2px : 1px;
            border-color: root.selected ? Theme.accent-solid
                : (card-ta.has-hover ? Theme.border-strong : Theme.border-subtle);
            background: root.entry.root;
            clip: true;
            Rectangle {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 26px;
                height: 26px;
                border-radius: 13px;
                background: root.entry.ac;
            }
            // 明暗角标（右下）
            Rectangle {
                x: parent.width - self.width - 4px;
                y: parent.height - self.height - 3px;
                width: 26px;
                height: 13px;
                border-radius: 6.5px;
                background: #5A5A5A73;
                Text {
                    text: root.entry.mode;
                    color: #ffffff;
                    font-size: 8.5px;
                    width: 100%;
                    height: 100%;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
            // 选中 ✓（右上，accent 圆底）
            if root.selected : Rectangle {
                x: parent.width - self.width - 4px;
                y: 4px;
                width: 15px;
                height: 15px;
                border-radius: 7.5px;
                background: Theme.accent-solid;
                Icon {
                    glyph: "check";
                    tint: Theme.dark ? #08221E : #ffffff;
                    size: 9px;
                }
            }
        }
        Text {
            text: root.entry.zh;
            color: root.selected ? Theme.accent-solid : Theme.text-secondary;
            font-size: 10px;
            height: 14px;
            horizontal-alignment: center;
            overflow: elide;
        }
    }
    card-ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
        changed has-hover => {
            if (self.has-hover) {
                hover-delay.restart();
            } else {
                hover-delay.running = false;
                root.restore();
            }
        }
    }
    hover-delay := Timer {
        interval: 220ms;
        triggered => {
            if (card-ta.has-hover) { root.preview(root.entry.id); }
        }
    }
}

// 「＋更多」卡：打开完整主题列表（浮层本体在 AppWindow 根层）。
component ThemeMoreCard inherits Rectangle {
    in property <bool> lang-en: false;
    callback clicked();
    width: 82px;
    height: 70px;
    background: transparent;
    VerticalLayout {
        spacing: 4px;
        Rectangle {
            height: 52px;
            border-radius: 8px;
            border-width: 1px;
            border-color: more-ta.has-hover ? Theme.border-strong : Theme.border-subtle;
            background: transparent;
            Icon {
                glyph: "add";
                tint: more-ta.has-hover ? Theme.text-secondary : Theme.text-muted;
                size: 15px;
            }
        }
        Text {
            text: root.lang-en ? "More" : "更多";
            color: Theme.text-secondary;
            font-size: 10px;
            height: 14px;
            horizontal-alignment: center;
        }
    }
    more-ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// 满宽滑杆行（高保真 .prow）：标题 + 读数（含「（默认）」）+ 滑杆 + 说明。
component PercentSliderRow inherits VerticalLayout {
    in property <string> label;
    in property <string> desc;
    in property <float> percent: 0;
    in property <float> default-percent: 0;
    in property <bool> enabled: true;
    in property <bool> lang-en: false;
    callback changed(float);
    callback released(float);
    callback reset();
    spacing: 2px;
    padding-top: 7px;
    padding-bottom: 7px;
    // (#zone-label-dblclick 2026-10-18) 与四根分区滑杆同款：双击标题/读数恢复
    // 默认（弹窗透明度 0%、遮罩浓度 32%、壁纸透明度 0%）。
    Rectangle {
        height: 18px;
        background: transparent;
        HorizontalLayout {
            spacing: 8px;
            Text {
                text: root.label;
                color: Theme.text-primary;
                font-size: 13px * Theme.panel-font;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            Text {
                text: round(root.percent) + "%"
                    + (round(root.percent) == round(root.default-percent)
                        ? (root.lang-en ? " (default)" : "（默认）") : "");
                color: Theme.text-primary;
                font-size: 12px * Theme.panel-font;
                vertical-alignment: center;
                opacity: root.enabled ? 1.0 : 0.45;
            }
        }
        header-ta := TouchArea {
            // 与滑杆本体的双击同一条路径：先把值落到默认（changed 回写外部状态），
            // 再发 reset 让外部写盘 —— 只发 reset 会读到旧值，等于没复位。
            double-clicked => {
                root.changed(root.default-percent);
                root.reset();
            }
        }
    }
    MTermSlider {
        width: 100%;
        minimum: 0;
        maximum: 100;
        value: root.percent;
        default-value: root.default-percent;
        enabled: root.enabled;
        changed(v) => { root.changed(v); }
        released(v) => { root.released(v); }
        reset => { root.reset(); }
    }
    if root.desc != "" : Text {
        text: root.desc;
        color: Theme.text-muted;
        font-size: 10.5px * Theme.panel-font;
        wrap: word-wrap;
        opacity: root.enabled ? 1.0 : 0.55;
    }
}

// 分区透明度（四等分格）：小标题 + 读数 + 滑杆。
component ZoneSlider inherits VerticalLayout {
    in property <string> label;
    in property <float> percent: 0;
    in property <float> default-percent: 0;
    in property <bool> lang-en: false;
    callback changed(float);
    callback released(float);
    callback reset();
    // (#zone-slider-equal 2026-10-17) 等宽由调用方按行宽给（见页面里的 4 个实例）：
    // 用 horizontal-stretch 时 Slint 按「首选宽 + 均分余量」分配，而每列的首选宽
    // 随数值文字变化（「0%（默认）」↔「100%」）→ 拖动时四根滑杆互相伸缩
    //（实测 181/191/191/213）。
    spacing: 3px;
    // (#zone-label-dblclick 2026-10-18) 双击**分区名 / 读数**也恢复默认
    // （高保真：滑杆本体、标题、分区名都可双击）。只有标题行挂 TouchArea——
    // 盖住整格会把下面滑杆的拖动吞掉。
    Rectangle {
        height: 17px;
        background: transparent;
        HorizontalLayout {
            spacing: 6px;
            Text {
                text: root.label;
                color: Theme.text-primary;
                font-size: 12px * Theme.panel-font;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }
            Text {
                text: round(root.percent) + "%"
                    + (round(root.percent) == round(root.default-percent)
                        ? (root.lang-en ? " (def)" : "（默认）") : "");
                color: Theme.text-primary;
                font-size: 11px * Theme.panel-font;
                vertical-alignment: center;
            }
        }
        header-ta := TouchArea {
            // 同 ZoneSlider：先 changed(默认) 再 reset。
            double-clicked => {
                root.changed(root.default-percent);
                root.reset();
            }
        }
    }
    MTermSlider {
        width: 100%;
        minimum: 0;
        maximum: 100;
        value: root.percent;
        default-value: root.default-percent;
        changed(v) => { root.changed(v); }
        released(v) => { root.released(v); }
        reset => { root.reset(); }
    }
}

// The settings content (nav + pages). Embedded in AppWindow's modal overlay.
export component InterfacePanel inherits Rectangle {
    in property <bool> lang-en;
    in property <bool> is-windows;
    in-out property <string> renderer-mode: "software";
    in property <[string]> term-fonts;
    // Interface (sans) font. `ui-fonts` is pre-filtered by Rust to installed,
    // non-monospace families that cover the CJK probe glyphs, so every row here
    // is safe for editable inputs (#54). The `*-chosen` strings are the RAW
    // stored choices ("" = the chain default), not the resolved families.
    in property <[string]> ui-fonts;
    in property <string> term-font-chosen;
    in property <string> term-font-default-name;
    in property <string> ui-font-chosen;
    in property <string> ui-font-default-name;
    in property <length> term-font-size;
    in-out property <float> terminal-line-spacing: 1.0;
    in-out property <bool> term-font-bold;
    in-out property <string> term-cursor-style: "block";
    in-out property <string> term-cursor-color-hex: "#D4D4D4";
    in property <color> term-cursor-color: #D4D4D4;
    in-out property <bool> output-highlight-enabled;
    in-out property <bool> json-format-output: true;
    in-out property <string> output-highlight-preset;
    in property <[OutputRuleItem]> output-highlight-rules;
    in-out property <string> output-highlight-rule-status;
    in property <float> ui-scale;
    in-out property <bool> sftp-follow-cd;
    in-out property <bool> collapse-right-sidebar-default;
    in-out property <bool> collapse-sftp-default;
    in-out property <bool> sync-upload-enabled;
    in-out property <bool> webdav-enabled;
    in-out property <string> webdav-url;
    in-out property <string> webdav-username;
    in-out property <string> webdav-password;
    in-out property <string> webdav-remote-path;
    in-out property <bool> webdav-accept-invalid-certs;
    in-out property <string> webdav-status;
    in-out property <bool> download-always-ask;
    in-out property <bool> paste-confirm-enabled: true;
    in-out property <bool> extra-paste-shortcuts-enabled: true;
    in-out property <bool> zen-mode: false;
    in-out property <bool> quick-commands-as-sidebar;
    // (#close-behavior) 点窗口关闭键时的行为:"ask" / "tray" / "exit"。
    // 与关闭确认卡共用同一份状态(双向绑定在 app.slint 里)。
    in-out property <string> close-behavior: "ask";
    in-out property <bool> mcp-enabled: true;
    in-out property <bool> mcp-use-saved-credentials: true;
    in-out property <bool> mcp-allow-commands: true;
    in-out property <bool> mcp-allow-file-transfers: true;
    // ── (#theme-split) 主题/强调色/三滑杆/通透度 ─────────────────────
    in property <[ThemeEntry]> theme-entries;      // 38 套（Rust 从 palettes.rs 构建）
    // 「常用主题」快捷位（≤6，config 顺序）——外观页画廊的数据源。
    in property <[ThemeEntry]> theme-favorites;
    in-out property <string> theme-chosen;          // 当前主题 id（""=跟随系统）
    in-out property <bool> follow-system: true;
    // 只有两个态：follow / custom（preset 仅为旧配置兼容保留，UI 不再暴露）。
    in-out property <string> accent-mode: "follow";
    in-out property <string> accent-preset: "";
    in-out property <string> accent-custom: "";
    // ── 强调色预设弹框 / 取色盘（定稿高保真 #accent-pop-v2）────────────
    // 浮层本体在 AppWindow 根层（theme-pick 同款桥）：面板内只发开关。
    // accent-stage = 弹框「选定色」（用户点的原色，原样保留，应用才调亮生效）。
    in-out property <string> accent-stage: "";
    // 对比度守卫提示（Rust apply_theme 每次重算回写）：chip 底色与守卫
    // 文案都读它 —— 跟随态=主题 ac，自定义态=3:1 守卫后的生效色。
    in-out property <AccentGuard> accent-guard;
    in-out property <bool> accent-pop-open: false;
    // (#accent-chip-info 2026-10-16) 设置页强调色色卡的取色信息卡：**浮层本体在
    // AppWindow 根层**（与 theme-pick / accent-pop 同款桥）。原因：色卡所在行的
    // 下方还有「界面通透度」整块内容，卡片若画在行内，会被**后声明**的行整个盖住
    // （用户截图「被覆盖了无法看见」——Slint 的绘制顺序 = 声明顺序，行内元素压不过
    // 后面的兄弟）。这里只存悬停态与色卡的窗口坐标：坐标必须在**事件期**从
    // absolute-position 取（布局期恒 0，见 ChainPicker 的 report-pos 结论）。
    in-out property <bool> accent-info-open: false;
    in-out property <length> accent-info-x: 0px;
    in-out property <length> accent-info-y: 0px;
    in-out property <bool> wallpaper-active;
    in-out property <bool> wallpaper-color-pickup;
    // (#zone-alpha 2026-10-17) 四分区透明度（滑杆值 = 透明程度，0 = 不透明；
    // Rust 侧存 alpha = 1 − 值）。
    in-out property <float> titlebar-transparency: 0.15;
    in-out property <float> tabbar-transparency: 0.15;
    in-out property <float> sidebar-transparency: 0.15;
    in-out property <float> term-transparency: 0.0;
    in-out property <float> wallpaper-transparency: 0.0;
    in-out property <int> wallpaper-scope: 0;      // 0 整个界面 / 1 终端区
    in-out property <string> wallpaper-fit: "auto";
    in-out property <string> scrim-style: "auto";
    in-out property <float> scrim-strength: 0.32;
    // 遮罩样式下拉：浮层本体在 AppWindow 根层（theme-pick 同款桥；设置页在
    // ScrollView 里，行内浮层会被滚出视口或裁掉）。
    in-out property <bool> scrim-pick-open: false;
    in-out property <length> scrim-pick-x: 0px;
    in-out property <length> scrim-pick-y: 0px;
    // 样式 id → 显示名：实现在 Theme.scrim-label（根层下拉也要用）。

    in-out property <float> popup-transparency: 0.0;
    // (#theme-split v2) 主题下拉浮层桥（浮层本体在 AppWindow 根层，ChainPicker
    // 同款模式）：open 开关 + 按钮窗口坐标 + 悬停预览回调。当前主题名由
    // Rust apply_theme 写 theme-name（按钮显示）。
    in-out property <bool> theme-pick-open: false;
    in-out property <length> theme-pick-x: 0px;
    in-out property <length> theme-pick-y: 0px;
    in-out property <string> theme-pick-search: "";
    callback theme-search-filter(string /* query — 清词恢复全量 */);
    in-out property <string> theme-name;   // <=> app（Rust apply 写）
    callback preview-theme(string /* id — 悬停实时预览，不落盘 */);
    // Active wallpaper id: "" / "builtin:light" / "builtin:dark" / a file path.
    in property <string> current-wallpaper;
    in property <string> custom-wallpaper-name;   // basename for the file row
    // (#wallpaper-library 2026-10-18) 数据目录 `wallpapers/` 里的自定义壁纸
    // （Rust 扫描 + 缩略图）；内置 5 套由页面自己画。
    in property <[WallpaperEntry]> wallpaper-items;
    // 「填充方式 = 自动」提示行要按作用域区域的比例判定结论（由 app.slint 传）。
    in property <float> window-aspect: 1.6;
    in property <float> term-aspect: 1.6;
    // (#wallpaper-scope-workspace 2026-10-19) 主区域（标题栏以下）的宽高比。
    in property <float> workspace-aspect: 1.6;
    in property <[WslProfileInfo]> wsl-profiles;
    in-out property <string> wsl-new-name: "WSL";
    in-out property <string> wsl-new-distribution;
    in-out property <string> wsl-new-directory: "~";

    in-out property <string> ifd-page: "font";   // 桥到 app（速选面板「更多主题」直达）
    // (#combo-focus-decoupled 2026-10-02) 面板级下拉代际时钟：点面板空白
    // （卡片吞层 → blank-clicked）推进它，各 FontCombo 的 focus-stamp 随之
    // 失效 → 高亮清除。与 session_dialog 的 drop-clock 同构，避免设置侧栏
    // 自造一套失焦机制。
    in-out property <int> combo-clock: 0;
    // (#settings-divider-line) A page switch destroys/rebuilds the right pane's
    // whole subtree through the incremental renderer; one full frame per switch
    // keeps stale buffer strips out of the title divider above.
    // 切页同时收起强调色浮层：开关留在根层，不清的话切回主题页会重新弹出。
    changed ifd-page => {
        root.request-full-redraw();
        root.accent-pop-open = false;
        // 壁纸库以文件夹为准：每次进外观页重扫一次（在外部丢图进来也能出现）。
        if (root.ifd-page == "theme") { root.refresh-wallpapers(); }
    }
    property <string> new-rule-pattern;
    property <bool> new-rule-regex;
    property <bool> new-rule-case-sensitive;
    property <bool> new-rule-whole-line;
    property <string> new-rule-color: "red";
    property <bool> renderer-restart-required;
    property <bool> wp-is-custom:
        root.current-wallpaper != "" && root.current-wallpaper != "builtin:light"
        && root.current-wallpaper != "builtin:dark" && root.current-wallpaper != "builtin:tech"
        && root.current-wallpaper != "builtin:miku" && root.current-wallpaper != "builtin:ms";
    // (#wallpaper-auto-fit 2026-10-18) 「自动」的判定结果：0 = 填充 / 1 = 适应。
    // 规则与 Theme.wallpaper-fit-mode 完全一致（比例差 ≤ 55% → 填充），只是这里
    // 按**作用域区域**的比例把结论写出来；真正的 image-fit 由 Theme 按各元素尺寸算。
    pure function auto-fit-resolved() -> int {
        // 0 = 整个界面 / 1 = 主区域 / 2 = 终端，各用各自矩形的比例。
        let region = root.wallpaper-scope == 2 ? root.term-aspect
            : root.wallpaper-scope == 1 ? root.workspace-aspect : root.window-aspect;
        let image = Theme.wallpaper-aspect;
        if (image <= 0.0 || region <= 0.0) { return 0; }
        let crop = 1.0 - min(image, region) / max(image, region);
        return crop <= 0.55 ? 0 : 1;
    }

    callback request-full-redraw();   // (#settings-divider-line) → AppWindow
    callback set-term-font(string);
    callback set-ui-font(string);
    callback set-term-font-size(int);
    callback set-terminal-line-spacing(float);
    callback set-term-font-bold(bool);
    callback set-term-cursor-style(string);
    callback set-term-cursor-color(string) -> bool;
    callback set-output-highlight(bool, string);
    callback set-json-format-output(bool);
    callback add-output-highlight-rule(string, bool, bool, bool, string) -> bool;
    callback remove-output-highlight-rule(int);
    callback set-output-highlight-rule-enabled(int, bool);
    callback set-ui-scale(int);
    callback set-panel-font(int);   // settings-panel font scale, percent
    callback set-renderer-mode(string);
    callback set-sftp-follow-cd(bool);
    callback set-collapse-right-sidebar-default(bool);
    callback set-collapse-sftp-default(bool);
    callback set-sync-upload-enabled(bool);
    callback save-webdav-settings(bool, string, string, string, string, bool);
    callback webdav-upload();
    callback webdav-download();
    callback set-download-always-ask(bool);
    callback set-paste-confirm-enabled(bool);
    callback set-extra-paste-shortcuts-enabled(bool);
    callback set-zen-mode(bool);
    callback set-quick-commands-as-sidebar(bool);
    // (#close-behavior) 设置 › 窗口 的「关闭按钮行为」下发回调。
    callback set-close-behavior(string);
    // (#storage-location 2026-10-02) 设置 › 窗口 的「存储位置」卡。
    in-out property <string> storage-current;
    in-out property <string> storage-default;
    in-out property <string> storage-target;
    in-out property <string> storage-status;
    in-out property <bool> storage-status-error;
    // (#storage-ui 2026-10-04) 「包含」chips 的两个计数，由 app.slint 下发。
    in-out property <int> storage-host-count;
    in-out property <int> storage-quick-count;
    callback open-storage-dir();
    callback copy-storage-path();
    callback pick-storage-dir();
    callback reset-storage-dir();
    callback switch-storage(bool) -> bool;
    callback set-mcp-permissions(bool, bool, bool, bool);
    callback set-theme(string);                 // 选主题（theme id）
    callback set-follow-system(bool);
    callback set-accent-mode(string, string);   // mode, preset-key/hex
    // hex → color / 色块上的墨色（Rust：src/app.rs；预设弹框在根层同样用）
    pure callback accent-hex-color(string) -> color;
    pure callback accent-ink-on(string) -> color;
    callback set-titlebar-alpha(float);
    callback set-tabbar-alpha(float);
    callback set-sidebar-alpha(float);
    callback set-term-alpha(float);
    callback set-wallpaper-transparency(float);
    callback set-wallpaper-scope(string);
    callback set-wallpaper-fit(string);
    callback set-scrim-style(string);
    callback set-scrim-alpha(float);
    callback set-popup-transparency(float);
    callback set-wallpaper-color-pickup(bool);
    callback set-wallpaper(string);    // none / builtin selection
    callback pick-wallpaper-file();    // open the OS file dialog (Rust)
    callback reveal-wallpaper(string); // 在资源管理器中定位这张壁纸
    callback remove-wallpaper(string); // 二次确认后删除这张壁纸（列表刷新）
    callback refresh-wallpapers();    // 重扫 wallpapers/（文件夹是唯一来源）
    callback add-wsl-profile(string, string, string);
    callback remove-wsl-profile(string);
    callback pick-wsl-directory();
    // (#settings-drag 2026-10-14) 「点面板空白清 FontCombo 聚焦高亮」原由本面板
    // 的全尺寸 blank-ta 完成，已删除：它位于设置卡拖动吞层之上，按下即 GrabMouse
    // 并中断 Slint 事件派发，卡片空白区拖动收不到 pointer-event（实测拖动全失效）。
    // 现在空白点击由卡片吞层（settings_dialog.slint）经本回调推进 combo-clock；
    // 面板里的滚动区都是 ScrollView（Flickable mouse-drag-pan-enabled=false，
    // 鼠标按下直接下穿），空白按下本来就能落到卡片层。
    callback blank-clicked();

    HorizontalLayout {
        // --- Left nav ------------------------------------------------------
        Rectangle {
            width: 168px;
            // Transparent so the whole dialog is one frosted layer (the card's
            // bg-panel); a 1px divider keeps the nav/content separation (items 6/7).
            background: transparent;
            Rectangle {
                // (#settings-divider-line) hairline, flush to the right edge:
                // with the card width device-snapped this lands on exactly one
                // device column (a logical 1px spans two at 125%).
                x: parent.width - self.width; width: Theme.hairline(); height: parent.height;
                background: Theme.border-subtle;
            }
            nav-scroll := ScrollView {
                width: 100%;
                height: 100%;
                content-width: self.visible-width;
                content-height: max(self.visible-height, nav-items.preferred-height);
                nav-items := VerticalLayout {
                    width: nav-scroll.visible-width;
                    padding: 10px;
                    spacing: 2px;
                    alignment: start;
                NavItem {
                    icon: "appearance"; label: root.lang-en ? "Appearance" : "外观";
                    active: root.ifd-page == "theme";
                    clicked => { root.ifd-page = "theme"; }
                }
                NavItem {
                    icon: "pencil"; label: root.lang-en ? "Display & Fonts" : "显示与字体";
                    active: root.ifd-page == "font";
                    clicked => { root.ifd-page = "font"; }
                }
                NavItem {
                    icon: "keyboard"; label: root.lang-en ? "Input" : "输入";
                    active: root.ifd-page == "input";
                    clicked => { root.ifd-page = "input"; }
                }
                NavItem {
                    icon: "rendering"; label: root.lang-en ? "Rendering" : "渲染";
                    active: root.ifd-page == "renderer";
                    clicked => { root.ifd-page = "renderer"; }
                }
                NavItem {
                    icon: "output-highlight"; label: root.lang-en ? "Output" : "输出高亮";
                    active: root.ifd-page == "output";
                    clicked => { root.ifd-page = "output"; }
                }
                NavItem {
                    icon: "folder"; label: "SFTP";
                    active: root.ifd-page == "sftp";
                    clicked => { root.ifd-page = "sftp"; }
                }
                if root.is-windows : NavItem {
                    icon: "computer"; label: "WSL";
                    active: root.ifd-page == "wsl";
                    clicked => { root.ifd-page = "wsl"; }
                }
                NavItem {
                    icon: "chevron-left"; label: root.lang-en ? "Sidebars" : "侧栏";
                    active: root.ifd-page == "sidebar";
                    clicked => { root.ifd-page = "sidebar"; }
                }
                NavItem {
                    icon: "link"; label: root.lang-en ? "Session sync" : "会话同步";
                    active: root.ifd-page == "sync";
                    clicked => { root.ifd-page = "sync"; }
                }
                NavItem {
                    icon: "cloud"; label: "WebDAV";
                    active: root.ifd-page == "webdav";
                    clicked => { root.ifd-page = "webdav"; }
                }
                NavItem {
                    icon: "download"; label: root.lang-en ? "Download" : "下载";
                    active: root.ifd-page == "download";
                    clicked => { root.ifd-page = "download"; }
                }
                // (#close-behavior) 新增:「窗口」页承载关闭按钮行为。
                NavItem {
                    icon: "more-vert"; label: root.lang-en ? "Window" : "窗口";
                    active: root.ifd-page == "window";
                    clicked => { root.ifd-page = "window"; }
                }
                // (#storage-location) 独立页:数据目录的查看/切换/迁移。
                NavItem {
                    icon: "folder-open"; label: root.lang-en ? "Data directory" : "数据目录";
                    active: root.ifd-page == "storage";
                    clicked => { root.ifd-page = "storage"; }
                }
                NavItem {
                    icon: "plug"; label: "MCP";
                    active: root.ifd-page == "mcp";
                    clicked => { root.ifd-page = "mcp"; }
                }
                }
            }
        }
        // --- Right content -------------------------------------------------
        Rectangle {
            horizontal-stretch: 1;
            // Transparent: the card's single bg-panel frost shows through, so the
            // settings panel matches the welcome/resource panels and tracks the
            // wallpaper-opacity slider (items 6/7).
            background: transparent;

            settings-scroll := ScrollView {
                width: 100%;
                height: 100%;
                content-width: self.visible-width;
                content-height: max(self.visible-height, settings-pages.preferred-height);

                settings-pages := VerticalLayout {
                    width: settings-scroll.visible-width;

            // --- Font page ---------------------------------------------
            if root.ifd-page == "font" : VerticalLayout {
                padding-left: 20px;
                padding-right: 20px;
                padding-top: 14px;
                spacing: 0;
                alignment: start;

                SectionHeader { text: root.lang-en ? "INTERFACE" : "界面"; height: 22px; }
                SettingRow {
                    label: root.lang-en ? "Interface font" : "界面字体";
                    desc: root.lang-en
                        ? "Sans-serif face for labels, menus and input boxes. Heavier CJK stems read cleaner at small sizes."
                        : "标签、菜单和输入框使用的无衬线字体。中文字重越粗，小字号下越清晰。";
                    FontCombo {
                        focus-clock <=> root.combo-clock;
                        lang-en: root.lang-en;
                        values: root.ui-fonts;
                        value: root.ui-font-chosen;
                        default-name: root.ui-font-default-name;
                        selected(v) => { root.set-ui-font(v); }
                    }
                }
                SettingRow {
                    label: root.lang-en ? "UI scale" : "界面缩放";
                    desc: root.lang-en ? "Zooms the whole interface (not this panel)."
                                       : "缩放整个界面(不影响本面板)。";
                    Stepper {
                        value: round(root.ui-scale * 100); minimum: 80; maximum: 200; step: 10; unit: "%";
                        changed(v) => { root.set-ui-scale(v); }
                    }
                }
                SettingRow {
                    label: root.lang-en ? "Settings font size" : "界面字体大小";
                    desc: root.lang-en ? "Enlarges this settings panel (font + window)."
                                       : "放大本设置面板的字体和窗口。";
                    show-divider: false;
                    Stepper {
                        value: round(Theme.panel-font * 100); minimum: 80; maximum: 160; step: 10; unit: "%";
                        changed(v) => { root.set-panel-font(v); }
                    }
                }

                Rectangle { height: 14px; }
                SectionHeader { text: root.lang-en ? "TERMINAL" : "终端"; height: 22px; }
                SettingRow {
                    label: root.lang-en ? "Terminal font" : "终端字体";
                    desc: root.lang-en
                        ? "Fixed-pitch face for the terminal grid."
                        : "终端单元格使用的等宽字体。";
                    FontCombo {
                        focus-clock <=> root.combo-clock;
                        lang-en: root.lang-en;
                        values: root.term-fonts;
                        value: root.term-font-chosen;
                        default-name: root.term-font-default-name;
                        selected(v) => { root.set-term-font(v); }
                    }
                }
                SettingRow {
                    label: root.lang-en ? "Terminal font size" : "终端字体大小";
                    Stepper {
                        value: root.term-font-size / 1px; minimum: 8; maximum: 32; step: 1; unit: "px";
                        changed(v) => { root.set-term-font-size(v); }
                    }
                }
                SettingRow {
                    label: root.lang-en ? "Terminal line spacing" : "终端行距";
                    desc: root.lang-en ? "Adjust terminal row height from compact to loose."
                                       : "调整终端行高，可设置得更紧凑或更宽松。";
                    Stepper {
                        value: round(root.terminal-line-spacing * 100);
                        minimum: 80; maximum: 150; step: 5; unit: "%";
                        changed(v) => { root.terminal-line-spacing = v / 100; root.set-terminal-line-spacing(root.terminal-line-spacing); }
                    }
                }
                SettingRow {
                    label: root.lang-en ? "Bold terminal text" : "终端字体加粗";
                    desc: root.lang-en ? "Makes regular terminal output use a bold face."
                                       : "让普通终端输出使用加粗字重。";
                    Switch {
                        on: root.term-font-bold;
                        toggled(v) => { root.term-font-bold = v; root.set-term-font-bold(v); }
                    }
                }
                SettingRow {
                    label: root.lang-en ? "Cursor shape" : "光标类型";
                    desc: root.lang-en ? "Choose the terminal insertion cursor shape."
                                       : "选择终端输入光标的形状。";
                    // (#cursor-seg 2026-10-17) 三个独立按钮 → SegGroup 滑动
                    // 分段（与「弹窗通透度」同一套滑动语言；用户定稿）。
                    SegGroup {
                        active-index: root.term-cursor-style == "block" ? 0
                            : (root.term-cursor-style == "bar" ? 1 : 2);
                        count: 3;
                        CursorSeg {
                            label: root.lang-en ? "Block" : "块状";
                            cursor-kind: "block";
                            active: root.term-cursor-style == "block";
                            clicked => { root.term-cursor-style = "block"; root.set-term-cursor-style("block"); }
                        }
                        CursorSeg {
                            label: root.lang-en ? "Bar" : "竖线";
                            cursor-kind: "bar";
                            active: root.term-cursor-style == "bar";
                            clicked => { root.term-cursor-style = "bar"; root.set-term-cursor-style("bar"); }
                        }
                        CursorSeg {
                            label: root.lang-en ? "Line" : "下划线";
                            cursor-kind: "underline";
                            active: root.term-cursor-style == "underline";
                            clicked => { root.term-cursor-style = "underline"; root.set-term-cursor-style("underline"); }
                        }
                    }
                }
                SettingRow {
                    label: root.lang-en ? "Cursor color" : "光标颜色";
                    desc: root.lang-en ? "Enter a hexadecimal RGB color."
                                       : "输入十六进制 RGB 颜色。";
                    show-divider: false;
                    CursorColorInput {
                        value <=> root.term-cursor-color-hex;
                        preview-color: root.term-cursor-color;
                        apply-color(v) => { root.set-term-cursor-color(v) }
                    }
                }

                Rectangle { height: 12px; }
                Text {
                    text: root.lang-en
                        ? "Install a TTF/OTF font in Windows, then restart MTerm to refresh the font list."
                        : "在 Windows 中安装 TTF/OTF 字体后，重启 MTerm 即可刷新字体列表。";
                    color: Theme.text-muted;
                    font-size: 11px * Theme.panel-font;
                    wrap: word-wrap;
                }
            }

            // --- Input page -------------------------------------------
            if root.ifd-page == "input" : VerticalLayout {
                padding-left: 20px;
                padding-right: 20px;
                padding-top: 14px;
                spacing: 0;
                alignment: start;

                SettingRow {
                    label: root.lang-en ? "Confirm multiline paste" : "确认多行粘贴";
                    desc: root.lang-en ? "Show a review dialog before sending multiline content."
                                       : "发送多行内容前显示预览确认窗口。";
                    Switch {
                        on: root.paste-confirm-enabled;
                        toggled(v) => { root.paste-confirm-enabled = v; root.set-paste-confirm-enabled(v); }
                    }
                }
                SettingRow {
                    label: root.lang-en ? "Additional paste shortcuts" : "额外粘贴快捷键";
                    desc: root.lang-en ? "Enable Ctrl+Alt+V, Shift+Insert, and middle-click paste."
                                       : "启用 Ctrl+Alt+V、Shift+Insert 和鼠标中键粘贴。";
                    show-divider: false;
                    Switch {
                        on: root.extra-paste-shortcuts-enabled;
                        toggled(v) => { root.extra-paste-shortcuts-enabled = v; root.set-extra-paste-shortcuts-enabled(v); }
                    }
                }
            }

            // --- Output highlighting page -----------------------------
            if root.ifd-page == "output" : VerticalLayout {
                padding-left: 20px;
                padding-right: 20px;
                padding-top: 14px;
                spacing: 0;
                alignment: start;

                SettingRow {
                    label: root.lang-en ? "Highlight plain terminal output" : "高亮纯文本终端输出";
                    desc: root.lang-en
                        ? "Adds client-side colours only when the program did not provide ANSI styling."
                        : "仅在程序未提供 ANSI 样式时由客户端补充颜色。";
                    Switch {
                        on: root.output-highlight-enabled;
                        toggled(v) => {
                            root.output-highlight-enabled = v;
                            root.set-output-highlight(v, root.output-highlight-preset);
                        }
                    }
                }
                SettingRow {
                    label: root.lang-en ? "Built-in rule set" : "内置规则集";
                    desc: root.lang-en
                        ? "Log levels is conservative; DevOps also recognises deployment and health states."
                        : "日志级别更保守；DevOps 还识别部署与健康状态。";
                    show-divider: false;
                    FontCombo {
                        focus-clock <=> root.combo-clock;
                        width: 190px;
                        enabled: root.output-highlight-enabled;
                        values: [root.lang-en ? "Log levels" : "日志级别", "DevOps"];
                        value: root.output-highlight-preset == "devops"
                            ? "DevOps"
                            : (root.lang-en ? "Log levels" : "日志级别");
                        selected(v) => {
                            root.output-highlight-preset = v == "DevOps" ? "devops" : "log";
                            root.set-output-highlight(
                                root.output-highlight-enabled,
                                root.output-highlight-preset);
                        }
                    }
                }

                SettingRow {
                    label: root.lang-en ? "Format and colour JSON lines" : "格式化并着色 JSON 行";
                    desc: root.lang-en
                        ? "Pretty-prints only complete JSON objects or arrays that occupy a whole terminal line. Other output is unchanged."
                        : "仅美化占据完整一行且可正确解析的 JSON 对象或数组，其他终端输出保持原样。";
                    show-divider: false;
                    Switch {
                        on: root.json-format-output;
                        toggled(v) => {
                            root.json-format-output = v;
                            root.set-json-format-output(v);
                        }
                    }
                }

                Rectangle { height: 18px; }
                SectionHeader { text: root.lang-en ? "PREVIEW" : "预览"; height: 22px; }
                Rectangle {
                    // (#ifd-preview-autofit 2026-10-01) Height follows the
                    // content instead of a hardcoded 92/116px: those numbers
                    // assumed Consolas's compact line boxes, and the new
                    // default mono (0xProto, taller metrics) pushed the last
                    // row out of the box. preferred-height already includes
                    // padding + spacing, so any terminal font / row count fits.
                    height: max(92px, preview-layout.preferred-height);
                    background: Theme.term-bg;
                    border-radius: 6px;
                    border-width: 1px;
                    border-color: Theme.border-subtle;
                    preview-layout := VerticalLayout {
                        padding: 12px;
                        spacing: 5px;
                        Text { text: "DEBUG cache lookup"; color: root.output-highlight-enabled ? Theme.text-muted : Theme.term-fg; font-family: Theme.term-font-family; font-size: 12px; }
                        Text { text: "INFO server ready"; color: root.output-highlight-enabled ? Theme.accent : Theme.term-fg; font-family: Theme.term-font-family; font-size: 12px; }
                        Text { text: "WARN disk nearly full"; color: root.output-highlight-enabled ? Theme.warning : Theme.term-fg; font-family: Theme.term-font-family; font-size: 12px; }
                        Text { text: "ERROR connection failed"; color: root.output-highlight-enabled ? Theme.danger : Theme.term-fg; font-family: Theme.term-font-family; font-size: 12px; }
                        if root.output-highlight-preset == "devops" : Text { text: "SUCCESS deployment completed"; color: root.output-highlight-enabled ? Theme.success : Theme.term-fg; font-family: Theme.term-font-family; font-size: 12px; }
                    }
                }

                Rectangle { height: 18px; }
                SectionHeader { text: root.lang-en ? "CUSTOM RULES" : "自定义规则"; height: 22px; }
                Text {
                    text: root.lang-en
                        ? "Custom rules run before the built-in preset and never overwrite ANSI colours."
                        : "自定义规则优先于内置规则，且不会覆盖程序输出的 ANSI 颜色。";
                    color: Theme.text-muted;
                    font-size: 11px * Theme.panel-font;
                    wrap: word-wrap;
                }
                Rectangle { height: 10px; }
                LabeledInput {
                    label: root.lang-en ? "Keyword or regular expression" : "关键词或正则表达式";
                    placeholder: root.new-rule-regex ? "timeout|connection refused" : "connection refused";
                    value <=> root.new-rule-pattern;
                    accepted => {
                        if root.add-output-highlight-rule(
                            root.new-rule-pattern, root.new-rule-regex,
                            root.new-rule-case-sensitive, root.new-rule-whole-line,
                            root.new-rule-color) {
                            root.new-rule-pattern = "";
                        }
                    }
                }
                Rectangle { height: 8px; }
                HorizontalLayout {
                    spacing: 8px;
                    FontCombo {
                        focus-clock <=> root.combo-clock;
                        width: 130px;
                        values: [root.lang-en ? "Keyword" : "关键词", root.lang-en ? "Regex" : "正则"];
                        value: root.new-rule-regex
                            ? (root.lang-en ? "Regex" : "正则")
                            : (root.lang-en ? "Keyword" : "关键词");
                        selected(v) => {
                            root.new-rule-regex = v == "Regex" || v == "正则";
                        }
                    }
                    FontCombo {
                        focus-clock <=> root.combo-clock;
                        width: 120px;
                        values: ["Red", "Yellow", "Green", "Cyan", "Magenta", "Gray"];
                        value: root.new-rule-color == "yellow" ? "Yellow"
                            : root.new-rule-color == "green" ? "Green"
                            : root.new-rule-color == "cyan" ? "Cyan"
                            : root.new-rule-color == "magenta" ? "Magenta"
                            : root.new-rule-color == "gray" ? "Gray" : "Red";
                        selected(v) => {
                            root.new-rule-color = v == "Yellow" ? "yellow"
                                : v == "Green" ? "green"
                                : v == "Cyan" ? "cyan"
                                : v == "Magenta" ? "magenta"
                                : v == "Gray" ? "gray" : "red";
                        }
                    }
                    Rectangle { horizontal-stretch: 1; }
                    PrimaryButton {
                        text: root.lang-en ? "Add rule" : "添加规则";
                        disabled: root.new-rule-pattern == "";
                        clicked => {
                            if root.add-output-highlight-rule(
                                root.new-rule-pattern, root.new-rule-regex,
                                root.new-rule-case-sensitive, root.new-rule-whole-line,
                                root.new-rule-color) {
                                root.new-rule-pattern = "";
                            }
                        }
                    }
                }
                SettingRow {
                    label: root.lang-en ? "Case sensitive" : "区分大小写";
                    Switch {
                        on: root.new-rule-case-sensitive;
                        toggled(v) => { root.new-rule-case-sensitive = v; }
                    }
                }
                SettingRow {
                    label: root.lang-en ? "Highlight whole line" : "高亮整行";
                    desc: root.lang-en
                        ? "Otherwise only matching text is coloured."
                        : "关闭时仅高亮匹配到的文字。";
                    show-divider: false;
                    Switch {
                        on: root.new-rule-whole-line;
                        toggled(v) => { root.new-rule-whole-line = v; }
                    }
                }
                if root.output-highlight-rule-status != "" : Text {
                    text: root.output-highlight-rule-status;
                    color: Theme.danger;
                    font-size: 11px * Theme.panel-font;
                    wrap: word-wrap;
                }

                if root.output-highlight-rules.length == 0 : Text {
                    text: root.lang-en ? "No custom rules yet." : "暂无自定义规则。";
                    color: Theme.text-muted;
                    font-size: 11px * Theme.panel-font;
                    height: 34px;
                    vertical-alignment: center;
                }
                for rule[index] in root.output-highlight-rules : Rectangle {
                    height: 44px;
                    Rectangle { y: 0px; width: 100%; height: 1px; background: Theme.border-subtle; }
                    HorizontalLayout {
                        spacing: 9px;
                        Rectangle {
                            width: 8px;
                            height: 8px;
                            border-radius: 4px;
                            background: rule.color == "yellow" ? Theme.warning
                                : rule.color == "green" ? Theme.success
                                : rule.color == "cyan" ? Theme.accent
                                : rule.color == "magenta" ? #d670d6
                                : rule.color == "gray" ? Theme.text-muted
                                : Theme.danger;
                            vertical-stretch: 0;
                        }
                        VerticalLayout {
                            horizontal-stretch: 1;
                            alignment: center;
                            spacing: 2px;
                            Text {
                                text: rule.pattern;
                                color: rule.enabled ? Theme.text-primary : Theme.text-muted;
                                font-family: Theme.term-font-family;
                                font-size: 12px * Theme.panel-font;
                                overflow: elide;
                            }
                            Text {
                                text: (rule.regex ? "Regex" : (root.lang-en ? "Keyword" : "关键词"))
                                    + (rule.case-sensitive ? " · Aa" : "")
                                    + (rule.whole-line ? (root.lang-en ? " · whole line" : " · 整行") : "");
                                color: Theme.text-muted;
                                font-size: 10px * Theme.panel-font;
                            }
                        }
                        Switch {
                            on: rule.enabled;
                            toggled(v) => { root.set-output-highlight-rule-enabled(index, v); }
                        }
                        Rectangle {
                            width: 28px;
                            height: 28px;
                            border-radius: 5px;
                            background: delete-ta.has-hover ? Theme.bg-hover : transparent;
                            delete-ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { root.remove-output-highlight-rule(index); }
                            }
                            Icon {
    glyph: "delete";
    tint: Theme.text-muted;
    size: 15px * Theme.panel-font;
}
                        }
                    }
                }
            }

            // --- Appearance page（主题画廊 + 壁纸 + 弹窗遮罩）2026-10-17 --------
            // (#theme-gallery / #zone-alpha / #scrim-style) 顺序按「皮肤流」：
            //   主题画廊 → 强调色 → 壁纸库 → 显示（透明度/作用域/四分区）→
            //   方式（填充）→ 弹窗与遮罩（通透度/样式/浓度/预览）。
            if root.ifd-page == "theme" : VerticalLayout {
                padding-left: 20px;
                padding-right: 20px;
                padding-top: 14px;
                spacing: 0;
                alignment: start;

                Text {
                    text: root.lang-en
                        ? "Appearance: colour system (incl. terminal ANSI) and wallpaper — independent layers."
                        : "外观：整套配色（含终端 ANSI 调色板）与壁纸 —— 两层相互独立。";
                    color: Theme.text-muted; font-size: 11px * Theme.panel-font; wrap: word-wrap;
                }
                Rectangle { height: 4px; }
                Text {
                    // (#mode-values 2026-10-17) 明暗各一套数值，切换主题自动切换。
                    text: root.lang-en
                        ? "Wallpaper and its display values are stored per theme × wallpaper × scope: switching theme brings that theme's own wallpaper (a theme you never configured starts with no wallpaper), and each scope keeps its own set of values. Something you never touched starts at its defaults."
                        : "壁纸与它的显示数值按「主题 × 壁纸 × 作用域」分开存：换主题就换成那个主题自己的壁纸（没配过的主题 = 无壁纸），两种作用域各存一套数值；没动过的组合就是默认值。";
                    color: Theme.text-muted;
                    font-size: 10.5px * Theme.panel-font;
                    wrap: word-wrap;
                }
                Rectangle { height: 12px; }

                // ── 主题画廊：常用快捷位（≤4）+ ＋更多 ────────────────────
                Text {
                    text: root.lang-en ? "Theme" : "主题";
                    color: Theme.text-primary;
                    font-size: 13px * Theme.panel-font;
                }
                Rectangle { height: 3px; }
                Text {
                    text: root.lang-en
                        ? "Quick slots for your favourite themes (max 6). “More” opens the full list — star a theme there to add it here (also capped at 6). Hover to preview live."
                        : "常用主题快捷位（最多 6 个）。「＋更多」打开完整列表（搜索 / 星标 / 明暗分组）—— 在列表里星标即添加到此处（同样封顶 6 个）。悬停实时预览。";
                    color: Theme.text-muted;
                    font-size: 11px * Theme.panel-font;
                    wrap: word-wrap;
                }
                Rectangle { height: 9px; }
                HorizontalLayout {
                    spacing: 6px;
                    alignment: start;
                    for fav[i] in root.theme-favorites : ThemeCard {
                        entry: fav;
                        selected: root.theme-chosen == fav.id;
                        clicked => {
                            root.theme-chosen = fav.id;
                            root.set-theme(fav.id);
                        }
                        preview(id) => { root.preview-theme(id); }
                        restore() => { root.preview-theme(root.theme-chosen); }
                    }
                    more-card := ThemeMoreCard {
                        lang-en: root.lang-en;
                        clicked => {
                            // 与先前下拉按钮同一套桥：清搜索词 → 打开根层浮层，
                            // 锚点取本卡事件期的窗口坐标。
                            root.theme-pick-search = "";
                            root.theme-search-filter("");
                            root.theme-pick-open = !root.theme-pick-open;
                            root.theme-pick-x = more-card.absolute-position.x;
                            root.theme-pick-y = more-card.absolute-position.y + more-card.height + 4px;
                        }
                    }
                }
                Rectangle { height: 12px; }

                // ── 强调色两态（定稿高保真 #accent-pop-v2）──────────────────
                SettingRow {
                    show-divider: false;
                    label: root.lang-en ? "Accent" : "强调色";
                    desc: root.lang-en
                        ? "Selection / primary button / links — independent of the theme"
                        : "选中态 / 主按钮 / 链接，独立于主题";
                    HorizontalLayout {
                        spacing: 10px;
                        SegGroup {
                            // (#accent-seg-width 2026-10-18) 定宽 220px（高保真
                            // #accSeg）：不定宽时 HorizontalLayout 会把它拉到整行宽，
                            // 与「作用域 250 / 填充 286」两段语言不一致。
                            width: 220px;
                            // (#accent-seg-ghost) 选中态 = 「弹框开着」或「已应用自定义」。
                            active-index: (root.accent-pop-open || root.accent-mode == "custom") ? 1 : 0;
                            count: 2;
                            AccentSeg {
                                label: root.lang-en ? "Follow theme" : "跟随主题";
                                active: !(root.accent-pop-open || root.accent-mode == "custom");
                                clicked => {
                                    root.accent-mode = "follow";
                                    root.accent-preset = "";
                                    root.set-accent-mode("follow", "");
                                    root.accent-pop-open = false;
                                }
                            }
                            AccentSeg {
                                label: root.lang-en ? "Custom" : "自定义";
                                active: root.accent-pop-open || root.accent-mode == "custom";
                                clicked => {
                                    root.accent-stage = root.accent-guard.eff;
                                    root.accent-pop-open = true;
                                }
                            }
                        }
                        chip := Rectangle {
                            width: 46px;
                            height: 32px;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: Theme.border-strong;
                            background: Theme.popup-field;
                            Rectangle {
                                x: 3px;
                                y: 3px;
                                width: parent.width - 6px;
                                height: parent.height - 6px;
                                border-radius: 5px;
                                background: root.accent-hex-color(root.accent-guard.eff);
                            }
                            accent-chip-ta := TouchArea {
                                clicked => { root.blank-clicked(); }
                                changed has-hover => {
                                    root.accent-info-open = self.has-hover;
                                    if (self.has-hover) {
                                        root.accent-info-x = self.absolute-position.x + self.width - 168px;
                                        root.accent-info-y = self.absolute-position.y + self.height + 8px;
                                    }
                                }
                            }
                        }
                    }
                }
                Rectangle { height: 1px; background: Theme.border-subtle; }
                Rectangle { height: 10px; }

                // ── 壁纸库 ──────────────────────────────────────────────
                SectionHeader { text: root.lang-en ? "WALLPAPER" : "壁纸库"; height: 22px; }
                Text {
                    text: root.lang-en
                        ? "Wallpaper is a background only — it never changes the accent or light/dark."
                        : "壁纸只作为背景显示，不再改变界面的强调色和深浅。";
                    color: Theme.text-muted; font-size: 11px * Theme.panel-font; wrap: word-wrap;
                }
                Rectangle { height: 8px; }

                // (#wallpaper-library 2026-10-18) 一条画廊（与高保真同款）：
                // 无 → 内置 5 套 → 数据目录 wallpapers/ 里的自定义图（可多张，
                // 悬停右上角 × 删除）→ ＋上传图片。卡片 79px：9 张 = 743px，
                // 正好落在内容宽（≈750px）内；再多横向滚动。
                wallpaper-scroll := ScrollView {
                    height: 80px;
                    width: 100%;
                    content-width: max(self.visible-width, wallpaper-row.preferred-width);
                    content-height: self.visible-height;

                    wallpaper-row := HorizontalLayout {
                        spacing: 4px;
                        alignment: start;
                        WallpaperCard {
                            caption: root.lang-en ? "None" : "无";
                            selected: root.current-wallpaper == "";
                            clicked => { root.set-wallpaper(""); }
                            Rectangle {
                                width: 100%; height: 100%;
                                background: Theme.window-base;
                                Icon {
                                    glyph: "select-all";
                                    tint: Theme.text-muted;
                                    size: 20px * Theme.panel-font;
                                }
                            }
                        }
                        WallpaperCard {
                            caption: root.lang-en ? "Meat Light" : "简约·浅";
                            selected: root.current-wallpaper == "builtin:light";
                            clicked => { root.set-wallpaper("builtin:light"); }
                            Rectangle {
                                width: 100%; height: 100%;
                                background: @linear-gradient(135deg, #eff3fb 0%, #d5e1f2 100%);
                                Rectangle {
                                    x: parent.width * 0.62; y: -parent.height * 0.18;
                                    width: 46px; height: 46px; border-radius: 23px;
                                    background: #4a90e2; opacity: 0.30;
                                }
                            }
                        }
                        WallpaperCard {
                            caption: root.lang-en ? "Meat Dark" : "简约·暗";
                            selected: root.current-wallpaper == "builtin:dark";
                            clicked => { root.set-wallpaper("builtin:dark"); }
                            Rectangle {
                                width: 100%; height: 100%;
                                background: @linear-gradient(135deg, #10131a 0%, #1b2233 100%);
                                Rectangle {
                                    x: parent.width * 0.62; y: -parent.height * 0.18;
                                    width: 46px; height: 46px; border-radius: 23px;
                                    background: #4a6ce0; opacity: 0.40;
                                }
                            }
                        }
                        WallpaperCard {
                            caption: root.lang-en ? "Fantasy 3048" : "幻想3048";
                            selected: root.current-wallpaper == "builtin:tech";
                            clicked => { root.set-wallpaper("builtin:tech"); }
                            Rectangle {
                                width: 100%; height: 100%;
                                background: @linear-gradient(180deg, #05060f 0%, #0b1430 55%, #1a0a2e 100%);
                                // glowing planet
                                Rectangle {
                                    x: parent.width * 0.5 - 13px; y: parent.height * 0.22;
                                    width: 26px; height: 26px; border-radius: 13px;
                                    background: @radial-gradient(circle, #ff5ea8 0%, #ff5ea800 70%);
                                }
                                // neon horizon line
                                Rectangle {
                                    y: parent.height * 0.58; width: parent.width; height: 2px;
                                    background: #19e6ff; opacity: 0.85;
                                }
                            }
                        }
                        WallpaperCard {
                            caption: "MS";
                            selected: root.current-wallpaper == "builtin:ms";
                            clicked => { root.set-wallpaper("builtin:ms"); }
                            Image {
                                width: 100%; height: 100%;
                                source: @image-url("../assets/ms.jpg");
                                image-fit: cover;
                            }
                        }
                        WallpaperCard {
                            caption: "Miku";
                            selected: root.current-wallpaper == "builtin:miku";
                            clicked => { root.set-wallpaper("builtin:miku"); }
                            Image {
                                width: 100%; height: 100%;
                                source: @image-url("../assets/miku.jpg");
                                image-fit: cover;
                            }
                        }
                        // 自定义：数据目录 wallpapers/ 的投影（放进去就出现）
                        for wp[i] in root.wallpaper-items : WallpaperCard {
                            caption: wp.name;
                            removable: true;
                            selected: root.current-wallpaper == wp.id;
                            clicked => { root.set-wallpaper(wp.id); }
                            remove => { root.remove-wallpaper(wp.id); }
                            Image {
                                width: 100%; height: 100%;
                                source: wp.thumb;
                                image-fit: cover;
                            }
                        }
                        WallpaperCard {
                            caption: root.lang-en ? "Upload" : "上传图片";
                            dashed: true;
                            clicked => { root.pick-wallpaper-file(); }
                        }
                    }
                }

                // 选中自定义壁纸后的工具条（「无」与内置套不显示）
                if root.wp-is-custom : HorizontalLayout {
                    spacing: 10px;
                    alignment: start;
                    GhostButton {
                        text: root.lang-en ? "Show in folder" : "在文件夹中显示";
                        glyph: "folder-open";
                        clicked => { root.reveal-wallpaper(root.current-wallpaper); }
                    }
                    GhostButton {
                        text: root.lang-en ? "Delete this wallpaper" : "删除这张壁纸";
                        glyph: "delete";
                        danger: true;
                        clicked => { root.remove-wallpaper(root.current-wallpaper); }
                    }
                }

                Text {
                    text: root.lang-en
                        ? "Uploaded images are copied into the wallpapers folder of the data directory (PNG / JPG / WEBP). That folder is the library: drop an image in and it appears here, delete the file and it disappears (deletion asks first)."
                        : "上传的图片复制保存到数据目录的 wallpapers 文件夹（PNG / JPG / WEBP）—— 该文件夹即壁纸列表的来源：放入新图片会自动出现在这里，删除文件即从列表消失（实机删除有二次确认）。";
                    color: Theme.text-muted; font-size: 10.5px * Theme.panel-font;
                    wrap: word-wrap;
                }
                Rectangle { height: 12px; }
                Rectangle { height: 1px; background: Theme.border-subtle; }
                Rectangle { height: 10px; }

                // ── 显示（按设置流排序：作用域 → 填充方式 → 壁纸透明度 →
                //    分区透明度；未选壁纸（选「无」）时前三项灰化不可点）──────
                SectionHeader { text: root.lang-en ? "DISPLAY" : "显示"; height: 22px; }

                SettingRow {
                    label: root.lang-en ? "Scope" : "作用域";
                    desc: root.lang-en
                        ? "Where the wallpaper is drawn. Whole window (default) fills the window including the title bar; Main area covers everything below the title bar — sidebars, terminal and bottom panels — and keeps the title bar solid; Terminal draws it in the terminal column only. Outside the scope there is no wallpaper at all: those areas composite over the window base (the desktop when no wallpaper). Dialogs are never part of it. Note: in Main area, raising the title-bar transparency reveals the desktop, not the wallpaper."
                        : "壁纸的**绘制区域**：「整个界面」（默认）= 铺满全窗，**含标题栏**；「主区域」= 标题栏**以下**——左右侧栏、终端、下方面板都有图，只有标题栏保持实心；「终端」= 只画在终端列里，侧栏后面没有图。作用域之外**没有壁纸**，那些区域按各自透明度叠在窗口底上（无壁纸时即桌面）。弹窗 / 浮层不在壁纸范围（由「弹窗与遮罩」单独控制）。注意：在「主区域」下把**标题栏透明度**调高，透出来的是桌面而不是壁纸。";
                    HorizontalLayout {
                        SegGroup {
                            width: 330px;
                            enabled: root.wallpaper-active;
                            active-index: root.wallpaper-scope;
                            count: 3;
                            AccentSeg {
                                label: root.lang-en ? "Whole window" : "整个界面";
                                active: root.wallpaper-scope == 0;
                                clicked => {
                                    root.wallpaper-scope = 0;
                                    root.set-wallpaper-scope("window");
                                }
                            }
                            AccentSeg {
                                label: root.lang-en ? "Main area" : "主区域";
                                active: root.wallpaper-scope == 1;
                                clicked => {
                                    root.wallpaper-scope = 1;
                                    root.set-wallpaper-scope("workspace");
                                }
                            }
                            AccentSeg {
                                label: root.lang-en ? "Terminal" : "终端";
                                active: root.wallpaper-scope == 2;
                                clicked => {
                                    root.wallpaper-scope = 2;
                                    root.set-wallpaper-scope("terminal");
                                }
                            }
                        }
                    }
                }

                SettingRow {
                    label: root.lang-en ? "Fill mode" : "填充方式";
                    desc: root.lang-en
                        ? "Auto (default) crops to fill unless the image and the scope area differ wildly (only then it fits the whole image, which leaves margins). Fill = crop to cover; Fit = whole image with margins; Stretch = fill and distort."
                        : "默认「自动」：**铺满裁切**；只有图片与作用域区域的比例差得离谱（竖图放进超宽区）才改成「适应」完整显示。「填充」= 铺满裁切，「适应」= 完整显示留白（上下会有空缺），「拉伸」= 铺满变形。";
                    HorizontalLayout {
                        VerticalLayout {
                            spacing: 4px;
                            SegGroup {
                                width: 286px;
                                enabled: root.wallpaper-active;
                                active-index: root.wallpaper-fit == "cover" ? 1
                                    : root.wallpaper-fit == "contain" ? 2
                                    : root.wallpaper-fit == "fill" ? 3 : 0;
                                count: 4;
                                AccentSeg {
                                    label: root.lang-en ? "Auto" : "自动";
                                    active: root.wallpaper-fit == "auto";
                                    clicked => {
                                        root.wallpaper-fit = "auto";
                                        root.set-wallpaper-fit("auto");
                                    }
                                }
                                AccentSeg {
                                    label: root.lang-en ? "Fill" : "填充";
                                    active: root.wallpaper-fit == "cover";
                                    clicked => {
                                        root.wallpaper-fit = "cover";
                                        root.set-wallpaper-fit("cover");
                                    }
                                }
                                AccentSeg {
                                    label: root.lang-en ? "Fit" : "适应";
                                    active: root.wallpaper-fit == "contain";
                                    clicked => {
                                        root.wallpaper-fit = "contain";
                                        root.set-wallpaper-fit("contain");
                                    }
                                }
                                AccentSeg {
                                    label: root.lang-en ? "Stretch" : "拉伸";
                                    active: root.wallpaper-fit == "fill";
                                    clicked => {
                                        root.wallpaper-fit = "fill";
                                        root.set-wallpaper-fit("fill");
                                    }
                                }
                            }
                            Text {
                                width: 286px;
                                text: root.wallpaper-fit != "auto"
                                    ? (root.lang-en
                                        ? "Manual: always uses the selected mode"
                                        : "手动：始终按所选模式显示")
                                    : (!root.wallpaper-active
                                        ? (root.lang-en
                                            ? "No wallpaper: not available"
                                            : "未选壁纸：此项暂不可用")
                                        : (root.lang-en
                                            ? "Auto: this image fits the "
                                                + (root.wallpaper-scope == 2 ? "terminal area"
                                                    : root.wallpaper-scope == 1 ? "main area" : "whole window")
                                                + " as " + (root.auto-fit-resolved() == 0 ? "Fill" : "Fit")
                                            : "自动：这张图在「"
                                                + (root.wallpaper-scope == 2 ? "终端区"
                                                    : root.wallpaper-scope == 1 ? "主区域" : "整个界面")
                                                + "」的比例按「"
                                                + (root.auto-fit-resolved() == 0 ? "填充" : "适应")
                                                + "」显示"));
                                color: Theme.accent;
                                font-size: 10.5px * Theme.panel-font;
                                wrap: word-wrap;
                            }
                        }
                    }
                }

                PercentSliderRow {
                    label: root.lang-en ? "Wallpaper transparency" : "壁纸透明度";
                    desc: root.lang-en
                        ? "How transparent the image itself is — higher = fainter. Double-click the slider to reset."
                        : "壁纸图自身的透明程度，越高壁纸越淡；双击滑杆恢复默认。";
                    percent: root.wallpaper-transparency * 100;
                    default-percent: 0;
                    enabled: root.wallpaper-active;
                    lang-en: root.lang-en;
                    changed(v) => { root.wallpaper-transparency = v / 100; }
                    released(v) => { root.set-wallpaper-transparency(v / 100); }
                    reset => { root.set-wallpaper-transparency(root.wallpaper-transparency); }
                }

                HorizontalLayout {
                    padding-top: 8px;
                    padding-bottom: 2px;
                    Text {
                        text: root.lang-en ? "Zone transparency" : "分区透明度";
                        color: Theme.text-primary;
                        font-size: 13px * Theme.panel-font;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    Text {
                        text: root.lang-en ? "Drag · double-click to reset" : "直接拖 · 双击恢复默认";
                        color: Theme.text-muted;
                        font-size: 10.5px * Theme.panel-font;
                        vertical-alignment: center;
                    }
                }
                Rectangle { height: 6px; }
                HorizontalLayout {
                    spacing: 14px;
                    ZoneSlider {
                        width: (parent.width - 42px) * 0.25;
                        label: root.lang-en ? "Title bar" : "标题栏";
                        percent: root.titlebar-transparency * 100;
                        default-percent: Theme.titlebar-default-transparency * 100;
                        lang-en: root.lang-en;
                        changed(v) => { root.titlebar-transparency = v / 100; }
                        released(v) => { root.set-titlebar-alpha(1.0 - v / 100); }
                        reset => { root.set-titlebar-alpha(1.0 - root.titlebar-transparency); }
                    }
                    ZoneSlider {
                        width: (parent.width - 42px) * 0.25;
                        label: root.lang-en ? "Tab bar" : "标签栏";
                        percent: root.tabbar-transparency * 100;
                        default-percent: Theme.tabbar-default-transparency * 100;
                        lang-en: root.lang-en;
                        changed(v) => { root.tabbar-transparency = v / 100; }
                        released(v) => { root.set-tabbar-alpha(1.0 - v / 100); }
                        reset => { root.set-tabbar-alpha(1.0 - root.tabbar-transparency); }
                    }
                    ZoneSlider {
                        width: (parent.width - 42px) * 0.25;
                        label: root.lang-en ? "Sidebars" : "侧栏";
                        percent: root.sidebar-transparency * 100;
                        default-percent: Theme.sidebar-default-transparency * 100;
                        lang-en: root.lang-en;
                        changed(v) => { root.sidebar-transparency = v / 100; }
                        released(v) => { root.set-sidebar-alpha(1.0 - v / 100); }
                        reset => { root.set-sidebar-alpha(1.0 - root.sidebar-transparency); }
                    }
                    ZoneSlider {
                        width: (parent.width - 42px) * 0.25;
                        label: root.lang-en ? "Terminal" : "终端区";
                        percent: root.term-transparency * 100;
                        default-percent: Theme.term-default-transparency * 100;
                        lang-en: root.lang-en;
                        changed(v) => { root.term-transparency = v / 100; }
                        released(v) => { root.set-term-alpha(1.0 - v / 100); }
                        reset => { root.set-term-alpha(1.0 - root.term-transparency); }
                    }
                }
                Rectangle { height: 4px; }
                Text {
                    text: root.lang-en
                        ? "How transparent each of the four zones is (sidebars include both side panels and the bottom panel). These values belong to the current theme × wallpaper × scope — a combination you use for the first time starts at a set that lets the wallpaper show (otherwise everything would just be solid black). With no wallpaper the light/dark base values are used. Double-click restores the default of the current context (with a wallpaper that is NOT 0%). A zone with nothing behind it (no wallpaper, or outside the scope) reveals the window base instead."
                        : "四个区域各自的面板透明程度（侧栏含左右侧栏与下方面板）。这组数值属于「当前主题 × 当前壁纸 × 当前作用域」：第一次使用的组合会自动给一套能看见壁纸的默认值（否则满屏纯黑）；没有壁纸时用明暗各一套的基础值。双击恢复的是**当前组合**的默认值（有壁纸时不是 0%）。没有壁纸（或区域不在作用域内）时透出窗口底色。";
                    color: Theme.text-muted;
                    font-size: 10.5px * Theme.panel-font;
                    wrap: word-wrap;
                }
                Rectangle { height: 6px; }

                Rectangle { height: 1px; background: Theme.border-subtle; }
                Rectangle { height: 10px; }

                // ── 弹窗与遮罩 ──────────────────────────────────────────
                SectionHeader { text: root.lang-en ? "DIALOGS & SCRIM" : "弹窗与遮罩"; height: 22px; }

                // 弹窗通透度 = 弹窗自身的**透明度**（0 实心 → 100% 完全透明）。
                // 与「遮罩浓度」是两个独立参数：一个管弹窗自己透多少，一个管
                // 背后压多暗。100% 时看到的就是背后内容（被遮罩压暗后的样子）。
                PercentSliderRow {
                    label: root.lang-en ? "Dialog transparency" : "弹窗透明度";
                    desc: root.lang-en
                        ? "How transparent the dialog itself is: 0% = solid, 100% = fully transparent (you see straight through to the content behind). Hover bubbles / floating info cards follow this same value. How dark that content is, is controlled by “Scrim strength” below. Double-click to reset."
                        : "弹窗 / 浮层（下拉、弹框、调色盘，以及悬浮提示气泡、拖拽信息卡这些浮在界面上的小卡）自身的透明度：0% = 实心，100% = 完全透明（直接看到背后的内容）。背后压多暗由下面的「遮罩浓度」单独决定。双击滑杆恢复默认。";
                    percent: root.popup-transparency * 100;
                    default-percent: 0;
                    lang-en: root.lang-en;
                    changed(v) => { root.popup-transparency = v / 100; }
                    released(v) => { root.set-popup-transparency(v / 100); }
                    reset => { root.set-popup-transparency(root.popup-transparency); }
                }

                SettingRow {
                    label: root.lang-en ? "Scrim style" : "遮罩样式";
                    desc: root.lang-en
                        ? "Solid black / white, tinted glass, soft light, frost, spotlight, sheen; “Random” picks a new one each time a dialog opens. True backdrop blur is impossible in Slint — soft / frost / sheen are the best glass approximations."
                        : "纯色黑 / 白、染色玻璃、柔光、磨砂、聚光、高光；「随机」每次打开弹窗换一种。真·背景模糊在 Slint 不可行，柔光 / 磨砂 / 高光是效果最好的玻璃近似。";
                    scrim-dd := Rectangle {
                        width: 170px;
                        height: 34px;
                        border-radius: 9px;
                        border-width: 1px;
                        border-color: scrim-dd-ta.has-hover || root.scrim-pick-open
                            ? Theme.accent : Theme.border-control;
                        background: Theme.popup-field;
                        Text {
                            x: 12px;
                            width: parent.width - 40px;
                            text: Theme.scrim-label(root.scrim-style, root.lang-en);
                            color: Theme.text-primary;
                            font-size: 12.5px * Theme.panel-font;
                            vertical-alignment: center;
                            overflow: elide;
                        }
                        Icon {
                            x: parent.width - 26px;
                            glyph: "expand-more";
                            tint: Theme.text-muted;
                            size: 14px;
                        }
                        scrim-dd-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.scrim-pick-x = self.absolute-position.x;
                                root.scrim-pick-y = self.absolute-position.y + self.height + 4px;
                                root.scrim-pick-open = !root.scrim-pick-open;
                            }
                        }
                    }
                }

                // 遮罩浓度：与其它滑杆同款（accent 已选段 + 双击恢复）
                PercentSliderRow {
                    label: root.lang-en ? "Scrim strength" : "遮罩浓度";
                    desc: root.lang-en
                        ? "How much dialogs dim what's behind them. System default 32%. Double-click to reset."
                        : "弹窗背后压暗强度。系统默认 32%，双击滑杆恢复默认。";
                    percent: root.scrim-strength * 100;
                    default-percent: 32;
                    lang-en: root.lang-en;
                    changed(v) => { root.scrim-strength = v / 100; }
                    released(v) => { root.set-scrim-alpha(v / 100); }
                    reset => { root.set-scrim-alpha(root.scrim-strength); }
                }

                // 预览卡：壁纸彩块 + 真实 Scrim + 迷你弹窗（popup-alpha 同源）
                Rectangle {
                    height: 118px;
                    border-radius: 10px;
                    background: Theme.popup-bg-active;
                    border-width: 1px;
                    border-color: Theme.border-subtle;
                    clip: true;
                    HorizontalLayout {
                        padding: 12px;
                        spacing: 16px;
                        Rectangle {
                            width: 224px;
                            border-radius: 8px;
                            clip: true;
                            background: #1f2433;
                            Rectangle { x: 20px; y: 10px; width: 96px; height: 96px; border-radius: 48px; background: #7a5ce0; opacity: 0.9; }
                            Rectangle { x: 152px; y: 54px; width: 56px; height: 56px; border-radius: 28px; background: #26b89a; opacity: 0.85; }
                            Rectangle { x: 130px; y: 8px; width: 44px; height: 44px; border-radius: 22px; background: #ffb648; opacity: 0.9; }
                            // 真实遮罩层（与弹框背后同源，换档位立刻可见）
                            Scrim { }
                            Rectangle {
                                x: 36px;
                                y: 17px;
                                width: 128px;
                                height: 84px;
                                border-radius: 9px;
                                border-width: 1px;
                                border-color: #ffffff38;
                                background: Theme.popup-bg;
                                drop-shadow-blur: 12px;
                                drop-shadow-color: transparent;
                                VerticalLayout {
                                    padding-top: 10px;
                                    padding-bottom: 10px;
                                    padding-left: 11px;
                                    padding-right: 11px;
                                    spacing: 6px;
                                    Rectangle { width: 40px; height: 7px; border-radius: 3.5px; background: Theme.text-primary; opacity: 0.88; }
                                    Rectangle { width: 96px; height: 5px; border-radius: 2.5px; background: Theme.text-primary; opacity: 0.45; }
                                    Rectangle { width: 68px; height: 5px; border-radius: 2.5px; background: Theme.text-primary; opacity: 0.45; }
                                    Rectangle { width: 48px; height: 13px; border-radius: 6px; background: Theme.accent-solid; }
                                }
                            }
                        }
                        VerticalLayout {
                            alignment: center;
                            spacing: 4px;
                            horizontal-stretch: 1;
                            Text {
                                text: root.lang-en
                                    ? (root.popup-transparency < 0.01
                                        ? "Solid (default): the dialog surface is fully opaque."
                                        : "Transparent: the dialog surface is drawn at (100% − this value) opacity over whatever is behind it.")
                                    : (root.popup-transparency < 0.01
                                        ? "实心（默认）：弹窗表面完全不透明。"
                                        : "透明：弹窗表面按「100% − 本值」的不透明度叠在背后内容上 —— 100% 即完全透出。");
                                color: Theme.text-muted;
                                font-size: 11px * Theme.panel-font;
                                wrap: word-wrap;
                            }
                            Text {
                                text: root.lang-en
                                    ? "Applies to all floating layers (menus, dialogs, pickers) immediately."
                                    : "对全部浮层（下拉 / 弹框 / 调色盘）立即生效，重启后保持。";
                                color: Theme.text-muted;
                                font-size: 10.5px * Theme.panel-font;
                                opacity: 0.8;
                                wrap: word-wrap;
                            }
                        }
                    }
                }
            }
            // --- Renderer page (#280) ---------------------------------
            if root.ifd-page == "renderer" : VerticalLayout {
                padding-left: 20px;
                padding-right: 20px;
                padding-top: 14px;
                spacing: 0;
                alignment: start;

                SettingRow {
                    label: root.lang-en ? "Renderer" : "渲染器";
                    desc: Theme.is-mac
                        ? (root.lang-en
                            ? "CPU is the compatibility default. FemtoVG and Skia use GPU acceleration."
                            : "CPU 是兼容性默认渲染器；FemtoVG 和 Skia 使用 GPU 加速。")
                        : (root.lang-en
                            ? "Auto tries GPU acceleration and lets Slint fall back to software. Software is best for VMs and compatibility."
                            : "自动模式会尝试 GPU 加速，并由 Slint 在初始化失败时回退到软件渲染；虚拟机或兼容性优先时请选择软件。");
                    show-divider: false;
                    // (#ifd-combo-unify 2026-10-01) Was the last std ComboBox;
                    // the custom FontCombo dropdown matches the panel chrome.
                    FontCombo {
                        focus-clock <=> root.combo-clock;
                        width: 150px;
                        values: Theme.is-mac
                            ? ["CPU", "FemtoVG", "Skia"]
                            : (root.lang-en
                                ? ["Automatic", "GPU", "Software"]
                                : ["自动", "GPU", "软件"]);
                        value: Theme.is-mac
                            ? (root.renderer-mode == "skia"
                                ? "Skia"
                                : root.renderer-mode == "femtovg" ? "FemtoVG" : "CPU")
                            : (root.renderer-mode == "auto"
                                ? (root.lang-en ? "Automatic" : "自动")
                                : root.renderer-mode == "gpu"
                                    ? "GPU"
                                    : (root.lang-en ? "Software" : "软件"));
                        selected(v) => {
                            if (Theme.is-mac && v == "CPU"
                                    && root.renderer-mode != "software") {
                                root.renderer-mode = "software";
                                root.set-renderer-mode("software");
                                root.renderer-restart-required = true;
                            } else if (Theme.is-mac && v == "FemtoVG"
                                    && root.renderer-mode != "femtovg") {
                                root.renderer-mode = "femtovg";
                                root.set-renderer-mode("femtovg");
                                root.renderer-restart-required = true;
                            } else if (Theme.is-mac && v == "Skia"
                                    && root.renderer-mode != "skia") {
                                root.renderer-mode = "skia";
                                root.set-renderer-mode("skia");
                                root.renderer-restart-required = true;
                            } else if (!Theme.is-mac && (v == "Automatic" || v == "自动")
                                    && root.renderer-mode != "auto") {
                                root.renderer-mode = "auto";
                                root.set-renderer-mode("auto");
                                root.renderer-restart-required = true;
                            } else if (!Theme.is-mac && v == "GPU" && root.renderer-mode != "gpu") {
                                root.renderer-mode = "gpu";
                                root.set-renderer-mode("gpu");
                                root.renderer-restart-required = true;
                            } else if (!Theme.is-mac && (v == "Software" || v == "软件")
                                    && root.renderer-mode != "software") {
                                root.renderer-mode = "software";
                                root.set-renderer-mode("software");
                                root.renderer-restart-required = true;
                            }
                        }
                    }
                }
                Rectangle { height: 10px; }
                Text {
                    text: root.renderer-restart-required
                        ? (root.lang-en
                            ? "Restart MTerm to apply the renderer change."
                            : "重启 MTerm 后渲染器设置才会生效。")
                        : (root.lang-en
                            ? (Theme.is-mac
                                ? "CPU is the default renderer on macOS."
                                : (root.is-windows
                                    ? "Software remains the compatibility default for existing installations."
                                    : "Automatic remains the default renderer on Linux."))
                            : (Theme.is-mac
                                ? "macOS 默认使用 CPU 渲染器。"
                                : (root.is-windows
                                    ? "现有安装继续默认使用兼容性更好的软件渲染。"
                                    : "Linux 默认继续使用自动渲染器。")));
                    color: root.renderer-restart-required ? Theme.accent : Theme.text-muted;
                    font-size: 11px * Theme.panel-font;
                    wrap: word-wrap;
                }
            }

            // --- SFTP page ---------------------------------------------
            if root.ifd-page == "sftp" : VerticalLayout {
                padding-left: 20px;
                padding-right: 20px;
                padding-top: 14px;
                spacing: 0;
                alignment: start;
                SettingRow {
                    label: root.lang-en ? "SFTP follows terminal cd" : "SFTP 跟随 cd 更新";
                    desc: root.lang-en
                        ? "A cd in the terminal switches the SFTP panel to the same directory."
                        : "终端里执行 cd 时,SFTP 面板自动切到相同目录。";
                    show-divider: false;
                    Switch {
                        on: root.sftp-follow-cd;
                        toggled(v) => { root.sftp-follow-cd = v; root.set-sftp-follow-cd(v); }
                    }
                }
            }

            // --- WSL page ----------------------------------------------
            if root.ifd-page == "wsl" : VerticalLayout {
                padding-left: 20px;
                padding-right: 20px;
                padding-top: 14px;
                spacing: 8px;
                alignment: start;
                Text {
                    text: root.lang-en
                        ? "Add multiple WSL launch entries. A blank distribution uses the Windows default; ~ opens the selected Linux user's home directory."
                        : "可添加多个 WSL 启动项。发行版留空时使用 Windows 默认发行版；~ 表示所选 Linux 用户的主目录。";
                    color: Theme.text-muted;
                    font-size: 11px * Theme.panel-font;
                    wrap: word-wrap;
                }
                LabeledInput {
                    label: root.lang-en ? "Display name" : "显示名称";
                    placeholder: "Ubuntu";
                    value <=> root.wsl-new-name;
                }
                LabeledInput {
                    label: root.lang-en ? "Distribution (optional)" : "发行版（可选）";
                    placeholder: "Ubuntu-24.04";
                    value <=> root.wsl-new-distribution;
                }
                HorizontalLayout {
                    spacing: 8px;
                    LabeledInput {
                        horizontal-stretch: 1;
                        label: root.lang-en ? "Startup directory" : "启动目录";
                        placeholder: "~ or /home/user/project";
                        value <=> root.wsl-new-directory;
                    }
                    VerticalLayout {
                        alignment: end;
                        GhostButton {
                            text: root.lang-en ? "Browse…" : "选择目录…";
                            clicked => { root.pick-wsl-directory(); }
                        }
                    }
                }
                HorizontalLayout {
                    alignment: end;
                    PrimaryButton {
                        text: root.lang-en ? "Add WSL" : "添加 WSL";
                        clicked => {
                            root.add-wsl-profile(root.wsl-new-name, root.wsl-new-distribution, root.wsl-new-directory);
                            root.wsl-new-name = "WSL";
                            root.wsl-new-distribution = "";
                            root.wsl-new-directory = "~";
                        }
                    }
                }
                Rectangle { height: 1px; background: Theme.border-subtle; }
                for profile in root.wsl-profiles : Rectangle {
                    height: 54px;
                    border-radius: Theme.radius-sm;
                    background: Theme.popup-bg-elevated;
                    HorizontalLayout {
                        padding-left: 10px; padding-right: 8px; spacing: 8px;
                        VerticalLayout {
                            horizontal-stretch: 1; alignment: center;
                            Text { text: profile.name; color: Theme.text-primary; font-size: 13px * Theme.panel-font; }
                            Text {
                                text: (profile.distribution == "" ? (root.lang-en ? "Default distribution" : "默认发行版") : profile.distribution)
                                    + "  ·  " + profile.directory;
                                color: Theme.text-muted; font-size: 11px * Theme.panel-font; overflow: elide;
                            }
                        }
                        GhostButton {
                            text: root.lang-en ? "Remove" : "删除";
                            clicked => { root.remove-wsl-profile(profile.id); }
                        }
                    }
                }
            }

            // --- Sidebars page -----------------------------------------
            if root.ifd-page == "sidebar" : VerticalLayout {
                padding-left: 20px;
                padding-right: 20px;
                padding-top: 14px;
                spacing: 0;
                alignment: start;
                SettingRow {
                    label: root.lang-en ? "Collapse the resource panel by default" : "默认收起资源视图面板";
                    Switch {
                        on: root.collapse-right-sidebar-default;
                        toggled(v) => { root.collapse-right-sidebar-default = v; root.set-collapse-right-sidebar-default(v); }
                    }
                }
                SettingRow {
                    label: root.lang-en ? "Zen mode" : "专注模式";
                    desc: root.lang-en
                        ? "Hide side panels and collapsed edge strips so the terminal fills the window."
                        : "隐藏侧栏、底栏和收起图标，让终端填满窗口内容区。";
                    Switch {
                        on: root.zen-mode;
                        toggled(v) => { root.zen-mode = v; root.set-zen-mode(v); }
                    }
                }
                SettingRow {
                    label: root.lang-en ? "Collapse the SFTP panel by default" : "默认收起 SFTP 侧栏";
                    desc: root.lang-en
                        ? "Takes effect on next launch; handy on low-spec jump hosts."
                        : "下次启动生效;低配跳板机上可减少常驻面板开销。";
                    Switch {
                        on: root.collapse-sftp-default;
                        toggled(v) => { root.collapse-sftp-default = v; root.set-collapse-sftp-default(v); }
                    }
                }
                SettingRow {
                    label: root.lang-en ? "Quick commands as a sidebar" : "快捷命令作为侧栏";
                    desc: root.lang-en
                        ? "Allows the quick-command popup to be dragged to a window edge. After docking, use the sidebar or its collapsed icon."
                        : "允许把快捷命令弹窗拖到窗口边缘；停靠后通过侧栏或收起图标使用。";
                    show-divider: false;
                    Switch {
                        on: root.quick-commands-as-sidebar;
                        toggled(v) => {
                            root.quick-commands-as-sidebar = v;
                            root.set-quick-commands-as-sidebar(v);
                        }
                    }
                }
            }

            // --- Welcome page ------------------------------------------
            // --- Session sync page -------------------------------------
            if root.ifd-page == "sync" : VerticalLayout {
                padding-left: 20px;
                padding-right: 20px;
                padding-top: 14px;
                spacing: 0;
                alignment: start;
                SettingRow {
                    label: root.lang-en ? "Sync file uploads" : "文件上传同步";
                    desc: root.lang-en
                        ? "While session sync is on, an upload goes to the same path on each session; if missing, to that session's current SFTP directory."
                        : "会话同步开启时,上传会发往各会话的相同路径;路径不存在则发往该会话当前 SFTP 目录。";
                    show-divider: false;
                    Switch {
                        on: root.sync-upload-enabled;
                        toggled(v) => { root.sync-upload-enabled = v; root.set-sync-upload-enabled(v); }
                    }
                }
                Rectangle { height: 6px; }
                Text {
                    text: root.lang-en
                        ? "Session sync itself is toggled from the sync icon in the top-right bar."
                        : "会话同步本身从右上角的同步图标开关。";
                    color: Theme.text-muted; font-size: 11px * Theme.panel-font; wrap: word-wrap;
                }
            }

            // --- WebDAV page (#185) ------------------------------------
            if root.ifd-page == "webdav" : VerticalLayout {
                padding-left: 20px;
                padding-right: 20px;
                padding-top: 14px;
                spacing: 10px;
                alignment: start;
                SettingRow {
                    label: root.lang-en ? "Enable WebDAV sync" : "启用 WebDAV 同步";
                    desc: root.lang-en
                        ? "Manual upload/download only; MTerm will not connect on startup."
                        : "仅手动上传/下载;MTerm 启动时不会自动连接。";
                    show-divider: false;
                    Switch {
                        on: root.webdav-enabled;
                        toggled(v) => { root.webdav-enabled = v; }
                    }
                }
                LabeledInput {
                    label: root.lang-en ? "Endpoint URL" : "WebDAV 地址";
                    placeholder: "https://nas:5006/all/ or https://nas:5006/all/mterm-connections.json";
                    value <=> root.webdav-url;
                }
                LabeledInput {
                    label: root.lang-en ? "Username" : "用户名";
                    placeholder: root.lang-en ? "Optional" : "可选";
                    value <=> root.webdav-username;
                }
                LabeledInput {
                    label: root.lang-en ? "Password / app token" : "密码 / 应用令牌";
                    placeholder: root.lang-en ? "Optional" : "可选";
                    password: true;
                    value <=> root.webdav-password;
                }
                LabeledInput {
                    label: root.lang-en ? "Remote file" : "远端文件";
                    placeholder: "mterm-connections.json";
                    value <=> root.webdav-remote-path;
                }
                SettingRow {
                    label: root.lang-en ? "Trust self-signed / intranet certs" : "信任自签名/内网证书";
                    desc: root.lang-en
                        ? "Use only for trusted NAS or LAN WebDAV over HTTPS."
                        : "仅用于可信 NAS 或局域网 HTTPS WebDAV。";
                    show-divider: false;
                    Switch {
                        on: root.webdav-accept-invalid-certs;
                        toggled(v) => { root.webdav-accept-invalid-certs = v; }
                    }
                }
                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;
                    GhostButton {
                        text: root.lang-en ? "Save" : "保存";
                        clicked => {
                            root.save-webdav-settings(
                                root.webdav-enabled, root.webdav-url, root.webdav-username,
                                root.webdav-password, root.webdav-remote-path,
                                root.webdav-accept-invalid-certs);
                        }
                    }
                    GhostButton {
                        text: root.lang-en ? "Download" : "下载";
                        clicked => { root.webdav-download(); }
                    }
                    PrimaryButton {
                        text: root.lang-en ? "Upload" : "上传";
                        clicked => { root.webdav-upload(); }
                    }
                }
                Text {
                    text: root.webdav-status;
                    color: Theme.text-muted;
                    font-size: 11px * Theme.panel-font;
                    wrap: word-wrap;
                }
            }

            // --- Download page -----------------------------------------
            if root.ifd-page == "download" : VerticalLayout {
                padding-left: 20px;
                padding-right: 20px;
                padding-top: 14px;
                spacing: 0;
                alignment: start;
                SettingRow {
                    label: root.lang-en ? "Always ask where to save" : "总是询问保存去何处";
                    desc: root.lang-en
                        ? "Every download prompts for a location instead of using the preset folder."
                        : "每次下载都询问保存位置,而不是直接存到预设下载目录。";
                    show-divider: false;
                    Switch {
                        on: root.download-always-ask;
                        toggled(v) => { root.download-always-ask = v; root.set-download-always-ask(v); }
                    }
                }
            }

            // --- (#close-behavior) Window page --------------------------
            // 承载「关闭按钮行为」。与关闭确认卡共用同一份状态:
            // 这里改了,关窗弹卡的默认项/直退行为同步变(反之亦然)。
            if root.ifd-page == "window" : VerticalLayout {
                padding-left: 20px;
                padding-right: 20px;
                padding-top: 14px;
                spacing: 0;
                alignment: start;
                SettingRow {
                    label: root.lang-en ? "Close button behavior" : "关闭按钮行为";
                    desc: root.lang-en
                        ? "What the window close button does."
                        : "点击窗口关闭按钮时的行为";
                    show-divider: false;
                    // (#hifi-select 2026-09-19) 换用与新建会话弹窗同款的 SelectField:
                    // 38px 圆角框 + 蓝色焦点/展开态 + 原生弹层,替代 ComboBox 的系统样式。
                    close-dd := SelectField {
                        width: 200px;
                        // 选项文案随语言;picked 里再映射回 id 下发。
                        choices: root.lang-en
                            ? ["Ask every time", "Minimize to tray", "Quit completely"]
                            : ["每次询问", "最小化到托盘", "直接完全退出"];
                        value: root.close-behavior == "tray"
                            ? (root.lang-en ? "Minimize to tray" : "最小化到托盘")
                            : root.close-behavior == "exit"
                                ? (root.lang-en ? "Quit completely" : "直接完全退出")
                                : (root.lang-en ? "Ask every time" : "每次询问");
                        picked(v) => {
                            root.close-behavior = v == (root.lang-en ? "Minimize to tray" : "最小化到托盘")
                                ? "tray"
                                : v == (root.lang-en ? "Quit completely" : "直接完全退出")
                                    ? "exit" : "ask";
                            root.set-close-behavior(root.close-behavior);
                        }
                    }
                }
            }

            // --- (#storage-location) Data-directory page ----------------
            if root.ifd-page == "storage" : VerticalLayout {
                padding-left: 20px;
                padding-right: 20px;
                padding-top: 14px;
                spacing: 0;
                alignment: start;
                StorageSettings {
                    lang-en: root.lang-en;
                    current-dir: root.storage-current;
                    default-dir: root.storage-default;
                    target-dir <=> root.storage-target;
                    status: root.storage-status;
                    status-error: root.storage-status-error;
                    host-count: root.storage-host-count;
                    quick-count: root.storage-quick-count;
                    open-dir() => { root.open-storage-dir(); }
                    copy-path() => { root.copy-storage-path(); }
                    pick-dir() => { root.pick-storage-dir(); }
                    reset-dir() => { root.reset-storage-dir(); }
                    switch-to(m) => { root.switch-storage(m); }
                }
            }

            // --- MCP page ----------------------------------------------
            if root.ifd-page == "mcp" : VerticalLayout {
                padding-left: 20px;
                padding-right: 20px;
                padding-top: 14px;
                spacing: 0;
                alignment: start;
                SettingRow {
                    label: root.lang-en ? "Enable MCP server" : "启用 MCP 服务";
                    desc: root.lang-en
                        ? "Allows local MCP clients to start MTerm mcp serve over stdio."
                        : "允许本机 MCP 客户端通过 MTerm mcp serve 启动 stdio 服务。";
                    Switch {
                        on: root.mcp-enabled;
                        toggled(v) => {
                            root.mcp-enabled = v;
                            root.set-mcp-permissions(v, root.mcp-use-saved-credentials, root.mcp-allow-commands, root.mcp-allow-file-transfers);
                        }
                    }
                }
                SettingRow {
                    label: root.lang-en ? "Use saved credentials" : "使用已保存凭据";
                    desc: root.lang-en
                        ? "MCP may authenticate with saved passwords and private keys, but can never read them."
                        : "MCP 可以使用已保存的密码和私钥完成认证，但永远不能读取其内容。";
                    Switch {
                        on: root.mcp-use-saved-credentials;
                        toggled(v) => {
                            root.mcp-use-saved-credentials = v;
                            root.set-mcp-permissions(root.mcp-enabled, v, root.mcp-allow-commands, root.mcp-allow-file-transfers);
                        }
                    }
                }
                SettingRow {
                    label: root.lang-en ? "Allow arbitrary SSH commands" : "允许任意 SSH 命令";
                    desc: root.lang-en
                        ? "Preview setting: permits run_command on saved SSH sessions."
                        : "预览阶段设置：允许对已保存的 SSH 会话调用 run_command。";
                    show-divider: false;
                    Switch {
                        on: root.mcp-allow-commands;
                        toggled(v) => {
                            root.mcp-allow-commands = v;
                            root.set-mcp-permissions(root.mcp-enabled, root.mcp-use-saved-credentials, v, root.mcp-allow-file-transfers);
                        }
                    }
                }
                SettingRow {
                    label: root.lang-en ? "Allow file transfers" : "允许文件传输";
                    desc: root.lang-en
                        ? "Permits MCP uploads from local paths and downloads to local directories."
                        : "允许 MCP 从本地路径上传文件，以及将远程文件下载到本地目录。";
                    show-divider: false;
                    Switch {
                        on: root.mcp-allow-file-transfers;
                        toggled(v) => {
                            root.mcp-allow-file-transfers = v;
                            root.set-mcp-permissions(root.mcp-enabled, root.mcp-use-saved-credentials, root.mcp-allow-commands, v);
                        }
                    }
                }
                Rectangle { height: 18px; }
                Text {
                    text: root.lang-en
                        ? "Command: MTerm mcp serve\nTransport: stdio (local process only)"
                        : "启动命令：MTerm mcp serve\n传输方式：stdio（仅本机进程）";
                    color: Theme.text-muted;
                    font-family: Theme.term-font-family;
                    font-size: 12px * Theme.panel-font;
                }
            }

                }
            }
        }
    }
}
