// (#find-bar 2026-10-27) 终端查找栏 —— 高保真 v3.6 右上浮层。
//
// 高保真稿：docs/design/find-bar-hifi-2026-10-23.html（v3.6）
// 数据侧：src/terminal/impls/terminal_find.rs（匹配/扫描/步进）
// 宿主接线：ui/terminal_view.slint（`if root.find-active : FindBar`）
//
// ★ 组件**只画和响应**：匹配、计数、步进都委托给宿主回调；本文件不认识
//   「终端网格」——这是 cmd-hint 的同一纪律（两处宿主不长第二份实现）。
//
// v3.6 落进本文件的口径：
//   · 定位：右上角 8px，宽 430（窄面板按 §06① 降级）；
//   · 聚焦光环：1px accent + 3px accent-soft（项目惯例，dialog-buttons-v2）；
//   · 四态（§02）：刚打开（只有手柄+输入框，计数/↑↓ 隐藏）、有结果、
//     没找到（计数红「0 个结果」+ 描边/光环/镜头转红，↑↓ 隐藏）、开关开启；
//   · Esc / ✕ 两段式（§04 关闭行）：有词先清词（带词清空入历史 §06⑦），
//     无词才关；
//   · Shift+Enter = 上一个（§04 跳转行）；
//   · Alt C/X/↓ 仅本输入框持焦时接管（§04），焦点在终端时不经这里；
//   · 手柄拖动 + 四角磁吸 ≤12px + 双击复位（§03 拖动细则）+ 三态配色
//     （静默置灰 / 悬停 accent 淡染 / 按住 accent 描边）；
//   · 下移让位（§03②③④）：宿主传当前匹配几何，组件按「匹配与锚位相交」
//     200ms 去抖判定——相交则让位（下移优先、放不上时上移 §06③），
//     不相交回锚位（钉过手柄回钉住处，§03④）；
//   · 重开/切 tab 回填 initial-*（§06⑨/⑩），不自动滚动；
//   · 输出去抖重算：面板打开期间每 400ms 提交一次当前词，Rust 幂等分支
//     决定是否真重扫（输出停顿 ≥200ms 才算，§04 新输出行）；
//   · 关闭（Esc/✕）不回 live bottom —— 面板关掉即止，滚动位置归宿主管。

import { Icon } from "icons.slint";
import { Theme } from "theme.slint";

// 一条查询历史（§04 历史行 / §06⑦）。
export struct FindHistItem {
    query: string,
    match-case: bool,
    use-regex: bool,
}

export component FindBar inherits Rectangle {
    // ── 数据（宿主 = TerminalView 转发 TermRow）────────────────────────
    in property <string> tab-id;
    in property <int> find-total: 0;
    in property <int> find-current-no: 0;
    in property <bool> find-invalid-regex: false;
    // 终端可视行数（居中跳转的「行数/2」在 Rust 侧算，这里只透传）。
    in property <[FindHistItem]> history: [];

    // ── 回调（宿主转发给 Rust）─────────────────────────────────────────
    callback query-changed(string);            // 200ms 去抖后的词
    callback options-changed(string, bool, bool); // (query, aa, regex)
    callback step(int);                        // +1 下一个 / -1 上一个
    callback pick-hit(int, int);               // 点击高亮 (vis-row, col)
    callback closed();                         // 面板关闭（宿主收焦点回终端）
    // (§06⑦) 查询入历史：Enter 步进与带词离开当前查询时提交（宿主落盘）。
    callback query-committed(string, bool, bool);

    // ── 让位判定几何（§03②）：宿主传当前匹配与网格原点 ──────────────────
    // 匹配矩形（网格坐标，cur-row < 0 = 当前匹配不在视口 → 不相交）。
    in property <int> find-cur-row: -1;
    in property <int> find-cur-col: 0;
    in property <int> find-cur-len: 0;
    in property <length> cell-w: 8px;
    in property <length> cell-h: 16px;
    // 网格原点（窗口绝对坐标）：组件内减自身 absolute-position 换算成本
    // 组件坐标系的偏移，滚动/布局变化时绑定自动跟随。
    in property <length> grid-abs-x: 0px;
    in property <length> grid-abs-y: 0px;
    property <length> grid-rel-x: root.grid-abs-x - self.absolute-position.x;
    property <length> grid-rel-y: root.grid-abs-y - self.absolute-position.y;

    // ── 重开/切 tab 回填（§06⑨/⑩）：宿主从 TermBuffer.find 铺来 ─────────
    // init 时初始化（重开回填，不自动滚动）；changed 时同步（切 tab 显示
    // 该 tab 的词）。回调只在值真正变化时触发，rebuild 每帧回写无害。
    in property <string> initial-query: "";
    in property <bool> initial-match-case: false;
    in property <bool> initial-use-regex: false;

    // ── 面板局部状态 ───────────────────────────────────────────────────
    property <bool> match-case: false;
    property <bool> use-regex: false;
    property <string> query: "";
    property <bool> hist-open: false;
    // 下移/上移让位后的偏移（§03②③）：0 = 锚位；>0 = 让到匹配行下方，
    // <0 = 上移到匹配行上方（§06③ 死角）。
    property <length> yield-y: 0px;
    // 手柄钉位（§03 拖动细则）：会话内记忆，不持久化；-1 = 未钉（右上默认）。
    // v3.6 §03④：锚位 = 钉住位（未钉 = 右上默认），让位/回锚都相对它。
    property <length> pin-x: -1px;
    property <length> pin-y: -1px;
    // true 仅在按住手柄拖动期间；松手即 false（钉位继续生效）。
    property <bool> dragging: false;
    property <length> eff-x: self.pin-x >= 0px ? self.pin-x : self.anchor-x;
    property <length> eff-y: self.pin-y >= 0px ? self.pin-y : self.anchor-y;
    // 输入去抖（§04 默认行为行：200ms）。
    property <bool> debounce-pending: false;
    // 让位判定去抖（§03②：200ms；匹配变化合并成一次判定）。
    property <bool> yield-pending: false;

    // 面板宽（§06① 窄面板降级：<360 计数缩字，<300 只留输入+清空+关闭）。
    property <length> panel-w: root.width < 420px ? max(240px, root.width - 16px) : 430px;
    property <bool> compact: self.panel-w < 360px;
    property <bool> mini: self.panel-w < 300px;

    // 锚位（§03 v3.6：钉过用钉住位，没钉用右上默认）。
    property <length> anchor-x: root.width - self.panel-w - 8px;
    property <length> anchor-y: 8px;

    // 「没找到 / 正则无效」红态（§02 没找到态）：fgroup 描边、聚焦光环、
    // 镜头一并转红；仅计数红字（正则无效 §06⑤）由计数位承担。
    property <bool> fail-state: (root.find-total == 0 && root.query != "")
        || root.find-invalid-regex;

    // ── 悬浮提示（tooltip）：按钮不自己渲染气泡，写到根的 tip-*，由
    //    组件末尾的统一浮层渲染（声明在最后 = 画在最上；照 app.slint
    //    IconBtn 的 topbar-tip 机制做成组件内局部版，300ms 防闪烁）。
    property <string> tip-text: "";
    property <string> tip-pending: "";
    property <length> tip-x: 0px;
    property <length> tip-y: 0px;
    function tip-show(text: string, ax: length, ay: length) {
        root.tip-pending = text;
        root.tip-x = ax - self.absolute-position.x;
        root.tip-y = ay - self.absolute-position.y;
    }
    function tip-hide() {
        root.tip-pending = "";
        root.tip-text = "";
    }
    Timer {
        interval: 300ms;
        running: root.tip-pending != "";
        triggered => {
            root.tip-text = root.tip-pending;
            root.tip-pending = "";
        }
    }

    Timer {
        interval: 200ms;
        running: root.debounce-pending;
        triggered => {
            root.debounce-pending = false;
            root.query-changed(root.query);
        }
    }

    // 让位判定去抖（§03② 200ms）：匹配变化的多个 changed 合并成一次判定；
    // 输出流刷屏不改 current（绝对行号锚定），不会连续触发位移。
    Timer {
        interval: 200ms;
        running: root.yield-pending;
        triggered => {
            root.yield-pending = false;
            root.apply-yield();
        }
    }

    // (§04 新输出行) 输出停顿 200ms 后静默重算的驱动源：面板打开且有词期间
    // 每 400ms 提交一次当前词；Rust 侧 find_set_query 幂等分支决定是否真的
    // 重扫（扫描后来过新输出且已静默 ≥200ms 才扫），刷屏期间这里空转。
    Timer {
        interval: 400ms;
        running: root.query != "";
        triggered => { root.query-changed(root.query); }
    }

    // ── 让位判定（§03②③④）：匹配与基准位（钉位/右上默认锚位）相交 →
    // 下移到匹配行下方；下方放不下（§06③）上移到匹配行上方；不相交 →
    // 回锚位（yield-y = 0，钉过手柄回钉住处）。拖动中不判定。
    function apply-yield() {
        if (root.dragging) {
            return;
        }
        if (root.find-cur-row < 0 || root.cell-h <= 0px) {
            root.yield-y = 0px;
            return;
        }
        let my0 = root.grid-rel-y + root.find-cur-row * root.cell-h;
        let mx0 = root.grid-rel-x + root.find-cur-col * root.cell-w;
        let mx1 = mx0 + root.find-cur-len * root.cell-w;
        let px = root.eff-x;
        let py = root.eff-y;
        let hit = px < mx1 && px + root.panel-w > mx0
            && py < my0 + root.cell-h && py + 34px > my0;
        if (!hit) {
            root.yield-y = 0px;
            return;
        }
        // 让位：面板 34px 高、与匹配行净距 6px；「下移让位」下方总有空间
        // （面板 ≪ 终端行数），仅钉到底部 + 匹配在末行的死角走「上移」。
        let below = my0 + root.cell-h + 6px - py;
        let above = my0 - 34px - 6px - py;
        if (py + below + 34px <= root.height - 4px) {
            root.yield-y = below;
        } else if (py + above >= 4px) {
            root.yield-y = above;
        } else {
            root.yield-y = 0px;
        }
    }

    // ── 面板本体收进 panel := Rectangle：根只是宿主给的坐标系（铺满终端
    //    区、无背景无描边）。此前把 background/border 直接放在根上，而
    //    实例化处又把根拉伸成 parent.width/height —— 整个终端区被一块
    //    巨大的描边面板盖住（实测 2026-10-30）。坐标系与面板必须分层。
    animate yield-y { duration: 200ms; easing: ease-out; }

    // 匹配变化 → 重新判定让位（§03④）。find-cur-row/len 与 current-no/
    // total 任一变化都要重判（值不变时 changed 不触发，rebuild 回写无害）。
    changed find-cur-row => { root.yield-pending = true; }
    changed find-cur-len => { root.yield-pending = true; }
    changed find-current-no => { root.yield-pending = true; }
    changed find-total => { root.yield-pending = true; }

    panel := Rectangle {
        // 面板定位：钉位或右上默认锚位；y 再叠加让位偏移。
        x: root.dragging ? root.pin-x : root.eff-x;
        y: root.dragging ? root.pin-y : root.eff-y + root.yield-y;
        width: root.panel-w;
        height: 34px;
        background: Theme.popup-bg;
        border-width: 1px;
        border-color: root.find-invalid-regex ? Theme.danger : Theme.border-strong;
        border-radius: Theme.radius-lg;
        // ★ 弹窗表面**不要投影**（2026-10-17 用户定稿「全删」）：
        //   颜色必须写成 transparent（tests/dialog_scrim_drag.rs 的唯一合规值）。
        //   ⚠ 这两行**不能整行删除** —— 实测删掉后 Slint 会把 panel-w/width
        //   误判成绑定循环（编译直接失败），所以保留属性、只把颜色设为透明。
        drop-shadow-blur: 0px;
        drop-shadow-color: transparent;

    HorizontalLayout {
        padding-left: 0px; padding-right: 4px;
        // (2026-10-31 用户口径) 右区收窄：面板左右间距同步收紧。
        spacing: 4px;

        // ── 手柄 ⠿（§03 拖动细则）：贴左缘、与面板等高热区；三态 =
        //    静默置灰 / 悬停 accent 淡染(grab) / 按住 accent 描边(grabbing)
        Rectangle {
            width: 18px;
            accessible-role: button;
            accessible-label: root.lang-en ? "Drag find bar" : "拖动查找栏";
            grip-ta := TouchArea {
                // (2026-10-31 用户口径) 不用 grab/grabbing 专形光标，保持系统默认箭头。
                // 拖动 = **绝对定位法**：首帧测「抓取偏移」（指针绝对位 − 面板位），
                // 之后每帧 pin = 指针绝对位 − 抓偏，直接从指针当前位置解算。
                // 此前是差分累加法（pin += 本帧指针位移）：absolute-position 的
                // 布局滞后会混进每帧增量，误差逐帧累积 → 快半拍/拖沓不丝滑
                //（实测 2026-10-31）。绝对法无累积、无反馈回路，单帧误差不放大。
                property <length> grab-off-x;
                property <length> grab-off-y;
                pointer-event(ev) => {
                    // 松手：钉位继续生效（dragging 只表示"按住拖动中"），
                    // 并立刻重判让位——钉位若压住当前匹配，照样让开。
                    if (ev.kind == PointerEventKind.up && root.dragging) {
                        root.dragging = false;
                        root.apply-yield();
                    }
                }
                moved => {
                    if (self.pressed) {
                        // 首帧（!dragging）测抓偏——此刻面板未动，absolute-position
                        // 与指针同帧，偏移精确。每次拖动都要重测（不能用 pin<0 判）。
                        if (!root.dragging) {
                            root.dragging = true;
                            root.pin-x = root.eff-x;
                            root.pin-y = root.eff-y + root.yield-y;
                            self.grab-off-x = self.absolute-position.x + self.mouse-x - root.pin-x;
                            self.grab-off-y = self.absolute-position.y + self.mouse-y - root.pin-y;
                        }
                        // 面板应到位置 = 指针当前绝对位 − 抓偏（抓偏已吸收根系
                        // 与窗口系的固定差、手柄在面板内的偏移、面板 1px 边框）。
                        let nx = self.absolute-position.x + self.mouse-x - self.grab-off-x;
                        let ny = self.absolute-position.y + self.mouse-y - self.grab-off-y;
                        // clamp 在终端区内（§03「范围」行）。★ 基准是**面板宽**
                        // （root.panel-w）——此前误用 self.width（手柄 18px），
                        // x 向上界几乎等于终端宽，面板会被整个拖出右缘看不见
                        // （用户实测 2026-10-30）。
                        let cx = clamp(nx, 4px, max(4px, root.width - root.panel-w - 4px));
                        let cy = clamp(ny, 4px, max(4px, root.height - 34px - 4px));
                        // 四角磁吸 ≤12px（§03）：Slint 无 if 表达式 → 嵌套三元。
                        root.pin-x = cx < 12px ? 8px
                            : (root.width - cx - root.panel-w < 12px
                                ? root.width - root.panel-w - 8px
                                : cx);
                        root.pin-y = cy < 12px ? 8px
                            : (root.height - cy - 34px < 12px
                                ? root.height - 34px - 8px
                                : cy);
                    }
                }
                clicked => { }
                changed has-hover => {
                    if (self.has-hover && !self.pressed) {
                        root.tip-show(
                            root.lang-en ? "Drag to move · double-click to reset"
                                : "拖动浮层 · 双击回右上角",
                            self.absolute-position.x + self.width / 2,
                            self.absolute-position.y + self.height + 5px);
                    } else {
                        root.tip-hide();
                    }
                }
                double-clicked => {
                    // 双击复位（项目惯例）：清钉位 + 清让位（§03「记忆」行）。
                    root.dragging = false;
                    root.pin-x = -1px;
                    root.pin-y = -1px;
                    root.yield-y = 0px;
                    root.apply-yield();
                }
            }
            Rectangle {
                // (2026-10-31 用户口径) 背景层让开面板 1px 描边（x/y: 1px），
                // 左上/左下角随面板圆角同心（radius-lg−1px）——悬停/按压的
                // 底色与描边不再戳出面板圆角边界。
                x: 1px; y: 1px;
                width: parent.width - 1px; height: parent.height - 2px;
                border-top-left-radius: Theme.radius-lg - 1px;
                border-bottom-left-radius: Theme.radius-lg - 1px;
                border-top-right-radius: Theme.radius-sm;
                border-bottom-right-radius: Theme.radius-sm;
                background: grip-ta.pressed ? Theme.accent-soft
                    : grip-ta.has-hover ? Theme.bg-hover : transparent;
                border-width: 1px;
                border-color: grip-ta.pressed ? Theme.accent-solid.with-alpha(0.30) : transparent;
                Icon {
                    glyph: "drag-grip";
                    tint: grip-ta.pressed || grip-ta.has-hover
                        ? Theme.accent-solid : Theme.text-muted;
                    width: 12px; height: 20px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }
            }
        }

        // ── 输入场（fgroup）：34px 面板内高 24px 上下各让 5（1:1 稿 .p1）；
        //    光环 = 1px accent + 3px accent-soft；没找到/正则无效时描边、
        //    光环、镜头一并转红（§02 没找到态）──
        VerticalLayout {
            padding-top: 5px; padding-bottom: 5px;
            Rectangle {
            HorizontalLayout {
                padding-left: 9px; padding-right: 0px;
                padding-top: 0px; padding-bottom: 0px;
                // (2026-10-31 用户口径) 按钮间不留间隔：悬停/选中背景块横向
                // 相连成一条连续带（IDEA 同款工具栏观感）；按钮组右缘贴合
                // 输入框右边框（正则图标盒贴边，图标自身保留盒内居中空隙）。
                spacing: 0px;
                Icon {
                    glyph: "search";
                    tint: root.fail-state ? Theme.danger-strong : Theme.text-muted;
                    width: 14px; y: (parent.height - self.height)/2;
                }
                // 输入 + 占位（Slint TextInput 无 placeholder-text，叠层实现）。
                Rectangle {
                    horizontal-stretch: 1;
                    fb-input := TextInput {
                        width: parent.width;
                        height: parent.height;
                        vertical-alignment: center;
                        single-line: true;
                        font-family: Theme.ui-font-family;
                        font-size: Theme.fs-sm;
                        color: Theme.text-primary;
                        init => { root.focus-pending = true; }
                        edited => {
                            root.query = self.text;
                            root.debounce-pending = true;
                            root.hist-open = false;
                        }
                        key-pressed(e) => {
                            if (e.text == "\u{001b}") {
                                // Esc 两段式（§04 关闭行）：有词先清词（入历史）。
                                if (root.query != "") {
                                    root.query-committed(root.query, root.match-case, root.use-regex);
                                    root.query = "";
                                    self.text = "";
                                    root.query-changed("");
                                    accept;
                                } else {
                                    root.closed();
                                    accept;
                                }
                            } else if (e.text == Key.Return) {
                                // Enter = 下一个 / Shift+Enter = 上一个（§04 跳转行）。
                                if (root.query != "") {
                                    root.query-committed(root.query, root.match-case, root.use-regex);
                                    root.step(e.modifiers.shift ? -1 : 1);
                                }
                                accept;
                            } else if (e.modifiers.alt && (e.text == "c" || e.text == "C" || e.text == "ã")) {
                                // Alt C/X/↓：仅本框持焦时接管（§04 切换规则行）。
                                root.match-case = !root.match-case;
                                root.options-changed(root.query, root.match-case, root.use-regex);
                                accept;
                            } else if (e.modifiers.alt && (e.text == "x" || e.text == "X" || e.text == "ø")) {
                                root.use-regex = !root.use-regex;
                                root.options-changed(root.query, root.match-case, root.use-regex);
                                accept;
                            } else if (e.modifiers.alt && e.text == Key.DownArrow) {
                                root.hist-open = !root.hist-open;
                                accept;
                            } else {
                                reject;
                            }
                        }
                    }
                    if (fb-input.text == "") : Text {
                        text: root.lang-en ? "Find (Ctrl+F)" : "查找 (Ctrl+F)";
                        color: Theme.text-muted;
                        font-size: Theme.fs-sm;
                        font-family: Theme.ui-font-family;
                        x: 0; y: (parent.height - self.height)/2;
                    }
                }
                // ── 内嵌按钮组：清空 × / 历史 ↩ / Aa / 正则（§01 2-5）────────
                // 「刚打开」态指令组不出现（§02 卡①：有输入才出现）。
                if (fb-input.text != "") : Rectangle {
                    width: 22px;
                    accessible-role: button;
                    accessible-label: @tr("Clear search");
                    fb-clr-ta := TouchArea {
                        mouse-cursor: pointer;
                        changed has-hover => {
                            if (self.has-hover) {
                                root.tip-show(
                                    root.lang-en ? "Clear (Esc)" : "清空 (Esc)",
                                    self.absolute-position.x,
                                    self.absolute-position.y + self.height + 5px);
                            } else { root.tip-hide(); }
                        }
                        clicked => {
                            // 带词清空 = 离开当前查询 → 入历史（§06⑦）。
                            root.query-committed(root.query, root.match-case, root.use-regex);
                            root.query = "";
                            fb-input.text = "";
                            root.query-changed("");
                            fb-input.focus();
                        }
                    }
                    Rectangle {
                        width: 16px; height: 16px;
                        x: (parent.width - self.width)/2; y: (parent.height - self.height)/2;
                        border-radius: self.width / 2;
                        background: fb-clr-ta.has-hover ? Theme.accent-solid : transparent;
                        animate background { duration: 90ms; }
                        Icon {
                            glyph: "close";
                            tint: fb-clr-ta.has-hover ? Theme.term-bg : Theme.text-muted;
                            width: 10px; height: 10px;
                            x: (parent.width - self.width)/2; y: (parent.height - self.height)/2;
                        }
                    }
                }
                // 历史 ↩（§01 ③）：command-history glyph；Alt ↓ 同键。
                if (!root.compact && fb-input.text != "") : Rectangle {   // §02卡①：空态指令组不出现
                    width: 24px;
                    accessible-role: button;
                    accessible-label: root.lang-en ? "Query history" : "查询历史";
                    hist-ta := TouchArea {
                        mouse-cursor: pointer;
                        changed has-hover => {
                            if (self.has-hover) {
                                root.tip-show(
                                    root.lang-en ? "Query history (Alt+Down)"
                                        : "查询历史 (Alt+↓)",
                                    self.absolute-position.x,
                                    self.absolute-position.y + self.height + 5px);
                            } else { root.tip-hide(); }
                        }
                        clicked => { root.hist-open = !root.hist-open; }
                    }
                    // 悬停/开启背景内收 2px（2026-10-31 用户口径：不贴输入框内缘）。
                    Rectangle {
                        width: parent.width;
                        height: parent.height - 4px;
                        y: 2px;
                        border-radius: Theme.radius-sm;
                        background: hist-ta.has-hover ? Theme.bg-hover
                            : root.hist-open ? Theme.accent-soft : transparent;
                    }
                    Icon {
                        glyph: "command-history";
                        tint: root.hist-open ? Theme.accent-solid
                            : hist-ta.has-hover ? Theme.text-primary : Theme.text-secondary;
                        width: 14px; height: 14px;
                        x: (parent.width - self.width)/2; y: (parent.height - self.height)/2;
                    }
                }
                // Aa（§01 ④）：match-case.svg。选中态 = accent 淡染底 + accent
                // 图标，**无线框**（2026-10-31 用户口径：去掉 1.5px 描边）。
                if (!root.compact && fb-input.text != "") : Rectangle {   // §02卡①：空态指令组不出现
                    width: 24px;
                    property <bool> on: root.match-case;
                    accessible-role: button;
                    accessible-label: root.lang-en ? "Match case" : "区分大小写";
                    aa-ta := TouchArea {
                        mouse-cursor: pointer;
                        changed has-hover => {
                            if (self.has-hover) {
                                root.tip-show(
                                    root.lang-en ? "Match case (Alt+C)" : "区分大小写 (Alt+C)",
                                    self.absolute-position.x,
                                    self.absolute-position.y + self.height + 5px);
                            } else { root.tip-hide(); }
                        }
                        clicked => {
                            root.match-case = !root.match-case;
                            root.options-changed(root.query, root.match-case, root.use-regex);
                        }
                    }
                    // 选中/悬停背景内收 2px（不贴输入框内缘）。
                    Rectangle {
                        width: parent.width;
                        height: parent.height - 4px;
                        y: 2px;
                        border-radius: Theme.radius-sm;
                        background: parent.on ? Theme.accent-soft
                            : aa-ta.has-hover ? Theme.bg-hover : transparent;
                    }
                    Icon {
                        glyph: "match-case";
                        tint: parent.on ? Theme.accent-solid
                            : aa-ta.has-hover ? Theme.text-primary : Theme.text-secondary;
                        width: 15px; height: 15px;
                        x: (parent.width - self.width)/2; y: (parent.height - self.height)/2;
                    }
                }
                // (.·)* 正则（§01 ⑤）：regex.svg；写错时计数位红字（数据侧保旧结果）。
                // 选中态同 Aa：accent 淡染底 + accent 图标，无线框。
                if (!root.compact && fb-input.text != "") : Rectangle {   // §02卡①：空态指令组不出现
                    width: 24px;
                    property <bool> on: root.use-regex;
                    accessible-role: button;
                    accessible-label: root.lang-en ? "Use regular expression" : "正则表达式";
                    rx-ta := TouchArea {
                        mouse-cursor: pointer;
                        changed has-hover => {
                            if (self.has-hover) {
                                root.tip-show(
                                    root.lang-en ? "Regular expression (Alt+X)"
                                        : "正则表达式 (Alt+X)",
                                    self.absolute-position.x,
                                    self.absolute-position.y + self.height + 5px);
                            } else { root.tip-hide(); }
                        }
                        clicked => {
                            root.use-regex = !root.use-regex;
                            root.options-changed(root.query, root.match-case, root.use-regex);
                        }
                    }
                    // 选中/悬停背景内收 2px（不贴输入框内缘）。
                    Rectangle {
                        width: parent.width;
                        height: parent.height - 4px;
                        y: 2px;
                        border-radius: Theme.radius-sm;
                        background: parent.on ? Theme.accent-soft
                            : rx-ta.has-hover ? Theme.bg-hover : transparent;
                    }
                    Icon {
                        glyph: "regex";
                        tint: parent.on ? Theme.accent-solid
                            : rx-ta.has-hover ? Theme.text-primary : Theme.text-secondary;
                        width: 15px; height: 15px;
                        x: (parent.width - self.width)/2; y: (parent.height - self.height)/2;
                    }
                }
            }
            background: Theme.field;
            border-width: 1px;
            border-color: root.fail-state ? Theme.danger
                : fb-input.has-focus ? Theme.accent-solid : Theme.border-subtle;
            border-radius: Theme.radius-md;
            // 聚焦光环（v3.6 B2：项目惯例）；没找到态光环同步转红（§02 卡③）。
            if (fb-input.has-focus) : Rectangle {
                x: -3px; y: -3px;
                width: parent.width + 6px; height: parent.height + 6px;
                border-radius: Theme.radius-md + 2px;
                border-width: 3px;
                border-color: root.fail-state
                    ? Theme.danger-strong.with-alpha(0.16) : Theme.accent-soft;
            }
            }
        }

        // ── 计数（§01 ⑥）：有词才出现（§02 卡①「刚打开」无计数）；
        //    0 结果红「0 个结果」、正则无效红「正则无效」。
        //    (2026-10-31 用户口径) 右区收窄给输入框让宽：正常计数「n / m」
        //    收 36px，异常文案（0 个结果/正则无效）保 56px 防截断 ─────────
        if (root.query != "") : Text {
            width: root.compact ? 26px
                : (root.find-invalid-regex || root.find-total == 0) ? 56px : 36px;
            text: root.find-invalid-regex
                ? (root.lang-en ? "bad rx" : "正则无效")
                : root.find-total == 0
                    ? (root.lang-en ? "0 results" : "0 个结果")
                    : root.find-current-no + " / " + root.find-total;
            color: (root.find-invalid-regex || root.find-total == 0)
                ? Theme.danger-strong : Theme.text-secondary;
            font-size: root.compact ? Theme.fs-2xs : Theme.fs-xs;
            font-weight: 600;
            vertical-alignment: center;
            horizontal-alignment: center;
            overflow: elide;
        }

        // ── ↑↓（§01 ⑦）：有结果才出现（§02 卡③「没找到」无导航）────────
        // ── 导航 + 关闭连续带（2026-10-31 用户口径）：↑↓× 悬停背景横向相连
        //    （spacing 0），背景高度内收不贴面板线框 ─────────────────────
        HorizontalLayout {
            spacing: 0px;
        // ── ↑↓（§01 ⑦）：有结果才出现（§02 卡③「没找到」无导航）。
        //    (2026-10-31 用户口径) 盒 24→20px：右区收窄给输入框让宽 ────────
        if (root.find-total > 0) : HorizontalLayout {
            spacing: 0px;
            Rectangle {
                width: 20px;
                accessible-role: button;
                accessible-label: root.lang-en ? "Previous match" : "上一个";
                prev-ta := TouchArea {
                    mouse-cursor: pointer;
                    changed has-hover => {
                        if (self.has-hover) {
                            root.tip-show(
                                root.lang-en ? "Previous match (Shift+Enter)"
                                    : "上一个 (Shift+Enter)",
                                self.absolute-position.x,
                                self.absolute-position.y + self.height + 5px);
                        } else { root.tip-hide(); }
                    }
                    clicked => { root.step(-1); }
                }
                // 悬停背景收成 20px 居中（2026-10-31 用户口径：盒随面板全高，
                // 背景太高不协调；与左侧图标组同高）。
                Rectangle {
                    width: parent.width;
                    height: 20px;
                    y: (parent.height - self.height)/2;
                    border-radius: Theme.radius-sm;
                    background: prev-ta.has-hover ? Theme.bg-hover : transparent;
                }
                Icon { glyph: "expand-less"; tint: prev-ta.has-hover ? Theme.text-primary : Theme.text-secondary; width: 14px; height: 14px; x: (parent.width - self.width)/2; y: (parent.height - self.height)/2; }
            }
            Rectangle {
                width: 20px;
                accessible-role: button;
                accessible-label: root.lang-en ? "Next match" : "下一个";
                next-ta := TouchArea {
                    mouse-cursor: pointer;
                    changed has-hover => {
                        if (self.has-hover) {
                            root.tip-show(
                                root.lang-en ? "Next match (Enter)" : "下一个 (Enter)",
                                self.absolute-position.x,
                                self.absolute-position.y + self.height + 5px);
                        } else { root.tip-hide(); }
                    }
                    clicked => { root.step(1); }
                }
                Rectangle {
                    width: parent.width;
                    height: 20px;
                    y: (parent.height - self.height)/2;
                    border-radius: Theme.radius-sm;
                    background: next-ta.has-hover ? Theme.bg-hover : transparent;
                }
                Icon { glyph: "expand-more"; tint: next-ta.has-hover ? Theme.text-primary : Theme.text-secondary; width: 14px; height: 14px; x: (parent.width - self.width)/2; y: (parent.height - self.height)/2; }
            }
        }

        // ── 关闭 ✕（§01 ⑧）：(2026-10-31 用户口径) **直接关闭整个面板**，
        //    不再「有词先清词」两段式（Esc 仍是两段式）；带词关闭不入历史。
        //    悬停 = DialogClose 同款语义红底 + 纯白 ×（Theme.close-btn-hot）。
        Rectangle {
            width: 20px;
            accessible-role: button;
            accessible-label: root.lang-en ? "Close find bar" : "关闭查找栏";
            fb-close-ta := TouchArea {
                mouse-cursor: pointer;
                changed has-hover => {
                    if (self.has-hover) {
                        root.tip-show(
                            root.lang-en ? "Close (Esc)" : "关闭 (Esc)",
                            self.absolute-position.x,
                            self.absolute-position.y + self.height + 5px);
                    } else { root.tip-hide(); }
                }
                clicked => {
                    // (2026-10-31) 直接关闭：先清缓冲词与匹配（终端高亮随缓冲
                    // 清空，§01⑧「关闭清掉全部高亮」），宿主收面板+焦点回终端。
                    root.query-changed("");
                    root.closed();
                }
            }
            Rectangle {
                width: parent.width;
                height: 20px;
                y: (parent.height - self.height)/2;
                border-radius: Theme.radius-sm;
                background: fb-close-ta.has-hover ? Theme.close-btn-hot : transparent;
                animate background { duration: 90ms; }
            }
            Icon {
                glyph: "close";
                tint: fb-close-ta.has-hover ? white : Theme.text-secondary;
                width: 15px; height: 15px;
                x: (parent.width - self.width)/2; y: (parent.height - self.height)/2;
            }
        }
        }   // ← 导航+关闭连续带包裹层闭合
    }

    // ── 历史下拉（§04 历史行 / §06⑦）：最近 10 条，选中即重查 ────────────
    // Alt ↓ / ↩ 打开；点条目 → 连开关一起恢复（走 options 通道一次到位）。
    if (root.hist-open && root.history.length > 0) : Rectangle {
        x: 18px;                     // 手柄右侧起
        y: parent.height + 4px;
        width: parent.width - 26px;
        height: min(root.history.length * 26px + 8px, 268px);
        background: Theme.popup-bg;
        border-width: 1px;
        border-color: Theme.border-strong;
        border-radius: Theme.radius-md;
        // 同上：历史下拉也是弹窗表面，投影全删（颜色必须 transparent）。
        drop-shadow-blur: 0px;
        drop-shadow-color: transparent;
        clip: true;
        VerticalLayout {
            padding: 4px;
            spacing: 1px;
            for it[i] in root.history : Rectangle {
                height: 25px;
                border-radius: Theme.radius-sm;
                background: hit-ta.has-hover ? Theme.bg-hover : transparent;
                hit-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        root.hist-open = false;
                        root.match-case = it.match-case;
                        root.use-regex = it.use-regex;
                        root.query = it.query;
                        fb-input.text = it.query;
                        // 选中即重查（§04）；开关已同步，走 options 通道一次到位。
                        root.options-changed(it.query, it.match-case, it.use-regex);
                        fb-input.focus();
                    }
                }
                HorizontalLayout {
                    padding-left: 8px; padding-right: 8px;
                    Text {
                        text: it.query;
                        color: Theme.text-primary;
                        font-family: Theme.ui-font-family;
                        font-size: Theme.fs-sm;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    Rectangle { width: 4px; }
                    if (it.match-case) : Text {
                        text: "Aa"; color: Theme.text-muted;
                        font-size: Theme.fs-2xs; vertical-alignment: center;
                        width: 18px;
                    }
                    if (it.use-regex) : Text {
                        text: ".*"; color: Theme.text-muted;
                        font-family: Theme.ui-font-family;
                        font-size: Theme.fs-2xs; vertical-alignment: center;
                        width: 18px;
                    }
                }
            }
        }
    }
    }
    // panel := Rectangle 结束（坐标系根继续）。

    // ── 悬浮提示浮层：声明在最后 = 画在最上（面板/下拉之上）。位置取
    //    按钮底部 +5（照 IconBtn topbar-tip），x 夹在组件内防右缘溢出。
    if (root.tip-text != "") : Rectangle {
        x: clamp(root.tip-x, 4px, max(4px, root.width - self.width - 4px));
        y: root.tip-y;
        width: tip-t.preferred-width + 14px;
        height: 22px;
        background: Theme.popup-bg;
        border-width: 1px;
        border-color: Theme.border-strong;
        border-radius: Theme.radius-sm;
        drop-shadow-blur: 0px;
        drop-shadow-color: transparent;
        tip-t := Text {
            x: (parent.width - self.preferred-width) / 2;
            y: (parent.height - self.preferred-height) / 2;
            text: root.tip-text;
            color: Theme.text-primary;
            font-size: Theme.fs-2xs;
            font-family: Theme.ui-font-family;
        }
    }

    // 宿主注入：语言开关。延迟聚焦（#343 同款：init 同步 focus 会崩）走
    // 组件内 Timer；宿主打开面板后置 open-seq 自增即触发。
    // select-all-seq：Ctrl+F 再按一次 → 全选查询词（§04 打开行）。
    in property <bool> lang-en: false;
    in property <int> open-seq: 0;
    in property <int> select-all-seq: 0;
    property <bool> focus-pending: false;
    changed open-seq => { root.focus-pending = true; }
    changed select-all-seq => { fb-input.select-all(); fb-input.focus(); }
    Timer {
        interval: 0ms;
        running: root.focus-pending;
        triggered => {
            root.focus-pending = false;
            fb-input.focus();
        }
    }

    // (§06⑨/⑩) 重开/切 tab 回填：init 初始化 + initial-* 变化时同步
    // （切 tab 显示该 tab 的词与开关）。不自动滚动——仅当视口内无命中时
    // 由 Rust 侧「最近命中」口径决定是否移动视图。
    init => {
        root.match-case = root.initial-match-case;
        root.use-regex = root.initial-use-regex;
        root.query = root.initial-query;
        fb-input.text = root.initial-query;
    }
    changed initial-query => {
        root.query = root.initial-query;
        fb-input.text = root.initial-query;
        root.match-case = root.initial-match-case;
        root.use-regex = root.initial-use-regex;
        root.hist-open = false;
        root.yield-pending = true;
    }
    changed initial-match-case => { root.match-case = root.initial-match-case; }
    changed initial-use-regex => { root.use-regex = root.initial-use-regex; }
}
